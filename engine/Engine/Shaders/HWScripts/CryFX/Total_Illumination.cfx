#if FEATURE_SVO_GI

// rt stage 2 (decision 06 section 6.3): ShadeLib.cfi's ForwardShadingAttribs embeds a
// CustomForwardShadingAttribs, so every shader that wants the forward stack has to declare
// its own before including ShadeLib.cfi - see Illum.cfx:33, Terrain.cfx:21, Vegetation.cfx:323
// and six more. Total_Illumination.cfx never did, because until now it never referenced
// ForwardShadingAttribs. The five members are Neo's; they are what the hit carries that a
// primary surface does not.
struct CustomForwardShadingAttribs
{
	int    LightingModel;
	// rt stage 5B: a float3, not a scalar. ThinTranslucencyBRDF takes a transmittance COLOUR
	// (shadeLib.cfi:952) and both CE sources of one are coloured - Vegetation's
	// TransmittanceColor defaults to (1, 1, 0.6) and HumanSkin's is exp(x * (-8, -40, -64)),
	// which is the red skin glow. Until now this lane was one scalar broadcast to grey, which
	// is the one thing a transmittance colour must not be.
	float3 Transmittance;
	float  Emittance;
	float3 RayDirection;
	float  SunShadowRT;
};

#include "Common.cfi"
#include "ShadeLib.cfi"
#include "vertexLib.cfi"
#include "ShadowCommon.cfi"

// rt stage 2: the direct-lighting lobe used by the hit-shading pass. It is CE's own callback
// contract (TiledShading.cfi calls it), with one change: the view vector looks back along the
// ray instead of back at the camera. DiffuseBRDF / SpecularBRDF / ThinTranslucencyBRDF already
// carry SCENE_BRDF_NORM_FACTOR on this branch, so the 1/PI convention is inherited with no edit.
void Callback_ShadingDirect(in ForwardShadingAttribs attribs, in ForwardLightParams light, out float3 diffuseAcc, out float3 specularAcc)
{
	const float3 viewVec = normalize(-attribs.custom.RayDirection);
	const float NdotL = saturate(dot(attribs.normal, light.lightVec));

	float3 diffuseTerm;
	if (attribs.custom.LightingModel == LIGHTINGMODEL_TRANSMITTANCE)
		diffuseTerm = ThinTranslucencyBRDF(attribs.normal, light.lightVec, (half3)attribs.custom.Transmittance);
	else
		diffuseTerm = (float3)DiffuseBRDF(attribs.normal, viewVec, light.lightVec, attribs.smoothness, NdotL);

	specularAcc = SpecularBRDF(attribs.normal, viewVec, light.lightVec, attribs.smoothness, attribs.reflectance) * NdotL;

	diffuseAcc = diffuseTerm * light.illuminance * attribs.custom.SunShadowRT;
	specularAcc = specularAcc * light.illuminance * attribs.custom.SunShadowRT;
}

// rt stage 2: ForwardShading.cfi must come BEFORE CommonSVO.cfi. CommonSVO.cfi:192 includes
// TiledShading.cfi itself, TiledShading.cfi has no include guard, and TiledShading.cfi's ApplyGI
// reads cbSVOGI out of the CBPerPassForward (b5) block that ForwardShading.cfi declares just
// above its own include of it. Pull it in from here, and tell CommonSVO.cfi to skip its copy.
// (ShadowCommon.cfi moved up for the same reason: Fwd_SampleSunShadowMaps calls ShadowDepthTest.
// CommonSVO.cfi references nothing from ShadowCommon.cfi.)
#include "ForwardShading.cfi"
#define TILED_SHADING_ALREADY_INCLUDED
#include "CommonSVO.cfi"
#include "Total_Illumination_Shading.cfi"

