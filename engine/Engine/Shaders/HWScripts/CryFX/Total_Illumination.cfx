// Structures
struct vtxOutWPOS
{
	float4 HPosition: SV_POSITION;
	float4 baseTC: TEXCOORD0;
	float4 CamVec: TEXCOORD1;
};

struct vtxInWPOS
{
	IN_P
	IN_TBASE
	float3 CamVec: TEXCOORD1;
};

struct pixoutMRTTrace_NID_GS
{
	half4 Diffuse: SV_Target0;
};

struct pixoutMRTTrace
{
	half4 Diffuse: SV_Target0;
	half4 Specular: SV_Target1;
#if %_RT_QUALITY
	// rt stage 2 (decision 06 section 6.6). Only allocated and only bound for the specular
	// target set when e_svoTI_RT_Active; the diffuse permutation never sets %_RT_QUALITY.
	//  HitPos: .xyz camera-relative hit position (RGBA32F - fp16 is 1.5 cm at 32 m, which is
	//          shadow-acne territory for hit shading), .w = RT_PackHitMaterial(reflectance,
	//          smoothness): a 24 bit integer holding the hit's F0 (8 bit square-law magnitude +
	//          a 216 entry hue code) and its smoothness (8 bit). Kept positive; the sign is
	//          reserved for the interleaved-refraction flag, stage 4. rt stage 2D moved the
	//          emissive hue out of this lane and into ALD.w to make room - see the comment above
	//          RT_PackHitMaterial in CommonSVO_RT.cfi for why the old packing killed specular.
	//  RayDir: .xyz ray direction, .w = hit distance, or GetMaxRayDistance() + 1 on a miss
	//          (the "no hit => fall back to probes" sentinel). .w == 0 means "not an RT pixel".
	float4 HitPos: SV_Target2;
	half4  RayDir: SV_Target3;
	//  HitGi:  rt stage 4A (energy audit error 1 + 2). .xyz = the SVO's DIFFUSE IRRADIANCE at
	//          the hit, in the same unexposed units as TexGiDiffuse (the deferred consumer's
	//          ApplyGI mode 2 input), .w = a voxel-derived ambient occlusion, 1 = unoccluded.
	//          It has to be produced HERE and not in ShadePS: the irradiance is a brick-pool
	//          fetch inside the SVO cell that produced the hit, and ShadePS may never touch a
	//          brick pool (t0-t3 aliasing). A miss writes (0,0,0,1).
	half4  HitGi: SV_Target4;
	//  HitMat: rt stage 5B (decision 10). .x = RT_PackHitMatCode - the shading tag as a compact
	//          code, one per type 8 bit scalar, and the sign flagging "this material has an
	//          extras record"; .yzw = the one per type float3 (vegetation / skin transmittance,
	//          glass tint, water body colour). See the block above RT_TagToCode in
	//          CommonSVO_RT.cfi for why no existing lane could carry it.
	half4  HitMat: SV_Target5;
#endif
};

// rt stage 2: the ShadePass output is exactly CE's two-target trace contract, which is why
// DemosaicPS and UpScalePS need no change at all.
struct pixoutShade
{
	half4 vALD: SV_Target0;
	half4 vRGB: SV_Target1;
