// rt stage 2: the four g-data targets the ShadePass reads.
//
// !!! THESE ALIAS t0-t3 WITH brickPool_Tree / Rgbs / Norm / Opac (CommonSVO.cfi:164-167). !!!
// It compiles only because the CryFX parser emits per-technique HLSL containing just the
// reachable declarations, and no single function ever reaches both sets: ConeTracePS walks the
// brick pools and never the forward stack, ShadePS walks the forward stack and never a pool.
// Adding a brick read to ShadePS - or a refl_G* read to anything the tracer calls - is a hard
// register redefinition error from fxc with a message that will not mention this comment.
// research/06 section 2.1, decision 06 section 6.1.
Texture2D refl_GAL: register (t0); // = the ALD target of the previous ConeTracePass
Texture2D refl_GNO: register (t1); // = the RGB target
Texture2D refl_GPO: register (t2); // = HITPOS
Texture2D refl_GLD: register (t3); // = RAYDIR

// rt stage 4A: the fifth g-data target, the SVO GI + AO at the hit. t37 is free on the ShadePass
// technique (the forward set claims t17-t24, t26-t31, t33, t40; t34-t36 are the sky).
Texture2D refl_GGI: register (t37);

// rt stage 5B (decision 10): the sixth g-data target, the hit's shading tag and its per type
// parameters. t39 is free on the ShadePass technique - the forward set claims t17-t24, t26-t31,
// t32, t33, t38 (Fwd_SunShadowMask), t40 and t42-t49, the sky t34-t36 and the SVO GI t37 - and
// FXSamplerDefs.cfi's own t39 users (NOISE_3D_MAP / DISSOLVE_NOISE_MAP) are macros this shader
// never instantiates.
Texture2D refl_GMAT: register (t39);

// rt stage 4B (decision 08 items 2 + 3): DemosaicPS and UpScalePS need the HIT DISTANCE - the
// virtual-image reprojection depth and the bilateral hit-distance similarity weight are both
// built on it - and it is the one g-data lane the shaded ALD + RGB pair does not carry. Same
// target ConeTracePass wrote at MRT 3 (pRT_RAYDIR_0), bound read-only on those two passes and
// only when e_svoTI_RT_Active. t38 is free on both techniques.
//   .xyz = ray direction scaled by the VNDF estimator weight, .w = hit distance
//          (GetMaxRayDistance() + 1 on a miss, 0 when the pixel is not an RT pixel).
Texture2D refl_RAYDIR_REC: register (t38);

