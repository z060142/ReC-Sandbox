/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Shader flags

// _RT_SAMPLE0									Low spec mode
// _RT_SAMPLE1									Global environment map is available
// _RT_SAMPLE2									Troposphere is enabled
// _RT_SAMPLE3									Volumetric lightmaps enabled
// _RT_SAMPLE4									ON - diffuse computations, OFF - specular
// _RT_SAMPLE5									Albedo and normals in use
// _RT_HW_PCF_COMPARE						Half-res kernel
// _RT_LIGHT_TEX_PROJ						Simple RSM sun
// _RT_POINT_LIGHT							Simple RSM point lights
// _RT_BLEND_WITH_TERRAIN_COLOR SS depth tracing
// _RT_MOTION_BLUR							Dual tracing for multi-GPU
// _RT_LIGHTVOLUME0             Portals in use
// _RT_SPRITE										Analytical occluders using final ALD light info
// _RT_AMBIENT_OCCLUSION				Sun RSM Inject in modes 1-2
// _RT_VOLUMETRIC_FOG						Use RSM albedo colors and normals
// _RT_LIGHTVOLUME1             Analytical GI mode - voxels are not used
// _RT_TILED_SHADING            Enable voxels tracing
// _RT_ENVIRONMENT_CUBEMAP      Analytical proxies included into voxel tracing
// _RT_REVERSE_DEPTH            Generate sun shadow mask by SVO ray tracing
// _RT_PROJECTION_MULTI_RES     Compute simple specular using ALD results of diffuse tracing
// _RT_QUALITY1                 Include terrain heightmap (whole level) into ray-traced sun shadows
// _RT_NO_TESSELLATION          Use full sphere tracing for translucent geoemtry
// _RT_QUALITY                  Enable mesh tracing
// _RT_SAMPLE6                  Mesh tracing uses the per-cell static BVH
// _RT_PARTICLE_SHADOW          Mesh tracing debug views (e_svoTI_RT_Debug)

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Functions

float3 GetDiffuseKernel(out int GI_DIFFUSE_KERNEL_TILING, int nElemId, const bool bFullSphere = true)
{
	if (IsDiffuseMode())
	{
#if %_RT_HW_PCF_COMPARE

		const int nGiDiffuseSampleNum = 128;
		nElemId = nElemId & (nGiDiffuseSampleNum - 1);

		GI_DIFFUSE_KERNEL_TILING = sqrt(nGiDiffuseSampleNum / 2);

#if %_RT_NO_TESSELLATION
		if (bFullSphere)
		{
			const float3 arrGiDiffuseKernel[nGiDiffuseSampleNum] = kernel_S_128;
			return arrGiDiffuseKernel[nElemId];
		}
		else
#endif
		{
			const float3 arrGiDiffuseKernel[nGiDiffuseSampleNum] = kernel_HS_128;
			return arrGiDiffuseKernel[nElemId];
		}

#else

		const int nGiDiffuseSampleNum = 512;
		nElemId = nElemId & (nGiDiffuseSampleNum - 1);

		GI_DIFFUSE_KERNEL_TILING = sqrt(nGiDiffuseSampleNum / 2);

#if %_RT_NO_TESSELLATION
		if (bFullSphere)
		{
			const float3 arrGiDiffuseKernel[nGiDiffuseSampleNum] = kernel_S_512;
			return arrGiDiffuseKernel[nElemId];
		}
		else
#endif
		{
			const float3 arrGiDiffuseKernel[nGiDiffuseSampleNum] = kernel_HS_512;
			return arrGiDiffuseKernel[nElemId];
		}

#endif
	}
	else
	{
#if %_RT_HW_PCF_COMPARE

		const int nGiDiffuseSampleNum = 8;
		nElemId = nElemId & (nGiDiffuseSampleNum - 1);

		GI_DIFFUSE_KERNEL_TILING = sqrt(nGiDiffuseSampleNum / 2);
		const float3 arrGiDiffuseKernel[nGiDiffuseSampleNum] = kernel_HS_8;
		return arrGiDiffuseKernel[nElemId];

#else

		const int nGiDiffuseSampleNum = 32;
		nElemId = nElemId & (nGiDiffuseSampleNum - 1);

		GI_DIFFUSE_KERNEL_TILING = sqrt(nGiDiffuseSampleNum / 2);
		const float3 arrGiDiffuseKernel[nGiDiffuseSampleNum] = kernel_HS_32;
		return arrGiDiffuseKernel[nElemId];

#endif
	}
}

float3 GetWorldSpaceNormals(float2 tc, out float fTransmittanceY, float3 vCamVec)
{
	half4 bufferA = tex2DlodPC(sceneGBuffer0, tc);
	float3 vNorm0 = DecodeGBufferNormal(bufferA);
	if (IsDiffuseMode())
		fTransmittanceY = saturate(DecodeGBufferTransmittanceLum(bufferA));
	else
		fTransmittanceY = 0;
	return vNorm0;
}

MaterialAttribsCommon DecodeGBufferChannels(in float2 tc)
{
	return DecodeGBuffer(tex2DlodPC(sceneGBuffer0, tc), tex2DlodPC(sceneGBuffer1, tc), tex2DlodPC(sceneGBuffer2, tc));
}

float3 GetVoxCenter(uint3 coord, uint3 coord0, uint3 coord1, float4 voxAreaMin, float4 voxAreaMax)
{
	return voxAreaMin + (voxAreaMax - voxAreaMin) * float3(coord - coord0) / float3(coord1 + 1 - coord0) + voxAreaMin.w / VOX_BRICK_TEXRES / 2;
}

float rand(float2 n)
{
	return frac(sin(dot(n.xy, float2(12.9898, 78.233))) * 43758.5453);
}

void GetRndRotationMat(in float3 vPos0, in float3 vNor0, out half2x2 mSampleRotMat)
{
	float3 vNorAbs = abs(vNor0);

	float2 vC = 0;
	if ((vNorAbs.x > vNorAbs.y) && (vNorAbs.x > vNorAbs.z))
		vC = vPos0.yz;
	else if ((vNorAbs.y > vNorAbs.x) && (vNorAbs.y > vNorAbs.z))
		vC = vPos0.xz;
	else
		vC = vPos0.xy;

	const half jitterIndex = dot(rand(vC), half2(1, .25));
	half2 vJitterSinCos = half2(sin(PI_X2 * jitterIndex), cos(PI_X2 * jitterIndex));
	const half2x2 _mSampleRotMat = { vJitterSinCos.y, vJitterSinCos.x, -vJitterSinCos.x, vJitterSinCos.y };
	mSampleRotMat = _mSampleRotMat;
}

vert2FragGeneral VoxelRayTraceVS(app2vertGeneral IN)
{
	vert2FragGeneral OUT = (vert2FragGeneral)0;

	streamPos vertPassPos = (streamPos)0;

	OUT.vView.xyz = g_VS_WorldViewPos.xyz;

	vs_shared_output(IN, OUT, vertPassPos, true);

	OUT.screenProj.x = IN.vertCommon.baseTC.x;
	OUT.screenProj.y = 1 - IN.vertCommon.baseTC.y;

	OUT.baseTC.xyz = IN.vertCommon.Position.xyz;

	return OUT;
}

int GetNodeRequestedForUpdate(int nItemId)
{
	float nRes = -2.f;

	const int SVO_MAX_NODE_GROUPS = 4;

	if (nItemId >= 0 && nItemId < SVO_MAX_NODE_GROUPS * 4 * 4)
	{
		int g = nItemId / 16;
		nItemId -= g * 16;
		int x = nItemId / 4;
		nItemId -= x * 4;
		int y = nItemId;

		if (g == 0)
		{
			nRes = SVO_NodesForUpdate0[x][y];
		}
		else if (g == 1)
		{
			nRes = SVO_NodesForUpdate1[x][y];
		}
		else if (g == 2)
		{
			nRes = SVO_NodesForUpdate2[x][y];
		}
		else if (g == 3)
		{
			nRes = SVO_NodesForUpdate3[x][y];
		}
	}

	return int(nRes + 0.1f);
}

float3 GetSkyColor(const float3 vDir, const float fConeSev)
{
	float fAmplifier = 1.f;
#if %_PS
	fAmplifier = IsDiffuseMode() ? SvoParamsDiffuse.w : SvoParamsSpecular.w;
#endif

#if !%_RT_SAMPLE5 && %_PS && !%_RT_LIGHTVOLUME1
	if (SvoParamsSkyColor.w < 0)
		return -SvoParamsSkyColor.w * vSkyColorTop.xyz * fAmplifier;
	return SvoParamsSkyColor.w * fAmplifier;
#endif

#if %_RT_SAMPLE1
	float3 vAmb = DecodeHDRCubemap(texCUBElodLC(globalSpecCM, half4(vDir, saturate(1.f - fConeSev) * 3.f))) * SvoParamsMisc.w;
#else
	float3 vAmb = vSkyColorTop;
#endif

	if (SvoParamsSkyColor.w < 0)
		return vAmb * -SvoParamsSkyColor.w * fAmplifier;

	return vAmb * SvoParamsSkyColor.w * fAmplifier;
}

struct Segment
{
	float3 P0;
	float3 P1;
};

float GetPointToSegmentDistance(float3 P, Segment S, out float3 vOutDir)
{
	float3 v = S.P1 - S.P0;
	float3 w = P - S.P0;
	float3 closestPoint;

	float c1 = dot(w, v);
	float c2 = dot(v, v);

	if (c1 <= 0)
	{
		closestPoint = S.P0;
	}
	else if (c2 <= c1)
	{
		closestPoint = S.P1;
	}
	else
	{
		float b = c1 / c2;
		closestPoint = S.P0 + b * v;
	}

	vOutDir = closestPoint - P;
	return length(vOutDir);
}

//		Source: http://geomalgorithms.com/a07-_distance.html
float GetSegmentToSegmentDistance(Segment S1, Segment S2)
{
	float3 u = S1.P1 - S1.P0;
	float3 v = S2.P1 - S2.P0;
	float3 w = S1.P0 - S2.P0;
	float a = dot(u, u);            // always >= 0
	float b = dot(u, v);
	float c = dot(v, v);            // always >= 0
	float d = dot(u, w);
	float e = dot(v, w);
	float D = a * c - b * b;       // always >= 0
	float sc, sN, sD = D;          // sc = sN / sD, default sD = D >= 0
	float tc, tN, tD = D;          // tc = tN / tD, default tD = D >= 0

	const float SMALL_NUM = 0.001f;

	// compute the line parameters of the two closest points
	if (D < SMALL_NUM)
	{
		// the lines are almost parallel
		sN = 0.0;         // force using point P0 on segment S1
		sD = 1.0;         // to prevent possible division by 0.0 later
		tN = e;
		tD = c;
	}
	else
	{
		// get the closest points on the infinite lines
		sN = (b * e - c * d);
		tN = (a * e - b * d);
		if (sN < 0.0)
		{
			// sc < 0 => the s=0 edge is visible
			sN = 0.0;
			tN = e;
			tD = c;
		}
		else if (sN > sD)
		{
			// sc > 1  => the s=1 edge is visible
			sN = sD;
			tN = e + b;
			tD = c;
		}
	}

	if (tN < 0.0)
	{
		// tc < 0 => the t=0 edge is visible
		tN = 0.0;
		// recompute sc for this edge
		if (-d < 0.0)
			sN = 0.0;
		else if (-d > a)
			sN = sD;
		else
		{
			sN = -d;
			sD = a;
		}
	}
	else if (tN > tD)
	{
		// tc > 1  => the t=1 edge is visible
		tN = tD;
		// recompute sc for this edge
		if ((-d + b) < 0.0)
			sN = 0;
		else if ((-d + b) > a)
			sN = sD;
		else
		{
			sN = (-d + b);
			sD = a;
		}
	}

	// finally do the division to get sc and tc
	sc = (abs(sN) < SMALL_NUM ? 0.0 : sN / sD);
	tc = (abs(tN) < SMALL_NUM ? 0.0 : tN / tD);

	// get the difference of the two closest points
	float3 dP = w + (sc * u) - (tc * v);  // =  S1(sc) - S2(tc)

	return length(dP);   // return the closest distance
}

struct OBB
{
	float4 ue[3];
	float4 c;
};

//Computes the square distance between point p and OBB b
float SqDistPointOBB(float3 p, OBB b, const bool bCylinder)
{
	float3 v = p - b.c.xyz;
	float sqDist = 0.0f;
	for (int i = 0; i < 3; i++)
	{
		float d = dot(v, b.ue[i].xyz);
		float excess = 0.0f;

		if (d < -b.ue[i].w)
			excess = d + b.ue[i].w;
		else if (d > b.ue[i].w)
			excess = d - b.ue[i].w;

		sqDist += excess * excess;
	}

	if (bCylinder)
	{
		Segment s0;
		s0.P0 = b.c.xyz + b.ue[2].xyz * b.ue[2].w;
		s0.P1 = b.c.xyz - b.ue[2].xyz * b.ue[2].w;

		float3 vOutDir = 0;
		float fSD = GetPointToSegmentDistance(p, s0, vOutDir);

		sqDist = max(sqDist, pow(max(0, fSD - b.ue[0].w), 2.f));
	}

	return sqDist;
}

struct SAnalyticalOccluder
{
	float4 P0;
	float4 P1;
	float4 P2;
	float4 C;
};

#define SVO_MAX_ANALYTICAL_OCCLUDERS 32

float4 SVO_AnalyticalOccluders[SVO_MAX_ANALYTICAL_OCCLUDERS * 4];
float4 SVO_PostOccluders[SVO_MAX_ANALYTICAL_OCCLUDERS * 4];

#define AO_eCapsule       0
#define AO_eOBB           1
#define AO_eCylinder      2
#define AO_eOBB_Hard      3
#define AO_eCylinder_Hard 4

float ProcessAnalyticalOccluders(float fRayLen, Ray r, inout float4 vC, float fDirectionality, const bool bPostOccl)
{
	float fHitDist = 1000;

#if !ORBIS

	float fOccl = 0;

	const float fDistM = length(r.startpoint.xyz - PS_WorldViewPos.xyz);

	for (int n = 0; n < SVO_MAX_ANALYTICAL_OCCLUDERS; n++)
	{
		SAnalyticalOccluder oc;

		if (bPostOccl)
		{
			oc.P0 = SVO_PostOccluders[n * 4 + 0];
			oc.P1 = SVO_PostOccluders[n * 4 + 1];
			oc.P2 = SVO_PostOccluders[n * 4 + 2];
			oc.C = SVO_PostOccluders[n * 4 + 3];
		}
		else
		{
			oc.P0 = SVO_AnalyticalOccluders[n * 4 + 0];
			oc.P1 = SVO_AnalyticalOccluders[n * 4 + 1];
			oc.P2 = SVO_AnalyticalOccluders[n * 4 + 2];
			oc.C = SVO_AnalyticalOccluders[n * 4 + 3];
		}

		if (!oc.P0.w)
			break;

		float fOrigDist = 1000;
		float fRayDist = 1000;
		float fRadius = 0;
		float3 vSegDir = 0;

		bool bHardOcclusion = (oc.C.w == AO_eOBB_Hard || oc.C.w == AO_eCylinder_Hard);

		if (oc.C.w == AO_eCapsule) // capsule
		{
			float3 startpoint = r.startpoint + r.direction * oc.P0.w * .125;

			Segment s0;
			s0.P0 = startpoint;
			s0.P1 = startpoint + r.direction * fRayLen;

			Segment s1;
			s1.P0 = oc.P0.xyz;
			s1.P1 = oc.P1.xyz;

			fRayDist = GetSegmentToSegmentDistance(s0, s1);

			s0.P0 = startpoint;
			s0.P1 = startpoint + r.direction * 0.001f;

			float3 dP;
			fOrigDist = GetPointToSegmentDistance(startpoint, s1, dP);

			vSegDir = normalize(dP);

			fRadius = oc.P0.w;
		}
		else if (oc.C.w <= AO_eCylinder_Hard) // obb or cylinder
		{
			float3 startpoint = r.startpoint + r.direction * (0.001 + 0.001 * fDistM);

			OBB obb;
			obb.ue[0] = oc.P0;
			obb.ue[1] = oc.P1;
			obb.ue[2] = oc.P2;
			obb.ue[1].xyz *= -1;

			obb.c = oc.C;

			bool bCylinder = (oc.C.w == AO_eCylinder || oc.C.w == AO_eCylinder_Hard);

			fOrigDist = sqrt(SqDistPointOBB(startpoint, obb, bCylinder));

			fRayDist = fOrigDist;
			float3 vMinPoint = startpoint;
			float fStepSize = fRayLen;

			for (float t = 0, steps = 0; (t < fRayLen) && (steps < 32) && fStepSize > 0; t += fStepSize, steps++)
			{
				float3 vTestPoint = startpoint + r.direction * t;

				float fD = sqrt(SqDistPointOBB(vTestPoint, obb, bCylinder));

				if (fD < fRayDist)
				{
					fRayDist = fD;
					vMinPoint = vTestPoint;
				}
				else if (fD > fRayDist)
					break;

				fStepSize = min(fD + .002, fStepSize);
			}

			vSegDir = normalize(vMinPoint - startpoint);

			fOrigDist = min(fOrigDist, length(vMinPoint - startpoint));

			fRadius = 0;
		}

		if (fRayDist <= 0)
		{
			if (fOrigDist < fHitDist && fOrigDist < fRayLen)
				fHitDist = fOrigDist;
		}

		float fO = 1.f - max(0, fRayDist - fRadius * .85) / (fRadius * 0.5 + fOrigDist * SvoParamsMisc3.y + 0.001);
		if (fOrigDist > 0)
		{
			fO *= saturate(.5 + dot(vSegDir, r.direction));
			if (!bHardOcclusion)
				fO *= saturate(1 - fOrigDist / fRayLen);
		}

		fOccl = max(fOccl, fO);
	}

	vC = lerp(vC, float4(0, 0, 0, 1), fOccl);

#endif

	return fHitDist;
}

float4 ConeTraceTreeAndSkyEx(float fRayLen, Ray r, float fConeSev, out float4 vNor1, const float fConesColorSatur = 1.f, const float fMultTriRT = 0, const bool bSpecular = false, bool bForceUseLighting = false, const bool bAllowSkyLight = true, float3 vSurfNorm = 0)
{
	float fAoHitDist = 1000;
	float fAoOpacity = 0;

#if !ORBIS
	#if %_RT_LIGHTVOLUME1 || %_RT_ENVIRONMENT_CUBEMAP
	{
		float4 vC = 0;
		float fDirectionality = 1;
		Ray r2 = r;
		r2.startpoint += r2.direction * 0.01f;
		fAoHitDist = ProcessAnalyticalOccluders(fRayLen, r2, vC, fDirectionality, false);
		fAoOpacity = vC.a;
	}
	#endif
#endif

	float4 vPos1 = 0;
	vNor1 = 0;
	float4 vC = 0;

#if %_RT_TILED_SHADING
	vC = ConeTraceTree(r, fConeSev, vPos1, vNor1, bSpecular ? (length(r.startpoint - PS_WorldViewPos.xyz) * .25 + .25) : 0, min(fAoHitDist + VOX_MIN_VOX_SIZE, fRayLen), 0.f, 1.f, 0, fMultTriRT, 0, false, bSpecular, bForceUseLighting, vSurfNorm);
#endif

#if !ORBIS
	#if %_RT_LIGHT_TEX_PROJ && %_RT_LIGHTVOLUME1
	if (fAoHitDist < 200)
	{
		float3 vHitPoint = r.startpoint + r.direction * fAoHitDist;

		half3 vSunLight = 0;
		float4 vShadTC = mul(SVO_RsmSunShadowProj, float4(vHitPoint.xyz - PS_WorldViewPos.xyz, 1.f));
		vShadTC.xy /= vShadTC.w;

		float4 vRGBD = 0;

		if (vShadTC.x >= 0 && vShadTC.x <= 1 && vShadTC.y >= 0 && vShadTC.y <= 1 && vShadTC.z <= 1)
		{
			float fShadowDepth = tex2DlodPC(rsmSunShadowMap, float4(vShadTC.xy, 0, 0)).r;
			vSunLight = (fShadowDepth > vShadTC.z + .00005);

		#if %_RT_VOLUMETRIC_FOG
			half4 vMatColor = tex2DlodPC(rsmSunColorsMap, float4(vShadTC.xy, 0, 0)).rgba;
			half3 vMatNormal = tex2DlodPC(rsmSunNormalMap, float4(vShadTC.xy, 0, 0)).rgb;
		#else
			half4 vMatColor = half4(SvoParamsMisc2.zzz, 0.15f);
			half3 vMatNormal = 0;
		#endif
			//vMatColor.xyz = pow(vMatColor.xyz, 1.0/2.2);
			float fMatIntens = dot(vMatColor.xyz, .333f);
			vMatColor.xyz += saturate(SvoParamsMisc2.z - fMatIntens);
			vSunLight *= vMatColor.xyz;
			vRGBD.xyz = vSunLight * SVO_RsmSunCol.xyz * SVO_RsmSunCol.w;
			float fRSM = saturate(1 - (8 / 8) * 200 * abs(fShadowDepth - vShadTC.z));
			vRGBD.a = max(vRGBD.a, fRSM * vMatColor.a);

		#if %_RT_VOLUMETRIC_FOG
			if (dot(vMatNormal, 1) < 0.01)
				vMatNormal = float3(0, 0, 1); // terrain
			else
				vMatNormal = vMatNormal * 2 - 1;

			if (dot(vMatNormal, r.direction) < 0.85)
		#endif
			if (SvoParamsCommon.z)
				vC.xyz += abs(1.f / SvoParamsCommon.z) * vRGBD.xyz * (vRGBD.a) * saturate(1 - 0);
		}
	}
	#endif
#endif

	vC.a = max(fAoOpacity, vC.a);

	// apply cloud shadows
	float fCloudsShadow = 1.f;
#if %_PS
	fCloudsShadow = GetCloudShadowCommon(r.startpoint, shadowFromClouds, ssSvoLinearWrap, SVO_CloudShadowAnimParams, SVO_CloudShadowParams);

	#if !%_RT_LIGHTVOLUME1
	// prevent sky light leaking from the bottom
	if (r.direction.z < 0)
		vC.a = lerp(1.f, vC.a, SvoParamsMisc4.y);
	#endif
#endif

	//float3 vAOTint = lerp(float3(1,1,1), float3(1.5, 1.5, 0), saturate((vC.a-.3)/.7));
	vC.xyz = vC.xyz * fCloudsShadow + GetSkyColor(r.direction, fConeSev) * (saturate(1 - vC.a)) * bAllowSkyLight * (fCloudsShadow * 0.2 + 0.8);
	vC.xyz = lerp((vC.x + vC.y + vC.z) / 3, vC.xyz, fConesColorSatur);

	return vC;
}

float4 ConeTraceTreeAndSky(float fRayLen, const Ray r, const float fConeSev, const float fConesColorSatur = 1.f, const float fMultTriRT = 0, const bool bSpecular = false, const bool bForceUseLighting = false, float3 vSurfNorm = 0)
{
	float4 vNor1 = 0;
	return ConeTraceTreeAndSkyEx(fRayLen, r, fConeSev, vNor1, fConesColorSatur, fMultTriRT, bSpecular, bForceUseLighting, true, vSurfNorm);
}

pixout SvoDebugDrawPS(vert2FragGeneral IN)
{
	pixout OUT = (pixout)0;

	float4 cDiffuseMap = 1;

	// define ray
	Ray r;
	r.startpoint = PS_WorldViewPos.xyz;
	r.direction = normalize(IN.baseTC.xyz - PS_WorldViewPos.xyz);

	float4 vPos0 = 0, vNormal = 0;

#if DURANGO || ORBIS
	cDiffuseMap = ConeTraceTree(r, SvoParamsSpecular.x, vPos0, vNormal, 0, 256.f);
	cDiffuseMap.xyz = float3(int3(vPos0.xyz) & 1);
#else
	//	cDiffuseMap = ConeTraceTreeAndSky(r,  SvoParamsSpecular.x, 1, 0, true, true);
	cDiffuseMap = ConeTraceTree(r, SvoParamsSpecular.x, vPos0, vNormal, 0, 256.f, 0.f, 1.f, 0, 0, 0, false, false, true, 0, (int)SvoParamsSkyColor.z);
	// cDiffuseMap.xyz = float3(int3(vPos0.xyz) & 1);
#endif

	//	cDiffuseMap.xyz = (vNormal)*.5+.5;

	cDiffuseMap.w = 1;

	OUT.Color = pow(cDiffuseMap, 1) / 16;
	OUT.Color.w = 1;

	return OUT;
}

vert2fragZ RenderLightingCommonVS_Z(vtxInWPOS IN)
{
	vert2fragZ OUT = (vert2fragZ)0;

	OUT.HPosition = Get2dHPos(IN.Position);
	OUT.baseTC.xy = IN.baseTC.xy;
	OUT.baseTC.zw = 0;//IN.baseTC * SVO_ScreenSize.xy * 0.25;
	OUT.vNormalWS.xyz = IN.CamVec;

	return OUT;
}

vtxOutWPOS RenderLightingCommonVS(vtxInWPOS IN)
{
	vtxOutWPOS OUT = (vtxOutWPOS)0;

	OUT.HPosition = Get2dHPos(IN.Position);
	OUT.baseTC.xy = IN.baseTC.xy;
	OUT.baseTC.zw = 0;//IN.baseTC * SVO_ScreenSize.xy * 0.25;
	OUT.CamVec.xyz = IN.CamVec;

	return OUT;
}

float3 GetWorldPos(float fDepth, float3 vCamVec)
{
	return fDepth * vCamVec + PS_WorldViewPos.xyz; // Return world space position
}

void GetRotationV0(half3 n, out half3x3 rotMat)
{
	half h = 1 / (1 + n.z);
	rotMat._m00 = h * n.y * n.y + n.z;
	rotMat._m01 = -h * n.y * n.x;
	rotMat._m02 = -n.x;
	rotMat._m10 = -h * n.y * n.x;
	rotMat._m11 = h * n.x * n.x + n.z;
	rotMat._m12 = -n.y;
	rotMat._m20 = n.x;
	rotMat._m21 = n.y;
	rotMat._m22 = n.z;
}

float3 Reproject(in half2 vScreenPos, in float fDepth, in float3x4 matReproj)
{
	float4 pos = float4(vScreenPos, 1.f, 1.f / fDepth);
	pos.xyz = mul(matReproj, pos);
	pos.xy /= pos.z;
	pos.z *= fDepth;

	if (IsDiffuseMode())
	{
	float2 vMV = tex2DlodPC(sceneVelocity, vScreenPos);
	if (vMV.x != 0)
		pos.xy = vScreenPos + DecodeMotionVector(vMV);
	}

	return pos.xyz;
}

void GetAverNormAndSmooth(float2 tcIn, out float3 vAverNor, out float fAverSmoothness, out float fAverTransmittanceY, float3 vCamVec, out float3 vAverReflectance, out float fDepthMin, out float fDepthMax, out float3 vNorMin, out float3 vNorMax)
{
	vAverNor = 0;
	fAverSmoothness = 0;
	vAverReflectance = 0;
	fAverTransmittanceY = 0;
	float fSummW = 0;
	int nRange = 1;
	float2 vR = 0.5f / PS_ScreenSize.xy;
	float fDepthRange = 0.12;
	float fDepth0 = SampleLinearDepth(sceneDepth, tcIn);
	fDepthMin = fDepthMax = fDepth0;
	for (int x = 0; x <= nRange; x++)
		for (int y = 0; y <= nRange; y++)
		{
			float fTransmittanceY = 0;
			float2 tc1 = tcIn + vR * float2(x, y);
			MaterialAttribsCommon gbuffer1 = DecodeGBufferChannels(tc1);
			float fDepth1 = SampleLinearDepth(sceneDepth, tc1);
			if (fDepth1 <= fDepthMin)
			{
				fDepthMin = fDepth1;
				vNorMin = GetWorldSpaceNormals(tc1, fTransmittanceY, vCamVec).xyz;
			}
			if (fDepth1 >= fDepthMax)
			{
				fDepthMax = fDepth1;
				vNorMax = GetWorldSpaceNormals(tc1, fTransmittanceY, vCamVec).xyz;
			}

			const float fW = saturate(fDepthRange - abs(1.f - fDepth0 / fDepth1)) + .001;

			fAverSmoothness += gbuffer1.Smoothness * fW;
			vAverReflectance += gbuffer1.Reflectance * fW;
			vAverNor += GetWorldSpaceNormals(tc1, fTransmittanceY, vCamVec).xyz * fW;
			fAverTransmittanceY += fTransmittanceY * fW;

			fSummW += fW;
		}

	float normalVar = 1.0 / length(vAverNor / fSummW) - 1.0;
	vAverNor = normalize(vAverNor);
	fAverSmoothness /= fSummW;
	fAverSmoothness /= 1 + normalVar * 25;
	fAverTransmittanceY /= fSummW;
	vAverReflectance /= fSummW;
}

float GetBlendMin(float2 tc0, float2 tc1, float fAverSmoothness, float fDepth0, float fDepth1)
{
	float fMinBlend = SVO_TargetResScale.z * 0.25f + SVO_TargetResScale.w;

	if (!IsDiffuseMode())
	{
		float fDistTCRat = saturate(length(tc0 - tc1) / .025f);

		// reduce ghosting for mirrors and in case of camera movement
		fMinBlend = saturate(max(fMinBlend + fDistTCRat * (1.f - fMinBlend), 0.5 * saturate(pow(fAverSmoothness, 3))));
	}

	fMinBlend += saturate(abs(fDepth0 / fDepth1 - 1.f));

	fMinBlend += 0.25f * (tc0.x < 0 || tc0.x > 1 || tc0.y < 0 || tc0.y > 1);

	return saturate(fMinBlend);
}

///////////////////////////////////////////////////////////////////////////////////
// !!! DO NOT WRAP THESE TWO IN A FILE-SCOPE #if. !!!
//
// CryFX's dead-code stripping only reaches NAMED code fragments. ParserBin.cpp:2157-2171
// turns every file-scope preprocessor directive into a code fragment whose m_dwName is never
// assigned, and ShaderFXParseBin.cpp:2961-2969 copies every unnamed fragment into EVERY
// stage's generated script without consulting the reachability list that
// InitShaderDependenciesList (ShaderFXParseBin.cpp:2070-2094) built. A top-level function
// sitting between a file-scope #if and its #endif therefore reaches the VS and the CS as
// well, while the helpers it calls - which ARE named fragments - are correctly stripped from
// them, and the stage fails with "undeclared identifier". That is exactly what
// #if %_RT_QUALITY around RT_IsTriPixel did to RenderLightingCommonVS and
// BuildRayTracingLightListCS: they got the body and not IsDiffuseMode (CommonSVO.cfi:226).
//
// Left unwrapped, both are ordinary named fragments: the pixel entry points that call them
// pull them in, every other stage strips them, and RT_GetFadedNormal's ddx/ddy never reach a
// stage that has no derivatives. This is how every function in CommonSVO_RT.cfi is written.
// The only stock file-scope #if blocks around a top-level function in this tree are
// `#ifdef SVO_LMAPS` (a plain define, never set) and Illum.cfx's `%SILHOUETTE_*` material
// flag - no %_RT_ one, which is why nobody hit this before.
///////////////////////////////////////////////////////////////////////////////////

///////////////////////////////////////////////////////////////////////////////////
// rt stage 2C: the ONE predicate that decides "this pixel is traced with triangles".
//
// ConeTracePS owns the decision, but DemosaicPS and UpScalePS have to reach the same answer
// pixel for pixel, because an RT pixel is reconstructed with a single tap and a cone-traced
// pixel is not. All three call GetAverNormAndSmooth at the same texel of the same G-buffer,
// and with e_svoTI_RT_Active the specular set is forced to full resolution (D3D_SVO.cpp
// CheckAllocateRT), so "the same texel" is literally the same pixel in all three passes and
// the three answers are bit-identical.
///////////////////////////////////////////////////////////////////////////////////
bool RT_IsTriPixel(const float fAverSmoothness, const float3 vAverReflectance, const float fDistM)
{
	// rt stage 4B (decision 08): e_svoTI_RT_MinGloss is now 0.5 and the switch from voxel cone
	// tracing to triangle rays is cross-faded over MinGloss +- VOX_RT_GLOSS_BAND, so the gate
	// opens at the BOTTOM of the band and UpScalePS ramps the RT contribution in across it.
	return !IsDiffuseMode()
	       && fAverSmoothness > (VOX_MAX_RT_MIN_GLOSS - VOX_RT_GLOSS_BAND)
	       && GetLuminance(vAverReflectance) > VOX_MAX_RT_MIN_REFL
	       && fDistM < VOX_MAX_RT_DIST_CAM;
}

// rt stage 2C, finding (a): the reflect direction of a normal-mapped mirror wobbles per pixel,
// and because a normal/detail map tiles on a regular screen grid the reflection picks that grid
// up directly. Neo's remedy is ti_RT_NormalsFading - fade the shading normal into the flat one
// with distance - and this is the reflecting-surface half of it. The flat normal is taken from
// the screen-space derivatives of the reconstructed world position, i.e. the geometric normal of
// the triangle under the quad (Neo does the same thing in its refraction branch). It is rejected
// where the quad straddles a depth discontinuity or a silhouette, in which case the shading
// normal is kept. MUST be called from uniform control flow: it uses ddx/ddy.
float3 RT_GetFadedNormal(const float3 vPos0, const float3 vNor0, const float fDistM)
{
	const float3 vGeo = cross(ddx(vPos0), ddy(vPos0));
	const float  fGeoLen = length(vGeo);

	float3 vFlat = vNor0;
	if (fGeoLen > 1e-9f)
	{
		float3 vG = vGeo / fGeoLen;
		if (dot(vG, vNor0) < 0)
			vG = -vG;
		if (dot(vG, vNor0) > 0.5f) // same surface, only the bump differs
			vFlat = vG;
	}

	return normalize(lerp(vFlat, vNor0, RT_GetNormalsFade(fDistM)));
}

///////////////////////////////////////////////////////////////////////////////////
// rt stage 4B (decision 08) - the three roughness ramps every RT pass agrees on.
// Like RT_IsTriPixel these are file-scope and DELIBERATELY NOT flag-wrapped (see the warning
// above it): a %-flag #if at file scope leaks a function into every stage. They are plain
// named fragments, pulled in only by the pixel entry points that call them.
///////////////////////////////////////////////////////////////////////////////////

// 0 at the bottom of the cross-fade band, 1 at the top. Below the band the pixel is not an RT
// pixel at all; above it the RT result is used neat.
float RT_GetGlossBandT(const float fSmoothness)
{
	const float fLo = VOX_MAX_RT_MIN_GLOSS - VOX_RT_GLOSS_BAND;
	return saturate((fSmoothness - fLo) / max(2.f * VOX_RT_GLOSS_BAND, 1e-4f));
}

// 0 at the bottom of the RT range (a wide lobe: long history, wide spatial filter, reproject at
// the SURFACE), 1 at the mirror end (a pinhole lobe: short history, no spatial filter,
// reproject through the VIRTUAL IMAGE). One curve, so the three filters cannot disagree.
float RT_GetMirrorT(const float fSmoothness)
{
	const float fLo = VOX_MAX_RT_MIN_GLOSS - VOX_RT_GLOSS_BAND;
	return saturate((fSmoothness - fLo) / max(VOX_RT_MIRROR_GLOSS - fLo, 1e-4f));
}

// The temporal blend weight for an RT pixel: 1 / (number of frames of history).
// e_svoTI_RT_TemporalFrames (8) at the rough end, 2 frames at the mirror end - a mirror is
// already stable and a long history only drags it. GetBlendMin's own rejection terms are
// re-used verbatim on top: the depth ratio between this pixel and the history texel it
// reprojected to, and the off-screen penalty. What is NOT re-used is GetBlendMin's
// smoothness knee (it is the mirror-only rule this replaces) and its fDistTCRat anti-ghosting
// term (it exists because the stock path reprojects a reflection at the wrong depth; the
// virtual-image reprojection below is the actual fix for that, and paying the penalty as well
// would throw the history away exactly when the camera moves, which is when it is needed).
float RT_GetGlossyBlend(const float2 tcPrev, const float fSmoothness, const float fDepth0, const float fDepthPrev)
{
	const float fFrames = lerp(max(VOX_RT_TEMPORAL_FRAMES, 1.f), 2.f, RT_GetMirrorT(fSmoothness));

	float fBlend = 1.f / fFrames;

	// GetBlendMin:1015 - the history texel is a different surface, take less of it
	fBlend += saturate(abs(fDepth0 / max(fDepthPrev, 1e-6f) - 1.f));

	// GetBlendMin:1017, hardened: a camera cut or a reprojection that leaves the screen has no
	// history at all, so reset instead of taking a quarter of a wrong pixel.
	if (tcPrev.x < 0.f || tcPrev.x > 1.f || tcPrev.y < 0.f || tcPrev.y > 1.f)
		fBlend = 1.f;

	return saturate(fBlend);
}

#define SVO_MAX_PORTALS 8

float4 SVO_PortalsPos[SVO_MAX_PORTALS];
float4 SVO_PortalsDir[SVO_MAX_PORTALS];

#define MAX_BEST_PORTALS 3

void FindBestPortals(float3 vPos0, float3 vNor0, out float4 arrBestPortalPos[MAX_BEST_PORTALS], out float4 arrBestPortalDir[MAX_BEST_PORTALS])
{
	float arrBestW[MAX_BEST_PORTALS];
	for (int n = 0; n < MAX_BEST_PORTALS; n++)
	{
		arrBestW[n] = 0;
		arrBestPortalPos[n] = 0;
		arrBestPortalDir[n] = 0;
	}

	for (int p = 0; p < SVO_MAX_PORTALS; p++)
	{
		if (SVO_PortalsPos[p].z)
		{
			float3 vDir = normalize(SVO_PortalsPos[p].xyz - vPos0.xyz);

			if (dot(vDir, vNor0) >= 0 && dot(vDir, -SVO_PortalsDir[p].xyz) >= 0)
			{
				float fD = length(SVO_PortalsPos[p].xyz - vPos0.xyz);

				if (fD > VOX_CONE_MAX_LEN)
					continue;

				float fW = 1.f / (fD + 0.01f);

				int nWorstSlot = 0;
				for (int n = 1; n < MAX_BEST_PORTALS; n++)
				{
					if (arrBestW[n] < arrBestW[nWorstSlot])
						nWorstSlot = n;
				}

				if (fW > arrBestW[nWorstSlot])
				{
					arrBestPortalPos[nWorstSlot] = SVO_PortalsPos[p];
					arrBestPortalDir[nWorstSlot] = SVO_PortalsDir[p];
					arrBestW[nWorstSlot] = fW;
				}
			}
		}
	}
}

pixoutMRTDemosaic DemosaicPS(vtxOutWPOS IN)
{
	pixoutMRTDemosaic OUT = (pixoutMRTDemosaic)0;

	// read position and normal
	float3 vPos0 = GetWorldPos(VOX_DEPTH_SCALE * SampleLinearDepth(sceneDepth, IN.baseTC.xy) - VOX_DEPTH_BIAS, IN.CamVec);

	float3 vNor0 = 0;
	float fAverSmoothness = 0;
	float fAverTransmittanceY = 0;
	float3 vAverReflectance = 0;
	float fDepthMin = 0, fDepthMax = 0;
	float3 vNorMin = 0, vNorMax = 0;
	GetAverNormAndSmooth(IN.baseTC.xy, vNor0, fAverSmoothness, fAverTransmittanceY, normalize(IN.CamVec.xyz), vAverReflectance, fDepthMin, fDepthMax, vNorMin, vNorMax);

	float2 vLowResBestTC = IN.baseTC.xy;

	float4 vALD0 = 0;
	float4 vRGB0 = 0;
	float4 vALD1 = 0;
	float4 vRGB1 = 0;

	// blend with prev frame ALD in order to remove flickering
	float fDepthC = SampleLinearDepth(sceneDepth, IN.baseTC.xy);
	float3 vReprojTC = Reproject(vLowResBestTC.xy, fDepthC, SVO_ReprojectionMatrix);

	int GI_DIFFUSE_KERNEL_TILING;
	GetDiffuseKernel(GI_DIFFUSE_KERNEL_TILING, 0);

#if %_RT_SAMPLE0
	int nRange = GI_DIFFUSE_KERNEL_TILING;
#else
	int nRange = GI_DIFFUSE_KERNEL_TILING;
#endif

	if (!IsDiffuseMode())
		nRange = clamp(saturate(1 - (fAverSmoothness * 1.3 - .5) / (1 - .5)) * (float)nRange, 1, GI_DIFFUSE_KERNEL_TILING);

	// reduce range at distance
	const float fDistM = length(vPos0 - PS_WorldViewPos.xyz);

#if %_RT_QUALITY
	// rt stage 2C, finding (b). A triangle-ray pixel already carries a FINAL shaded colour at
	// full resolution (ShadePass wrote it); the min/max demosaic exists to reconstruct a
	// half-resolution stochastic cone trace and has nothing left to do here except smear it.
	// Neo reaches the same place from the other end - its specular filter radius collapses to
	// 0.1 under mesh ray tracing (neo:1014) - and the same single tap is what makes its upscale
	// (neo:2340) legal. So: one tap, at this pixel's own texel.
	const bool bRTPixel = RT_IsTriPixel(fAverSmoothness, vAverReflectance, fDistM);
	if (bRTPixel)
		nRange = 1;
#endif

	//#if %_RT_SAMPLE0
	//nRange = lerp(nRange, nRange / 2, saturate((fDistM - 8) / 8));
	//#endif

	float fResScale = 1.f;
	float2 vR = 2.f * fResScale / (int2(PS_ScreenSize.xy / fResScale) * fResScale);
	float fSumm0 = 0;
	float fSumm1 = 0;
	float fDepthRange = 0.12 + 0.08 * saturate(1.f - dot(normalize(IN.CamVec.xyz), -vNor0)); // floor fix
	float fDotMax = .25;

	float2 vShift;
	if (IsDiffuseMode())
		vShift = vR / 2;
	else
		vShift = vR / 4;

	float2 vSnap = vR / 2;

	float2 vLowResBestTC_Sn = float2(int2(vLowResBestTC / vSnap)) * vSnap + vShift;

#if %_RT_SAMPLE3
	const int nStep = 2;
#else
	const int nStep = 1;
#endif

	float3 vFocus = IsDiffuseMode() ? vNor0 : reflect(normalize(IN.CamVec.xyz), vNor0);

	// reduce border noise
	float2 vBorder = (nRange / 2) * vR * 1;
	vLowResBestTC_Sn = clamp(vLowResBestTC_Sn, vBorder, 1 - vBorder);

	float fRangeFade = 1.2f + 0.5f * saturate(1 - fDistM / 16);

	//	if(SampleLinearDepth(sceneDepth, IN.baseTC.xy) < 0.8f)
	for (int x = -nRange / 2; x <= nRange / 2; x += nStep)
		for (int y = -nRange / 2; y <= nRange / 2; y += nStep)
		{
			float4 tc = saturate(float4(vLowResBestTC_Sn + vR * float2(x, y), 0, 0));

			float4 texALD = tex2DlodLC(sceneAld, tc);
			float4 texRGB = tex2DlodLC(sceneRgb, tc);

			float fNewDepth = texRGB.w;
			float3 vNorm = texALD;

			float fDistW = saturate(fRangeFade - sqrt(x * x + y * y) / max(1, nRange / 2));

			float fDotTest = lerp(.25, saturate(fAverTransmittanceY * 4 + dot(normalize(vNorm), vFocus) - fDotMax), saturate(length(vNorm) / max(0.0001, texALD.w) * 8.f)) + .001;

			float fDepTest0 = saturate((fDepthRange - abs(1.f - fNewDepth / fDepthMin)) * 4) + .001;
			float fDepTest1 = saturate((fDepthRange - abs(1.f - fNewDepth / fDepthMax)) * 4) + .001;

			float fWeigth0 = fDepTest0 * fDotTest * fDistW;
			float fWeigth1 = fDepTest1 * fDotTest * fDistW;

			fWeigth0 = lerp(.015f, fWeigth0, saturate(texALD.w * 1000));
			fWeigth1 = lerp(.015f, fWeigth1, saturate(texALD.w * 1000));

			vALD0 += texALD * fWeigth0;
			vRGB0 += texRGB * fWeigth0;
			vALD1 += texALD * fWeigth1;
			vRGB1 += texRGB * fWeigth1;

			fSumm0 += fWeigth0;
			fSumm1 += fWeigth1;
		}

	// rt stage 2C, finding (b) / (d). CE keeps only the CHROMA here and rebuilds the magnitude in
	// UpScalePS out of the ALD lobe (vRGB * vALD.w, with an NdotH power of 2^12.5 for a mirror).
	// That round trip is exact only for a single sample and an exactly-reconstructed half vector;
	// for a triangle-ray pixel the colour is already final, so keep it as it is and let
	// UpScalePS pass it through. Neo does exactly this (neo:1047 has no normalize, neo:2412
	// assigns vRGB straight out).
#if %_RT_QUALITY
	const bool bKeepRTColour = bRTPixel;
#else
	const bool bKeepRTColour = false;
#endif

	if (fSumm0)
	{
		vALD0 /= fSumm0;
		if (bKeepRTColour)
			vRGB0.xyz /= fSumm0;
		else
			vRGB0.xyz = normalize(vRGB0.xyz);
	}
	if (fSumm1)
	{
		vALD1 /= fSumm1;
		if (bKeepRTColour)
			vRGB1.xyz /= fSumm1;
		else
			vRGB1.xyz = normalize(vRGB1.xyz);
	}

	OUT.Diffuse.xyz = vRGB0;
	OUT.Diffuse.w = fDepthMin;
	OUT.Specular = vALD0;

	OUT.Diffuse1.xyz = vRGB1;
	OUT.Diffuse1.w = fDepthMax;
	OUT.Specular1 = vALD1;

	bool bSameMinMaxDepth = (abs(fDepthMax - fDepthMin) * PS_NearFarClipDist.y < .1) && (dot(vNorMin, vNorMax) > .7);

#if !ORBIS

	#if %_RT_LIGHTVOLUME1 && %_RT_LIGHTVOLUME0

	OUT.Specular *= SvoParamsCommon.z;
	OUT.Specular1 *= SvoParamsCommon.z;

	float4 arrPortOut[2] =
	{
		float4(0, 0, 0, 0),
		float4(0, 0, 0, 0)
	};

	for (int nPass = 0; nPass < 2; nPass++)
	{
		Ray r;
		r.direction = 0;

		if (!nPass)
			r.startpoint = GetWorldPos(VOX_DEPTH_SCALE * fDepthMin - VOX_DEPTH_BIAS, IN.CamVec);
		else
			r.startpoint = GetWorldPos(VOX_DEPTH_SCALE * fDepthMax - VOX_DEPTH_BIAS, IN.CamVec);

		r.startpoint += vNor0 * 0.01;

		{
			float4 arrBestPortalPos[MAX_BEST_PORTALS];
			float4 arrBestPortalDir[MAX_BEST_PORTALS];
			FindBestPortals(vPos0, vNor0, arrBestPortalPos, arrBestPortalDir);

			for (int nPort = 0; nPort < MAX_BEST_PORTALS; nPort++)
			{
				float4 bestPortalPos = arrBestPortalPos[nPort];
				float4 bestPortalDir = arrBestPortalDir[nPort];
				if (bestPortalPos.z)
				{
					float3 lightPos = bestPortalPos;
					float lightSize = bestPortalPos.w;

					//lightPos += SVO_PortalsDir[0].xyz * 2;
					r.direction = normalize(lightPos - vPos0);
					float fDist = length(lightPos - vPos0);

					float4 vC4;
					if (dot(r.direction, vNor0) > 0)
						vC4 = ConeTraceTreeAndSky(fDist, r, SvoParamsDiffuse.x, SvoParamsInject.z, 0, false, false, vNor0);
					else
						vC4 = float4(0, 0, 0, 1);

					float fBr = GetSkyColor(vNor0, 0).b * saturate(1 - vC4.w) * saturate(dot(normalize(vNor0), r.direction)) * saturate(1 / (fDist * 0.5f + 1));

					fBr *= saturate(16 * dot(-bestPortalDir, r.direction));

					if (!nPass)
					{
						arrPortOut[0].xyz += r.direction * fBr;
						arrPortOut[0].w += fBr;
					}
					else
					{
						arrPortOut[1].xyz += r.direction * fBr;
						arrPortOut[1].w += fBr;
					}
				}
			}
		}

		if (bSameMinMaxDepth)
		{
			arrPortOut[1] = arrPortOut[0];
			break;
		}
	}

	OUT.Specular += arrPortOut[0];
	OUT.Specular1 += arrPortOut[1];

	#endif

	#if %_RT_SPRITE
	{
		float4 vC = 0;
		Ray r;

		r.direction = normalize(OUT.Specular.xyz);
		r.startpoint = GetWorldPos(VOX_DEPTH_SCALE * fDepthMin - VOX_DEPTH_BIAS, IN.CamVec);
		float fDirectionality = saturate(length(OUT.Specular.xyz) / OUT.Specular.w);
		vC = 0;
		ProcessAnalyticalOccluders(VOX_POST_AO_MAX_DIST, r, vC, IsDiffuseMode() ? fDirectionality : pow(fAverSmoothness, .5), true);

		#if %_RT_LIGHTVOLUME1 && %_RT_LIGHTVOLUME0
		OUT.Specular *= saturate(1 - vC.w * 0.5);
		#else
		OUT.Specular *= saturate(1 - vC.w);
		#endif

		if (!bSameMinMaxDepth)
		{
			r.direction = normalize(OUT.Specular1.xyz);
			r.startpoint = GetWorldPos(VOX_DEPTH_SCALE * fDepthMax - VOX_DEPTH_BIAS, IN.CamVec);
			float fDirectionality = saturate(length(OUT.Specular1.xyz) / OUT.Specular1.w);
			vC = 0;
			ProcessAnalyticalOccluders(VOX_POST_AO_MAX_DIST, r, vC, IsDiffuseMode() ? fDirectionality : pow(fAverSmoothness, .5), true);
		}

		#if %_RT_LIGHTVOLUME1 && %_RT_LIGHTVOLUME0
		OUT.Specular1 *= saturate(1 - vC.w * 0.5);
		#else
		OUT.Specular1 *= saturate(1 - vC.w);
		#endif
	}
	#endif

#endif

	float3 vReprojTC_Min = Reproject(IN.baseTC.xy, fDepthMin, SVO_ReprojectionMatrix);
	float3 vReprojTC_Max = Reproject(IN.baseTC.xy, fDepthMax, SVO_ReprojectionMatrix);

	float fDepthMinPrev = tex2DlodLC(sceneRgbMinPrev, float4(vReprojTC_Min.xy, 0, 0)).w;
	float fDepthMaxPrev = tex2DlodLC(sceneRgbMaxPrev, float4(vReprojTC_Max.xy, 0, 0)).w;

	float fBlendMin = GetBlendMin(vReprojTC_Min.xy, IN.baseTC.xy, fAverSmoothness, fDepthMin, fDepthMinPrev);
	float fBlendMax = GetBlendMin(vReprojTC_Max.xy, IN.baseTC.xy, fAverSmoothness, fDepthMax, fDepthMaxPrev);

#if %_RT_QUALITY
	// rt stage 4B (decision 08 item 3) - the temporal filter for triangle-ray pixels.
	float3 vRTNbMin = 0, vRTNbMax = 0;
	if (bRTPixel)
	{
		// --- reprojection through the VIRTUAL REFLECTED POSITION --------------------------
		// What a mirror pixel shows is not the mirror, it is the virtual image of the hit, and
		// that image lies along THIS pixel own view ray at (surface distance + hit distance).
		// So the screen position the same content occupied last frame is the reprojection of
		// this pixel at the VIRTUAL depth, not at the surface depth. Reprojecting at the
		// surface depth - what the stock filter does - drags the reflection behind the camera;
		// that is report 02C finding (b), and the reason UpScalePS second temporal filter had
		// to be switched off for RT pixels. Neo calls the same quantity reflectedDepthScale
		// (research/03 section 4.6). SVO_ReprojectionMatrix IS the previous view-projection
		// composed with this frame inverse (D3D_SVO.cpp:1069 GetReprojectionMatrix), so handing
		// Reproject a different depth along the same view ray is exactly "project the virtual
		// point with the previous view-projection".
		//
		// As the lobe widens the virtual image stops being a point and the reflection starts
		// moving with the SURFACE instead, so the reprojection depth lerps back. One ramp,
		// RT_GetMirrorT, shared with the history length and with UpScalePS filter radius.
		const float fHitDist = max(refl_RAYDIR_REC.SampleLevel(ssSvoPointClamp, IN.baseTC.xy, 0).w, 0.f);
		const float fDepthVirt = saturate(fDepthC + fHitDist / max(PS_NearFarClipDist.y, 1e-3f));
		const float fDepthReproj = lerp(fDepthC, fDepthVirt, RT_GetMirrorT(fAverSmoothness));

		vReprojTC_Min = Reproject(IN.baseTC.xy, fDepthReproj, SVO_ReprojectionMatrix);
		vReprojTC_Max = vReprojTC_Min;

		// The rejection test still compares the REFLECTING surface own depth against the one
		// the history texel stored, because .w is what that texel stored: if the virtual
		// reprojection landed on a pixel whose surface was somewhere else, that history is
		// somebody else reflection. RT_GetGlossyBlend re-uses GetBlendMin depth-ratio and
		// off-screen tests over a roughness-dependent 1/frames base.
		const float fPrevDepthRT = tex2DlodLC(sceneRgbMinPrev, float4(vReprojTC_Min.xy, 0, 0)).w;
		fBlendMin = RT_GetGlossyBlend(vReprojTC_Min.xy, fAverSmoothness, fDepthC, fPrevDepthRT);
		fBlendMax = fBlendMin;

		// --- variance clamp ---------------------------------------------------------------
		// This frame 3x3 neighbourhood bounds what the history is allowed to be. Standard TAA
		// colour clipping, and the only thing between a one-sample-per-pixel GGX lobe and
		// visible ghosting when the reflected content changes. The DEM min/max pair carries the
		// clamped result downstream unchanged.
		const float2 vRTTexel = 1.f / PS_ScreenSize.xy;
		vRTNbMin = (float3)1e6f;
		vRTNbMax = (float3)(-1e6f);
		for (int nbx = -1; nbx <= 1; nbx++)
			for (int nby = -1; nby <= 1; nby++)
			{
				const float3 vNb = tex2DlodLC(sceneRgb, float4(saturate(IN.baseTC.xy + vRTTexel * float2(nbx, nby)), 0, 0)).xyz;
				vRTNbMin = min(vRTNbMin, vNb);
				vRTNbMax = max(vRTNbMax, vNb);
			}

	#if %_RT_PARTICLE_SHADOW
		// debug 14 = the raw 1 spp trace, temporal filter off (UpScalePS drops its spatial
		// filter for the same view, so 14 against 0 is exactly "what the denoiser removed").
		if ((int)VOX_RT_DEBUG_MODE == 14)
		{
			fBlendMin = 1.f;
			fBlendMax = 1.f;
		}
	#endif
	}
#endif

	// rt stage 2C: CE's +-8 is a ceiling on a UNIT-LENGTH chroma plus an ALD lobe, which never
	// gets near it. An RT pixel carries a real radiance in this channel now, and a reflected
	// window or practical clips at 8 and turns grey. Neo's clamp for the same data is 100
	// (neo:1114); use it for RT pixels only, so the stock path keeps its exact +-8.
#if %_RT_QUALITY
	const float fDemClamp = bRTPixel ? 100.f : 8.f;
#else
	const float fDemClamp = 8.f;
#endif

	// rt stage 4B: the history colour is read out into a local so the variance clamp can be
	// applied to it. Off %_RT_QUALITY this is the same fetch in the same place and the same
	// lerp, so the stock path is unchanged.
	float4 vHistRgbMin = tex2DlodLC(sceneRgbMinPrev, float4(vReprojTC_Min.xy, 0, 0));
	float4 vHistRgbMax = tex2DlodLC(sceneRgbMaxPrev, float4(vReprojTC_Max.xy, 0, 0));

#if %_RT_QUALITY
	if (bRTPixel)
	{
		vHistRgbMin.xyz = clamp(vHistRgbMin.xyz, vRTNbMin, vRTNbMax);
		vHistRgbMax.xyz = clamp(vHistRgbMax.xyz, vRTNbMin, vRTNbMax);
	}
#endif

	OUT.Diffuse = clamp(lerp(vHistRgbMin, OUT.Diffuse, fBlendMin), -fDemClamp, fDemClamp);
	OUT.Specular = clamp(lerp(tex2DlodLC(sceneAldMinPrev, float4(vReprojTC_Min.xy, 0, 0)), OUT.Specular, fBlendMin), -fDemClamp, fDemClamp);

	OUT.Diffuse1 = clamp(lerp(vHistRgbMax, OUT.Diffuse1, fBlendMax), -fDemClamp, fDemClamp);
	OUT.Specular1 = clamp(lerp(tex2DlodLC(sceneAldMaxPrev, float4(vReprojTC_Max.xy, 0, 0)), OUT.Specular1, fBlendMax), -fDemClamp, fDemClamp);

#if %_RT_QUALITY
	#if %_RT_PARTICLE_SHADOW
	// debug 15 = the temporal HISTORY weight, white = the pixel is all history, black = all
	// new. It answers the one question 14 cannot: whether the denoiser is smooth because it is
	// accumulating, or smooth because it is ghosting.
	if (bRTPixel && (int)VOX_RT_DEBUG_MODE == 15)
	{
		OUT.Diffuse.xyz = (float3)saturate(1.f - fBlendMin);
		OUT.Diffuse1.xyz = OUT.Diffuse.xyz;
	}
	#endif
#endif

	return OUT;
}

void ProcessLights(inout float4 vALD, inout float4 vRGB, in float3 vPos0, in float3 vNor0, in float fOffset, bool bSpec, float3 vReflection, float fSpecPow, float fLightRadMin, bool bAllowDynamicVoxels = true, bool bShadows = true, float fCustomSunConesLen = 0, bool bSkipSun = false)
{
#if %_RT_SAMPLE5

	for (int nLightId = 0; nLightId < 32; nLightId++)
	{
		float4 vPosR = 0, vDirF = 0, vCol = 0;

		if (!GetLightTI(nLightId, vPosR, vDirF, vCol))
			break;

		if (vPosR.w < fLightRadMin)
			continue;

		if (nLightId == 0 && bSkipSun && vPosR.w > 2000)
			continue;

		Ray r;
		r.direction = (vPosR.xyz - vPos0);
		float fDist = length(r.direction);
		if (fDist > vPosR.w)
			continue;

		r.direction = normalize(r.direction);

		float fNdotL = saturate(dot(vNor0, r.direction) + (1.f - length(vNor0)));

		if (fNdotL > 0)
		{
			float fFovAtt = 1.f;

			if (vDirF.w)
			{
				float fAngle = acos(dot(vDirF.xyz, -r.direction));
				float fAngleMax = (vDirF.w / 180.f * 3.14f / 2.f);
				fFovAtt = saturate((fAngleMax - fAngle) * 8.f);
			}

			if (fFovAtt > 0)
			{
				float fRayLen = min(fDist - fOffset * 2, min(fDist * .9f, fCustomSunConesLen ? fCustomSunConesLen : (VOX_CONE_MAX_LEN * 2)));

				if (length(vCol.xyz) < 0.01f)
					continue;

				if (bSpec)
				{
					float fPowAmount = sqrt(saturate(dot(vReflection, r.direction)));
					fPowAmount = saturate(pow(fPowAmount, fSpecPow * 255.f)) - 0.01;

					if (fPowAmount > 0)
					{
						r.startpoint = vPos0 + vNor0 * fOffset / 40 + r.direction * fOffset;

						float4 vPos1 = 0, vNor1 = 0;
						float4 vC = 0;
						if (vCol.a > 0 && bShadows)
							vC = ConeTraceTree(r, SvoParamsCommon.x, vPos1, vNor1, 0, fRayLen);

						float3 vColorAdd = fNdotL * (1.f - vC.a) * vCol.xyz * saturate(1.f - fDist / vPosR.w) * fFovAtt * fPowAmount;// * vShadowCol;

						float fSunBr = length(vColorAdd);
						vALD.xyz += fSunBr * r.direction;
						vALD.w += fSunBr;
						vRGB.xyz += vColorAdd;
					}
				}
				else
				{
					r.startpoint = vPos0 + vNor0 * fOffset / 3 + r.direction * fOffset;

					float4 vPos1 = 0, vNor1 = 0;

					float4 vC = 0;
					if (vCol.a > 0 && bShadows)
						vC = ConeTraceTree(r, SvoParamsCommon.x, vPos1, vNor1, 0, fRayLen);

					float3 vColorAdd = fNdotL * (1.f - vC.a) * vCol.xyz * saturate(1.f - fDist / vPosR.w) * fFovAtt;// * vShadowCol;

					if (vPosR.w < 5000) // if point light
						vColorAdd *= SvoParamsMisc2.x;

					float fSunBr = length(vColorAdd);
					vALD.xyz += fSunBr * r.direction;
					vALD.w += fSunBr;
					vRGB.xyz += vColorAdd;
				}
			}
		}
	}

#endif
}

#ifdef SVO_LMAPS

pixoutMRTTrace_NID_GS ConeTracePS_NID_GS(vtxOutWPOS IN)
{
	pixoutMRTTrace_NID_GS OUT = (pixoutMRTTrace_NID_GS)0;

	int nAtlasOffset = (int)IN.CamVec.w + .45;
	float3 tcMin = ComputeDataTC(nAtlasOffset);

	float4 voxAreaMin, voxAreaMax;
	ReadNodeCropBox(tcMin, voxAreaMin, voxAreaMax);

	IN.HPosition = mul(SVO_ViewProj, IN.baseTC);
	IN.HPosition /= IN.HPosition.w;
	IN.HPosition.xy = IN.HPosition.xy * 0.5f + 0.5f;
	IN.HPosition.y = 1 - IN.HPosition.y;
	IN.baseTC.xy = IN.HPosition.xy;

	float3 x0 = lerp(SVO_FrustumVerticesCam0, SVO_FrustumVerticesCam1, 1 - IN.baseTC.x);
	float3 x1 = lerp(SVO_FrustumVerticesCam3, SVO_FrustumVerticesCam2, 1 - IN.baseTC.x);
	IN.CamVec.xyz = lerp(x0, x1, IN.baseTC.y);

	// reconstruct position
	#if %_RT_SAMPLE3
	float3 vPos0 = GetWorldPos(SampleLinearDepth(sceneDepth, IN.baseTC.xy), IN.CamVec);
	#else
	float3 vPos0 = GetWorldPos(VOX_DEPTH_SCALE * SampleLinearDepth(sceneDepth, IN.baseTC.xy) - VOX_DEPTH_BIAS, IN.CamVec);
	#endif

	if (!IsPointInAABB(vPos0, voxAreaMin, voxAreaMax))
	{
		clip(-1);
		return OUT;
	}

	OUT.Diffuse.w = nAtlasOffset;
	OUT.Diffuse.x = 1.f / 255.f * (nAtlasOffset & 255);
	nAtlasOffset /= 256;
	OUT.Diffuse.y = 1.f / 255.f * (nAtlasOffset & 255);
	nAtlasOffset /= 256;
	OUT.Diffuse.z = 1.f / 255.f * (nAtlasOffset & 255);
	nAtlasOffset /= 256;
	return OUT;
}

bool ConeTraceBrick_LM(const float3 vRayStartPos, inout Ray r, const float _fDistanceIn, inout float fDistance, const float fDistanceMax,
                       inout float4 vPosOut, inout float4 vNormal, const float3 tcMin, inout float4 vRgbOut, const float fAlphaRef, const float fLodRatio,
                       const float fAlphaRefMin, const float fAlphaRefMax, const int nPredictionMode, const float fMultTriRT, const bool bAirOnlyMode, const bool bApplyGlobalDensity, const bool bSpecular)
{
	bool bRes = true;

	float4 voxAreaMin, voxAreaMax;
	ReadNodeCropBox(tcMin, voxAreaMin, voxAreaMax);
	const float ocNodeSize = voxAreaMin.w;

	const float3 vHalfTexSizeWS = 0.5f / VOX_BRICK_TEXRES * ocNodeSize;
	const float3 vBoxSize = voxAreaMax.xyz - voxAreaMin.xyz;

	float tmin = 0, tmax = 0;
	const float fSafetyBorder = 0.001f;
	//	const bool bHit = IntersectRayAABB(r, voxAreaMin.xyz-fSafetyBorder, voxAreaMax.xyz+fSafetyBorder, tmin, tmax);

	//if( bHit && (tmax>0))
	{
		const float3 vMulTC = 1.f / ocNodeSize * vBoxSize / VOX_ATLAS_SIZE * VOX_SUBBLOCK_SIZE_RATIO;

		float3 vNextTC = tcMin + ((clamp(r.startpoint, voxAreaMin + vHalfTexSizeWS, voxAreaMax - vHalfTexSizeWS) - voxAreaMin.xyz) / (vBoxSize)) * vMulTC;

		vRgbOut = tex3DlodLC(brickPool_Rgbs, float4(vNextTC.xyz, 0));

		vNormal = tex3DlodLC(brickPool_Norm, float4(vNextTC.xyz, 0));
	}

	return bRes;
}

void ConeTrace_LM_PS(in vtxOutWPOS IN, out float4 vALD, out float4 vRGB)
{
	float3 vPos0 = GetWorldPos(SampleLinearDepth(sceneDepth, IN.baseTC.xy), IN.CamVec);
	float fTransmittanceY = 0;
	float3 vNor0 = normalize(GetWorldSpaceNormals(IN.baseTC.xy, fTransmittanceY, normalize(IN.CamVec.xyz)).xyz);

	vALD = 0;
	vRGB = 0;

	float fNewDepth = SampleLinearDepth(sceneDepth, IN.baseTC.xy);

	int nAtlasOffset = tex2DlodPC(sceneSvoMap, float4(IN.baseTC.xy, 0, 0)).w;

	if (nAtlasOffset < 0 || tex2DlodPC(sceneSvoMap, float4(IN.baseTC.xy, 0, 0)).z)
	{
		vALD = float4(0, 0, 0, 0);
		vRGB = 0.1;
		vRGB.w = fNewDepth;
		return;
	}

	float3 tcMin = ComputeDataTC(nAtlasOffset);
	float4 voxAreaMin, voxAreaMax;
	ReadNodeCropBox(tcMin, voxAreaMin, voxAreaMax);

	float fOffset = voxAreaMin.w / 96;

	Ray r;
	r.direction = normalize(vNor0);
	r.startpoint = vPos0 + vNor0 * fOffset;

	float4 vRgbOut = 0;
	float fDistance = 0;
	float4 vPos1 = 0, vNor1 = 0;
	bool bCompleted = ConeTraceBrick_LM(r.startpoint, r, 0, fDistance, 8,
	                                    vPos1, vNor1, tcMin, vRgbOut, .9f, 1.8f,
	                                    0, 1, 0, 0, false, false, false);

	vALD = vNor1;
	vALD.xyz = vALD.xyz * 2 - 1;
	vALD /= max(vRgbOut.w, .01f);

	float4 vC = vRgbOut;
	vC /= max(vRgbOut.w, .01f);

	vRGB.xyz = (vC.xyz + .001);

	vRGB.w = fNewDepth;
}

#endif // SVO_LMAPS

pixoutMRTTrace ConeTracePS(vtxOutWPOS IN)
{
	pixoutMRTTrace OUT = (pixoutMRTTrace)0;

	float4 vALD = 0;
	float4 vRGB = 0;

#if %_RT_SAMPLE3
	#ifdef SVO_LMAPS
	ConeTrace_LM_PS(IN, vALD, vRGB);
	#endif
#else

	// reconstruct position
	float3 vPos0 = GetWorldPos(VOX_DEPTH_SCALE * SampleLinearDepth(sceneDepth, IN.baseTC.xy) - VOX_DEPTH_BIAS, IN.CamVec);

	float3 vNor0 = 0;
	float fAverSmoothness = 0;
	float fAverTransmittanceY = 0;
	float3 vAverReflectance = 0;
	float fDepthMin = 0, fDepthMax = 0;
	float3 vNorMin = 0, vNorMax = 0;
	GetAverNormAndSmooth(IN.baseTC.xy, vNor0, fAverSmoothness, fAverTransmittanceY, normalize(IN.CamVec.xyz), vAverReflectance, fDepthMin, fDepthMax, vNorMin, vNorMax);

	float fDistM = length(vPos0 - PS_WorldViewPos.xyz);

	//float fOffset = VOX_MIN_VOX_SIZE*2/3 + fDistM/96; // TODO: make cone trace func skip first 1-2 voxels instead of offset here

	float3 vFocus = IsDiffuseMode() ? vNor0 : reflect(normalize(IN.CamVec.xyz), vNor0);

#if %_RT_QUALITY
	// rt stage 2C. The RT decision is hoisted out of the trace loop so that (i) the kernel can
	// be replaced by the exact reflect direction before it is built, (ii) RT_GetFadedNormal can
	// call ddx/ddy from uniform control flow, and (iii) DemosaicPS / UpScalePS can recompute the
	// identical predicate from the identical inputs.
	const bool bUseRT = RT_IsTriPixel(fAverSmoothness, vAverReflectance, fDistM);

	// finding (a): triangle rays follow the DISTANCE-FADED normal, so a normal-mapped mirror
	// stops printing its detail map into the reflection as a grid. e_svoTI_RT_NormalsFading 0
	// (the default) leaves vFocusRT == vFocus and the picture unchanged.
	const float3 vNorRT = RT_GetFadedNormal(vPos0, vNor0, fDistM);
	float3 vFocusRT = reflect(normalize(IN.CamVec.xyz), vNorRT);

	// rt stage 4B (decision 08 item 1). Below VOX_RT_MIRROR_GLOSS the ray is ONE GGX
	// VISIBLE-NORMAL sample of the reflecting surface's own lobe instead of the mirror
	// direction, so a smoothness 0.6 floor reflects a blurred picture rather than a sharp one,
	// and the blur is the same GGX lobe shadeLib.cfi's SpecularBRDF uses for the direct view.
	// The estimator weight G2/G1 leaves this pass in the LENGTH of RayDir.xyz - see the g-data
	// write at the end of the function.
	//
	// The lobe is driven by fAverSmoothness, the same quantity RT_IsTriPixel, DemosaicPS and
	// UpScalePS key on, and NOT by the raw G-buffer smoothness. They differ only where the 2x2
	// quad's normals disagree, and there GetAverNormAndSmooth divides the smoothness by
	// 1 + normalVar*25 - i.e. it charges sub-pixel normal variance as extra roughness, which is
	// the Toksvig/LEAN answer and the right one for a ray that represents the whole pixel. It
	// also keeps all three passes on one number, which is what makes the single-tap
	// reconstruction legal at all (report 02C section 2).
	float fRTSampleWeight = 1.f;
	if (bUseRT && VOX_RT_GLOSSY_MODE > 0.f && fAverSmoothness < VOX_RT_MIRROR_GLOSS)
	{
		const int2 nRndXY = int2(IN.baseTC.xy * PS_ScreenSize.xy);
		const float4 vRnd = RT_BlueNoise4(nRndXY, SVO_FrameIdByte.x);
		vFocusRT = RT_GlossyReflectDir(vNorRT, -normalize(IN.CamVec.xyz), fAverSmoothness, vRnd, fRTSampleWeight);
	}
#endif

	float fNewDepth = SampleLinearDepth(sceneDepth, IN.baseTC.xy);

	int2 nXY = int2(IN.baseTC.xy * PS_ScreenSize.xy);

	int GI_DIFFUSE_KERNEL_TILING;
	GetDiffuseKernel(GI_DIFFUSE_KERNEL_TILING, 0);

	int x = nXY.x & (GI_DIFFUSE_KERNEL_TILING - (int)1);
	int y = nXY.y & (GI_DIFFUSE_KERNEL_TILING - (int)1);
	int i = x * GI_DIFFUSE_KERNEL_TILING + y;

	const int nFramesNum = (SVO_TargetResScale.w /*|| !IsDiffuseMode()*/) ? 1 : 2;

	// rt: dual tracing (%_RT_MOTION_BLUR) runs the kernel twice and averages. The software
	// triangle tracer cannot: g_rtInfo is one global hit record, so a second pass overwrites
	// the first pass' hit and the g-data handed to ShadePS would describe only the last ray.
	// On the RT permutation the pass count is therefore pinned to one. Without %_RT_QUALITY
	// this preprocesses to exactly the stock two lines.
	#if %_RT_MOTION_BLUR && !%_RT_QUALITY
	const int nPassesNum = 2;
	#else
	const int nPassesNum = 1;
	#endif

#if %_RT_QUALITY
	// rt stage 2: set when this pixel carries intermediate g-data for the ShadePass instead
	// of a final colour. Cleared again by any debug view, so a debug picture survives ShadePS.
	bool bRTWriteGData = false;
#endif

#if %_RT_QUALITY
	// rt: fxc cannot build this loop once the software triangle tracer (RT_TraverseTris, a
	// stack walk with a triangle loop inside it) is inlined next to the voxel cone trace:
	// it insists on unrolling the pass loop and then reports X3511 "unrolling failed" on the
	// body's size ([loop] only turns that into X3531). The pass count is one on this
	// permutation (see nPassesNum above), so the loop is peeled by hand into its single pass.
	// Without %_RT_QUALITY the stock `for` in the #else below is what compiles, unchanged.
	const int p = 0;
	{
#else
	for (int p = 0; p < nPassesNum; p++)
	{
#endif
		int s = (nFramesNum == 2) ? (int(SVO_FrameIdByte.x) & 1) : 0;
		s += p * nFramesNum;

		Ray r;

		const int nGiDiffuseSampleNum = GI_DIFFUSE_KERNEL_TILING * GI_DIFFUSE_KERNEL_TILING * 2;
		float3 kern = GetDiffuseKernel(GI_DIFFUSE_KERNEL_TILING, i + s * nGiDiffuseSampleNum / nFramesNum / nPassesNum);

		{
			// dual kernel
			half3x3 rotMat = 0;
			GetRotationV0(vFocus, rotMat);
			bool bRotate = dot(vFocus, float3(0, 0, 1)) > -0.999f;
			float3 kernOpa = GetDiffuseKernel(GI_DIFFUSE_KERNEL_TILING, i + s * nGiDiffuseSampleNum / nFramesNum / nPassesNum, false);

			if (nFramesNum == 2) // TODO: use rotation instead of flip
			{
				if (int(SVO_FrameIdByte.x / 2) & 1)
					kernOpa.x = -kernOpa.x;
				if (int(SVO_FrameIdByte.x / 2) & 2)
					kernOpa.y = -kernOpa.y;
			}

			kernOpa.z -= SvoParamsCommon.y;

			if (bRotate)
				kernOpa = normalize(mul(normalize(kernOpa), rotMat));
			else
				kernOpa = normalize(float3(kernOpa.x, kernOpa.y, -kernOpa.z));

#if %_RT_NO_TESSELLATION
			if (IsDiffuseMode())
				kern = lerp(kernOpa, kern, saturate(fAverTransmittanceY * 4));
			else
#endif
				kern = kernOpa;
		}

		half power;
		if (IsDiffuseMode())
		{
			//kern.z += SvoParamsCommon.y;
			power = 0;
		}
		else
		{
			// Fresnel
			//fAverSmoothness = lerp(fAverSmoothness, 1, pow(1 - dot(-normalize(IN.CamVec.xyz), vNor0), 2));

			power = exp2(10.h * fAverSmoothness + 1.h);

#if %_RT_QUALITY
			// rt stage 2C, finding (b). A triangle ray is a RAY, not a cone: it takes the exact
			// mirror direction and no per-pixel kernel jitter. CE's "kern += vFocus*power/25"
			// below is a stochastic gloss lobe whose offset comes from GetDiffuseKernel indexed
			// by the screen-space dither tile, so on a surface that falls just under the .95
			// knee it prints that tile into the reflection as a regular grid and blurs it. Neo
			// is categorical about it: for a mirror "kern = vFocus" unless _RTGI_GLOSSY_REFLECTIONS
			// is on (neo:1468-1472), and the glossy lobe is our stage 4.
			if (bUseRT)
				kern = vFocusRT;
			else
#endif
			if (fAverSmoothness < .95)
			kern += vFocus * power / 25;
			else
				kern = vFocus;
		}

		r.direction = normalize(kern);

		r.startpoint = vPos0;

		#if %_RT_TILED_SHADING && %_RT_NO_TESSELLATION
		  r.startpoint += (vFocus * fAverTransmittanceY) * (VOX_MIN_VOX_SIZE + fDistM*.025f);
		#endif

	#if !ORBIS
		#if %_RT_SAMPLE5 && !%_RT_LIGHTVOLUME1 && %_RT_LIGHTVOLUME0
		// rt stage 2C, finding (a)/(b): portal bending picks a portal with `i & 3`, i.e. with the
		// screen-space dither tile, and bends the ray toward it - another per-pixel grid printed
		// into the reflection, and geometrically wrong for a mirror in any case. It is a cone
		// tracing importance-sampling trick; a triangle ray does not get one.
		#if %_RT_QUALITY
		if (SvoTreeSettings5.y && !bUseRT)
		#else
		if (SvoTreeSettings5.y)
		#endif
		{
			float4 arrBestPortalPos[MAX_BEST_PORTALS];
			float4 arrBestPortalDir[MAX_BEST_PORTALS];
			FindBestPortals(vPos0, vNor0, arrBestPortalPos, arrBestPortalDir);

			float4 bestPortalPos = arrBestPortalPos[i & int(MAX_BEST_PORTALS - 1)];
			float3 lightPos = bestPortalPos;
			float lightSize = bestPortalPos.w;
			if (lightPos.z)
			{
				float3 vDir = normalize(lightPos - vPos0);
				float fDist = length(lightPos - vPos0);
				float fLerp = SvoTreeSettings5.y * saturate(fDist / lightSize) * pow(saturate(dot(vDir, vNor0.xyz)), .25) * saturate(abs(SvoParamsSkyColor.w));
				if (!IsDiffuseMode())
				{
					// reduce kernel distortion for mirrors
					fLerp *= 1 - saturate(fAverSmoothness) * saturate(GetLuminance(vAverReflectance));
				}
				r.direction = normalize(lerp(r.direction, vDir, fLerp));
			}
		}
		#endif
	#endif

		float4 vC = 0;

		float fRayLen;
	#if %_RT_LIGHTVOLUME1
		fRayLen = VOX_POST_AO_MAX_DIST; // in this mode we call ConeTraceTreeAndSky for near range AO info and for light bounces
	#else
		fRayLen = VOX_CONE_MAX_LEN;
	#endif

#if %_RT_QUALITY
		if (bUseRT)
		{
			// triangle rays get their own length budget, not the cone length
			fRayLen = VOX_MAX_RT_DIST_RAY;

			// R01 (decision 03 section 3.6): the G-buffer position sits within depth precision of the
			// triangle that produced it, so push the origin off the surface along the shading normal,
			// scaled with distance, instead of relying on the 1 mm hit epsilon alone.
			r.startpoint += normalize(vNor0) * max(0.002f, 0.0002f * fDistM);

			RT_ResetInfo(vFocusRT, VOX_MAX_RT_DIST_RAY, fDistM, RT_GetStippleAlphaRef(nXY), false);
		}
#else
		const bool bUseRT = false;
#endif

		vC = ConeTraceTreeAndSky(fRayLen, r, SvoParamsDiffuse.x + power / 10000, SvoParamsInject.z, bUseRT ? 1 : 0, false, false, bUseRT ? float3(0, 0, 0) : normalize(vNor0));

#if %_RT_QUALITY
		// rt stage 2: a hit (or a deliberate miss) leaves this pixel carrying g-data, which the
		// ShadePass turns into ALD + RGB. An `incomplete` traversal falls through to the voxel
		// cone result and is therefore NOT g-data (decision 03 section 3.5).
		bRTWriteGData = bUseRT && g_rtInfo.hitpos.w > 0 && !g_rtInfo.best.incomplete;

	#if %_RT_PARTICLE_SHADOW
		if (bUseRT)
		{
			if ((int)VOX_RT_DEBUG_MODE == 6)
			{
				// Debug view 6 = the stage-1 provisional colour (decision 06 section 6.5): the
				// triangle albedo substituted into CE's own "voxel radiance / voxel albedo"
				// irradiance trick. Kept as a view because it needs no light data at all, so it
				// still shows a picture when the ShadePass resources are wrong.
				if (bRTWriteGData && g_rtInfo.best.vAlb.a > 0)
				{
					const float3 vIrradiance = g_rtInfo.cellValid
						? RT_SampleVoxelIrradiance(g_rtInfo.cellTC, g_rtInfo.cellMin, g_rtInfo.cellMax, g_rtInfo.hitpos.xyz)
						: (float3)1.f;

					vC.xyz = g_rtInfo.albedo_smoothness.xyz * vIrradiance;
					vC.a = 1;
				}

				bRTWriteGData = false; // this pixel is final; ShadePS must leave it alone
			}
			else
			{
				float3 vDebug;
				if (RT_GetDebugColor(vDebug))
				{
					vC = float4(vDebug, 1);
					bRTWriteGData = false;
				}
			}
		}
	#endif
#endif

#if %_RT_NO_TESSELLATION
		vC *= lerp(1.f, SvoParamsInject.w, saturate(fAverTransmittanceY * 8));
#endif

		vC /= nPassesNum;

		float fBr = length(vC.xyz);
		vALD.xyz += r.direction * fBr;
		vALD.w += fBr;
		vRGB.xyz += vC.xyz;
	}

	vRGB.xyz += 0.001f;
	vRGB.w = fNewDepth;

#if %_RT_QUALITY
	// rt stage 2 (decision 06 section 6.1 / 6.6): a triangle-ray pixel carries g-data instead of
	// a colour, and the ShadePass overwrites ALD + RGB with the shaded result. The packing is
	// Neo's, so the two existing targets carry four of the six values:
	//   ALD.xyz = world normal scaled by (1 + emittance)   ALD.w = PackRGB(emissive hue) + 1,
	//                                                              negated for the veg-leaves model
	//   RGB.xyz = hit albedo                               RGB.w = UNTOUCHED scene linear depth
	// RGB.w stays the reflecting pixel's depth because that is what DemosaicPS reads out of this
	// channel (Total_Illumination.cfx:1066, 1073-1074) for its bilateral weights. Reflectance and
	// smoothness therefore ride in HitPos.w, not here (rt stage 2D).
	if (bRTWriteGData)
	{
		vALD.xyz = g_rtInfo.normal_emissive.xyz;
		vALD.w   = g_rtInfo.normal_emissive.w;
		vRGB.xyz = g_rtInfo.albedo_smoothness.xyz;

		// rt stage 2D: one 24 bit integer, no fractional field any more. Reflectance and
		// smoothness are both exact integers on the way out and on the way back, so the round
		// trip is deterministic and debug view 12 can show exactly what ShadePS will read.
		OUT.HitPos = float4(g_rtInfo.hitpos.xyz - GetWorldViewPos(),
		                    RT_PackHitMaterial(g_rtInfo.reflectance, abs(g_rtInfo.albedo_smoothness.w)));
		// rt stage 4B: the VNDF estimator weight rides in the LENGTH of RayDir.xyz. The lane
		// was free because the direction is unit by construction (RT_ProcessBestHit writes
		// rOrig.direction, which is normalize(kern)), the target is RGBA16F so a [0,1] scale
		// costs no precision the direction was not already losing, and ShadePS is the only
		// reader. The alternatives were HITGI.w (packing two values into one half, which would
		// have cost the voxel AO its precision) and a sixth MRT for one scalar.
		// With e_svoTI_RT_GlossyMode 0 the weight is exactly 1 and this line is the old line.
		OUT.RayDir = float4(g_rtInfo.raydir.xyz * fRTSampleWeight, g_rtInfo.raydir.w);

		// rt stage 5B: the shading tag and the per type parameters RT_ProcessBestHit resolved at
		// the hit. A miss writes zero, which decodes as "no material data".
		OUT.HitMat = g_rtInfo.matData;

		// rt stage 4A, energy audit error 1 + 2. The DIRECT view of a surface does not get the
		// env probe's ambient at all: ApplyGI mode 2 replaces it with the SVO's GI
		// (TiledShading.cfi:139-140). The hit used to get the full probe irradiance instead,
		// with occlusion hard-wired to (1,1) - a different indirect model AND no occlusion, which
		// between them are the dominant reason a reflected wall reads brighter than the wall.
		// So the hit gets the same thing the primary surface gets: a voxel irradiance fetch in
		// the cell the hit came from, plus a voxel AO, handed to ShadePS in a fifth target.
		// Unexposed, like TexGiDiffuse; ShadePS multiplies by PS_HDR_RANGE_ADAPT_MAX exactly
		// where ApplyGI would have.
		if (g_rtInfo.best.vAlb.a > 0 && g_rtInfo.cellValid)
		{
			OUT.HitGi = float4(RT_SampleVoxelIrradiance(g_rtInfo.cellTC, g_rtInfo.cellMin, g_rtInfo.cellMax, g_rtInfo.hitpos.xyz),
			                   RT_SampleVoxelAO(g_rtInfo.cellTC, g_rtInfo.cellMin, g_rtInfo.cellMax, g_rtInfo.hitpos.xyz, normalize(g_rtInfo.normal_emissive.xyz)));
		}
		else
		{
			// no cell (a miss, or a hit the traversal could not place): no GI, no occlusion.
			// A miss is resolved by the sky and never reads this lane.
			OUT.HitGi = float4(0, 0, 0, 1);
		}
	}
#endif

#endif

	OUT.Diffuse = vALD;
	OUT.Specular = vRGB;
	OUT.Specular.w = vRGB.w;

	return OUT;
}

///////////////////////////////////////////////////////////////////////////////////
// rt stage 2 - hit shading (decision 06). Sits between ConeTracePass and DemosaicPass on the
// specular target set and converts the g-data written above back into the ALD + RGB contract
// the rest of the stock SVO chain already speaks, so nothing downstream changes.
//
// !!! ShadePS aliases t0-t3 with the brick pools. It must never call an SVO tracing function.
// See the header of Total_Illumination_Shading.cfi. !!!
///////////////////////////////////////////////////////////////////////////////////

pixoutShade ShadePS(vtxOutWPOS IN)
{
	pixoutShade OUT = (pixoutShade)0;

	const float4 vGAL = refl_GAL.SampleLevel(ssSvoPointClamp, IN.baseTC.xy, 0);
	const float4 vGNO = refl_GNO.SampleLevel(ssSvoPointClamp, IN.baseTC.xy, 0);

	// pass-through for every pixel the tracer already shaded (voxel cone result, debug views,
	// pixels below the gloss threshold); ALD + RGB simply survive the pass unmodified
	OUT.vALD = vGAL;
	OUT.vRGB = vGNO;

#if %_RT_QUALITY
	const float4 vGPO = refl_GPO.SampleLevel(ssSvoPointClamp, IN.baseTC.xy, 0);
	const float4 vGLD = refl_GLD.SampleLevel(ssSvoPointClamp, IN.baseTC.xy, 0);

	// The sentinel is the hit distance, not Neo's hitpos.w: a hit smoothness of exactly 0 is
	// legal (a matte wall seen in a mirror) and would read as "not an RT pixel".
	if (vGLD.w > 0)
	{
		// "no hit" is encoded as an over-long distance; the ray direction is then flipped so the
		// probe lookup below reflects into the sky instead of into the surface, and albedo /
		// reflectance were forced to 1 by RT_ProcessBestHit so the probe term passes through
		// unmodified. That is the whole fallback-to-probes policy.
		const bool bNoHit = (vGLD.w >= GetMaxRayDistance() + 0.5f);

		// rt stage 4B (decision 08 item 1). The glossy VNDF estimator weight arrived in the
		// LENGTH of RayDir.xyz, so the direction has to be re-normalised before it is used.
		// FRESNEL IS NOT IN THE WEIGHT: TiledShading.cfi:951-953 multiplies TexGiSpecular by
		// the reflecting surface's envFresnel downstream, so the weight carries the
		// masking-shadowing ratio G2/G1 only and F0 is applied exactly once (report 02f / 04a
		// ledger). With e_svoTI_RT_GlossyMode 0 the tracer writes a unit vector and both lines
		// below are numerically the value they were before this stage.
		const float3 vRayDirN = normalize(vGLD.xyz);
		const float fSampleWeight = (VOX_RT_GLOSSY_MODE > 0.f) ? saturate(length(vGLD.xyz)) : 1.f;

		// rt stage 2D. HITPOS.w carries the hit's F0 and smoothness (RT_PackHitMaterial);
		// ALD.w carries the emissive hue code + 1, signed by the lighting model. Before 2D the
		// reflectance came through PackRGB at 3 bits per channel and CE's 0.0369 dielectric F0
		// quantised to exactly 0, so SpecularBRDF returned 0 at every non-metal hit and the
		// reflection had no specular response at all.
		float3 vReflectance; float fSmoothness;
		RT_UnpackHitMaterial(vGPO.w, vReflectance, fSmoothness);

		const float3 vEmmTint = RT_UnpackEmissiveHue(vGAL.w);

		// rt stage 5B (decision 10): the hit's material TYPE and its per type parameters.
		uint nMatCode; float fMatParam; bool bMatExtras;
		RT_UnpackHitMatCode(refl_GMAT.SampleLevel(ssSvoPointClamp, IN.baseTC.xy, 0).x, nMatCode, fMatParam, bMatExtras);
		const float3 vMatRgb = refl_GMAT.SampleLevel(ssSvoPointClamp, IN.baseTC.xy, 0).yzw;

		// The sign of the packed emissive hue is stage 2D's veg-leaves marker and is kept as the
		// fallback, so a record written before the tag existed still gets the two-sided model.
		const bool bTagVegLeaves = (nMatCode == VOX_RT_MATCODE_VEG_LEAVES) || (vGAL.w < 0);
		const bool bTagSkin      = (nMatCode == VOX_RT_MATCODE_HUMAN_SKIN);
		const bool bTagGlass     = (nMatCode == VOX_RT_MATCODE_GLASS);
		const bool bTagWater     = (nMatCode == VOX_RT_MATCODE_WATER);

		MaterialAttribsCommon commonAttribs = (MaterialAttribsCommon)0;
		commonAttribs.NormalWorld = normalize(vGAL.xyz);
		commonAttribs.Albedo      = vGNO.xyz;
		commonAttribs.Reflectance = vReflectance;
		commonAttribs.Smoothness  = fSmoothness;

		// VEGETATION LEAVES (tag 0.25) and HUMAN SKIN (tag 2) share CE's one forward answer to
		// "light comes through this surface": LIGHTINGMODEL_TRANSMITTANCE, which makes
		// Callback_ShadingDirect call ThinTranslucencyBRDF (shadeLib.cfi:952-964) INSTEAD OF the
		// diffuse BRDF - it is a substitution, not an addition, which is why the leaf is not
		// twice as bright as the trunk. The colour is the material's own now:
		//   Vegetation.cfx:503-512  saturate(BackDiffuseMultiplier * translucencyMap) * TransmittanceColor
		//   HumanSkin.cfx:286-298   exp((1 - saturate(translucencyMap * TranslucencyMultiplier)) * (-8, -40, -64))
		// Both are resolved per texel at the hit (RT_ProcessBestHit) and arrive in the HITMAT
		// float3. A leaf material whose record predates the extras keeps the old grey 0.5.
		//
		// SKIN IS THE FORWARD APPROXIMATION AND NOTHING MORE. CE's skin is
		// LIGHTINGMODEL_TRANSMITTANCE plus a SCREEN SPACE subsurface blur keyed on
		// attribs.ScatteringIndex (HumanSkin.cfx:288-293, resolved by the SSS stage). There is
		// no screen at a ray hit, so the blur cannot be reproduced; what is reproduced is the
		// transmittance term, which is the part that makes an ear glow red from behind.
		if (bTagVegLeaves || bTagSkin)
		{
			commonAttribs.LightingModel = LIGHTINGMODEL_TRANSMITTANCE;
			commonAttribs.Transmittance = bMatExtras ? (half3)vMatRgb : (half3)0.5f;
		}

		// GLASS (tag 3): Glass.cfx:575-586 shades the pane from its TINT, not from its albedo -
		// localTintColor is what the glass keeps of what is behind it, and the albedo only
		// appears through the backlight mask, which the hit has no equivalent of.
		// WATER (tag 4): the body colour computed at the hit (fog colour attenuated by
		// density x depth, Water.cfx:1116-1117) takes the albedo's place, so the sun and the
		// SVO GI light the water body the same way they light any other diffuse surface.
		if (bTagGlass || bTagWater)
			commonAttribs.Albedo = vMatRgb;

		ForwardShadingAttribs fwdAttribs = (ForwardShadingAttribs)0;
		fwdAttribs.screenUV        = IN.baseTC.xy;
		fwdAttribs.worldPos        = vGPO.xyz; // camera-relative, as everywhere in the forward stack
		fwdAttribs.normal          = commonAttribs.NormalWorld;
		fwdAttribs.normalSpecProbe = commonAttribs.NormalWorld;
		fwdAttribs.reflectance     = commonAttribs.Reflectance;
		fwdAttribs.albedo          = commonAttribs.Albedo;
		fwdAttribs.smoothness      = commonAttribs.Smoothness;

		fwdAttribs.custom.LightingModel = commonAttribs.LightingModel;
		fwdAttribs.custom.Transmittance = (commonAttribs.LightingModel == LIGHTINGMODEL_TRANSMITTANCE)
		                                  ? (float3)commonAttribs.Transmittance : (float3)0.f;
		// emittance rides in the LENGTH of the packed normal
		fwdAttribs.custom.Emittance     = max(length(vGAL.xyz) - 1.f, 0.f);
		fwdAttribs.custom.RayDirection  = bNoHit ? -vRayDirN : vRayDirN;
		// traced sun shadow rays are stage 4; the cascades do the work today
		fwdAttribs.custom.SunShadowRT   = 1.f;

		// rt stage 4A (energy audit item 7, decision 09 section 9.1). A ray that hit nothing is
		// looking at the sky, so it gets the ENGINE'S OWN sky along its direction - the same
		// Nishita dome (or skybox) the deferred sky pass draws, including the Mie peak that IS
		// the sun disc - and no sun / local-light loop at all. What it used to get was a fake
		// surface with F0 = 1 and smoothness 1 run through the full direct lighting, which put a
		// mirror-sharp second sun into every reflected sky.
		//
		// Below the horizon the sky texture says nothing useful (a lat-long dome is only defined
		// above it, and what is actually down there is ground the ray failed to reach inside
		// e_svoTI_RT_MaxDistRay), so a downward miss keeps the env-probe fallback with the
		// roughness mip exactly as before.
		float3 vSkyRadiance = (float3)0.f;
		const bool bMissSky = bNoHit && (vGLD.z > 0.f) && SVO_RT_SampleSky(vRayDirN, vSkyRadiance);

		// rt stage 5F (decision 09 section 9.2). VOLUMETRIC CLOUDS IN THE REFLECTION. The cloud
		// pass renders into a screen space target one stage LATER in the frame, so there is no
		// image of "the sky in this direction" to sample - only an image of the sky the camera
		// saw. A reflection ray leaves the camera's pixel, so the clouds have to be marched
		// again, in the reflected direction, out of the density field itself. That field is the
		// SAME one Clouds.cfx uses (CloudsCommon.cfi), at the same wind offset, under the same
		// cloud shadow map, so the cloud in the mirror is the cloud in the sky.
		//
		// The march starts at the REFLECTING SURFACE, not at the pseudo-hit the miss path puts
		// e_svoTI_RT_MaxDistRay metres down the ray: the layer is kilometres up, so the 48 m
		// difference is far below one step, but the surface is the physically right origin and
		// it is also the origin the optional on-a-hit mode needs a name for.
		//
		// bCloudsOnHit is OFF by default (SVO_CloudParams2.w = 0). When a distance is set, a hit
		// FURTHER away than that also gets the layer marched in front of it - the same veil a
		// very distant object gets in the direct view. It is off by default because inside
		// e_svoTI_RT_MaxDistRay (48 m) no hit is far enough for a cloud deck to sit in front of
		// it, so the steps would be spent for nothing.
		float3 vCloudInscatter = (float3)0.f;
		float  fCloudTrans = 1.f;
		bool   bCloudsOnHit = false;
		{
			const float3 vHitAbsCl = vGPO.xyz + GetWorldViewPos();
			const float3 vSurfaceAbsCl = vHitAbsCl - vRayDirN * abs(vGLD.w);
			bCloudsOnHit = (SVO_CloudParams2.w > 0.f) && !bNoHit && (abs(vGLD.w) >= SVO_CloudParams2.w);

			if (bMissSky || bCloudsOnHit)
				SVO_RT_MarchClouds(bCloudsOnHit ? vHitAbsCl : vSurfaceAbsCl, vRayDirN, vCloudInscatter, fCloudTrans);
		}

		// rt stage 5B, WATER (decision 09 section 9.4, decision 10 item 4 Water). What a water
		// surface shows is Water.cfx:1160
		//     cFinal = lerp(refractColor, cSpecularAcc, fFresnel)
		// with cSpecularAcc the reflection (Water.cfx:1053, a cubemap or the planar reflection,
		// times ReflectionScale) and fFresnel = GetEnvmapFresnel(0.02, FresnelGloss, NdotE)
		// (Water.cfx:1134-1135). v1 sends NO secondary ray: the reflection is the SAME sky
		// lookup the miss path already has, evaluated along the mirror of the incoming ray about
		// the water normal. A ray reflected DOWNWARD off water gets nothing from a lat-long
		// dome, so it keeps the ordinary probe specular instead.
		float3 vWaterRefl = (float3)0.f;
		bool bWaterSky = false;

		if (bTagWater && !bNoHit)
		{
			const float3 vWaterReflDir = reflect(vRayDirN, commonAttribs.NormalWorld);
			bWaterSky = (vWaterReflDir.z > 0.f) && SVO_RT_SampleSky(vWaterReflDir, vWaterRefl);
		}

		float3 diffuseAcc = 0.0f;
		float3 specularAcc = 0.0f;
		SRTShadeProbe dbgShade = (SRTShadeProbe)0;
		dbgShade.sunVisibility = 1;

		// rt stage 4A, energy audit errors 1 and 2: the indirect term at the hit is the SVO's own
		// GI, exactly as ApplyGI mode 2 gives it to the primary surface, not the env probe's full
		// irradiance with occlusion pinned to 1. Produced by TracingPS into the fifth g-data
		// target because it needs the brick pools; unexposed there, exposed inside
		// Fwd_StandardOpaqueShading_Raytracing where ApplyGI would have done it.
		const float4 vGGI = refl_GGI.SampleLevel(ssSvoPointClamp, IN.baseTC.xy, 0);

		// Water skips the SPECULAR PROBE when the sky answered: the probe specular and the sky
		// lookup below are two estimates of the same reflection and adding both doubles it.
		if (!bMissSky)
			Fwd_StandardOpaqueShading_Raytracing(commonAttribs, fwdAttribs, diffuseAcc, specularAcc, dbgShade, true, !bNoHit, !bNoHit, vGGI, bWaterSky);

		// rt stage 5B: the per tag composite. Tags 0 (Illum) and 5 (Terrain) - and 0.25 and 2,
		// whose whole difference is the lighting model the BRDF callback already switched on -
		// take the stock sum. Terrain deliberately has no branch: Terrain.cfx's own lighting IS
		// the Illum lobe, and the record carries no terrain normal map to apply.
		float3 vShaded = diffuseAcc + specularAcc;

		if (bTagGlass || bTagWater)
		{
			// GetEnvmapFresnel is what BOTH shaders use for this lerp: Glass.cfx:579 on the
			// material's own reflectance, Water.cfx:1135 on a hard coded 0.02 with FresnelGloss.
			// The hit's reflectance lane already IS that 0.02 for water (the CPU writes it) and
			// the material's own F0 for glass, so one expression covers both.
			const float3 vViewVec = normalize(-fwdAttribs.custom.RayDirection);
			const float fFres = GetEnvmapFresnel(fwdAttribs.reflectance, fwdAttribs.smoothness,
			                                     saturate(dot(commonAttribs.NormalWorld, vViewVec))).x;

			if (bTagGlass)
			{
				// Glass.cfx:576-586:
				//   tintBlend = lerp(cBackbuffer * tint, tint * diffuseAcc, TintCloudiness)
				//   cDiffuse  = lerp(tintBlend, litDiffuse, backlightMask)
				//   cFinal    = lerp(cDiffuse, cSpecular, fresnel)
				// cBackbuffer - what is BEHIND the pane - is not a value this branch has, and it
				// does not need one: the stochastic acceptance in the traversal already sends
				// the ray straight through the pane in (1 - opacity) of the stipple phases, so
				// the background half of tintBlend arrives as those other phases and the
				// temporal filter of stage 4B does the lerp. What is left here is the cloudy
				// half - the tint lit as a diffuse - and the specular, combined by CE's own
				// Fresnel. backlightMask is a forward-only screen term and is taken as 0.
				vShaded = lerp(diffuseAcc * fMatParam, specularAcc, fFres);
			}
			else if (bWaterSky)
			{
				// Water.cfx:1160, with refractColor collapsed to the lit body colour (v1 sends
				// no refraction ray) and cSpecularAcc replaced by the sky along the reflected
				// direction times ReflectionScale. specularAcc is the SUN highlight, which
				// Water.cfx adds on top of the reflection in the same way (SunSpecular,
				// Water.cfx:971-992).
				vShaded = lerp(diffuseAcc, vWaterRefl * fMatParam, fFres) + specularAcc;
			}
		}

		// rt stage 5F: the cloud layer sits BETWEEN the reflecting surface and the sky dome, so
		// it composites over the sky exactly the way CloudsBlendPS composites over the scene -
		// sky * transmittance + in-scatter - and it does so on the EXPOSED side of the pass,
		// before the single divide below, because both terms are already exposed (the cloud
		// radiance constants take GetSceneReferredExposure() on the CPU in
		// CVolumetricCloudsStage::GenerateCloudShaderParam, exactly as the sky constants do in
		// CSkyStage). With clouds off fCloudTrans is 1 and vCloudInscatter is 0, and this line
		// is the line it replaces.
		float3 acc = bMissSky
		             ? (vSkyRadiance * fCloudTrans + vCloudInscatter + .0001f)
		             : (vShaded + SVO_ShadeParams0.x * fwdAttribs.albedo + .0001f);

		// Emissive, exactly Illum.cfx IlluminationPS:
		//     emittance = MatEmissiveColor.rgb * MatEmissiveColor.w * MAT_EMISSIVE_UNIT_SCALE
		//                 * PS_HDR_RANGE_ADAPT_MAX * GetEmittanceMask(baseTC)
		// Emittance (the normal's length) and vEmmTint (hitpos.w's integer part) multiply back
		// to the first four factors times the mask; PS_HDR_RANGE_ADAPT_MAX is the one that was
		// missing. It has to be here, on the exposed side of the divide below, because the
		// divide + ApplyGI's multiply cancel and emissive would otherwise land one exposure
		// factor short of the same surface seen directly. NOT multiplied by albedo: that is
		// Neo's borrowed-hue trick for a scalar-only atlas, and we carry a real hue now.
		acc += fwdAttribs.custom.Emittance * vEmmTint * PS_HDR_RANGE_ADAPT_MAX;

		// rt stage 4A, energy audit error 3 / E4. Every VOXEL specular pixel is multiplied by
		// e_svoTI_SpecularAmplifier inside the cone trace (CommonSVO.cfi:1323-1328,
		// SvoParamsSpecular.w); an RT pixel never saw it, because the g-data write at the end of
		// ConeTracePS overwrites the traced colour wholesale. So on a level tuned with the
		// amplifier at, say, 0.3 - and it is a per-level Total Illumination setting, not a
		// constant - the RT reflections sat a flat 1/0.3 brighter than the voxel reflections
		// beside them, with a visible step at the e_svoTI_RT_MinGloss knee where the two meet.
		// Applied here, on the same value and in the same units, so the two halves of the picture
		// carry the same gain.
		//
		// It is a pure artistic gain on what is otherwise a radiance: A PHYSICALLY EXACT LEVEL
		// SHOULD SET e_svoTI_SpecularAmplifier TO 1. This multiply exists to keep RT and voxel
		// pixels consistent with each other, not because the gain is right.
		acc *= SvoParamsSpecular.w;

		// rt stage 4B: the Monte-Carlo estimator weight for the one GGX sample this pixel took.
		// It multiplies the WHOLE reflected radiance - a hit's shading and a miss's sky alike -
		// because it is the BRDF-over-pdf factor of the reflection integral, not a property of
		// what was hit. Exactly 1 for a mirror and in mirror-only mode.
		acc *= fSampleWeight;

		if (SVO_ShadeParams0.y) // debug: flat albedo
			acc = fwdAttribs.albedo;

		// rt stage 5E (decision 09 section 9.3): the fog terms of the REFLECTED SEGMENT are
		// COMPUTED here, before the debug block, and APPLIED after it - so that debug views 7-9
		// still show the shading term without a veil over it, and views 18/19 can show the fog
		// terms themselves. Nothing here touches `acc`.
		//
		// The analytic global fog is computed unconditionally and is the fallback: with
		// r_VolumetricFog 0 (or an interior with no global fog, or a frame where the fog stage
		// has no live volumes) SVO_VolFogParams.x is 0, the march is skipped, fFogCovered is 0
		// and what is applied below is byte for byte the lerp this pass has always done.
		float3 vFogInscatter = (float3)0.f;
		float  fFogTrans = 1.f;
		float  fFogCovered = 0.f;
		float4 vFogAnalytic = float4(0, 0, 0, 1);
		if (!bNoHit)
		{
			// Neo's vector, and the right one: the REFLECTED SEGMENT, not camera-to-hit. The fog
			// over the camera-to-mirror segment is applied to this pixel again downstream by the
			// scene fog pass (CFogStage / CVolumetricFogStage on the composited image), so
			// anything this pass adds for that segment would be counted twice. A MISS is not
			// fogged at all: its "hit distance" is the e_svoTI_RT_MaxDistRay sentinel, and a sky
			// or probe sample already carries its own aerial perspective.
			const float  fSegLen = abs(vGLD.w);
			const float3 cameraToWorldPos = vRayDirN * fSegLen;
			const float3 worldPos = vGPO.xyz + GetWorldViewPos();

			const SFogParams fogParams = GetFogParams();
			vFogAnalytic = GetVolumetricFogColor(fogParams, worldPos, cameraToWorldPos);

			if (SVO_VolFogParams.x > 0.f)
			{
				const float3 vSurfaceAbs = worldPos - cameraToWorldPos;
				const SVolumetricFogParams vfp = GetVolumetricFogParams();
				SVO_RT_MarchSegmentFog(vfp, vSurfaceAbs, vRayDirN, fSegLen, vFogInscatter, fFogTrans, fFogCovered);
			}
		}

		// rt stage 2C: debug views 7-9, the three questions the picture cannot answer on its own.
		// They sit HERE, before the fog and the writer clamp, so that what they show is the term
		// itself and not the term plus a veil. The exposure divide below and ApplyGI's multiply
		// cancel exactly, so a value of 1 written here reaches the screen as 1.
		bool bRawDebug = false;
#if %_RT_PARTICLE_SHADOW
		{
			const int nDbg = (int)VOX_RT_DEBUG_MODE;
			if (nDbg == 7)
			{
				// 7 = the sun shadow factor at the hit. WHITE = the hit sees the sun.
				acc = (float3)dbgShade.sunVisibility;
				bRawDebug = true;
			}
			else if (nDbg == 8)
			{
				// 8 = sun + local lights only, before any probe. What is left when this is
				// subtracted from view 0 is the probe ambient, which is the term the directly
				// seen surface does NOT get (ApplyGI mode 2 replaces it with the SVO result).
				acc = dbgShade.directAcc;
				bRawDebug = true;
			}
			else if (nDbg == 9)
			{
				// 9 = the raw accumulator: every light plus probes plus emissive, before the fog
				// lerp, before the writer clamp and before the exposure divide.
				bRawDebug = true;
			}
			else if (nDbg == 16)
			{
				// rt stage 5B. 16 = the SHADING TAG at the hit, as a flat colour. This is the
				// view that answers "is my glass actually tagged glass" before any argument
				// about what glass should look like:
				//   grey   0 Illum          green  0.25 vegetation leaves
				//   pink   2 human skin     cyan   3 glass
				//   blue   4 water          brown  5 terrain
				//   yellow 6 emissive only (reserved, the CPU never produces it)
				//   black    the pixel carries no material data at all (a miss)
				float3 vTagCol = (float3)0.f;
				if (nMatCode == VOX_RT_MATCODE_ILLUM)           vTagCol = float3(0.5f, 0.5f, 0.5f);
				else if (nMatCode == VOX_RT_MATCODE_VEG_LEAVES) vTagCol = float3(0.f, 1.f, 0.f);
				else if (nMatCode == VOX_RT_MATCODE_HUMAN_SKIN) vTagCol = float3(1.f, 0.5f, 0.6f);
				else if (nMatCode == VOX_RT_MATCODE_GLASS)      vTagCol = float3(0.f, 0.8f, 1.f);
				else if (nMatCode == VOX_RT_MATCODE_WATER)      vTagCol = float3(0.f, 0.15f, 1.f);
				else if (nMatCode == VOX_RT_MATCODE_TERRAIN)    vTagCol = float3(0.6f, 0.4f, 0.15f);
				else                                            vTagCol = float3(1.f, 1.f, 0.f);

				acc = bNoHit ? (float3)0.f : vTagCol;
				bRawDebug = true;
			}
			else if (nDbg == 17)
			{
				// rt stage 5B. 17 = does this hit's material have an EXTRAS record. White = yes
				// (detail map, blend layer, transmittance, glass / skin / water parameters),
				// black = a plain 4 texel record. A detail-mapped wall that reads black here is
				// a CPU-side problem (the producer did not emit extras) and not a shader one;
				// the "extras N" counter on the r_DisplayInfo 2 "RT BVH:" line is the other half
				// of the same question.
				acc = (bNoHit || !bMatExtras) ? (float3)0.f : (float3)1.f;
				bRawDebug = true;
			}
			else if (nDbg == 18)
			{
				// rt stage 5E. 18 = the fog IN-SCATTER added at the hit, i.e. the light the
				// reflected segment picks up on its way back to the mirror, in exposed radiance -
				// the same units view 0 is in, so a value that reads as mid grey here is a fog
				// contribution as bright as a mid grey surface. Black = this pixel's reflected
				// segment sits in clear air (or the froxel volume does not cover it and the
				// analytic fog is doing the work, which this view deliberately does NOT show).
				acc = vFogInscatter;
				bRawDebug = true;
			}
			else if (nDbg == 19)
			{
				// rt stage 5E. 19 = the TRANSMITTANCE of the reflected segment, the factor the
				// hit's own radiance is multiplied by. WHITE = clear air, the reflection arrives
				// undimmed; BLACK = the segment is optically thick and the reflection is pure
				// fog. GREEN tint = the froxel volume covered the segment; RED tint = it did not
				// and the analytic global fog is covering that share (off screen, behind the near
				// plane, or past the froxel range - see the gap list in
				// Total_Illumination_Shading.cfi). A mirror that is all red here is telling you
				// the froxel path never ran, not that there is no fog.
				acc = float3(1.f - fFogCovered, fFogCovered, 0.f) * 0.35f + (float3)fFogTrans * 0.65f;
				bRawDebug = true;
			}
			else if (nDbg == 20)
			{
				// rt stage 5F. 20 = the cloud IN-SCATTER the reflected ray picked up in the
				// cloud layer, in exposed radiance - the units view 0 is in. This is the cloud
				// itself, without the sky behind it, so a sunlit cumulus reads bright and the
				// clear sky between clouds reads black. If a mirror that clearly shows sky reads
				// black everywhere here, the march never ran: either the ray points below the
				// horizon, or the clouds stage bound nothing this frame (e_Clouds /
				// r_VolumetricClouds), or e_svoTI_RT_Clouds is 0.
				acc = vCloudInscatter;
				bRawDebug = true;
			}
			else if (nDbg == 21)
			{
				// rt stage 5F. 21 = the cloud TRANSMITTANCE along the reflected ray. WHITE =
				// clear sky, the dome behind the layer arrives undimmed; BLACK = an optically
				// thick cloud, the reflection is pure cloud. This is the cloud's SHAPE, and it is
				// the view to compare against the shape of the same cloud in the direct view:
				// they must be the same cloud in the same place and they must drift together.
				acc = (float3)fCloudTrans;
				bRawDebug = true;
			}
			else if (nDbg == 13)
			{
				// 13 = VALIDATOR C (energy audit section 5 / research 06 section 8, option C).
				// The one test the picture cannot argue with: for a hit that also happens to be
				// ON SCREEN, the reflected shading of that point and the DIRECT shading of the
				// same point must agree. Project the hit back through SVO_ViewProj, check the
				// depth buffer says the camera really sees that surface and not something in
				// front of it, and compare luminances in STOPS.
				//   black = agreement          red   = the reflection is N stops too BRIGHT
				//   blue  = not testable       green = the reflection is N stops too DARK
				//
				// Both sides are read in EXPOSED units and no exposure is applied to either:
				// `acc` here is pre-divide, i.e. already exposed, and $HDRTargetPrev is the
				// pre-exposed HDR target, so the ratio is exposure-free by construction.
				//
				// Two caveats, both real, both the reason this lives ONLY in a debug branch:
				// $HDRTargetPrev is the PREVIOUS frame (the camera has moved, so judge it on a
				// still frame), and reading a pre-exposed buffer back into SVO maths is exactly
				// what e_svoTI_SSDepthTrace is forced off for on the scene-referred path. This
				// value must never reach a non-debug path.
				const float3 vHitAbs = vGPO.xyz + GetWorldViewPos();
				float4 vProjTC = mul(SVO_ViewProj, float4(vHitAbs, 1));
				const bool bInFront = (vProjTC.w > 0);
				vProjTC /= vProjTC.w;
				vProjTC.xy = vProjTC.xy * 0.5f + 0.5f;
				vProjTC.y = 1.f - vProjTC.y;

				bool bTestable = bInFront && !bNoHit && all(vProjTC.xy == saturate(vProjTC.xy));

				if (bTestable)
				{
					const float fScrDepth = SampleLinearDepth(sceneDepth, vProjTC.xy) * PS_NearFarClipDist.y;
					const float fHitDepth = GetLinearDepth(g_PS_ProjRatio.y / (vProjTC.z - g_PS_ProjRatio.x)) * PS_NearFarClipDist.y;
					bTestable = abs(fScrDepth - fHitDepth) < max(0.05f, fHitDepth * 0.02f);
				}

				if (!bTestable)
				{
					acc = float3(0, 0, 0.25f);
				}
				else
				{
					const float3 vDirect = sceneTargetPrev.SampleLevel(ssSvoPointClamp, vProjTC.xy, 0).rgb;
					const float fStops = log2(max(GetLuminance(acc), 1e-6f) / max(GetLuminance(vDirect), 1e-6f));
					acc = (fStops > 0.f) ? float3(saturate(fStops), 0, 0) : float3(0, saturate(-fStops), 0);
				}

				bRawDebug = true;
			}
		}
#endif

		// Fog on the reflected segment, added BEFORE the exposure divide. Both sources are in
		// EXPOSED radiance: GetVolumetricFogColorInternal multiplies the authored fog colour by
		// PS_HDR_RANGE_ADAPT_MAX itself (VolumetricFog.cfi:154), and the froxel volume was
		// injected from a scattering colour the CPU pre-multiplied by GetSceneReferredExposure()
		// (VolumetricFog.cpp:2513). `acc` is built from already-exposed lights, so all three are
		// in the same units. The transmittances are unit free.
		//
		// THE FORMULA. S = the reflecting surface, H = the hit. What this pass owns is the
		// segment S->H and nothing else; the camera->S segment is fogged downstream by CFogStage /
		// CVolumetricFogStage on the composited image, so adding it here would count it twice.
		//
		//   acc  <-  acc * T_froxel + I_froxel          (the part of S->H the froxels covered)
		//   acc  <-  lerp(C_analytic, acc, T_analytic ^ (1 - covered))
		//
		// The second line is the leftover. The analytic fog's transmittance is exp2(-k * length),
		// so raising it to (1 - covered) is the analytic fog of exactly the uncovered share of
		// the segment - and when covered = 0 it collapses to T_analytic, i.e. to the lerp this
		// pass has always done. There is no double counting between the two: the froxel volume
		// already has the analytic global fog density injected into it
		// (VolumeLighting.cfi:2000 GetExponentialHeightFogDensity), so the two terms are
		// complementary shares of one segment, never the same share twice. The split is by
		// FRACTION, not by position, so an uncovered step in the middle is charged as if it were
		// at the far end; with fog this smooth that is below the noise of one GGX sample.
		//
		// A MISS is still not fogged: on a miss the "hit distance" is the e_svoTI_RT_MaxDistRay
		// sentinel and the hit position is a point that far along a ray that hit nothing, so the
		// lerp pulled a sky/probe colour a fixed fraction of the way towards the fog colour
		// everywhere at once - a flat grey veil over every part of the reflection that escaped.
		// A miss is resolved by the sky or the probes, and both carry their own aerial perspective.
		// rt stage 5F, the optional on-a-hit mode (off unless SVO_CloudParams2.w is set): the
		// cloud layer lies in front of a far enough hit, so it dims it and adds its own light,
		// the same composite the miss path does over the sky. It goes BEFORE the fog so that the
		// fog of the reflected segment still veils the whole thing.
		if (!bRawDebug && bCloudsOnHit)
			acc = acc * fCloudTrans + vCloudInscatter;

		if (!bRawDebug && !bNoHit)
		{
			acc = acc * fFogTrans + vFogInscatter;
			// the ternary is not cosmetic: with no froxel coverage this has to be the SAME
			// expression as before, not pow(x, 1), which is exp2(log2(x)) and not bit exact.
			const float fAnalyticTrans = (fFogCovered > 0.f)
			                             ? pow(max(saturate(vFogAnalytic.w), 0.0001f), 1.f - fFogCovered)
			                             : saturate(vFogAnalytic.w);
			acc = lerp(vFogAnalytic.xyz, acc, saturate(fAnalyticTrans));
		}

		// Neo clamps to a hard 8 here, which is roughly the top of the RGBM range the voxel
		// codec expects - a ceiling in UNEXPOSED units applied to an EXPOSED value. On the
		// scene-referred path the only meaningful ceiling is the fp16 writer clamp, applied
		// while the value is still exposed, exactly as Illum.cfx does it.
		if (!bRawDebug && SCENE_WRITER_CLAMP > 0)
			acc = min(acc, (float3)SCENE_WRITER_CLAMP);

		// decision 06 section 6.4: ApplyGI (TiledShading.cfi:105-142) is THE single pre-exposure
		// boundary for SVOGI, and everything downstream of this pass - DemosaicPS, UpScalePS,
		// GetSpecularFinRT - is in stock, unexposed units. Fwd_StandardOpaqueShading_Raytracing
		// returned EXPOSED radiance because CV_SunColor and the tiled light colours already carry
		// the aperture. Divide it back out here, once, so ApplyGI exposes it exactly once.
		// PS_HDR_RANGE_ADAPT_MAX is exactly 1.0 off the switch, so the stock path is unchanged.
		acc /= PS_HDR_RANGE_ADAPT_MAX;

		// output ALD + RGB in the shape DemosaicPS expects
		const float fBr = length(acc.xyz);

		OUT.vALD.xyz = vRayDirN * fBr;
		OUT.vALD.w   = fBr;

		OUT.vRGB.xyz = acc.xyz;
		OUT.vRGB.w   = vGNO.w; // scene linear depth of the reflecting pixel, untouched
	}
#endif

	return OUT;
}

pixout_RenderAtmosphere RenderAtmospherePS(vtxOutWPOS IN)
{
	pixout_RenderAtmosphere OUT = (pixout_RenderAtmosphere)0;

	MaterialAttribsCommon gbuffer = DecodeGBufferChannels(IN.baseTC.xy);

	float fDepth0 = SampleLinearDepth(sceneDepth, IN.baseTC.xy);
	float fDepthMin = fDepth0;
	float fDepthMax = fDepth0;

	float3 vPos0 = GetWorldPos(fDepth0, IN.CamVec);

	float3 ray_endpoint = vPos0;
	float3 ray_endpoint_min = ray_endpoint;
	float3 ray_endpoint_max = ray_endpoint;

	int nRange = int(SVO_TargetResScale.x); // TODO: SVO_TargetResScale.x is wrong!!!
	float2 vR = 1.f / PS_ScreenSize.xy / nRange;

	// find min/max depth ray end in the area
	for (int x = -nRange / 2; x <= nRange / 2; x++)
		for (int y = -nRange / 2; y <= nRange / 2; y++)
		{
			float2 tc = IN.baseTC.xy + vR * float2(x, y);

			float fDepth = SampleLinearDepth(sceneDepth, tc);

			if (fDepth < fDepthMin)
			{
				ray_endpoint_min = GetWorldPos(fDepth, IN.CamVec);
				fDepthMin = fDepth;
			}

			if (fDepth > fDepthMax)
			{
				ray_endpoint_max = GetWorldPos(fDepth, IN.CamVec);
				fDepthMax = fDepth;
			}
		}

	Ray r;
	r.startpoint = PS_WorldViewPos.xyz + float3(0, 0, .125);

	float fTraceMaxDist = 1024 * 4;
	float fDistanceMax = min(fTraceMaxDist, length(ray_endpoint_max - r.startpoint));
	float fDistanceMin = min(fTraceMaxDist, length(ray_endpoint_min - r.startpoint));

	r.direction = normalize(vPos0.xyz - PS_WorldViewPos.xyz);
	r.startpoint += r.direction / 10;

	float fLod = 2;

	OUT.SVO_Shadow.r = fDepthMin;
	OUT.SVO_Shadow.g = fDepthMax;

	fDistanceMin = min(fTraceMaxDist, length(ray_endpoint_min - r.startpoint));
	fDistanceMax = min(fTraceMaxDist, length(ray_endpoint_max - r.startpoint));

	{
		float4 vPos1 = 0, vNor1 = 0;
		float4 vAirMax = ConeTraceTree(r, fLod, vPos1, vNor1, fDistanceMin, fDistanceMax, 0.f, 1.f, 0, 0, SVO_TRACE_MODE_AIR, true, true); // air

		float4 vAirMin = vNor1;
		if (vAirMin.w == 0)
			vAirMin = vAirMax;
		if (fDepth0 != 1)
			vAirMin.xyz /= saturate(vAirMin.w + .001);
		OUT.Air_RGBA_Min.xyz = (vAirMin.xyz * SvoParamsSpecular.z);
		OUT.Air_RGBA_Min.w = vAirMin.w;

		if (fDepth0 != 1)
			vAirMax.xyz /= saturate(vAirMax.w + .001);
		OUT.Air_RGBA_Max.xyz = (vAirMax.xyz * SvoParamsSpecular.z);
		OUT.Air_RGBA_Max.w = vAirMax.w;
	}

	//	float3 lightDir=0;
	//	float4 vPosR=0, vDirF=0, vCol=0;
	//if(GetLightTI(0, vPosR, vDirF, vCol))
	//lightDir = normalize(vPosR-vPos0.xyz);

	if (fDistanceMax == fTraceMaxDist)
	{
		// add the sky
		//OUT.Diffuse.xyz += (1-OUT.Diffuse.w) * VOX_SKY_COLOR * 6;

		// add the sun spot on the sky
		//if(vPosR.w > SUN_LIGHT_RADIUS)
		{
			//			float fDotRef = .96;
			//		OUT.Diffuse.xyz += (1-OUT.Diffuse.w) * pow(saturate(dot(r.direction, lightDir)-fDotRef)/(1-fDotRef), 22) * vCol * 4;
		}

		//OUT.Diffuse.w = 1;
	}

	//OUT.Diffuse.w = 0;

	//if(vPosR.w > SUN_LIGHT_RADIUS)
	{
		/*#if !%_RT_SAMPLE0
		   if(fDistanceMax != fTraceMaxDist)
		   {
		   // air sun shadows
		   r.direction = lightDir;
		   r.startpoint = vPos0 + r.direction;

		   float4 vPos1=0, vNor1=0;
		   OUT.SVO_Shadow.a = saturate(1.f - ConeTraceTree(r, SvoParamsCommon.x, vPos1, vNor1, 0, 4000, 0.f, 1.f, 0, 0, false).a); // air
		   }
		   else
		 #endif*/
		OUT.SVO_Shadow.a = 1;
	}

	return OUT;
}

pixout_TraceSunShadows TraceSunShadowsPS(vtxOutWPOS IN)
{
	pixout_TraceSunShadows OUT = (pixout_TraceSunShadows)0;

	float fDepth0 = SampleLinearDepth(sceneDepth, IN.baseTC.xy);
	float fDepthMin = fDepth0;
	float fDepthMax = fDepth0;

	float3 vPos0 = GetWorldPos(fDepth0, IN.CamVec);

	int nRange = int(SVO_TargetResScale.x);
	float2 vR = 1.f / PS_ScreenSize.xy / nRange;

	// find min/max depth ray end in the area
	for (int x = -nRange / 2; x <= nRange / 2; x++)
	{
		for (int y = -nRange / 2; y <= nRange / 2; y++)
		{
			float2 tc = IN.baseTC.xy + vR * float2(x, y);

			float fDepth = SampleLinearDepth(sceneDepth, tc);

			if (fDepth < fDepthMin)
			{
				fDepthMin = fDepth;
			}

			if (fDepth > fDepthMax)
			{
				fDepthMax = fDepth;
			}
		}
	}

	OUT.SVO_Shadow = 1;

	if (fDepthMin < 1.f)
	{
		float fTransmittanceY = 0;
		const float3 vNor0 = normalize(GetWorldSpaceNormals(IN.baseTC.xy, fTransmittanceY, normalize(IN.CamVec.xyz)).xyz);

		float3 sunDir = 0;
		float4 vPosR = 0, vDirF = 0, vCol = 0;
		if (GetLightTI(0, vPosR, vDirF, vCol))
			sunDir = normalize(vPosR - vPos0.xyz);

		float3 arrPosMinMax[2] =
		{
			GetWorldPos(fDepthMin, IN.CamVec),
			GetWorldPos(fDepthMax, IN.CamVec)
		};

		// calculate dithered startpoint offset
		int2 nXY = int2(IN.baseTC.xy * PS_ScreenSize.xy);
		nXY.x = (nXY.x + (int(SVO_FrameIdByte.x) & 1)) & 1;
		nXY.y = (nXY.y + (int(SVO_FrameIdByte.x / 2) & 1)) & 1;
		float3 vOffset = sunDir * (0.5f * (float)nXY.x + 0.25f * (float)nXY.y);

		bool useDualDepth = (fTransmittanceY || dot(sunDir, vNor0) > 0);

		for (int i = 0; i < 2; i++)
		{
			float distance = length(arrPosMinMax[i] - PS_WorldViewPos.xyz);

			Ray r;
			r.direction = sunDir;
			r.startpoint = arrPosMinMax[i] + r.direction * 0.25f + vOffset * saturate(2.f - distance * 0.25f);

			// trace SVO, TODO: fix back face skipping
#if %_RT_TILED_SHADING
			float4 vPos1 = 0, vNor1 = 0;
			float3 vSurfNorm = (r.direction - normalize(IN.CamVec) * 0.5f);
			OUT.SVO_Shadow[i] = saturate(1.f - ConeTraceTree(r, SvoParamsCommon.x, vPos1, vNor1, 0, 63, 0.f, 1.f, 0, 0, 0, false, false, false, vSurfNorm, 0, 1.f).a);
#endif

			// trace heightmap
#if %_RT_QUALITY1 
			if (OUT.SVO_Shadow[i] > 0)
			{
				const int samplesNum = 64;
				const float maxShadowLen = 512.f; // in meters
				const float shadowHardness = 1.f / 10.f;

				const float texturePoolItemSizeScale = 1.f / 16.f; // 1.f / sqrt(e_TerrainTextureStreamingPoolItemsNum)
				const float3 worldToTc = float3(1.f / VOX_WORLD_SIZE * texturePoolItemSizeScale, 1.f / VOX_WORLD_SIZE * texturePoolItemSizeScale, 1.f);
				const float tcMin = 0.01 * texturePoolItemSizeScale;
				const float tcMax = 0.98 * texturePoolItemSizeScale;

				float3 vStepSize = r.direction / samplesNum * maxShadowLen;
				float3 vPos = arrPosMinMax[i] + vStepSize;
				vPos.z += distance * 0.001;
				vPos *= worldToTc;
				vStepSize *= worldToTc;

				for (int t = 0; t < samplesNum; t++)
				{
					float h = tex2DlodLC(levelHeightmap, vPos.yx).x;

					if (vPos.x > tcMin && vPos.x < tcMax && vPos.y >tcMin && vPos.y < tcMax)
						OUT.SVO_Shadow[i] = min(OUT.SVO_Shadow[i], saturate(1.f - (h - vPos.z) * shadowHardness));

					vPos += vStepSize;
				}
			}
#endif

			if (fDepthMin / fDepthMax > VOX_DEPTH_RANGE_THRESHOLD || !useDualDepth)
			{
				// skip second trace if min/max depths are close
				OUT.SVO_Shadow[1] = OUT.SVO_Shadow[0];
				break;
			}
		}

		OUT.SVO_Shadow[2] = fDepthMin;
		OUT.SVO_Shadow[3] = fDepthMax;
	}

	return OUT;
}

[numthreads(VOX_COMPUTE_NUM_THREADS, VOX_COMPUTE_NUM_THREADS, 1)]
void ComputeClearBricks(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint3 DTid : SV_DispatchThreadID, uint Gidx : SV_GroupIndex)
{
	int nNodeOffset = GetNodeRequestedForUpdate(Gid.x);
	if (nNodeOffset >= 0)
	{
		float3 vDataTC = ComputeDataTC(nNodeOffset);

		uint3 coord0 = vDataTC * float3(VOX_TEX_POOL_DIM);
		uint3 coord1 = coord0 + uint(VOX_BRICK_TEXRES);
		uint3 coord = coord0 + uint3(GTid.x, GTid.y, Gid.y);

		float4 pixel = 0;
		UAV_7[coord] = FlOAT4_TO_UINT(pixel);
		UAV_5[coord] = FlOAT4_TO_UINT(pixel);
		UAV_6[coord] = FlOAT4_TO_UINT(pixel);
		UAV_0[coord] = FlOAT4_TO_UINT(float4(.5, .5, .5, 0));

		UAV_3[coord] = UAV_4[coord];
	}
}

float noise(float3 q)
{
	float fVal = 0;
	fVal += tex2DlodLW(noiseMap2D, float4(q.xz, 0, 0)).g - .5;
	fVal += tex2DlodLW(noiseMap2D, float4(q.yz, 0, 0)).g - .5;
	fVal += tex2DlodLW(noiseMap2D, float4(q.xy, 0, 0)).g - .5;
	return fVal * 1.25f;
}

float MapCloudsInt(float3 vPos0)
{
	float3 q = vPos0 * VOX_TI_ATMO_CLOUDS_GEN_FREQ / float3(VOX_WORLD_SIZE, VOX_WORLD_SIZE, VOX_WORLD_SIZE / 2);

	float noq = noise(q * VOX_TI_ATMO_CLOUDS_TURB_FREQ);
	q.x += sin(noq) * VOX_TI_ATMO_CLOUDS_TURB_SCALE;
	q.z += cos(noq) * VOX_TI_ATMO_CLOUDS_TURB_SCALE;

	float f = 0;
	float k = .5;
	float f2 = 0;

	if (VOX_TI_ATMO_CLOUDS_GEN_FREQ)
		for (int p = 0; p < 4; p++)
		{
			float fNoise = noise(q);
			f += k * fNoise;
			f2 += k * fNoise;
			q = q * VOX_TI_ATMO_CLOUDS_GEN_FREQ_STEP;//2.02;

			float noq = noise(q * VOX_TI_ATMO_CLOUDS_TURB_FREQ);
			q.x += sin(noq) * VOX_TI_ATMO_CLOUDS_TURB_SCALE;
			q.y += cos(noq) * VOX_TI_ATMO_CLOUDS_TURB_SCALE;

			k *= VOX_TI_ATMO_CLOUDS_GEN_SCALE;
		}

	return (f);
}

float MapClouds(float3 vPos0, bool bFogVolumes)
{
	float f = MapCloudsInt(vPos0);

	float fcloudsLayerZ = VOX_TI_ATMO_CLOUDS_GEN_HEIGHT * 2 / 3;
	float fH = pow(saturate((abs(fcloudsLayerZ - vPos0.z) / (VOX_TI_ATMO_CLOUDS_GEN_HEIGHT / 3))), 4);

	float fXYBorder = VOX_WORLD_SIZE / 32;
	fH += saturate((fXYBorder - vPos0.x) / fXYBorder);
	fH += saturate((fXYBorder - vPos0.y) / fXYBorder);
	fH += 1.f - saturate((VOX_WORLD_SIZE - vPos0.x) / fXYBorder);
	fH += 1.f - saturate((VOX_WORLD_SIZE - vPos0.y) / fXYBorder);

	f = min(pow(saturate((f - fH - .35) / 1000), .75), .0025);

	if (bFogVolumes)
	{
		if (VOX_TI_ATMO_HEIGHT_LAYER0 > VOX_TI_ATMO_HEIGHT_GROUND)
			f = max(f, VOX_TI_ATMO_HEIGHT_LAYER0_DENS * saturate(1 - (VOX_TI_ATMO_HEIGHT_LAYER0_RAND * MapCloudsInt(vPos0 * 512 / (VOX_TI_ATMO_HEIGHT_LAYER0 - VOX_TI_ATMO_HEIGHT_GROUND))) - (vPos0.z - VOX_TI_ATMO_HEIGHT_GROUND) / (VOX_TI_ATMO_HEIGHT_LAYER0 - VOX_TI_ATMO_HEIGHT_GROUND)));
		else if (VOX_TI_ATMO_HEIGHT_LAYER0 < 0)
			f = max(f, VOX_TI_ATMO_HEIGHT_LAYER0_DENS * saturate(-VOX_TI_ATMO_HEIGHT_LAYER0 - vPos0.z));

		if (VOX_TI_ATMO_HEIGHT_LAYER1 > VOX_TI_ATMO_HEIGHT_GROUND)
			f = max(f, VOX_TI_ATMO_HEIGHT_LAYER1_DENS * saturate(1 - (VOX_TI_ATMO_HEIGHT_LAYER1_RAND * MapCloudsInt(vPos0 * 512 / (VOX_TI_ATMO_HEIGHT_LAYER1 - VOX_TI_ATMO_HEIGHT_GROUND))) - (vPos0.z - VOX_TI_ATMO_HEIGHT_GROUND) / (VOX_TI_ATMO_HEIGHT_LAYER1 - VOX_TI_ATMO_HEIGHT_GROUND)));
		else if (VOX_TI_ATMO_HEIGHT_LAYER1 < 0)
			f = max(f, VOX_TI_ATMO_HEIGHT_LAYER1_DENS * saturate(-VOX_TI_ATMO_HEIGHT_LAYER1 - vPos0.z));
	}

	return saturate(f);
}

[numthreads(VOX_COMPUTE_NUM_THREADS, VOX_COMPUTE_NUM_THREADS, 1)]
void ComputeInjectAtmosphere(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint3 DTid : SV_DispatchThreadID, uint Gidx : SV_GroupIndex)
{
	int nNodeOffset = GetNodeRequestedForUpdate(Gid.x);
	if (nNodeOffset >= 0)
	{
		float3 vDataTC = ComputeDataTC(nNodeOffset);
		float4 voxAreaMin, voxAreaMax;
		float fNodeFrameId = ReadNodeCropBox(vDataTC, voxAreaMin, voxAreaMax);

		// find region for update
		float3 vTC0, vTC1;
		PrepareBrickInjection(vDataTC, vTC0, vTC1);
		uint3 coord0 = saturate(vTC0) * VOX_TEX_POOL_DIM;
		uint3 coord1 = saturate(vTC1) * VOX_TEX_POOL_DIM;
		uint3 coord = coord0 + uint3(GTid.x, GTid.y, Gid.y);

		if ((coord.x <= coord1.x && coord.y <= coord1.y && coord.z <= coord1.z))
		{
			float4 pixOld = UINT_TO_FlOAT4(UAV_7[coord]);

			if (!pixOld.x && !pixOld.y && !pixOld.z)
			{
				float3 vPos0 = GetVoxCenter(coord, coord0, coord1, voxAreaMin, voxAreaMax);

				float f = 0;
				if (SvoParamsSpecular.z)
					f = saturate(MapClouds(vPos0, true));

				pixOld.a = sqrt(f);

				UAV_7[coord] = FlOAT4_TO_UINT(pixOld);
			}
		}
	}
}

[numthreads(VOX_COMPUTE_NUM_THREADS, VOX_COMPUTE_NUM_THREADS, 1)]
void ComputeDirectStaticLighting(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint3 DTid : SV_DispatchThreadID, uint Gidx : SV_GroupIndex)
{
	int nNodeOffset = GetNodeRequestedForUpdate(Gid.x);
	if (nNodeOffset >= 0)
	{
		float3 vDataTC = ComputeDataTC(nNodeOffset);
		float4 voxAreaMin, voxAreaMax;
		float fNodeFrameId = ReadNodeCropBox(vDataTC, voxAreaMin, voxAreaMax);

		// find region for update
		float3 vTC0, vTC1;
		PrepareBrickInjection(vDataTC, vTC0, vTC1);
		uint3 coord0 = saturate(vTC0) * VOX_TEX_POOL_DIM;
		uint3 coord1 = saturate(vTC1) * VOX_TEX_POOL_DIM;
		uint3 coord = coord0 + uint3(GTid.x, GTid.y, Gid.y);

		float4 pixel = UINT_TO_FlOAT4(UAV_2[coord]);

		if ((coord.x <= coord1.x && coord.y <= coord1.y && coord.z <= coord1.z))
		{
			// get geom normal
			float3 vNor0 = 0;

			// get world position
			float3 vPos0 = GetVoxCenter(coord, coord0, coord1, voxAreaMin, voxAreaMax);

			bool bFogVolumes = true;

			float4 vOPAC = LoadTexel(brickPool_Opac, coord);
			bool bAir = (!vOPAC.x && !vOPAC.y && !vOPAC.z);

			if (bAir)
			{

			}
			else
			{
				// get geom normal
				vNor0 = LoadTexel(brickPool_Norm, coord);
				vNor0.xyz = (vNor0.zyx - .5) * 2;
			}

			// compute normal from density
			/*float3 vNormD=0;
			   {
			   float4 pixel_c = UINT_TO_FlOAT4(UAV_2[coord]); // bad
			   float fSumm=0;
			   for(int x=-1; x<=1; x++)
			   for(int y=-1; y<=1; y++)
			   for(int z=-1; z<=1; z++)
			   {
			   int3 coord_n = coord+int3(x,y,z);
			   coord_n = clamp(coord_n, coord0, coord1);
			   float4 pixel_n = UINT_TO_FlOAT4(UAV_2[coord_n]);
			   vNormD += float3(x,y,z)*(pixel_c.w - pixel_n.w);
			   fSumm++;
			   }
			   if(length(vNormD.xyz)>.5)
			   vNormD = normalize(vNormD);
			   else
			   vNormD = 0;
			   }*/

			float4 vALD = 0;
			float4 vRGB = 0;

			bool bSunRsmSUccess = false;
			/*
			   float4 vSunPosR=0, vSunDirF=0, vSunCol=0;
			   GetLightTI(0, vSunPosR, vSunDirF, vSunCol);

			   // use sun RSM if possibe
			   if(dot(vNor0, normalize(vSunPosR.xyz - vPos0.xyz))>0.5 && vSunPosR.w>5000)
			   if(SVO_RsmSunCol.r || SVO_RsmSunCol.g || SVO_RsmSunCol.b)
			   {
			   float4 vShadTC = mul(SVO_RsmSunShadowProj, float4(vPos0.xyz + vNor0.xyz*voxAreaMin.w/VOX_BRICK_TEXRES/4 - PS_WorldViewPos.xyz, 1.f));

			   vShadTC.xy /= vShadTC.w;

			   float fFilerScale = 1;//(0.9 + 0.1*voxAreaMin.w / 1);

			   half4 vSunLightAlbedo = 0;

			   if(vShadTC.x >= 0 && vShadTC.x <= 1 && vShadTC.y >= 0 && vShadTC.y <= 1 && vShadTC.z <= 1)
			   {
			   for(int x=-1; x<=1; x++) for(int y=-1; y<=1; y++)
			   {
			   float2 tc = vShadTC.xy + float2(x,y) / 1024.f * fFilerScale;

			   float fShadowDepth = tex2DlodPC(rsmSunShadowMap, float4(tc,0,0)).r;

			   float fSunVis = saturate(1.f - abs(fShadowDepth - vShadTC.z - 0.00025)*1000 / fFilerScale);

			   vSunLightAlbedo.xyz += tex2DlodPC(rsmSunColorsMap, float4(tc,0,0)).xyz*fSunVis;

			   vSunLightAlbedo.w += 1.f;
			   }

			   vSunLightAlbedo /= vSunLightAlbedo.w;

			   if(length(vSunLightAlbedo)>.1)
			   {
			   vRGB.xyz = SVO_RsmSunCol.rgb;
			   pixel.xyz = vSunLightAlbedo;
			   }

			   bSunRsmSUccess = true;
			   }
			   }*/

			// cone-trace if RSM was not possibe
			{
				float fLength = length(vNor0);

#if %_RT_SAMPLE2
				if (fLength > 0.25 || !fLength)
#else
				if (fLength > 0.25)
#endif
					ProcessLights(vALD, vRGB, vPos0, fLength ? (vNor0 / fLength * 0.75) : 0, voxAreaMin.w / VOX_BRICK_TEXRES * 2, false, 0, 0, 1.f, false, true, 4000, bSunRsmSUccess);
			}

			vRGB.xyz *= SvoParamsInject.x;

			// add glow
			vRGB.xyz += pixel.w * SvoParamsMisc.x;

			// add bias
			vRGB.xyz += max(0, SvoParamsCommon.z * vSkyColorTop.z);

#if %_RT_LIGHTVOLUME0
			if (SvoTreeSettings5.x > 0)
			{
				float4 arrBestPortalPos[MAX_BEST_PORTALS];
				float4 arrBestPortalDir[MAX_BEST_PORTALS];
				FindBestPortals(vPos0, vNor0, arrBestPortalPos, arrBestPortalDir);

				for (int i = 0; i < MAX_BEST_PORTALS; i++)
				{
					float4 bestPortalPos = arrBestPortalPos[i];
					float3 lightPos = bestPortalPos;
					float lightSize = bestPortalPos.w;
					if (lightPos.z)
					{
						float3 vDir = normalize(lightPos - vPos0);
						float fDist = length(lightPos - vPos0);

						Ray r;
						r.direction = vDir;
						r.startpoint = vPos0;
						float4 vNor1 = 0;
						vRGB.xyz += ConeTraceTreeAndSkyEx(fDist, r, SvoParamsDiffuse.x, vNor1, 1.f, 0, false, false, true) * SvoTreeSettings5.x / 2 * saturate(fDist / lightSize);
					}
				}
			}
#endif

			if (bAir)
			{
#if %_RT_SAMPLE2
				float3 vAmb = 0;
				/*float fSky = saturate(vPos0.z-abs(VOX_TI_ATMO_HEIGHT_LAYER1));
				   if(fSky) // simple sky AO
				   {

				   // AO
				   float fAirAO = 1;
				   int nRange = 1;
				   float f = MapClouds(vPos0, false);
				   for(int x=-nRange; x<=nRange; x+=nRange*2)
				   for(int y=-nRange; y<=nRange; y+=nRange*2)
				   for(int z=-nRange; z<=nRange; z+=nRange*2)
				   fAirAO -= (MapClouds(vPos0 + float3(x,y,z) * 40, false))*100;
				   fAirAO = saturate(fAirAO);

				   vAmb = GetSkyColor(vNor0, 0) * fSky * fAirAO / 2;
				   }*/

				pixel = float4(vAmb + vRGB.xyz * VOX_AIR_ALBEDO_COLOR, 0);
#endif
			}
			else
			{
				pixel.xyz *= vRGB.xyz;
			}

			pixel.w = 0;

			pixel = EncodeHDR(pixel);

			UAV_7[coord] = FlOAT4_TO_UINT(pixel);
			UAV_6[coord] = FlOAT4_TO_UINT(pixel);
		}
	}
}

[numthreads(VOX_COMPUTE_NUM_THREADS, VOX_COMPUTE_NUM_THREADS, 1)]
void ComputeDirectDynamicLighting(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint3 DTid : SV_DispatchThreadID, uint Gidx : SV_GroupIndex)
{
	int nNodeOffset = GetNodeRequestedForUpdate(Gid.x);
	if (nNodeOffset >= 0)
	{
		float3 vDataTC = ComputeDataTC(nNodeOffset);
		float4 voxAreaMin, voxAreaMax;
		float fNodeFrameId = ReadNodeCropBox(vDataTC, voxAreaMin, voxAreaMax);

		// find region for update
		float3 vTC0, vTC1;
		PrepareBrickInjection(vDataTC, vTC0, vTC1);
		uint3 coord0 = saturate(vTC0) * VOX_TEX_POOL_DIM;
		uint3 coord1 = saturate(vTC1) * VOX_TEX_POOL_DIM;
		uint3 coord = coord0 + uint3(GTid.x, GTid.y, Gid.y);

		float4 pixel = UINT_TO_FlOAT4(UAV_2[coord]);

		float4 vOPAC = LoadTexel(brickPool_Opac, coord);
		bool bAir = (!vOPAC.x && !vOPAC.y && !vOPAC.z);

		if (!bAir)
			if ((coord.x <= coord1.x && coord.y <= coord1.y && coord.z <= coord1.z))
			{
				// get geom normal
				float3 vNor0 = 0;

				// get world position
				float3 vPos0 = GetVoxCenter(coord, coord0, coord1, voxAreaMin, voxAreaMax);

				bool bFogVolumes = true;

				// compute geom normal
				//				vNor0 = LoadTexel( brickPool_Norm,  coord );
				//			vNor0.xyz = (vNor0.zyx-.5)*2;

				float4 vALD = 0;
				float4 vRGB = 0;

				//			float fLength = length(vNor0);
				//			if(fLength > 0.25)

				if (length(vPos0.xyz - SVO_CamPos.xyz) < 24)
				{
					ProcessTiledLights(vRGB, vPos0, 0, voxAreaMin.w / VOX_BRICK_TEXRES);

#if %_RT_AMBIENT_OCCLUSION
					// additional sun RSM inject
					if (voxAreaMin.w <= VOX_MIN_NODE_SIZE * SVO_RsmSunDir.w)
					{
						if (SVO_RsmSunCol.r || SVO_RsmSunCol.g || SVO_RsmSunCol.b)
						{
							float4 vShadTC = mul(SVO_RsmSunShadowProj, float4(vPos0.xyz + vNor0.xyz * voxAreaMin.w / VOX_BRICK_TEXRES / 4 + SVO_RsmSunDir.xyz * voxAreaMin.w / VOX_BRICK_TEXRES - PS_WorldViewPos.xyz, 1.f));
							vShadTC.xy /= vShadTC.w;

							if (vShadTC.x >= 0 && vShadTC.x <= 1 && vShadTC.y >= 0 && vShadTC.y <= 1 && vShadTC.z <= 1)
							{
								float fShadowDepth = tex2DlodPC(rsmSunShadowMap, float4(vShadTC.xy, 0, 0)).r;
								half3 vMatNormal = tex2DlodPC(rsmSunNormalMap, float4(vShadTC.xy, 0, 0)).rgb;

								if (dot(vMatNormal, 1) < 0.01)
									vMatNormal = float3(0, 0, 1); // terrain
								else
									vMatNormal = vMatNormal * 2 - 1;

								vRGB.xyz += SVO_RsmSunCol.xyz * (fShadowDepth > vShadTC.z) * saturate(dot(vMatNormal.xyz, SVO_RsmSunDir.xyz));
							}
						}
					}
#endif    // _RT_AMBIENT_OCCLUSION
				}

				{
					pixel.xyz *= vRGB.xyz * SvoParamsInject.x;
				}

				float4 pixOld = UINT_TO_FlOAT4(UAV_5[coord]);
				pixOld.xyz = DecodeHDR(pixOld);
				pixOld.w = 0;
				pixOld.xyz = max(pixel.xyz, pixOld.xyz);
				pixOld = EncodeHDR(pixOld);
				UAV_7[coord] = FlOAT4_TO_UINT(pixOld);
			}
	}
}

[numthreads(VOX_COMPUTE_NUM_THREADS, VOX_COMPUTE_NUM_THREADS, 1)]
void ComputePropagateLighting(uint3 Gid : SV_GroupID, uint3 GTid : SV_GroupThreadID, uint3 DTid : SV_DispatchThreadID, uint Gidx : SV_GroupIndex)
{
	int nNodeOffset = GetNodeRequestedForUpdate(Gid.x);
	if (nNodeOffset >= 0)
	{
		float3 vDataTC = ComputeDataTC(nNodeOffset);
		float4 voxAreaMin, voxAreaMax;
		float fNodeFrameId = ReadNodeCropBox(vDataTC, voxAreaMin, voxAreaMax);

		// find region for update
		float3 vTC0, vTC1;
		PrepareBrickInjection(vDataTC, vTC0, vTC1);
		uint3 coord0 = saturate(vTC0) * VOX_TEX_POOL_DIM;
		uint3 coord1 = saturate(vTC1) * VOX_TEX_POOL_DIM;

		uint3 coord = coord0 + uint3(GTid.x, GTid.y, Gid.y);

		float4 pixel = LoadTexel(brickPool_Rgbs, coord);

		pixel.xyz = DecodeHDR(pixel);
		pixel.w = 0;

		float4 vOPAC = LoadTexel(brickPool_Opac, coord);
		const bool bSolid = (vOPAC.x || vOPAC.y || vOPAC.z);

#if !%_RT_SAMPLE2
		if (!bSolid)
			return;
#endif

		const int nPassId = SvoParamsMisc.y;
		const int nPassesNum = SvoParamsMisc.z;

		if (SvoParamsInject.y && (coord.x <= coord1.x && coord.y <= coord1.y && coord.z <= coord1.z))
		{
			// get world normal
			float3 vNor0 = LoadTexel(brickPool_Norm, coord);
			vNor0.xyz = 2 * (vNor0.zyx - 0.5f);

			if (!bSolid)
				vNor0 = float3(0, 0, 1);
			else
			{
				/*
				   float3 vNormD = 0;

				   float pixel_c = tex3DlodLC(brickPool_Norm, vTC).w;

				   for (int x = -1; x <= 1; x++)
				   for (int y = -1; y <= 1; y++)
				    for (int z = -1; z <= 1; z++)
				    {
				      int3 coord_n = coord + int3(x, y, z);

				      if (coord_n.x <= coord1.x && coord_n.y <= coord1.y && coord_n.z <= coord1.z)
				        if (coord_n.x >= coord0.x && coord_n.y >= coord0.y && coord_n.z >= coord0.z)
				        {
				          float4 vTC_N = float4(1.f / VOX_TEX_POOL_DIM * coord_n.xyz + 0.5f / VOX_TEX_POOL_DIM, 0);

				          float pixel_n = tex3DlodLC(brickPool_Norm, vTC_N).w;

				          vNormD += float3(x, y, z)*(pixel_c - pixel_n);
				        }
				    }

				   vNormD /= 16;

				   if (length(vNormD) > length(vNor0))
				   vNor0.xyz = normalize(vNormD);
				 */

				if (length(vNor0) < .25)
					return;

				vNor0.xyz = normalize(vNor0.xyz);
			}

			// get world position
			float3 vPos0 = GetVoxCenter(coord, coord0, coord1, voxAreaMin, voxAreaMax);

			float fVoxSize = voxAreaMin.w / VOX_BRICK_TEXRES;

			half3x3 rotMat = 0;
			GetRotationV0(vNor0, rotMat);

			float3 vCollectedLight = 0;
			float4 vCollectedALD = 0;

			{
				half2x2 mSampleRotMat;
				if (bSolid)
					GetRndRotationMat(vPos0 + nPassId, vNor0, mSampleRotMat);
				else
					GetRndRotationMat(vPos0 + vPos0.z, vNor0, mSampleRotMat);

#if %_RT_HW_PCF_COMPARE
				const int nSampleNum = 16;
#else
				const int nSampleNum = 32;
#endif

				for (int s = 0; s < nSampleNum; s++)
				{
					float3 kern;

#if %_RT_HW_PCF_COMPARE
					if (bSolid)
						kern = kernel_HS_16[s];
					else
						kern = kernel_S_16[s];
#else
					if (bSolid)
						kern = kernel_HS_32[s];
					else
						kern = kernel_S_32[s];
#endif

					// apply random rotation
					kern.xy = mul(kern.xy, mSampleRotMat);

					Ray r;
					if (bSolid)
						r.direction = mul(normalize(kern), rotMat);
					else
						r.direction = kern;

					r.startpoint = vPos0 + vNor0 * fVoxSize * 2 + r.direction * fVoxSize * 1.5f;

					float fConeSev = SvoParamsDiffuse.x; // .1f;

					float4 vNor1 = 0;

					float4 vC = ConeTraceTreeAndSkyEx(VOX_CONE_MAX_LEN, r, fConeSev, vNor1, 1.f, 0, false, false, nPassId == 0);

					vCollectedLight += vC;

					vCollectedALD.xyz += length(vC.xyz) * r.direction;
					vCollectedALD.w += length(vC.xyz);
				}

				if (bSolid)
					vCollectedLight /= nSampleNum;
				else
					vCollectedLight /= nSampleNum;///2;

				vCollectedALD /= nSampleNum;
			}

			// desaturate
			vCollectedLight.xyz = lerp((vCollectedLight.x + vCollectedLight.y + vCollectedLight.z) / 3, vCollectedLight.xyz, SvoParamsInject.z);

			RWTexture3D<uint> UAV_Albedo = UAV_0;
			RWTexture3D<uint> UAV_Direct = UAV_1;
			RWTexture3D<uint> UAV_Popag1 = UAV_2;
			RWTexture3D<uint> UAV_Popag2 = UAV_3;
			RWTexture3D<uint> UAV_Out = UAV_5;
			RWTexture3D<uint> UAV_OutDir = UAV_6;
			RWTexture3D<uint> UAV_DYNL = UAV_7;

			float4 vAlbedo = UINT_TO_FlOAT4(UAV_Albedo[coord]);
			if (!bSolid)
				vAlbedo = VOX_AIR_ALBEDO_COLOR;

#if %_RT_SAMPLE3
			//			vCollectedLight *= SvoParamsInject.y;
#else
			vCollectedLight *= vAlbedo.xyz;// * SvoParamsInject.y;
#endif

			vCollectedLight.xyz = pow(vCollectedLight.xyz, SvoParamsInject.y); // helps to propagate bounces furter

			if ((nPassId == 0) && (nPassesNum == 1))
			{
				// single propagation pass
#if %_RT_SAMPLE3
				pixel.xyz = vCollectedLight.xyz;
#else
				pixel.xyz = (pixel.xyz + vCollectedLight);
#endif
			}
			else if ((nPassId == 0) && (nPassesNum == 2))
			{
				// first of two passes
				pixel.xyz = vCollectedLight;
			}
			else if ((nPassId == 1) && (nPassesNum == 2))
			{
				// second of two passes
				pixel.xyz = (pixel.xyz + vCollectedLight);

#if %_RT_SAMPLE3
				pixel.xyz = pixel.xyz;
#else
				pixel.xyz = (pixel.xyz + DecodeHDR(UINT_TO_FlOAT4(UAV_Direct[coord])));
#endif
			}

			pixel = EncodeHDR(pixel);

			UAV_Out[coord] = FlOAT4_TO_UINT(pixel);
			UAV_DYNL[coord] = FlOAT4_TO_UINT(pixel);

#if %_RT_SAMPLE3
			{
				vCollectedALD.xyz = vCollectedALD.xyz * .75 + .5;
				UAV_OutDir[coord] = FlOAT4_TO_UINT(vCollectedALD);

				for (int x = -1; x <= 1; x++)
					for (int y = -1; y <= 1; y++)
						for (int z = -1; z <= 1; z++)
						{
							int3 coord_n = coord + int3(x, y, z);
							if (coord_n.x <= coord1.x && coord_n.y <= coord1.y && coord_n.z <= coord1.z)
								if (coord_n.x >= coord0.x && coord_n.y >= coord0.y && coord_n.z >= coord0.z)
								{
									float4 vOldRGB = UINT_TO_FlOAT4(UAV_Out[coord_n]);
									float4 vOldALD = UINT_TO_FlOAT4(UAV_OutDir[coord_n]);

									float4 pixel_N = tex3DlodLC(brickPool_Rgbs, float4(1.f / VOX_TEX_POOL_DIM * coord_n.xyz + 0.5f / VOX_TEX_POOL_DIM, 0));

									if (vCollectedALD.w > vOldALD.w && pixel_N.w == 0)
									{
										UAV_Out[coord_n] = FlOAT4_TO_UINT(pixel);
										UAV_OutDir[coord_n] = FlOAT4_TO_UINT(vCollectedALD);
									}
								}
						}
			}
#endif
		}
	}
}

#ifdef SVO_LMAPS

vert2FragGeneral VoxelRayTraceVS_GS(app2vertGeneral IN)
{
	vert2FragGeneral OUT = (vert2FragGeneral)0;

	streamPos vertPassPos = (streamPos)0;

	OUT.vView.xyz = g_VS_WorldViewPos.xyz;
	OUT.vView.w = IN.vertCommon.baseTC.x;

	OUT.HPosition.xyz = IN.vertCommon.Position.xyz;
	OUT.HPosition.w = 1.0f;

	OUT.screenProj.x = IN.vertCommon.baseTC.x;
	OUT.screenProj.y = 1 - IN.vertCommon.baseTC.y;

	float fNodeSize = IN.vertCommon.baseTC.y;
	OUT.baseTC.x = IN.vertCommon.Color.r * fNodeSize;
	OUT.baseTC.y = IN.vertCommon.Color.g * fNodeSize;
	OUT.baseTC.z = IN.vertCommon.Color.b * fNodeSize;
	OUT.baseTC.w = IN.vertCommon.Color.a;

	return OUT;
}

[maxvertexcount((2 + 4 * 2) + 4 * 2)]
void BoxGenGS_GS(point vert2FragGeneral InPos[1], inout TriangleStream<vtxOutWPOS> SpriteStream)
{
	vtxOutWPOS OUT = (vtxOutWPOS)0;

	#if !%_RT_SAMPLE3
	if (SVO_PassId_VS.x == 0 && InPos[0].baseTC.w < SVO_PassId_VS.w) // skip non opac bricks for layer 0
		return;
	#endif

	float4 vWorldPos;
	vWorldPos.xyz = InPos[0].HPosition.xyz;// -g_VS_WorldViewPos.xyz;
	vWorldPos.w = 1.0f;

	OUT.baseTC.w = 1.0f;

	OUT.CamVec.w = InPos[0].vView.w;

	float3 vBoxSize = InPos[0].baseTC.xyz;

	for (int v = 0; v < 18; v++)
	{
		OUT.HPosition = vWorldPos;

		OUT.HPosition.xyz += box_expansion[v] * vBoxSize;

		OUT.CamVec.xyz = OUT.HPosition.xyz - g_VS_WorldViewPos.xyz;

		OUT.baseTC = OUT.HPosition; // box vertex pos WS

		OUT.HPosition = mul(g_VS_ViewProjMatr, OUT.HPosition); // transform into screen space

		//OUT.baseTC.xy = (OUT.HPosition.xy / OUT.HPosition.w / 2 + .5);

		if (v == 10 || v == 14)
			SpriteStream.RestartStrip();

		SpriteStream.Append(OUT);
	}

	SpriteStream.RestartStrip();
}

#endif // SVO_LMAPS

pixoutMRTUpscale UpScalePS(vtxOutWPOS IN)
{
	pixoutMRTUpscale OUT = (pixoutMRTUpscale)0;

	const float fDepthRange = .12;
	const float fDotMax = .20;
	const float fDepthC = SampleLinearDepth(sceneDepth, IN.baseTC.xy);
	const float fDepthClampMin = 4.f / PS_NearFarClipDist.y;
	float fTransmittanceY = 0;
	const float3 vNor0 = normalize(GetWorldSpaceNormals(IN.baseTC.xy, fTransmittanceY, normalize(IN.CamVec.xyz)).xyz);

	float3 vFocus = IsDiffuseMode() ? vNor0 : reflect(normalize(IN.CamVec.xyz), vNor0);

	float4 vRGB = 0;
	float4 vALD = 0;
	float fShadowSvoFin = 0, fShadowSvoDepthMin = 1.f, fShadowSvoDepthMax = 0;
	float fAverSmoothness = 0;

#if %_RT_QUALITY
	// rt stage 2C, finding (b). Recompute ConeTracePS's own predicate from the same inputs: the
	// specular set is full resolution under e_svoTI_RT_Active, so this pass, DemosaicPS and
	// ConeTracePS all evaluate it at the same texel and agree.
	float3 vUpNor0 = 0;
	float fUpSmooth = 0, fUpTransm = 0;
	float3 vUpRefl = 0;
	float fUpDepthMin = 0, fUpDepthMax = 0;
	float3 vUpNorMin = 0, vUpNorMax = 0;
	GetAverNormAndSmooth(IN.baseTC.xy, vUpNor0, fUpSmooth, fUpTransm, normalize(IN.CamVec.xyz), vUpRefl, fUpDepthMin, fUpDepthMax, vUpNorMin, vUpNorMax);
	const float3 vUpPos0 = GetWorldPos(VOX_DEPTH_SCALE * fDepthC - VOX_DEPTH_BIAS, IN.CamVec);
	const bool bRTPixel = RT_IsTriPixel(fUpSmooth, vUpRefl, length(vUpPos0 - PS_WorldViewPos.xyz));

	// rt stage 4B (decision 08 item 4): the roughness-scaled spatial filter. A mirror is a
	// single tap - it was already final at full resolution and any radius at all softens it -
	// and the radius opens to 4 source texels at the bottom of the RT range, where one GGX
	// sample per pixel is genuinely noisy. Same ramp as the temporal history length, so the two
	// halves of the denoiser cannot disagree about how rough this pixel is.
	float fRTRadius = bRTPixel ? lerp(4.f, 0.f, RT_GetMirrorT(fUpSmooth)) : 0.f;
	float fRTBandT = bRTPixel ? RT_GetGlossBandT(fUpSmooth) : 1.f;
	#if %_RT_PARTICLE_SHADOW
	// debug 14 (raw 1 spp) and 15 (history weight) must reach the screen unfiltered and unmixed
	if ((int)VOX_RT_DEBUG_MODE == 14 || (int)VOX_RT_DEBUG_MODE == 15)
	{
		fRTRadius = 0.f;
		fRTBandT = 1.f;
	}
	#endif
	// the centre tap hit distance, the guide signal of the bilateral below; 0 = not RT
	const float fRTHitDistC = bRTPixel ? refl_RAYDIR_REC.SampleLevel(ssSvoPointClamp, IN.baseTC.xy, 0).w : 0.f;
#else
	const bool bRTPixel = false;
	const float fRTRadius = 0.f;
	const float fRTBandT = 1.f;
	const float fRTHitDistC = 0.f;
#endif

	// define sampling kernel
	const int samplesNum = 5;
	// rt stage 2C: the stock kernel reads +-1.5 SOURCE texels away and shifts even its own
	// centre tap by a quarter texel, through a LINEAR sampler. At half resolution that is the
	// upscale; at the full resolution an RT reflection runs at it is a 4x4-ish box blur applied
	// to an already-final picture, and the quarter-texel bias smears it diagonally on top. Neo
	// collapses the whole loop to one tap under %_RTGI_MESH_RAY_TRACING && !DIFFUSE
	// (neo:2340-2346, neo:2348 samples at baseTC with tex2DlodPC). Same thing here, per pixel.
	// rt stage 4B: for an RT pixel the offsets become the roughness-scaled radius and the
	// quarter-texel bias stays at zero (it exists to help a half-resolution upscale and only
	// smears a full-resolution result). fRTRadius == 0 collapses back to stage 2C single tap.
	const float4 sampleTM = bRTPixel ? float4(SVO_SrcPixSize.xy * fRTRadius, 0.f, 0.f)
	                                 : float4(SVO_SrcPixSize.xy * 1.5f, SVO_SrcPixSize.xy * 0.25f);
	const int samplesUsed = (bRTPixel && fRTRadius <= 0.f) ? 1 : samplesNum;
	const float2 arrSamples[samplesNum] =
	{
		// TODO: try (-1,0), (0,1) ....
		float2( 0,-1) * sampleTM.xy - sampleTM.zw,
		float2( 0, 1) * sampleTM.xy - sampleTM.zw,
		float2(-1, 0) * sampleTM.xy - sampleTM.zw,
		float2( 1, 0) * sampleTM.xy - sampleTM.zw,
		float2( 0, 0) * sampleTM.xy - sampleTM.zw,
	};

	for (int s = 0; s < samplesUsed; s++)
	{
		const float2 tc = IN.baseTC.xy + arrSamples[s];

		const float4 vDiff_RGB_Min = tex2DlodLC(sceneRgbMin, tc);
		const float4 vDiff_ALD_Min = tex2DlodLC(sceneAldMin, tc);
		const float4 vDiff_RGB_Max = tex2DlodLC(sceneRgbMax, tc);
		const float4 vDiff_ALD_Max = tex2DlodLC(sceneAldMax, tc);

		// reduce artifacts around 1p weapon
		const float fDepthMin = max(fDepthClampMin, vDiff_RGB_Min.w);
		const float fDepthMax = max(fDepthClampMin, vDiff_RGB_Max.w);

		float fLerp = saturate((fDepthC - fDepthMin) / max(fDepthMax - fDepthMin, 0.0001f));

		float4 vDiff_RGB = lerp(vDiff_RGB_Min, vDiff_RGB_Max, fLerp);
		float4 vDiff_ALD = lerp(vDiff_ALD_Min, vDiff_ALD_Max, fLerp);

#if %_RT_LIGHTVOLUME1
		const float fDepth1 = SampleLinearDepth(sceneDepth, tc.xy);
#else
		const float fDepth1 = vDiff_RGB.w;
#endif

#if %_RT_LIGHTVOLUME1
		float fTr = 0;
		const float3 vNorm = normalize(GetWorldSpaceNormals(tc.xy, fTr, normalize(IN.CamVec.xyz)).xyz);
#else
		const float3 vNorm = vDiff_ALD;
#endif

		float fDotTest = lerp(.25, saturate(fTransmittanceY * 4 + dot(normalize(vNorm), vFocus) - fDotMax), saturate(length(vNorm) / max(0.0001, vDiff_ALD.w) * 8.f));

		float fDepTest = saturate((fDepthRange - abs(1.f - fDepthC / fDepth1)) * 4);

		float fW = fDepTest * fDotTest;

#if %_RT_QUALITY
		if (bRTPixel && fRTRadius > 0.f)
		{
			// rt stage 4B: hit-distance similarity. Two neighbouring pixels whose rays ended
			// metres apart are not looking at the same thing however alike their surfaces are,
			// and depth + normal cannot tell - they are identical across a flat floor. This is
			// the guide buffer an NRD-class denoiser keys on (decision 08 alternatives, R09);
			// here it is one term of a 5 tap bilateral. A tap that is not an RT pixel at all
			// (hit distance 0) is rejected outright.
			const float fHitD = refl_RAYDIR_REC.SampleLevel(ssSvoPointClamp, tc, 0).w;
			const float fRelD = abs(fHitD - fRTHitDistC) / max(fRTHitDistC, 0.25f);
			fW *= (fHitD > 0.f) ? saturate(1.f - fRelD) : 0.f;
		}
#endif

		if (s == 4)
			fW = saturate(fW * 4); // midddle sample is most important

		fW += +.001;

		vRGB.xyz += vDiff_RGB.xyz * fW;
		vALD += vDiff_ALD * fW;
		MaterialAttribsCommon gbuffer = DecodeGBufferChannels(tc);
		fAverSmoothness += gbuffer.Smoothness * fW;
		vRGB.w += fW;

#if %_RT_REVERSE_DEPTH
		if (IsDiffuseMode())
		{
			// upscale svo sun shadow
			float4 vShadowSvo = tex2DlodPC(shadowFromSvoMinMax, tc);   // shadowMin, shadowMax, depthMin, depthMax
			float lerpShadow = saturate((fDepthC - vShadowSvo[2]) / max(vShadowSvo[3] - vShadowSvo[2], 0.0001f));
			float shadowSvoLerped = lerp(vShadowSvo[0], vShadowSvo[1], lerpShadow);
			fShadowSvoDepthMin = min(fShadowSvoDepthMin, vShadowSvo[2]);
			fShadowSvoDepthMax = max(fShadowSvoDepthMax, vShadowSvo[3]);
			fShadowSvoFin += shadowSvoLerped * fW;
		}
#endif
	}

	if (vRGB.w)
	{
		vRGB.xyz /= vRGB.w;
		vALD /= vRGB.w;
		fAverSmoothness /= vRGB.w;
		fShadowSvoFin /= vRGB.w;
	}

	// copmute lighting
	float fDirIntens = max(0, length(vALD.xyz)) * saturate(1 - fTransmittanceY);

	MaterialAttribsCommon gbuffer = DecodeGBufferChannels(IN.baseTC.xy);
	half power = IsDiffuseMode() ? 1.f : exp2(12.h * gbuffer.Smoothness + 0.5h);

	float3 vH = IsDiffuseMode() ? normalize(vALD.xyz) : normalize(-normalize(IN.CamVec.xyz) + normalize(vALD.xyz));

	float NdotH = dot(vNor0, vH);
	float fIntensity = fDirIntens * pow(saturate(NdotH), power) + max(0, vALD.w - fDirIntens);

	if (IsDiffuseMode())
	{
		OUT.Diffuse.xyz = vRGB * fIntensity;
	}
	else
	{
		float so = gbuffer.Smoothness;
		// Fresnel smoothness
		//		gbuffer.Smoothness = lerp(gbuffer.Smoothness, 1, pow(1 - dot(-normalize(IN.CamVec.xyz), vNor0), 2));

		//OUT.Diffuse.xyz = vRGB * vALD.w;

		if (bRTPixel)
		{
			// rt stage 2C, finding (b)/(d): DemosaicPS kept the real radiance for this pixel, so
			// there is nothing to reconstruct. The stock line below rebuilds the magnitude from
			// the ALD lobe through pow(saturate(NdotH), 2^12.5) - a knife-edge test that an RT
			// ray direction fails the moment the shading normal and the traced direction differ
			// by a thousandth - and then lerps in the DIFFUSE GI buffer for anything that is not
			// a perfect mirror. Both are cone-tracing reconstruction and both are wrong here.
			// Neo: OUT.Diffuse.xyz = vRGB (neo:2412), no sceneDiffuseFin blend (neo:2419-2421).
			OUT.Diffuse.xyz = vRGB.xyz;

			// rt stage 4B (decision 08 consequences): the cross-fade band around
			// e_svoTI_RT_MinGloss. Below the band a pixel is voxel cone traced and the stock
			// line below anchors it to the DIFFUSE GI buffer with weight saturate(3s - 0.75);
			// above the band an RT pixel is used neat. Inside the band the RT pixel is given
			// the SAME anchor with the SAME weight and then ramped off it, so the
			// reconstruction is continuous across the threshold and the only step left is the
			// voxel-cone result against the ray-traced one - two estimates of the same
			// reflection, which the stage 4A energy fixes put in the same units on purpose.
			// A true cross-fade would need BOTH traces on the same pixel; see report 04b
			// section 6.
			if (fRTBandT < 1.f)
			{
				const float4 vFinalDiffuseRT = tex2DlodPC(sceneDiffuseFin, float4(IN.baseTC.xy, 0, 0)) / SvoParamsDiffuse.w * SvoParamsSpecular.w;
				const float4 vAnchoredRT = lerp(vFinalDiffuseRT, OUT.Diffuse, saturate(gbuffer.Smoothness * 3.f - .75f));
				OUT.Diffuse = lerp(vAnchoredRT, OUT.Diffuse, fRTBandT);
			}
		}
		else
		{
		OUT.Diffuse.xyz = lerp(vRGB * fIntensity, vRGB * vALD.w, pow(gbuffer.Smoothness, 2));

		float4 vFinalDiffuse = tex2DlodPC(sceneDiffuseFin, float4(IN.baseTC.xy, 0, 0)) / SvoParamsDiffuse.w * SvoParamsSpecular.w;

		OUT.Diffuse = lerp(vFinalDiffuse, OUT.Diffuse, saturate(pow(gbuffer.Smoothness * 3 - .75, 1)));
		}

		// Fresnel amplify
		//OUT.Diffuse.xyz *= 1 + pow(saturate(1 - so), 4) * pow(saturate(1 - dot(-normalize(IN.CamVec.xyz), vNor0)), 7) * 2;

		OUT.Diffuse.a = 1;
	}

#if !%_RT_SAMPLE5 && !%_RT_LIGHTVOLUME1
	// rt stage 2C, finding (d): e_svoTI_DiffuseBias x the sky-top colour is a FLAT ADDITIVE
	// lift, the cone tracer's "there is always a bit of ambient" fudge. Added on top of a fully
	// shaded triangle hit it is exactly the hazy, washed-out veil the direct view does not have,
	// and it is bright enough to bury a sun shadow edge. Neo drops it under mesh ray tracing
	// (neo:2427). Off for RT pixels, byte-identical for everything else.
	if (!bRTPixel)
	{
	if (SvoParamsCommon.z > 0)
		OUT.Diffuse.xyz += SvoParamsCommon.z * vSkyColorTop.z;
	else
		OUT.Diffuse.xyz += -SvoParamsCommon.z * vSkyColorTop.z * 0.15f;
	}
#endif

	OUT.Diffuse.w = fDepthC;

	float3 vReprojTC = Reproject(IN.baseTC.xy, fDepthC, SVO_ReprojectionMatrix);

	float4 valPrev = tex2DlodPC(sceneFinOutPrev, float4(vReprojTC.xy, 0, 0));

	float fBlend = GetBlendMin(vReprojTC.xy, IN.baseTC.xy, fAverSmoothness, fDepthC, valPrev.w);

	// detect high contrast difference
	float fDiff = dot(abs(1.f - OUT.Diffuse.xyz / valPrev.xyz), half3(0.33f, 0.33f, 0.33f));
	if (fDiff > 0)
		fBlend += (1.f - fBlend) * saturate(fDiff * 3);

	// rt stage 2C, finding (b): this is the SECOND temporal filter on the same data, and unlike
	// DemosaicPS's it reprojects a reflection at the REFLECTING surface's depth - which is the
	// wrong depth for a virtual image and drags the reflection behind the camera. DemosaicPS
	// already holds the flicker for us. Neo takes the same decision and hard-codes fBlend = 1
	// for specular (neo:2455). Clamp follows the demosaic's (neo:2463).
	const float fUpClamp = bRTPixel ? 100.f : 8.f;
	if (bRTPixel)
		fBlend = 1.f;

	OUT.Diffuse = clamp(lerp(valPrev, OUT.Diffuse, fBlend), 0, fUpClamp);

#if %_RT_REVERSE_DEPTH
	if (IsDiffuseMode())
	{
		if (fShadowSvoDepthMin / fShadowSvoDepthMax > VOX_DEPTH_RANGE_THRESHOLD)
		{
			float4 vShadowSvoFiltered = tex2DlodLC(shadowFromSvoMinMax, IN.baseTC.xy);
			fShadowSvoFin = (vShadowSvoFiltered[0] + vShadowSvoFiltered[1]) * 0.5;
		}
		float4 shadowSvoFinPrev = tex2DlodPC(shadowFromSvoFinPrev, float4(vReprojTC.xy, 0, 0));
		OUT.Specular = clamp(lerp(shadowSvoFinPrev, fShadowSvoFin, fBlend), 0, 1);
	}
#endif

#if %_RT_PROJECTION_MULTI_RES
	{
		// simple specular
		half power = exp2(7.h * gbuffer.Smoothness + 0.5f);
		float3 vH = normalize(-normalize(IN.CamVec.xyz) + normalize(vALD.xyz));
		float NdotH = dot(vNor0, vH);	
		float intensity = fDirIntens * pow(saturate(NdotH), power) * (1 + max(0, vALD.w - fDirIntens) / 2) + max(0, vALD.w - fDirIntens)/2;
		OUT.Diffuse1.xyz = vRGB * intensity;

	#if !%_RT_SAMPLE5 && !%_RT_LIGHTVOLUME1
		if (SvoParamsCommon.z > 0)
			OUT.Diffuse1.xyz += SvoParamsCommon.z * vSkyColorTop.z;
		else
			OUT.Diffuse1.xyz += -SvoParamsCommon.z * vSkyColorTop.z * 0.15f;
	#endif

		OUT.Diffuse1.xyz *= SvoParamsSpecular.w;
		OUT.Diffuse1.w = fDepthC;
	}
#endif

	return OUT;
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Rendering techniques

technique SvoDebugDraw
{
	pass p0
	{
		VertexShader = VoxelRayTraceVS() GeneralVS;
		PixelShader = SvoDebugDrawPS() GeneralPS;
		CullMode = None;
	}
}

technique ConeTracePass
{
	pass p0
	{
		VertexShader = RenderLightingCommonVS();
		PixelShader = ConeTracePS();
		CullMode = None;
	}
}

// rt stage 2 (decision 06): hit shading, between ConeTracePass and DemosaicPass on the
// specular target set. Only dispatched when e_svoTI_RT_Active && IntegrationMode == 2.
technique ShadePass
{
	pass p0
	{
		VertexShader = RenderLightingCommonVS();
		PixelShader = ShadePS();
		CullMode = None;
	}
}

#ifdef SVO_LMAPS

technique ConeTracePS_NID
{
	pass p0
	{
		VertexShader = VoxelRayTraceVS_GS();
		GeometryShader = BoxGenGS_GS();
		PixelShader = ConeTracePS_NID_GS();

		ZEnable = true;
		ZWriteEnable = true;
		CullMode = Front;
	}
}

#endif

technique RenderAtmosphere
{
	pass p0
	{
		VertexShader = RenderLightingCommonVS();
		PixelShader = RenderAtmospherePS();
		CullMode = None;
	}
}

technique TraceSunShadows
{
	pass p0
	{
		VertexShader = RenderLightingCommonVS();
		PixelShader = TraceSunShadowsPS();
		CullMode = None;
	}
}

technique DemosaicPass
{
	pass p0
	{
		VertexShader = RenderLightingCommonVS();
		PixelShader = DemosaicPS();
		CullMode = None;
	}
}

technique UpScalePass
{
	pass p0
	{
		VertexShader = RenderLightingCommonVS();
		PixelShader = UpScalePS();
		CullMode = None;
	}
}

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Compute techniques

// rt stage 2: world-space light mask grid for the ShadePass (decision 06 section 6.2).
// Body in Total_Illumination_Shading.cfi; see the note there for why it is not in
// TiledShading.cfi.
technique
  BuildRayTracingLightList {
	pass p0 {
		ComputeShader =
		  BuildRayTracingLightListCS();
	}
}

technique
  ComputeClearBricks {
	pass p0 {
		ComputeShader =
		  ComputeClearBricks();
	}
}

technique
  ComputeInjectAtmosphere {
	pass p0 {
		ComputeShader =
		  ComputeInjectAtmosphere();
	}
}

technique
  ComputeDirectStaticLighting {
	pass p0 {
		ComputeShader =
		  ComputeDirectStaticLighting();
	}
}

technique
  ComputeDirectDynamicLighting {
	pass p0 {
		ComputeShader =
		  ComputeDirectDynamicLighting();
	}
}

technique
  ComputePropagateLighting {
	pass p0 {
		ComputeShader =
		  ComputePropagateLighting();
	}
}

#endif // FEATURE_SVO_GI
