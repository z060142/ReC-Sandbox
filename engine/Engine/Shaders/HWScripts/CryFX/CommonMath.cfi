// Copyright 2019-2021 Crytek GmbH / Crytek Group. All rights reserved.#define MAX_FRACTIONAL_8_BIT        (255.0f / 256.0f)#define MIDPOINT_8_BIT              (127.0f / 255.0f)#define TWO_BITS_EXTRACTION_FACTOR  (3.0f + MAX_FRACTIONAL_8_BIT)#define short  min16int#define short2 min16int2#define short3 min16int3#define short4 min16int4////////////////////////////////////////////////////////////////////////////////////////////////////// Basic math toolsfloat4 sqr(float4 x){	return x * x;}float3 sqr(float3 x){	return x * x;}float2 sqr(float2 x){	return x*x;}float  sqr(float x){ 	return x*x; }float hmin(float4 c){	float2 d = min(c.xy, c.zw);	return min(d.x, d.y);}float hmax(float4 c){	float2 d = max(c.xy, c.zw);	return max(d.x, d.y);}float hmin(float4 a, float4 b){	return hmin(min(a, b));}float hmax(float4 a, float4 b){	return hmax(min(a, b));}////////////////////////////////////////////////////////////////////////////////////////////////////// Geometric mathfloat IntersectAABB(float3 rayDir, float3 rayOrg, float3 boxExt){	if (length(rayDir) < 1e-6) return 1;	// Intersection using slabs	float3 rcpDir = rcp(rayDir);	float3 tNeg = ( boxExt - rayOrg) * rcpDir;	float3 tPos = (-boxExt - rayOrg) * rcpDir;	return max(max(min(tNeg.x, tPos.x), min(tNeg.y, tPos.y)), min(tNeg.z, tPos.z));}uint selectCubeFace(in float3 rayVec){	float3 dir = abs(rayVec);	bool3 pmag = bool3(dir.x > dir.y, dir.y > dir.z, dir.x > dir.z);	bool3 nmag = bool3(dir.x <= dir.y, dir.y <= dir.z, dir.x <= dir.z); 	bool3 flp  = bool3(rayVec.x == dir.x, rayVec.y == dir.y, rayVec.z == dir.z); 	uint cubeFace = 		(pmag.x) * (pmag.z) * (0 + flp.x) +		(nmag.x) * (pmag.y) * (2 + flp.y) +		(nmag.z) * (nmag.y) * (4 + flp.z); 			return cubeFace;}////////////////////////////////////////////////////////////////////////////////////////////////////// Encoding related math (simple)float4 RGB10A2_to_RGB10A2f( float4 InColor ){	// Shift left 3 bits. This allows us to have the exponent and mantissa on opposite	// sides of the decimal point for extraction.	float4 OutColor = InColor * 8.0f;	// Extract the exponent and mantissa that are now on opposite sides of the decimal point	float3 e = floor( OutColor.rgb );	float3 m = frac( OutColor.rgb );		// Perform the 7e3 conversion.  Note that this varies on the value of e for each channel:	// if e != 0.0f then the correct conversion is (1+m)/8*pow(2,e).	// else it is (1+m)/8*pow(2,e).  	OutColor.rgb  = (e == 0.0f) ? 2*m/8 : (1+m)/8 * exp2(e);	return OutColor;}// Encode a float value into 3 bytes (input value should be in the range of [0, 1])float3 PackFloatToVec3(const float value){	static const float3 bitSh = float3(256.0 * 256.0, 256.0, 1.0);	static const float3 bitMsk = float3(0.0, 1.0/256.0, 1.0/256.0);	float3 res = frac(value * bitSh);	res -= res.xxy * bitMsk;	return res;}float UnpackFloatFromVec3(const float3 value){	static const float3 bitSh = float3(1.0/(256.0*256.0), 1.0/256.0, 1.0);	return dot(value, bitSh);}////////////////////////////////////////////////////////////////////////////////////////////////////// Color-Space related mathhalf3 GetLuminanceWeights(){	return half3( 0.2126h, 0.7152h, 0.0722h );}half GetLuminance( half3 color ){	return dot( color, GetLuminanceWeights() );}// The luminance weights of the space the HDR TARGET is in - Rec.709 on the stock path, ACEScg// (AP1) once the scene-referred working-space conversion has run (SceneReferredSpec.md S3).//// This is a SEPARATE name and not a switch inside GetLuminanceWeights() on purpose: two thirds of// that function's call sites read the G-buffer, do shading-time energy conservation or run after// the display transform, and Rec.709 is still the right answer in every one of them. Only the// handful of sites that sit between the conversion point and the tone map may move - the// exposure meter, the firefly filter in the stable downsample, the tone map's saturation pivot// and the lens model's highlight extraction. Getting that classification wrong in either// direction is a wrong picture with no error message.//// A per-view constant rather than a shader permutation: the DOF gather evaluates this inside a// 121-tap loop and the firefly filter thirteen times per texel, and a static flag would double// the permutation count of every one of those techniques to carry three floats. The value is a// DELTA from Rec.709, so a pass that does not bind the per-view buffer still gets Rec.709 rather// than zero, and on the stock path the delta is an exact 0.0.half3 GetWorkingLuminanceWeights(){	return GetLuminanceWeights() + (half3)CV_SceneLuminanceWeightsDelta.xyz;}half GetWorkingLuminance( half3 color ){	return dot( color, GetWorkingLuminanceWeights() );}half3 EncodeColorYCC( half3 col ){	half3 encodedCol;	// Y'Cb'Cr'	col = sqrt( col );	encodedCol.x = dot( half3(0.299, 0.587, 0.114), col.rgb );	encodedCol.y = dot( half3(-0.1687, -0.3312, 0.5), col.rgb );	encodedCol.z = dot( half3(0.5, -0.4186, -0.0813), col.rgb );		return half3(encodedCol.x, encodedCol.y * MIDPOINT_8_BIT + MIDPOINT_8_BIT, encodedCol.z * MIDPOINT_8_BIT + MIDPOINT_8_BIT);}half3 DecodeColorYCC( half3 encodedCol, const bool useChrominance = true ){	encodedCol = half3(encodedCol.x, encodedCol.y / MIDPOINT_8_BIT - 1, encodedCol.z / MIDPOINT_8_BIT - 1);	if (!useChrominance) encodedCol.yz = 0;		// Y'Cb'Cr'	half3 col;	col.r = encodedCol.x + 1.402 * encodedCol.z;	col.g = dot( half3( 1, -0.3441, -0.7141 ), encodedCol.xyz );	col.b = encodedCol.x + 1.772 * encodedCol.y;	return col * col;}////////////////////////////////////////////////////////////////////////////////////////////////////// ACES working space (SceneReferredSpec.md D5, Stage S3)//// Linear Rec.709 (sRGB primaries, D65) <-> ACEScg (AP1 primaries, ACES D60), chromatic adaptation// by BRADFORD. The adaptation is the load-bearing part: without it a neutral grey would come out// tinted, because the two spaces do not share a white point. With it, (1,1,1) maps to (1,1,1).//// These are STANDARDS, not tuning: Rec.709, AP1, D65, D60 and Bradford are each fixed by their// own specification, so there is no scene, camera or user parameter in these numbers. They are// exact double-precision operator parameters read out of OCIO's own transform, NOT sampled// through a float32 processor.////   Bradford-adapted, verified against PyOpenColorIO 2.5, tools/ocio-bake/verify_matrices.py//   (config ocio://studio-config-latest = studio-config-v4.0.0_aces-v2.0_ocio-v2.5).//   Re-run that script if any digit here is ever in doubt; it fails with a per-entry diff.//// Two properties worth knowing before using them://  1. REC709_TO_ACESCG is entirely NON-NEGATIVE - Rec.709's primaries lie inside AP1 - so no//     non-negative Rec.709 colour can produce a negative AP1 component. That is what makes the//     spec's "AP1-encoded negatives never appear" a VERIFICATION that the matrix was applied//     correctly rather than a hazard of the transform. The inverse IS signed, which is why//     anything going back to Rec.709 needs a float buffer.//  2. The matrix does not change any colour, only its coordinates: a Rec.709 (1,0,0) becomes//     (0.6131, 0.0702, 0.0206). Every threshold that compares against an absolute constant//     therefore sees a different number even though the light did not change. Re-deriving those//     constants is D11 / Stage S7 and must NOT be mixed into the primaries change.//// Unlike every transfer function below, these must NEVER acquire a saturate(): they operate on// scene-referred values with no upper bound.static const float3x3 REC709_TO_ACESCG ={	 0.61309740f,  0.33952315f,  0.04737945f,	 0.07019372f,  0.91635388f,  0.01345240f,	 0.02061559f,  0.10956977f,  0.86981463f};static const float3x3 ACESCG_TO_REC709 ={	 1.70505099f, -0.62179212f, -0.08325887f,	-0.13025642f,  1.14080474f, -0.01054832f,	-0.02400336f, -0.12896898f,  1.15297233f};float3 Rec709ToACEScg(float3 col){	return mul(REC709_TO_ACESCG, col);}float3 ACEScgToRec709(float3 col){	return mul(ACESCG_TO_REC709, col);}// The Y row of the AP1 -> CIE XYZ (D60) matrix; the three weights sum to exactly 1.0. This is the// luminance of an ACEScg value, and it is NOT GetLuminanceWeights(): compared with Rec.709's// (0.2126, 0.7152, 0.0722) red gains about 0.060, green loses 0.041 and blue loses 0.019, so a// saturated red source reads roughly 28 % brighter than the 709 weights would say. Applying the// 709 weights to AP1 data is the classic silent failure - every threshold and every// hue-preserving rescale moves, and nothing errors. Same provenance as the matrices above.static const float3 ACESCG_LUMINANCE_WEIGHTS = float3(0.27222872f, 0.67408177f, 0.05368952f);float ACEScgLuminance(float3 col){	return dot(col, ACESCG_LUMINANCE_WEIGHTS);}////////////////////////////////////////////////////////////////////////////////////////////////////// ACEScct - the ACES grading log encoding (Stage S4's shaper, defined here so that there is one// home for the constants). A pure log curve cannot represent zero, nor the small negatives a// wide-gamut grade legitimately produces, so ACEScct replaces the toe with a straight segment// that meets the log curve at X_BRK with matching value and slope.//// Constants read out of OCIO's "CURVE - ACEScct-LOG_to_LINEAR" LogCameraTransform by// tools/ocio-bake/verify_matrices.py (base 2, logSideSlope 1/17.52, logSideOffset 9.72/17.52,// linSideBreak 2^-7, linearSlope defaulted to the tangent at the break).//// Landmarks worth remembering: encode(0.18) = 0.41358781 (mid grey), -B/A = -0.00691688 is the// most negative linear value the encode still represents, and decode(1.0) = 222.86 - NOT the fp16// ceiling. Anything that clamps the shaper output to [0,1] therefore clips at about 223x// reference white, roughly +10.3 stops over mid grey.#define ACESCCT_X_BRK       0.0078125000f#define ACESCCT_Y_BRK       0.1552511416f#define ACESCCT_A          10.5402377417f#define ACESCCT_B           0.0729055342f#define ACESCCT_LOG_OFFSET  9.7200000000f#define ACESCCT_LOG_SCALE  17.5200000000ffloat LinearToACEScct(float x){	return (x < ACESCCT_X_BRK)	       ? (ACESCCT_A * x + ACESCCT_B)	       : ((log2(x) + ACESCCT_LOG_OFFSET) / ACESCCT_LOG_SCALE);}float3 LinearToACEScct(float3 col){	return float3(LinearToACEScct(col.r), LinearToACEScct(col.g), LinearToACEScct(col.b));}float ACEScctToLinear(float y){	return (y < ACESCCT_Y_BRK)	       ? ((y - ACESCCT_B) / ACESCCT_A)	       : exp2(y * ACESCCT_LOG_SCALE - ACESCCT_LOG_OFFSET);}float3 ACEScctToLinear(float3 col){	return float3(ACEScctToLinear(col.r), ACEScctToLinear(col.g), ACEScctToLinear(col.b));}// Gamma-Curve / Transfer-function only (no color-space change and no limited ranges)half3 LinearToSRGB(half3 col){	col = saturate(col);	return (col < 0.0031308) ? 12.92h * col : 1.055h * pow(col, 1.0h / 2.4h) - half3(0.055h, 0.055h, 0.055h);}half3 SRGBToLinear(half3 col){	col = saturate(col);	return (col <= 0.040450h) ? col / 12.92h : pow((col + float3(0.055h, 0.055h, 0.055h)) / 1.055h, 2.4h);}half3 SRGBToLinearApproximation(half3 col){	col = saturate(col);	// http://chilliant.blogspot.com/2012/08/srgb-approximations-for-hlsl.html	return		col * (col * (col * 0.305306011h + 0.682171111h) + 0.012522878h);}half3 SRGBToLinearApproximation(half3 col, half3 weights){	col = saturate(col);	// http://chilliant.blogspot.com/2012/08/srgb-approximations-for-hlsl.html	return		col.r * (col.r * (col.r * 0.305306011h + 0.682171111h) + 0.012522878h) * weights.r +		col.g * (col.g * (col.g * 0.305306011h + 0.682171111h) + 0.012522878h) * weights.g +		col.b * (col.b * (col.b * 0.305306011h + 0.682171111h) + 0.012522878h) * weights.b;}half3 LinearToREC709(half3 col){	col = saturate(col);	return (col < 0.0180000h) ? 4.50h * col : 1.099h * pow(col, 1.0h / 2.4h) - half3(0.099h, 0.099h, 0.099h);}half3 REC709ToLinear(half3 col){	col = saturate(col);	return (col < 0.081000h) ? col / 4.50h : pow((col + half3(0.099h, 0.099h, 0.099h)) / 1.099h, 2.4h);}// Rec. 2020 defines a nonlinear transfer function for gamma correction that is the same nonlinear transfer function that is used by Rec. 709,// except that its parameters are given with higher precisionfloat3 LinearToREC2020(float3 col){	col = saturate(col);	return (col < 0.018053968510807f) ? 4.50f * col : 1.09929682680944f * pow(col, 1.0h / 2.4f) - float3(0.09929682680944f, 0.09929682680944f, 0.09929682680944f);}float3 REC2020ToLinear(float3 col){	col = saturate(col);	return (col < 0.0812428582986315f) ? col / 4.50f : pow((col + float3(0.09929682680944f, 0.09929682680944f, 0.09929682680944f)) / 1.09929682680944f, 2.4f);}// BROKEN AND UNUSED - left in place deliberately, do not copy it. The opening "float3(" is// missing, so it cannot compile; even repaired it is not a matrix multiply (the commas are the// comma operator, so each row's three products are never summed) and each row multiplies a// different component instead of dotting the whole vector. The coefficients themselves are the// correct Rec.709 -> Rec.2020 matrix, which is what makes it dangerous: it looks authoritative.// It survives only because nothing references it and the CryFX front end does not emit// unreferenced functions. Repairing it would be a stock-path source change with no stock// consumer (scene-notes/decisions/s3-working-space.md section 3C); the working colour-matrix// code the scene-referred path uses is Rec709ToACEScg() / ACEScgToRec709() above.// The color primaries of sRGB and REC709 are the same, REC2020 has distinct color primariesfloat3 Convert_REC709toREC2020(half3 col){	return		0.6274f * col.x, 0.3293f * col.y, 0.0433f * col.z,		0.0691f * col.x, 0.9195f * col.y, 0.0114f * col.z,		0.0164f * col.x, 0.0880f * col.y, 0.8956f * col.z);}half3 LimitREC709_8Bit(half3 col){	// Technically 0 and 255 are reserved values (timing control values) and the rest is out-of-gammut	return (16.0 / 255.0) + col.xyz * ((235.0 - 16.0) / 255.0);}half3 LimitREC2020_10Bit(half3 col){	// Technically 0-3 and 1020-1023 are reserved values (timing control values) and the rest is out-of-gammut	return (64.0 / 1024.0) + col.xyz * ((940.0 - 64.0) / 1024.0);}half3 LimitREC2020_12Bit(half3 col){	// Technically 0-15 and 4080-4095 are reserved values (timing control values) and the rest is out-of-gammut	return (256.0 / 4096.0) + col.xyz * ((4080.0 - 256.0) / 4096.0);}////////////////////////////////////////////////////////////////////////////////////////////////////// Backwards-compatibility preserving function-husks// Common functionshalf4 EXPAND( half4 a ){  return a * 2 - 1;}half3 EXPAND( half3 a ){  return a * 2 - 1;}half EXPAND( half a ){  return a * 2 - 1;}half2 EXPAND( half2 a ){  return a * 2 - 1;}