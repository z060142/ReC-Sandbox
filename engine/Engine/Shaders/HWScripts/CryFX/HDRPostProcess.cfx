// Copyright 2009-2021 Crytek GmbH / Crytek Group. All rights reserved.#include "Common.cfi"#include "ShadeLib.cfi"#include "PostEffectsLib.cfi"#include "ShadowCommon.cfi"// Shader global descriptionsfloat Script : STANDARDSGLOBAL<  string Script =           "NoPreview;"           "LocalConstants;"           "ShaderDrawType = Custom;"           "ShaderType = PostProcess;">;/// Un-Tweakables //////////////////////float4 ScreenSize  : PB_ScreenSize < register = VS_REG_PB_0 >;float4 SampleOffsets[16] < register = c0; >float4x4 mViewProjPrev;float4 HDRParams0;float4 HDREyeAdaptation;float4 HDRFilmCurve;float3 HDRBloomColor;float4 HDRColorBalance;			// (ColorBalance.rgb, fHDRSaturation)float4 HDRMiscParams;				// (1.0f, 1.0f, 1.0f, 1.0f)float4 SunShafts_SunCol;float4 ElapsedTime;float Time = {PB_time};Texture2D<float4> zMap : register(t0);Texture2DMS<float4> baseMapMS : register(t0);Texture2DMS<float4> zMapMS : register(t0);struct app2vert{	IN_P	IN_TBASE	IN_C0};struct app2vertToneMap{	IN_P	IN_TBASE	float3 CamVec       : TEXCOORD1;};struct app2vertFog{	IN_P	float2 baseTC       : TEXCOORD0;	float3 CamVec       : TEXCOORD1;};struct vert2frag{	OUT_HPOS_IN_WPOS	float4 baseTC       : TEXCOORD0;	float3 CamVec       : TEXCOORD1;	float4 baseTCScaled : TEXCOORD2;};struct vert2fragFog{	OUT_HPOS_IN_WPOS	float2 baseTC       : TEXCOORD0;	float3 CamVec       : TEXCOORD1;	MSAA_SAMPLE_INDEX_PS};/////////////////////////////////////////////////////////////////////////////////////vert2frag TransformedVS(app2vertToneMap IN){	vert2frag OUT = (vert2frag)0; 	float4 vPos = IN.Position;	vPos.y = 1 -vPos.y;	OUT.HPosition = float4(vPos.xy*2-1, vPos.z, 1.0);	float2 baseTC = IN.baseTC.xy;	half2 offset = half2(frac(Time.x*27), frac(Time.x*19));	OUT.baseTC.xy = baseTC;	OUT.baseTCScaled.xy = GetScaledScreenTC(baseTC);    	OUT.baseTCScaled.wz = ((OUT.baseTCScaled.xy + offset) / 64.0) * g_VS_ScreenSize.xy;	OUT.CamVec.xyz = IN.CamVec;	return OUT;}vert2fragFog PreTransformedFogVS(app2vertFog IN){	vert2fragFog OUT = (vert2fragFog)0;	OUT.HPosition = Get2dHPos(IN.Position);	OUT.baseTC.xy = IN.baseTC.xy;	OUT.CamVec.xyz = IN.CamVec.xyz;	return OUT;}////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////Texture2D<float4> HDRBloom_Temp           : register(t0); // WxH quarter resTexture2D<float4> HDRBloom_Temp2          : register(t1); // WxH quarter resSamplerState HDRCalc_BloomSampler         : register(s0); // PointClamp or LinearClampfloat3 HDRBloomGaussianPS(vtxOut IN) : SV_Target{	const float weights[15] = { 153, 816, 3060, 8568, 18564, 31824, 43758, 48620, 43758, 31824, 18564, 8568, 3060, 816, 153 };	const float weightSum = 262106.0;		float2 coords = IN.baseTC.xy - HDRParams0.xy * 7.0;	half3 vColor = 0;		[unroll]	for (int i = 0; i < 15; ++i)	{		vColor += GetTexture2D(HDRBloom_Temp, HDRCalc_BloomSampler, coords).rgb * (weights[i] / weightSum);		coords += HDRParams0.xy;	}		// Compose sum of Gaussians in final pass#if %_RT_SAMPLE0	half3 bloom0 = GetTexture2D(HDRBloom_Temp2, HDRCalc_BloomSampler, IN.baseTC.xy).rgb;	half3 bloom1 = vColor;	vColor = (0.0174 * bloom0 + 0.192 * bloom1) / (0.0174 + 0.192);#endif		return vColor;}////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// Aperture diffraction streaks (sunstars). Light bending around the straight edges of the// iris blades throws a set of evenly spaced rays out of every very bright source. The// renderer reproduces them at bloom resolution: one high threshold pass isolates the// sources, then each ray direction is grown by a chain of exponentially widening// directional blurs and added back into the bloom target.float4 StreakParams0;   // (dirX / targetWidth, dirY / targetHeight, tapStride in pixels, output scale)float4 StreakParams1;   // (threshold, soft knee, per tap decay, unused)float4 StreakParams2;   // (tint rgb, unused) - white for the iris spikes, the coating colour for the anamorphic flareTexture2D<float4> HDRStreak_Src        : register(t0);SamplerState HDRStreak_LClampSampler   : register(s0); // LinearClampfloat3 HDRStreakThresholdPS(vtxOut IN) : SV_Target{	float3 cColor = GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy, 0.0f).rgb;	// Soft knee high pass expressed in scene HDR units. The threshold sits far above the	// white point on purpose: a merely bright sky must not grow rays, only sources that	// genuinely overload the aperture do.	const float fThreshold = StreakParams1.x;	const float fKnee = max(StreakParams1.y, 0.0001f);	const float fLum = max(max(cColor.r, cColor.g), cColor.b);	const float fSoft = clamp(fLum - fThreshold + fKnee, 0.0f, 2.0f * fKnee);	const float fContribution = max(fSoft * fSoft / (4.0f * fKnee), fLum - fThreshold);	// Rescale instead of subtracting so the source keeps its own hue and never washes to white.	return cColor * (fContribution / max(fLum, 0.0001f));}float3 HDRStreakStretchPS(vtxOut IN) : SV_Target{	const float2 vStep = StreakParams0.xy * StreakParams0.z;	const float fDecay = StreakParams1.z;	// Symmetric march: one pass paints a full line through each source (two opposed rays),	// so an N-spike star needs only N/2 passes and the spikes are guaranteed collinear.	float2 tcPos = IN.baseTC.xy;	float2 tcNeg = IN.baseTC.xy;	float3 cSum = GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, tcPos, 0.0f).rgb;	float fWeight = 1.0f;	float fWeightSum = 1.0f;	// Fixed mip, so the growing stride cannot pull the sampler into a different level.	[unroll]	for (int i = 0; i < 7; ++i)	{		fWeight *= fDecay;		tcPos += vStep;		tcNeg -= vStep;		cSum += (GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, tcPos, 0.0f).rgb		       + GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, tcNeg, 0.0f).rgb) * fWeight;		fWeightSum += 2.0f * fWeight;	}	// Normalised weights keep the total energy independent of the iteration count.	return cSum * (StreakParams0.w / max(fWeightSum, 0.0001f)) * StreakParams2.rgb;}// Wave-glare source pre-blur: one axis of a 5 tap Gaussian, sigma ~ 1 source texel, weights// normalised so the TOTAL EXCESS is preserved exactly (it is an energy, not a picture).//// This is a physical convolution, not a smoothing hack: the glare of an EXTENDED source is the// pattern convolved with the source's own shape, and the thresholded source is that shape. What// it buys in practice is that a lamp, which clears the threshold over a small BLOCK of texels// each of which spawns its own sprite, stops summing into a pattern with the grid's square as// its core. Two of these cost less than one of the stretch passes above.//// StreakParams0.xy is the texel step: (1/width, 0) horizontally, (0, 1/height) vertically.float3 HDRDiffractionSourceBlurPS(vtxOut IN) : SV_Target{	const float2 vStep = StreakParams0.xy;	// exp(-x^2 / 2) at x = 0, 1, 2, normalised: 0.40262, 0.24420, 0.05449.	const float w0 = 0.40262f;	const float w1 = 0.24420f;	const float w2 = 0.05449f;	float3 cSum = GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy, 0.0f).rgb * w0;	cSum += (GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy + vStep, 0.0f).rgb	       + GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy - vStep, 0.0f).rgb) * w1;	cSum += (GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy + 2.0f * vStep, 0.0f).rgb	       + GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy - 2.0f * vStep, 0.0f).rgb) * w2;	return cSum;}////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// Front filter point spread function (FilterPSFSpec.md).//// A star / cross-screen filter is a plate of etched grooves in FRONT of the lens: every bright// point in the frame is convolved with one fixed pattern. The convolution is done sparsely -// one textured sprite per bright quarter-resolution texel, expanded from SV_VertexID with no// vertex stream at all, deposited additively into the bloom target. Nothing here follows the// iris: a plate is not the aperture, so there is no f-number term and no blade phase.float4 FilterPSFParams0;  // (sprite half extent x in NDC, half extent y in NDC, cos rotation, sin rotation)float4 FilterPSFParams1;  // (energy per unit of source excess, star point count, PSF texture bound 0/1, working space is AP1 0/1)Texture2D<float4> HDRFilterPSF_Src      : register(t0);  // thresholded quarter res source, vertex shader (the front filter stays at quarter res)Texture2D<float4> HDRFilterPSF_Tex      : register(t1);  // authored PSF image, pixel shaderSamplerState HDRFilterPSF_PClampSampler : register(s0);  // PointClampSamplerState HDRFilterPSF_LClampSampler : register(s1);  // LinearClampstruct v2fFilterPSF{	float4 Position : SV_POSITION;	float4 QuadUV   : TEXCOORD0;  // xy: quad local, 0..1 across the sprite. zw unused.	float4 Color    : TEXCOORD1;  // rgb: this source's deposit. a unused.};// Shared by every sparse-convolution sprite pass in this file (the front filter and the// wave-optics diffraction glare): the clip-space CENTRE of the quad a vertex belongs to.// One quad per grid cell, and the grid IS the thresholded target, so a cell and a source// texel are the same thing. Same integer walk the DOF's sprite passes use; the grid size// arrives through the pass's own per-view constant buffer.float4 SpriteGridCentrePos(uint nVertexID){	const int nQuadID    = (int)(nVertexID / 6);	const int nGridWidth = (int)g_VS_ScreenSize.x;	float4 INPos = float4((float)(nQuadID % nGridWidth), (float)(nQuadID / nGridWidth), 0, 0);	INPos.xy /= g_VS_HPosScale.xy;	INPos.xy *= g_VS_ScreenSize.zw * 2.0;	INPos.xy += g_VS_ScreenSize.zw;	return float4(INPos.xy * 2 - 1, 0, 1);}// Two triangles, corners in [-1, 1]. The pixel shaders read the quad-local coordinate back out// of QuadUV, so the winding and the order here are part of both passes' contract.static const float2 g_SpriteQuadVerts[6] ={	float2( 1,  1),	float2(-1,  1),	float2( 1, -1),	float2( 1, -1),	float2(-1,  1),	float2(-1, -1)};v2fFilterPSF FilterPSFVS(uint nVertexID : SV_VertexID){	v2fFilterPSF OUT = (v2fFilterPSF) 0;	OUT.Position = SpriteGridCentrePos(nVertexID);	const float4 screenProj = HPosToScreenTC(OUT.Position);	// One point read at the texel centre. The threshold pass already rescaled the source to	// its own excess above the knee with the hue preserved, so this IS the excess E.	const half3 cExcess = GetTexture2DLod(HDRFilterPSF_Src, HDRFilterPSF_PClampSampler, float4(screenProj.xy, 0, 0)).rgb;	// Nothing survived the threshold here: collapse the quad instead of rasterizing a sprite	// that would deposit zero. This is what keeps the pass proportional to the number of	// bright sources rather than to the frame area.	if (dot(cExcess, half3(1, 1, 1)) < 1e-4)	{		OUT.Position.xy = 0;		return OUT;	}	OUT.Color.rgb = cExcess * (half)FilterPSFParams1.x;	// Half extents arrive in NDC already divided by the anamorphic squeeze on x, so the	// pattern is compressed horizontally exactly as the rest of the picture is.	const float2 vHalfExtent = FilterPSFParams0.xy;	OUT.Position.xy += g_SpriteQuadVerts[nVertexID % 6].xy * vHalfExtent;	OUT.QuadUV = float4(g_SpriteQuadVerts[nVertexID % 6].xy * 0.5 + 0.5, 0, 0);	return OUT;}// Procedural stand-in for an authored PSF: an N-point star with rainbow tips, so the filter is// testable and has a sane default. d is quad local in [-1, 1], the plate's rotation already// walked back out of it.float3 ProceduralStarPSF(float2 d, float fPoints, float fWorkingSpace){	// N points come from N/2 LINES, each of which paints two opposed spikes - the same	// symmetry the iris diffraction streaks are built on.	const int nLines = clamp((int)(fPoints * 0.5), 2, 4);	float3 cSum = 0;	[loop] for (int j = 0; j < nLines; ++j)	{		const float fTheta = (float)j * (PI / (float)nLines);		const float fCos = cos(fTheta);		const float fSin = sin(fTheta);		const float fAlong = dot(d, float2(fCos, fSin));		const float fPerp  = dot(d, float2(-fSin, fCos));		// Thin across (the groove is a line), fading quadratically along its length so the		// tail runs out at the edge of the sprite instead of being cut off.		const float fAbsAlong = min(abs(fAlong), 1.0);		const float fLine = exp(-abs(fPerp) * 40.0) * pow(saturate(1.0 - fAbsAlong), 2.0);		// Dispersion: the groove is a grating, so the far end of each line is where the		// wavelengths have separated most. Red near the core, blue at the tips, washed back		// to white as the line approaches the source it came from.		//		// The three anchors are Rec.709-authored, like every other colour our optics carry, and		// this pass deposits into the working space (SceneReferredSpec.md S3 deviation 5). They		// are the one such colour that lives in a shader rather than in a CPU constant, so the		// conversion is here, gated by a constant the CPU sets - the same colour expressed in		// the primaries the target is actually in, not a different colour.		float3 cHue = (fAbsAlong < 0.5)			? lerp(float3(1.0, 0.25, 0.15), float3(0.35, 1.0, 0.30), fAbsAlong * 2.0)			: lerp(float3(0.35, 1.0, 0.30), float3(0.20, 0.35, 1.0), fAbsAlong * 2.0 - 1.0);		if (fWorkingSpace > 0.5)			cHue = Rec709ToACEScg(cHue);		cSum += fLine * lerp(cHue, 1.0, saturate(1.0 - fAbsAlong));	}	// The undiffracted core: the plate passes most of the light straight through, so the	// source itself is still there under the star.	cSum += exp(-dot(d, d) * 60.0);	return cSum;}float4 FilterPSFPS(v2fFilterPSF IN) : SV_Target{	// Turning the plate turns the pattern, so the PSF is SAMPLED through the inverse	// rotation. Around the sprite centre, which is where the source sits.	const float2 vLocal = IN.QuadUV.xy * 2.0 - 1.0;	const float fCos = FilterPSFParams0.z;	const float fSin = FilterPSFParams0.w;	const float2 d = float2(vLocal.x * fCos + vLocal.y * fSin,	                       -vLocal.x * fSin + vLocal.y * fCos);	float3 cPSF;	if (FilterPSFParams1.z > 0.5)	{		// Authored plate: the pattern is exactly this image, centred, black outside itself.		cPSF = GetTexture2D(HDRFilterPSF_Tex, HDRFilterPSF_LClampSampler, d * 0.5 + 0.5).rgb;	}	else	{		cPSF = ProceduralStarPSF(d, FilterPSFParams1.y, FilterPSFParams1.w);	}	// Alpha 0: the bloom target's alpha channel is not ours to touch.	return float4(IN.Color.rgb * cPSF, 0.0);}////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// Wave-optics diffraction glare (DiffractionKernelSpec.md).//// The glare of a point source IS the Fraunhofer diffraction pattern of the pupil, |F{A}|^2. The// CPU has already transformed the pupil into $DiffractionKernel (sqrt-encoded, core removed:// the frame carries the source itself). What is left here is the two things that make it a// picture: the wavelength scaling and the far field.////  * Scale. The kernel's texel pitch on the sensor is lambda * N * d / L, which at working//    apertures is a fraction of a pixel - the whole texture spans some tens of pixels. So the//    texture resolves the STRUCTURE and the reach comes from the far-field law: past its edge//    the pattern is extrapolated as I_ring(theta) * (R_tex / u)^2, the 1/u^2 of a straight//    edge. That is exact for a straight blade and pessimistic for anything smoother, so the//    extrapolated tail is never brighter than the physics allows.////  * Sampling. Because the pitch is a fraction of a pixel, ONE PIXEL COVERS TENS OF KERNEL//    TEXELS - about 17 at f/16, about 100 wide open - while the rays inside the kernel are one//    or two texels wide. A single tap per pixel therefore hits a ray roughly one time in//    seventeen and the pattern disappears from the picture even though its average energy is//    correct. So the kernel carries a PREFILTERED MIP CHAIN of the LINEAR intensity (built on//    the CPU, sqrt-encoded only after filtering, because sqrt is not linear) and each//    wavelength is read with an explicit LOD: f = fScale / s_q texels per pixel along the//    pattern, lod = log2(max(f, 1)). The tap is then the MEAN intensity over the pixel's//    footprint, and the 1 / s_q^2 below turns that mean into the footprint's integral.//    The sampler must be TRILINEAR - a MIP_NONE sampler is created with MaxLOD 0 and would pin//    every read to level 0.////  * Energy. The kernel is NOT renormalised. Its texels are the Parseval-normalised |F{A}|^2//    of the pupil - the whole pattern summed to 1 before the core was removed - so what the//    texture holds is literally the fraction of the source that was diffracted away. The only//    factor applied here is 1 / pitch^2, which converts "per kernel texel" into "per//    half-resolution pixel", the unit the sprite rasterizes in. Amount 1 is therefore the//    physical fraction (5-15% of the source for a typical iris), not the whole excess. There is//    no bloom-weight divide any more: the deposit goes into the glare's own half-resolution//    layer, which is added straight into the HDR target after the bloom stage, so nothing//    scales it on the way to the screen.////  * Colour. Each wavelength is a scaled copy: PSF_l(u) = (l0/l)^2 * PSF_l0(u * l0/l). Blue is//    compact, red is stretched, which is why a real sunstar's ray runs blue at the core and red//    at the tip. Six samples, weights pre-multiplied and normalised to white on the CPU.float4 DiffractionParams0;    // (sprite radius in half-res px, kernel texel pitch in the same px, R_tex, 1 / pitch^2)float4 DiffractionParams1;    // (dispersion 0..1, grid size L, max LOD = mip count - 1, r_HDRDiffractionDebug mode)float4 DiffractionParams2;    // (sprite half extent x in NDC, half extent y in NDC, energy per unit of source excess, deposited glare fraction)float4 DiffractionParams3;    // (source budget active 0/1, residual quad half extent x in NDC, half extent y in NDC, unused)float4 DiffractionSpectrum[6];// rgb = colour * (l0/l)^2 normalised to white, w = l0 / lfloat4 DiffractionDebugParams;// (display width fraction, display height fraction, log gain, output scale)float4 DiffractionDebugParams1;// (1 / source width, 1 / source height, unused, unused) - debug pass onlyTexture2D<float4> HDRDiffraction_Src   : register(t0);  // thresholded + pre-blurred half res source, vertex shaderTexture2D<float4> HDRDiffraction_Kernel: register(t1);  // sqrt(|F{pupil}|^2), L x L, R16FTexture2D<float4> HDRDiffraction_Ring  : register(t2);  // sqrt(I) on the kernel's boundary ring, 256 x 1, R16FTexture2D<float4> HDRDiffraction_Stats : register(t3);  // 1 x 1 source budget stats, vertex shaderSamplerState HDRDiffraction_PClampSampler : register(s0);  // PointClampSamplerState HDRDiffraction_LClampSampler : register(s1);  // TrilinearClamp - the kernel is mippedSamplerState HDRDiffraction_LWrapSampler  : register(s2);  // LinearWrap - the ring is an angle////////////////////////////////////////////////////////////////////////////////////////////////////// The wave glare's SOURCE BUDGET (decisions/s8-glare-budget.md).//// The sprite pass draws one quad per half-resolution texel and the vertex shader collapses the// ones whose source is empty, so its cost is EXACTLY the number of texels above// HDR_Streaks_Threshold times the sprite's area. Under the scene-referred pre-exposure that// threshold is an absolute scene value, so raising the exposure - or walking outside - can put// tens of thousands of texels over it at once, each drawing a sprite the size of a small window.// That is the reported "brightness up, frame rate down".//// These three passes answer, on the GPU and with no CPU round trip, the one question the vertex// shader needs: what energy must a source have to be worth a sprite this frame?////   1. HDRDiffractionSourceStats   source -> 8x8 tiles: (raw count, count above the cutoff,//                                  summed excess, excess below the cutoff)//   2. HDRDiffractionStatsReduce   tiles  -> a fixed 16x16 target, the same four sums//   3. HDRDiffractionBudget        16x16  -> ONE texel: (cutoff, raw, above, below fraction),//                                  the cutoff corrected from the previous frame's count//// Step 3 is a controller, not a solver: it multiplies the previous cutoff by (count / N)^k and// converges in two or three frames. A histogram would give the answer in one frame with no// state, and would cost three more passes and four more targets to buy a precision that the// vertex shader's one-stop crossfade makes irrelevant - a factor of two in the cutoff is a// factor of two in the sprite count, which is the tolerance the budget already has.//// The cutoff selects the same set a top-N sort would (the N brightest sources are exactly those// above the N-th value) without needing a sort, a compaction pass or an append buffer - none of// which exist anywhere on this path.float4 DiffractionStatsParams0;  // (1 / source width, 1 / source height, block width, block height)float4 DiffractionStatsParams1;  // (source width, source height, target width, target height)float4 DiffractionBudgetParams;  // (budget N, 0 = unlimited, unused, unused, unused)Texture2D<float4> HDRDiffractionStats_Src  : register(t0);  // the source, or the previous stage's tilesTexture2D<float4> HDRDiffractionStats_Prev : register(t1);  // the PREVIOUS frame's 1 x 1 statsSamplerState HDRDiffractionStats_PSampler0 : register(s0);  // PointClampSamplerState HDRDiffractionStats_PSampler1 : register(s1);  // PointClamp// Step 1. One output texel per 8x8 block of source texels. The raw count uses EXACTLY the// vertex shader's collapse test, so "raw sources" in the report is the number of sprites the// pass would rasterize with no budget at all - not an estimate of it.float4 HDRDiffractionSourceStatsPS(vtxOut IN) : SV_Target{	const float2 vSrcSize    = DiffractionStatsParams1.xy;	const float2 vTargetSize = DiffractionStatsParams1.zw;	const float2 vInvSrc     = DiffractionStatsParams0.xy;	const int2   vBlock      = (int2)DiffractionStatsParams0.zw;	const int2 vBase = ((int2)floor(IN.baseTC.xy * vTargetSize)) * vBlock;	// The cutoff this frame's population is measured AGAINST is last frame's - that is the one	// frame of lag the controller has, and it is the whole reason step 3 can be a controller.	const float fPrevCut = HDRDiffractionStats_Prev.SampleLevel(HDRDiffractionStats_PSampler1, float2(0.5, 0.5), 0).x;	float4 acc = 0;	[loop] for (int j = 0; j < vBlock.y; ++j)	{		[loop] for (int i = 0; i < vBlock.x; ++i)		{			const int2 p = vBase + int2(i, j);			if (p.x >= (int)vSrcSize.x || p.y >= (int)vSrcSize.y)				continue;			const float2 uv = ((float2)p + 0.5) * vInvSrc;			const float3 c = HDRDiffractionStats_Src.SampleLevel(HDRDiffractionStats_PSampler0, uv, 0).rgb;			if (dot(c, float3(1, 1, 1)) < 1e-4)				continue;			// The threshold pass keeps the source's hue, so the brightest channel is the number			// that decides what this source is worth - the same measure the report's peak uses.			const float e = max(c.r, max(c.g, c.b));			acc.x += 1.0;			acc.z += e;			if (e >= fPrevCut)				acc.y += 1.0;			else				acc.w += e;		}	}	return acc;}// Step 2. Plain block sum of step 1's output into the fixed 16x16 target, so step 3 is always// exactly 256 taps whatever the resolution is.float4 HDRDiffractionStatsReducePS(vtxOut IN) : SV_Target{	const float2 vSrcSize    = DiffractionStatsParams1.xy;	const float2 vTargetSize = DiffractionStatsParams1.zw;	const float2 vInvSrc     = DiffractionStatsParams0.xy;	const int2   vBlock      = (int2)DiffractionStatsParams0.zw;	const int2 vBase = ((int2)floor(IN.baseTC.xy * vTargetSize)) * vBlock;	float4 acc = 0;	[loop] for (int j = 0; j < vBlock.y; ++j)	{		[loop] for (int i = 0; i < vBlock.x; ++i)		{			const int2 p = vBase + int2(i, j);			if (p.x >= (int)vSrcSize.x || p.y >= (int)vSrcSize.y)				continue;			acc += HDRDiffractionStats_Src.SampleLevel(HDRDiffractionStats_PSampler0, ((float2)p + 0.5) * vInvSrc, 0);		}	}	return acc;}// Step 3. One texel: sum what is left of the frame, then correct the cutoff.float4 HDRDiffractionBudgetPS(vtxOut IN) : SV_Target{	const int2   vSrcSize = (int2)DiffractionStatsParams1.xy;	const float2 vInvSrc  = DiffractionStatsParams0.xy;	float4 acc = 0;	[loop] for (int j = 0; j < vSrcSize.y; ++j)	{		[loop] for (int i = 0; i < vSrcSize.x; ++i)		{			acc += HDRDiffractionStats_Src.SampleLevel(HDRDiffractionStats_PSampler0, ((float2)int2(i, j) + 0.5) * vInvSrc, 0);		}	}	const float fRaw   = acc.x;	const float fAbove = acc.y;	const float fSum   = acc.z;	const float fBelow = acc.w;	const float fPrevCut = HDRDiffractionStats_Prev.SampleLevel(HDRDiffractionStats_PSampler1, float2(0.5, 0.5), 0).x;	const float fBudget  = DiffractionBudgetParams.x;	// Below this the cutoff is indistinguishable from off, and holding a denormal one alive would	// keep the vertex shader's crossfade running for no reason.	const float kMinCut = 1e-6;	float fCut;	if (fBudget < 0.5 || fRaw <= fBudget)	{		// The budget is off, or the whole population fits inside it: DECAY the cutoff rather than		// snapping it to zero, so a frame that drops back under the budget fades its stars in over		// a few frames instead of switching them on. A scene that has always fitted sits at 0, and		// the sprite pass is then bit-identical to the un-budgeted one.		fCut = fPrevCut * 0.5;		if (fCut < kMinCut)			fCut = 0.0;	}	else if (fPrevCut <= 0.0)	{		// Bootstrap. Two decades BELOW the mean excess, and climb: starting at the answer would		// cull half the frame in a single frame, which is exactly the pop this exists to avoid.		fCut = max(0.01 * fSum / max(fRaw, 1.0), kMinCut);	}	else if (fAbove <= fBudget && fAbove >= 0.8 * fBudget)	{		// Dead band. Without it the controller hunts around N by a few sources every frame - and		// the sources it hunts over are the ones on the crossfade, i.e. it would flicker them.		fCut = fPrevCut;	}	else	{		// Asymmetric on purpose: react fast when there are too many (that is the frame-rate cliff		// arriving) and relax slowly when there are too few (that is only a missing star).		const float fRatio = clamp(fAbove / max(fBudget, 1.0), 0.02, 100.0);		const float fStep  = (fRatio > 1.0) ? 0.5 : 0.15;		fCut = max(fPrevCut * pow(fRatio, fStep), kMinCut);	}	return float4(fCut, fRaw, fAbove, (fSum > 0.0) ? (fBelow / fSum) : 0.0);}struct v2fDiffraction{	float4 Position : SV_POSITION;	float4 QuadUV   : TEXCOORD0;  // xy: quad local, 0..1 across the sprite. z: 1 = the budget's residual quad. w unused.	float4 Color    : TEXCOORD1;  // rgb: this source's deposit. a unused.};v2fDiffraction DiffractionPSFVS(uint nVertexID : SV_VertexID){	v2fDiffraction OUT = (v2fDiffraction) 0;	OUT.Position = SpriteGridCentrePos(nVertexID);	const float4 screenProj = HPosToScreenTC(OUT.Position);	// One point read at the texel centre. The threshold pass already rescaled the source to its	// own excess above the knee with the hue preserved, so this IS the excess E.	const float3 cExcess = GetTexture2DLod(HDRDiffraction_Src, HDRDiffraction_PClampSampler, float4(screenProj.xy, 0, 0)).rgb;	// Nothing survived the threshold here: collapse the quad instead of rasterizing a sprite	// that would deposit zero. This is what keeps the cost proportional to the number of bright	// sources rather than to the frame area - and these sprites are large.	if (dot(cExcess, float3(1, 1, 1)) < 1e-4)	{		OUT.Position.xy = 0;		return OUT;	}	// The SOURCE BUDGET (decisions/s8-glare-budget.md). DiffractionParams3.x is 0 unless the	// budget is configured AND the scene-referred path is on, and at 0 not one line of this runs -	// which is what keeps the un-budgeted path byte-identical rather than merely equal.	float fWeight = 1.0;	if (DiffractionParams3.x > 0.5)	{		const float fCut = HDRDiffraction_Stats.SampleLevel(HDRDiffraction_PClampSampler, float2(0.5, 0.5), 0).x;		if (fCut > 0.0)		{			// One STOP of crossfade, not a hard cut: a source drifting past the budget while the			// camera pans loses its rays over several frames instead of switching off. This is the			// whole anti-popping mechanism and it costs one smoothstep.			const float e = max(cExcess.r, max(cExcess.g, cExcess.b));			fWeight = smoothstep(fCut, fCut * 2.0, e);		}	}	if (fWeight <= 0.0)	{		// Below the budget: no sprite - but the LIGHT does not disappear. A single half-res texel		// carries the whole energy the pattern would have spread (excess * gain * the deposited		// fraction) into the same layer, at the source's own position. The frame's total is		// unchanged, so turning the budget on cannot darken a scene, and a source crossing the		// budget loses its SHAPE, not its light. The layer is bilinearly upscaled into the HDR		// target, so one texel lands as a soft 2x2 native blob on the source itself.		OUT.Color.rgb = cExcess * DiffractionParams2.z * DiffractionParams2.w;		OUT.Position.xy += g_SpriteQuadVerts[nVertexID % 6].xy * DiffractionParams3.yz;		OUT.QuadUV = float4(g_SpriteQuadVerts[nVertexID % 6].xy * 0.5 + 0.5, 1, 0);		return OUT;	}	// float, not half: the deposit carries the bloom-weight divide (a factor of some 250) on top	// of an HDR excess, which overflows half long before it overflows anything visible.	OUT.Color.rgb = cExcess * DiffractionParams2.z * fWeight;	// The x half extent already carries the anamorphic stretch: the iris sits BEHIND the	// cylindrical group, so its pattern is formed unsqueezed and the desqueeze widens it.	OUT.Position.xy += g_SpriteQuadVerts[nVertexID % 6].xy * DiffractionParams2.xy;	OUT.QuadUV = float4(g_SpriteQuadVerts[nVertexID % 6].xy * 0.5 + 0.5, 0, 0);	return OUT;}float4 DiffractionPSFPS(v2fDiffraction IN) : SV_Target{	// The budget's RESIDUAL deposit (see the vertex shader): one texel carrying the energy this	// source's pattern is not going to spread. Flat, no kernel, no windows, no dispersion - it is	// an energy being conserved, not a picture being drawn.	if (IN.QuadUV.z > 0.5)		return float4(IN.Color.rgb, 0.0);	// Quad local in [-1, 1] scaled to the PATTERN's own coordinates. The y flip puts us in the	// texture space the pupil was rastered in (v down), which is the space the bokeh shape mask	// is authored in and the space the iris phase is measured in - so a mask's diffraction	// pattern comes out the same way up as its bokeh, and Blade Rotation turns both together.	// x needs no undo of the anamorphic stretch: the quad was widened, so quad-local x = 1 is	// still one pattern radius.	const float2 vLocal = IN.QuadUV.xy * 2.0 - 1.0;	const float2 d = float2(vLocal.x, -vLocal.y) * DiffractionParams0.x;	const float r = length(d);	// Two windows, both in SCREEN space, both applied to the final intensity. They are the	// difference between "the maths is right" and "the picture is right", and neither is	// cosmetic:	//	//  * OUTER (w_out). The sprite is a square quad and the 1/u^2 extrapolation is still finite	//    at its boundary, so the boundary is a hard cut - and a hard cut around every small	//    emitter is a visible WHITE SQUARE FRAME. Feathering the last 20% of the radius and	//    zeroing everything past it turns the square into a round cut-off: the quad's corners	//    (r up to sqrt(2) R) never draw. The energy this removes is the outermost, faintest	//    part of the logarithmic tail - the CPU's tail estimate accounts for it by integrating	//    to 0.9 R instead of R.	//	//  * INNER (w_in). The deposit target is HALF resolution and, just outside the removed	//    core, the pattern falls as 1/u^2 from about six texels - roughly 1.4 native pixels -	//    so the slope crosses a whole deposit texel in almost nothing and the deposit shows as	//    native BLOCKS around the source (4x4 when this pass ran at quarter resolution, 2x2	//    now). The analytic streaks never exposed this	//    because their exponential falloff is orders of magnitude gentler. The first four	//    half-res pixels - the same EIGHT NATIVE the quarter-res version faded over two of its	//    own, so the figure on screen is unchanged - belong to the source itself and to the	//    bloom around it in any case, so fading the glare in over that radius costs nothing that can be seen	//    and removes the only part of the pattern the grid cannot represent. It is NOT free in	//    energy terms - it is the steepest part of the pattern - but the kernel's own core	//    removal (2.5 Airy radii) is unchanged, so the energy accounting is untouched and the	//    loss is a small extra deficit at the very centre, reported in the log as a radius in	//    kernel texels rather than estimated (it needs the kernel's radial profile, which is	//    not on this side of the job).	//	// The step the previous round named and did not take - "run the sprite pass into a	// half-resolution target of its own and composite that down" - has now been taken, because	// the windows alone did not cure the blocks: the SOURCE grid was half the problem, and no	// amount of windowing the deposit can fix a square that is already in the sum of the	// sprites. See the renderer's comment on ExecuteDiffraction.	const float fSpriteRadius = max(DiffractionParams0.x, 1e-4);	// Half-res pixels, so 8 native - the CPU's log prints this radius in kernel texels and	// computes it from the same constant.	const float kDiffractionInnerWindowPx = 4.0;	const float w_out = 1.0 - smoothstep(0.8, 1.0, r / fSpriteRadius);	const float w_in = smoothstep(0.0, kDiffractionInnerWindowPx, r);	const float fWindow = w_in * w_out;	// The quad's corners are outside the round cut-off: nothing there can ever be drawn, so	// skip the six kernel taps as well.	if (fWindow <= 0.0)		return float4(0, 0, 0, 0);	const float2 vDir = (r > 1e-6) ? (d / r) : float2(1, 0);	// Off the normalised direction, not off d: at the exact sprite centre atan2(0, 0) is not	// defined and would poison the ring lookup for that pixel.	const float fTheta = atan2(vDir.y, vDir.x);	// Distance from the source in KERNEL TEXELS at the reference wavelength.	const float fPitch = max(DiffractionParams0.y, 1e-6);	const float u0 = r / fPitch;	const float fRingRadius = DiffractionParams0.z;	const float fInvL = 1.0 / max(DiffractionParams1.y, 1.0);	const float fMaxLod = DiffractionParams1.z;	// r_HDRDiffractionDebug 2 - shape only. Everything above and below runs exactly as it does	// in mode 0 (same sources, same sprite, same mip LOD), only the DEPOSIT is replaced.	const bool bShapeOnly = abs(DiffractionParams1.w - 2.0) < 0.5;	// The boundary ring, once: it is a function of the angle only, and all six wavelengths	// extrapolate off the same edge. It is NOT mipped: its 256 bins already span 6+ texels of a	// ~1600-texel circumference, which is the same order as the angular footprint of a pixel	// covering 17 texels, so a bin is already the pixel's angular average to within a factor. The CPU binned it over [0, 2pi) starting at +x, so u is	// theta / 2pi with NO half-texture offset; atan2's negative half wraps round through the	// sampler, which is why the ring must be sampled wrapped and not clamped.	const float fRingEnc = GetTexture2D(HDRDiffraction_Ring, HDRDiffraction_LWrapSampler,	                                    float2(fTheta * (0.5 / PI), 0.5)).x;	const float fRingI = fRingEnc * fRingEnc;	float3 cSum = 0;	float fISum = 0;	[unroll]	for (int i = 0; i < 6; ++i)	{		// Dispersion 0 collapses every wavelength onto 550 nm: one white pattern, no rainbow.		const float fScale = lerp(1.0, DiffractionSpectrum[i].w, DiffractionParams1.x);		const float u = u0 * fScale;		float I;		if (u <= fRingRadius)		{			// This pixel's footprint in kernel texels at THIS wavelength: u = r * fScale / s_q,			// so one pixel of r is fScale / s_q texels of u. Never below one texel (the pattern			// can be magnified, in which case level 0 is already finer than the pixel).			const float fFootprint = fScale / fPitch;			const float fLod = clamp(log2(max(fFootprint, 1.0)), 0.0, fMaxLod);			// sqrt-encoded so the 1e-8 tails stay above half float's denormals. The chain was			// box filtered in LINEAR intensity, so k * k is the mean intensity over the			// footprint at every level - which is what makes one tap an integral.			const float k = GetTexture2DLod(HDRDiffraction_Kernel, HDRDiffraction_LClampSampler,			                                float4(0.5 + (u * fInvL) * vDir, 0, fLod)).x;			I = k * k;		}		else		{			const float t = fRingRadius / u;			I = fRingI * t * t;		}		cSum += DiffractionSpectrum[i].rgb * I;		fISum += I;	}	// r_HDRDiffractionDebug 2: paint the PATTERN, not its energy. The source's excess, the	// texel-to-pixel norm and the bloom-weight divide are all dropped and every source that	// passed the threshold deposits the same fully visible figure. The colour is the spectral	// sum renormalised to its own peak, so the dispersion rainbow stays readable at full	// brightness. This answers "does the pass draw at all, where does it land, how big is it,	// what shape is it" without any argument about how much light it should have received.	//	// The curve is a DECADE MAP, not the kernel view's log(1 + I * 1e6). That gain belongs to	// the corner view, which reads the kernel at level 0 where a ray texel is around 1e-4; what	// arrives HERE is the pixel's footprint MEAN - one deposit pixel covers some 17 kernel texels	// at f/16 and a hundred wide open - plus the 1/u^2 tail, which together run from about 1e-4	// just outside the core to 1e-12 at the rim of the sprite. Pushed through the old curve, a	// typical 1e-8 pixel came out at 0.0007: black. Mapping ten decades, 1e-13 (black) to 1e-3	// (white), puts that same pixel at mid grey and keeps the faint tail visible - which is the	// entire point of the mode.	if (bShapeOnly)	{		const float v = saturate((log10(max(fISum, 1e-20)) + 13.0) * 0.1);		const float fPeak = max(cSum.x, max(cSum.y, cSum.z));		const float3 cHue = (fPeak > 1e-20) ? (cSum / fPeak) : float3(1, 1, 1);		// The windows are geometry, not deposit: mode 2 must show the figure the pass actually		// rasterizes, round cut-off and faded centre included.		return float4(cHue * v * fWindow, 0.0);	}	// Alpha 0: the bloom target's alpha channel is not ours to touch.	return float4(IN.Color.rgb * cSum * (DiffractionParams0.w * fWindow), 0.0);}// r_HDRDiffractionDebug 1: the kernel itself, into the top-left corner on a log tone curve.// The pattern spans eight decades, so anything linear is a black square with a white dot.// r_HDRDiffractionDebug 3: the pass's own thresholded SOURCE texture in the same corner - the// excess above HDR_Streaks_Threshold that the sprites are fed - on a decade scale, so it can be// read off the picture whether there is any glare source on screen at all and how bright it is.float4 DiffractionDebugPS(vtxOut IN) : SV_Target{	const float2 uv = IN.baseTC.xy / max(DiffractionDebugParams.xy, 1e-4);	if (uv.x > 1.0 || uv.y > 1.0)		return float4(0, 0, 0, 0);	if (DiffractionParams1.w > 2.5)	{		// The panel is a HALF SIZE copy of a quarter-resolution texture, so it MINIFIES 2:1 -		// and the sources it exists to show are one or two texels across. Point sampling one tap		// per panel pixel therefore throws away three quarters of the isolated bright texels and		// the panel comes up black even with a lamp blazing away in the frame. So: a 5x5 MAX		// over the source's own texel grid. It cannot drop a texel (the taps are contiguous at		// one texel spacing, which covers the 2:1 footprint twice over) and it DILATES - a		// single hot texel paints a 3x3 block of panel pixels, some 12x12 native, which is		// something you can see rather than something you have to hunt for.		const float2 vTexel = DiffractionDebugParams1.xy;		float E = 0.0;		[unroll]		for (int y = -2; y <= 2; ++y)		{			[unroll]			for (int x = -2; x <= 2; ++x)			{				const float3 c = GetTexture2DLod(HDRDiffraction_Src, HDRDiffraction_PClampSampler,				                                 float4(uv + float2(x, y) * vTexel, 0, 0)).rgb;				E = max(E, max(c.x, max(c.y, c.z)));			}		}		// A dim floor over the whole panel and a brighter border around it, so the panel is		// visible WHETHER OR NOT anything cleared the threshold. Without it "no sources" and		// "the debug pass never ran" are the same black rectangle, which is the one confusion a		// diagnostic must not have.		const float fBorder = 0.004;  // panel-relative, so about two pixels of a 480 px panel		const bool bBorder = any(uv < fBorder) || any(uv > (1.0 - fBorder));		float e = bBorder ? 0.12 : 0.03;		// Four decades of grey above that floor, and any excess at all starts a quarter of the		// way up: E = 0+ -> 0.25, 1 -> 0.30, 10 -> 0.44, 100 -> 0.62, 1000 -> 0.81, 10000 -> 1.		if (E > 0.0)			e = 0.25 + 0.75 * saturate(log10(1.0 + E) * 0.25);		return float4(e.xxx * DiffractionDebugParams.w, 0.0);	}	// Level 0 deliberately: this view is here to show the kernel's true structure, not what a	// screen pixel would average out of it.	const float k = GetTexture2DLod(HDRDiffraction_Kernel, HDRDiffraction_LClampSampler, float4(uv, 0, 0)).x;	const float I = k * k * DiffractionDebugParams.z;	const float v = log(1.0 + I) / log(1.0 + DiffractionDebugParams.z);	return float4(v.xxx * DiffractionDebugParams.w, 0.0);}// The glare layer into the HDR target. Additive, bilinear, half res to native - the layer holds// nothing but what the sprites deposited, in the units the frame is already in, so there is// nothing to scale on the way. Alpha is left alone by the blend state.float4 DiffractionCompositePS(vtxOut IN) : SV_Target{	// Slot 0, and the composite pass binds a LINEAR sampler there - the slot the sprite pass	// point samples the source grid with is the same slot this magnifies the layer through.	return float4(GetTexture2D(HDRDiffraction_Src, HDRDiffraction_PClampSampler, IN.baseTC.xy).rgb, 0.0);}////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////float4 SampleLumOffsets0;float4 SampleLumOffsets1;Texture2D<float4> HDRLum_Targ           : register(t0);Texture2D<float4> HDRLum_Norm           : register(t1);Texture2D<float4> HDRLum_Diff           : register(t2);Texture2D<float4> HDRLum_Spec           : register(t3);SamplerState HDRLum_LClampSampler       : register(s0);   //LinearClampfloat2 HDRSampleLumInitialPS(vtxOut IN) : SV_Target{	half  fRecipSampleCount = 0.25h;	half  fCenterWeight = 1;//saturate(1-length(IN.baseTC.xy*2-1));	half2 vLumInfo = 0;	float2 sampleOffsets[4] = {SampleLumOffsets0.xy, SampleLumOffsets0.zw, SampleLumOffsets1.xy, SampleLumOffsets1.zw};		[unroll] for (int i = 0; i < 4; ++i)	{		float2 SampleTC = IN.baseTC.xy + sampleOffsets[i];		SampleTC = MapViewportToRaster(SampleTC);		 		// Use base color to get a coarse approximation of the (incoming) illuminance		MaterialAttribsCommon attribs = DecodeGBuffer(			GetTexture2D(HDRLum_Norm, HDRLum_LClampSampler, SampleTC),			GetTexture2D(HDRLum_Diff, HDRLum_LClampSampler, SampleTC),			GetTexture2D(HDRLum_Spec, HDRLum_LClampSampler, SampleTC));		half baseColorLum = max(max(GetLuminance(attribs.Albedo), GetLuminance(attribs.Reflectance)), 0.01);				// Assume emissive surfaces (especially sky) have the typical scene reflectance to keep auto exposure more stable		if (GetLuminance(attribs.Albedo) == 0)			baseColorLum = 0.2;				half3 cTex = GetTexture2D(HDRLum_Targ, HDRLum_LClampSampler, SampleTC).rgb;		half  fLum = all(isfinite(cTex)) ? GetWorkingLuminance(cTex) : 0;  // Filter out nans		// Scene-referred: an Inf here is not a bug, so it must not be read as black.		//		// SCENE_METER_CEILING is 0 on the stock path and the branch below is dead, byte for byte.		// Under the switch the HDR target holds PRE-EXPOSED scene radiance, and a sun disc at a		// daylight exposure sits within a stop or two of fp16's 65504 - one stop of over-exposure		// and those texels are +Inf, legitimately. The stock filter answers Inf with 0, which in		// a LOG mean is log(1e-6) = -13.8 nats per tap: a handful of sun pixels drag the		// geometric-mean illuminance to ~1e-6, the camera meters EV ~ -18, the pre-exposure scale		// jumps by four orders of magnitude, MORE texels overflow to Inf, and the loop ratchets		// one step per readback until it is pinned at Auto EV Min with the frame blown white.		// Positive feedback out of a sign error, not out of the exposure bookkeeping.		//		// So clamp instead of zero, at a ceiling expressed in stops above mid grey - the one		// anchor the pre-exposure guarantees (0.18). A tap brighter than that is a specular or		// solar highlight whose exact value an incident meter has no opinion about; reading it as		// "very bright" pushes EV UP, which is negative feedback and converges. The ceiling also		// keeps the geometric mean itself inside fp16, which the R16G16F meter target needs.		if (SCENE_METER_CEILING > 0)			fLum = all(isfinite(cTex)) ? min(fLum, SCENE_METER_CEILING) : SCENE_METER_CEILING;		half fIllum = fLum / baseColorLum * PI;		if (SCENE_METER_CEILING > 0)			fIllum = min(fIllum, SCENE_METER_CEILING * (PI / 0.18));		vLumInfo.x += log(fLum + 1e-6);       // Luminance		vLumInfo.y += log(fIllum + 1e-6);     // Illuminance	}	return fCenterWeight * fRecipSampleCount * vLumInfo;}///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////float2 HDRSampleLumIterativePS(vtxOut IN) : SV_Target{	const int nIter = 4;	const half nIterI = 0.25f;	// TODO: Could use Gather instead? (no iteration necessary)	half2 vResampleSum = 0; 	for (int i=0; i < nIter; i++)		vResampleSum += GetTexture2D(HDRLum_Targ, HDRLum_LClampSampler, IN.baseTC.xy + SampleOffsets[i].xy).rg;	vResampleSum *= nIterI;#if %_RT_SAMPLE0 	vResampleSum = exp( vResampleSum );#endif	return vResampleSum;}////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// Final eye/luminance adaptationTexture2D<float2> HDRCalc_Prev : register(t0); // 1x1 rgTexture2D<float2> HDRCalc_TMap : register(t1); // 1x1 rgfloat2 HDRCalculateAdaptedLumPS() : SV_Target{	half2 vAdaptedLum = HDRCalc_Prev.Load(int3(0, 0, 0));	half2 vCurrentLum = HDRCalc_TMap.Load(int3(0, 0, 0));	return max(0, vAdaptedLum + (vCurrentLum - vAdaptedLum) *  ElapsedTime.yyzz);}////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////#define LIGHT_UNIT_SCALE 10000.0fhalf ComputeExposure(float fIlluminance){	// Compute EV with ISO 100 and standard camera settings	half EV100 = log2(fIlluminance * LIGHT_UNIT_SCALE * 100.0 / 330.0);		// Apply automatic exposure compensation based on scene key	EV100 -= ((clamp(log10(fIlluminance * LIGHT_UNIT_SCALE + 1), 0.1, 5.2) - 3.0) / 2.0) * HDREyeAdaptation.z;		// Clamp EV	EV100 = clamp(EV100, HDREyeAdaptation.x, HDREyeAdaptation.y);		// Compute maximum luminance based on Saturation Based Film Sensitivity (ISO 100, lens factor q=0.65)	float maxLum = exp2(EV100);		return (LIGHT_UNIT_SCALE / 1.2f) * rcp(maxLum);}////////////////////////////////////////////////////////////////////////////////////////////////////////////// The scene-referred display chain (SceneReferredSpec.md S4/S5, D8, D9, D10).//// Its own constant block: HDRMiscParams and HDREyeAdaptation are both unread on this branch and// could have carried these numbers, but CToneMappingStage::DisplayDebugInfo() still prints their// OLD meanings and a debug readout that lies is worse than six float4s.////////////////////////////////////////////////////////////////////////////////////////////////////////////float4 SceneWBRow0;      // Bradford white-balance matrix, in the working space (AP1). Row 0.                         // .w = the sensor's saturation level in LINEAR working-space units                         //      (0.18 * 2^N), 0 = no clip. It rides here because the clip happens                         //      immediately after this matrix; see FilmMapping step 1b.float4 SceneWBRow1;      // Row 1. .w unused.float4 SceneWBRow2;      // Row 2. .w unused.float4 SceneCDLSlope;    // ASC CDL slope.rgb, .w = saturation (1 = neutral)float4 SceneCDLOffset;   // ASC CDL offset.rgb, .w = LMT grid size N (0 = no look loaded)float4 SceneCDLPower;    // ASC CDL power.rgb, .w = ODT grid size N (0 = no output transform loaded)Texture3D lmtTex : register(t3);   // creative look, ACEScct in / ACEScct outTexture3D odtTex : register(t4);   // output transform, ACEScct in / display-encoded outSamplerState linearClamp3DSS : register(s1);// The standard half-texel inset for an N^3 grid: the first and last samples sit at the CENTRES// of the outer texels, so the usable range is [0.5/N, 1 - 0.5/N] and an input of 0..1 has to be// mapped onto it. Exactly the correction TexColorChart2D makes for its unwrapped strip, one// dimension up. Getting it wrong is a small, uniform, entirely invisible error - which is why it// is spelled out here instead of being folded into the call.float3 SampleLut3D(Texture3D lut, SamplerState ss, float3 c, float fGridSize){	const float fScale = (fGridSize - 1.0) / fGridSize;	const float fBias  = 0.5 / fGridSize;	return lut.SampleLevel(ss, saturate(c) * fScale + fBias, 0).rgb;}half3 FilmMapping( in vert2frag IN, in half3 cScene, in half3 cBloom, in half3 vAdaptedLum, in half fVignetting, out half3 cExportTap ){	// The EXR export tap (SceneReferredSpec.md section 2, S6). Zero on the stock path and on	// every frame that is not capturing - the caller only writes it to SV_Target1 under	// %_RT_SAMPLE2, so with the flag clear the whole thing is dead code and the compiler	// removes it. Declared as an out parameter rather than computed twice because the value	// wanted is a shader TEMPORARY: it exists between the LMT fetch and the ODT fetch and	// nowhere else.	cExportTap = (half3)0;#if %_RT_SAMPLE0	// ------------------------------------------------------------------------------------	// The scene-referred branch. Nothing in here knows what a display is except the last	// fetch, which IS the display transform.	//	// Whole-body #if rather than an #if inside the function on purpose: ComputeExposure() is	// called unconditionally on the stock path, and leaving it above the branch would keep	// evaluating the EV formula and reading the luminance texture for a value this path throws	// away. The exposure here is exactly 1.0 - S1 applied it on the light side, so the HDR	// target arrives already exposed and applying any of it again would expose the frame twice.	//	// Shared with the stock path and deliberately UNCHANGED: the vignette scalar (a lens	// transmission, already in the right place - it multiplies scene-linear light) and the bloom	// composite (its form is a look question that belongs with the S7 re-thresholding, not here).	// ------------------------------------------------------------------------------------	half3 cColor = fVignetting * lerp(cScene, cBloom, saturate(HDRBloomColor));	// 1. White balance. A Bradford chromatic adaptation from the temperature the CAMERA is set	//    to towards the neutral setting, expressed as a 3x3 in the working space and computed on	//    the CPU (CToneMappingStage::ResolveWhiteBalanceMatrix). Exactly identity when white	//    balance is off or at the neutral setting, so this multiply is a no-op by construction	//    and not by approximation. Scene-linear in, scene-linear out.	cColor = mul(float3x3(SceneWBRow0.xyz, SceneWBRow1.xyz, SceneWBRow2.xyz), cColor);	// 1b. SENSOR SATURATION - the full well (decisions/s8-sensor-clip.md).	//	//     Every RAW converter clips the highlights per channel at ONE common level and does it	//     AFTER the white-balance gains, for one reason: the gains are per channel, so a neutral	//     highlight that was already clipped comes out of them tinted by the inverse of the	//     illuminant - which is exactly the "white balance 5600 -> 3200 K turns the clipped sky	//     blue" report. Clipped here, at a level the three channels share, a clipped neutral	//     stays neutral at every colour temperature, and only the highlights that were NOT	//     clipped take the WB's colour, which is what a camera does.	//	//     This is the SENSOR, not the lens. Everything upstream - bloom, glare, diffraction,	//     depth of field - runs on the unclipped radiance on purpose: the lens sees the light	//     that is really there, and a sun a hundred thousand times over the clip level must	//     still throw a hundred-thousand-times flare. The clip is the last thing before the	//     grading space because it is the last thing before the picture becomes a picture.	//	//     0 = off, which is what the stock path and an unpublishing camera read, so the branch	//     folds away and nothing changes. Negatives are left alone (min, not clamp): they are	//     legal AP1 values and the ODT's own domain handling owns them.	if (SceneWBRow0.w > 0.0)		cColor = min(cColor, (half3)SceneWBRow0.w);	// 2. Linear ACEScg -> ACEScct. The grading space, the LUT domain and the shaper are all the	//    same encoding, so this happens once and everything downstream is log.	float3 cGrade = LinearToACEScct((float3)cColor);	// 3. ASC CDL, in the order the ASC specification fixes:	//        out = (in * slope + offset) ^ power	//    with the power applied to the clamped result (the spec's "negative values are clamped	//    to zero before the power function"), per channel and with no cross-channel term.	//    Saturation is the ASC's own extension and comes AFTER the SOP, about the luminance of	//    the already-graded value - and the luminance weights are AP1's, because that is the	//    space this is happening in. Using Rec.709 weights on AP1 data is the classic silent	//    failure: the picture is wrong and nothing reports it.	cGrade = cGrade * SceneCDLSlope.rgb + SceneCDLOffset.rgb;	cGrade = pow(max(cGrade, 0.0), SceneCDLPower.rgb);	const float fGradeLuma = dot(cGrade, ACESCG_LUMINANCE_WEIGHTS);	cGrade = fGradeLuma + SceneCDLSlope.w * (cGrade - fGradeLuma);	// 4. The look (LMT), ACEScct in and out. An empty slot is the identity look - D10's "no	//    hidden ReC look": with nothing loaded the picture is pure ACES.	if (SceneCDLOffset.w > 1.5)		cGrade = SampleLut3D(lmtTex, linearClamp3DSS, cGrade, SceneCDLOffset.w);	// --- EXPORT TAP -------------------------------------------------------------------------	// The graded value, back in LINEAR ACEScg. This is the spec's "the buffer here is what gets	// written to EXR": everything the camera does (WB, CDL, LMT, and the composites before them)	// has happened, and nothing that knows about a display has.	//	// The clip of step 1b is upstream of this point, so the tap carries it too - the EXR is a	// file of what the SENSOR recorded, and a capture whose highlights ran past the full well	// would not match the picture the ODT shows. There is deliberately no second clip here.	//	// The inverse shaper is NOT an operator being undone - the ACEScct encode belongs to the ODT	// LUT's input domain, not to the grade. An EXR of the log value would be a file no ACES tool	// could interpret without being told about our private shaper, and the D12 round trip	// (Resolve applies its own ACES 2.0 output transform to this file) needs scene-linear.	cExportTap = (half3)ACEScctToLinear(cGrade);	// 5. The output transform (ODT), ACEScct in and DISPLAY-ENCODED [0,1] out. The back buffer	//    is R8G8B8A8_UNORM and is not sRGB-typed, so the encode has to be inside this LUT; the	//    engine's own sRGB curve at the end of the stock branch is what it replaces.	//	//    With no ODT loaded the picture is deliberately, visibly wrong - the log image, clamped	//    - instead of quietly falling back to the film curve. A wrong picture that cannot be	//    mistaken for a correct one is what D13 asks for.	if (SceneCDLPower.w > 1.5)		return (half3)SampleLut3D(odtTex, linearClamp3DSS, cGrade, SceneCDLPower.w);	return (half3)saturate(cGrade);#else	// Compute exposure	half fExposure = ComputeExposure(vAdaptedLum.y);#if %_RT_SAMPLE4	// Legacy exposure mode	// Krawczyk scene key estimation adjusted to better fit our range - low (0.05) to high key (0.8) interpolation based on avg scene luminance	const half fSceneKey = 1.03h - 2.0h / (2.0h + log2(vAdaptedLum.x + 1.0));	fExposure = clamp(fSceneKey / vAdaptedLum.x, HDREyeAdaptation.y, HDREyeAdaptation.z);#endif	half3 cColor = fVignetting * fExposure * lerp(cScene, cBloom, saturate(HDRBloomColor));	// hdr color grading	half fLuminance = GetWorkingLuminance(cColor);	cColor = fLuminance + HDRColorBalance.a * ( cColor - fLuminance );	// saturation	cColor *= HDRColorBalance.rgb;	// color balance	// Filmic response curve as proposed by J. Hable	half4 c = half4(max(cColor, 0), HDRFilmCurve.w);	const half ShoStren = 0.22 * HDRFilmCurve.x, LinStren = 0.3 * HDRFilmCurve.y, LinAngle = 0.1, ToeStren = 0.2, ToeNum = 0.01 * HDRFilmCurve.z, ToeDenom = 0.3;	half4 compressedCol = ((c * (ShoStren * c + LinAngle*LinStren) + ToeStren*ToeNum) / (c * (ShoStren * c + LinStren) + ToeStren*ToeDenom)) - (ToeNum/ToeDenom);	cScene = saturate(compressedCol / compressedCol.w);		// Apply gamma correction using exact sRGB curve	cScene = (cScene < 0.0031308) ? 12.92h * cScene : 1.055h * pow(cScene, 1.0h / 2.4h) - half3(0.055h, 0.055h, 0.055h);	return cScene;#endif}////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////half4 GetHDRTargetMS( float2 baseTC, int NumSamples, int nCurrSample ) {	int3 vPixCoord = int3( baseTC * PS_ScreenSize.xy, 0);	return baseMapMS.Load(vPixCoord, nCurrSample);}half4 GetZTargetMS( float2 baseTC, int NumSamples, int nCurrSample ) {	int3 vPixCoord = int3( baseTC * PS_ScreenSize.xy, 0);	return zMapMS.Load(vPixCoord, nCurrSample);}////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////half3 HDRToneMapSample( in vert2frag IN, in half3 vSample, in half3 cBloom, in half3 vAdaptedLum, in half fVignetting, out half3 cExportTap){	vSample = FilmMapping(IN, vSample, cBloom, vAdaptedLum, fVignetting, cExportTap);	return saturate(vSample);}float3 NRand3( float2 seed ){	return frac(sin(dot(seed.xy, float2(34.483, 89.637))) * float3(29156.4765, 38273.5639, 47843.7546));}void ApplyRandomDithering(inout half3 color, float2 uv){	// Apply dithering in sRGB space to minimize quantization artifacts	// Use a triangular distribution which gives a more uniform noise by avoiding low-noise areas	float3 rndValue = NRand3(uv) + NRand3(uv + 0.5789) - 0.5;	color += rndValue / 255.0;}void ApplyOrderedDithering(inout half3 color, int2 uv){	// Get values from -15.5/32 to 15.5/32 (~-0.5f to ~0.5f)	float fThresholdR = GetDissolveThreshold17(uv + int2(0, 0)) - 0.5f * (15.0f / 16);	float fThresholdG = GetDissolveThreshold17(uv + int2(0, 1)) - 0.5f * (15.0f / 16);	float fThresholdB = GetDissolveThreshold17(uv + int2(0, 2)) - 0.5f * (15.0f / 16);	// Add dithering below 10bit range (we convert from HDR to 10bit)	// NOTE: with R11G11B10F we could add dither below the 6bit mantissa instead	color.r = saturate(color.r + fThresholdR * (1.0f / 1024.0f));	color.g = saturate(color.g + fThresholdG * (1.0f / 1024.0f));	color.b = saturate(color.b + fThresholdB * (1.0f / 1024.0f));}////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////Texture2D<float3> hdrTex   : register(t0); // WxHTexture2D luminanceTex     : register(t1); // 1x1Texture2D<float3> bloomTex : register(t2); // WxH quarter resTexture2D vignettingTex    : register(t7); // ?x?// x = residual vignette strength (0 = off, 1 = stock map, 2 = deepened): the glass and sensor// falloff. y = the field-dependent pupil's barrel offset at the frame corner, z = the barrel// radius, both in pupil units - together they are the MECHANICAL light loss, applied here and// nowhere else (FieldPupilSpec.md section 2.3). w = field debug flag.float4 HDRVignetteParams;Texture2D colorChartTex    : register(t8); // ?x?Texture2D sunShaftsTex     : register(t9); // WxH full or half resSamplerState linearClampSS : register(s0);// The MRT form of the tone map's output. Slot 1 exists only under %_RT_SAMPLE2 - the S6 export// permutation - so with the flag clear this is the stock single-target signature and the pass// binds nothing extra (research/s6-capture-path.md section 5, tap T2).struct pixoutHDRFinal{	half4 Color   : SV_Target0;#if %_RT_SAMPLE2	half4 Export  : SV_Target1;#endif};pixoutHDRFinal HDRFinalScenePS(vert2frag IN){	pixoutHDRFinal OUT = (pixoutHDRFinal)0;	float2 ScreenTC = MapViewportToRaster(IN.baseTCScaled.xy);	half  fVignetting = 1;	half3 cBloom = 0;	// Strength driven vignette (r_HDRVignetteAmount / lens character). Note the legacy	// SAMPLE2 gate was inverted (enabled set the flag, the shader sampled on !flag), so the	// stock map was never visible; the strength constant replaces the gate entirely and 0	// keeps the familiar look.	if (HDRVignetteParams.x > 0.001)	{		fVignetting = pow(saturate(vignettingTex.Sample(linearClampSS, ScreenTC.xy).r), HDRVignetteParams.x);	}	// Mechanical vignetting: the lens barrel clips the pupil more and more toward the frame	// edges, so less light reaches those pixels - whether or not they are in focus, which is	// why this belongs to the whole picture and not to the depth of field stage. The gather	// only reshapes its kernel and the splat divides this factor back out, so the loss lands	// exactly once, here. Deliberately outside the strength gate above: the residual falloff	// and the mechanical one are two independent lens properties.	{		const float fAspect = PS_ScreenSize.x / max(PS_ScreenSize.y, 1.0);		const float2 vField = (ScreenTC.xy * 2 - 1) * float2(fAspect, 1.0) * rsqrt(fAspect * fAspect + 1.0);		const float fTransmission = LensFieldPupilTransmission(HDRVignetteParams.y * length(vField), HDRVignetteParams.z);		fVignetting *= (half)fTransmission;		// DIAGNOSTIC (r_DepthOfFieldFieldDebug): the transmission itself as a grey ramp, so the		// mechanical falloff can be read off the frame instead of guessed at.		if (HDRVignetteParams.w > 0.5)		{			OUT.Color = half4((half3)fTransmission, 1.0f);			return OUT;		}	}#if %_RT_SAMPLE3	cBloom = bloomTex.Sample(linearClampSS, ScreenTC.xy);#endif	half3 vAdaptedLum = luminanceTex.Load(int3(0, 0, 0));	half3 vSample = hdrTex.Load(int3(IN.WPos.xy, 0));	// Sun shafts, scene-referred composite (SceneReferredSpec.md S2, decisions/s2-sun-shafts.md	// approach A). SAMPLE0 is the scene-referred permutation of this pass; SAMPLE5 still means	// "shafts are present". BEFORE the tone curve, so the shafts are scene radiance like	// everything else and S4's output transform sees them, and ADDITIVE, because the stock	// blend's (1 - oSample) headroom term has no meaning in scene-referred space - there is no	// "1.0 white" to have headroom against. Physically scattering IS additive; the visible	// consequence is that shafts are no longer suppressed over bright regions.	//	// The constant it multiplies by is the sun's own exposed radiance times the shaft amount	// (CToneMappingStage::Execute), not the unit-length hue vector the stock path uses, so the	// shafts follow T-stop, ND and time of day continuously.#if %_RT_SAMPLE0 && %_RT_SAMPLE5	{		half3 cShafts = sunShaftsTex.Sample(linearClampSS, ScreenTC.xy).rgb * SunShafts_SunCol.rgb;		// A second bound, on the composited radiance this time (decisions/s2-sun-shafts.md,		// round-3 addendum). The mask is a visibility in [0,1] now, but the constant it		// multiplies is the SUN's exposed radiance - four to five stops over anything else in		// the frame - times a shaft amount that was authored as a display fraction and has no		// physical calibration behind it. Screen-space shafts are an approximation of single		// scattering; there is no equation here that would stop a mis-set amount from painting		// six stops of white over a third of the picture, and from there through the bloom		// chain over all of it.		//		// The ceiling is the level the camera calls white. The atmosphere near the sun really		// can be brighter than that - but the sensor cannot record it, so letting it through		// buys no picture and costs the whole frame. Off the switch this is 0 and the line is		// unreachable, since the branch is inside the scene-referred permutation anyway.		if (SCENE_METER_CEILING > 0)			cShafts = min(cShafts, (half3)SCENE_METER_CEILING);		vSample += cShafts;	}#endif	half3 cExportTap;	half3 oSample = HDRToneMapSample( IN, vSample, cBloom, vAdaptedLum, fVignetting, cExportTap);	// The graded, pre-ODT, scene-linear value goes out on slot 1 while a graded-mode capture is	// armed. Alpha carries 1 so a reader that keeps four channels gets an opaque frame; the	// writer only takes RGB.#if %_RT_SAMPLE2	OUT.Export = half4(cExportTap, 1.0f);#endif	// Apply merged post processes	// The stock composite, untouched, and now only reachable off the scene-referred permutation.#if !%_RT_SAMPLE0 && %_RT_SAMPLE5	oSample += sunShaftsTex.Sample(linearClampSS, ScreenTC.xy) * SunShafts_SunCol * (1 - oSample); // Blend in ldr sunshafts	#endif#if %_RT_SAMPLE1	TexColorChart2D(colorChartTex, linearClampSS, oSample);#endif	#if %_RT_SAMPLE6	ApplyRandomDithering(oSample, IN.WPos.xy);#endif	OUT.Color = half4(oSample, 1.0f);	return OUT;}pixout HDRFinalSceneDebugPS(vert2frag IN){    half3 oSample;#if %_RT_DEBUG0	half fExposure = 0.00001 * ComputeExposure( luminanceTex.Load(int3(0, 0, 0)).y );	half3 vSample = hdrTex.Load(int3(IN.WPos.xy, 0)) * fExposure;	oSample = (vSample < 0.0031308) ? 12.92 * vSample : 1.055 * pow( vSample, 1.0 / 2.4 ) - float3( 0.055, 0.055, 0.055 );#elif %_RT_DEBUG1	half3 vSample = hdrTex.Load(int3(IN.WPos.xy, 0));	if(any(isnan(vSample)) || any(isinf(vSample)))		oSample = float3(1.0f, 0.0f, 0.0f);	else if(any(vSample<0.0f))		oSample = float3(0.0f, 1.0f, 0.0f);	else 		oSample = float3(0.5f, 0.5f, 0.5f);#endif 	return (pixout)half4(oSample, 1.0f);}pixout HDRFinalSceneFixedExposurePS(vert2frag IN){	half3 vAdaptedLum = float3(1.0f, 1.0f, 1.0f);	half3 vSample = hdrTex.Load(int3(IN.WPos.xy, 0));	half3 oSample;		{		// Compute exposure		const half fExposure = 1.0f;		half3 cColor = fExposure * vSample;#if 0		// Filmic response curve as proposed by J. Hable		half4 c = half4(max(cColor, 0), HDRFilmCurve.w);		const half ShoStren = 0.22 * HDRFilmCurve.x, LinStren = 0.3 * HDRFilmCurve.y, LinAngle = 0.1, ToeStren = 0.2, ToeNum = 0.01 * HDRFilmCurve.z, ToeDenom = 0.3;		half4 compressedCol = ((c * (ShoStren * c + LinAngle*LinStren) + ToeStren*ToeNum) / (c * (ShoStren * c + LinStren) + ToeStren*ToeDenom)) - (ToeNum / ToeDenom);		oSample = saturate(compressedCol / compressedCol.w);#endif		// Apply gamma correction using exact sRGB curve		oSample = (vSample < 0.0031308) ? 12.92h * vSample : 1.055h * pow(vSample, 1.0h / 2.4h) - half3(0.055h, 0.055h, 0.055h);	}	return (pixout)half4(oSample, 1.0f);}//////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////struct fragInShadowFog{	#ifdef D3D10		float4 WPos	:	SV_POSITION;	#else		float4 WPos : VPOS;	#endif	float2 ScreenTC		:	TEXCOORD0;		//TD - remove	//not used  float3 CamVec       : TEXCOORD1;	MSAA_SAMPLE_INDEX_PS};Texture2D fogShadowDepthTex : register(t0) = TS_ZTarget;Texture2D fogShadowInterleaveTex : register(t1) = "%ENGINE%/EngineAssets/Textures/FogVolShadowJitter.dds";Texture2D fogShadowRotTex : register(t2) = "%ENGINE%/EngineAssets/Textures/rotrandom.dds";Texture2D fogCloudShadowTex : register(t3) = TS_CloudShadow;Texture2D fogShadowMap0Tex : register(t4) = TS_Shadow0;Texture2D fogShadowMap1Tex : register(t5) = TS_Shadow2;Texture2D fogShadowMap2Tex : register(t6) = TS_Shadow4;Texture2D fogShadowMap3Tex : register(t7) = TS_Shadow6;Texture3D fogShadowVolCloudTex : register(t8) = TS_VolCloudShadow;SamplerComparisonState fogShadowLinearClampCompSS : register(s0) = SS_Shadow2;SamplerState fogShadowPointWrapSS : register(s1) = SS_PointWrap;SamplerState fogShadowPointClampSS : register(s2) = SS_PointClamp;SamplerState fogShadowBilinearWrapSS : register(s3) = SS_MaterialBilinearWrap;SamplerState fogShadowBilinearClampSS : register(s4) = SS_MaterialTrilinearBorder;float4x4 TexGen0;float4x4 TexGen1;float4x4 TexGen2;float4x4 TexGen3;float4 vInvShadowMapSize;float4 fDepthTestBias; // defines how hard depth test is (default is 100 - hard test)float4 fOneDivFarDist;float4 fKernelRadius;float4 CloudShadowParams;float4 CloudShadowAnimParams;float4 irreg_kernel_2d[HALF_MAX_SHADOW_SAMPLES_NUM];float4 volFogShadowRange;SShadowSamplingParams GetShadowSamplingParams(){    SShadowSamplingParams s;    s.TexGen0 = TexGen0;    s.TexGen1 = TexGen1;    s.TexGen2 = TexGen2;    s.TexGen3 = TexGen3;    s.vInvShadowMapSize = vInvShadowMapSize;    s.fDepthTestBias = fDepthTestBias; // defines how hard depth test is (default is 100 - hard test)    s.fOneDivFarDist = fOneDivFarDist;    s.fKernelRadius = fKernelRadius;    s.CloudShadowParams = CloudShadowParams;    s.CloudShadowAnimParams = CloudShadowAnimParams;    s.irreg_kernel_2d = irreg_kernel_2d;    return s;}float4 CalcHomogeneousPos(float2 WPos, float SceneDepth, float4x4 mScreenToShadow){	float4 vWBasisScale = float4(WPos.x, WPos.y, 1, 1);	vWBasisScale.xyz *= SceneDepth;	float4 HPos = mul(mScreenToShadow, vWBasisScale);  return HPos;}float4 CalcShadowSpace(float4 HPos){  float4 P0 = HPos;	P0.xy /= P0.w;	P0.z -= 0.0000001;//fDepthTestBias.x;   return P0;}bool LinePlaneClip( float4 v0, float4 v1, float4 vPlane, inout float t0,  inout float t1){	float dp0 = dot( v0, vPlane );	float dp1 = dot( v1, vPlane );	bool neg_dp0 = (dp0<0.0f);	bool neg_dp1 = (dp1<0.0f);	if (neg_dp0 && neg_dp1)		return false; // both vertices outside clip plane: discard	if (neg_dp1)	{		float t = dp1 / (dp1 - dp0);		if (t > t1) t1 = t;	}	else if (neg_dp0)	{		float t = dp0 / (dp0 - dp1);		if (t > t0) t0 = t;	}	if (t0 + t1 >= 1.0)		return false; // discard	return true;}bool ClipLine(float4 v0, float4 v1, inout float4 newvert0, inout float4 newvert1, float2 clipMin, float2 clipMax, inout float t0,  inout float t1){	t0 = 0;	t1 = 0;	bool bVisGl = false;	bool bVis = false;	bVis = LinePlaneClip( v0, v1, float4(-1.0,  0,  0, clipMax.x), t0, t1 );	if (!bVis)		return false;	bVis = LinePlaneClip( v0, v1, float4( 1.0,  0,  0, -clipMin.x), t0, t1 );	if (!bVis)		return false;	bVis = LinePlaneClip( v0, v1, float4( 0, -1.0,  0, clipMax.y), t0, t1 ); 	if (!bVis)		return false;	bVis = LinePlaneClip( v0, v1, float4( 0,  1.0,  0, -clipMin.y), t0, t1 );	if (!bVis)		return false;	bVis = LinePlaneClip( v0, v1, float4( 0,  0, -1.0, 1), t0, t1 );	if (!bVis)		return false;	//Z pl	bVis = LinePlaneClip( v0, v1, float4( 0,  0,  1.0, 1), t0, t1 );	if (!bVis)		return false;	newvert0 = lerp(v0, v1, t0);	newvert1 = lerp(v1, v0, t1);	return true;}bool ClipLine(float4 v0, float4 v1, inout float4 newvert0, inout float4 newvert1, inout float t0,  inout float t1 ) //{	t0 = 0;	t1 = 0;	bool bVis = false;	bVis = LinePlaneClip( v0, v1, float4(-1,  0,  0, 1), t0, t1 ); //CLIP_RIGHT_BIT	if (!bVis)		return false;	bVis = LinePlaneClip( v0, v1, float4( 1,  0,  0, 1), t0, t1 ); //CLIP_LEFT_BIT	if (!bVis)		return false;	bVis = LinePlaneClip( v0, v1, float4( 0, -1,  0, 1), t0, t1 ); //CLIP_TOP_BIT	if (!bVis)		return false;	bVis = LinePlaneClip( v0, v1, float4( 0,  1,  0, 1), t0, t1 ); //CLIP_BOTTOM_BIT	if (!bVis)		return false;	bVis = LinePlaneClip( v0, v1, float4( 0,  0, -1, 1), t0, t1 ); //CLIP_FAR_BIT	if (!bVis)		return false;	bVis = LinePlaneClip( v0, v1, float4( 0,  0,  1, 1), t0, t1 ); //CLIP_NEAR_BIT	if (!bVis)		return false;	//interpolation	newvert0 = lerp(v0, v1, t0);	//INTERP_4F( t0, coord[newvert], coord[v0], coord[v1] );	//USE t1 !!!	newvert1 = lerp(v1, v0, t1);	//INTERP_4F( t1, coord[newvert], coord[v1], coord[v0_orig] );	return true;}#define CLIP_OFFSET 0.00001ffloat SingleGSMShadowedFog(Texture2D depthMap, SamplerComparisonState comparisonSampler, float4x4 mTexGen, float2 WPos, inout float StartDepth, float EndDepth, float RayStep){	float2 clipMin = float2(CLIP_OFFSET, CLIP_OFFSET);	float2 clipMax = float2(1.0f-CLIP_OFFSET,1.0f-CLIP_OFFSET);	//TD some temp variables can be shared for CalcHomogeneousPos math	float4 P0 = 0.0f;	float4 P1 = 0.0f;	P0 = CalcHomogeneousPos(WPos.xy, StartDepth, mTexGen);	P0 = CalcShadowSpace(P0);	P1 = CalcHomogeneousPos(WPos.xy, EndDepth, mTexGen);	P1 = CalcShadowSpace(P1);	float4 clP0, clP1;	float t0, t1;	bool bVis = ClipLine(P0, P1, clP0, clP1, clipMin, clipMax, t0, t1);	float StartDepthNew = StartDepth;//lerp(StartDepth, EndDepth, t0); //don't clip start position	float EndDepthFr = lerp(EndDepth, StartDepth, t1);	float curLen = (EndDepthFr - StartDepthNew);	float3 rayDir = (clP1.xyz-P0.xyz); //clP0.xyz //don't clip start position	float fFogShadow = 0.0f;	float SamplNum = 0.0f;	float3 rayDirStep = (RayStep/curLen) * rayDir;	float3 rayCur = P0.xyz;	float curDepth = StartDepthNew;	float fSample = 0;	[loop]	for (; curDepth<=EndDepthFr; curDepth+=RayStep)	{		shadow_sample(depthMap, comparisonSampler, rayCur, fSample);		fFogShadow += fSample;		rayCur += rayDirStep;		SamplNum += 1.0f;	}	float fShadow = 0.0f;	if (bVis)	{		fShadow = fFogShadow;		StartDepth = curDepth;	}	//StartDepth = curDepth;	return fShadow;}float2 MultiGSMShadowedFogPS(fragInShadowFog IN) : SV_Target{    SShadowSamplingParams ss = GetShadowSamplingParams();	//jitter	const float2 oj = fogShadowInterleaveTex.Sample(fogShadowPointWrapSS, IN.WPos.xy / 64.0f).xw;	const float offset = oj.x;	const float jitter = oj.y;	// Todo: bilateral upscale pass. Measure performance vs rendering shadows to multisampled target+sample freq passes	float SceneDepth = fogShadowDepthTex.SampleLevel(fogShadowPointWrapSS, IN.ScreenTC.xy, 0.0f);	SceneDepth = min( SceneDepth, volFogShadowRange.x );	//SceneDepth = min( SceneDepth, 0.3 );	//SceneDepth = max( SceneDepth, 0.000001 );	float StartDepth = 0.0000f;	//for bilateral upcale	const float refDepth = SceneDepth * volFogShadowRange.y;	const int numShadowSamples = 16;	const int numTotalShadowSamples = 8 * 8 * numShadowSamples;	StartDepth = SceneDepth * (((float)0 + offset) / (float)numShadowSamples + jitter / (float)numTotalShadowSamples);	SceneDepth = SceneDepth * (((float)numShadowSamples + offset) / (float)numShadowSamples + jitter / (float)numTotalShadowSamples);	float RayStep = (SceneDepth - StartDepth) / numShadowSamples;	float sampleCount = 0.0;	float fogOccl = 0.0;    float fFogGsm = SingleGSMShadowedFog(fogShadowMap0Tex, fogShadowLinearClampCompSS, ss.TexGen0, IN.WPos.xy, StartDepth, SceneDepth, RayStep); //updates StartDepth	fogOccl += fFogGsm;    const uint nCascadeMask = GetForwardShadowsCascadeMask(ss);	////		second cascade	if(nCascadeMask & FORWARD_SHADOWS_CASCADE_1)	{        fFogGsm = SingleGSMShadowedFog(fogShadowMap1Tex, fogShadowLinearClampCompSS, ss.TexGen1, IN.WPos.xy, StartDepth, SceneDepth, RayStep); //updates StartDepth		fogOccl += fFogGsm;	}	//////		3d cascade	if(nCascadeMask & FORWARD_SHADOWS_CASCADE_2)	{        fFogGsm = SingleGSMShadowedFog(fogShadowMap2Tex, fogShadowLinearClampCompSS, ss.TexGen2, IN.WPos.xy, StartDepth, SceneDepth, RayStep); //updates StartDepth		fogOccl += fFogGsm;	}	//////		4th cascade	if(nCascadeMask & FORWARD_SHADOWS_CASCADE_3)	{        fFogGsm = SingleGSMShadowedFog(fogShadowMap3Tex, fogShadowLinearClampCompSS, ss.TexGen3, IN.WPos.xy, StartDepth, SceneDepth, RayStep); //updates StartDepth		fogOccl += fFogGsm;	}	for (float curDepth = StartDepth; curDepth<=SceneDepth; curDepth+=RayStep)	{		fogOccl += 1.0f;	}	fogOccl /= (numShadowSamples);	return float2(refDepth, fogOccl);	////////////////////////////////////////////////////////////////////////////////} FogPassVolShadowsInterleavePassPS(vert2fragFog IN) : SV_Target{	float2 sampleUV = MapViewportToRaster(IN.baseTC.xy);	const float sceneDepth = min(fogShadowDepthTex.SampleLevel(fogShadowPointWrapSS, sampleUV, 0.0f), volFogShadowRange.x);	const float2 oj = fogShadowInterleaveTex.Sample(fogShadowPointWrapSS, IN.WPos.xy / 64.0f).xw;	const float offset = oj.x;	const float jitter = oj.y;	const int numShadowSamples = 16;	const int numTotalShadowSamples = 8 * 8 * numShadowSamples;#if %_RT_SAMPLE4	const bool bSampleCloudShadows = false;#elif %_RT_SAMPLE5	const bool bSampleCloudShadows = true;#else	const bool bSampleCloudShadows = false;#endif	ShadowCascades cascades;	cascades.shadowMap0 = fogShadowMap0Tex;	cascades.shadowMap1 = fogShadowMap1Tex;	cascades.shadowMap2 = fogShadowMap2Tex;	cascades.shadowMap3 = fogShadowMap3Tex;	cascades.cloudShadowTex = fogCloudShadowTex;	ShadowSamplingContext shadowContext;	shadowContext.comparisonSampler = fogShadowLinearClampCompSS;	shadowContext.pointSamplerWrap = fogShadowPointWrapSS;	shadowContext.pointSamplerClamp = fogShadowPointClampSS;	shadowContext.bilinearSamplerWrap = fogShadowBilinearWrapSS;	shadowContext.noiseTex = fogShadowRotTex;		const float3 cameraToWorldPos = ReconstructWorldPos(IN.WPos.xy, sceneDepth, true);	half shadowOccl = 0;	for (int i=0; i<numShadowSamples; i++)	{		const float ratio = (((float)i + offset) / (float)numShadowSamples + jitter / (float)numTotalShadowSamples);		const float4 worldPos = float4(ratio * cameraToWorldPos.xyz + vfViewPos.xyz, 1);        float shadowSample = ShadowDepthTest(GetShadowSamplingParams(), cascades, shadowContext, worldPos, bSampleCloudShadows, true).r;#if %_RT_SAMPLE4		shadowSample = min(shadowSample, GetVolumetricCloudShadow(fogShadowVolCloudTex, fogShadowBilinearClampSS, worldPos.xyz, CV_SunLightDir.xyz, CloudShadowParams, CloudShadowAnimParams));#endif		shadowOccl += shadowSample;	}	const float refDepth = sceneDepth * volFogShadowRange.y;	shadowOccl /= (float)numShadowSamples;	return float2(refDepth, shadowOccl);}float4 volFogShadowBufSampleOffsets[8];float VolFogShadowBilateralFilter(in Texture2D<float2> tex, in SamplerState pointClampSS, in const int numSamples, in const float2 baseTC, in const float refDepth, in const float similarity){	float accumVal = 0.0;	float accumWeight = 0.0;	for(int i=0; i<numSamples; i++)	{		const float2 coord = baseTC.xy + volFogShadowBufSampleOffsets[i].xy;		const float2 sampleXYZW = tex.Sample(pointClampSS, coord).xy;		const float sampleVal = sampleXYZW.y;		const float sampleDepth = sampleXYZW.x;		const float s = exp2(abs(sampleDepth - refDepth) * -similarity);		accumVal += sampleVal * s;		accumWeight += s;	}	return accumVal / accumWeight;}Texture2D<float2> volFogShadowGatherTex : register(t0);SamplerState volFogPointSamplerState : register(s0);float2 FogPassVolShadowsGatherPassPS(vert2fragFog IN) : SV_Target{	float2 sampleUV = MapViewportToRaster(IN.baseTC.xy);	const float refDepth = volFogShadowGatherTex.Sample(volFogPointSamplerState, sampleUV + volFogShadowBufSampleOffsets[4].xy).x;	const float value = VolFogShadowBilateralFilter(volFogShadowGatherTex, volFogPointSamplerState, 8, sampleUV, refDepth, 50.0);	return float2(refDepth, value);}Texture2D<float2> volFogShadowTex : register(t1);float4 volFogShadowDarkening;float4 volFogShadowDarkeningSunAmb;void FogPassCommon(	in vert2fragFog IN,	in float4 WPos,	out float sceneDepth,	out float4 localFogColor,	out float3 worldPos,	out float3 cameraToWorldPos){	float2 sampleUV = MapViewportToRaster(IN.baseTC.xy);	#if %_RT_MSAA_QUALITY || %_RT_MSAA_QUALITY1 			uint uSample = 0;		#if %_RT_MSAA_SAMPLEFREQ_PASS			uSample = IN.uSample;		#endif		sceneDepth = GetLinearDepth(GetZTargetMS(sampleUV, GetMSAASampleNum(), uSample).x);	#else		sceneDepth = GetLinearDepth(zMap, sampleUV);	#endif	cameraToWorldPos = ReconstructWorldPos(WPos.xy, sceneDepth, true);	worldPos = cameraToWorldPos + vfViewPos.xyz;#if %_RT_SAMPLE0	const float refDepth = min(sceneDepth, volFogShadowRange.x) * volFogShadowRange.y;	const float volFogShadowContrib = VolFogShadowBilateralFilter(volFogShadowTex, volFogPointSamplerState, 5, sampleUV, refDepth, 100.0);	const float2 volFogShadowContribSunAmb = saturate(volFogShadowContrib * volFogShadowDarkeningSunAmb.xz + volFogShadowDarkeningSunAmb.yw);	localFogColor = GetVolumetricFogColor(worldPos, cameraToWorldPos, volFogShadowContribSunAmb.x, volFogShadowContribSunAmb.y);	localFogColor.rgb = lerp(localFogColor.rgb * volFogShadowDarkening.x, localFogColor.rgb, volFogShadowContrib);#else	localFogColor = GetVolumetricFogColor(worldPos, cameraToWorldPos);#endif}float4 SVO_AirTextureScale;Texture2D FOG_smp_Air_RGBA_Min    : register(t12);Texture2D FOG_smp_Air_Depths      : register(t13);Texture2D FOG_smp_Air_RGBA_Max    : register(t14);SamplerState FOG_SStatePC         : register(s0);pixout GetSvoGiFog(vert2fragFog IN, pixout OUT){	// Blend in SVO atmospheric effects (with upscale)	int nRange = 1;	float fDepthRange = 0.2f;	float fDepth0 = GetLinearDepth( zMap, IN.baseTC.xy );	float2 vSrcPixSize = 1.f/PS_ScreenSize.xy*SVO_AirTextureScale.xy;	float4 vAir = 0;	float fSumm = 0;	for(int x=-nRange; x<=nRange; x+=1) for(int y=-nRange; y<=nRange; y+=1)	{		float fLen = max(0, 1 + nRange - sqrt(x*x+y*y));		float2 tc1 = IN.baseTC.xy + float2(x,y)*vSrcPixSize;		{			float fDepth1 = GetTexture2D(FOG_smp_Air_Depths, FOG_SStatePC, tc1).r;			float fW = fLen*( abs(1.f-fDepth1/fDepth0) < fDepthRange ) + 0.001f;				vAir += GetTexture2D(FOG_smp_Air_RGBA_Min, FOG_SStatePC, tc1)*fW;			fSumm += fW;		}		{			float fDepth1 = GetTexture2D(FOG_smp_Air_Depths, FOG_SStatePC, tc1).g;			float fW = fLen*( abs(1.f-fDepth1/fDepth0) < fDepthRange ) + 0.001f;				vAir += GetTexture2D(FOG_smp_Air_RGBA_Max, FOG_SStatePC, tc1)*fW;			fSumm += fW;		}	}	vAir /= fSumm;	OUT.Color = vAir * vAir.a;	OUT.Color.a = vAir.a;	// S8, decisions/s8-svogi-fog-clouds.md item 1 A2: the SVO's SECOND output. The voxel data is	// in stock, unexposed units (see ApplyGI in TiledShading.cfi) so the atmosphere it writes	// into the HDR target needs the same pre-exposure the cone-trace result gets at ApplyGI.	// Colour only - .a is a transmittance. Exactly 1.0 off the switch.	OUT.Color.rgb *= PS_HDR_RANGE_ADAPT_MAX;	OUT.Color.a = saturate(1.0f - OUT.Color.a);	return OUT;}Texture3D<float4> volFogSamplingTex : register(t1) = TS_VolumetricFog;TextureCube<float4> volFogGlobalEnvProbeTex0 : register(t2) = TS_VolumetricFogGlobalEnvProbe0;TextureCube<float4> volFogGlobalEnvProbeTex1 : register(t3) = TS_VolumetricFogGlobalEnvProbe1;SamplerState volFogTrilinearClampSState : register(s0) = SS_TrilinearClamp;float4 GetVolumetricFog(in vert2fragFog IN, in float4 WPos){	float sceneDepth;	#if %_RT_MSAA_QUALITY || %_RT_MSAA_QUALITY1 			uint uSample = 0;		#if %_RT_MSAA_SAMPLEFREQ_PASS			uSample = IN.uSample;		#endif		sceneDepth = GetLinearDepth(GetZTargetMS(IN.baseTC.xy, GetMSAASampleNum(), uSample).x);	#else		sceneDepth = GetLinearDepth(zMap, IN.baseTC.xy);	#endif	float linearDepth = sceneDepth * PS_NearFarClipDist.y;	float3 cameraToWorldPos = ReconstructWorldPos(WPos.xy, sceneDepth, true);	VolumetricFogSampling vfs;	vfs.volumetricFogTex = volFogSamplingTex;	vfs.globalEnvProbeTex0 = volFogGlobalEnvProbeTex0;	vfs.globalEnvProbeTex1 = volFogGlobalEnvProbeTex1;	vfs.trilinearClampSState = volFogTrilinearClampSState;	// blend volumetric fog with global fog.	float len = length(cameraToWorldPos);	VolumetricFogTexcoord vtc = GetVolumetricFogTexcoordParamByScreenTexcoordAndDepth(IN.baseTC.xy, linearDepth, false, len);	float4 vf = GetVolumetricFogValueJittered(vfs, vtc);	float4 localFogColor = GetVolumetricFogAnalyticalColor(vfs, cameraToWorldPos, len);	localFogColor = BlendVolumetricFogWithGlobalFog(vf, localFogColor, vtc);	localFogColor = ClampFinalFogDensity(localFogColor);	return localFogColor;}pixout FogPassPS(vert2fragFog IN){	pixout OUT;#if FEATURE_SVO_GI#if %_RT_SAMPLE2	return GetSvoGiFog(IN, OUT);#endif#endif#if %_RT_DEBUG0 && %_RT_DEBUG1 && %_RT_DEBUG2 && %_RT_DEBUG3    OUT.Color = NumInstructions;    return OUT;#endif	float4 localFogColor;#if %_RT_VOLUMETRIC_FOG	localFogColor = GetVolumetricFog(IN, IN.WPos);	localFogColor.a = saturate(localFogColor.a);#else	float sceneDepth;	float3 worldPos, cameraToWorldPos;	FogPassCommon(IN, IN.WPos, sceneDepth, localFogColor, worldPos, cameraToWorldPos);	localFogColor.a = saturate(1.0 - localFogColor.a);	// Premultiply alpha	localFogColor.xyz *= localFogColor.a;	localFogColor.a = saturate(1.0 - localFogColor.a);#endif	HDROutput(OUT, localFogColor, 1);	return OUT;}float4 LightningPos;float4 LightningColSize;pixout FogPassWithLightningPS(vert2fragFog IN){  pixout OUT;#if %_RT_DEBUG0 && %_RT_DEBUG1 && %_RT_DEBUG2 && %_RT_DEBUG3    OUT.Color = NumInstructions;    return OUT;#endif	half sceneDepth;	half3 cameraToWorldPos;	sceneDepth = GetLinearDepth(zMap, IN.baseTC.xy);	cameraToWorldPos = ReconstructWorldPos(IN.WPos.xy, sceneDepth, true);	/////////////////////////////////////////////////////////////	// lightning computation... 	float atten = LightningColSize.w;		float3 c = atten * ( LightningPos.xyz - vfViewPos.xyz );	float3 d = atten * cameraToWorldPos;	float u = dot( c, c ) + 1;	float v = -2 * dot( c, d );	float w =  dot( d, d );	float div = rsqrt( 4 * u * w - v * v );		//float lightning = sqrt( w ) * 2 * ( atan( ( v + 2 * w ) * div ) - atan( v * div ) ) * div; 	float2 atan_res = atan( float2( v + 2 * w, v ) * div );	float lightning = sqrt( w ) * 2 * ( atan_res.x - atan_res.y ) * div;   /////////////////////////////////////////////////////////////  OUT.Color = half4(LightningColSize.xyz * lightning, 1);  return OUT;}////////////////////////////////////////////////////////////////////////////////////////////////////// Rec.709 -> ACEScg, the entry to the scene-referred working space (SceneReferredSpec.md D5,// Stage S3; scene-notes/decisions/s3-working-space.md approach 1A).//// One 3x3 per texel, in place on $HDRTarget's UAV, dispatched from// CStandardGraphicsPipeline::ExecuteHDRPostProcessing() between the $HDRTargetPrev copy and the// depth-of-field stage. That is the only window in the frame where every writer of Rec.709 scene// colour has finished (deferred, forward opaque, sky, water, fog, clouds, transparents, particles,// snow displacement and rain) and nothing has read the target for post yet.//// In place is race-free because each thread reads and writes ONLY its own texel: no scratch// target, no copy-back, no pipeline pointer to swap. It costs one read plus one write of the// full-resolution fp16 target, about 0.08 ms at 1080p and 0.33 ms at 4K.//// The matrix is linear, so everything that BLENDED into the target before this point is// unaffected by the move (additive and alpha blending both commute with a 3x3). Multiplicative// and min/max blends do NOT commute, and they are reachable from material shader scripts - which// is the second reason the conversion sits after all scene blending rather than at the writers.//// $HDRTargetPrev deliberately stays Rec.709: it is filled by the copy immediately before this// dispatch and consumed NEXT frame inside the 709 lighting pass by screen-space reflections,// water reflection and the SVOGI bounce. See the comment at the copy site.RWTexture2D<float4> SceneReferredTargetUAV : register(u0);// .xy = target size in texels (the dispatch is padded up to the group size)// .z  = r_SceneReferredDebug: 2 paints the texels this pass could not produce// .w  = the writer ceiling (r_SceneReferredWriterClamp) enforced on the whole target here.//       0 = no guard, which is what the stock path never reaches anyway.float4 SceneReferredParams;#define SCENE_REFERRED_CONVERT_TILE 8// Debug marker brightness. Far above anything the tone map or the ODT will resolve, so a marked// texel is unmistakably a flat primary and cannot be confused with scene content.#define SCENE_REFERRED_DEBUG_MARK 64.0[numthreads(SCENE_REFERRED_CONVERT_TILE, SCENE_REFERRED_CONVERT_TILE, 1)]void SceneReferredConvertCS(uint3 DispatchThreadID : SV_DispatchThreadID){	const int2 vPixCoord = int2(DispatchThreadID.xy);	if (any(vPixCoord >= (int2)SceneReferredParams.xy))		return;	const float4 cSrc = SceneReferredTargetUAV[vPixCoord];	float3 cDst = Rec709ToACEScg(cSrc.rgb);	// r_SceneReferredDebug 2. Rec.709's primaries lie INSIDE AP1, so the forward matrix is	// entirely non-negative and a non-negative 709 frame cannot come out of it negative. A	// marked texel therefore means one of two things and neither is a property of the transform:	// either the frame already carried a NaN/Inf (red) or a negative channel (green) before the	// conversion, or the matrix is not being applied to what we think it is. This is the S3	// acceptance instrument taken at the conversion point itself; r_HDRDebug 3 is the same test	// at the END of the chain, where depth of field, the glare family and motion blur have all	// had their turn.	if (SceneReferredParams.z > 1.5)	{		if (any(isnan(cDst)) || any(isinf(cDst)))			cDst = float3(SCENE_REFERRED_DEBUG_MARK, 0.0, 0.0);		else if (any(cDst < 0.0))			cDst = float3(0.0, SCENE_REFERRED_DEBUG_MARK, 0.0);	}	else if (SceneReferredParams.w > 0.0)	{		// The one gate every scene writer has to pass (decisions/s8-fp16-writers.md). Each		// writer is clamped where it is, but a writer we have not found - or a blend of several		// that individually behaved - can still leave a non-finite texel here, and this pass is		// the last point at which the whole target is walked before anything AVERAGES it. One		// Inf inside a bloom downsample block, a glare threshold pass or the exposure meter's		// log mean takes the whole block, the whole frame or the whole exposure loop with it,		// which is the round-2 runaway all over again.		//		// NaN reads as black: it carries no information and the alternatives all spread it.		// Inf and anything over the ceiling read as the ceiling: they DO carry information -		// "brighter than this buffer can say" - and the sensor clip in the tone map is three		// and a half stops below it, so nothing visible is lost.		//		// Deliberately in the else of the debug branch: r_SceneReferredDebug 2 exists to SHOW		// the texels that arrive broken, and a guard that silently repaired them first would		// make the instrument lie.		cDst = any(isnan(cDst)) ? (float3)0.0 : min(cDst, (float3)SceneReferredParams.w);	}	SceneReferredTargetUAV[vPixCoord] = float4(cDst, cSrc.a);}technique SceneReferredConvert{  pass p0  {    ComputeShader = SceneReferredConvertCS();  }}////////////////////////////////////////////////////////////////////////////////////////////////////// The camera's metering histogram (SceneReferredSpec.md D2/D7, decisions/s8-metering.md approach A).//// A 64-bin log2 LUMINANCE histogram of the quarter-res exposed HDR source - the same texture the// stock measure pass reads - accumulated with a metering weight and read back per frame. The// camera then takes the log-mean of a percentile band of it instead of the log-mean of the whole// frame, which is the one statistic that is robust to "one large region owns the average".//// WHAT IS METERED, AND THE SEMANTIC CHANGE THAT COMES WITH IT.//// The stock measure pass does not meter luminance. It divides the G-buffer albedo out and// multiplies by PI to estimate the ILLUMINANCE falling on each surface, which makes it an// incident meter - and for pixels with no G-buffer albedo (sky, emissive, every forward-rendered// pixel) it FABRICATES an albedo of 0.2. That fabrication is calibrated for midday sun and// over-reads by 1.6 to 3.2 stops in low sun, overcast and open shade, weighted by the sky's share// of the frame, which outdoors is most of it: on an airfield frame it put 74 700 lux on mid grey// when the subject was lit by 100 000 and collapsed the whole picture into a 2.5-stop band below// mid grey (research/s8-metering.md section 2.3).//// This pass meters LUMINANCE. There is no albedo, no PI and no fabricated 0.2, so the sky and// emissive fallback no longer exists and NO LONGER MATTERS. The meter now behaves like a real// camera's REFLECTED meter: it measures the light coming back off the scene. What keeps the// calibration is the target, not the quantity - the camera places the band's log-mean on 0.18, and// by spec D6 a correctly exposed 18 % card under the light lands on exactly 0.18. So an 18 % card// filling the frame makes the two meters agree exactly, and the incident-form constant C = 120*PI// of decisions/s1-exposure-constant.md still holds, because "put the metered value on 0.18 in// exposed units" IS that constant written the other way round (the algebra is spelled out in// CCinematicCameraComponent::ComputeSceneReferredEV100). What we do NOT inherit is a real body's// K = 12.5 calibration, which corresponds to about 12-13 % reflectance and is the origin of the// well-known third-of-a-stop grey-card discrepancy; ours is anchored on 18 % because the// pre-exposure guarantees 18 %.//// THE BIN MAPPING. Bin i covers////     log2(L_exposed / 0.18)  in  [ -14 + i*0.5 , -14 + (i+1)*0.5 )//// i.e. 64 bins of half a stop each, from 14 stops BELOW mid grey to 18 stops ABOVE it. Bins 0 and// 63 are saturating buckets. The window is relative to mid grey rather than absolute, which is// only possible because the pre-exposure anchors 0.18 (spec D6): it is therefore permanently// centred on the interesting part of the scene at every time of day and with every lens and needs// no per-scene tuning - the one thing UE's absolute HistogramLogMin/Max cannot do, and the reason// Epic had to ship an "Extend default luminance range" project setting when they went physical.// The upper edge sits above the writer clamp's 17.5 stops on purpose, so a texel that hit the// clamp still has a bin to land in; the lower edge is 14 stops down, which covers a scene's own// range plus the tracking error during a seven-stop indoor-to-outdoor transition.//// WEIGHT QUANTISATION. Weights are accumulated as uint(w * 256), so a full-weight texel counts 256// and the CPU never has to divide - it works in those integer units throughout and only ever forms// ratios. At quarter res (480x270 at 1080p) the worst case is 129 600 * 256 = 33 million, far// inside uint32.//// COST. One texel per thread, 8x8 groups, 64 groupshared bins per group and one global atomic per// bin per group: 2 025 groups x 64 = 129 600 global atomics at 1080p, 0.02-0.05 ms. An order of// magnitude under the bloom that runs on the same texture one pass later.Texture2D<float4>  MeterHistSource : register(t0);RWTexture2D<uint>  MeterHistogram  : register(u0);// .x/.y = source size in texels (the dispatch is padded up to the group size)// .z    = metering mode: 0 Average, 1 CenterWeighted, 2 Spot// .w    = unusedfloat4 MeterHistParams;// .xyz = the luminance weights of the space the HDR target is in this frame (Rec.709 before the//        working-space conversion, AP1 after it). Passed explicitly rather than read through//        GetWorkingLuminance(), because that lives in the per-view constant buffer and a compute//        pass in this renderer has no established binding for it.float4 MeterHistWeights;#define SCENE_METER_HIST_TILE     8#define SCENE_METER_HIST_BINS     64#define SCENE_METER_HIST_LOG_MIN  (-14.0)#define SCENE_METER_HIST_LOG_MAX  ( 18.0)#define SCENE_METER_HIST_WEIGHT_Q 256.0groupshared uint g_MeterHistBins[SCENE_METER_HIST_BINS];// The metering mask. A real body offers exactly this family of choices and has since the 1980s;// the sizes are the ones the camera industry settled on.////   Average        - the whole frame, uniformly. The A/B reference against the shipped log-mean.//   CenterWeighted - a smooth radial falloff, full sensitivity at the centre and a quarter of it//                    in the corners. The classic, cheap and predictable answer to "the sky is half//                    the frame and it is not the subject". Default.//   Spot           - a disc 20 % of frame height across (about 1.8 % of frame area, inside the//                    camera-standard 1.5-3 %), soft-edged. Put it on a grey card and the card is//                    mid grey, whatever else is in the picture.//// The falloff is smooth rather than a hard circle on purpose: a hard edge makes the meter step as// content crosses it, and a step in the metering weight is a step in the exposure.float MeteringWeight(float2 uv, float2 size, float mode){	if (mode < 0.5)		return 1.0;	// Frame-shaped coordinates, so a circle stays a circle on a wide frame instead of becoming an	// ellipse.	const float aspect = size.x / max(size.y, 1.0);	const float2 d = (uv - 0.5) * float2(aspect, 1.0);	if (mode < 1.5)	{		// Normalised so r = 1 at the corner. The normalisation only sets how fast the falloff		// runs; this one gives the classic 100 % centre / 25 % corner split.		const float r = saturate(length(d) / (0.5 * sqrt(aspect * aspect + 1.0)));		return lerp(1.0, 0.25, smoothstep(0.0, 1.0, r));	}	const float spotRadius = 0.10;  // 20 % of frame height across	return 1.0 - smoothstep(spotRadius * 0.9, spotRadius * 1.1, length(d));}[numthreads(SCENE_METER_HIST_TILE, SCENE_METER_HIST_TILE, 1)]void SceneReferredMeterHistogramCS(uint3 DispatchThreadID : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex){	if (GroupIndex < SCENE_METER_HIST_BINS)		g_MeterHistBins[GroupIndex] = 0;	GroupMemoryBarrierWithGroupSync();	const int2 vPixCoord = int2(DispatchThreadID.xy);	const int2 vSize = (int2)MeterHistParams.xy;	if (all(vPixCoord < vSize))	{		const float3 cSrc = MeterHistSource[vPixCoord].rgb;		// A NaN carries no information and is dropped - no bin and no weight, so it cannot move		// the percentiles in either direction. An Inf DOES carry information, "brighter than this		// buffer can say", so it goes in the top bin: it gets a POSITION and no magnitude, which		// is the whole reason a histogram is immune to the runaway a log mean was not		// (research/s8-auto-exposure-runaway.md). The band then discards it as an outlier instead		// of being dragged by it, which is also why this pass needs no meter ceiling of its own.		if (!any(isnan(cSrc)))		{			const float fLum = max(dot(max(cSrc, 0.0), MeterHistWeights.xyz), 0.0);			const float fLogL = isfinite(fLum)			                    ? log2(max(fLum, 1e-8) / SCENE_MID_GREY)			                    : SCENE_METER_HIST_LOG_MAX;			const float fBinScale = SCENE_METER_HIST_BINS / (SCENE_METER_HIST_LOG_MAX - SCENE_METER_HIST_LOG_MIN);			const uint nBin = (uint)clamp(floor((fLogL - SCENE_METER_HIST_LOG_MIN) * fBinScale),			                              0.0, SCENE_METER_HIST_BINS - 1.0);			const float2 uv = (float2(vPixCoord) + 0.5) / float2(vSize);			const uint nWeight = (uint)(saturate(MeteringWeight(uv, float2(vSize), MeterHistParams.z))			                            * SCENE_METER_HIST_WEIGHT_Q + 0.5);			if (nWeight > 0)				InterlockedAdd(g_MeterHistBins[nBin], nWeight);		}	}	GroupMemoryBarrierWithGroupSync();	// One global atomic per bin per group instead of one per texel: 64 x 2 025 rather than	// 129 600 contended adds on 64 addresses.	if (GroupIndex < SCENE_METER_HIST_BINS)	{		const uint nLocal = g_MeterHistBins[GroupIndex];		if (nLocal > 0)			InterlockedAdd(MeterHistogram[int2(GroupIndex, 0)], nLocal);	}}technique SceneReferredMeterHistogram{  pass p0  {    ComputeShader = SceneReferredMeterHistogramCS();  }}//=======================================================// HDR post-processing techniquestechnique HDRSampleLumInitial{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = HDRSampleLumInitialPS() HDRPostProcessPS;  }}technique HDRSampleLumIterative{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = HDRSampleLumIterativePS() HDRPostProcessPS;  }}technique HDRCalculateAdaptedLum{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = HDRCalculateAdaptedLumPS() HDRPostProcessPS;  }}technique HDRBloomGaussian{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = HDRBloomGaussianPS() HDRPostProcessPS;  }}technique HDRStreakThreshold{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = HDRStreakThresholdPS() HDRPostProcessPS;  }}technique HDRStreakStretch{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = HDRStreakStretchPS() HDRPostProcessPS;  }}technique HDRFilterPSF{  pass p0  {    VertexShader = FilterPSFVS() HDRPostProcessVS;    PixelShader = FilterPSFPS() HDRPostProcessPS;    CullMode = None;  }}technique HDRDiffractionSourceBlur{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = HDRDiffractionSourceBlurPS() HDRPostProcessPS;    CullMode = None;  }}technique HDRDiffractionSourceStats{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = HDRDiffractionSourceStatsPS() HDRPostProcessPS;    CullMode = None;  }}technique HDRDiffractionStatsReduce{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = HDRDiffractionStatsReducePS() HDRPostProcessPS;    CullMode = None;  }}technique HDRDiffractionBudget{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = HDRDiffractionBudgetPS() HDRPostProcessPS;    CullMode = None;  }}technique HDRDiffractionComposite{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = DiffractionCompositePS() HDRPostProcessPS;    CullMode = None;  }}technique HDRDiffractionPSF{  pass p0  {    VertexShader = DiffractionPSFVS() HDRPostProcessVS;    PixelShader = DiffractionPSFPS() HDRPostProcessPS;    CullMode = None;  }}technique HDRDiffractionDebug{  pass p0  {    VertexShader = FullscreenTriVS() HDRPostProcessVS;    PixelShader = DiffractionDebugPS() HDRPostProcessPS;  }}technique HDRFinalPass{  pass p0  {    VertexShader = TransformedVS() HDRPostProcessVS;    PixelShader = HDRFinalScenePS() HDRPostProcessPS;  }}technique HDRFinalDebugPass{  pass p0  {		VertexShader = TransformedVS() HDRPostProcessVS;		PixelShader = HDRFinalSceneDebugPS() HDRPostProcessPS;  }}technique HDRFinalPassFixedExposure{  pass p0  {    VertexShader = TransformedVS() HDRPostProcessVS;    PixelShader = HDRFinalSceneFixedExposurePS() HDRPostProcessPS;  }}//======================================================================technique MultiGSMShadowedFog{  pass p0  {    VertexShader = PreTransformedFogVS() FogPostProcessVS;    GeometryShader = $AutoGS_MultiRes();    PixelShader = MultiGSMShadowedFogPS() FogPassVolShadowsInterleavePassPS;  }}technique FogPass{  pass p0  {    VertexShader = PreTransformedFogVS() FogPostProcessVS;    GeometryShader = $AutoGS_MultiRes();    PixelShader = FogPassPS() FogPostProcessPS;  }}technique FogPassWithLightning{  pass p0  {        VertexShader = PreTransformedFogVS() FogPostProcessVS;    GeometryShader = $AutoGS_MultiRes();    PixelShader = FogPassWithLightningPS() FogPostProcessPS;  }}technique FogPassVolShadowsInterleavePass{  pass p0  {    VertexShader = PreTransformedFogVS() FogPostProcessVS;    GeometryShader = $AutoGS_MultiRes();    PixelShader = FogPassVolShadowsInterleavePassPS() FogPassVolShadowsInterleavePassPS;  }}technique FogPassVolShadowsGatherPass{  pass p0  {    VertexShader = PreTransformedFogVS() FogPostProcessVS;    GeometryShader = $AutoGS_MultiRes();    PixelShader = FogPassVolShadowsGatherPassPS() FogPassVolShadowsGatherPass;  }}