// Copyright 2007-2021 Crytek GmbH / Crytek Group. All rights reserved. #define MAX_BONES 768 #define MAX_NUM_BONES_PER_GROUP 250 #define MAX_NUM_BONES_PER_GROUP_WITH_MB 125//============================================================================//=== Uniform parameters =====================================================// Parameter semantic prefixes:// PF - Per-Frame// PB - Per-Batch// PI - Per-Instance// PM - Per-Material// Per-Material Constant Buffer - Fixed constants#define REG_PM_DIFFUSE_COL          c28#define REG_PM_SPECULAR_COL         c29#define REG_PM_EMISSIVE_COL         c30#define REG_PM_TCM_MATRIX           c31#define REG_PM_DEFORM_WAVE          c35#define REG_PM_DETAIL_TILING        c36#define REG_PM_SILPOM_DETAIL_PARAMS c37// Per-Material Constant Buffer - Tweakables in cfi files#define REG_PM_PARAM_INCL_0  c38#define REG_PM_PARAM_INCL_1  c39#define REG_PM_PARAM_INCL_2  c40#define REG_PM_PARAM_INCL_3  c41// Per-Material Constant Buffer - Tweakables in cfx files#define REG_PM_PARAM_0  c42#define REG_PM_PARAM_1  c43#define REG_PM_PARAM_2  c44#define REG_PM_PARAM_3  c45#define REG_PM_PARAM_4  c46#define REG_PM_PARAM_5  c47#define REG_PM_PARAM_6  c48#define REG_PM_PARAM_7  c49float4   MatDifColor                 : PM_MatDiffuseColor             < register = REG_PM_DIFFUSE_COL; >;float4   MatSpecColor                : PM_MatSpecularColor            < register = REG_PM_SPECULAR_COL; >;float4   MatEmissiveColor            : PM_MatEmissiveColor            < register = REG_PM_EMISSIVE_COL; >;float4x4 CM_MatrixTCM                : PM_MatMatrixTCM                < register = REG_PM_TCM_MATRIX; >;float4   CM_DeformWave               : PM_MatDeformWave               < register = REG_PM_DEFORM_WAVE; >;float4   CM_DetailTilingAndAlphaRef  : PM_MatDetailTilingAndAlphaRef  < register = REG_PM_DETAIL_TILING; >;float4   CM_SilPomDetailParams       : PM_MatSilPomDetailParams       < register = REG_PM_SILPOM_DETAIL_PARAMS; >;/*// TODO: Use explicit CB once shader parser got adjustedcbuffer PerMaterialConstants : register(){	float4   CM_Tweakables[12];	float4   MatDifColor;   // TODO: Adjust name	float4   MatSpecColor;  // TODO: Adjust name	float4x4 CM_MatrixTCM;	float4   CM_DeformWave;	float4   CM_DetailTilingAndAlphaRef;}*/// Vertex shader parameters range:// c0-c3, c7-c28 = PB, PI// c8-c15  = PM (tweakables)// c29-c34 = PF// c40-c255 = Skinning, Instancing, etc#define VS_REG_PB_0 c0#define VS_REG_PB_1 c1#define VS_REG_PB_2 c2#define VS_REG_PB_3 c3#define VS_REG_PB_4 c4#define VS_REG_PB_5 c5#define VS_REG_PB_6 c6#define VS_REG_PB_7 c7#define VS_REG_PB_8 c8#define VS_REG_PB_9 c9#define VS_REG_PB_10 c10//=============================================================================// Pixel shader parameters range:// c12-c38 = PM (channel's scale & bias)// c39-c51 = PM (Light material)// c52-c61 = PM (tweakables), PI, PB// c62-67 = PF#define PS_REG_PB_0 c0#define PS_REG_PB_1 c1#define PS_REG_PB_2 c2#define PS_REG_PB_3 c3#define PS_REG_PB_4 c4#define PS_REG_PB_5 c5#define PS_REG_PB_6 c6#define PS_REG_PB_7 c7#define PS_REG_PB_8 c8#define PS_REG_PB_9 c9//=============================================================================//=== Global constants ========================================================// Emissive materials are authored in kcd/m^2 while engine units are 1.0 = 10 000 cd/m^2. One// definition, because the same literal used to sit in Illum.cfx, MultiLayeredMaterials.cfx and// (as its reciprocal power) in ShaderResources.h, free to drift apart at the first edit.#define MAT_EMISSIVE_UNIT_SCALE (1000.0 / 10000.0)// The scene-referred pre-exposure, as seen by the forward and transparent passes// (SceneReferredSpec.md D3, decisions/s1-writer-coverage.md approach A). This used to be the// literal 1.0 - a leftover of the CE 3.x L-buffer range-adaptation round trip that nothing ever// set - and it is now the lever every writer that bypasses the deferred light lists multiplies by.//// It is written as 1 + (exposure - 1) rather than as the exposure itself, and that is deliberate:// CV_SceneExposure.x holds exposure MINUS ONE, so a shader that runs with the per-view constant// buffer unbound - or with the scene-referred path off, where the camera publishes unity - reads// exactly 1.0 and multiplies by exactly 1.0. Off the switch the picture is therefore bit-identical// (x * 1.0f is exact in IEEE); only the instruction that was folded away at compile time comes// back. The 16 multiply sites keep their text unchanged.#define PS_HDR_RANGE_ADAPT_MAX (1.0 + CV_SceneExposure.x)// The five sites that read scene colour BACK out of the HDR or reflection targets used to divide// the same factor out again, which is the round-trip semantics of the old console scheme and// exactly wrong for a pre-exposure: the value read is already exposed and must not be un-exposed.// Off the switch the factor was 1.0 anyway, so this is 1.0 in both cases and the divide keeps// folding away at compile time exactly as it does today.#define PS_HDR_RANGE_ADAPT_MAX_SCENE_READ 1.0// The 1/PI that CRYENGINE omits from BOTH of its lobes - the Burley diffuse (which is defined as// albedo/PI * scatterL * scatterV) and the GGX NDF (alpha^2 / (PI * denom^2)) - and compensates// for by pre-dividing the sun on the light side instead. The scene-referred path makes every// light radiometric and puts the 1/PI back where the physics has it (SceneReferredSpec.md D4,// decisions/s2-pi-unification.md approach A), which is a pure algebraic shuffle for the sun and// closes the 1.65-stop gap for every local light.//// Same offset-by-one trick as the exposure above and for the same two reasons: an unbound// per-view constant buffer reads 0 and therefore multiplies by exactly 1.0 instead of darkening// the surface to nothing, and off the switch the multiply is by an exact 1.0, which is// bit-identical in IEEE. Zero extra ALU: both consumers already multiply by a value there.//// NOT for ambient lights (they are multiplicative tints, not radiance), NOT for environment// probes (a cosine-weighted cubemap is already E/PI and never enters a BRDF) and NOT for// emissive materials (radiance by definition). Those three are guarded where they are, in// TiledLightVolumes.cpp and TiledShading.cfi, and none of them call DiffuseBRDF/SpecularBRDF.#define SCENE_BRDF_NORM_FACTOR (1.0 + CV_SceneExposure.z)// "Are we on the scene-referred light-unit convention?" as a boolean, from the same slot. .z is// stored minus one, so it is an EXACT 0.0 on the stock path and 1/PI - 1 = -0.6817 on the// scene-referred one; a comparison against zero is therefore exact and folds away with the// constant. Needed where a site wants something other than "multiply by the BRDF factor" - the// area lights' per-shape normalisation is not a scaling of 1/PI, it is a different constant per// shape (decisions/s8-light-units.md part 2).#define SCENE_REFERRED_LIGHT_UNITS (CV_SceneExposure.z < 0.0)// The exposure meter's saturation point, in PRE-EXPOSED scene units: the luminance above which// the incident meter stops caring how bright a texel is. 0 on the stock path, where the meter's// input never carries absolute scene radiance and the stock NaN filter is right as it stands, so// every use of this is behind an `if (SCENE_METER_CEILING > 0)` that folds away.//// NOT stored minus one: zero is the meaningful "off" here, and an unbound per-view buffer reading// 0 lands on the stock behaviour, which is the same safe default the other two get from their// offset. Set from LIGHT_METER_CEILING_STOPS above mid grey in// CGraphicsPipeline::GeneratePerViewConstantBuffer().#define SCENE_METER_CEILING (CV_SceneExposure.w)// Mid grey in the scene-referred working space. THE anchor of the whole pipeline// (SceneReferredSpec.md D6): the pre-exposure is defined so that an 18 % patch lands exactly// here, which is what lets every threshold, ceiling and clip in the chain be expressed in stops// rather than in engine units nobody can reason about. The C++ twin is// CRendererResources::kSceneReferredMidGrey.#define SCENE_MID_GREY (0.18)// The ceiling every scene-referred WRITER is held to, in exposed scene units// (r_SceneReferredWriterClamp, default 2^15 = 32768, about 17.5 stops over mid grey). 0 = no// clamp, which is what the stock path and an unbound per-view buffer read, so every use of this// sits behind an `if (SCENE_WRITER_CLAMP > 0)` that folds away.//// This is a FORMAT bound and not a look. The HDR target is fp16 and stops at 65504; a writer// that can exceed it - the procedural sky's Mie forward-scattering peak, which diverges as the// view direction meets the sun, or an emissive material in kcd/m2 at a night pre-exposure -// leaves an Inf in the buffer, and from there every average, blur and threshold downstream is// poisoned. The sensor's own clip (FilmMapping step 1b, 14 stops over grey by default) sits// three and a half stops BELOW this, so nothing the picture can show is touched by it.//// It rides in CV_SceneLuminanceWeightsDelta.w rather than in a float4 of its own for the reason// the meter ceiling rides in CV_SceneExposure.w: it is the only spare slot in the per-view block// whose unbound value, 0, is already the correct "off".#define SCENE_WRITER_CLAMP (CV_SceneLuminanceWeightsDelta.w)cbuffer CBPerViewGlobal : register(b6){	float4x4  CV_ViewProjZeroMatr;	float4    CV_AnimGenParams;		float4x4  CV_ViewProjMatr;	float4x4  CV_ViewProjNearestMatr;	float4x4  CV_InvViewProj;	float4x4  CV_PrevViewProjMatr;	float4x4  CV_PrevViewProjNearestMatr;	float3x4  CV_ScreenToWorldBasis;	float4    CV_TessInfo;	float4    CV_WorldViewPosition;	float4    CV_CameraRightVector;	float4    CV_CameraFrontVector;	float4    CV_CameraUpVector;		float4    CV_ScreenSize;	float4    CV_HPosScale;	float4    CV_ProjRatio;	float4    CV_NearestScaled;	float4    CV_NearFarClipDist;		float4    CV_SunLightDir;	float4    CV_SunColor;	float4    CV_SkyColor;	float4    CV_FogColor;	float4    CV_TerrainInfo;		float4    CV_DecalZFightingRemedy;		float4x4  CV_FrustumPlaneEquation;	float4    CV_WindGridOffset;		float4x4  CV_ViewMatr;	float4x4  CV_InvViewMatr;		float4x4  CV_ProjMatr;	float4x4  CV_ProjMatrUnjittered;	// Scene-referred constants, all stored MINUS ONE so an unbound buffer reads unity.	// .x = exposure - 1, .y = 1/exposure - 1, .z = BRDF normalisation factor - 1.	// .w is the exposure meter's saturation luminance and is NOT offset - 0 means "stock".	// Read through PS_HDR_RANGE_ADAPT_MAX, SCENE_BRDF_NORM_FACTOR and SCENE_METER_CEILING,	// never directly.	float4    CV_SceneExposure;	// The luminance weights of whatever space the HDR target is in this frame, stored as the	// DELTA from Rec.709 for exactly the reason CV_SceneExposure is stored minus one: a pass that	// does not bind the per-view constant buffer reads zero, adds zero, and gets Rec.709 - the	// stock answer - instead of a black frame or, far worse, a silently wrong luminance. On the	// stock path the delta is an exact 0.0, so the addition is bit-identical.	// .w is NOT a weight: it is the scene-referred writer clamp (SCENE_WRITER_CLAMP above), and	// 0 - what an unbound buffer reads - is its "off". Read the xyz through	// GetWorkingLuminanceWeights() and the w through SCENE_WRITER_CLAMP, never directly.	float4    CV_SceneLuminanceWeightsDelta;};cbuffer CBPerPassShadowGen : register(b5){	float4    CP_ShadowGen_LightPos;	float4    CP_ShadowGen_ViewPos;		float4    CP_ShadowGen_DepthTestBias;	float4    CP_ShadowGen_FrustumInfo;		float4    CP_ShadowGen_VegetationAlphaClamp;};cbuffer CBPerPassCustom : register(b5){	float4    CP_Custom_ViewMode;};		#define g_VS_WindGridOffs          CV_WindGridOffset#define g_VS_WorldViewPos          float3(CV_ScreenToWorldBasis[0][3], CV_ScreenToWorldBasis[1][3], CV_ScreenToWorldBasis[2][3])#define g_VS_ViewProjZeroMatr      CV_ViewProjZeroMatr#define g_VS_ViewProjMatr          CV_ViewProjMatr#define g_VS_ScreenSize            CV_ScreenSize#define g_VS_HPosScale             CV_HPosScale#define g_VS_NearFarClipDist       CV_NearFarClipDist#define g_VS_AnimGenParams         CV_AnimGenParams#define g_VS_SunLightDir           CV_SunLightDir#define g_VS_SkyColor              CV_SkyColor#define g_VS_TessInfo              CV_TessInfo#define g_VS_FrustumPlaneEquation  CV_FrustumPlaneEquation#define g_PS_ProjRatio             CV_ProjRatio#define g_PS_NearestScaled         CV_NearestScaled#define g_PS_SunLightDir           CV_SunLightDir#define g_PS_SunColor              CV_SunColor#define g_PS_SkyColor              CV_SkyColor#define g_PS_FogColor              CV_FogColor#define g_PS_TerrainInfo           CV_TerrainInfocbuffer CB_SkinQuat_Cur : register(b2){	float2x4 _g_SkinQuat_Cur[MAX_BONES];};cbuffer CB_SkinQuat_Prev : register(b3){	float2x4 _g_SkinQuat_Prev[MAX_BONES];};//==========================================================================================// Frequently used parametersfloat4 FogInfo              : PB_Fog;float4 PS_NearFarClipDist   : PB_NearFarDist;float4 PS_WorldViewPos      : PB_CameraPos;float4 PS_ScreenSize        : PB_ScreenSize;float4 PS_ZRange;