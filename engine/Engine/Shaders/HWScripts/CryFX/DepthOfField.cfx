// Copyright 2008-2021 Crytek GmbH / Crytek Group. All rights reserved.#include "Common.cfi"#include "ShadeLib.cfi"#include "PostEffectsLib.cfi"// Shader global descriptionsfloat Script : STANDARDSGLOBAL<  string Script =           "NoPreview;"           "LocalConstants;"           "ShaderDrawType = Custom;"           "ShaderType = PostProcess;">; /// Constants ////////////////////////////float4 vDofParamsFocus0;float4 vDofParamsFocus1;float4 vAspectRatio;half4 vRainColor;// Sprite bokeh shaping. x: iris blade count, y: polygon blend (0 = round/wide open,// 1 = fully formed polygon - same f/1.2 to f/2.8 window the gather kernel uses),// z: 1 when a shape texture is bound, w: iris phase in radians (shared with the streaks).float4 vDofBokehShape;// Sparse highlight selection for the hybrid splat layer. x: scene-HDR luminance threshold,// y: soft knee half width, z: energy gain of one splat, w: diagnostic flag.// The DOWNSCALE pass repacks zw for the lens-mode energy split (z: the sprite's full-strength// circle of confusion, w: whether the splat is running at all) - it is a separate draw with its// own constant update, and it has no use for a gain or a sprite diagnostic. See DownscaleDofPS.float4 vDofBokehHighlight;// Pupil = shape mask INTERSECT iris polygon, continuous at every f-number.// x: mask-look weight (0 = iris fill style, 1 = mask fill style; follows which hole is the//    smaller one), y: mask sampling scale = pupil bounding radius in mask units (1 while the//    mask is the smaller hole, N_mask/N once the iris is), z: iris polygon radius in quad//    units (N_mask/N while the mask bounds the pupil, 1 once the iris does),// w: circle of confusion at which a splat reaches full strength (fade-in, VS).float4 vDofBokehMask;// Mask rotation: x = cos, y = sin. The mask is its own element and turns independently of// the iris phase (vDofBokehShape.w); the texture is sampled through the INVERSE rotation so// the silhouette turns the same way as the gather taps, which are rotated forward on the CPU.float4 vDofBokehMask2;// Field-dependent pupil (FieldPupilSpec.md), all of it in PUPIL units so the shaders never need// the f-number: x = distance the barrel's apparent centre slides away from the pupil centre at// the frame CORNER (scaled by the pixel's own field height, direction = minus radial),// y = barrel radius, z = coma coefficient, w = astigmatism coefficient (signed; the far layer// stretches radially where the near layer stretches tangentially).float4 vDofFieldPupil;// x = anamorphic squeeze S. The gather taps arrive already narrowed by 1/S from the CPU, but// the barrel and the aberrations are defined on the UNSQUEEZED pupil, so the gather undoes and// redoes the squeeze around them. The splat quad was narrowed in the vertex shader instead, so// its quad-local coordinate already IS pupil space and it ignores this. y = field debug flag.// z = field curvature coefficient, w = the edge softness floor coefficient (LensFlawsSpec.md).// Both are focus errors rather than pupil shapes, so they are applied inside// ComputeCircleOfConfusion and reach the downscale and the composite, not the splat.float4 vDofFieldPupil2;// Axial (longitudinal) chromatic aberration, AxialChromaticSpec.md. x = s, the radius of the// shrunk channels' out-of-focus disc in units of the full one (1 = off). Not a field effect:// each wavelength simply focuses at its own distance, so the centre of the frame fringes as// hard as the corners.// y = the iris polygon's soft edge width in quad-local radius units, resolved on the CPU from// blade curvature (0.06 fully curved, 0.015 fully straight). A curved blade presents a rounded,// slightly soft outline and a straight one cuts a crisp edge - that, not corner length, is how// the two differ, since the silhouette itself is the convex polygon in both cases. zw unused.float4 vDofAxialChromatic;// Internal reflection ghosts (LensGhostSpec.md), one draw per ghost layer - the chain cannot// share a single constant because every layer sits at its own place with its own size and its// own coating colour, and the vertex shader has no way to know which layer it is drawing.// vDofGhost0: x = k, the factor the source's NDC position is mirrored through the frame centre// by, y = the ghost's radius in native pixels (a ghost is an image of the APERTURE, so the CPU// sizes it from the pupil scale rather than from any circle of confusion), z = the scene HDR// luminance a source needs to spawn ghosts, w = the soft knee half width around it.// vDofGhost1: rgb = this layer's coating tint, already hue rotated on the CPU, w = amount.float4 vDofGhost0;float4 vDofGhost1;// Squared field radius of a pixel: 0 at the frame centre, 1 at the corners. Same normalisation// as the field vector the pupil effects use (FieldPupilSpec 2.1), reduced to the only quantity// the flaws below need - both of them are even in the field, so no direction is required.float LensFieldRadius2(float2 tc){	const float fAspect = PS_ScreenSize.x / max(PS_ScreenSize.y, 1.0);	const float2 vField = (tc * 2 - 1) * float2(fAspect, 1.0) * rsqrt(fAspect * fAspect + 1.0);	return dot(vField, vField);}/////////////////////////////////////////////////////////////////////////////////////////////////// Lens model (DofLensModelSpec.md), %_RT_SAMPLE2. Everything below is dead code in the stock// permutation: the cinematic camera asks for the lens model explicitly, and with it off the// engine is an ordinary CRYENGINE down to the instruction./////////////////////////////////////////////////////////////////////////////////////////////////// The gather-side passes (downscale, gather, composite, splat overlay) read://   x = K, the thin-lens constant, so that the SIGNED circle of confusion radius in gather//       units is simply K * (d - d_f) / d. Positive = behind focus, negative = in front.//   y = d_f, the focus distance in metres.//   z = the circle of confusion cap in gather units (r_DepthOfFieldLensModelMaxCoC), NEGATED//       when r_DepthOfFieldLensModelDebug is on - a cap is a positive quantity by construction,//       so its sign is a free flag and costs no lane in a constant that has none to spare.// The SPLAT and the GHOST draws never form a circle of confusion themselves (they read the// gather's own CoC texture), so for those two passes x and y are unused and z carries the// SPLAT's own cap in native pixels instead.//   w = k_sa, spherical aberration. The one lane every consumer reads the same way.float4 vDofLensModel;// The second lens-model constant, read by the gather-side passes only.//   x = the cap on the PHYSICAL circle of confusion, in gather units. This is the splat's own//       ceiling (r_DepthOfFieldLensModelSplatMaxCoC, a native-pixel DIAMETER) expressed as a//       radius in units, and it is the ONLY clamp the circle of confusion texture ever takes://       the texture has to carry what the lens really does, because the tile pass, the layer//       alpha and above all the SPRITE size are all built from it. Clamping it to the gather's//       kernel reach instead - which is what this used to do - made the splat cap dead code and//       pinned every sprite to the gather's disc, which is the one thing the splat exists to//       exceed. The gather clamps its own reach internally instead (vDofLensModel.z).//   y = per-tap jitter amplitude in pupil units (r_DepthOfFieldLensModelJitter x half the tap//       spacing, quartered in the mask domain where a jittered tap can leave the mask's open//       area). 0 = the bare stratified grid.//   z = the frame counter, wrapped, for the jitter's temporal phase. 0 = frozen pattern.//   w = reserved.float4 vDofLensModel2;// Thin lens, signed, in the gather's existing CoC units. This is the whole point of the round:// a real lens has no "focus range" and no quadratic ramp - the blur is fixed by focal length,// f-number, focus distance and sensor size, and the near/far split falls out of the SIGN of the// defocus rather than out of two independently authored ramps.//// The lens flaws fold in exactly where they do on the stock path, because they are the same// physical statements: field curvature bends the object distance BEFORE the lens sees it, edge// softness is a residual far-side blur floor after it, and the minimum-Z near blur is a camera// BODY effect that must not be bent by the curved focal surface.void LensModelCoC(in float4 depths, in float fFieldR2, out float4 nearCoC, out float4 farCoC){	// Petzval field curvature: same depth scale, same meaning as the stock path.	const float4 depthsF = max(depths * (1.0 + vDofFieldPupil2.z * fFieldR2), 1e-4);	// c_px / 2 / U, folded into K on the CPU: the sensor, the frame width and the unit size are	// all constants of the frame, so the per-pixel cost of the thin lens is one divide.	const float4 vSigned = vDofLensModel.x * (depthsF - vDofLensModel.y) / depthsF;	// Body near-clip blur on the RAW depth, as on the stock path.	const float4 FocusRangeNearMin = vDofParamsFocus1.y * saturate(1 - (depths / vDofParamsFocus1.x));	farCoC  = max(vSigned, 0.0);	nearCoC = max(-vSigned, 0.0) + FocusRangeNearMin;	farCoC = max(farCoC, 0.00001);	// Residual off-axis aberration blur, unchanged in meaning: a far-layer floor, so a soft edge	// blends behind the near layer instead of washing over the sharp centre.	farCoC = max(farCoC, vDofFieldPupil2.w * fFieldR2);	// PHYSICAL cap only. The circle of confusion this function produces is what the CoC texture	// carries and therefore what the sprite sizes itself from, so the only ceiling that belongs	// here is the largest disc the SPLAT is allowed to draw. The gather's kernel reach is a	// property of the gather - 121 taps cannot resolve a disc of any size - and is applied	// inside DofPS, on the copies of the CoC it uses for reach, coverage and density, so that	// clipping the halo does not also clip the sprite.	const float fCap = max(vDofLensModel2.x, 0.0001);	farCoC  = clamp(farCoC,  0, fCap);	nearCoC = clamp(nearCoC, 0, fCap);}// Native pixels of disc RADIUS per unit of circle of confusion. This is not a choice: it is// what DofPS's own tap scale works out to (PS_ScreenSize.zw = 0.5 / size, times two, times the// 1080-referenced scale), so anything that wants to know how big the gather's disc really is on// screen has to use exactly this. Evaluated with the FULL resolution screen size.float LensCoCUnitPixels(float2 vScreenSize){	return 4.0 * max(vScreenSize.x / 1920.0, vScreenSize.y / 1080.0);}// How much of the frame the far layer is allowed to replace. Zero until the disc exceeds one// pixel and complete by two: inside the depth of field the composite must hand back the NATIVE// frame, or a half-resolution blur is lerped over pixels that the lens says are sharp - which is// exactly why the stock focus zone never reads sharp.float LensFarBlend(float fFarCoC, float2 vScreenSize){	return saturate((fFarCoC * LensCoCUnitPixels(vScreenSize) - 0.5) / 1.5);}// Spherical aberration as a pupil APODIZATION: the rays through the rim of the pupil focus at a// different distance from the ones through its centre, so on one side of focus the disc piles// its light up at the rim and on the other it smears it into the middle. w(r) = 1 + side*k*(2r^2-1)// integrates to zero over the unit disc, so the disc's total energy is unchanged to first order// and no normalisation has to follow it. side = +1 behind focus, -1 in front.// k > 0: bright-rimmed behind focus, soft in front (over-corrected, "soap bubble").// k < 0: the reverse - the STF / DC apodized look. 0 = a flat disc, exactly what it was.float LensApodize(float fR2, float fSide){	return clamp(1.0 + fSide * vDofLensModel.w * (2.0 * fR2 - 1.0), 0.05, 2.0);}// The soft-knee highlight excess, EXACTLY as DofBokehRefVS computes it for the sprite: a// quadratic knee across [threshold - knee, threshold + knee], linear above. Shared so that// base + excess == the texel by construction rather than by two authors agreeing.//// This is what splits the frame's energy between the two halves of the hybrid depth of field.// The gather layers used to carry each texel's FULL colour AND the splat deposited the excess// on top: a gather is a normalised average, but over a stratified kernel it still spreads a// point's whole light L over its disc in expectation, so a lamp came out at L (gather) plus// L - T (sprite) - up to twice its real brightness, with the error a function of a purely// aesthetic threshold. The lamp's full L in the gather is also what made the tap copies so// visible: the brightest thing in the frame was the thing being sampled 121 times.//// So in lens mode the downscale keeps only the BASE (min(L, T)-ish, softened by the same knee)// and the sprite carries the rest. Per SAMPLE, before the 5-tap average: max(0, x - t) is// convex, so the excess of a mean understates the mean of the excesses, and the sprite itself// thresholds its four native texels individually for the same reason.float LensHighlightExcess(float fLum, float fThreshold, float fKnee){	float fSoft = clamp(fLum - fThreshold + fKnee, 0, 2 * fKnee);	fSoft = (fSoft * fSoft) / (4 * fKnee);	return max(fSoft, fLum - fThreshold);}// The pupil, as a single function of a point in pupil space (unit disc = the wide-open geometric// pupil). Returns rgb = the per-channel transmittance x intensity profile, a = the same thing// without the per-channel mask - the lane the layer's own circle of confusion is averaged by.//// It carries the terms that are pure arithmetic and therefore identical for every consumer: the// mechanical barrel clip, the axial chromatic per-channel radius, and the apodization above. The// two terms that need a RESOURCE rather than arithmetic - the iris polygon and the shape mask -// are not in here because each consumer already owns them in the only form it can afford: the// gather has them baked into the DISTRIBUTION of its taps (CPU-side polygon mapping, or// importance sampling of the mask texture), the splat evaluates them per pixel from the texture// it has bound. Putting them here would double count on one side and cost a texture binding on// the other. Coma and astigmatism are coordinate transforms and belong outside a pupil function// by definition - they say where a ray lands, not whether it exists.float4 LensPupil(float2 x, float2 vBarrelC, float fSide, float fAxialS){	const float fR2 = dot(x, x);	// The aperture: this ray only exists if it clears the mechanical opening. Soft edged so the	// clipped silhouette does not alias from one tap to the next.	const float fBarrel = saturate((vDofFieldPupil.y - length(x - vBarrelC)) / 0.08 + 0.5);	const float fBase = fBarrel * LensApodize(fR2, fSide);	// Per-channel disc: the short-focusing pair simply does not accept rays outside its own,	// smaller radius. Behind focus that pair is red and blue and the rim left over reads green;	// in front of focus it is green and the rim reads magenta. One-sided and outward, so at	// s = 1 every point of the unit pupil masks to exactly 1.	const float m = saturate((fAxialS - length(x)) / 0.08 + 1);	const float3 vChannel = (fSide > 0.0) ? float3(m, 1, m) : float3(1, m, 1);	return float4(fBase * vChannel, fBase);}/////////////////////////////////////////////////////////////////////////////////////////////////// Sprite-Based DOF/////////////////////////////////////////////////////////////////////////////////////////////////struct pixoutDofMRT{	half4 LayerNear  : SV_Target0;	half4 LayerFar   : SV_Target1;};// One quad per source pixel, expanded from SV_VertexID - there is no vertex stream at all,// so this is the only interpolator set the sprite path uses.struct v2fBokehQuad{	float4 Position  : SV_POSITION;	float4 QuadPos   : TEXCOORD0; //xy quad-local uv, z near blur, w unused	float4 Color     : TEXCOORD1;	// Field-dependent pupil, resolved once per sprite from its own position in the frame:	// xy = field vector (0 at the centre, 1 at the corners), z = 1 / transmission through the	// clipped pupil, w = how much the quad was grown to hold the deformed shape.	float4 Field     : TEXCOORD2;};Texture2D texDofBkRef_SceneTarget : register(t0);Texture2D texDofBkRef_SceneDepth  : register(t1);Texture2D texDofBkRef_Dither      : register(t2);Texture2D texDofBkRef_BokehShape  : register(t3);Texture2D texDofBkRef_CoC         : register(t4);  // gather's CoC: r = near (tile max), g = far (tile min)SamplerState ssDofBkRef_SceneTarget : register(s0);SamplerState ssDofBkRef_SceneDepth  : register(s1);SamplerState ssDofBkRef_Dither      : register(s2);SamplerState ssDofBkRef_BokehShape  : register(s3);// Radius of a regular n-gon at angle theta, normalized so the edge midpoints sit at 1.// Same closed form the gather kernel uses on the CPU (CDepthOfFieldStage::ToUnitDisk).float NGon_Rad(float theta, float n){	return cos(PI / n) / cos(theta - (2 * PI / n) * floor((n * theta + PI) / (2 * PI)));}v2fBokehQuad DofBokehRefVS(uint nVertexID : SV_VertexID){	v2fBokehQuad OUT = (v2fBokehQuad) 0;	// Resolve the quad's cell in the source grid with integer math. The original float	// modulo against g_VS_ScreenSize.x works today, but the quad id reaches several million	// and would start banding into columns once it leaves fp32's exact integer range.	const int nQuadID    = (int)(nVertexID / 6);	const int nGridWidth = (int)g_VS_ScreenSize.x;	float4 INPos = float4((float)(nQuadID % nGridWidth), (float)(nQuadID / nGridWidth), 0, 0);	INPos.xy /= g_VS_HPosScale.xy;	float4 vOutPos = INPos;  float4 vPos = INPos;		INPos.xy *= g_VS_ScreenSize.zw * 2.0;	INPos.xy += g_VS_ScreenSize.zw;	vOutPos = INPos;	vOutPos.xy =  vOutPos.xy *2 -1;	OUT.Position = float4(vOutPos.xy, 0, 1);//vWorldPos.z, fDepth); //mul(vpMatrix, vPos);  	float4 screenProj = HPosToScreenTC(OUT.Position);			// fetch scene color - output vertex/quad color	float fDepth = GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy, 0, 0)).x;	#if %_RT_SAMPLE1	// Dilate to avoid ghosting on edges due to lower resolution DOF	// This can cause artifacts in small cavities and on alpha-tested geometry	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2( vAspectRatio.w, vAspectRatio.w), 0, 0)).x);	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2(-vAspectRatio.w, vAspectRatio.w), 0, 0)).x);	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2( vAspectRatio.w,-vAspectRatio.w), 0, 0)).x);	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2(-vAspectRatio.w,-vAspectRatio.w), 0, 0)).x);#endif	OUT.QuadPos = 1;	fDepth *= g_VS_NearFarClipDist.y;	// Circle of confusion read from the gather's own CoC texture rather than recomputed from	// depth: the splat rides on top of the gather result, so it has to agree with the gather on	// how far out of focus this cell is - to the number, including the gather's 2x2 min (far)	// / max (near) and its tile dilation. Recomputing from a different depth source put the two	// a little apart at every edge, and that read as the splat lagging the halo.	const half2 vCocGather = GetTexture2DLod(texDofBkRef_CoC, ssDofBkRef_SceneDepth, float4(screenProj.xy, 0, 0)).rg;#if %_RT_SAMPLE2	// Lens mode: the gather already clamped its circle of confusion to the user's kernel cap, so	// a second hard clamp at 4 here would silently cut the sprite back to the stock kernel's	// reach - the one number the splat exists to exceed.	half fCocNear = max(vCocGather.r, 0);	half fCocFar  = max(vCocGather.g, 0);#else	half fCocNear = clamp(vCocGather.r, 0, 4);	half fCocFar  = clamp(vCocGather.g, 0, 4);#endif	// DofPS turns a CoC into a tap radius with this scale; doubling it gives the diameter.	const half fCocScalePixels = max(g_VS_ScreenSize.x / 1920.0, g_VS_ScreenSize.y / 1080.0) * 4.0;	half fDepthBlur = max(fCocFar, fCocNear) * 2.0 * fCocScalePixels;#if %_RT_SAMPLE2	// A sprite is an EXACT evaluation of the pupil, not a sparse sample of it, so a large disc	// costs fill rate and nothing else - the 64 px ceiling only ever existed to bound a sprite	// that had to agree with a 4-unit gather. r_DepthOfFieldLensModelSplatMaxCoC owns it now,	// and the CPU hands it down already halved: the cvar is a DIAMETER, fDepthBlur is the quad's	// half extent. abs() because the gather's copy of this constant flags the diagnostic with the	// cap's sign - the sprite's copy never does, but a lane that can be negative anywhere is not	// a lane to compare a size against.	fDepthBlur = min(abs(vDofLensModel.z), fDepthBlur);#else	fDepthBlur = min(64, fDepthBlur);#endif	// Amplitude in step with the gather. The gather's halo loses energy as a highlight nears	// focus (its taps are weighted by CoC), while an energy-conserving splat only gets	// brighter per pixel as its disc shrinks - left alone, a small sharp silhouette floats on	// an already-converged light and then vanishes in one frame at the cull below. Fade the	// splat in over [1/3, 1] x r_DepthOfFieldSpriteBokehFadeCoC instead: below a handful of	// pixels the shape is unresolvable anyway, and the gather already carries that light.	const half fFadeFull = max(vDofBokehMask.w, 1e-3);	const half fSplatFade = smoothstep(fFadeFull * 0.333, fFadeFull, max(fCocFar, fCocNear));	// Sub-pixel splats add nothing the gather has not already done, and cost a quad each.	if( fDepthBlur < 1.0 || fSplatFade <= 0.001 )	{		OUT.Position.xy=0;		return OUT;	}	OUT.QuadPos = max(1, fDepthBlur);	// lod blend weight	OUT.Color.w = ( sqrt(OUT.QuadPos.z) );	// Need to scale by pixel size	OUT.QuadPos.xy *= g_VS_ScreenSize.zw * 2.0;  // Scale by aspect ratio  OUT.QuadPos.xy *= vAspectRatio.xy;  // Anamorphic squeeze: the pupil image is compressed horizontally, so the quad - and the  // shape mask sampled through it - is too. QuadPos.w (the CoC in pixels) is left alone.  OUT.QuadPos.x *= vAspectRatio.z;	OUT.QuadPos.xy = max(g_VS_ScreenSize.zw * 2.0, OUT.QuadPos.xy);	OUT.QuadPos.z = saturate(fCocNear); // near blur, splits the splat between the two layers	// The grid cell's four NATIVE resolution texels: t0 is the full resolution scene copy,	// one grid texel spans 2x2 native texels, and zw is half a grid texel = one native texel,	// so +/-0.5*zw from the cell centre lands exactly on the four native texel centres.	// The old path sampled an already-downscaled copy and then averaged a further 2x2	// neighbourhood of it, so a small bright highlight was diluted by up to 16x BEFORE the	// threshold ever saw it - the splat survived but carried almost no excess energy, which	// is why the shapes only became readable once supersampling raised the internal	// resolution and undid the dilution by accident.	float4 vQuad[4] =	{		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2(-0.5, -0.5), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2( 0.5,  0.5), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2( 0.5, -0.5), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2(-0.5,  0.5), 0, 0)),	};	// Sparse highlight selection, PER TEXEL. The gather underneath has already spread the	// base energy, so only the EXCESS above a soft knee is splatted - but the knee has to be	// applied to each native texel BEFORE any averaging: max(0, x - t) is convex, so the	// excess of a mean is always less than the mean of the excesses, and a lone hot pixel in	// a dark cell used to read as a dim cell and lose its energy.	const half fThreshold = vDofBokehHighlight.x;	const half fKnee      = max(vDofBokehHighlight.y, 1e-4);	half fExcessSum = 0;	half3 cExcess = 0;	[unroll] for (int i = 0; i < 4; i++)	{		const half fLum = GetWorkingLuminance(vQuad[i].rgb);		// Quadratic knee across [threshold - knee, threshold + knee], linear above. A wide		// knee is what stops highlights popping as the aperture or focus sweeps past them.		half fSoft = clamp(fLum - fThreshold + fKnee, 0, 2 * fKnee);		fSoft = (fSoft * fSoft) / (4 * fKnee);		const half fExcess = max(fSoft, fLum - fThreshold);		// Hue preserving: this texel's colour rescaled so its luminance is exactly its excess.		cExcess += vQuad[i].rgb * (fExcess / max(fLum, 1e-4));		fExcessSum += fExcess;	}	// Mean over the cell keeps the old calibration for uniform areas (mean of excess equals	// excess of mean there) while a lone hot texel now keeps a quarter of its true excess	// instead of a sixteenth.	if (fExcessSum * 0.25 < 1e-4)	{		OUT.Position.xy=0;		return OUT;	}	OUT.Color.rgb = cExcess * 0.25 * fSplatFade;	// Field-dependent pupil, evaluated at the SPRITE's own place in the frame (a splat is one	// point of the field, unlike a gather pixel which is the field position itself).	{		const float fFieldAspect = g_VS_ScreenSize.x / max(g_VS_ScreenSize.y, 1.0);		const float2 vField = (screenProj.xy * 2 - 1) * float2(fFieldAspect, 1.0) * rsqrt(fFieldAspect * fFieldAspect + 1.0);		const float fFieldR = length(vField);		// The one number the tonemap, the gather and this pass all have to agree on. The		// tonemap darkens every pixel by T, and this pass divides its deposit by T so the loss		// lands exactly once - the splat normalises by the FULL disc area, so a clipped pupil		// would otherwise dim it a second time. Floored at 0.05 so a fully clipped corner		// sprite cannot explode.		const float fTransmission = LensFieldPupilTransmission(vDofFieldPupil.x * fFieldR, vDofFieldPupil.y);		// Coma pushes taps outward and astigmatism stretches one axis, so the deformed shape no		// longer fits the quad the CoC alone would need. Grow the quad by the worst case and		// undo the growth in the pixel shader, which keeps the shape's size (and therefore its		// energy normalisation) exactly as it was.		const float fGrowth = 1.0 + vDofFieldPupil.z * fFieldR + abs(vDofFieldPupil.w) * fFieldR * fFieldR;		OUT.Field = float4(vField, 1.0 / max(fTransmission, 0.05), fGrowth);		OUT.QuadPos.xy *= fGrowth;	}  const float2 Verts[6] =  {      float2( 1,  1),      float2(-1,  1),      float2( 1, -1),      float2( 1, -1),      float2(-1,  1),      float2(-1, -1)  };    OUT.Position.xy += Verts[nVertexID%6].xy * OUT.QuadPos.xy;  OUT.QuadPos = float4(Verts[nVertexID%6].xy*0.5+0.5, OUT.QuadPos.zw);	return OUT;}// The pupil itself: barrel clip INTERSECT iris polygon INTERSECT shape mask, rendered in// whichever of the two fill styles the smaller hole calls for. Factored out of the pixel shader// below because axial chromatic aberration needs it evaluated TWICE, at two radii - a channel// that focuses short draws the very same pupil, only smaller. tcQuad is the quad-local// coordinate already brought back to pupil units and walked back through the aberrations;// vBarrelC is the barrel's apparent centre and fIrisExp the lod-driven iris falloff exponent.// fSide is +1 behind focus and -1 in front, which is all the spherical-aberration apodization// needs to know: it is the same function of pupil radius on both sides of focus, turned over.// fRadiusPx is how many native pixels ONE unit of tcQuad radius covers - the drawn shape's own// radius on screen - which is what turns the polygon's edge width from an abstract number into// a number of pixels (see fEdgeSoft below).half4 EvalPupilShape(half2 tcQuad, float2 vBarrelC, half fIrisExp, half fSide, float fRadiusPx){	const half fLen = dot(tcQuad, tcQuad);	// Iris fill style: radial falloff plus the approximate diffusion ring.	half fShapeBokeh = pow(fLen, fIrisExp) ;// * fLen;  // ^2	half4 cIris = saturate(1-fShapeBokeh);	cIris += saturate(1-abs(fShapeBokeh*2-1));	// Iris polygon at the formation exponent (vDofBokehShape.y: 0 = circle, 1 = the true	// polygon and the hard ceiling - a real iris opening is the intersection of the blades and	// is always convex, so nothing may push the corners past NGon_Rad - the same exponent the	// gather kernel raises its taps by, so both views of the iris always agree), at radius	// vDofBokehMask.z in quad units. Blade curvature is expressed as the EDGE instead: soft for	// a curved blade, crisp for a straight one (vDofAxialChromatic.y).	// Soft edge width in quad-local RADIUS units, floored at one native pixel. Blade curvature	// authors this number for the look (0.06 curved, 0.015 straight), but on a large sprite a	// straight blade's 0.015 is half a pixel wide and the outline stops being an edge at all: it	// aliases into a dotted line and reads as if curvature did nothing. One pixel is the finest	// edge the grid can express, so that is the floor - and it is a floor, so a curved blade's	// deliberately soft outline is untouched at every size.	const float fEdgeSoft = max(vDofAxialChromatic.y, 1.0f / max(fRadiusPx, 1.0f));	const float fRadius   = sqrt(max(fLen, 1e-6f));	const float fTheta    = atan2(tcQuad.y, tcQuad.x);	const float fPolyRad  = pow(NGon_Rad(fTheta - vDofBokehShape.w, max(vDofBokehShape.x, 3.0f)), vDofBokehShape.y) * vDofBokehMask.z;	const half  fPolyMask = saturate((fPolyRad - fRadius) / fEdgeSoft);	// PUPIL = mask INTERSECT iris. The mask (white when none is bound) is sampled at the pupil's	// bounding scale (vDofBokehMask.y), the polygon at its own radius; their product is the	// physical aperture at every f-number. Stopping the iris down through the mask clips the	// silhouette corner by corner and rounds it off progressively - the two apertures are two	// separate mechanisms, but the crossover between them is a continuous intersection.	// Quad-local, from the CORRECTED coordinate: the mask is part of the pupil, so the barrel	// and the aberrations have to reshape its silhouette too, not be drawn as a circle over it.	float2 vMaskLocal = (tcQuad * 0.5) * vDofBokehMask.y;	vMaskLocal = float2( vMaskLocal.x * vDofBokehMask2.x + vMaskLocal.y * vDofBokehMask2.y,	                    -vMaskLocal.x * vDofBokehMask2.y + vMaskLocal.y * vDofBokehMask2.x);   // inverse rotation	const half fMaskVal = GetTexture2D(texDofBkRef_BokehShape, ssDofBkRef_BokehShape, vMaskLocal + 0.5).r;	// The barrel clip is the APERTURE and comes before the aberrations conceptually - it decides	// which rays exist at all, while coma and astigmatism are what the glass does to the ones	// that got through. Soft edge matched to the polygon's, so the two silhouettes blend alike.	const half  fBarrel = saturate((vDofFieldPupil.y - length(tcQuad - (half2)vBarrelC)) / 0.06 + 0.5);	const half fPupil   = fMaskVal * fPolyMask * fBarrel;	// Mask fill style: the pupil value field is the fill, and the soap-bubble diffusion ring	// rides the bilinear band where it crosses one half - the mask's outline inside the polygon,	// the polygon's edge where it clips the mask. A star gets a star-shaped ring.	const half4 cMaskLook = (half4)fPupil + saturate(1 - abs((1 - fPupil) * 2 - 1));	const half4 cIrisLook = cIris * fPupil;	// The fill style follows whichever hole is the smaller one (weight resolved on the CPU	// from N_mask / N); the geometry above is exact in both.	// Spherical aberration rides on top of all of it as an intensity profile across the pupil -	// not a silhouette change, so it multiplies whatever shape the pupil turned out to be, star	// or disc alike, and the ghosts (which share this function) inherit it. At k_sa = 0 the	// factor is exactly 1, so this is a no-op on the stock path.	return lerp(cIrisLook, cMaskLook, vDofBokehMask.x) * (half)LensApodize(fLen, fSide);}pixoutDofMRT DofBokehRefPS(v2fBokehQuad IN){	pixoutDofMRT OUT = (pixoutDofMRT) 0.0;	//clip(-1);	half2 tcQuad = IN.QuadPos.xy*2-1;	// Field-dependent pupil. The quad was GROWN by g in the vertex shader so the deformed shape	// still fits inside it, so a quad-local coordinate now spans g pupil radii instead of one:	// scaling by g recovers pupil units and leaves the drawn shape at exactly the screen size	// (and therefore the pixel area, and therefore the energy normalisation) it had before.	// Then walk BACK through the aberrations - drawing a deformed shape means sampling the	// undeformed pupil at M^-1(x).	const float fFieldR = length(IN.Field.xy);	// Undefined at the exact frame centre, where every field term vanishes anyway.	const float2 vFieldU = (fFieldR > 1e-4) ? (IN.Field.xy / fFieldR) : float2(1, 0);	const float2 vFieldT = float2(-vFieldU.y, vFieldU.x);	// Near and far layers sit on opposite sides of focus, so their astigmatic ellipses are	// each other turned by 90 degrees. QuadPos.z is the near/far split the vertex shader	// resolved from the CoC. Hoisted out of the block below because the spherical-aberration	// apodization is turned over by the very same split - one side of focus, one sign.	const float fAstigSign = (IN.QuadPos.z > 0.5) ? -1.0 : 1.0;	{		tcQuad *= (half)IN.Field.w;		const float a = fAstigSign * vDofFieldPupil.w * fFieldR * fFieldR;		float2 x = vFieldU * (dot(tcQuad, vFieldU) / (1 + a)) + vFieldT * (dot(tcQuad, vFieldT) / (1 - a));		// Coma has no closed-form inverse - the displacement depends on the radius it produces -		// but one Newton refinement lands well inside a pixel at the strengths this exposes.		const float k = vDofFieldPupil.z * fFieldR;		const float2 x0 = x - vFieldU * (k * dot(x, x));		x -= vFieldU * (k * dot(x0, x0));		tcQuad = (half2)x;	}	// -8 ms for big kernels	const half fLen = (dot(tcQuad, tcQuad));	// Bare iris: the circular clip is the lens barrel. With a shape texture bound the pupil is	// the mask x polygon product below, which is zero outside itself - and the mask may own	// the quad's corners, so the barrel must not eat them. Always at the FULL radius: the quad	// is sized for the widest channel, so clipping it to the shrunk one would cut the rim off.	clip( lerp(1 - fLen, 1.0, vDofBokehShape.z) );	const float2 vBarrelC = -vFieldU * (vDofFieldPupil.x * fFieldR);	// Axial chromatic aberration. The shrunk channels focus at a different distance, so they	// draw the SAME pupil at a smaller radius: evaluating the shape at tcQuad / s is exactly	// that shape scaled by s. Dividing by s^2 keeps the light in it constant, so the smaller	// disc is correspondingly brighter - the same energy through a smaller circle. At s = 1	// the two evaluations are identical and this reduces to the single deposit it replaced.	const half fAxialS = (half)max(vDofAxialChromatic.x, 0.05);	// Same near/far split the astigmatic ellipse uses - a sprite lands on one side of focus.	const half fApodSide = (half)fAstigSign;	// QuadPos.w is the quad's half extent in native pixels, i.e. exactly how many pixels one unit	// of quad-local radius spans. The shrunk channel is drawn at radius fAxialS of that, so its	// edge has correspondingly fewer pixels to be soft over.	const float fQuadRadPx = max(IN.QuadPos.w, 1.0);	const half4 cFull   = EvalPupilShape(tcQuad, vBarrelC, (half)IN.Color.w, fApodSide, fQuadRadPx);	const half4 cShrunk = EvalPupilShape(tcQuad / fAxialS, vBarrelC, (half)IN.Color.w, fApodSide, fQuadRadPx * fAxialS) / (fAxialS * fAxialS);	// Behind focus red and blue are the short-focusing pair, so the rim beyond their discs is	// green alone; in front of focus it is green that shrinks and the rim reads magenta. Which	// side a splat lands on is the same near/far split QuadPos.z already carries.	const half3 cShapeFar  = half3(cShrunk.r, cFull.g,   cShrunk.b);	const half3 cShapeNear = half3(cFull.r,   cShrunk.g, cFull.b);	// Energy conserving deposit. QuadPos.w carries the CoC in pixels, so dividing by its area	// spreads a fixed amount of energy over the disc however large it grows - a highlight	// going further out of focus widens and dims instead of gaining brightness. The layer is	// added to the gathered frame, so there is no accumulated-weight average to divide by.	const half fCocPixels = max(IN.QuadPos.w, 1.0);	// The anamorphic oval covers CoC^2 * vAspectRatio.z pixels instead of CoC^2 (the quad was	// narrowed by that same factor in the VS), so the deposit is divided by the real area.	const half fSplatNorm = vDofBokehHighlight.z / (fCocPixels * fCocPixels * vAspectRatio.z);	// Each layer composes its own silhouette now, so the deposit is built twice. Everything	// that is not the colour - the area normalisation, the transmission divide, the alpha from	// the mean of the channels - is exactly what it was.	// fSplatNorm divides by the FULL disc area, so a barrel-clipped pupil would dim this splat	// by the transmission T all by itself - and the tonemap vignette dims it again. Divide T	// back out (Field.z is 1/T) so the mechanical light loss is applied exactly once, in the	// tonemap, for blurred and sharp pixels alike.	const half fDeposit = fSplatNorm * (half)IN.Field.z;	half4 cSceneFar  = half4(IN.Color.rgb * cShapeFar,  dot(cShapeFar,  0.333)) * fDeposit;	half4 cSceneNear = half4(IN.Color.rgb * cShapeNear, dot(cShapeNear, 0.333)) * fDeposit;	// DIAGNOSTIC (r_DofSpriteBokehDebug): ignore the scene colour and the area	// normalization and paint the silhouette itself, blazing. If the shape texture and the	// iris polygon reach this shader at all, this makes them impossible to miss.	if (vDofBokehHighlight.w > 0.5)	{		cSceneFar  = half4(cShapeFar,  dot(cShapeFar,  0.333)) * 4.0;		cSceneNear = half4(cShapeNear, dot(cShapeNear, 0.333)) * 4.0;	}	// Background layer splats	OUT.LayerFar = cSceneFar * saturate(1-IN.QuadPos.z);	// Foreground layer splats	OUT.LayerNear = cSceneNear * saturate(IN.QuadPos.z);	// Apply dither pattern (minimize banding artefacts from accumulation/blending + aproximate lens particles)		half fDither = GetTexture2D(texDofBkRef_Dither, ssDofBkRef_Dither, IN.QuadPos.xy).w;	OUT.LayerFar += OUT.LayerFar * fDither;	OUT.LayerNear += OUT.LayerNear * fDither;	return OUT;}technique DofBokehRef{  pass p0  {    VertexShader = DofBokehRefVS() PostMotionBlurVS;    PixelShader = DofBokehRefPS() PostMotionBlurPS;    CullMode = None;  }}/////////////////////////////////////////////////////////////////////////////////////////////////// Lens ghosts (LensGhostSpec.md)//// A bright source reflects between the lens surfaces and lands on the sensor as a chain of// IMAGES OF THE APERTURE, strung along the line from the source through the frame centre. That// is the same object the sprite bokeh already draws, so this shares DofBokehRefPS verbatim and// inherits the iris polygon, the shape mask and its rotation, the anamorphic oval, the cat-eye// clip and the axial chromatic rim for free. Only the placement and the sizing are different,// which is exactly one vertex shader.//// The grid is QUARTER resolution: a ghost source is a lamp or the sun, never a lone hot texel,// and every extra layer multiplies the vertex work by the whole grid./////////////////////////////////////////////////////////////////////////////////////////////////v2fBokehQuad DofBokehGhostVS(uint nVertexID : SV_VertexID){	v2fBokehQuad OUT = (v2fBokehQuad) 0;	// Same integer walk over the quad grid as the splat above; only the per-view constant	// buffer differs, so the existing arithmetic needs no knowledge of the grid tier.	const int nQuadID    = (int)(nVertexID / 6);	const int nGridWidth = (int)g_VS_ScreenSize.x;	float4 INPos = float4((float)(nQuadID % nGridWidth), (float)(nQuadID / nGridWidth), 0, 0);	INPos.xy /= g_VS_HPosScale.xy;	INPos.xy *= g_VS_ScreenSize.zw * 2.0;	INPos.xy += g_VS_ScreenSize.zw;	float4 vOutPos = INPos;	vOutPos.xy = vOutPos.xy * 2 - 1;	// Where the SOURCE is. The ghost is placed elsewhere below, but the light is sampled here.	OUT.Position = float4(vOutPos.xy, 0, 1);	float4 screenProj = HPosToScreenTC(OUT.Position);	OUT.QuadPos = 1;	// No circle of confusion, no depth, no focus fade: a ghost is formed in the lens, not in	// the scene, so its size is the aperture's image and arrives resolved from the CPU in	// native pixels. Sub-pixel ghosts cost a quad and add nothing.	const half fRadiusPx = (half)vDofGhost0.y;	if (fRadiusPx < 1.0)	{		OUT.Position.xy = 0;		return OUT;	}	// The middle 2x2 of the 4x4 cell. zw is half a GRID texel and a grid texel spans four	// native texels here, so one native texel is 0.5 * zw and +/-0.25 * zw lands on the four	// texel centres around the cell centre.	float4 vQuad[4] =	{		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2(-0.25, -0.25), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2( 0.25,  0.25), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2( 0.25, -0.25), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2(-0.25,  0.25), 0, 0)),	};	// Its own threshold, far above the splat's: only lamps, the sun and hot reflections throw	// ghosts. Same quadratic knee and the same per-texel order as the splat - max(0, x - t) is	// convex, so thresholding the mean would swallow a lone hot texel, which is exactly what a	// distant lamp is on a quarter resolution grid.	const half fThreshold = (half)vDofGhost0.z;	const half fKnee      = (half)max(vDofGhost0.w, 1e-4);	half fExcessSum = 0;	half3 cExcess = 0;	[unroll] for (int i = 0; i < 4; i++)	{		const half fLum = GetWorkingLuminance(vQuad[i].rgb);		half fSoft = clamp(fLum - fThreshold + fKnee, 0, 2 * fKnee);		fSoft = (fSoft * fSoft) / (4 * fKnee);		const half fExcess = max(fSoft, fLum - fThreshold);		// Hue preserving, as in the splat: this texel's colour rescaled to its own excess.		cExcess += vQuad[i].rgb * (fExcess / max(fLum, 1e-4));		fExcessSum += fExcess;	}	if (fExcessSum * 0.25 < 1e-4)	{		OUT.Position.xy = 0;		return OUT;	}	// The chain: the ghost sits on the line from the source through the frame CENTRE and out	// the other side, at k times the source's distance from it. NDC has the centre at the	// origin, so the reflection is a plain negation.	OUT.Position = float4(-vOutPos.xy * vDofGhost0.x, 0, 1);	OUT.Color.rgb = cExcess * 0.25 * (half3)vDofGhost1.rgb * (half)vDofGhost1.w;	// Read by the pixel shader as the iris falloff exponent, exactly as for a splat.	OUT.Color.w = sqrt(fRadiusPx);	// Radius in native pixels -> NDC half extent. The grid is quarter resolution, so one grid	// cell spans four native pixels and g_VS_ScreenSize.zw (half a grid texel) IS one native	// pixel expressed in NDC - no 1080-referenced aspect scale belongs here, because the CPU	// already sized the ghost as a fraction of the real frame height.	OUT.QuadPos = float4(fRadiusPx * g_VS_ScreenSize.zw, 1, fRadiusPx);	// Anamorphic squeeze: the pupil image is compressed horizontally, so its ghost is too.	OUT.QuadPos.x *= vAspectRatio.z;	// QuadPos.z = 1: ghosts go to the NEAR layer, which the overlay adds unmasked. The far	// layer is depth-masked against in-focus foreground and would cut them - and a ghost is	// formed inside the lens, so nothing in the scene may occlude it.	// Field-dependent pupil, evaluated at the GHOST's own place in the frame rather than the	// source's: the aperture image is clipped by the barrel where IT lands.	{		const float fFieldAspect = g_VS_ScreenSize.x / max(g_VS_ScreenSize.y, 1.0);		const float2 vField = OUT.Position.xy * float2(fFieldAspect, 1.0) * rsqrt(fFieldAspect * fFieldAspect + 1.0);		const float fFieldR = length(vField);		const float fTransmission = LensFieldPupilTransmission(vDofFieldPupil.x * fFieldR, vDofFieldPupil.y);		const float fGrowth = 1.0 + vDofFieldPupil.z * fFieldR + abs(vDofFieldPupil.w) * fFieldR * fFieldR;		OUT.Field = float4(vField, 1.0 / max(fTransmission, 0.05), fGrowth);		OUT.QuadPos.xy *= fGrowth;	}	const float2 Verts[6] =	{		float2( 1,  1),		float2(-1,  1),		float2( 1, -1),		float2( 1, -1),		float2(-1,  1),		float2(-1, -1)	};	OUT.Position.xy += Verts[nVertexID % 6].xy * OUT.QuadPos.xy;	OUT.QuadPos = float4(Verts[nVertexID % 6].xy * 0.5 + 0.5, OUT.QuadPos.zw);	return OUT;}technique DofBokehGhost{  pass p0  {    VertexShader = DofBokehGhostVS() PostMotionBlurVS;    PixelShader = DofBokehRefPS() PostMotionBlurPS;    CullMode = None;  }}Texture2D texDofNrm_DofLayer0   : register(t0);Texture2D texDofNrm_DofLayer1   : register(t1);Texture2D texDofNrm_DepthTarget : register(t3);SamplerState ssDofNrm_DofLayer0   : register(s0);SamplerState ssDofNrm_DofLayer1   : register(s1);SamplerState ssDofNrm_DepthTarget : register(s3);pixout RefDofMBNormalizePS(vtxOut IN){	pixout OUT = (pixout) 0;	half fDepth = GetTexture2D(texDofNrm_DepthTarget, ssDofNrm_DepthTarget, IN.baseTC.xy).x * PS_NearFarClipDist.y;	// The splat layers are full resolution now, so this is a straight 1:1 read. The half pixel	// offset and the four tap average that used to be here existed only to hide the bilinear	// magnification of a half resolution layer, and would blur away exactly the silhouette	// sharpness that rasterizing at native resolution just bought.	half4 cLayerNear = GetTexture2D(texDofNrm_DofLayer0, ssDofNrm_DofLayer0, IN.baseTC.xy);	half4 cLayerFar  = GetTexture2D(texDofNrm_DofLayer1, ssDofNrm_DofLayer1, IN.baseTC.xy);	// The splat layer is an overlay on an already gathered frame, so it is ADDED rather than	// blended against a sharp scene. Background splats are masked by how out of focus the	// DESTINATION pixel is, which is what stops a distant highlight bleeding over an in-focus	// object standing in front of it. Foreground splats are added unmasked - an out of focus	// foreground highlight is supposed to wash over whatever is behind it.#if %_RT_SAMPLE2	// Lens mode: mask the far splats by exactly the sharpness the composite blended the far	// LAYER with, or the sprite and the halo under it disagree about where the focus zone ends.	float4 vLensNear, vLensFar;	LensModelCoC(fDepth.xxxx, LensFieldRadius2(IN.baseTC.xy), vLensNear, vLensFar);	const half fFarMask = (half)LensFarBlend(vLensFar.x, PS_ScreenSize.xy);#else	half4 vFocusRanges = saturate( half4(fDepth.xxxx ) * vDofParamsFocus0.xzxz + vDofParamsFocus0.ywyw );	vFocusRanges.x *= vFocusRanges.x;	const half fFarMask = saturate( vFocusRanges.x * vDofParamsFocus1.w );#endif	OUT.Color = float4(cLayerNear.rgb + cLayerFar.rgb * fFarMask, 0);	return OUT;}technique RefDofMbNormalizePass{  pass p0  {    VertexShader = FullscreenTriVS() PostMotionBlurVS;    PixelShader = RefDofMBNormalizePS() PostMotionBlurPS;    CullMode = None;  }}/////////////////////////////////////////////////////////////////////////////////////////////////// Lens ghost composite (LensGhostSpec.md, "Pipeline placement")//// The ghosts accumulate into a layer of their own instead of riding the splat layers, because// the pass above runs INSIDE the depth of field stage and everything it adds to the HDR target// is still a light source for the glare family that thresholds that target afterwards. A ghost// is a second-order internal reflection; a flare struck off one would be third order and// invisible. So this - a straight additive blit of the layer, no threshold, no depth, no mask -// runs later, once the streaks, the anamorphic flare, the filter PSF and halation have taken// their sources. Alpha is left at 0 exactly as the splat overlay leaves it./////////////////////////////////////////////////////////////////////////////////////////////////pixout DofGhostCompositePS(vtxOut IN){	pixout OUT = (pixout) 0;	OUT.Color = float4(GetTexture2D(texDofNrm_DofLayer0, ssDofNrm_DofLayer0, IN.baseTC.xy).rgb, 0);	return OUT;}technique DofGhostComposite{  pass p0  {    VertexShader = FullscreenTriVS() PostMotionBlurVS;    PixelShader = DofGhostCompositePS() PostMotionBlurPS;    CullMode = None;  }}/////////////////////////////////////////////////////////////////////////////////////////////////// Gather-Based DOF/////////////////////////////////////////////////////////////////////////////////////////////////void ComputeCircleOfConfusion(in float4 depths, in float fFieldR2, out float4 nearCoC, out float4 farCoC){	// Petzval field curvature: the focal surface is not flat, so with the centre in focus a point	// at the edge of the field images as though it stood at a different distance. Scaling the	// depth rather than shifting the focus plane is what keeps the error proportional to	// distance, which is what a curved surface does in object space. Positive = the edges focus	// closer than the centre. Its visibility rides the circle of confusion like any focus error,	// so stopping down hides it by itself.	float4 depthsF = depths * (1.0 + vDofFieldPupil2.z * fFieldR2);	// The minimum-Z near blur deliberately keeps the RAW depths: it is a camera-body near-clip	// effect, not something the glass does, so the curved focal surface must not bend it.	float4 FocusRangeNearMin = vDofParamsFocus1.y * saturate(1 - (depths / vDofParamsFocus1.x)) ;	float4 vCocFar = saturate(depthsF * vDofParamsFocus0.x + vDofParamsFocus0.y);	float4 vCocNear = saturate(depthsF * vDofParamsFocus0.z + vDofParamsFocus0.w) + FocusRangeNearMin;		farCoC = vCocFar * vCocFar * vDofParamsFocus1.w;	nearCoC = vCocNear * vCocNear * vDofParamsFocus1.w;	farCoC = max(farCoC, 0.00001);	// Residual off-axis aberration blur: even an edge that IS in focus stays soft wide open.	// A far-layer floor on purpose - the edge then blends behind the near layer the way a	// blurred background does, where a near-layer floor would wash edge objects over the sharp	// centre. The coefficient already carries the square of the pupil radius, so the softness	// disappears on stopping down without a separate aperture link.	farCoC = max(farCoC, vDofFieldPupil2.w * fFieldR2);		farCoC = clamp(farCoC, -4, 4);	nearCoC = clamp(nearCoC, -4, 4);}float w0(float a){	return (1.0/6.0)*(a*(a*(-a + 3.0) - 3.0) + 1.0);}float w1(float a){	return (1.0/6.0)*(a*a*(3.0*a - 6.0) + 4.0);}float w2(float a){	return (1.0/6.0)*(a*(a*(-3.0*a + 3.0) + 3.0) + 1.0);}float w3(float a){	return (1.0/6.0)*(a*a*a);}// g0 and g1 are the two amplitude functionsfloat g0(float a){	return w0(a) + w1(a);}float g1(float a){	return w2(a) + w3(a);}// h0 and h1 are the two offset functionsfloat h0(float a){	return -1.0 + w1(a) / (w0(a) + w1(a));}float h1(float a){	return 1.0 + w3(a) / (w2(a) + w3(a));}float4 tex2D_bicubic(Texture2D tex, SamplerState samp, float2 uv, float2 res){	uv = uv * res + 0.5;	float2 iuv = floor( uv );	float2 fuv = frac( uv );	float g0x = g0(fuv.x);	float g1x = g1(fuv.x);	float h0x = h0(fuv.x);	float h1x = h1(fuv.x);	float h0y = h0(fuv.y);	float h1y = h1(fuv.y);	float2 p0 = (float2(iuv.x + h0x, iuv.y + h0y) - 0.5) / res;	float2 p1 = (float2(iuv.x + h1x, iuv.y + h0y) - 0.5) / res;	float2 p2 = (float2(iuv.x + h0x, iuv.y + h1y) - 0.5) / res;	float2 p3 = (float2(iuv.x + h1x, iuv.y + h1y) - 0.5) / res;	return g0(fuv.y) * (g0x * GetTexture2D(tex, samp, p0)  + g1x * GetTexture2D(tex, samp, p1)) + g1(fuv.y) * (g0x * GetTexture2D(tex, samp, p2) + g1x * GetTexture2D(tex, samp, p3));}Texture2D<float4> DnScDoF_Depth            : register(t0);SamplerState DnScDoF_DepthSamp             : register(s0);  //PointClampTexture2D<float4> DnScDoF_HDRTarg          : register(t1);SamplerState DnScDoF_HDRTargSamp           : register(s1);  //LinearClampstruct vtxOutDownscaleDof{	float4 HPosition  : SV_POSITION;	float4 tc0 : TEXCOORD0;	float4 tc1 : TEXCOORD1;	float4 tc2 : TEXCOORD2;	float4 tc3 : TEXCOORD3;	float4 tc4 : TEXCOORD4;	float4 tc5 : TEXCOORD5;	float4 tc6 : TEXCOORD6;};vtxOutDownscaleDof DownscaleDofVS(uint VertexID : SV_VertexID){	vtxOutDownscaleDof OUT = (vtxOutDownscaleDof)0; 	OUT.HPosition = GetHPos_FromTriVertexID(VertexID);	float2 baseTC = GetBaseTC_FromTriVertexID(VertexID);		OUT.tc0 = baseTC.xyxy + float4(-1, -1,  1,  1) * g_VS_ScreenSize.zwzw * 0.5;	OUT.tc1 = baseTC.xyxy + float4( 1, -1, -1,  1) * g_VS_ScreenSize.zwzw * 0.5;	OUT.tc3 = baseTC.xyxy + float4(-1,  0,  1,  0) * g_VS_ScreenSize.zwzw;	OUT.tc4 = baseTC.xyxy + float4( 0, -1,  0,  1) * g_VS_ScreenSize.zwzw;	OUT.tc5 = baseTC.xyxy + float4( 1,  1, -1, -1) * g_VS_ScreenSize.zwzw;	OUT.tc6 = baseTC.xyxy + float4(-1,  1,  1, -1) * g_VS_ScreenSize.zwzw;	OUT.tc2.xy = baseTC.xy;	return OUT;}struct OutDownscaleDof{	float4 LayerNear  : SV_Target0;	float4 LayerFar   : SV_Target1;		float2 CocNearFar : SV_Target2;};OutDownscaleDof DownscaleDofPS(vtxOutDownscaleDof IN){		OutDownscaleDof OUT = (OutDownscaleDof) 0;		float4 depths = float4(GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc5.xy).x,		GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc5.zw).x,		GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc6.xy).x,		GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc6.zw).x);	// todo: use gather4	depths *= PS_NearFarClipDist.y;	float4 c = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc2.xy).rgb, 1);	float4 c0 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc0.xy).rgb, 1);	float4 c1 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc0.zw).rgb, 1);	float4 c2 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc1.xy).rgb, 1);	float4 c3 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc1.zw).rgb, 1);	// The circle of confusion is resolved BEFORE the colour in lens mode: how much of a	// highlight this pass may keep depends on whether the sprite is going to carry it, and	// that is a function of the disc's size. In the stock permutation the two are independent	// and the order is immaterial.	float4 vCocNear, vCocFar;#if %_RT_SAMPLE2	LensModelCoC(depths, LensFieldRadius2(IN.tc2.xy), vCocNear, vCocFar);#else	ComputeCircleOfConfusion(depths, LensFieldRadius2(IN.tc2.xy), vCocNear, vCocFar);#endif#if %_RT_SAMPLE2	// Energy split with the hybrid splat (spec 3.3). This pass's copy of vDofBokehHighlight is	// packed for the split rather than for the sprite - the splat pass is a different draw with	// its own constant update, so the two never collide:	//   x = highlight threshold, y = soft knee half width  (identical to the sprite's)	//   z = the circle of confusion at which a sprite reaches full strength (r_DofSpriteBokehFadeCoC)	//   w = 1 when the splat is actually running (r_DepthOfFieldMode 0), else 0.	//	// With the splat off the gather is the ONLY thing carrying light and must keep every texel	// whole. With it on, the gather hands the excess over - but only in proportion to the fade	// the sprite itself applies, or a highlight too small to be splatted would lose its excess	// to nobody. The fade here is read from this pixel's own circle of confusion; the sprite	// reads the once-dilated tile copy, which is never smaller, so any disagreement leaves a	// sliver of excess in the gather rather than counting it twice.	{		const float fThreshold = vDofBokehHighlight.x;		const float fKnee      = max(vDofBokehHighlight.y, 1e-4);		const float fFadeFull  = max(vDofBokehHighlight.z, 1e-3);		const float fCocHere   = max(max(max(vCocNear.x, vCocNear.y), max(vCocNear.z, vCocNear.w)),		                             min(min(vCocFar.x, vCocFar.y), min(vCocFar.z, vCocFar.w)));		const float fHandOver  = vDofBokehHighlight.w * smoothstep(fFadeFull * 0.333, fFadeFull, fCocHere);		// Per sample, before the average: see LensHighlightExcess.		const float fL  = GetWorkingLuminance(c.rgb);		const float fL0 = GetWorkingLuminance(c0.rgb);		const float fL1 = GetWorkingLuminance(c1.rgb);		const float fL2 = GetWorkingLuminance(c2.rgb);		const float fL3 = GetWorkingLuminance(c3.rgb);		// Hue preserving, exactly like the sprite's: the texel rescaled so its luminance is		// what is left after the sprite's share is removed.		c.rgb  *= (fL  - fHandOver * LensHighlightExcess(fL,  fThreshold, fKnee)) / max(fL,  1e-4);		c0.rgb *= (fL0 - fHandOver * LensHighlightExcess(fL0, fThreshold, fKnee)) / max(fL0, 1e-4);		c1.rgb *= (fL1 - fHandOver * LensHighlightExcess(fL1, fThreshold, fKnee)) / max(fL1, 1e-4);		c2.rgb *= (fL2 - fHandOver * LensHighlightExcess(fL2, fThreshold, fKnee)) / max(fL2, 1e-4);		c3.rgb *= (fL3 - fHandOver * LensHighlightExcess(fL3, fThreshold, fKnee)) / max(fL3, 1e-4);	}#endif	OUT.LayerNear = (c+c0 + c1 + c2 + c3) * 0.2;	OUT.LayerFar = OUT.LayerNear;	OUT.LayerNear.a = max(vCocNear.x, vCocNear.y);	OUT.LayerNear.a = max(OUT.LayerNear.a, vCocNear.z);	OUT.LayerNear.a = max(OUT.LayerNear.a, vCocNear.w); 		OUT.LayerFar.a = min(vCocFar.x, vCocFar.y);	OUT.LayerFar.a = min(OUT.LayerFar.a, vCocFar.z);	OUT.LayerFar.a = min(OUT.LayerFar.a, vCocFar.w);	OUT.CocNearFar = float2(OUT.LayerNear.a, OUT.LayerFar.a);#if %_RT_SAMPLE2	// Lens mode keeps the near layer's alpha as the TRUE circle of confusion, unsaturated: the	// energy gather below needs to know how far each tap's own disc reaches, and a foreground	// two units out of focus is not the same tap as one at ten. Nothing downstream wants the	// clamped version any more - the near layer's opacity is computed from the pupil instead	// (spec 3.3) and the composite reads that.	//	// And no premultiply by the CoC. That multiply was the stock proxy for "how much of this	// pixel's light actually reaches its neighbours", which is precisely the coverage term the	// gather now computes per tap; doing both would darken every disc by its own radius twice.	// The layers therefore carry STRAIGHT colour and the composite does not unpremultiply.#else	// Clamp for proper masking later (avoids "super strong" edges on very blurry foreground objects).	OUT.LayerNear.a = saturate(OUT.LayerNear.a);	// Scale with CoC to avoid leaking of sharper details.	OUT.LayerFar.rgb *= (OUT.LayerFar.a);	OUT.LayerNear.rgb *= (OUT.LayerNear.a);#endif	return OUT;}technique DownscaleDof{  pass p0  {    VertexShader = DownscaleDofVS();    PixelShader = DownscaleDofPS();    CullMode = None;          }}//////////////////////////////////////////////////////////////////////////////////////////////////Texture2D<float4> TMCoC_SCoC          : register(t0);SamplerState TMCoC_SCoCSamp           : register(s0);  //LinearClampstruct OutTileMinCoC{	float2 CocNearFar : SV_Target0;};vtxOutDownscaleDof TileMinCoCVS(uint VertexID : SV_VertexID){	vtxOutDownscaleDof OUT = (vtxOutDownscaleDof)0; 	OUT.HPosition = GetHPos_FromTriVertexID(VertexID);	float2 baseTC = GetBaseTC_FromTriVertexID(VertexID);		OUT.tc0 = baseTC.xyxy + float4(-1,  0, 1,  0) * vDofParamsFocus1.zwzw;	OUT.tc1 = baseTC.xyxy + float4( 0, -1, 0,  1) * vDofParamsFocus1.zwzw;	OUT.tc2 = baseTC.xyxy + float4(-1, -1, 1,  1) * vDofParamsFocus1.zwzw;	OUT.tc3 = baseTC.xyxy + float4(-1,  1, 1, -1) * vDofParamsFocus1.zwzw;	return OUT;}OutTileMinCoC TileMinCoCPS(vtxOutDownscaleDof IN){		OutTileMinCoC OUT = (OutTileMinCoC) 0;	float2 coc0 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc0.xy).rg);	float2 coc1 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc0.zw).rg);	float2 coc2 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc1.xy).rg);	float2 coc3 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc1.zw).rg);	float2 coc4 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc2.xy).rg);	float2 coc5 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc2.zw).rg);	float2 coc6 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc3.xy).rg);	float2 coc7 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc3.zw).rg);	OUT.CocNearFar.r = max(coc0.rg, max(coc1, max(coc2, coc3))).r; // direction is inverted, take max	OUT.CocNearFar.g = min(coc0.rg, min(coc1, min(coc2, coc3))).g;	OUT.CocNearFar.r = max(OUT.CocNearFar.rg, max(coc4, max(coc5, max(coc6, coc7)))).r; // direction is inverted, take max	OUT.CocNearFar.g = min(OUT.CocNearFar.rg, min(coc4, min(coc5, min(coc6, coc7)))).g;	return OUT;}technique TileMinCoC{  pass p0  {    VertexShader = TileMinCoCVS();    PixelShader = TileMinCoCPS();    CullMode = None;          }}//////////////////////////////////////////////////////////////////////////////////////////////////Texture2D<float4> DOF_Depth          : register(t0);Texture2D<float4> DOF_CoCM           : register(t4);SamplerState DOF_PCSamp              : register(s0);  //PointClampTexture2D<float4> DOF_HDRDoF0        : register(t1);Texture2D<float4> DOF_HDRDoF1        : register(t2);SamplerState DOF_LCSamp              : register(s1);  //LinearClamp// Sized to the LARGEST kernel any permutation uses: 11x11 = 121 taps for the lens model's first// iteration, 7x7 = 49 for the stock one, 3x3 for the second iteration in both. The count in use// arrives per pass in vDofParamsFocus1.z and the loops below run exactly that many, so the stock// permutation still reads its own 49 taps and nothing else - only the reserved space grew.// .xy = the tap in pupil space (polygon mapped, anamorphically narrowed);// .z  = the iris polygon's radius at that tap's angle, the ceiling the jitter below is clamped//       back to so a per-pixel offset can roughen the INTERIOR without softening the outline.float4 g_Taps[11*11];// Per-pixel, per-tap stratified jitter (lens mode). 121 taps spread over a large disc are still// 121 discrete copies of the source - the "several circles trying to form a triangle" - because// every pixel samples the source at the SAME 121 places. Offsetting each tap inside its own cell// by a per-pixel amount turns that structure into noise, which the temporal AA then resolves into// the smooth disc the taps were supposed to be approximating.//// The offset is applied in PUPIL space and clamped back inside the iris polygon: jittering the// kernel as a whole (a rotation or a common translation) would blur the polygon's outline, which// is the one part of the shape worth keeping exact. fIGN is the pixel's own pair of hashes,// resolved once outside the loops; the R2 low-discrepancy increments decorrelate the taps from// each other without another hash per tap.float2 LensTapJitter(float2 x, float fPolyRad, float2 fIGN, float fTap, float fAmp){	const float2 vJit = (frac(fIGN + fTap * float2(0.7548776662, 0.5698402909)) - 0.5) * fAmp;	float2 xj = x + vJit;	const float fRj = length(xj);	// A tap may not leave the opening it came through. fPolyRad is the polygon's radius at the	// unjittered angle, which is within a jitter of the right one and costs nothing here.	return (fRj > fPolyRad) ? xj * (fPolyRad / max(fRj, 1e-5)) : xj;}struct pixout_dof{	float4 LayerNear  : SV_Target0;		float4 LayerFar   : SV_Target1;			float2 CocNearFar : SV_Target2;		};pixout_dof DofPS(vtxOut IN){	pixout_dof OUT = (pixout_dof) 0;	const int nNumTaps = vDofParamsFocus1.z;	float2 fCocScale = PS_ScreenSize.zw * 2.0;		// Rescale (tweaked to be compatible with Sprite DOF)	float scale = max(PS_ScreenSize.x / 1920, PS_ScreenSize.y / 1080) * 4;	fCocScale *= scale;	// Field-dependent pupil. The field vector runs from 0 at the frame centre to 1 at the	// corners, so every term below is written for the corner and scales in from there. The	// stock radial tap squash that used to live here (fOptVignettingAmount = 0.2) was Crytek's	// own crude approximation of exactly this effect and has been removed - keeping it would	// stack two versions of the same thing.	const float fFieldAspect = PS_ScreenSize.x / max(PS_ScreenSize.y, 1.0);	const float2 vField = (IN.baseTC.xy * 2 - 1) * float2(fFieldAspect, 1.0) * rsqrt(fFieldAspect * fFieldAspect + 1.0);	const float fFieldR = length(vField);	// At the exact centre the radial direction is undefined; every field term carries a factor	// of fFieldR or its square, so any unit vector gives the same (vanishing) result.	const float2 vFieldU = (fFieldR > 1e-4) ? (vField / fFieldR) : float2(1, 0);	const float2 vFieldT = float2(-vFieldU.y, vFieldU.x);	const float2 vBarrelC = -vFieldU * (vDofFieldPupil.x * fFieldR);	const float fSqueezeS = max(vDofFieldPupil2.x, 1.0);	const float fComaK = vDofFieldPupil.z * fFieldR;	const float fAstigA = vDofFieldPupil.w * fFieldR * fFieldR;   // signed per layer below	// Axial chromatic aberration: the radius, in pupil units, of the disc the SHRUNK channels	// convolve with. Rather than three gathers, every tap keeps the layer's kernel and its	// colour is masked per channel - a channel whose disc is smaller simply does not accept	// taps outside its own radius, and the per-channel weight sum below renormalises what it	// did accept. Same result, a few multiplies instead of a second and third kernel.	const float fAxialS = vDofAxialChromatic.x;#if %_RT_SAMPLE0 || %_RT_SAMPLE1	fCocScale *= 0.15;#endif	float4 cCenterTapNear = GetTexture2DLod(DOF_HDRDoF0, DOF_LCSamp, float4(IN.baseTC.xy, 0, 0));	float4 cCenterTapFar = GetTexture2DLod(DOF_HDRDoF1, DOF_LCSamp, float4(IN.baseTC.xy, 0, 0));	float fCocNear = cCenterTapNear.w;	float fCocFar = cCenterTapFar.w;#if %_RT_SAMPLE0 || %_RT_SAMPLE1		float4 cAccNear = float4(0,0,0,0);	float4 caccNear = 0;	float4 cAccFar = float4(0,0,0,fCocFar);	float4 caccFar = 0;	OUT.LayerFar = cCenterTapFar;	OUT.LayerNear = cCenterTapNear;#else	// The weight accumulators carry one lane per colour channel plus alpha: with a per-channel	// tap mask each channel takes a different subset of the taps, so each has to be normalised	// over the weight IT accumulated. .a keeps the unmasked sum, which is what the alpha (the	// circle of confusion the layer carries onward) has always been averaged by.	float4 cAccNear = float4(0,0,0,0);	float4 caccNear = 0;	float4 cAccFar = float4(0,0,0,0);	float4 caccFar = 0;#endif#if %_RT_SAMPLE2 && !%_RT_SAMPLE0 && !%_RT_SAMPLE1	// Near-layer opacity, spec 3.3: the pupil-weighted fraction of the rays arriving at this	// pixel that came off the FOREGROUND. In a uniformly blurred foreground every ray does and	// it is 1; at the edge of a blurred foreground over a sharp background it falls off as the	// true fraction of the pupil that still sees the object - which is what partial occlusion	// physically is, rather than the heuristic the stock path approximates it with.	float fNearAlphaNum = 0;	float fNearAlphaDen = 0;#endif	const float2 vMinTileCoC = (GetTexture2DLod(DOF_CoCM, DOF_PCSamp, float4(IN.baseTC.xy, 0, 0)).rg);#if %_RT_SAMPLE2	// The gather's OWN reach cap. The circle of confusion arriving from the texture is the	// physical one (it has to be - the sprite is sized from it), but a fixed tap count cannot	// resolve a disc of any size, so everything the KERNEL derives from a CoC - how far it	// reaches, whether a tap's disc covers this pixel, and how thinly that tap's light was	// spread - is taken from the capped copy. The light beyond the cap is the splat's to carry.	const float fGatherCap = abs(vDofLensModel.z);	const float fNearReach = min(vMinTileCoC.r, fGatherCap);	const float fFarReach  = min(fCocFar, fGatherCap);	// The pixel's own pair of hashes for the tap jitter, resolved once. Interleaved gradient	// noise: a screen-space pattern that decorrelates neighbours at every scale and costs one	// dot product, which is what a 121-tap loop can afford.	const float2 vPixIGN = IN.baseTC.xy * PS_ScreenSize.xy;	float2 fIGN = frac(52.9829189 * frac(float2(0.06711056 * vPixIGN.x + 0.00583715 * vPixIGN.y,	                                            0.06711056 * vPixIGN.y + 0.00583715 * vPixIGN.x)));	// Per-FRAME phase, without which the whole exercise is pointless: a jitter that depends on	// the pixel alone is fixed-pattern noise, and fixed-pattern noise is the one thing temporal	// AA cannot average away - every frame it accumulates the identical error. Advancing the	// phase along the golden-ratio sequence (each lane by its own increment, so the two do not	// walk in step) gives TSAA a different member of the sample set each frame, which is what	// turns 121 taps into a smooth disc instead of 121 stable copies. vDofLensModel2.z is the	// frame counter from the CPU, already wrapped; 0 there freezes the pattern for A/B.	fIGN = frac(fIGN + frac(vDofLensModel2.z * float2(0.61803398875, 0.38196601125)));	const float fJitAmp = vDofLensModel2.y;#else	const float fNearReach = vMinTileCoC.r;	const float fFarReach  = fCocFar;#endif	// note - on nvidia getting better perf with single branch outside loops. on amd the oposite	[branch] if (vMinTileCoC.r>0.0)	{		[loop] for(int t = 0; t < nNumTaps; t ++)		{				const float2 offset = g_Taps[t].xy;			// Pupil space: undo the anamorphic narrowing the CPU already baked into the tap, so			// the barrel and the aberrations act on the round pupil they are defined on.			const float2 x = float2(offset.x * fSqueezeS, offset.y);			// The aperture: this ray only exists if it clears the mechanical opening. Soft edged			// so the clipped silhouette does not alias from one tap to the next.			const float clipW = saturate((vDofFieldPupil.y - length(x - vBarrelC)) / 0.08 + 0.5);#if %_RT_SAMPLE2 && !%_RT_SAMPLE0 && !%_RT_SAMPLE1			// Stratified jitter, first iteration only: the second one is a hole-filling dilate,			// not a sampling of the disc, and has nothing to stratify.			const float2 xj = LensTapJitter(x, g_Taps[t].z, fIGN, (float)t, fJitAmp);#else			// Identical to x in every other permutation, so the stock kernel is untouched.			const float2 xj = x;#endif			// Near layer sits on the opposite side of focus from the far layer, so its			// astigmatic ellipse is the far layer's turned by 90 degrees - hence the minus.			const float aNear = -fAstigA;			float2 xn = vFieldU * dot(xj, vFieldU) * (1 + aNear) + vFieldT * dot(xj, vFieldT) * (1 - aNear);			xn += vFieldU * (fComaK * dot(xj, xj));			float2 cocOffset = fNearReach * fCocScale * float2(xn.x / fSqueezeS, xn.y);			float4 cn = GetTexture2DLod(DOF_HDRDoF0, DOF_LCSamp, float4(IN.baseTC.xy + cocOffset, 0, 0));			const float k = 1.075;			float wn = (cn.w >= vMinTileCoC.r * k) ? 1 : saturate(vMinTileCoC.r * k - cn.w);			// The clip reshapes the kernel only: the renormalisation by accumulated weight below			// keeps the brightness, because the light the barrel eats is applied once in the			// tonemap vignette instead (FieldPupilSpec.md section 2.3).			wn *= clipW;			// Per-channel disc: in FRONT of focus it is green that focuses short, so green			// alone is masked to the smaller radius and the rim left over reads magenta. rho is			// the tap's radius in the unsqueezed pupil BEFORE coma and astigmatism - the mask			// is a property of the aperture, like the barrel clip, not of the deformation.			// One-sided and outward, so at s = 1 every tap of the unit pupil masks to exactly 1.			const float mn = saturate((fAxialS - length(x)) / 0.08 + 1);#if !%_RT_SAMPLE2			cn.rgb *= float3(1, mn, 1);#endif#if %_RT_SAMPLE0 || %_RT_SAMPLE1			// The max path ignores wn entirely, so the clip has to reach the colour itself.			cAccNear = max(cAccNear, cn * clipW);#elif %_RT_SAMPLE2			// Scatter-as-gather. Each tap is a POINT that threw a disc of its own; this pixel			// gets a share of that point's light only if the disc actually reaches here			// (coverage), and the share is the point's light divided by the area it was spread			// over (density). That single change is what makes a bright point dim as it goes			// further out of focus instead of staying a flat plate, and it is what lets the			// splat be a refinement of the same quantity rather than a second energy system.			{				// The tap's distance from this pixel, in the same units its CoC is expressed				// in - measured on the SQUEEZED offset, because that is where it really landed.				const float fTapR = fNearReach * length(float2(xn.x / fSqueezeS, xn.y));				// Capped: coverage and density describe the disc the GATHER is drawing, which is				// the clipped one. cn.w itself stays physical and is what the layer's alpha - and				// therefore the sprite's size - is averaged from.				const float fTapCoC = min(cn.w, fGatherCap);				// Soft over a quarter unit (~1 px): a hard coverage test aliases into rings.				const float fCov = saturate((fTapCoC - fTapR) / 0.25 + 0.5);				const float fCocD = max(fTapCoC, 0.125);				const float fDens = 1.0 / (fCocD * fCocD);				// The near LAYER is the image formed by foreground points, and by nothing else.				// Without this the sharp background sitting one tap away - whose own disc is				// tiny, so its density is enormous - would dominate the layer's colour, and the				// foreground would then be composited over the background as a picture OF the				// background: a blurred edge that spills nothing.				const float fIsNear = (fTapCoC > 0.01) ? 1.0 : 0.0;				const float4 vPupil = LensPupil(xj, vBarrelC, -1.0, fAxialS);				const float4 wLens = (fCov * fIsNear * fDens) * vPupil;				cAccNear += float4(cn.rgb * wLens.rgb, cn.w * wLens.a);				caccNear += wLens;				// Opacity: the pupil-weighted fraction of the rays arriving here that came off				// the foreground. The denominator is the WHOLE pupil, including the rays that				// saw past the object - those are exactly what makes a blurred edge translucent				// rather than a hard cut.				//				// The numerator is weighted by DENSITY relative to the reach disc, and that is				// not cosmetic. The taps are spread over a disc of radius R = fNearReach, which				// is the TILE MAXIMUM circle of confusion, dilated along the tile chain. A				// foreground point whose own disc is c_i spreads its light over pi*c_i^2, not				// pi*R^2, so counting covering taps as a fraction of all taps in the reach disc				// only measures the pupil fraction when c_i == R. Whenever the tile maximum came				// from a closer object or from the dilation at an edge - which is most of the				// time - the count is low by (c_i/R)^2 and the foreground composites in too				// transparent. (R/c_i)^2 puts it back: a uniform foreground at c_i = R is				// unchanged, and at c_i = R/2 the quarter as many taps that still cover are each				// worth four times as much, so alpha lands where it would if R had been c_i.				const float fNearDensity = (fNearReach * fNearReach) / (fCocD * fCocD);				fNearAlphaNum += fCov * fIsNear * vPupil.a * fNearDensity;				fNearAlphaDen += vPupil.a;			}#else			cAccNear += cn*wn;			caccNear += wn * float4(1, mn, 1, 1);#endif		}	}	//[branch] if (vMinTileCoC.g>=0.0)	{		[loop] for(int t = 0; t < nNumTaps; t ++)		{				const float2 offset = g_Taps[t].xy;			// Same pupil transform as the near loop, with the astigmatic ellipse the other way			// round: this is the far side of focus. See the near loop for the reasoning.			const float2 x = float2(offset.x * fSqueezeS, offset.y);			const float clipW = saturate((vDofFieldPupil.y - length(x - vBarrelC)) / 0.08 + 0.5);#if %_RT_SAMPLE2 && !%_RT_SAMPLE0 && !%_RT_SAMPLE1			const float2 xj = LensTapJitter(x, g_Taps[t].z, fIGN, (float)t, fJitAmp);#else			const float2 xj = x;#endif			const float aFar = fAstigA;			float2 xf = vFieldU * dot(xj, vFieldU) * (1 + aFar) + vFieldT * dot(xj, vFieldT) * (1 - aFar);			xf += vFieldU * (fComaK * dot(xj, xj));			float2 cocOffset = fFarReach * fCocScale * float2(xf.x / fSqueezeS, xf.y);			float4 cf = GetTexture2DLod(DOF_HDRDoF1, DOF_LCSamp, float4(IN.baseTC.xy + cocOffset, 0, 0));			float wf = (cf.w >= fCocFar) ? 1 : saturate( cf.w );			wf *= clipW;			// BEHIND focus red and blue are the pair that focuses short, so they take the			// smaller disc and green alone survives at the rim - the green fringe of fast and			// vintage glass. Alpha is left alone: it is the circle of confusion, not light.			const float mf = saturate((fAxialS - length(x)) / 0.08 + 1);#if !%_RT_SAMPLE2			cf.rgb *= float3(mf, 1, mf);#endif#if %_RT_SAMPLE0 || %_RT_SAMPLE1			cAccFar = max(cAccFar, cf*wf);#elif %_RT_SAMPLE2			// Same energy weights as the near loop, on the far side of focus. The reach here is			// the CENTRE pixel's own circle of confusion rather than a tile maximum (spec 5):			// a background disc therefore cannot spill over a LESS blurred background			// neighbour, which is the one honest limitation of doing this as a gather.			{				const float fTapR = fFarReach * length(float2(xf.x / fSqueezeS, xf.y));				// Capped for the same reason as the near loop: the gather's disc is the clipped				// one, cf.w stays physical so the alpha the splat reads is the real lens.				const float fTapCoC = min(cf.w, fGatherCap);				const float fCov = saturate((fTapCoC - fTapR) / 0.25 + 0.5);				const float fCocD = max(fTapCoC, 0.125);				const float fDens = 1.0 / (fCocD * fCocD);				const float4 vPupil = LensPupil(xj, vBarrelC, 1.0, fAxialS);				const float4 wLens = (fCov * fDens) * vPupil;				cAccFar += float4(cf.rgb * wLens.rgb, cf.w * wLens.a);				caccFar += wLens;			}#else			cAccFar += cf*wf;			caccFar += wf * float4(mf, 1, mf, 1);#endif		}	}#if !%_RT_SAMPLE0 && !%_RT_SAMPLE1	// Per channel, not per pixel: a channel that accepted no weight at all - fully masked out,	// or the whole kernel clipped away - falls back to the centre tap's own channel, exactly as	// the scalar version fell back for the whole pixel. The guard is per lane because the lanes	// no longer share a weight.	cAccNear = (caccNear > 0) ? cAccNear / max(caccNear, 1e-6) : cCenterTapNear;	cAccFar = (caccFar > 0) ? cAccFar / max(caccFar, 1e-6) : cCenterTapFar;#if %_RT_SAMPLE2	// The near layer's alpha is no longer a circle of confusion at all in lens mode - it is the	// fraction of the pupil that saw the foreground, i.e. exactly what the composite should	// blend this layer over the rest of the frame with. The far layer keeps its CoC, because	// the composite forms the far blend from the pixel's own depth instead.	cAccNear.a = (fNearAlphaDen > 1e-6) ? saturate(fNearAlphaNum / fNearAlphaDen) : 0.0;#endif#endif	OUT.LayerNear = cAccNear;	OUT.LayerNear.a = (OUT.LayerNear.a);	OUT.LayerFar = cAccFar;	OUT.LayerFar.a = (OUT.LayerFar.a);	OUT.CocNearFar.rg = (float2(OUT.LayerNear.a, OUT.LayerFar.a));	return OUT;}technique Dof{  pass p0  {    VertexShader = FullscreenTriVS() PostMotionBlurVS;    PixelShader = DofPS() HDRPostProcessPS;    CullMode = None;          }}//////////////////////////////////////////////////////////////////////////////////////////////////Texture2D<float4> CDOF_Depth         : register(t0);Texture2D<float4> CDOF_STarg         : register(t4);SamplerState CDOF_PCSamp             : register(s0);  //PointClampTexture2D<float4> CDOF_HDRDoF0       : register(t1);Texture2D<float4> CDOF_HDRDoF1       : register(t2);SamplerState CDOF_LCSamp             : register(s1);  //LinearClamppixout CompositeDofPS(vtxOut IN){	pixout OUT = (pixout) 0;	half4 cScene = GetTexture2D(CDOF_STarg, CDOF_PCSamp, IN.baseTC.xy);	half4 cLayerNear = tex2D_bicubic(CDOF_HDRDoF0, CDOF_LCSamp, IN.baseTC.xy, PS_ScreenSize.xy *0.5);	half4 cLayerFar = tex2D_bicubic(CDOF_HDRDoF1, CDOF_LCSamp, IN.baseTC.xy, PS_ScreenSize.xy *0.5);		float depth = GetTexture2D(CDOF_Depth, CDOF_PCSamp, IN.baseTC.xy).x * PS_NearFarClipDist.y;	float4 nearCoC, farCoC;#if %_RT_SAMPLE2	LensModelCoC(depth.xxxx, LensFieldRadius2(IN.baseTC.xy), nearCoC, farCoC);	// Sharp where the lens is sharp. The layers are half resolution, so ANY amount of them	// blended over an in-focus pixel costs it its native detail - the stock saturate(CoC) ramp	// starts eating the picture the moment the circle of confusion leaves zero, which is why	// the focus zone never read sharp. Hold the frame until the disc is bigger than the pixel	// it is supposed to be blurring, then hand over within another pixel and a half.	const half fFarBlend = (half)LensFarBlend(farCoC.x, PS_ScreenSize.xy);	// Straight colour on both layers: the downscale did not premultiply and the gather divided	// by its own weight, so there is nothing to undo here.	const half fNearBlend = saturate(cLayerNear.a);	OUT.Color = lerp(cScene, cLayerFar, fFarBlend);	OUT.Color = lerp(OUT.Color, cLayerNear, fNearBlend);	// DIAGNOSTIC (r_DepthOfFieldLensModelDebug, flagged by a negative cap): green = the frame	// the lens says is sharp, red = how much of the far layer replaced it, blue = the near	// layer's pupil opacity. If focus, the far ramp and the occlusion disagree, this shows it.	if (vDofLensModel.z < 0)		OUT.Color = float4(fFarBlend, saturate(1 - fFarBlend - fNearBlend), fNearBlend, 1);	return OUT;#else	ComputeCircleOfConfusion(depth.xxxx, LensFieldRadius2(IN.baseTC.xy), nearCoC, farCoC);	cLayerFar.rgb /= cLayerFar.a > 0 ? cLayerFar.a : 1.0f;	cLayerFar.a = saturate( farCoC.x );	cLayerNear.rgb = cLayerNear.rgb / (cLayerNear.a > 0 ? cLayerNear.a : 1.0f);	cLayerNear.a = saturate(cLayerNear.a);		OUT.Color = lerp(cScene, cLayerFar, cLayerFar.a);	OUT.Color = lerp(OUT.Color, cLayerNear, cLayerNear.a);	return OUT;#endif}technique CompositeDof{  pass p0  {    VertexShader = FullscreenTriVS() PostMotionBlurVS;    PixelShader = CompositeDofPS() HDRPostProcessPS;    CullMode = None;          }}