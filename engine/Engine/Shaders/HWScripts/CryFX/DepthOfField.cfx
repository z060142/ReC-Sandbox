// Copyright 2008-2021 Crytek GmbH / Crytek Group. All rights reserved.#include "Common.cfi"#include "ShadeLib.cfi"#include "PostEffectsLib.cfi"// Shader global descriptionsfloat Script : STANDARDSGLOBAL<  string Script =           "NoPreview;"           "LocalConstants;"           "ShaderDrawType = Custom;"           "ShaderType = PostProcess;">; /// Constants ////////////////////////////float4 vDofParamsFocus0;float4 vDofParamsFocus1;float4 vAspectRatio;half4 vRainColor;// Sprite bokeh shaping. x: iris blade count, y: polygon blend (0 = round/wide open,// 1 = fully formed polygon - same f/1.2 to f/2.8 window the gather kernel uses),// z: 1 when a shape texture is bound, w: iris phase in radians (shared with the streaks).float4 vDofBokehShape;// Sparse highlight selection for the hybrid splat layer. x: scene-HDR luminance threshold,// y: soft knee half width, z: energy gain of one splat, w: diagnostic flag.float4 vDofBokehHighlight;// Pupil = shape mask INTERSECT iris polygon, continuous at every f-number.// x: mask-look weight (0 = iris fill style, 1 = mask fill style; follows which hole is the//    smaller one), y: mask sampling scale = pupil bounding radius in mask units (1 while the//    mask is the smaller hole, N_mask/N once the iris is), z: iris polygon radius in quad//    units (N_mask/N while the mask bounds the pupil, 1 once the iris does),// w: circle of confusion at which a splat reaches full strength (fade-in, VS).float4 vDofBokehMask;/////////////////////////////////////////////////////////////////////////////////////////////////// Sprite-Based DOF/////////////////////////////////////////////////////////////////////////////////////////////////struct pixoutDofMRT{	half4 LayerNear  : SV_Target0;	half4 LayerFar   : SV_Target1;};// One quad per source pixel, expanded from SV_VertexID - there is no vertex stream at all,// so this is the only interpolator set the sprite path uses.struct v2fBokehQuad{	float4 Position  : SV_POSITION;	float4 QuadPos   : TEXCOORD0; //xy quad-local uv, z near blur, w unused	float4 Color     : TEXCOORD1;};Texture2D texDofBkRef_SceneTarget : register(t0);Texture2D texDofBkRef_SceneDepth  : register(t1);Texture2D texDofBkRef_Dither      : register(t2);Texture2D texDofBkRef_BokehShape  : register(t3);Texture2D texDofBkRef_CoC         : register(t4);  // gather's CoC: r = near (tile max), g = far (tile min)SamplerState ssDofBkRef_SceneTarget : register(s0);SamplerState ssDofBkRef_SceneDepth  : register(s1);SamplerState ssDofBkRef_Dither      : register(s2);SamplerState ssDofBkRef_BokehShape  : register(s3);// Radius of a regular n-gon at angle theta, normalized so the edge midpoints sit at 1.// Same closed form the gather kernel uses on the CPU (CDepthOfFieldStage::ToUnitDisk).float NGon_Rad(float theta, float n){	return cos(PI / n) / cos(theta - (2 * PI / n) * floor((n * theta + PI) / (2 * PI)));}v2fBokehQuad DofBokehRefVS(uint nVertexID : SV_VertexID){	v2fBokehQuad OUT = (v2fBokehQuad) 0;	// Resolve the quad's cell in the source grid with integer math. The original float	// modulo against g_VS_ScreenSize.x works today, but the quad id reaches several million	// and would start banding into columns once it leaves fp32's exact integer range.	const int nQuadID    = (int)(nVertexID / 6);	const int nGridWidth = (int)g_VS_ScreenSize.x;	float4 INPos = float4((float)(nQuadID % nGridWidth), (float)(nQuadID / nGridWidth), 0, 0);	INPos.xy /= g_VS_HPosScale.xy;	float4 vOutPos = INPos;  float4 vPos = INPos;		INPos.xy *= g_VS_ScreenSize.zw * 2.0;	INPos.xy += g_VS_ScreenSize.zw;	vOutPos = INPos;	vOutPos.xy =  vOutPos.xy *2 -1;	OUT.Position = float4(vOutPos.xy, 0, 1);//vWorldPos.z, fDepth); //mul(vpMatrix, vPos);  	float4 screenProj = HPosToScreenTC(OUT.Position);			// fetch scene color - output vertex/quad color	float fDepth = GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy, 0, 0)).x;	#if %_RT_SAMPLE1	// Dilate to avoid ghosting on edges due to lower resolution DOF	// This can cause artifacts in small cavities and on alpha-tested geometry	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2( vAspectRatio.w, vAspectRatio.w), 0, 0)).x);	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2(-vAspectRatio.w, vAspectRatio.w), 0, 0)).x);	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2( vAspectRatio.w,-vAspectRatio.w), 0, 0)).x);	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2(-vAspectRatio.w,-vAspectRatio.w), 0, 0)).x);#endif	OUT.QuadPos = 1;	fDepth *= g_VS_NearFarClipDist.y;	// Circle of confusion read from the gather's own CoC texture rather than recomputed from	// depth: the splat rides on top of the gather result, so it has to agree with the gather on	// how far out of focus this cell is - to the number, including the gather's 2x2 min (far)	// / max (near) and its tile dilation. Recomputing from a different depth source put the two	// a little apart at every edge, and that read as the splat lagging the halo.	const half2 vCocGather = GetTexture2DLod(texDofBkRef_CoC, ssDofBkRef_SceneDepth, float4(screenProj.xy, 0, 0)).rg;	half fCocNear = clamp(vCocGather.r, 0, 4);	half fCocFar  = clamp(vCocGather.g, 0, 4);	// DofPS turns a CoC into a tap radius with this scale; doubling it gives the diameter.	const half fCocScalePixels = max(g_VS_ScreenSize.x / 1920.0, g_VS_ScreenSize.y / 1080.0) * 4.0;	half fDepthBlur = max(fCocFar, fCocNear) * 2.0 * fCocScalePixels;	fDepthBlur = min(64, fDepthBlur);	// Amplitude in step with the gather. The gather's halo loses energy as a highlight nears	// focus (its taps are weighted by CoC), while an energy-conserving splat only gets	// brighter per pixel as its disc shrinks - left alone, a small sharp silhouette floats on	// an already-converged light and then vanishes in one frame at the cull below. Fade the	// splat in over [1/3, 1] x r_DepthOfFieldSpriteBokehFadeCoC instead: below a handful of	// pixels the shape is unresolvable anyway, and the gather already carries that light.	const half fFadeFull = max(vDofBokehMask.w, 1e-3);	const half fSplatFade = smoothstep(fFadeFull * 0.333, fFadeFull, max(fCocFar, fCocNear));	// Sub-pixel splats add nothing the gather has not already done, and cost a quad each.	if( fDepthBlur < 1.0 || fSplatFade <= 0.001 )	{		OUT.Position.xy=0;		return OUT;	}	OUT.QuadPos = max(1, fDepthBlur);	// lod blend weight	OUT.Color.w = ( sqrt(OUT.QuadPos.z) );	// Need to scale by pixel size	OUT.QuadPos.xy *= g_VS_ScreenSize.zw * 2.0;  // Scale by aspect ratio  OUT.QuadPos.xy *= vAspectRatio.xy;  // Anamorphic squeeze: the pupil image is compressed horizontally, so the quad - and the  // shape mask sampled through it - is too. QuadPos.w (the CoC in pixels) is left alone.  OUT.QuadPos.x *= vAspectRatio.z;	OUT.QuadPos.xy = max(g_VS_ScreenSize.zw * 2.0, OUT.QuadPos.xy);	OUT.QuadPos.z = saturate(fCocNear); // near blur, splits the splat between the two layers	// The grid cell's four NATIVE resolution texels: t0 is the full resolution scene copy,	// one grid texel spans 2x2 native texels, and zw is half a grid texel = one native texel,	// so +/-0.5*zw from the cell centre lands exactly on the four native texel centres.	// The old path sampled an already-downscaled copy and then averaged a further 2x2	// neighbourhood of it, so a small bright highlight was diluted by up to 16x BEFORE the	// threshold ever saw it - the splat survived but carried almost no excess energy, which	// is why the shapes only became readable once supersampling raised the internal	// resolution and undid the dilution by accident.	float4 vQuad[4] =	{		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2(-0.5, -0.5), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2( 0.5,  0.5), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2( 0.5, -0.5), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2(-0.5,  0.5), 0, 0)),	};	// Sparse highlight selection, PER TEXEL. The gather underneath has already spread the	// base energy, so only the EXCESS above a soft knee is splatted - but the knee has to be	// applied to each native texel BEFORE any averaging: max(0, x - t) is convex, so the	// excess of a mean is always less than the mean of the excesses, and a lone hot pixel in	// a dark cell used to read as a dim cell and lose its energy.	const half fThreshold = vDofBokehHighlight.x;	const half fKnee      = max(vDofBokehHighlight.y, 1e-4);	half fExcessSum = 0;	half3 cExcess = 0;	[unroll] for (int i = 0; i < 4; i++)	{		const half fLum = GetLuminance(vQuad[i].rgb);		// Quadratic knee across [threshold - knee, threshold + knee], linear above. A wide		// knee is what stops highlights popping as the aperture or focus sweeps past them.		half fSoft = clamp(fLum - fThreshold + fKnee, 0, 2 * fKnee);		fSoft = (fSoft * fSoft) / (4 * fKnee);		const half fExcess = max(fSoft, fLum - fThreshold);		// Hue preserving: this texel's colour rescaled so its luminance is exactly its excess.		cExcess += vQuad[i].rgb * (fExcess / max(fLum, 1e-4));		fExcessSum += fExcess;	}	// Mean over the cell keeps the old calibration for uniform areas (mean of excess equals	// excess of mean there) while a lone hot texel now keeps a quarter of its true excess	// instead of a sixteenth.	if (fExcessSum * 0.25 < 1e-4)	{		OUT.Position.xy=0;		return OUT;	}	OUT.Color.rgb = cExcess * 0.25 * fSplatFade;  const float2 Verts[6] =  {      float2( 1,  1),      float2(-1,  1),      float2( 1, -1),      float2( 1, -1),      float2(-1,  1),      float2(-1, -1)  };    OUT.Position.xy += Verts[nVertexID%6].xy * OUT.QuadPos.xy;  OUT.QuadPos = float4(Verts[nVertexID%6].xy*0.5+0.5, OUT.QuadPos.zw);	return OUT;}pixoutDofMRT DofBokehRefPS(v2fBokehQuad IN){	pixoutDofMRT OUT = (pixoutDofMRT) 0.0;	//clip(-1);	half2 tcQuad = IN.QuadPos.xy*2-1;	// -8 ms for big kernels	half fLen = (dot(tcQuad, tcQuad));	// Bare iris: the circular clip is the lens barrel. With a shape texture bound the pupil is	// the mask x polygon product below, which is zero outside itself - and the mask may own	// the quad's corners, so the barrel must not eat them.	clip( lerp(1 - fLen, 1.0, vDofBokehShape.z) );	//tcQuad*=1.1; // add slight border offset	fLen = (dot(tcQuad, tcQuad));	// Iris fill style: radial falloff plus the approximate diffusion ring.	half fShapeBokeh = pow(fLen, ((IN.Color.w))) ;// * fLen;  // ^2	half4 cIris = saturate(1-fShapeBokeh);  cIris += saturate(1-abs(fShapeBokeh*2-1));	// Iris polygon at the curvature-driven sharpening exponent (vDofBokehShape.y: 0 = circle,	// ~1 = the true polygon, 2+ = sharpened, 4 = caricature - the same exponent the gather	// kernel raises its taps by, so both views of the iris always agree), at radius	// vDofBokehMask.z in quad units.	const float fEdgeSoft = 0.06f;      // soft edge width, in quad-local radius	const float fRadius   = sqrt(max(fLen, 1e-6f));	const float fTheta    = atan2(tcQuad.y, tcQuad.x);	const float fPolyRad  = pow(NGon_Rad(fTheta - vDofBokehShape.w, max(vDofBokehShape.x, 3.0f)), vDofBokehShape.y) * vDofBokehMask.z;	const half  fPolyMask = saturate((fPolyRad - fRadius) / fEdgeSoft);	// PUPIL = mask INTERSECT iris. The mask (white when none is bound) is sampled at the pupil's	// bounding scale (vDofBokehMask.y), the polygon at its own radius; their product is the	// physical aperture at every f-number. Stopping the iris down through the mask clips the	// silhouette corner by corner and rounds it off progressively - the two apertures are two	// separate mechanisms, but the crossover between them is a continuous intersection.	const half fMaskVal = GetTexture2D(texDofBkRef_BokehShape, ssDofBkRef_BokehShape, (IN.QuadPos.xy - 0.5) * vDofBokehMask.y + 0.5).r;	const half fPupil   = fMaskVal * fPolyMask;	// Mask fill style: the pupil value field is the fill, and the soap-bubble diffusion ring	// rides the bilinear band where it crosses one half - the mask's outline inside the polygon,	// the polygon's edge where it clips the mask. A star gets a star-shaped ring.	const half4 cMaskLook = (half4)fPupil + saturate(1 - abs((1 - fPupil) * 2 - 1));	const half4 cIrisLook = cIris * fPupil;	// The fill style follows whichever hole is the smaller one (weight resolved on the CPU	// from N_mask / N); the geometry above is exact in both.	half4 cBokehShape = lerp(cIrisLook, cMaskLook, vDofBokehMask.x);	// Energy conserving deposit. QuadPos.w carries the CoC in pixels, so dividing by its area	// spreads a fixed amount of energy over the disc however large it grows - a highlight	// going further out of focus widens and dims instead of gaining brightness. The layer is	// added to the gathered frame, so there is no accumulated-weight average to divide by.	const half fCocPixels = max(IN.QuadPos.w, 1.0);	// The anamorphic oval covers CoC^2 * vAspectRatio.z pixels instead of CoC^2 (the quad was	// narrowed by that same factor in the VS), so the deposit is divided by the real area.	const half fSplatNorm = vDofBokehHighlight.z / (fCocPixels * fCocPixels * vAspectRatio.z);	half4 cScene = half4(IN.Color.rgb, 1);	cScene *= half4(cBokehShape.rgb, dot(cBokehShape.rgb, 0.333));	cScene *= fSplatNorm;	// DIAGNOSTIC (r_DofSpriteBokehDebug): ignore the scene colour and the area	// normalization and paint the silhouette itself, blazing. If the shape texture and the	// iris polygon reach this shader at all, this makes them impossible to miss.	if (vDofBokehHighlight.w > 0.5)		cScene = half4(cBokehShape.rgb, dot(cBokehShape.rgb, 0.333)) * 4.0;	// Background layer splats	OUT.LayerFar = cScene * saturate(1-IN.QuadPos.z);	// Foreground layer splats	OUT.LayerNear = cScene * saturate(IN.QuadPos.z);	// Apply dither pattern (minimize banding artefacts from accumulation/blending + aproximate lens particles)		half fDither = GetTexture2D(texDofBkRef_Dither, ssDofBkRef_Dither, IN.QuadPos.xy).w;	OUT.LayerFar += OUT.LayerFar * fDither;	OUT.LayerNear += OUT.LayerNear * fDither;	return OUT;}technique DofBokehRef{  pass p0  {    VertexShader = DofBokehRefVS() PostMotionBlurVS;    PixelShader = DofBokehRefPS() PostMotionBlurPS;    CullMode = None;          }}Texture2D texDofNrm_DofLayer0   : register(t0);Texture2D texDofNrm_DofLayer1   : register(t1);Texture2D texDofNrm_DepthTarget : register(t3);SamplerState ssDofNrm_DofLayer0   : register(s0);SamplerState ssDofNrm_DofLayer1   : register(s1);SamplerState ssDofNrm_DepthTarget : register(s3);pixout RefDofMBNormalizePS(vtxOut IN){	pixout OUT = (pixout) 0;	half fDepth = GetTexture2D(texDofNrm_DepthTarget, ssDofNrm_DepthTarget, IN.baseTC.xy).x * PS_NearFarClipDist.y;	// The splat layers are full resolution now, so this is a straight 1:1 read. The half pixel	// offset and the four tap average that used to be here existed only to hide the bilinear	// magnification of a half resolution layer, and would blur away exactly the silhouette	// sharpness that rasterizing at native resolution just bought.	half4 cLayerNear = GetTexture2D(texDofNrm_DofLayer0, ssDofNrm_DofLayer0, IN.baseTC.xy);	half4 cLayerFar  = GetTexture2D(texDofNrm_DofLayer1, ssDofNrm_DofLayer1, IN.baseTC.xy);	// The splat layer is an overlay on an already gathered frame, so it is ADDED rather than	// blended against a sharp scene. Background splats are masked by how out of focus the	// DESTINATION pixel is, which is what stops a distant highlight bleeding over an in-focus	// object standing in front of it. Foreground splats are added unmasked - an out of focus	// foreground highlight is supposed to wash over whatever is behind it.	half4 vFocusRanges = saturate( half4(fDepth.xxxx ) * vDofParamsFocus0.xzxz + vDofParamsFocus0.ywyw );	vFocusRanges.x *= vFocusRanges.x;	const half fFarMask = saturate( vFocusRanges.x * vDofParamsFocus1.w );	OUT.Color = float4(cLayerNear.rgb + cLayerFar.rgb * fFarMask, 0);	return OUT;}technique RefDofMbNormalizePass{  pass p0  {    VertexShader = FullscreenTriVS() PostMotionBlurVS;    PixelShader = RefDofMBNormalizePS() PostMotionBlurPS;    CullMode = None;          }}/////////////////////////////////////////////////////////////////////////////////////////////////// Gather-Based DOF/////////////////////////////////////////////////////////////////////////////////////////////////void ComputeCircleOfConfusion(in float4 depths, out float4 nearCoC, out float4 farCoC){	float4 FocusRangeNearMin = vDofParamsFocus1.y * saturate(1 - (depths / vDofParamsFocus1.x)) ;	float4 vCocFar = saturate(depths * vDofParamsFocus0.x + vDofParamsFocus0.y);	float4 vCocNear = saturate(depths * vDofParamsFocus0.z + vDofParamsFocus0.w) + FocusRangeNearMin;		farCoC = vCocFar * vCocFar * vDofParamsFocus1.w;	nearCoC = vCocNear * vCocNear * vDofParamsFocus1.w;	farCoC = max(farCoC, 0.00001);		farCoC = clamp(farCoC, -4, 4);	nearCoC = clamp(nearCoC, -4, 4);}float w0(float a){	return (1.0/6.0)*(a*(a*(-a + 3.0) - 3.0) + 1.0);}float w1(float a){	return (1.0/6.0)*(a*a*(3.0*a - 6.0) + 4.0);}float w2(float a){	return (1.0/6.0)*(a*(a*(-3.0*a + 3.0) + 3.0) + 1.0);}float w3(float a){	return (1.0/6.0)*(a*a*a);}// g0 and g1 are the two amplitude functionsfloat g0(float a){	return w0(a) + w1(a);}float g1(float a){	return w2(a) + w3(a);}// h0 and h1 are the two offset functionsfloat h0(float a){	return -1.0 + w1(a) / (w0(a) + w1(a));}float h1(float a){	return 1.0 + w3(a) / (w2(a) + w3(a));}float4 tex2D_bicubic(Texture2D tex, SamplerState samp, float2 uv, float2 res){	uv = uv * res + 0.5;	float2 iuv = floor( uv );	float2 fuv = frac( uv );	float g0x = g0(fuv.x);	float g1x = g1(fuv.x);	float h0x = h0(fuv.x);	float h1x = h1(fuv.x);	float h0y = h0(fuv.y);	float h1y = h1(fuv.y);	float2 p0 = (float2(iuv.x + h0x, iuv.y + h0y) - 0.5) / res;	float2 p1 = (float2(iuv.x + h1x, iuv.y + h0y) - 0.5) / res;	float2 p2 = (float2(iuv.x + h0x, iuv.y + h1y) - 0.5) / res;	float2 p3 = (float2(iuv.x + h1x, iuv.y + h1y) - 0.5) / res;	return g0(fuv.y) * (g0x * GetTexture2D(tex, samp, p0)  + g1x * GetTexture2D(tex, samp, p1)) + g1(fuv.y) * (g0x * GetTexture2D(tex, samp, p2) + g1x * GetTexture2D(tex, samp, p3));}Texture2D<float4> DnScDoF_Depth            : register(t0);SamplerState DnScDoF_DepthSamp             : register(s0);  //PointClampTexture2D<float4> DnScDoF_HDRTarg          : register(t1);SamplerState DnScDoF_HDRTargSamp           : register(s1);  //LinearClampstruct vtxOutDownscaleDof{	float4 HPosition  : SV_POSITION;	float4 tc0 : TEXCOORD0;	float4 tc1 : TEXCOORD1;	float4 tc2 : TEXCOORD2;	float4 tc3 : TEXCOORD3;	float4 tc4 : TEXCOORD4;	float4 tc5 : TEXCOORD5;	float4 tc6 : TEXCOORD6;};vtxOutDownscaleDof DownscaleDofVS(uint VertexID : SV_VertexID){	vtxOutDownscaleDof OUT = (vtxOutDownscaleDof)0; 	OUT.HPosition = GetHPos_FromTriVertexID(VertexID);	float2 baseTC = GetBaseTC_FromTriVertexID(VertexID);		OUT.tc0 = baseTC.xyxy + float4(-1, -1,  1,  1) * g_VS_ScreenSize.zwzw * 0.5;	OUT.tc1 = baseTC.xyxy + float4( 1, -1, -1,  1) * g_VS_ScreenSize.zwzw * 0.5;	OUT.tc3 = baseTC.xyxy + float4(-1,  0,  1,  0) * g_VS_ScreenSize.zwzw;	OUT.tc4 = baseTC.xyxy + float4( 0, -1,  0,  1) * g_VS_ScreenSize.zwzw;	OUT.tc5 = baseTC.xyxy + float4( 1,  1, -1, -1) * g_VS_ScreenSize.zwzw;	OUT.tc6 = baseTC.xyxy + float4(-1,  1,  1, -1) * g_VS_ScreenSize.zwzw;	OUT.tc2.xy = baseTC.xy;	return OUT;}struct OutDownscaleDof{	float4 LayerNear  : SV_Target0;	float4 LayerFar   : SV_Target1;		float2 CocNearFar : SV_Target2;};OutDownscaleDof DownscaleDofPS(vtxOutDownscaleDof IN){		OutDownscaleDof OUT = (OutDownscaleDof) 0;		float4 depths = float4(GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc5.xy).x,		GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc5.zw).x,		GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc6.xy).x,		GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc6.zw).x);	// todo: use gather4	depths *= PS_NearFarClipDist.y;	float4 c = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc2.xy).rgb, 1);	float4 c0 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc0.xy).rgb, 1);	float4 c1 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc0.zw).rgb, 1);	float4 c2 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc1.xy).rgb, 1);	float4 c3 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc1.zw).rgb, 1);	OUT.LayerNear = (c+c0 + c1 + c2 + c3) * 0.2; 	OUT.LayerFar = OUT.LayerNear; 	float4 vCocNear, vCocFar;	ComputeCircleOfConfusion(depths, vCocNear, vCocFar);	OUT.LayerNear.a = max(vCocNear.x, vCocNear.y);	OUT.LayerNear.a = max(OUT.LayerNear.a, vCocNear.z);	OUT.LayerNear.a = max(OUT.LayerNear.a, vCocNear.w); 		OUT.LayerFar.a = min(vCocFar.x, vCocFar.y);	OUT.LayerFar.a = min(OUT.LayerFar.a, vCocFar.z);	OUT.LayerFar.a = min(OUT.LayerFar.a, vCocFar.w);	OUT.CocNearFar = float2(OUT.LayerNear.a, OUT.LayerFar.a);		// Clamp for proper masking later (avoids "super strong" edges on very blurry foreground objects).	OUT.LayerNear.a = saturate(OUT.LayerNear.a);	// Scale with CoC to avoid leaking of sharper details.	OUT.LayerFar.rgb *= (OUT.LayerFar.a);	OUT.LayerNear.rgb *= (OUT.LayerNear.a);		return OUT;}technique DownscaleDof{  pass p0  {    VertexShader = DownscaleDofVS();    PixelShader = DownscaleDofPS();    CullMode = None;          }}//////////////////////////////////////////////////////////////////////////////////////////////////Texture2D<float4> TMCoC_SCoC          : register(t0);SamplerState TMCoC_SCoCSamp           : register(s0);  //LinearClampstruct OutTileMinCoC{	float2 CocNearFar : SV_Target0;};vtxOutDownscaleDof TileMinCoCVS(uint VertexID : SV_VertexID){	vtxOutDownscaleDof OUT = (vtxOutDownscaleDof)0; 	OUT.HPosition = GetHPos_FromTriVertexID(VertexID);	float2 baseTC = GetBaseTC_FromTriVertexID(VertexID);		OUT.tc0 = baseTC.xyxy + float4(-1,  0, 1,  0) * vDofParamsFocus1.zwzw;	OUT.tc1 = baseTC.xyxy + float4( 0, -1, 0,  1) * vDofParamsFocus1.zwzw;	OUT.tc2 = baseTC.xyxy + float4(-1, -1, 1,  1) * vDofParamsFocus1.zwzw;	OUT.tc3 = baseTC.xyxy + float4(-1,  1, 1, -1) * vDofParamsFocus1.zwzw;	return OUT;}OutTileMinCoC TileMinCoCPS(vtxOutDownscaleDof IN){		OutTileMinCoC OUT = (OutTileMinCoC) 0;	float2 coc0 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc0.xy).rg);	float2 coc1 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc0.zw).rg);	float2 coc2 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc1.xy).rg);	float2 coc3 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc1.zw).rg);	float2 coc4 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc2.xy).rg);	float2 coc5 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc2.zw).rg);	float2 coc6 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc3.xy).rg);	float2 coc7 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc3.zw).rg);	OUT.CocNearFar.r = max(coc0.rg, max(coc1, max(coc2, coc3))).r; // direction is inverted, take max	OUT.CocNearFar.g = min(coc0.rg, min(coc1, min(coc2, coc3))).g;	OUT.CocNearFar.r = max(OUT.CocNearFar.rg, max(coc4, max(coc5, max(coc6, coc7)))).r; // direction is inverted, take max	OUT.CocNearFar.g = min(OUT.CocNearFar.rg, min(coc4, min(coc5, min(coc6, coc7)))).g;	return OUT;}technique TileMinCoC{  pass p0  {    VertexShader = TileMinCoCVS();    PixelShader = TileMinCoCPS();    CullMode = None;          }}//////////////////////////////////////////////////////////////////////////////////////////////////Texture2D<float4> DOF_Depth          : register(t0);Texture2D<float4> DOF_CoCM           : register(t4);SamplerState DOF_PCSamp              : register(s0);  //PointClampTexture2D<float4> DOF_HDRDoF0        : register(t1);Texture2D<float4> DOF_HDRDoF1        : register(t2);SamplerState DOF_LCSamp              : register(s1);  //LinearClampfloat4 g_Taps[7*7];  // Max is 7x7 (for first iteration)struct pixout_dof{	float4 LayerNear  : SV_Target0;		float4 LayerFar   : SV_Target1;			float2 CocNearFar : SV_Target2;		};pixout_dof DofPS(vtxOut IN){	pixout_dof OUT = (pixout_dof) 0;	const int nNumTaps = vDofParamsFocus1.z;	float2 fCocScale = PS_ScreenSize.zw * 2.0;		// Rescale (tweaked to be compatible with Sprite DOF)	float scale = max(PS_ScreenSize.x / 1920, PS_ScreenSize.y / 1080) * 4;	fCocScale *= scale;	static const float fOpticalVignettingAmount = 0.2f;	float2 optv_tc = (IN.baseTC.xy * 2 - 1) * fOpticalVignettingAmount;#if %_RT_SAMPLE0 || %_RT_SAMPLE1	fCocScale *= 0.15;#endif	float4 cCenterTapNear = GetTexture2DLod(DOF_HDRDoF0, DOF_LCSamp, float4(IN.baseTC.xy, 0, 0));	float4 cCenterTapFar = GetTexture2DLod(DOF_HDRDoF1, DOF_LCSamp, float4(IN.baseTC.xy, 0, 0));	float fCocNear = cCenterTapNear.w;	float fCocFar = cCenterTapFar.w;#if %_RT_SAMPLE0 || %_RT_SAMPLE1		float4 cAccNear = float4(0,0,0,0);	float caccNear = 0;	float4 cAccFar = float4(0,0,0,fCocFar);	float caccFar = 0;	OUT.LayerFar = cCenterTapFar;	OUT.LayerNear = cCenterTapNear;#else	float4 cAccNear = float4(0,0,0,0);	float caccNear = 0;	float4 cAccFar = float4(0,0,0,0);	float caccFar = 0;#endif	const float2 vMinTileCoC = (GetTexture2DLod(DOF_CoCM, DOF_PCSamp, float4(IN.baseTC.xy, 0, 0)).rg);		// note - on nvidia getting better perf with single branch outside loops. on amd the oposite	[branch] if (vMinTileCoC.r>0.0)	{		[loop] for(int t = 0; t < nNumTaps; t ++)		{				const float2 offset = g_Taps[t].xy;			const float fOptVignetting = 1 - abs(dot(optv_tc.xy, offset.xy));			float2 cocOffset = vMinTileCoC.r * fOptVignetting * fCocScale * offset.xy;			float4 cn = GetTexture2DLod(DOF_HDRDoF0, DOF_LCSamp, float4(IN.baseTC.xy + cocOffset, 0, 0));					const float k = 1.075;			float wn = (cn.w >= vMinTileCoC.r * k) ? 1 : saturate(vMinTileCoC.r * k - cn.w);			#if %_RT_SAMPLE0 || %_RT_SAMPLE1			cAccNear = max(cAccNear, cn);#else			cAccNear += cn*wn;			caccNear += wn;#endif		}	}	//[branch] if (vMinTileCoC.g>=0.0)	{		[loop] for(int t = 0; t < nNumTaps; t ++)		{				const float2 offset = g_Taps[t].xy;			const float fOptVignetting = 1-abs(dot(optv_tc.xy, offset.xy));			float2 cocOffset = fCocFar * fOptVignetting * fCocScale * offset.xy;						float4 cf = GetTexture2DLod(DOF_HDRDoF1, DOF_LCSamp, float4(IN.baseTC.xy + cocOffset, 0, 0));			float wf = (cf.w >= fCocFar) ? 1 : saturate( cf.w );			#if %_RT_SAMPLE0 || %_RT_SAMPLE1			cAccFar = max(cAccFar, cf*wf);#else			cAccFar += cf*wf;			caccFar += wf;#endif		}	}#if !%_RT_SAMPLE0 && !%_RT_SAMPLE1	cAccNear = caccNear ? cAccNear * rcp(caccNear) : cCenterTapNear;	cAccFar = caccFar? cAccFar * rcp(caccFar) : cCenterTapFar;#endif	OUT.LayerNear = cAccNear;	OUT.LayerNear.a = (OUT.LayerNear.a);	OUT.LayerFar = cAccFar;	OUT.LayerFar.a = (OUT.LayerFar.a);	OUT.CocNearFar.rg = (float2(OUT.LayerNear.a, OUT.LayerFar.a));	return OUT;}technique Dof{  pass p0  {    VertexShader = FullscreenTriVS() PostMotionBlurVS;    PixelShader = DofPS() HDRPostProcessPS;    CullMode = None;          }}//////////////////////////////////////////////////////////////////////////////////////////////////Texture2D<float4> CDOF_Depth         : register(t0);Texture2D<float4> CDOF_STarg         : register(t4);SamplerState CDOF_PCSamp             : register(s0);  //PointClampTexture2D<float4> CDOF_HDRDoF0       : register(t1);Texture2D<float4> CDOF_HDRDoF1       : register(t2);SamplerState CDOF_LCSamp             : register(s1);  //LinearClamppixout CompositeDofPS(vtxOut IN){	pixout OUT = (pixout) 0;	half4 cScene = GetTexture2D(CDOF_STarg, CDOF_PCSamp, IN.baseTC.xy);	half4 cLayerNear = tex2D_bicubic(CDOF_HDRDoF0, CDOF_LCSamp, IN.baseTC.xy, PS_ScreenSize.xy *0.5);	half4 cLayerFar = tex2D_bicubic(CDOF_HDRDoF1, CDOF_LCSamp, IN.baseTC.xy, PS_ScreenSize.xy *0.5);		float depth = GetTexture2D(CDOF_Depth, CDOF_PCSamp, IN.baseTC.xy).x * PS_NearFarClipDist.y; 		float4 nearCoC, farCoC;	ComputeCircleOfConfusion(depth.xxxx, nearCoC, farCoC);	cLayerFar.rgb /= cLayerFar.a > 0 ? cLayerFar.a : 1.0f;	cLayerFar.a = saturate( farCoC.x );	cLayerNear.rgb = cLayerNear.rgb / (cLayerNear.a > 0 ? cLayerNear.a : 1.0f);	cLayerNear.a = saturate(cLayerNear.a);		OUT.Color = lerp(cScene, cLayerFar, cLayerFar.a);	OUT.Color = lerp(OUT.Color, cLayerNear, cLayerNear.a);		return OUT;}technique CompositeDof{  pass p0  {    VertexShader = FullscreenTriVS() PostMotionBlurVS;    PixelShader = CompositeDofPS() HDRPostProcessPS;    CullMode = None;          }}