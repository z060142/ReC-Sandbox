loat2 vField = (IN.baseTC.xy * 2 - 1) * float2(fFieldAspect, 1.0) * rsqrt(fFieldAspect * fFieldAspect + 1.0);	const float fFieldR = length(vField);	// At the exact centre the radial direction is undefined; every field term carries a factor	// of fFieldR or its square, so any unit vector gives the same (vanishing) result.	const float2 vFieldU = (fFieldR > 1e-4) ? (vField / fFieldR) : float2(1, 0);	const float2 vFieldT = float2(-vFieldU.y, vFieldU.x);	const float2 vBarrelC = -vFieldU * (vDofFieldPupil.x * fFieldR);	const float fSqueezeS = max(vDofFieldPupil2.x, 1.0);	const float fComaK = vDofFieldPupil.z * fFieldR;	const float fAstigA = vDofFieldPupil.w * fFieldR * fFieldR;   // signed per layer below	// Axial chromatic aberration: the radius, in pupil units, of the disc the SHRUNK channels	// convolve with. Rather than three gathers, every tap keeps the layer's kernel and its	// colour is masked per channel - a channel whose disc is smaller simply does not accept	// taps outside its own radius, and the per-channel weight sum below renormalises what it	// did accept. Same result, a few multiplies instead of a second and third kernel.	const float fAxialS = vDofAxialChromatic.x;#if %_RT_SAMPLE0 || %_RT_SAMPLE1	fCocScale *= 0.15;#endif	float4 cCenterTapNear = GetTexture2DLod(DOF_HDRDoF0, DOF_LCSamp, float4(IN.baseTC.xy, 0, 0));	float4 cCenterTapFar = GetTexture2DLod(DOF_HDRDoF1, DOF_LCSamp, float4(IN.baseTC.xy, 0, 0));	float fCocNear = cCenterTapNear.w;	float fCocFar = cCenterTapFar.w;#if %_RT_SAMPLE0 || %_RT_SAMPLE1		float4 cAccNear = float4(0,0,0,0);	float4 caccNear = 0;	float4 cAccFar = float4(0,0,0,fCocFar);	float4 caccFar = 0;	OUT.LayerFar = cCenterTapFar;	OUT.LayerNear = cCenterTapNear;#else	// The weight accumulators carry one lane per colour channel plus alpha: with a per-channel	// tap mask each channel takes a different subset of the taps, so each has to be normalised	// over the weight IT accumulated. .a keeps the unmasked sum, which is what the alpha (the	// circle of confusion the layer carries onward) has always been averaged by.	float4 cAccNear = float4(0,0,0,0);	float4 caccNear = 0;	float4 cAccFar = float4(0,0,0,0);	float4 caccFar = 0;#endif	const float2 vMinTileCoC = (GetTexture2DLod(DOF_CoCM, DOF_PCSamp, float4(IN.baseTC.xy, 0, 0)).rg);		// note - on nvidia getting better perf with single branch outside loops. on amd the oposite	[branch] if (vMinTileCoC.r>0.0)	{		[loop] for(int t = 0; t < nNumTaps; t ++)		{				const float2 offset = g_Taps[t].xy;			// Pupil space: undo the anamorphic narrowing the CPU already baked into the tap, so			// the barrel and the aberrations act on the round pupil they are defined on.			const float2 x = float2(offset.x * fSqueezeS, offset.y);			// The aperture: this ray only exists if it clears the mechanical opening. Soft edged			// so the clipped silhouette does not alias from one tap to the next.			const float clipW = saturate((vDofFieldPupil.y - length(x - vBarrelC)) / 0.08 + 0.5);			// Near layer sits on the opposite side of focus from the far layer, so its			// astigmatic ellipse is the far layer's turned by 90 degrees - hence the minus.			const float aNear = -fAstigA;			float2 xn = vFieldU * dot(x, vFieldU) * (1 + aNear) + vFieldT * dot(x, vFieldT) * (1 - aNear);			xn += vFieldU * (fComaK * dot(x, x));			float2 cocOffset = vMinTileCoC.r * fCocScale * float2(xn.x / fSqueezeS, xn.y);			float4 cn = GetTexture2DLod(DOF_HDRDoF0, DOF_LCSamp, float4(IN.baseTC.xy + cocOffset, 0, 0));			const float k = 1.075;			float wn = (cn.w >= vMinTileCoC.r * k) ? 1 : saturate(vMinTileCoC.r * k - cn.w);			// The clip reshapes the kernel only: the renormalisation by accumulated weight below			// keeps the brightness, because the light the barrel eats is applied once in the			// tonemap vignette instead (FieldPupilSpec.md section 2.3).			wn *= clipW;			// Per-channel disc: in FRONT of focus it is green that focuses short, so green			// alone is masked to the smaller radius and the rim left over reads magenta. rho is			// the tap's radius in the unsqueezed pupil BEFORE coma and astigmatism - the mask			// is a property of the aperture, like the barrel clip, not of the deformation.			// One-sided and outward, so at s = 1 every tap of the unit pupil masks to exactly 1.			const float mn = saturate((fAxialS - length(x)) / 0.08 + 1);			cn.rgb *= float3(1, mn, 1);#if %_RT_SAMPLE0 || %_RT_SAMPLE1			// The max path ignores wn entirely, so the clip has to reach the colour itself.			cAccNear = max(cAccNear, cn * clipW);#else			cAccNear += cn*wn;			caccNear += wn * float4(1, mn, 1, 1);#endif		}	}	//[branch] if (vMinTileCoC.g>=0.0)	{		[loop] for(int t = 0; t < nNumTaps; t ++)		{				const float2 offset = g_Taps[t].xy;			// Same pupil transform as the near loop, with the astigmatic ellipse the other way			// round: this is the far side of focus. See the near loop for the reasoning.			const float2 x = float2(offset.x * fSqueezeS, offset.y);			const float clipW = saturate((vDofFieldPupil.y - length(x - vBarrelC)) / 0.08 + 0.5);			const float aFar = fAstigA;			float2 xf = vFieldU * dot(x, vFieldU) * (1 + aFar) + vFieldT * dot(x, vFieldT) * (1 - aFar);			xf += vFieldU * (fComaK * dot(x, x));			float2 cocOffset = fCocFar * fCocScale * float2(xf.x / fSqueezeS, xf.y);			float4 cf = GetTexture2DLod(DOF_HDRDoF1, DOF_LCSamp, float4(IN.baseTC.xy + cocOffset, 0, 0));			float wf = (cf.w >= fCocFar) ? 1 : saturate( cf.w );			wf *= clipW;			// BEHIND focus red and blue are the pair that focuses short, so they take the			// smaller disc and green alone survives at the rim - the green fringe of fast and			// vintage glass. Alpha is left alone: it is the circle of confusion, not light.			const float mf = saturate((fAxialS - length(x)) / 0.08 + 1);			cf.rgb *= float3(mf, 1, mf);#if %_RT_SAMPLE0 || %_RT_SAMPLE1			cAccFar = max(cAccFar, cf*wf);#else			cAccFar += cf*wf;			caccFar += wf * float4(mf, 1, mf, 1);#endif		}	}#if !%_RT_SAMPLE0 && !%_RT_SAMPLE1	// Per channel, not per pixel: a channel that accepted no weight at all - fully masked out,	// or the whole kernel clipped away - falls back to the centre tap's own channel, exactly as	// the scalar version fell back for the whole pixel. The guard is per lane because the lanes	// no longer share a weight.	cAccNear = (caccNear > 0) ? cAccNear / max(caccNear, 1e-6) : cCenterTapNear;	cAccFar = (caccFar > 0) ? cAccFar / max(caccFar, 1e-6) : cCenterTapFar;#endif	OUT.LayerNear = cAccNear;	OUT.LayerNear.a = (OUT.LayerNear.a);	OUT.LayerFar = cAccFar;	OUT.LayerFar.a = (OUT.LayerFar.a);	OUT.CocNearFar.rg = (float2(OUT.LayerNear.a, OUT.LayerFar.a));	return OUT;}technique Dof{  pass p0  {    VertexShader = FullscreenTriVS() PostMotionBlurVS;    PixelShader = DofPS() HDRPostProcessPS;    CullMode = None;          }}//////////////////////////////////////////////////////////////////////////////////////////////////Texture2D<float4> CDOF_Depth         : register(t0);Texture2D<float4> CDOF_STarg         : register(t4);SamplerState CDOF_PCSamp             : register(s0);  //PointClampTexture2D<float4> CDOF_HDRDoF0       : register(t1);Texture2D<float4> CDOF_HDRDoF1       : register(t2);SamplerState CDOF_LCSamp             : register(s1);  //LinearClamppixout CompositeDofPS(vtxOut IN){	pixout OUT = (pixout) 0;	half4 cScene = GetTexture2D(CDOF_STarg, CDOF_PCSamp, IN.baseTC.xy);	half4 cLayerNear = tex2D_bicubic(CDOF_HDRDoF0, CDOF_LCSamp, IN.baseTC.xy, PS_ScreenSize.xy *0.5);	half4 cLayerFar = tex2D_bicubic(CDOF_HDRDoF1, CDOF_LCSamp, IN.baseTC.xy, PS_ScreenSize.xy *0.5);		float depth = GetTexture2D(CDOF_Depth, CDOF_PCSamp, IN.baseTC.xy).x * PS_NearFarClipDist.y; 		float4 nearCoC, farCoC;	ComputeCircleOfConfusion(depth.xxxx, LensFieldRadius2(IN.baseTC.xy), nearCoC, farCoC);	cLayerFar.rgb /= cLayerFar.a > 0 ? cLayerFar.a : 1.0f;	cLayerFar.a = saturate( farCoC.x );	cLayerNear.rgb = cLayerNear.rgb / (cLayerNear.a > 0 ? cLayerNear.a : 1.0f);	cLayerNear.a = saturate(cLayerNear.a);		OUT.Color = lerp(cScene, cLayerFar, cLayerFar.a);	OUT.Color = 