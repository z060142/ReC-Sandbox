// Copyright 2008-2021 Crytek GmbH / Crytek Group. All rights reserved.#include "Common.cfi"#include "ShadeLib.cfi"#include "PostEffectsLib.cfi"// Shader global descriptionsfloat Script : STANDARDSGLOBAL<  string Script =           "NoPreview;"           "LocalConstants;"           "ShaderDrawType = Custom;"           "ShaderType = PostProcess;">; /// Constants ////////////////////////////float4 vDofParamsFocus0;float4 vDofParamsFocus1;float4 vAspectRatio;half4 vRainColor;// Sprite bokeh shaping. x: iris blade count, y: polygon blend (0 = round/wide open,// 1 = fully formed polygon - same f/1.2 to f/2.8 window the gather kernel uses),// z: 1 when a shape texture is bound, w: iris phase in radians (shared with the streaks).float4 vDofBokehShape;// Sparse highlight selection for the hybrid splat layer. x: scene-HDR luminance threshold,// y: soft knee half width, z: energy gain of one splat, w: diagnostic flag.float4 vDofBokehHighlight;// Pupil = shape mask INTERSECT iris polygon, continuous at every f-number.// x: mask-look weight (0 = iris fill style, 1 = mask fill style; follows which hole is the//    smaller one), y: mask sampling scale = pupil bounding radius in mask units (1 while the//    mask is the smaller hole, N_mask/N once the iris is), z: iris polygon radius in quad//    units (N_mask/N while the mask bounds the pupil, 1 once the iris does),// w: circle of confusion at which a splat reaches full strength (fade-in, VS).float4 vDofBokehMask;// Mask rotation: x = cos, y = sin. The mask is its own element and turns independently of// the iris phase (vDofBokehShape.w); the texture is sampled through the INVERSE rotation so// the silhouette turns the same way as the gather taps, which are rotated forward on the CPU.float4 vDofBokehMask2;// Field-dependent pupil (FieldPupilSpec.md), all of it in PUPIL units so the shaders never need// the f-number: x = distance the barrel's apparent centre slides away from the pupil centre at// the frame CORNER (scaled by the pixel's own field height, direction = minus radial),// y = barrel radius, z = coma coefficient, w = astigmatism coefficient (signed; the far layer// stretches radially where the near layer stretches tangentially).float4 vDofFieldPupil;// x = anamorphic squeeze S. The gather taps arrive already narrowed by 1/S from the CPU, but// the barrel and the aberrations are defined on the UNSQUEEZED pupil, so the gather undoes and// redoes the squeeze around them. The splat quad was narrowed in the vertex shader instead, so// its quad-local coordinate already IS pupil space and it ignores this. y = field debug flag.// z = field curvature coefficient, w = the edge softness floor coefficient (LensFlawsSpec.md).// Both are focus errors rather than pupil shapes, so they are applied inside// ComputeCircleOfConfusion and reach the downscale and the composite, not the splat.float4 vDofFieldPupil2;// Axial (longitudinal) chromatic aberration, AxialChromaticSpec.md. x = s, the radius of the// shrunk channels' out-of-focus disc in units of the full one (1 = off). Not a field effect:// each wavelength simply focuses at its own distance, so the centre of the frame fringes as// hard as the corners. yzw unused.float4 vDofAxialChromatic;// Internal reflection ghosts (LensGhostSpec.md), one draw per ghost layer - the chain cannot// share a single constant because every layer sits at its own place with its own size and its// own coating colour, and the vertex shader has no way to know which layer it is drawing.// vDofGhost0: x = k, the factor the source's NDC position is mirrored through the frame centre// by, y = the ghost's radius in native pixels (a ghost is an image of the APERTURE, so the CPU// sizes it from the pupil scale rather than from any circle of confusion), z = the scene HDR// luminance a source needs to spawn ghosts, w = the soft knee half width around it.// vDofGhost1: rgb = this layer's coating tint, already hue rotated on the CPU, w = amount.float4 vDofGhost0;float4 vDofGhost1;// Squared field radius of a pixel: 0 at the frame centre, 1 at the corners. Same normalisation// as the field vector the pupil effects use (FieldPupilSpec 2.1), reduced to the only quantity// the flaws below need - both of them are even in the field, so no direction is required.float LensFieldRadius2(float2 tc){	const float fAspect = PS_ScreenSize.x / max(PS_ScreenSize.y, 1.0);	const float2 vField = (tc * 2 - 1) * float2(fAspect, 1.0) * rsqrt(fAspect * fAspect + 1.0);	return dot(vField, vField);}/////////////////////////////////////////////////////////////////////////////////////////////////// Sprite-Based DOF/////////////////////////////////////////////////////////////////////////////////////////////////struct pixoutDofMRT{	half4 LayerNear  : SV_Target0;	half4 LayerFar   : SV_Target1;};// One quad per source pixel, expanded from SV_VertexID - there is no vertex stream at all,// so this is the only interpolator set the sprite path uses.struct v2fBokehQuad{	float4 Position  : SV_POSITION;	float4 QuadPos   : TEXCOORD0; //xy quad-local uv, z near blur, w unused	float4 Color     : TEXCOORD1;	// Field-dependent pupil, resolved once per sprite from its own position in the frame:	// xy = field vector (0 at the centre, 1 at the corners), z = 1 / transmission through the	// clipped pupil, w = how much the quad was grown to hold the deformed shape.	float4 Field     : TEXCOORD2;};Texture2D texDofBkRef_SceneTarget : register(t0);Texture2D texDofBkRef_SceneDepth  : register(t1);Texture2D texDofBkRef_Dither      : register(t2);Texture2D texDofBkRef_BokehShape  : register(t3);Texture2D texDofBkRef_CoC         : register(t4);  // gather's CoC: r = near (tile max), g = far (tile min)SamplerState ssDofBkRef_SceneTarget : register(s0);SamplerState ssDofBkRef_SceneDepth  : register(s1);SamplerState ssDofBkRef_Dither      : register(s2);SamplerState ssDofBkRef_BokehShape  : register(s3);// Radius of a regular n-gon at angle theta, normalized so the edge midpoints sit at 1.// Same closed form the gather kernel uses on the CPU (CDepthOfFieldStage::ToUnitDisk).float NGon_Rad(float theta, float n){	return cos(PI / n) / cos(theta - (2 * PI / n) * floor((n * theta + PI) / (2 * PI)));}v2fBokehQuad DofBokehRefVS(uint nVertexID : SV_VertexID){	v2fBokehQuad OUT = (v2fBokehQuad) 0;	// Resolve the quad's cell in the source grid with integer math. The original float	// modulo against g_VS_ScreenSize.x works today, but the quad id reaches several million	// and would start banding into columns once it leaves fp32's exact integer range.	const int nQuadID    = (int)(nVertexID / 6);	const int nGridWidth = (int)g_VS_ScreenSize.x;	float4 INPos = float4((float)(nQuadID % nGridWidth), (float)(nQuadID / nGridWidth), 0, 0);	INPos.xy /= g_VS_HPosScale.xy;	float4 vOutPos = INPos;  float4 vPos = INPos;		INPos.xy *= g_VS_ScreenSize.zw * 2.0;	INPos.xy += g_VS_ScreenSize.zw;	vOutPos = INPos;	vOutPos.xy =  vOutPos.xy *2 -1;	OUT.Position = float4(vOutPos.xy, 0, 1);//vWorldPos.z, fDepth); //mul(vpMatrix, vPos);  	float4 screenProj = HPosToScreenTC(OUT.Position);			// fetch scene color - output vertex/quad color	float fDepth = GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy, 0, 0)).x;	#if %_RT_SAMPLE1	// Dilate to avoid ghosting on edges due to lower resolution DOF	// This can cause artifacts in small cavities and on alpha-tested geometry	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2( vAspectRatio.w, vAspectRatio.w), 0, 0)).x);	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2(-vAspectRatio.w, vAspectRatio.w), 0, 0)).x);	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2( vAspectRatio.w,-vAspectRatio.w), 0, 0)).x);	fDepth = min(fDepth, GetTexture2DLod(texDofBkRef_SceneDepth, ssDofBkRef_SceneDepth, float4(screenProj.xy + g_VS_ScreenSize.zw * half2(-vAspectRatio.w,-vAspectRatio.w), 0, 0)).x);#endif	OUT.QuadPos = 1;	fDepth *= g_VS_NearFarClipDist.y;	// Circle of confusion read from the gather's own CoC texture rather than recomputed from	// depth: the splat rides on top of the gather result, so it has to agree with the gather on	// how far out of focus this cell is - to the number, including the gather's 2x2 min (far)	// / max (near) and its tile dilation. Recomputing from a different depth source put the two	// a little apart at every edge, and that read as the splat lagging the halo.	const half2 vCocGather = GetTexture2DLod(texDofBkRef_CoC, ssDofBkRef_SceneDepth, float4(screenProj.xy, 0, 0)).rg;	half fCocNear = clamp(vCocGather.r, 0, 4);	half fCocFar  = clamp(vCocGather.g, 0, 4);	// DofPS turns a CoC into a tap radius with this scale; doubling it gives the diameter.	const half fCocScalePixels = max(g_VS_ScreenSize.x / 1920.0, g_VS_ScreenSize.y / 1080.0) * 4.0;	half fDepthBlur = max(fCocFar, fCocNear) * 2.0 * fCocScalePixels;	fDepthBlur = min(64, fDepthBlur);	// Amplitude in step with the gather. The gather's halo loses energy as a highlight nears	// focus (its taps are weighted by CoC), while an energy-conserving splat only gets	// brighter per pixel as its disc shrinks - left alone, a small sharp silhouette floats on	// an already-converged light and then vanishes in one frame at the cull below. Fade the	// splat in over [1/3, 1] x r_DepthOfFieldSpriteBokehFadeCoC instead: below a handful of	// pixels the shape is unresolvable anyway, and the gather already carries that light.	const half fFadeFull = max(vDofBokehMask.w, 1e-3);	const half fSplatFade = smoothstep(fFadeFull * 0.333, fFadeFull, max(fCocFar, fCocNear));	// Sub-pixel splats add nothing the gather has not already done, and cost a quad each.	if( fDepthBlur < 1.0 || fSplatFade <= 0.001 )	{		OUT.Position.xy=0;		return OUT;	}	OUT.QuadPos = max(1, fDepthBlur);	// lod blend weight	OUT.Color.w = ( sqrt(OUT.QuadPos.z) );	// Need to scale by pixel size	OUT.QuadPos.xy *= g_VS_ScreenSize.zw * 2.0;  // Scale by aspect ratio  OUT.QuadPos.xy *= vAspectRatio.xy;  // Anamorphic squeeze: the pupil image is compressed horizontally, so the quad - and the  // shape mask sampled through it - is too. QuadPos.w (the CoC in pixels) is left alone.  OUT.QuadPos.x *= vAspectRatio.z;	OUT.QuadPos.xy = max(g_VS_ScreenSize.zw * 2.0, OUT.QuadPos.xy);	OUT.QuadPos.z = saturate(fCocNear); // near blur, splits the splat between the two layers	// The grid cell's four NATIVE resolution texels: t0 is the full resolution scene copy,	// one grid texel spans 2x2 native texels, and zw is half a grid texel = one native texel,	// so +/-0.5*zw from the cell centre lands exactly on the four native texel centres.	// The old path sampled an already-downscaled copy and then averaged a further 2x2	// neighbourhood of it, so a small bright highlight was diluted by up to 16x BEFORE the	// threshold ever saw it - the splat survived but carried almost no excess energy, which	// is why the shapes only became readable once supersampling raised the internal	// resolution and undid the dilution by accident.	float4 vQuad[4] =	{		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2(-0.5, -0.5), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2( 0.5,  0.5), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2( 0.5, -0.5), 0, 0)),		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2(-0.5,  0.5), 0, 0)),	};	// Sparse highlight selection, PER TEXEL. The gather underneath has already spread the	// base energy, so only the EXCESS above a soft knee is splatted - but the knee has to be	// applied to each native texel BEFORE any averaging: max(0, x - t) is convex, so the	// excess of a mean is always less than the mean of the excesses, and a lone hot pixel in	// a dark cell used to read as a dim cell and lose its energy.	const half fThreshold = vDofBokehHighlight.x;	const half fKnee      = max(vDofBokehHighlight.y, 1e-4);	half fExcessSum = 0;	half3 cExcess = 0;	[unroll] for (int i = 0; i < 4; i++)	{		const half fLum = GetLuminance(vQuad[i].rgb);		// Quadratic knee across [threshold - knee, threshold + knee], linear above. A wide		// knee is what stops highlights popping as the aperture or focus sweeps past them.		half fSoft = clamp(fLum - fThreshold + fKnee, 0, 2 * fKnee);		fSoft = (fSoft * fSoft) / (4 * fKnee);		const half fExcess = max(fSoft, fLum - fThreshold);		// Hue preserving: this texel's colour rescaled so its luminance is exactly its excess.		cExcess += vQuad[i].rgb * (fExcess / max(fLum, 1e-4));		fExcessSum += fExcess;	}	// Mean over the cell keeps the old calibration for uniform areas (mean of excess equals	// excess of mean there) while a lone hot texel now keeps a quarter of its true excess	// instead of a sixteenth.	if (fExcessSum * 0.25 < 1e-4)	{		OUT.Position.xy=0;		return OUT;	}	OUT.Color.rgb = cExcess * 0.25 * fSplatFade;	// Field-dependent pupil, evaluated at the SPRITE's own place in the frame (a splat is one	// point of the field, unlike a gather pixel which is the field position itself).	{		const float fFieldAspect = g_VS_ScreenSize.x / max(g_VS_ScreenSize.y, 1.0);		const float2 vField = (screenProj.xy * 2 - 1) * float2(fFieldAspect, 1.0) * rsqrt(fFieldAspect * fFieldAspect + 1.0);		const float fFieldR = length(vField);		// The one number the tonemap, the gather and this pass all have to agree on. The		// tonemap darkens every pixel by T, and this pass divides its deposit by T so the loss		// lands exactly once - the splat normalises by the FULL disc area, so a clipped pupil		// would otherwise dim it a second time. Floored at 0.05 so a fully clipped corner		// sprite cannot explode.		const float fTransmission = LensFieldPupilTransmission(vDofFieldPupil.x * fFieldR, vDofFieldPupil.y);		// Coma pushes taps outward and astigmatism stretches one axis, so the deformed shape no		// longer fits the quad the CoC alone would need. Grow the quad by the worst case and		// undo the growth in the pixel shader, which keeps the shape's size (and therefore its		// energy normalisation) exactly as it was.		const float fGrowth = 1.0 + vDofFieldPupil.z * fFieldR + abs(vDofFieldPupil.w) * fFieldR * fFieldR;		OUT.Field = float4(vField, 1.0 / max(fTransmission, 0.05), fGrowth);		OUT.QuadPos.xy *= fGrowth;	}  const float2 Verts[6] =  {      float2( 1,  1),      float2(-1,  1),      float2( 1, -1),      float2( 1, -1),      float2(-1,  1),      float2(-1, -1)  };    OUT.Position.xy += Verts[nVertexID%6].xy * OUT.QuadPos.xy;  OUT.QuadPos = float4(Verts[nVertexID%6].xy*0.5+0.5, OUT.QuadPos.zw);	return OUT;}// The pupil itself: barrel clip INTERSECT iris polygon INTERSECT shape mask, rendered in// whichever of the two fill styles the smaller hole calls for. Factored out of the pixel shader// below because axial chromatic aberration needs it evaluated TWICE, at two radii - a channel// that focuses short draws the very same pupil, only smaller. tcQuad is the quad-local// coordinate already brought back to pupil units and walked back through the aberrations;// vBarrelC is the barrel's apparent centre and fIrisExp the lod-driven iris falloff exponent.half4 EvalPupilShape(half2 tcQuad, float2 vBarrelC, half fIrisExp){	const half fLen = dot(tcQuad, tcQuad);	// Iris fill style: radial falloff plus the approximate diffusion ring.	half fShapeBokeh = pow(fLen, fIrisExp) ;// * fLen;  // ^2	half4 cIris = saturate(1-fShapeBokeh);	cIris += saturate(1-abs(fShapeBokeh*2-1));	// Iris polygon at the curvature-driven sharpening exponent (vDofBokehShape.y: 0 = circle,	// ~1 = the true polygon, 2+ = sharpened, 4 = caricature - the same exponent the gather	// kernel raises its taps by, so both views of the iris always agree), at radius	// vDofBokehMask.z in quad units.	const float fEdgeSoft = 0.06f;      // soft edge width, in quad-local radius	const float fRadius   = sqrt(max(fLen, 1e-6f));	const float fTheta    = atan2(tcQuad.y, tcQuad.x);	const float fPolyRad  = pow(NGon_Rad(fTheta - vDofBokehShape.w, max(vDofBokehShape.x, 3.0f)), vDofBokehShape.y) * vDofBokehMask.z;	const half  fPolyMask = saturate((fPolyRad - fRadius) / fEdgeSoft);	// PUPIL = mask INTERSECT iris. The mask (white when none is bound) is sampled at the pupil's	// bounding scale (vDofBokehMask.y), the polygon at its own radius; their product is the	// physical aperture at every f-number. Stopping the iris down through the mask clips the	// silhouette corner by corner and rounds it off progressively - the two apertures are two	// separate mechanisms, but the crossover between them is a continuous intersection.	// Quad-local, from the CORRECTED coordinate: the mask is part of the pupil, so the barrel	// and the aberrations have to reshape its silhouette too, not be drawn as a circle over it.	float2 vMaskLocal = (tcQuad * 0.5) * vDofBokehMask.y;	vMaskLocal = float2( vMaskLocal.x * vDofBokehMask2.x + vMaskLocal.y * vDofBokehMask2.y,	                    -vMaskLocal.x * vDofBokehMask2.y + vMaskLocal.y * vDofBokehMask2.x);   // inverse rotation	const half fMaskVal = GetTexture2D(texDofBkRef_BokehShape, ssDofBkRef_BokehShape, vMaskLocal + 0.5).r;	// The barrel clip is the APERTURE and comes before the aberrations conceptually - it decides	// which rays exist at all, while coma and astigmatism are what the glass does to the ones	// that got through. Soft edge matched to the polygon's, so the two silhouettes blend alike.	const half  fBarrel = saturate((vDofFieldPupil.y - length(tcQuad - (half2)vBarrelC)) / 0.06 + 0.5);	const half fPupil   = fMaskVal * fPolyMask * fBarrel;	// Mask fill style: the pupil value field is the fill, and the soap-bubble diffusion ring	// rides the bilinear band where it crosses one half - the mask's outline inside the polygon,	// the polygon's edge where it clips the mask. A star gets a star-shaped ring.	const half4 cMaskLook = (half4)fPupil + saturate(1 - abs((1 - fPupil) * 2 - 1));	const half4 cIrisLook = cIris * fPupil;	// The fill style follows whichever hole is the smaller one (weight resolved on the CPU	// from N_mask / N); the geometry above is exact in both.	return lerp(cIrisLook, cMaskLook, vDofBokehMask.x);}pixoutDofMRT DofBokehRefPS(v2fBokehQuad IN){	pixoutDofMRT OUT = (pixoutDofMRT) 0.0;	//clip(-1);	half2 tcQuad = IN.QuadPos.xy*2-1;	// Field-dependent pupil. The quad was GROWN by g in the vertex shader so the deformed shape	// still fits inside it, so a quad-local coordinate now spans g pupil radii instead of one:	// scaling by g recovers pupil units and leaves the drawn shape at exactly the screen size	// (and therefore the pixel area, and therefore the energy normalisation) it had before.	// Then walk BACK through the aberrations - drawing a deformed shape means sampling the	// undeformed pupil at M^-1(x).	const float fFieldR = length(IN.Field.xy);	// Undefined at the exact frame centre, where every field term vanishes anyway.	const float2 vFieldU = (fFieldR > 1e-4) ? (IN.Field.xy / fFieldR) : float2(1, 0);	const float2 vFieldT = float2(-vFieldU.y, vFieldU.x);	{		tcQuad *= (half)IN.Field.w;		// Near and far layers sit on opposite sides of focus, so their astigmatic ellipses are		// each other turned by 90 degrees. QuadPos.z is the near/far split the vertex shader		// resolved from the CoC.		const float fAstigSign = (IN.QuadPos.z > 0.5) ? -1.0 : 1.0;		const float a = fAstigSign * vDofFieldPupil.w * fFieldR * fFieldR;		float2 x = vFieldU * (dot(tcQuad, vFieldU) / (1 + a)) + vFieldT * (dot(tcQuad, vFieldT) / (1 - a));		// Coma has no closed-form inverse - the displacement depends on the radius it produces -		// but one Newton refinement lands well inside a pixel at the strengths this exposes.		const float k = vDofFieldPupil.z * fFieldR;		const float2 x0 = x - vFieldU * (k * dot(x, x));		x -= vFieldU * (k * dot(x0, x0));		tcQuad = (half2)x;	}	// -8 ms for big kernels	const half fLen = (dot(tcQuad, tcQuad));	// Bare iris: the circular clip is the lens barrel. With a shape texture bound the pupil is	// the mask x polygon product below, which is zero outside itself - and the mask may own	// the quad's corners, so the barrel must not eat them. Always at the FULL radius: the quad	// is sized for the widest channel, so clipping it to the shrunk one would cut the rim off.	clip( lerp(1 - fLen, 1.0, vDofBokehShape.z) );	const float2 vBarrelC = -vFieldU * (vDofFieldPupil.x * fFieldR);	// Axial chromatic aberration. The shrunk channels focus at a different distance, so they	// draw the SAME pupil at a smaller radius: evaluating the shape at tcQuad / s is exactly	// that shape scaled by s. Dividing by s^2 keeps the light in it constant, so the smaller	// disc is correspondingly brighter - the same energy through a smaller circle. At s = 1	// the two evaluations are identical and this reduces to the single deposit it replaced.	const half fAxialS = (half)max(vDofAxialChromatic.x, 0.05);	const half4 cFull   = EvalPupilShape(tcQuad, vBarrelC, (half)IN.Color.w);	const half4 cShrunk = EvalPupilShape(tcQuad / fAxialS, vBarrelC, (half)IN.Color.w) / (fAxialS * fAxialS);	// Behind focus red and blue are the short-focusing pair, so the rim beyond their discs is	// green alone; in front of focus it is green that shrinks and the rim reads magenta. Which	// side a splat lands on is the same near/far split QuadPos.z already carries.	const half3 cShapeFar  = half3(cShrunk.r, cFull.g,   cShrunk.b);	const half3 cShapeNear = half3(cFull.r,   cShrunk.g, cFull.b);	// Energy conserving deposit. QuadPos.w carries the CoC in pixels, so dividing by its area	// spreads a fixed amount of energy over the disc however large it grows - a highlight	// going further out of focus widens and dims instead of gaining brightness. The layer is	// added to the gathered frame, so there is no accumulated-weight average to divide by.	const half fCocPixels = max(IN.QuadPos.w, 1.0);	// The anamorphic oval covers CoC^2 * vAspectRatio.z pixels instead of CoC^2 (the quad was	// narrowed by that same factor in the VS), so the deposit is divided by the real area.	const half fSplatNorm = vDofBokehHighlight.z / (fCocPixels * fCocPixels * vAspectRatio.z);	// Each layer composes its own silhouette now, so the deposit is built twice. Everything	// that is not the colour - the area normalisation, the transmission divide, the alpha from	// the mean of the channels - is exactly what it was.	// fSplatNorm divides by the FULL disc area, so a barrel-clipped pupil would dim this splat	// by the transmission T all by itself - and the tonemap vignette dims it again. Divide T	// back out (Field.z is 1/T) so the mechanical light loss is applied exactly once, in the	// tonemap, for blurred and sharp pixels alike.	const half fDeposit = fSplatNorm * (half)IN.Field.z;	half4 cSceneFar  = half4(IN.Color.rgb * cShapeFar,  dot(cShapeFar,  0.333)) * fDeposit;	half4 cSceneNear = half4(IN.Color.rgb * cShapeNear, dot(cShapeNear, 0.333)) * fDeposit;	// DIAGNOSTIC (r_DofSpriteBokehDebug): ignore the scene colour and the area	// normalization and paint the silhouette itself, blazing. If the shape texture and the	// iris polygon reach this shader at all, this makes them impossible to miss.	if (vDofBokehHighlight.w > 0.5)	{		cSceneFar  = half4(cShapeFar,  dot(cShapeFar,  0.333)) * 4.0;		cSceneNear = half4(cShapeNear, dot(cShapeNear, 0.333)) * 4.0;	}	// Background layer splats	OUT.LayerFar = cSceneFar * saturate(1-IN.QuadPos.z);	// Foreground layer splats	OUT.LayerNear = cSceneNear * saturate(IN.QuadPos.z);	// Apply dither pattern (minimize banding artefacts from accumulation/blending + aproximate lens particles)		half fDither = GetTexture2D(texDofBkRef_Dither, ssDofBkRef_Dither, IN.QuadPos.xy).w;	OUT.LayerFar += OUT.LayerFar * fDither;	OUT.LayerNear += OUT.LayerNear * fDither;	return OUT;}technique DofBokehRef{  pass p0  {    VertexShader = DofBokehRefVS() PostMotionBlurVS;    PixelShader = DofBokehRefPS() PostMotionBlurPS;    CullMode = None;  }}/////////////////////////////////////////////////////////////////////////////////////////////////// Lens ghosts (LensGhostSpec.md)//// A bright source reflects between the lens surfaces and lands on the sensor as a chain of// IMAGES OF THE APERTURE, strung along the line from the source through the frame centre. That// is the same object the sprite bokeh already draws, so this shares DofBokehRefPS verbatim and// inherits the iris polygon, the shape mask and its rotation, the anamorphic oval, the cat-eye// clip and the axial chromatic rim for free. Only the placement and the sizing are different,// which is exactly one vertex shader.//// The grid is QUARTER resolution: a ghost source is a lamp or the sun, never a lone hot texel,// and every extra layer multiplies the vertex work by the whole grid./////////////////////////////////////////////////////////////////////////////////////////////////v2fBokehQuad DofBokehGhostVS(uint nVertexID : SV_VertexID){	v2fBokehQuad OUT = (v2fBokehQuad) 0;	// Same integer walk over the quad grid as the splat above; only the per-view constant	// buffer differs, so the existing arithmetic needs no knowledge of the grid tier.	const int nQuadID    = (int)(nVertexID / 6);	const int nGridWidth = (int)g_VS_ScreenSize.x;	float4 INPos = float4((float)(nQuadID % nGridWidth), (float)(nQuadID / nGridWidth), 0, 0);	INPos.xy /= g_VS_HPosScale.xy;	INPos.xy *= g_VS_ScreenSize.zw * 2.0;	INPos.xy += g_VS_ScreenSize.zw;	float4 vOutPos = INPos;	vOutPos.xy = vOutPos.xy * 2 - 1;	// Where the SOURCE is. The ghost is placed elsewhere below, but the light is sampled here.	OUT.Position = float4(vOutPos.xy, 0, 1);	float4 screenProj = HPosToScreenTC(OUT.Position);	OUT.QuadPos = 1;	// No circle of confusion, no depth, no focus fade: a ghost is formed in the lens