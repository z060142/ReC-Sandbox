;	}	// The chain: the ghost sits on the line from the source through the frame CENTRE and out	// the other side, at k times the source's distance from it. NDC has the centre at the	// origin, so the reflection is a plain negation.	OUT.Position = float4(-vOutPos.xy * vDofGhost0.x, 0, 1);	OUT.Color.rgb = cExcess * 0.25 * (half3)vDofGhost1.rgb * (half)vDofGhost1.w;	// Read by the pixel shader as the iris falloff exponent, exactly as for a splat.	OUT.Color.w = sqrt(fRadiusPx);	// Radius in native pixels -> NDC half extent. The grid is quarter resolution, so one grid	// cell spans four native pixels and g_VS_ScreenSize.zw (half a grid texel) IS one native	// pixel expressed in NDC - no 1080-referenced aspect scale belongs here, because the CPU	// already sized the ghost as a fraction of the real frame height.	OUT.QuadPos = float4(fRadiusPx * g_VS_ScreenSize.zw, 1, fRadiusPx);	// Anamorphic squeeze: the pupil image is compressed horizontally, so its ghost is too.	OUT.QuadPos.x *= vAspectRatio.z;	// QuadPos.z = 1: ghosts go to the NEAR layer, which the overlay adds unmasked. The far	// layer is depth-masked against in-focus foreground and would cut them - and a ghost is	// formed inside the lens, so nothing in the scene may occlude it.	// Field-dependent pupil, evaluated at the GHOST's own place in the frame rather than the	// source's: the aperture image is clipped by the barrel where IT lands.	{		const float fFieldAspect = g_VS_ScreenSize.x / max(g_VS_ScreenSize.y, 1.0);		const float2 vField = OUT.Position.xy * float2(fFieldAspect, 1.0) * rsqrt(fFieldAspect * fFieldAspect + 1.0);		const float fFieldR = length(vField);		const float fTransmission = LensFieldPupilTransmission(vDofFieldPupil.x * fFieldR, vDofFieldPupil.y);		const float fGrowth = 1.0 + vDofFieldPupil.z * fFieldR + abs(vDofFieldPupil.w) * fFieldR * fFieldR;		OUT.Field = float4(vField, 1.0 / max(fTransmission, 0.05), fGrowth);		OUT.QuadPos.xy *= fGrowth;	}	const float2 Verts[6] =	{		float2( 1,  1),		float2(-1,  1),		float2( 1, -1),		float2( 1, -1),		float2(-1,  1),		float2(-1, -1)	};	OUT.Position.xy += Verts[nVertexID % 6].xy * OUT.QuadPos.xy;	OUT.QuadPos = float4(Verts[nVertexID % 6].xy * 0.5 + 0.5, OUT.QuadPos.zw);	return OUT;}technique DofBokehGhost{  pass p0  {    VertexShader = DofBokehGhostVS() PostMotionBlurVS;    PixelShader = DofBokehRefPS() PostMotionBlurPS;    CullMode = None;  }}Texture2D texDofNrm_DofLayer0   : register(t0);Texture2D texDofNrm_DofLayer1   : register(t1);Texture2D texDofNrm_DepthTarget : register(t3);SamplerState ssDofNrm_DofLayer0   : register(s0);SamplerState ssDofNrm_DofLayer1   : register(s1);SamplerState ssDofNrm_DepthTarget : register(s3);pixout RefDofMBNormalizePS(vtxOut IN){	pixout OUT = (pixout) 0;	half fDepth = GetTexture2D(texDofNrm_DepthTarget, ssDofNrm_DepthTarget, IN.baseTC.xy).x * PS_NearFarClipDist.y;	// The splat layers are full resolution now, so this is a straight 1:1 read. The half pixel	// offset and the four tap average that used to be here existed only to hide the bilinear	// magnification of a half resolution layer, and would blur away exactly the silhouette	// sharpness that rasterizing at native resolution just bought.	half4 cLayerNear = GetTexture2D(texDofNrm_DofLayer0, ssDofNrm_DofLayer0, IN.baseTC.xy);	half4 cLayerFar  = GetTexture2D(texDofNrm_DofLayer1, ssDofNrm_DofLayer1, IN.baseTC.xy);	// The splat layer is an overlay on an already gathered frame, so it is ADDED rather than	// blended against a sharp scene. Background splats are masked by how out of focus the	// DESTINATION pixel is, which is what stops a distant highlight bleeding over an in-focus	// object standing in front of it. Foreground splats are added unmasked - an out of focus	// foreground highlight is supposed to wash over whatever is behind it.	half4 vFocusRanges = saturate( half4(fDepth.xxxx ) * vDofParamsFocus0.xzxz + vDofParamsFocus0.ywyw );	vFocusRanges.x *= vFocusRanges.x;	const half fFarMask = saturate( vFocusRanges.x * vDofParamsFocus1.w );	OUT.Color = float4(cLayerNear.rgb + cLayerFar.rgb * fFarMask, 0);	return OUT;}technique RefDofMbNormalizePass{  pass p0  {    VertexShader = FullscreenTriVS() PostMotionBlurVS;    PixelShader = RefDofMBNormalizePS() PostMotionBlurPS;    CullMode = None;          }}/////////////////////////////////////////////////////////////////////////////////////////////////// Gather-Based DOF/////////////////////////////////////////////////////////////////////////////////////////////////void ComputeCircleOfConfusion(in float4 depths, in float fFieldR2, out float4 nearCoC, out float4 farCoC){	// Petzval field curvature: the focal surface is not flat, so with the centre in focus a point	// at the edge of the field images as though it stood at a different distance. Scaling the	// depth rather than shifting the focus plane is what keeps the error proportional to	// distance, which is what a curved surface does in object space. Positive = the edges focus	// closer than the centre. Its visibility rides the circle of confusion like any focus error,	// so stopping down hides it by itself.	float4 depthsF = depths * (1.0 + vDofFieldPupil2.z * fFieldR2);	// The minimum-Z near blur deliberately keeps the RAW depths: it is a camera-body near-clip	// effect, not something the glass does, so the curved focal surface must not bend it.	float4 FocusRangeNearMin = vDofParamsFocus1.y * saturate(1 - (depths / vDofParamsFocus1.x)) ;	float4 vCocFar = saturate(depthsF * vDofParamsFocus0.x + vDofParamsFocus0.y);	float4 vCocNear = saturate(depthsF * vDofParamsFocus0.z + vDofParamsFocus0.w) + FocusRangeNearMin;		farCoC = vCocFar * vCocFar * vDofParamsFocus1.w;	nearCoC = vCocNear * vCocNear * vDofParamsFocus1.w;	farCoC = max(farCoC, 0.00001);	// Residual off-axis aberration blur: even an edge that IS in focus stays soft wide open.	// A far-layer floor on purpose - the edge then blends behind the near layer the way a	// blurred background does, where a near-layer floor would wash edge objects over the sharp	// centre. The coefficient already carries the square of the pupil radius, so the softness	// disappears on stopping down without a separate aperture link.	farCoC = max(farCoC, vDofFieldPupil2.w * fFieldR2);		farCoC = clamp(farCoC, -4, 4);	nearCoC = clamp(nearCoC, -4, 4);}float w0(float a){	return (1.0/6.0)*(a*(a*(-a + 3.0) - 3.0) + 1.0);}float w1(float a){	return (1.0/6.0)*(a*a*(3.0*a - 6.0) + 4.0);}float w2(float a){	return (1.0/6.0)*(a*(a*(-3.0*a + 3.0) + 3.0) + 1.0);}float w3(float a){	return (1.0/6.0)*(a*a*a);}// g0 and g1 are the two amplitude functionsfloat g0(float a){	return w0(a) + w1(a);}float g1(float a){	return w2(a) + w3(a);}// h0 and h1 are the two offset functionsfloat h0(float a){	return -1.0 + w1(a) / (w0(a) + w1(a));}float h1(float a){	return 1.0 + w3(a) / (w2(a) + w3(a));}float4 tex2D_bicubic(Texture2D tex, SamplerState samp, float2 uv, float2 res){	uv = uv * res + 0.5;	float2 iuv = floor( uv );	float2 fuv = frac( uv );	float g0x = g0(fuv.x);	float g1x = g1(fuv.x);	float h0x = h0(fuv.x);	float h1x = h1(fuv.x);	float h0y = h0(fuv.y);	float h1y = h1(fuv.y);	float2 p0 = (float2(iuv.x + h0x, iuv.y + h0y) - 0.5) / res;	float2 p1 = (float2(iuv.x + h1x, iuv.y + h0y) - 0.5) / res;	float2 p2 = (float2(iuv.x + h0x, iuv.y + h1y) - 0.5) / res;	float2 p3 = (float2(iuv.x + h1x, iuv.y + h1y) - 0.5) / res;	return g0(fuv.y) * (g0x * GetTexture2D(tex, samp, p0)  + g1x * GetTexture2D(tex, samp, p1)) + g1(fuv.y) * (g0x * GetTexture2D(tex, samp, p2) + g1x * GetTexture2D(tex, samp, p3));}Texture2D<float4> DnScDoF_Depth            : register(t0);SamplerState DnScDoF_DepthSamp             : register(s0);  //PointClampTexture2D<float4> DnScDoF_HDRTarg          : register(t1);SamplerState DnScDoF_HDRTargSamp           : register(s1);  //LinearClampstruct vtxOutDownscaleDof{	float4 HPosition  : SV_POSITION;	float4 tc0 : TEXCOORD0;	float4 tc1 : TEXCOORD1;	float4 tc2 : TEXCOORD2;	float4 tc3 : TEXCOORD3;	float4 tc4 : TEXCOORD4;	float4 tc5 : TEXCOORD5;	float4 tc6 : TEXCOORD6;};vtxOutDownscaleDof DownscaleDofVS(uint VertexID : SV_VertexID){	vtxOutDownscaleDof OUT = (vtxOutDownscaleDof)0; 	OUT.HPosition = GetHPos_FromTriVertexID(VertexID);	float2 baseTC = GetBaseTC_FromTriVertexID(VertexID);		OUT.tc0 = baseTC.xyxy + float4(-1, -1,  1,  1) * g_VS_ScreenSize.zwzw * 0.5;	OUT.tc1 = baseTC.xyxy + float4( 1, -1, -1,  1) * g_VS_ScreenSize.zwzw * 0.5;	OUT.tc3 = baseTC.xyxy + float4(-1,  0,  1,  0) * g_VS_ScreenSize.zwzw;	OUT.tc4 = baseTC.xyxy + float4( 0, -1,  0,  1) * g_VS_ScreenSize.zwzw;	OUT.tc5 = baseTC.xyxy + float4( 1,  1, -1, -1) * g_VS_ScreenSize.zwzw;	OUT.tc6 = baseTC.xyxy + float4(-1,  1,  1, -1) * g_VS_ScreenSize.zwzw;	OUT.tc2.xy = baseTC.xy;	return OUT;}struct OutDownscaleDof{	float4 LayerNear  : SV_Target0;	float4 LayerFar   : SV_Target1;		float2 CocNearFar : SV_Target2;};OutDownscaleDof DownscaleDofPS(vtxOutDownscaleDof IN){		OutDownscaleDof OUT = (OutDownscaleDof) 0;		float4 depths = float4(GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc5.xy).x,		GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc5.zw).x,		GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc6.xy).x,		GetTexture2D(DnScDoF_Depth, DnScDoF_DepthSamp, IN.tc6.zw).x);	// todo: use gather4	depths *= PS_NearFarClipDist.y;	float4 c = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc2.xy).rgb, 1);	float4 c0 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc0.xy).rgb, 1);	float4 c1 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc0.zw).rgb, 1);	float4 c2 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc1.xy).rgb, 1);	float4 c3 = float4(GetTexture2D(DnScDoF_HDRTarg, DnScDoF_HDRTargSamp, IN.tc1.zw).rgb, 1);	OUT.LayerNear = (c+c0 + c1 + c2 + c3) * 0.2; 	OUT.LayerFar = OUT.LayerNear; 	float4 vCocNear, vCocFar;	ComputeCircleOfConfusion(depths, LensFieldRadius2(IN.tc2.xy), vCocNear, vCocFar);	OUT.LayerNear.a = max(vCocNear.x, vCocNear.y);	OUT.LayerNear.a = max(OUT.LayerNear.a, vCocNear.z);	OUT.LayerNear.a = max(OUT.LayerNear.a, vCocNear.w); 		OUT.LayerFar.a = min(vCocFar.x, vCocFar.y);	OUT.LayerFar.a = min(OUT.LayerFar.a, vCocFar.z);	OUT.LayerFar.a = min(OUT.LayerFar.a, vCocFar.w);	OUT.CocNearFar = float2(OUT.LayerNear.a, OUT.LayerFar.a);		// Clamp for proper masking later (avoids "super strong" edges on very blurry foreground objects).	OUT.LayerNear.a = saturate(OUT.LayerNear.a);	// Scale with CoC to avoid leaking of sharper details.	OUT.LayerFar.rgb *= (OUT.LayerFar.a);	OUT.LayerNear.rgb *= (OUT.LayerNear.a);		return OUT;}technique DownscaleDof{  pass p0  {    VertexShader = DownscaleDofVS();    PixelShader = DownscaleDofPS();    CullMode = None;          }}//////////////////////////////////////////////////////////////////////////////////////////////////Texture2D<float4> TMCoC_SCoC          : register(t0);SamplerState TMCoC_SCoCSamp           : register(s0);  //LinearClampstruct OutTileMinCoC{	float2 CocNearFar : SV_Target0;};vtxOutDownscaleDof TileMinCoCVS(uint VertexID : SV_VertexID){	vtxOutDownscaleDof OUT = (vtxOutDownscaleDof)0; 	OUT.HPosition = GetHPos_FromTriVertexID(VertexID);	float2 baseTC = GetBaseTC_FromTriVertexID(VertexID);		OUT.tc0 = baseTC.xyxy + float4(-1,  0, 1,  0) * vDofParamsFocus1.zwzw;	OUT.tc1 = baseTC.xyxy + float4( 0, -1, 0,  1) * vDofParamsFocus1.zwzw;	OUT.tc2 = baseTC.xyxy + float4(-1, -1, 1,  1) * vDofParamsFocus1.zwzw;	OUT.tc3 = baseTC.xyxy + float4(-1,  1, 1, -1) * vDofParamsFocus1.zwzw;	return OUT;}OutTileMinCoC TileMinCoCPS(vtxOutDownscaleDof IN){		OutTileMinCoC OUT = (OutTileMinCoC) 0;	float2 coc0 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc0.xy).rg);	float2 coc1 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc0.zw).rg);	float2 coc2 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc1.xy).rg);	float2 coc3 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc1.zw).rg);	float2 coc4 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc2.xy).rg);	float2 coc5 = (GetTexture2D(TMCoC_SCoC, TMCoC_SCoCSamp, IN.tc2.zw).rg);	float2 coc6 = (GetTexture2D(TMCoC_SCo