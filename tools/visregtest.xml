<?xml version="1.0" encoding="utf-8"?>
<!--
  Byte-identity harness for the scene-referred pipeline (SceneReferredSpec.md, stage S0).
  Procedure and the comparison steps: ReC-Sandbox/tools/README-bitcompare.md.

  WHERE THIS FILE LIVES
    CVisRegTest::LoadConfig() loads PathUtil::GetGameFolder() + "/" + <file>, so for this
    project the path is
        S:\Crytek\crytek\cryengine-gamesdk-sample-project2\5.7.1\gamesdk\visregtest.xml
    (game folder "gamesdk"; the default file name is visregtest.xml).

  HOW TO RUN, in the LAUNCHER, not the editor (the editor forces SMAA_1X and skips the
  game-mode passes):
        VisRegTest byteid_stock            -> captures into %USER%/TestResults/VisReg/byteid_stock/
        VisRegTest byteid_scene_off        -> ... /byteid_scene_off/
        VisRegTest byteid_scene_on         -> ... /byteid_scene_on/
    Optional 2nd argument is a different xml, optional 3rd argument "quit" exits afterwards.

  WHAT COMES OUT
    CVisRegTest::CaptureSample() writes "<map>_<n>.bmp" - and the extension is a lie:
    RT_StoreTextureToFile() looks the extension up with GetCaptureFormatByExtension(), "bmp"
    is not one of tga/jpg/png, so it falls back to TGA and writes TGA bytes into a .bmp file.
    That is lossless, which is what matters; bitcompare.py reads the bytes, not the name.
    Because the map name contains a slash the files land in
        %USER%/TestResults/VisReg/<testname>/singleplayer/woodland_<n>.bmp

  DETERMINISM
    The engine already does the hard part on eCMDOnMapLoaded (timers to 0, t_FixedStep
    0.033333, RNG seeded 0) and on eCMDWaitStreaming (streaming settled, then 64 more frames
    "for tone-mapper to adapt"). The Config block below removes the rest: temporal AA, the
    time-dependent film grain, and the debug text that is drawn into the captured frame.

  VIEWPOINTS
    The six positions are the level's own SpawnPoints (level.pak/mission_mission0.xml), raised
    ~1.6 m to eye height, each looking at a different heading. They are a starting set: to use
    a viewpoint of your own, stand there in game, type "goto" in the console, and paste the
    numbers it prints into a Sample line. A screenshot logs its "goto" line automatically.
-->
<VisRegTest>

	<Config>
		<!-- No temporal accumulation: SMAA_1TX and TAA both carry history across frames. -->
		<ConsoleCmd cmd="r_AntialiasingMode 0"/>
		<!-- Film grain is sampled with PB_time; the only capture input that moves on its own. -->
		<ConsoleCmd cmd="r_HDRGrainAmount 0"/>
		<!-- Nothing may be drawn over the picture: r_displayInfo is 1 in gamesdk.cryproject. -->
		<ConsoleCmd cmd="r_displayInfo 0"/>
		<ConsoleCmd cmd="r_profiler 0"/>
		<!-- Viewfinder overlays are monitor markings, never part of a comparison. -->
		<ConsoleCmd cmd="r_LensOverlays 0"/>
		<!-- Our own golden-ratio jitter advances one step per frame; 2 = full amplitude,
		     frame phase FROZEN. Irrelevant with no cinematic camera in the level, set anyway
		     so the same file can be used for the switch-on run. -->
		<ConsoleCmd cmd="r_DepthOfFieldLensModelJitter 2"/>
		<!-- Keep the two ends of the comparison honest about which path they took. -->
		<ConsoleCmd cmd="r_HDRDebug 0"/>
	</Config>

	<Map name="singleplayer/woodland">
		<!-- Set r_SceneReferred here (0 or 1) when running the switch-off / switch-on pair.
		     It does not exist in a stock build, where the command is simply reported unknown.
		<ConsoleCmd cmd="r_SceneReferred 0"/>
		-->

		<!-- x y z wx wy wz, degrees. -->
		<Sample location="1477.61 878.32 40.20 0 0 0"/>
		<Sample location="1477.61 878.32 40.20 0 0 120"/>
		<Sample location="1663.44 863.88 54.78 0 0 240"/>
		<Sample location="1319.07 945.21 51.72 0 0 45"/>
		<Sample location="1527.13 850.21 46.13 0 0 200"/>
		<Sample location="1607.16 897.34 48.80 0 0 300"/>
	</Map>

</VisRegTest>
