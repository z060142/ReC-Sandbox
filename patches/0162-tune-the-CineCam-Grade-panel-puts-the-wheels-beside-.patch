+void CCineGradePanel::ApplyLayout(EGradeLayout layout)
+{
+	if (layout == m_layout)
+		return;
+
+	const bool bWide = (layout == EGradeLayout::Wide);
+	const bool bWasWide = (m_layout == EGradeLayout::Wide);
+	m_layout = layout;
+
+	if (bWide != bWasWide)
+	{
+		// The same widget, moved between the two hosts. Nothing is destroyed and nothing is
+		// recreated, so every number, every caret position and any gesture in flight survives the
+		// move, and no widget signal - hence no write to the component - comes out of it.
+		m_pRightScroll->setVisible(bWide);
+
+		QVBoxLayout* const pFrom = bWide ? m_pLeftHostLayout : m_pRightHostLayout;
+		QVBoxLayout* const pTo = bWide ? m_pRightHostLayout : m_pLeftHostLayout;
+		pFrom->removeWidget(m_pRestColumn);
+		// Right host: before its stretch. Left host: after the wheels, before its stretch.
+		pTo->insertWidget(bWide ? 0 : 1, m_pRestColumn);
+		m_pRestColumn->show();
+
+		CCineWheelControl* const pWheels[3] = { m_pLift, m_pGamma, m_pGain };
+		for (int i = 0; i < 3; ++i)
+			pWheels[i]->SetMaxDiscSide(bWide ? Layout::kWideDiscMaxSide : Layout::kDiscMaxSide);
+
+		if (!bWide)
+		{
+			m_pLeftScroll->setMinimumWidth(0);
+			m_pLeftScroll->setMaximumWidth(QWIDGETSIZE_MAX);
+		}
+	}
+
+	ApplyWheelLayout(layout == EGradeLayout::Narrow);
+}
+
+int CCineGradePanel::WheelColumnCap() const
+{
+	// Three wheels at the two-column disc ceiling, measured from the controls themselves rather
+	// than from a hand-counted pixel total, so a different style cannot make the column too tight.
+	return 3 * m_pLift->WidthForDiscSide(Layout::kWideDiscMaxSide) + kWheelColumnPadding;
+}
+
+void CCineGradePanel::UpdateWheelColumnWidth()
+{
+	int columnWidth = qMin(WheelColumnCap(), (width() * kWheelColumnPercent) / 100);
+	columnWidth = qMax(columnWidth, 3 * m_pLift->WidthForDiscSide(Layout::kDiscMinSide) + kWheelColumnPadding);
+	// The same quantisation the disc uses, so a scrollbar appearing on either side cannot start a
+	// grow/shrink ping-pong between the two columns.
+	columnWidth -= columnWidth % Layout::kDiscSideStep;
+
+	if (m_pLeftScroll->minimumWidth() == columnWidth && m_pLeftScroll->maximumWidth() == columnWidth)
+		return;
+
+	m_pLeftScroll->setFixedWidth(columnWidth);
+}
+
 void CCineGradePanel::resizeEvent(QResizeEvent* pEvent)
 {
 	CDockableEditor::resizeEvent(pEvent);
 
-	const bool bStacked = (width() < kWheelRowMinWidth);
-	if (bStacked != m_wheelsStacked)
-		ApplyWheelLayout(bStacked);
+	EGradeLayout layout = EGradeLayout::Medium;
+	if (width() >= kTwoColumnMinWidth)
+		layout = EGradeLayout::Wide;
+	else if (width() < kWheelRowMinWidth)
+		layout = EGradeLayout::Narrow;
+
+	ApplyLayout(layout);
+
+	// The wheel column follows the dock inside the two-column layout as well, not only when the
+	// layout itself changes.
+	if (m_layout == EGradeLayout::Wide)
+		UpdateWheelColumnWidth();
 }
 
