 	{
-		IEntity* pEntity = (gEnv->pEntitySystem != nullptr) ? gEnv->pEntitySystem->GetEntity(entityId) : nullptr;
-		const char* szName = (pEntity != nullptr) ? pEntity->GetName() : "<none>";
+		szPath = m_endCapMesh.value.c_str();
+	}
 
-		// The seam, deliberately left open. Baking means CREATING EDITOR OBJECTS - one CBrushObject
-		// per instance, inside one undo step - and an engine module cannot reach the object manager
-		// to do that. It belongs in the AreaComponentsEditor plugin, driven from a tool, which is
-		// where the "Edit Shape" button already goes. Until then this says so rather than pretending.
-		CryWarning(VALIDATOR_MODULE_ENTITYSYSTEM, VALIDATOR_WARNING,
-		           "Distributor on entity \"%s\": \"Bake To Brushes\" is not implemented yet - baking has to create editor "
-		           "objects, which only the editor plugin can do. The instances keep their live link to the spline.",
-		           szName);
-	}));
+	if (szPath != nullptr)
+	{
+		cry_strcpy(out.meshPath, szPath);
+	}
 
-	Rebuild();
+	return true;
+}
+
+void CDistributorComponent::SetBakeEnabled(bool bEnabled)
+{
+	if (m_bEnabled == bEnabled)
+		return;
+
+	m_bEnabled = bEnabled;
+
+	// Forced: Enabled is part of the signature, but going through the guard would be one more thing
+	// to get wrong on a path whose whole job is to make the live instances disappear.
+	Rebuild(true);
 }
 
