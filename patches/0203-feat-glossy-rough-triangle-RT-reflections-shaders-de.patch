+		// reprojection landed on a pixel whose surface was somewhere else, that history is
+		// somebody else reflection. RT_GetGlossyBlend re-uses GetBlendMin depth-ratio and
+		// off-screen tests over a roughness-dependent 1/frames base.
+		const float fPrevDepthRT = tex2DlodLC(sceneRgbMinPrev, float4(vReprojTC_Min.xy, 0, 0)).w;
+		fBlendMin = RT_GetGlossyBlend(vReprojTC_Min.xy, fAverSmoothness, fDepthC, fPrevDepthRT);
+		fBlendMax = fBlendMin;
