+///////////////////////////////////////////////////////////////////////////////////
+// rt stage 4B - glossy (rough) triangle reflections (decision 08).
+//
+// (glossyMode, glossScale, temporalFrames, blueNoiseBound). Set by
+// CSvoRenderer::SetupCommonConstants and by ShadePass, both only under e_svoTI_RT_Active.
+//   .x e_svoTI_RT_GlossyMode    0 = mirror only (the stage 2C behaviour, bit for bit), 1 = GGX
+//   .y e_svoTI_RT_GlossScale    lobe width multiplier on the GGX alpha, 1 = physical
+//   .z e_svoTI_RT_TemporalFrames  the history length at smoothness 0.5
+//   .w 1 when rt_bluenoise_64.dds is bound at t32, 0 = fall back to the hash
+///////////////////////////////////////////////////////////////////////////////////
+float4 SVO_RTParams2;
+
+#define VOX_RT_GLOSSY_MODE                 (SVO_RTParams2.x)
+#define VOX_RT_GLOSS_SCALE_CVAR            (SVO_RTParams2.y)
+#define VOX_RT_TEMPORAL_FRAMES             (SVO_RTParams2.z)
+#define VOX_RT_NOISE_BOUND                 (SVO_RTParams2.w)
+
+// Smoothness at and above which a pixel keeps the EXACT mirror direction: the GGX alpha there
+// is (1 - 0.98)^2 = 4e-4, i.e. a lobe narrower than one specular texel, so sampling it only
+// adds noise. Also the upper end of every roughness ramp in the reconstruction.
+#define VOX_RT_MIRROR_GLOSS                0.98f
+
+// Half width of the cone-trace / ray-trace cross-fade band around e_svoTI_RT_MinGloss
+// (decision 08 consequences: "the transition band 0.45-0.55").
+#define VOX_RT_GLOSS_BAND                  0.05f
+
+// 64 x 64 RGBA8 void-and-cluster blue noise, scene-notes/rt/tools/gen_bluenoise.py.
+// Read with Load(), so no sampler and no filtering; t32 is free on every SVO technique.
+Texture2D SVO_BlueNoise: register (t32);
+
+// Fallback when the texture is missing: a cheap integer hash. White noise, not blue - the
+// temporal and spatial filters still work, they just have more to remove.
+float4 RT_HashNoise4(const int2 nXY, const float fFrameId)
+{
+	uint3 v = uint3((uint)abs(nXY.x), (uint)abs(nXY.y), (uint)abs(fFrameId));
+	uint h = v.x * 1973u + v.y * 9277u + v.z * 26699u + 1u;
+	uint4 r;
+	h ^= h >> 16; h *= 2246822519u; r.x = h;
+	h ^= h >> 13; h *= 3266489917u; r.y = h;
+	h ^= h >> 16; h *= 668265263u;  r.z = h;
+	h ^= h >> 15; h *= 2654435761u; r.w = h;
+	return float4(r >> 8) * (1.f / 16777216.f);
+}
+
+// Two independent uniform pairs in [0,1): .xy for the first GGX sample, .zw for the one
+// resample a below-the-horizon sample is allowed. Blue noise gives the spatial decorrelation
+// the 5 tap spatial filter needs; the per-frame R4 (generalised golden ratio) offset gives the
+// temporal decorrelation the history needs, and preserves the spectrum because an equal shift
+// of every texel is a shift, not a reshuffle (Wolfe/Heitz "blue noise + golden ratio").
+float4 RT_BlueNoise4(const int2 nXY, const float fFrameId)
+{
+	float4 vRnd = (VOX_RT_NOISE_BOUND > 0.f)
+	              ? SVO_BlueNoise.Load(int3(nXY.x & 63, nXY.y & 63, 0))
+	              : RT_HashNoise4(nXY, fFrameId);
+
+	// the plastic constant for d = 4: a_i = phi4^-i, phi4 = 1.1673039783
+	const float4 vR4 = float4(0.8566748839f, 0.7338918566f, 0.6287067210f, 0.5386328057f);
+	return frac(vRnd + fFrameId * vR4);
+}
+
+// CE's OWN smoothness -> GGX alpha mapping, so the traced lobe is the same lobe the deferred
+// pass shades with. shadeLib.cfi:368 SmoothnessToRoughness returns m = (1 - smoothness)^2, and
+// shadeLib.cfi:417 SpecularBRDF then writes the GGX NDF as m2 / (NdotH^2 (m2 - 1) + 1)^2 with
+// m2 = m * m - i.e. the D term's alpha IS m. Nothing here re-derives it.
+float RT_SmoothnessToAlpha(const float fSmoothness)
+{
+	const float m = (1.f - saturate(fSmoothness)) * (1.f - saturate(fSmoothness));
+	return clamp(m * max(VOX_RT_GLOSS_SCALE_CVAR, 0.f), 1e-3f, 1.f);
+}
+
+// Smith's Lambda for GGX, the same height-correlated form shadeLib.cfi:427-432 uses.
+float RT_SmithLambda(const float fNdotX, const float fAlpha)
+{
+	const float c2 = saturate(fNdotX * fNdotX);
+	const float t2 = (1.f - c2) / max(c2, 1e-7f);
+	return 0.5f * (-1.f + sqrt(1.f + fAlpha * fAlpha * t2));
+}
+
+// The VNDF estimator weight, WITHOUT the Fresnel term: sampling the distribution of visible
+// normals cancels D, the geometry and the cosines down to F * G2 / G1 (Heitz 2018 section 5).
+// F is deliberately left out here - TiledShading.cfi:951-953 multiplies TexGiSpecular by the
+// reflecting surface's envFresnel, so applying it again would count F0 twice (report 02f / 04a
+// energy ledger).
+float RT_GGXWeightG2overG1(const float fNdotV, const float fNdotL, const float fAlpha)
+{
+	const float Lv = RT_SmithLambda(fNdotV, fAlpha);
+	const float Ll = RT_SmithLambda(fNdotL, fAlpha);
+	return saturate((1.f + Lv) / max(1.f + Lv + Ll, 1e-6f));
+}
+
+// Heitz 2018, "Sampling the GGX Distribution of Visible Normals" (JCGT 7(4)), listing 1, the
+// isotropic case. Ve is the view direction in the tangent frame (+Z = shading normal, pointing
+// AWAY from the surface); the result is the sampled microfacet normal in the same frame.
+float3 RT_SampleGGXVNDF(const float3 Ve, const float fAlpha, const float u1, const float u2)
+{
+	// section 3.2: warp the view direction into the hemisphere configuration
+	const float3 Vh = normalize(float3(fAlpha * Ve.x, fAlpha * Ve.y, Ve.z));
+
+	// section 4.1: an orthonormal basis around Vh
+	const float fLenSq = Vh.x * Vh.x + Vh.y * Vh.y;
+	const float3 T1 = (fLenSq > 1e-7f) ? (float3(-Vh.y, Vh.x, 0.f) * rsqrt(fLenSq)) : float3(1, 0, 0);
+	const float3 T2 = cross(Vh, T1);
+
+	// section 4.2: a uniform point on the unit disk, squashed onto the visible half
+	const float r = sqrt(saturate(u1));
+	const float fPhi = 6.28318530718f * u2;
+	const float t1 = r * cos(fPhi);
+	float t2 = r * sin(fPhi);
+	const float s = 0.5f * (1.f + Vh.z);
+	t2 = lerp(sqrt(saturate(1.f - t1 * t1)), t2, s);
+
+	// section 4.3: lift back onto the hemisphere, then unwarp
+	const float3 Nh = t1 * T1 + t2 * T2 + sqrt(saturate(1.f - t1 * t1 - t2 * t2)) * Vh;
+	return normalize(float3(fAlpha * Nh.x, fAlpha * Nh.y, max(Nh.z, 1e-6f)));
+}
+
+// Branchless orthonormal basis, Duff et al. 2017 (JCGT 6(1)). No normalize, no singularity.
+void RT_BuildBasis(const float3 n, out float3 t, out float3 b)
+{
+	const float sgn = (n.z >= 0.f) ? 1.f : -1.f;
+	const float a = -1.f / (sgn + n.z);
+	const float c = n.x * n.y * a;
+	t = float3(1.f + sgn * n.x * n.x * a, sgn * c, -sgn * n.x);
+	b = float3(c, sgn + n.y * n.y * a, -n.y);
+}
+
+// The one entry point ConeTracePS calls. vNormal = the (distance-faded) shading normal,
+// vViewDir = surface -> eye, normalised. Returns the world space ray direction and writes the
+// VNDF estimator weight, which ShadePS multiplies the hit radiance by.
+//
+// A sampled microfacet can still reflect the view vector INTO the surface (the classic GGX
+// tail). Decision 08 says: resample once with the second noise pair, then fall back to the
+// exact mirror direction with weight 1 - biased, but bounded, cheap, and it never leaks a ray
+// through the floor. At one sample per pixel a rejection loop is not affordable.
+float3 RT_GlossyReflectDir(const float3 vNormal, const float3 vViewDir, const float fSmoothness,
+                           const float4 vRnd, out float fWeight)
+{
+	const float fAlpha = RT_SmoothnessToAlpha(fSmoothness);
+
+	float3 vT, vB;
+	RT_BuildBasis(vNormal, vT, vB);
+
+	const float3 Ve = float3(dot(vViewDir, vT), dot(vViewDir, vB), dot(vViewDir, vNormal));
+
+	float3 Nh = RT_SampleGGXVNDF(Ve, fAlpha, vRnd.x, vRnd.y);
+	float3 H = Nh.x * vT + Nh.y * vB + Nh.z * vNormal;
+	float3 L = reflect(-vViewDir, H);
+
+	if (dot(L, vNormal) <= 0.f)
+	{
+		Nh = RT_SampleGGXVNDF(Ve, fAlpha, vRnd.z, vRnd.w);
+		H = Nh.x * vT + Nh.y * vB + Nh.z * vNormal;
+		L = reflect(-vViewDir, H);
+	}
+
+	const float fNdotL = dot(L, vNormal);
+	if (fNdotL <= 0.f)
+	{
+		fWeight = 1.f;
+		return reflect(-vViewDir, vNormal);
+	}
+
+	// floored at 1/1024 so the direction stays recoverable from the LENGTH of the RGBA16F
+	// RayDir lane that carries this weight; the bias is under 0.1 % and only at grazing angles.
+	fWeight = max(RT_GGXWeightG2overG1(abs(Ve.z), fNdotL, fAlpha), 0.0009765625f);
+	return normalize(L);
+}
+
