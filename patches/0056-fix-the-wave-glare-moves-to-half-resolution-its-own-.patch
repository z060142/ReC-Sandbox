+// Wave-glare source pre-blur: one axis of a 5 tap Gaussian, sigma ~ 1 source texel, weights
+// normalised so the TOTAL EXCESS is preserved exactly (it is an energy, not a picture).
+//
+// This is a physical convolution, not a smoothing hack: the glare of an EXTENDED source is the
+// pattern convolved with the source's own shape, and the thresholded source is that shape. What
+// it buys in practice is that a lamp, which clears the threshold over a small BLOCK of texels
+// each of which spawns its own sprite, stops summing into a pattern with the grid's square as
+// its core. Two of these cost less than one of the stretch passes above.
+//
+// StreakParams0.xy is the texel step: (1/width, 0) horizontally, (0, 1/height) vertically.
+float3 HDRDiffractionSourceBlurPS(vtxOut IN) : SV_Target
+{
+	const float2 vStep = StreakParams0.xy;
+
+	// exp(-x^2 / 2) at x = 0, 1, 2, normalised: 0.40262, 0.24420, 0.05449.
+	const float w0 = 0.40262f;
+	const float w1 = 0.24420f;
+	const float w2 = 0.05449f;
+
+	float3 cSum = GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy, 0.0f).rgb * w0;
+	cSum += (GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy + vStep, 0.0f).rgb
+	       + GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy - vStep, 0.0f).rgb) * w1;
+	cSum += (GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy + 2.0f * vStep, 0.0f).rgb
+	       + GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy - 2.0f * vStep, 0.0f).rgb) * w2;
+
+	return cSum;
+}
