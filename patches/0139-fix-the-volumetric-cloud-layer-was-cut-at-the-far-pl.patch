diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.cpp
index 40d558d3..e9272394 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.cpp
@@ -141,7 +141,7 @@ struct SVolumetricCloudsShaderParam
 	f32      jitteredSamplingPosition;
 
 	Vec3     cloudOffset;
-	f32      padding1;
+	f32      skyRayUnclamped; // cloudBaseOffsetParams.w: 1.0 on the scene-referred path - sky rays are not clamped to the far plane (decisions/s9-cloud-edge.md); 0.0 stock (unused padding)
 
 	f32      maxGlobalCloudDensity;
 	f32      minRescaleCloudTexDensity;
@@ -1586,7 +1586,13 @@ void CVolumetricCloudsStage::GenerateCloudShaderParam(::VCCloudRenderContext& co
 			cb.jitteredSamplingPosition = VCGetVdC(iFrameCount);
 
 			cb.cloudOffset = Vec3(PF.pVolCloudTilingOffset.x, PF.pVolCloudTilingOffset.y, PF.pVolCloudTilingOffset.z - altitude);
-			cb.padding1 = 0.0f;
+			// Scene-referred: Clouds.cfx no longer clamps a SKY ray's march to the depth buffer. A sky
+			// pixel carries the far plane's depth and the far plane is not an occluder; clamped to it,
+			// the whole cloud layer was cut at asin((cloud base - camera) / ZF) above the horizon - a
+			// hard line across the sky that stock CRYENGINE 5.7.1 has too (verified against the pristine
+			// engine, research/s9-cloud-edge-root.md, decisions/s9-cloud-edge.md). Exactly 0.0 off the
+			// switch - a lane stock never reads.
+			cb.skyRayUnclamped = CRendererResources::IsSceneReferredStage(2) ? 1.0f : 0.0f;
 
 			cb.maxGlobalCloudDensity = cloudDensityParams.x;
 			cb.minRescaleCloudTexDensity = cloudDensityParams.y;
@@ -1704,8 +1710,16 @@ void CVolumetricCloudsStage::GenerateCloudShaderParam(::VCCloudRenderContext& co
 				const float mu = cb.sunLightDirection.z; // dot(float3(0,0,1), sunLightDir)
 				const float phaseRayleigh = cb.sunIntensityForAtmospheric * 3.0f / (16.0f * gf_PI) * (1.0f + mu * mu);
 				const float pathIntegral = 8.0e3f * (1.0f - expf(-(cb.altitude + cb.thickness) / 8.0e3f));
-				const Vec3 haze = cb.atmosphericScattering * (phaseRayleigh * pathIntegral);
+				// The shader's running attenuation exp(-beta * OD) makes the sum phaseRayleigh *
+				// (1 - exp(-beta * OD)) per channel, not beta * OD * phaseRayleigh: identical to 1 %
+				// at the zenith, but the first-order form over-reports by 45 % near the horizon
+				// (research/s9-cloud-haze-ratio.md s7), so carry the saturating form here.
+				const Vec3 beta = cb.atmosphericScattering;
+				const Vec3 haze(phaseRayleigh * (1.0f - expf(-beta.x * pathIntegral)),
+				                phaseRayleigh * (1.0f - expf(-beta.y * pathIntegral)),
+				                phaseRayleigh * (1.0f - expf(-beta.z * pathIntegral)));
 				m_srDebug.zenithHazeExposed = 0.2126f * haze.x + 0.7152f * haze.y + 0.0722f * haze.z;
+				m_srDebug.bSkyRayUnclamped = cb.skyRayUnclamped > 0.0f;
 			}
 		}
 
