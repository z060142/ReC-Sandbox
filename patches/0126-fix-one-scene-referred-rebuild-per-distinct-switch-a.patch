From e2f2ba8deabb1c26d2f7b427ba8eb6949eed5c2f Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Tue, 8 Sep 2026 19:53:58 +0800
Subject: [PATCH 126/174] fix: one scene-referred rebuild per distinct switch
 answer, not one per frame

SceneReferredFormatsChanged() compared each target's GetDstFormat() with the format the switch
asks for. If SetClosestFormatSupported() ever moved a requested format on some hardware, that
comparison would stay true after the rebuild and the pipeline would re-create the whole HDR and
post-FX map sets - and broadcast a stage Resize() - on every single frame. Under the old in-place
reformat that was a wasted comparison; now it is a per-frame rebuild, so it needs a stop.

CGraphicsPipelineResources remembers the format triple it last rebuilt with and answers false
immediately when the switch asks for the same triple again. A genuine flip changes the triple, so
it is unaffected; a level load and a resize never reach the rebuild at all because the creation
functions already resolve the right format.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HXzRVK4yBVDUNfdWXEwV5y
---
 .../GraphicsPipeline/Common/GraphicsPipeline.cpp  | 15 +++++++++++++++
 .../GraphicsPipeline/Common/GraphicsPipeline.h    |  8 ++++++++
 2 files changed, 23 insertions(+)

diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp
index 377cb1a4..231b4ec5 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp
@@ -520,6 +520,17 @@ bool CGraphicsPipelineResources::SceneReferredFormatsChanged() const
 	const ETEX_Format wantedSatellite = ResolveHDRSatelliteFormat();
 	const ETEX_Format wantedScaled    = ResolveDisplayTargetScaledFormat();
 
+	// Already rebuilt for exactly this triple? Then whatever still disagrees below disagrees
+	// because SetClosestFormatSupported() moved the request, not because the switch flipped, and
+	// rebuilding again would rebuild again next frame and every frame after that. One rebuild per
+	// distinct answer from the switch, not one per frame.
+	if (wantedMain      == m_lastBuiltHDRMainFormat &&
+	    wantedSatellite == m_lastBuiltHDRSatelliteFormat &&
+	    wantedScaled    == m_lastBuiltScaledFormat)
+	{
+		return false;
+	}
+
 	const std::pair<CTexture*, ETEX_Format> targets[] =
 	{
 		{ m_pTexHDRTarget,                  wantedMain      },
@@ -642,6 +653,10 @@ void CGraphicsPipelineResources::RecreateSceneReferredFormats()
 	CreateHDRMaps(m_resourceWidth, m_resourceHeight);
 	CreatePostFXMaps(m_resourceWidth, m_resourceHeight);
 
+	m_lastBuiltHDRMainFormat      = wantedMain;
+	m_lastBuiltHDRSatelliteFormat = wantedSatellite;
+	m_lastBuiltScaledFormat       = wantedScaled;
+
 	uint64 sizeAfter = 0;
 	for (const auto& entry : targets)
 	{
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.h b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.h
index 7e54992d..7a8cb976 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.h
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.h
@@ -154,6 +154,14 @@ public:
 	//! stage Resize() broadcast. Render thread, before anything is prepared.
 	void RecreateSceneReferredFormats();
 
+	//! Scene-referred pipeline: the format triple RecreateSceneReferredFormats() last built with.
+	//! A rebuild is only attempted when the triple the switch asks for differs from this, so a
+	//! target whose requested format never survives SetClosestFormatSupported() costs one rebuild
+	//! and not one per frame forever. eTF_Unknown = never rebuilt.
+	ETEX_Format m_lastBuiltHDRMainFormat      = eTF_Unknown;
+	ETEX_Format m_lastBuiltHDRSatelliteFormat = eTF_Unknown;
+	ETEX_Format m_lastBuiltScaledFormat       = eTF_Unknown;
+
 	//! Scene-referred pipeline: the last state this pipeline logged the switch in, so the flip is
 	//! announced once per pipeline and not once per frame. -1 = nothing logged yet.
 	int m_nSceneReferredLogged = -1;
