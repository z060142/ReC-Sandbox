-	CEffectParam* pRequest = pPostMgr->GetByName("Global_User_SceneReferred");
+	// Resolved once at CPostEffectsMgr::Init(), not looked up by name here: this runs from the
+	// tone map and from the pipeline resource update on every frame, and GetByName() is a CRC
+	// plus a map lookup behind a one-entry per-thread cache that the other params keep evicting.
+	//
+	// The value read is the one CParamFloat::SyncMainWithRender() copied into this thread's slot
+	// at the frame boundary, so it is the request ccam made for THIS frame and it cannot change
+	// underneath a frame that has already started.
+	CEffectParam* pRequest = pPostMgr->GetSceneReferredParam();
 	return pRequest != nullptr && pRequest->GetParam() > 0.5f;
 }
 
