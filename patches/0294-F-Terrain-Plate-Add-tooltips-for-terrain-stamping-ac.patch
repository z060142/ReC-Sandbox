From e3e574e5478b8b495e6d74ec3441f7935019d689 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 2 Sep 2026 18:47:21 +0800
Subject: [PATCH 294/307] !F (Terrain Plate) Add tooltips for terrain stamping
 actions.

---
 .../DefaultComponents/Geometry/TerrainPlateComponent.cpp   | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index b7b48513..abb3a8eb 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -1008,8 +1008,15 @@ void STerrainPlateBakeGroup::Serialize(Serialization::IArchive& archive)
 
 	// The two stamps, beside the bake items they make permanent. An action button carries no data, so it needs no
 	// AddMember: FunctorActionButton's own Serialize is edit only, which is exactly this archive.
+	// ar.doc() documents the row just emitted - the only tooltip channel a member with no AddMember has.
 	archive(plate.m_stampHeightButton, "StampHeight", "Stamp Height");
+	archive.doc("Permanently writes the baked terrain height you see now into the level. The relief becomes ordinary "
+	            "terrain and stays after the plate is deleted. Bake Into Terrain is unticked afterwards, because the "
+	            "ground carries the shape itself now - the picture does not change.");
 	archive(plate.m_stampColourButton, "StampColour", "Stamp Colour");
+	archive.doc("Permanently writes the plate's terrain colour you see now into the level. Terrain Colour From Plate "
+	            "is unticked afterwards, because the ground carries the colour itself now - the picture does not "
+	            "change.");
 }
 
 // The Weld drawer. Edge Weld itself is a top level row, same as Bake Into Terrain above.
