+void CTerrainPlateComponent::OnTransformChanged()
+{
+	// Only the COMPONENT transform reaches this hook; moving or scaling the entity itself comes through
+	// ENTITY_EVENT_XFORM. Both end in the same place, and the once per frame throttle in
+	// RequestRegenerate keeps a dragged transform widget to one rebuild per frame.
+	if (m_pEntity == nullptr)
+		return;
+
+	RequestRegenerate();
+}
