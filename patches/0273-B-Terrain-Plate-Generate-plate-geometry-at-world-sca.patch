-Matrix34 CTerrainPlateComponent::GetPlateWorldTM() const
+Matrix34 CTerrainPlateComponent::GetPlateFrameTM() const
 {
 	if (m_pEntity == nullptr)
 		return Matrix34(IDENTITY);
 
+	// Built from the entity and the component transform rather than read back from the slot. Up to P40
+	// the two were the same matrix (CEntity::UpdateSlotForComponent copies the component transform into
+	// the slot local TM, so GetSlotWorldTM == GetWorldTM() * GetTransformMatrix()), but P41 overwrites
+	// the slot local TM with the scale-cancelling one, so the slot no longer carries the plate's size.
+	// This is the frame that does, and it is also the only one that exists before the slot does.
+	return m_pEntity->GetWorldTM() * GetTransformMatrix();
+}
+
+Vec3 CTerrainPlateComponent::GetMeshBuildScale() const
+{
+	// The size RegenerateMesh multiplied into the position stream. It equals GetWorldScale() except
+	// between a deferred transform and its flush, when the mesh is deliberately one size behind.
+	return Vec3(
+	  (fabs_tpl(m_lastWorldScale.x) > 0.0001f) ? m_lastWorldScale.x : 1.f,
+	  (fabs_tpl(m_lastWorldScale.y) > 0.0001f) ? m_lastWorldScale.y : 1.f,
+	  (fabs_tpl(m_lastWorldScale.z) > 0.0001f) ? m_lastWorldScale.z : 1.f);
+}
+
+Matrix34 CTerrainPlateComponent::GetPlateNodeTM() const
+{
+	// The design frame with the MESH's size divided out, column by column. Because the mesh is generated
+	// in world metres (P41), node * meshVertex == frame * unitVertex for every vertex, so the two
+	// matrices are interchangeable as long as each is fed the space it belongs to.
+	const Vec3 meshScale = GetMeshBuildScale();
+	Matrix34 nodeTM = GetPlateFrameTM();
+	nodeTM.SetColumn(0, nodeTM.GetColumn(0) / meshScale.x);
+	nodeTM.SetColumn(1, nodeTM.GetColumn(1) / meshScale.y);
+	nodeTM.SetColumn(2, nodeTM.GetColumn(2) / meshScale.z);
+	return nodeTM;
+}
+
+void CTerrainPlateComponent::ApplySlotScaleCompensation()
+{
+	// P41 / option A of reports/40. The renderer reconstructs the vertex normal as cross(T, B) in OBJECT
+	// space and then multiplies it by the object matrix (ModificatorVT.cfi:429, vertexLib.cfi:253), which
+	// tilts it by S^2 instead of S^-1 under a non-uniform scale - so no tangent stream can make a
+	// non-uniformly scaled node shade correctly. The cure is to leave no scale on the node: the mesh is
+	// generated in metres and the slot local transform is the component transform with the size the mesh
+	// was built at divided out, so
+	//     entityWorldTM * slotLocalTM == GetPlateNodeTM(), unit length columns whenever the mesh is
+	//     current.
+	// The user's workflow is untouched: the entity scale gizmo still sizes the plate, it just sizes the
+	// generated geometry now instead of the matrix.
+	//
+	// The one case where the columns are NOT unit is a deferred drag (Update During Drag off, or a baking
+	// plate riding the move batch): the entity is already at the new size and the mesh is still at the
+	// old one, so this puts the RATIO on the node and the plate keeps stretching live under the gizmo,
+	// exactly as it did before P41. The moment the rebuild lands the ratio is 1 again and the correct
+	// shading frame comes back. That is a deliberate trade: a wrong normal for the duration of a drag
+	// buys the user the immediate feedback the gizmo is for.
 	const int slotId = GetEntitySlotId();
-	if (slotId != IEntityComponent::EmptySlotId)
-		return m_pEntity->GetSlotWorldTM(slotId);
+	if (m_pEntity == nullptr || slotId == IEntityComponent::EmptySlotId)
+		return;
 
-	return m_pEntity->GetWorldTM() * GetTransformMatrix();
+	const Vec3 meshScale = GetMeshBuildScale();
+	Matrix34 slotLocalTM = GetTransformMatrix();
+	slotLocalTM.SetColumn(0, slotLocalTM.GetColumn(0) / meshScale.x);
+	slotLocalTM.SetColumn(1, slotLocalTM.GetColumn(1) / meshScale.y);
+	slotLocalTM.SetColumn(2, slotLocalTM.GetColumn(2) / meshScale.z);
+
+	m_pEntity->SetSlotLocalTM(slotId, slotLocalTM);
+
+	if (GetPlateDebugLevel() >= 1)
+	{
+		const Matrix34 slotWorldTM = m_pEntity->GetSlotWorldTM(slotId);
+		CryLog("TerrainPlate '%s': plate size %.3f x %.3f x %.3f m, mesh built at %.3f x %.3f x %.3f, "
+		       "node column lengths %.4f / %.4f / %.4f (1 = no scale on the node)",
+		       GetPlateName(), GetWorldScale().x, GetWorldScale().y, GetWorldScale().z,
+		       meshScale.x, meshScale.y, meshScale.z,
+		       slotWorldTM.GetColumn0().GetLength(), slotWorldTM.GetColumn1().GetLength(), slotWorldTM.GetColumn2().GetLength());
+	}
 }
 
