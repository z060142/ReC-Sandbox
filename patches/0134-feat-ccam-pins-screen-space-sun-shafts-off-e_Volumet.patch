+// ---------------------------------------------------------------------------
+// Sun shafts - retired on ReCS in favour of volumetric fog (2026-09-09).
+//
+// r_sunshafts defaults to 0 on ReCS, but the engine's sys_spec CVar groups
+// (Engine/Config/CVarGroups/sys_spec_PostProcessing.cfg, `r_SunShafts=2` in the [default]
+// block) re-apply the stock value at startup, so the code default alone is not seen. The cvar is
+// VF_DUMPTODISK and global (decisions/s0-master-switch.md), so the camera does not write it.
+// Instead it holds the OTHER input of the stage's gate: CSunShafts::Preprocess() runs only when
+// `SunShafts_Active` (published by CTimeOfDay::UpdateEnvLighting from the TOD's visibility
+// sliders) is > 0 AND the cvar is on. Pinning the parameter at 0 from here switches the stage off
+// through the bus every other camera effect already uses, whatever the cfg did to the cvar.
+//
+// The TOD rewrites the parameter on every UpdateEnvLighting() (time change, preset edit, our own
+// forced update in PublishSceneReferredConvention), so this is re-asserted per frame from the
+// plugin's BeforeFinalizeCamera hook - which runs AFTER the TOD update - not written once.
+// ---------------------------------------------------------------------------
+void CCinematicCameraComponent::ApplySunShaftsOff()
+{
+	if (!CanDriveRenderState())
+		return;
+
+	if (!m_bSunShaftsSaved)
+	{
+		gEnv->p3DEngine->GetPostEffectParam("SunShafts_Active", m_savedSunShaftsActive);
+		m_bSunShaftsSaved = true;
+		CryLog("[CinematicCamera] sun shafts off (retired in favour of volumetric fog)");
+	}
+
+	gEnv->p3DEngine->SetPostEffectParam("SunShafts_Active", 0.0f);
+}
+
+void CCinematicCameraComponent::RestoreSunShafts()
+{
+	if (!m_bSunShaftsSaved)
+		return;
+
+	// The saved value is the TOD's last publish before we took over; the TOD's next update
+	// overwrites it with the current sliders anyway.
+	gEnv->p3DEngine->SetPostEffectParam("SunShafts_Active", m_savedSunShaftsActive);
+	m_bSunShaftsSaved = false;
+}
+
 // ---------------------------------------------------------------------------
 // Exposure — called from CCinematicCameraPlugin::UpdateBeforeFinalizeCamera()
 // which runs AFTER ITimeOfDay::Update() so our write is the last one before render.
