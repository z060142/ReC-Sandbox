+
+	float3 vThickness;
+	vThickness.x = SVO_RT_CloudSunThickness(vPosAbs, SVO_CloudSunDir.xyz, fExtinction, param, 3.0f);
+	vThickness.y = fExtinction * fDensity * min(4000.0f, max(0.0f, (param.altitude + param.thickness) - vPosAbs.z));
+	vThickness.z = fExtinction * fDensity * min(4000.0f, max(0.0f, vPosAbs.z - param.altitude));
+	return vThickness;
+}
+
+// Marches the cloud layer along vDirN starting at vStartAbs. Returns false when there is nothing
+// to do (clouds off, the ray points down, or the ray never meets the layer). vInscatter is
+// EXPOSED radiance; fTransmittance is what is left of whatever lies behind the layer.
+bool SVO_RT_MarchClouds(in float3 vStartAbs, in float3 vDirN, out float3 vInscatter, out float fTransmittance)
+{
+	vInscatter = (float3)0.f;
+	fTransmittance = 1.f;
+
+	if (SVO_CloudParams0.x <= 0.f || vDirN.z <= 0.f)
+		return false;
+
+	const float fAltitude   = SVO_CloudParams0.y;
+	const float fThickness  = SVO_CloudParams0.z;
+	const float fScatter    = SVO_CloudParams1.x;
+	const float fExtinction = SVO_CloudParams1.y;
+	const float fPowder     = SVO_CloudParams1.z;
+	const float fRadius     = SVO_CloudParams1.w;
+
+	// ENABLE_ORIGIN_MOVE_WITH_CAMERA, as Clouds.cfx builds it: the spherical layer's centre
+	// follows the camera, so the layer is a shell of constant altitude around the viewer.
+	float3 vCentre = GetWorldViewPos();
+	vCentre.z = -fRadius;
+
+	const float2 vHit = vcGetIntersectionWithCloudLayer(vStartAbs, vDirN, fAltitude, fThickness, fRadius, vCentre);
+	float fEnd = min(SVO_CloudParams2.y, max(vHit.x, vHit.y));
+	const float fStart = max(min(vHit.x, vHit.y), 0.f);
+	fEnd = ((fEnd - fStart) > SVO_CloudParams2.z) ? (fStart + SVO_CloudParams2.z) : fEnd;
+
+	if (fStart >= fEnd)
+		return false;
+
+	const float fSteps = max(SVO_CloudParams2.x, 1.f);
+	const int   nSteps = (int)fSteps;
+
+	CloudGenParam param = SVO_RT_GetCloudGenParam();
+
+	// Clouds.cfx's own sun / sky / ground terms for this direction, from the same constants.
+	const float3 vSunDir = SVO_CloudSunDir.xyz;
+	const float3 cSun = SVO_CloudSunLight.xyz;
+	const float  fDotLE = dot(vDirN, vSunDir);
+
+	const float fAngle = acos_fast(fDotLE) * ONE_OVER_PI;
+	const float fMieNorm = 1.0f / 12.71f;
+	const float3 vMiePhase = SVO_CloudMiePhaseTex.SampleLevel(SampStateTrilinearClamp, float2(fAngle, 0.f), 0.f).rgb
+	                         * SVO_CloudScatterParams.x * fMieNorm;
+
+	const float g = SVO_CloudScatterParams.z;
+	const float fMultiPhase = GetVolumetricFogInscatteringSchlickPhaseFunction(fDotLE, g, 1.f - g * g);
+	const float3 cSunLight = (cSun * vMiePhase) + (SVO_CloudScatterParams.y * fMultiPhase) * cSun;
+	const float3 cSunHigh = (SVO_CloudScatterParams.w * (0.25f * ONE_OVER_PI)) * cSun;
+
+	const float3 vSkyRayleigh = SVO_CloudSkyLight.xyz;
+	const float3 cGroundSrc = (saturate(vSunDir.z) * cSun) + vSkyRayleigh;
+	const float3 cGroundLight = SVO_CloudGroundLight.w * (0.25f * ONE_OVER_PI) * cGroundSrc * SVO_CloudGroundLight.xyz;
+	const float3 cSkyLight = SVO_CloudSkyLight.w * (0.25f * ONE_OVER_PI) * vSkyRayleigh;
+
+	const float fMsAttenuation = SVO_CloudMultiScatter.x;
+	const float fMsPreservation = SVO_CloudMultiScatter.y;
+
+	float fTotalThickness = 0.f;
+
+	[loop] for (int i = 0; i < nSteps; ++i)
+	{
+		if (fTransmittance < 0.01f)
+			break;
+
+		const float d = vcGetLinearDepth((float)i, fSteps, fStart, fEnd);
+		const float dNext = vcGetLinearDepth((float)i + 1.f, fSteps, fStart, fEnd);
+		const float fStepSize = dNext - d;
+
+		float3 vPosAbs = vStartAbs + vDirN * d;
+		// ENABLE_SPHERICAL_CLOUD_LAYER: the density field is evaluated in the flattened space of
+		// the shell, exactly as the direct view evaluates it.
+		vPosAbs = vcTranslateWorldPosToCloudPos(vPosAbs, vCentre, fRadius, fAltitude);
+
+		const float fDensity = GetCloudDensity(vPosAbs, param);
+		if (fDensity <= 0.f)
+			continue;
+
+		const float3 vOptThickness = SVO_RT_CloudOpticalThickness(vPosAbs, fDensity, fExtinction, param);
+
+		const float fShadow       = exp(-vOptThickness.x);
+		const float fSkyShadow    = lerp(fMsPreservation, 0.f, exp(-vOptThickness.y * fMsAttenuation));
+		const float fGroundShadow = lerp(fMsPreservation, 0.f, exp(-vOptThickness.z * fMsAttenuation));
+
+		fTotalThickness += fExtinction * fDensity * fStepSize;
+		const float fPowderEffect = 1.f - exp(-fTotalThickness * fPowder);
+
+		const float fSigmaS = fScatter * fDensity;
+		float3 S = fSigmaS * (fShadow * cSunLight + fSkyShadow * cSunHigh + fSkyShadow * cSkyLight + fGroundShadow * cGroundLight);
+		S *= fPowderEffect;
+
+		const float muE = max(0.000000001f, fExtinction * fDensity);
+		const float trns = exp(-muE * fStepSize);
+		const float3 Sint = ((-S * trns) + S) / muE;
+
+		vInscatter += fTransmittance * Sint;
+		fTransmittance *= trns;
+	}
+
+	return true;
+}
+
