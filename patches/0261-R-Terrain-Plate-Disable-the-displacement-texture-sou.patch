From d5194bd6cdb6e6491fd1fb71584d0ae0b0433ddc Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 2 Sep 2026 05:13:53 +0800
Subject: [PATCH 261/307] !R (Terrain Plate) Disable the displacement texture
 source.

Force Terrain Plates to use the heightmap-file source and remove the displacement
selector from serialization and the property panel. Keep the loader code in
place for possible future use.
---
 .../Geometry/TerrainPlateComponent.cpp        | 25 ++++++++++++-------
 .../Geometry/TerrainPlateComponent.h          | 13 +++++++---
 2 files changed, 25 insertions(+), 13 deletions(-)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index 511aa70c..865a4fc6 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -1343,7 +1343,15 @@ void CTerrainPlateComponent::FlushDeferredTransform()
 
 void CTerrainPlateComponent::LoadSourceIfNeeded()
 {
-	const string& path = (m_sourceMode == ETerrainPlateSource::HeightmapFile) ? m_heightmapPath.value : m_displacementPath.value;
+	// Displacement source parked per user 2026-09-01 - see reports/32. Source Mode and Displacement
+	// Texture are off the panel and out of the archive, so m_sourceMode can only be HeightmapFile on a
+	// new plate; it is forced here as well so that an object which somehow still carries the old value
+	// (a Schematyc default kept alive in memory, a prefab library entry) loads its heightmap instead of
+	// silently producing a flat plate. TerrainPlateLoader::LoadDisplacementTexture itself is left
+	// compiled and reachable through the header, only nothing calls it any more.
+	m_sourceMode = ETerrainPlateSource::HeightmapFile;
+
+	const string& path = m_heightmapPath.value;
 
 	if (m_bSourceLoaded && m_loadedSourceMode == m_sourceMode && m_loadedSource == path)
 		return;
@@ -1352,14 +1360,13 @@ void CTerrainPlateComponent::LoadSourceIfNeeded()
 
 	if (!path.empty())
 	{
-		if (m_sourceMode == ETerrainPlateSource::HeightmapFile)
-		{
-			TerrainPlateLoader::LoadHeightmapFile(path.c_str(), m_heightField);
-		}
-		else
-		{
-			TerrainPlateLoader::LoadDisplacementTexture(path.c_str(), m_heightField);
-		}
+		TerrainPlateLoader::LoadHeightmapFile(path.c_str(), m_heightField);
+
+		// The parked branch, kept verbatim so un-parking is a two line job:
+		//   if (m_sourceMode == ETerrainPlateSource::HeightmapFile)
+		//     TerrainPlateLoader::LoadHeightmapFile(path.c_str(), m_heightField);
+		//   else
+		//     TerrainPlateLoader::LoadDisplacementTexture(path.c_str(), m_heightField);
 	}
 
 	m_loadedSource = path;
diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
index 1c009f6b..6351a969 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
@@ -203,7 +203,7 @@ public:
 		desc.SetGUID("{3F1D8B4A-6C2E-4E9F-9A21-7B5C0D4E8A13}"_cry_guid);
 		desc.SetEditorCategory("Geometry");
 		desc.SetLabel("Terrain Plate");
-		desc.SetDescription("A procedural relief plate built from a heightmap or a displacement texture, meant to be merged into the terrain. "
+		desc.SetDescription("A procedural relief plate built from a heightmap file, meant to be merged into the terrain. "
 		                   "The plate is a unit plate: 1 x 1 m in XY and 0..1 m of relief; its size and height in the world come from the "
 		                   "entity or component transform scale (X/Y = size, Z = height of the relief).");
 		desc.SetIcon("icons:ObjectTypes/object.ico");
@@ -218,9 +218,14 @@ public:
 		               "Determines the behavior of the generated mesh. Collider gives the plate its own static physics, so it can be "
 		               "walked on and collided with without any physics component on the entity.", EMeshType::RenderAndCollider);
 
-		desc.AddMember(&CTerrainPlateComponent::m_sourceMode, 'srcm', "SourceMode", "Source Mode", "Whether the relief comes from a heightmap file or from a displacement texture", ETerrainPlateSource::HeightmapFile);
-		desc.AddMember(&CTerrainPlateComponent::m_heightmapPath, 'hmap', "HeightmapFile", "Heightmap File", "16 bit raw/r16 (headerless, square), binary PGM (P5) or uncompressed BMP. Used when Source Mode is Heightmap File.", Schematyc::TerrainHeightmapFileName());
-		desc.AddMember(&CTerrainPlateComponent::m_displacementPath, 'dtex', "DisplacementTexture", "Displacement Texture", "Uncompressed DDS (R8, R16, R16F, R32F, RGBA8/BGRA8). Compressed formats cannot be read on the CPU and give a flat plate. Used when Source Mode is Displacement Texture.", Schematyc::TextureFileName());
+		// Displacement source parked per user 2026-09-01 - see reports/32. The displacement texture path
+		// never worked well enough to be useful and nobody needs it now, so Source Mode and Displacement
+		// Texture lose BOTH their panel row and their persistence: with no AddMember the archive skips
+		// them, an old level that saved SourceMode = DisplacementTexture simply does not restore it, and
+		// m_sourceMode stays at its HeightmapFile default. The heightmap file row below is untouched.
+		//desc.AddMember(&CTerrainPlateComponent::m_sourceMode, 'srcm', "SourceMode", "Source Mode", "Whether the relief comes from a heightmap file or from a displacement texture", ETerrainPlateSource::HeightmapFile);
+		desc.AddMember(&CTerrainPlateComponent::m_heightmapPath, 'hmap', "HeightmapFile", "Heightmap File", "16 bit raw/r16 (headerless, square), binary PGM (P5) or uncompressed BMP.", Schematyc::TerrainHeightmapFileName());
+		//desc.AddMember(&CTerrainPlateComponent::m_displacementPath, 'dtex', "DisplacementTexture", "Displacement Texture", "Uncompressed DDS (R8, R16, R16F, R32F, RGBA8/BGRA8). Compressed formats cannot be read on the CPU and give a flat plate. Used when Source Mode is Displacement Texture.", Schematyc::TextureFileName());
 		desc.AddMember(&CTerrainPlateComponent::m_materialPath, 'mat', "Material", "Material", "Material of the plate. Empty uses the engine default material; the plate needs a material to be picked up by terrain integration.", "");
 
 		desc.AddMember(&CTerrainPlateComponent::m_gridMode, 'gmod', "GridMode", "Grid Mode",
-- 
