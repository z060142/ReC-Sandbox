index 2c08915a..ae9926bc 100644
--- a/Code/CryEngine/Cry3DEngine/3dEngine.cpp
+++ b/Code/CryEngine/Cry3DEngine/3dEngine.cpp
@@ -4446,6 +4446,15 @@ void C3DEngine::SetGlobalParameter(E3DEngineParameter param, const Vec3& v)
 	case E3DPARAM_SKYBOX_MULTIPLIER:
 		m_skyboxMultiplier = v.x;
 		break;
+
+	// Scene-referred pipeline (SceneReferredSpec.md S2, decisions/s2-engine-side-switch.md
+	// approach A). A plain store: the caller (the Cinematic Camera) is responsible for forcing
+	// the time-of-day re-evaluation that recomputes everything keyed on it, because the values
+	// it selects are cached in m_vSunColor / E3DPARAM_SKY_SKYBOX_EMITTANCE / the volumetric
+	// cloud globals until the next TOD update.
+	case E3DPARAM_SCENE_REFERRED:
+		m_bSceneReferred = (v.x > 0.5f);
+		break;
 	case E3DPARAM_DAY_NIGHT_INDICATOR:
 		m_dayNightIndicator = v.x;
 		REINST(Set daylight parameter)
@@ -4722,6 +4731,10 @@ void C3DEngine::GetGlobalParameter(E3DEngineParameter param, Vec3& v)
 	case E3DPARAM_SKYBOX_MULTIPLIER:
 		v = Vec3(m_skyboxMultiplier, 0, 0);
 		break;
+
+	case E3DPARAM_SCENE_REFERRED:
+		v = Vec3(m_bSceneReferred ? 1.0f : 0.0f, 0, 0);
+		break;
 	case E3DPARAM_DAY_NIGHT_INDICATOR:
 		v = Vec3(m_dayNightIndicator, 0, 0);
 		break;
