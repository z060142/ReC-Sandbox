index 8c7fba9b..c84cbcaa 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/DriverD3D.h
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/DriverD3D.h
@@ -261,6 +261,12 @@ public:
 	//! at sample time through the tint hook - decisions/s1-probe-exposure.md approach A).
 	void         LatchSceneReferredExposure(uint32 shaderRenderingFlags);
 
+	//! The latched BRDF normalisation factor for the render thread's current frame: 1.0f on the
+	//! stock path, 1/PI on the scene-referred path, where the lights are radiometric and the
+	//! BRDF carries the 1/PI instead (SceneReferredSpec.md D4). Latched with the exposure so a
+	//! frame can never mix a new sun with an old BRDF.
+	float        GetSceneReferredBRDFFactor() const { return m_fSceneReferredBRDFFactor[GetRenderThreadID()]; }
+
 	//! The latched pre-exposure for the render thread's current frame. 1.0f off the switch.
 	float        GetSceneReferredExposure() const { return m_fSceneReferredExposure[GetRenderThreadID()]; }
 	virtual void RT_PostRenderScene(CRenderView* pRenderView) final;
@@ -719,6 +725,13 @@ public:
 	// keeps the value every engine initialiser writes.
 	float              m_fSceneReferredExposure[RT_COMMAND_BUF_COUNT];
 
+	// The 1/PI that the scene-referred path moves out of the light side and into the BRDF
+	// (SceneReferredSpec.md D4). Latched together with the exposure above, so that one frame
+	// carries exactly one light-unit convention. Exactly 1.0f off the switch, and the shader
+	// constant that carries it is stored offset by one, so the stock path multiplies by an
+	// exact 1.0 and stays bit-identical.
+	float              m_fSceneReferredBRDFFactor[RT_COMMAND_BUF_COUNT];
+
 	int                m_MaxAnisotropyLevel;
 	SamplerStateHandle m_nMaterialAnisoHighSampler;
 	SamplerStateHandle m_nMaterialAnisoLowSampler;
