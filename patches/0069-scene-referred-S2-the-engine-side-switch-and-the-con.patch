+++ b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.h
@@ -1017,6 +1017,10 @@ private:
 	//! whole picture, so it has to be visible while the properties are being tuned.
 	void ApplySceneReferred();
 	void RestoreSceneReferred();
+	//! Mirror the switch into the 3D engine (E3DPARAM_SCENE_REFERRED) and, on a flip, force a
+	//! full time-of-day re-evaluation and sky-dome recompute so nothing stays cached or
+	//! mid-crossfade. See SceneReferredSpec.md S2 / decisions/s2-engine-side-switch.md.
+	void PublishSceneReferredConvention(bool bSceneReferred);
 	//! The camera's pre-exposure for this frame, published as a linear scale next to the request
 	//! above (Global_User_SceneExposure). Editor-live for the same reason.
 	void ApplySceneExposure();
