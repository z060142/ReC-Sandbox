+++ b/Code/CryEngine/Cry3DEngine/3dEngine.h
@@ -836,6 +836,11 @@ public:
 	float                 m_oceanFogDensity;
 	float                 m_skyboxMultiplier;
 	float                 m_dayNightIndicator;
+
+	//! Scene-referred pipeline (SceneReferredSpec.md S2): the 3DEngine-visible mirror of the
+	//! renderer's r_SceneReferred switch, set through E3DPARAM_SCENE_REFERRED. See
+	//! IsSceneReferredConvention().
+	bool                  m_bSceneReferred = false;
 	bool                  m_bHeightMapAoEnabled;
 	bool                  m_bIntegrateObjectsIntoTerrain;
 	bool                  m_supportOfflineProceduralVegetation = false;
@@ -1083,6 +1088,13 @@ public:
 	virtual void                     SetGlobalParameter(E3DEngineParameter param, const Vec3& v);
 	using I3DEngine::GetGlobalParameter;
 	virtual void                     GetGlobalParameter(E3DEngineParameter param, Vec3& v);
+
+	//! Scene-referred pipeline (SceneReferredSpec.md D4, S2). True while the Cinematic Camera's
+	//! scene-referred path is active, as published through E3DPARAM_SCENE_REFERRED. It selects
+	//! the light-unit convention on the 3DEngine side of the renderer boundary: all lights
+	//! radiometric with the 1/PI in the BRDF, instead of the sun being pre-divided by PI.
+	//! False is the stock engine, byte for byte.
+	bool                             IsSceneReferredConvention() const { return m_bSceneReferred; }
 	virtual void                     SetShadowMode(EShadowMode shadowMode) { m_eShadowMode = shadowMode; }
 	virtual EShadowMode              GetShadowMode() const                 { return m_eShadowMode; }
 	virtual void                     AddPerObjectShadow(IShadowCaster* pCaster, float fConstBias, float fSlopeBias, float fJitter, const Vec3& vBBoxScale, uint nTexSize);
diff --git a/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h b/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h
index 8303a461..ac86e6d4 100644
--- a/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h
+++ b/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h
@@ -155,7 +155,18 @@ enum E3DEngineParameter
 
 	E3DPARAM_COLORGRADING_FILTERS_PHOTOFILTER_COLOR,
 	E3DPARAM_COLORGRADING_FILTERS_PHOTOFILTER_DENSITY,
-	E3DPARAM_COLORGRADING_FILTERS_GRAIN
+	E3DPARAM_COLORGRADING_FILTERS_GRAIN,
+
+	//! Scene-referred pipeline (Code/CryPlugins/CinematicCamera/SceneReferredSpec.md, stage S2).
+	//! A 3DEngine-visible mirror of the renderer's r_SceneReferred switch, written by the
+	//! Cinematic Camera once per frame (0 = stock, 1 = scene-referred). The 3D engine cannot
+	//! read renderer cvars, yet four unit decisions live on this side of the boundary and are
+	//! cached until the next time-of-day update: the sun's illuminance-to-radiance divide by PI,
+	//! the volumetric-cloud replication of it, the legacy .tod migration's multiply by PI and
+	//! the Nishita sun-intensity scale. Whoever flips this parameter must force a full
+	//! ITimeOfDay::Update(true, true) in the same call, or those values stay stale.
+	//! Only .x is used, as a boolean (> 0.5).
+	E3DPARAM_SCENE_REFERRED
 };
 
 enum EShadowMode
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/D3DRendPipeline.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/D3DRendPipeline.cpp
index bc0c60a4..5c564c5c 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/D3DRendPipeline.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/D3DRendPipeline.cpp
@@ -604,6 +604,19 @@ void CD3D9Renderer::LatchSceneReferredExposure(uint32 shaderRenderingFlags)
 
 	m_fSceneReferredExposure[GetRenderThreadID()] = exposure;
 	m_fAdaptedSceneScaleLBuffer = exposure;
+
+	// The light-unit convention is latched HERE, next to the exposure, and for the same reason:
+	// one convention per frame (SceneReferredSpec.md D4, decisions/s2-engine-side-switch.md).
+	// The sun's colour is computed on the main thread inside CTimeOfDay::Update while the render
+	// thread is a frame behind, so a flip of the switch could otherwise put the new sun (no
+	// divide by PI) in front of the old BRDF (no 1/PI) - a frame PI times too bright - or the
+	// reverse, a frame PI times too dark.
+	//
+	// Unlike the exposure this is NOT forced to unity for cube-map generation: a probe must be
+	// baked under the same convention the scene is lit with, which is the whole point of the
+	// _rec suffix in decisions/s2-preset-and-probes.md. It is the exposure that must not be
+	// baked in, not the convention.
+	m_fSceneReferredBRDFFactor[GetRenderThreadID()] = CRendererResources::IsSceneReferred() ? (1.0f / gf_PI) : 1.0f;
 }
 
