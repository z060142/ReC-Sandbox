+//! Implemented by any component that owns geometry the level editor should be able to frame, click
+//! and edit - a shape volume, a spline, a decal projector, an emitter's region. It is the Sandbox
+//! side of O3DE's "component mode" contract, kept deliberately generic: nothing here knows what the
+//! geometry *is*, only that it has bounds, that a ray can hit it, and that some edit tool owns it.
+//!
+//! Like IEditorEntityComponent above, it is a *reflected* interface base: implementations pull it
+//! in with desc.AddBase<IEditorShapeComponent>(), which is what lets the editor find them across a
+//! DLL boundary with IEntity::QueryComponentsByInterfaceID() / GetAllComponents<>().
+//!
+//! Consumers in 5.7.1: CEntityObject::GetLocalBounds (framing, rubber-band selection through
+//! GetBoundBox), CEntityObject::HitTest (click the geometry to select the entity) and
+//! CEntityObject's inspector, which emits one "edit tool" button row per component that names a
+//! tool. Entities with no such component take the legacy path unchanged.
+//!
+//! ABI: append-only. Every method here is called from EditorQt against an implementation that
+//! lives in another DLL, so new virtuals go at the END and existing ones never change signature.
+struct IEditorShapeComponent : public IEntityComponent
+{
+	static void ReflectType(Schematyc::CTypeDesc<IEditorShapeComponent>& desc)
+	{
+		desc.SetGUID("{3C8D5E14-7A96-4B20-9F41-8E0D2B75A6C3}"_cry_guid);
+	}
+
+	//! Bounds of the geometry in the ENTITY's local space (the component's own transform, if it has
+	//! one, already applied). Return false when there is nothing to contribute, and the editor's
+	//! bounding box is left exactly as the legacy slot walk computed it.
+	virtual bool        GetEditorLocalBounds(AABB& out) const = 0;
+
+	//! Ray/geometry test in WORLD space for viewport picking. `tolerance` is a world-space distance
+	//! the caller derived from the viewport (screen scale factor + selection tolerance), so that
+	//! wireframe edges stay clickable at any zoom. On success `distOut` is the distance from
+	//! worldRay.origin along a normalised worldRay.direction.
+	virtual bool        EditorHitTest(const Ray& worldRay, float tolerance, float& distOut) const = 0;
+
+	//! Class name of the CEditTool that edits this geometry, e.g. "EditTool.AreaShapeEdit", or
+	//! nullptr when the component has no edit mode. A non-null name makes the inspector show a
+	//! button row that starts the tool for THIS component instance.
+	virtual const char* GetEditToolClassName() const = 0;
+
+	//! Label of that button row, e.g. "Edit Shape". Never null when GetEditToolClassName() is not.
+	virtual const char* GetEditToolLabel() const = 0;
+};
+
+//! What the inspector's edit-tool button hands to the tool through CEditTool::SetUserData().
+//!
+//! CEditTool::SetUserData() takes a single (key, void*) pair and Serialization::SEditToolButton
+//! calls it exactly once, so the two identities the tool needs - which editor object, which
+//! component instance - travel together in this one struct instead of in two calls. Both are
+//! GUIDs, never raw pointers: the tool re-resolves the object through IObjectManager::FindObject
+//! and the component through IEntity::GetComponentByGUID every time it touches them, so a deleted
+//! or re-created object can never be dereferenced (MEMORY.md, fix bde12cd8).
+//!
+//! The pointer handed over stays owned by EditorQt and is valid for the lifetime of the editor
+//! session; the tool copies the two GUIDs out of it and keeps no pointer to it.
+struct SEntityComponentEditToolTarget
+{
+	//! The key EditorQt passes to CEditTool::SetUserData() with a pointer to this struct.
+	static const char* GetUserDataKey() { return "entityComponentEditTarget"; }
+
+	//! CBaseObject::GetId() of the editor object that owns the entity.
+	CryGUID objectGuid;
+	//! IEntityComponent::GetGUID(), i.e. the per-instance GUID of the component being edited.
+	CryGUID componentGuid;
+};
