From 105147f398c94dc36faaac8f0506a33a0ff6cc63 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sat, 12 Sep 2026 15:40:04 +0800
Subject: [PATCH 218/221] refactor(area): drop the road's unused ForceRebuild

Written for the terrain-alignment action to call, then found unnecessary:
CTerrain::SetTerrainElevation already collects every eERType_Road node inside the
changed rectangle and calls CRoadRenderNode::OnTerrainChanged on it
(terran_edit.cpp:407-421), which re-projects the road mesh onto the new heights.
The component's nodes are ordinary octree-registered road nodes, so they are in
that list.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SCUvWGLCsqzm3VNMzp4uiS
---
 .../AreaComponents/Module/Functions/RoadComponent.cpp      | 7 -------
 .../AreaComponents/Module/Functions/RoadComponent.h        | 4 ----
 2 files changed, 11 deletions(-)

diff --git a/Code/CryPlugins/AreaComponents/Module/Functions/RoadComponent.cpp b/Code/CryPlugins/AreaComponents/Module/Functions/RoadComponent.cpp
index 1ab4e0bc..0697afcf 100644
--- a/Code/CryPlugins/AreaComponents/Module/Functions/RoadComponent.cpp
+++ b/Code/CryPlugins/AreaComponents/Module/Functions/RoadComponent.cpp
@@ -372,13 +372,6 @@ void CRoadComponent::RebuildIfNeeded(bool bForce)
 	BuildNodes();
 }
 
-void CRoadComponent::ForceRebuild()
-{
-	// The terrain moved under the road, so the drape has to be recomputed even though nothing the
-	// digest watches has changed.
-	RebuildIfNeeded(true);
-}
-
 // ---------------------------------------------------------------------------
 // Events
 // ---------------------------------------------------------------------------
diff --git a/Code/CryPlugins/AreaComponents/Module/Functions/RoadComponent.h b/Code/CryPlugins/AreaComponents/Module/Functions/RoadComponent.h
index e5629239..f77d0ee8 100644
--- a/Code/CryPlugins/AreaComponents/Module/Functions/RoadComponent.h
+++ b/Code/CryPlugins/AreaComponents/Module/Functions/RoadComponent.h
@@ -89,10 +89,6 @@ public:
 	virtual void OnShapeChanged(IShapeComponent& shape, EShapeChangeReason reason) override;
 	// ~IShapeListener
 
-	//! The editor tool calls this after it has moved the terrain, so that the road re-drapes over
-	//! the new heights in the same step rather than on the next edit.
-	void ForceRebuild();
-
 protected:
 	// IEntityComponent
 	virtual void                    Initialize() override;
