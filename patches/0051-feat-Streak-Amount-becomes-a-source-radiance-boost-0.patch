@@ -36,6 +36,10 @@ const float kLambda0 = 550e-9f;
 //! would be added to the picture a second time.
 const float kCoreAiryRadii = 2.5f;
 
+//! Radius, in Airy radii, past which the pattern is what the viewer actually calls "the rays":
+//! far enough out that the source's own bloom no longer covers it. Diagnostics only.
+const float kFarAiryRadii = 20.0f;
+
 //! Width of the boundary ring the far-field extrapolation is read off, in texels.
 const float kRingWidth = 4.0f;
 
@@ -469,7 +473,15 @@ void CDiffractionKernel::BuildJob()
 	const float fAiryRadius = 1.22f * (float)L / (float)d;
 	const float fCoreRadius = kCoreAiryRadii * fAiryRadius;
 	const float fCoreRadiusSq = fCoreRadius * fCoreRadius;
+
+	// Where the VISIBLE rays live. The core and the first few Airy rings sit under the source's
+	// own bloom and are never read as a sunstar; what the eye calls "the rays" is everything
+	// further out than a couple of dozen Airy radii. Measuring that share separately is the only
+	// honest answer to "why do I see nothing at amount 1".
+	const float fFarRadius = kFarAiryRadii * fAiryRadius;
+	const float fFarRadiusSq = fFarRadius * fFarRadius;
 	double fCore = 0.0;
+	double fFar = 0.0;
 	for (int iy = 0; iy < L; ++iy)
 	{
 		const float dy = (float)iy + 0.5f - fCentre;
@@ -505,7 +517,11 @@ void CDiffractionKernel::BuildJob()
 			// Only what the texture will actually be sampled inside counts toward its integral;
 			// past R_tex the shader uses the extrapolation, not these texels.
 			if (r2 <= fRingRadius * fRingRadius)
+			{
 				fTexIntegral += (double)I;
+				if (r2 >= fFarRadiusSq)
+					fFar += (double)I;
+			}
 
 			if (r2 >= fRingInner * fRingInner && r2 <= fRingRadius * fRingRadius)
 			{
@@ -594,6 +610,7 @@ void CDiffractionKernel::BuildJob()
 	m_resultTailCoefficient = (float)(2.0 * PI * fRingMean * (double)fRingRadius * (double)fRingRadius);
 	m_resultIntegral = (float)fTexIntegral;
 	m_resultCoreFraction = (float)fCore;
+	m_resultFarFraction = (float)fFar;
 	m_resultJobMs = (gEnv->pTimer->GetAsyncTime() - tStart).GetMilliSeconds();
 }
 
@@ -672,17 +689,24 @@ void CDiffractionKernel::UploadResult(const char* szNameSuffix)
 	m_fTextureIntegral = m_resultIntegral;
 	m_fTailCoefficient = m_resultTailCoefficient;
 	m_fCoreFraction = m_resultCoreFraction;
+	m_fFarFraction = m_resultFarFraction;
 
 	// The physical glare fraction is what is NOT in the core: the pattern was Parseval-normalised
 	// to the pupil's whole transmitted light before the core was cut out, so 1 - core is the
 	// share of a source's light that really leaves it as glare. That is what amount 1 deposits
 	// (bar the part of the tail the sprite is too small to hold - the glare pass logs the number
 	// it actually deposits).
-	CryLog("[BLOOM] diffraction kernel blades=%.0f exp=%.2f phase=%.0f mask=%s maskRot=%.0f maskScale=%.2f sa=%.2f -> core=%.2f tail=%.3g physical glare fraction = %.3f L=%d (job %.1f ms)",
+	// E_far is the part of that fraction which lands OUTSIDE the first kFarAiryRadii Airy radii -
+	// the rays as a viewer sees them, with the core and the inner rings (which hide under the
+	// source's own bloom) excluded. It is typically a few parts in a thousand, spread over
+	// hundreds of pixels, which is why the physically exact amount of 1 shows almost nothing and
+	// why Streak Amount is a source-radiance boost rather than a fudge factor.
+	CryLog("[BLOOM] diffraction kernel blades=%.0f exp=%.2f phase=%.0f mask=%s maskRot=%.0f maskScale=%.2f sa=%.2f -> core=%.2f tail=%.3g physical glare fraction = %.3f E_far(>%.0f Airy) = %.4f L=%d (job %.1f ms)",
 	       m_builtDesc.fBlades, m_builtDesc.fExponent, RAD2DEG(m_builtDesc.fPhase),
 	       m_builtDesc.maskName.empty() ? "none" : m_builtDesc.maskName.c_str(),
 	       RAD2DEG(m_builtDesc.fMaskRotation), m_builtDesc.fIrisRadius, m_builtDesc.fKsa,
-	       m_fCoreFraction, m_fTailCoefficient, 1.0f - m_fCoreFraction, L, m_resultJobMs);
+	       m_fCoreFraction, m_fTailCoefficient, 1.0f - m_fCoreFraction, kFarAiryRadii, m_fFarFraction,
+	       L, m_resultJobMs);
 	CryLog("[BLOOM] diffraction kernel mip chain: %d levels (%d..1), %.0f KB", m_nKernelMips, L,
 	       (float)(m_resultKernel.size() * sizeof(uint16)) / 1024.0f);
 }
