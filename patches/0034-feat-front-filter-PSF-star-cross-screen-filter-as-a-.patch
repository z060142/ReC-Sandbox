+// Front filter point spread function (FilterPSFSpec.md).
+//
+// A star / cross-screen filter is a plate of etched grooves in FRONT of the lens: every bright
+// point in the frame is convolved with one fixed pattern. The convolution is done sparsely -
+// one textured sprite per bright quarter-resolution texel, expanded from SV_VertexID with no
+// vertex stream at all, deposited additively into the bloom target. Nothing here follows the
+// iris: a plate is not the aperture, so there is no f-number term and no blade phase.
+
+float4 FilterPSFParams0;  // (sprite half extent x in NDC, half extent y in NDC, cos rotation, sin rotation)
+float4 FilterPSFParams1;  // (energy per unit of source excess, star point count, PSF texture bound 0/1, unused)
+
+Texture2D<float4> HDRFilterPSF_Src      : register(t0);  // thresholded quarter res source, vertex shader
+Texture2D<float4> HDRFilterPSF_Tex      : register(t1);  // authored PSF image, pixel shader
+SamplerState HDRFilterPSF_PClampSampler : register(s0);  // PointClamp
+SamplerState HDRFilterPSF_LClampSampler : register(s1);  // LinearClamp
+
+struct v2fFilterPSF
+{
+	float4 Position : SV_POSITION;
+	float4 QuadUV   : TEXCOORD0;  // xy: quad local, 0..1 across the sprite. zw unused.
+	float4 Color    : TEXCOORD1;  // rgb: this source's deposit. a unused.
+};
+
+v2fFilterPSF FilterPSFVS(uint nVertexID : SV_VertexID)
+{
+	v2fFilterPSF OUT = (v2fFilterPSF) 0;
+
