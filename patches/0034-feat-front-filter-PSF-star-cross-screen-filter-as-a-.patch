+
+// Procedural stand-in for an authored PSF: an N-point star with rainbow tips, so the filter is
+// testable and has a sane default. d is quad local in [-1, 1], the plate's rotation already
+// walked back out of it.
+float3 ProceduralStarPSF(float2 d, float fPoints)
+{
+	// N points come from N/2 LINES, each of which paints two opposed spikes - the same
+	// symmetry the iris diffraction streaks are built on.
+	const int nLines = clamp((int)(fPoints * 0.5), 2, 4);
+
+	float3 cSum = 0;
+
+	[loop] for (int j = 0; j < nLines; ++j)
+	{
+		const float fTheta = (float)j * (PI / (float)nLines);
+		const float fCos = cos(fTheta);
+		const float fSin = sin(fTheta);
+
+		const float fAlong = dot(d, float2(fCos, fSin));
+		const float fPerp  = dot(d, float2(-fSin, fCos));
+
+		// Thin across (the groove is a line), fading quadratically along its length so the
+		// tail runs out at the edge of the sprite instead of being cut off.
+		const float fAbsAlong = min(abs(fAlong), 1.0);
+		const float fLine = exp(-abs(fPerp) * 40.0) * pow(saturate(1.0 - fAbsAlong), 2.0);
+
+		// Dispersion: the groove is a grating, so the far end of each line is where the
+		// wavelengths have separated most. Red near the core, blue at the tips, washed back
+		// to white as the line approaches the source it came from.
+		const float3 cHue = (fAbsAlong < 0.5)
+			? lerp(float3(1.0, 0.25, 0.15), float3(0.35, 1.0, 0.30), fAbsAlong * 2.0)
+			: lerp(float3(0.35, 1.0, 0.30), float3(0.20, 0.35, 1.0), fAbsAlong * 2.0 - 1.0);
+
+		cSum += fLine * lerp(cHue, 1.0, saturate(1.0 - fAbsAlong));
+	}
+
+	// The undiffracted core: the plate passes most of the light straight through, so the
+	// source itself is still there under the star.
+	cSum += exp(-dot(d, d) * 60.0);
+
+	return cSum;
+}
+
+float4 FilterPSFPS(v2fFilterPSF IN) : SV_Target
+{
+	// Turning the plate turns the pattern, so the PSF is SAMPLED through the inverse
+	// rotation. Around the sprite centre, which is where the source sits.
+	const float2 vLocal = IN.QuadUV.xy * 2.0 - 1.0;
+	const float fCos = FilterPSFParams0.z;
+	const float fSin = FilterPSFParams0.w;
+	const float2 d = float2(vLocal.x * fCos + vLocal.y * fSin,
+	                       -vLocal.x * fSin + vLocal.y * fCos);
+
+	float3 cPSF;
+	if (FilterPSFParams1.z > 0.5)
+	{
+		// Authored plate: the pattern is exactly this image, centred, black outside itself.
+		cPSF = GetTexture2D(HDRFilterPSF_Tex, HDRFilterPSF_LClampSampler, d * 0.5 + 0.5).rgb;
+	}
+	else
+	{
+		cPSF = ProceduralStarPSF(d, FilterPSFParams1.y);
+	}
