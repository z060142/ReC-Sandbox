-// Change an existing render target's format WITHOUT destroying the CTexture object.
-//
-// The alternative - releasing the object and letting GetOrCreateRenderTarget build a new one -
-// looks simpler but is not safe here: the graphics-pipeline stages bind these targets inside
-// IsDirty() guards whose keys do not mention them (CToneMappingStage binds $HDRFinalBloom under
-// a key of sun-shafts / colour-chart / luminance texture IDs; CBloomStage's m_pass2V.IsDirty()
-// takes no arguments at all), so after a destroy-and-recreate the device layer would null their
-// bindings through the eResourceDestroyed callback and nothing would ever set them again.
-//
-// Swapping the device texture underneath the same object avoids that completely: every
-// CTexture* stays valid, and SetDevTexture() raises eDeviceResourceDirty, which marks every
-// resource set and device render pass holding this texture dirty so they rebuild their views.
-// That is the sanctioned path - it is what OwnDevTexture() exists for ("texture-config does
-// change").
-bool CTexture::ReformatRenderTarget(ETEX_Format eFormat)
-{
-	if (eFormat == eTF_Unknown || !(m_eFlags & FT_USAGE_RENDERTARGET))
-		return false;
-
-	m_eSrcFormat = eFormat;
-	SetClosestFormatSupported();
-
-	// A target that has been REGISTERED but not yet device-created has nothing to swap. Sandbox
-	// reaches this state routinely: every viewport, the material editor and the thumbnail renderer
-	// build their own CGraphicsPipelineResources, and a target whose pool entry has not run yet
-	// (or whose creation failed) sits there at 0x0 with m_pDevTexture == nullptr. Handing that to
-	// CreateDeviceTexture() would ask CDeviceTexture::Create() for a zero-sized resource.
-	//
-	// Setting the format fields above and returning is the right answer rather than a no-op:
-	// CreateRenderTarget() only assigns m_eSrcFormat while it is still eTF_Unknown, so the format
-	// written here is the one the target will be born with when the pool does create it.
-	if (!m_pDevTexture || m_nWidth <= 0 || m_nHeight <= 0)
-		return false;
-
-	// Release the old device texture BEFORE creating the new one, which is what
-	// CTexture::Invalidate() does for the identical case (a live render target whose format or
-	// size changed) and what SPostEffectsUtils::GetOrCreateRenderTarget() relies on. The first
-	// version of this function went straight to CreateDeviceTexture() and let SetDevTexture()
-	// drop the old one on the way past - but SetDevTexture() calls Release() on a device texture
-	// that FT_DONT_RELEASE has marked SetNoDelete(true), so the D3D resource was freed and the
-	// CDeviceTexture object was leaked on every flip of the switch. RT_ReleaseDeviceTexture()
-	// accounts for the memory, clears the owner and raises eDeviceResourceDirty - NOT
-	// eResourceDestroyed - so every resource set and render pass holding this CTexture rebuilds
-	// its views and no invalidation callback is dropped. The CTexture* itself never moves, which
-	// is the property the stages' IsDirty() guards depend on.
-	if (m_eFlags & FT_FORCE_MIPS)
-		m_nMips = 1;
-
-	ReleaseDeviceTexture(true);
-
-	// Same mip recomputation CreateRenderTarget() performs; width, height, array size, flags and
-	// clear colour are all left as they are and only the format moves.
-	m_nMips = (m_eFlags & FT_FORCE_MIPS) ? CTexture::CalcNumMips(m_nWidth, m_nHeight) : m_nMips;
-
-	SSubresourceData pData(nullptr);
-	CreateDeviceTexture(std::move(pData));
-	PostCreate();
-
-	// A freshly created target holds whatever the driver left in it. The pool clears every target
-	// it creates for exactly this reason; a reformat is a creation.
-	if (!(m_eFlags & FT_FAILED))
-		Clear();
-
-	return true;
-}
