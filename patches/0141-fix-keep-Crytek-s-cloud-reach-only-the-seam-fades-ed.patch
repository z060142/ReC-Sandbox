--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.cpp
@@ -141,7 +141,7 @@ struct SVolumetricCloudsShaderParam
 	f32      jitteredSamplingPosition;
 
 	Vec3     cloudOffset;
-	f32      skyRayUnclamped; // cloudBaseOffsetParams.w: 1.0 on the scene-referred path - sky rays are not clamped to the far plane (decisions/s9-cloud-edge.md); 0.0 stock (unused padding)
+	f32      skyRayUnclamped; // cloudBaseOffsetParams.w: informational 1.0 - the sky-ray edge fade is on (decisions/s9-cloud-edge.md); stock: unused padding
 
 	f32      maxGlobalCloudDensity;
 	f32      minRescaleCloudTexDensity;
@@ -1586,15 +1586,13 @@ void CVolumetricCloudsStage::GenerateCloudShaderParam(::VCCloudRenderContext& co
 			cb.jitteredSamplingPosition = VCGetVdC(iFrameCount);
 
 			cb.cloudOffset = Vec3(PF.pVolCloudTilingOffset.x, PF.pVolCloudTilingOffset.y, PF.pVolCloudTilingOffset.z - altitude);
-			// ReCS: Clouds.cfx no longer clamps a SKY ray's march to the depth buffer, and fades the
-			// pass out over the last kilometres before any distance limit. A sky pixel carries the far
-			// plane's depth and the far plane is not an occluder; clamped to it, the whole cloud layer
-			// was cut at asin((cloud base - camera) / ZF) above the horizon - a hard line across the sky
-			// that stock CRYENGINE 5.7.1 has too (verified against the pristine engine,
-			// research/s9-cloud-edge-root.md, decisions/s9-cloud-edge.md). UNCONDITIONAL by user policy
-			// (2026-09-09): the clouds must look the same through every camera, so this is an engine
-			// behaviour change like the e_VolumetricFog default, not a scene-referred one. The lane is
-			// informational (overlay) - the shader applies the rule without reading it.
+			// ReCS: Clouds.cfx fades a SKY ray's cloud contribution out over the last kilometres before
+			// whatever limit ends its march (the depth-buffer clamp at the far plane, the max viewable
+			// distance). The reach itself is Crytek's and stays - low clouds dissolve into the
+			// atmosphere rather than running crisply to the horizon; only the hard seam at
+			// asin((cloud base - camera) / limit) goes (research/s9-cloud-edge-root.md,
+			// decisions/s9-cloud-edge.md). UNCONDITIONAL by user policy (2026-09-09): the clouds must
+			// look the same through every camera. The lane is informational (overlay) only.
 			cb.skyRayUnclamped = 1.0f;
 
 			cb.maxGlobalCloudDensity = cloudDensityParams.x;
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.h b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.h
index 0f18bb64..ce4b4ecf 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.h
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.h
@@ -45,7 +45,7 @@ public:
 		float atmosSunExposed   = 0.0f;   // sunIntensityForAtmospheric, exposed engine units
 		Vec3  rayleighCoeff     = Vec3(ZERO); // atmosphericScattering, per metre - NOT exposed, it lives inside exp()
 		float zenithHazeExposed = 0.0f;   // CPU evaluation of the atmospheric inscatter straight up, exposed engine units (what a cloud at the zenith gets in front of it)
-		bool  bSkyRayUnclamped  = false;  // skyRayUnclamped lane: sky rays march past the far plane to the cloud layer (decisions/s9-cloud-edge.md)
+		bool  bSkyRayUnclamped  = false;  // skyRayUnclamped lane: the sky-ray edge fade is on (decisions/s9-cloud-edge.md)
 	};
 	const SSceneReferredDebug& GetSceneReferredDebug() const { return m_srDebug; }
 
diff --git a/Engine/Shaders/HWScripts/CryFX/Clouds.cfx b/Engine/Shaders/HWScripts/CryFX/Clouds.cfx
index 4dc1d782..df9e5b76 100644
--- a/Engine/Shaders/HWScripts/CryFX/Clouds.cfx
+++ b/Engine/Shaders/HWScripts/CryFX/Clouds.cfx
@@ -1430,16 +1430,7 @@ void RenderCloudMonolithicCS(uint3 GroupID : SV_GroupID,
 	distanceEnd = (distanceEnd - distanceStart) > MaxRaymarchDistance ? (MaxRaymarchDistance + distanceStart) : distanceEnd;
 
 	// limit the length of ray-marching by depth buffer.
-	// ReCS scene-referred path (decisions/s9-cloud-edge.md, 2026-09-09): a SKY pixel carries the far
-	// plane's depth, and the far plane is not an occluder. Clamping the march to it cuts the whole cloud
-	// layer - clouds, haze, everything - at the elevation where the layer is entered beyond ZF
-	// (asin((cloud base - camera) / ZF): ~6 degrees for this level's 8 km), a hard line across the sky
-	// that stock CRYENGINE 5.7.1 has too (verified against the pristine engine). Sky rays keep the
-	// geometric bounds (cloud shell, max viewable distance); real geometry still clamps as before.
-	// ReCS: unconditional - the cloud layer must look the same through every camera (user policy
-	// 2026-09-09), so this is an engine behaviour change, not a scene-referred one.
-	const bool bSkyRayUnclamped = (linearMaxDepth >= 0.999f);
-	distanceEnd = (!bSkyRayUnclamped && distanceTarget < distanceEnd && distanceFar > distanceTarget) ? distanceTarget : distanceEnd;
+	distanceEnd = (distanceTarget < distanceEnd && distanceFar > distanceTarget) ? distanceTarget : distanceEnd;
 
 	// intersection with ocean or horizon to stop ray-marching under the horizon.
 	float distHorizon = vcGetIntersectionPlane(nearPlanePosWS, camDir, float4(0.0f, 0.0f, 1.0f, horizonHeight));
@@ -1449,7 +1440,7 @@ void RenderCloudMonolithicCS(uint3 GroupID : SV_GroupID,
 	distanceStart = (nearPlanePosWS.z <= horizonHeight && camDir.z <= 0.0f) ? distanceEnd : distanceStart;
 
 	// if min-depth equals to far depth, it should be beyond far plane.
-	distanceTargetMin = (distanceTargetMin == distanceFar || (bSkyRayUnclamped && linearMinDepth >= 0.999f)) ? distanceEnd : distanceTargetMin;
+	distanceTargetMin = (distanceTargetMin == distanceFar) ? distanceEnd : distanceTargetMin;
 
 	// stop ray-marching if it isn't needed.
 	float maxStepNum = (distanceStart >= distanceEnd) ? 0.0f : MaxStepRaymarch;
@@ -1631,10 +1622,14 @@ void RenderCloudMonolithicCS(uint3 GroupID : SV_GroupID,
 
 
 	// ReCS edge fade (decisions/s9-cloud-edge.md, 2026-09-09): whatever ends a SKY ray's march - the
-	// max viewable distance, the max ray-march length - does so with a hard boundary in elevation.
-	// Fade the pass's contribution out over the last kilometres of marched segment so the cloud
-	// region's sky blends into the plain sky below instead of stepping. Sky rays only: a ray that
-	// stops on geometry keeps its full contribution (the cloud in front of a mountain is real).
+	// depth-buffer clamp at the far plane, the max viewable distance, the max ray-march length -
+	// does so with a hard boundary in elevation (asin((cloud base - camera) / limit)). The reach
+	// itself is Crytek's and stays: low clouds dissolve into the atmosphere, they do not run crisply
+	// to the horizon (user, 2026-09-09). Only the seam goes: the pass's contribution fades out over
+	// the last kilometres of marched segment, so the cloud region's sky blends into the plain sky
+	// below. Sky rays only - a ray that stops on geometry keeps its full contribution (the cloud
+	// in front of a mountain is real). Unconditional: the clouds must look the same through every
+	// camera, so this is an engine behaviour change (like the e_VolumetricFog default).
 	{
 		const float fadeLength = 4000.0f;
 		const float edgeFade = (linearMaxDepth >= 0.999f && maxStepNum != 0.0f) ? saturate((distanceEnd - distanceStart) / fadeLength) : 1.0f;
@@ -2339,16 +2334,7 @@ void RenderCloudCS(uint3 GroupID : SV_GroupID,
 	distanceEnd = (distanceEnd - distanceStart) > MaxRaymarchDistance ? (MaxRaymarchDistance + distanceStart) : distanceEnd;
 
 	// limit the length of ray-marching by depth buffer.
-	// ReCS scene-referred path (decisions/s9-cloud-edge.md, 2026-09-09): a SKY pixel carries the far
-	// plane's depth, and the far plane is not an occluder. Clamping the march to it cuts the whole cloud
-	// layer - clouds, haze, everything - at the elevation where the layer is entered beyond ZF
-	// (asin((cloud base - camera) / ZF): ~6 degrees for this level's 8 km), a hard line across the sky
-	// that stock CRYENGINE 5.7.1 has too (verified against the pristine engine). Sky rays keep the
-	// geometric bounds (cloud shell, max viewable distance); real geometry still clamps as before.
-	// ReCS: unconditional - the cloud layer must look the same through every camera (user policy
-	// 2026-09-09), so this is an engine behaviour change, not a scene-referred one.
-	const bool bSkyRayUnclamped = (linearMaxDepth >= 0.999f);
-	distanceEnd = (!bSkyRayUnclamped && distanceTarget < distanceEnd && distanceFar > distanceTarget) ? distanceTarget : distanceEnd;
+	distanceEnd = (distanceTarget < distanceEnd && distanceFar > distanceTarget) ? distanceTarget : distanceEnd;
 
 	// intersection with ocean or horizon to stop ray-marching under the horizon.
 	float distHorizon = vcGetIntersectionPlane(nearPlanePosWS, camDir, float4(0.0f, 0.0f, 1.0f, horizonHeight));
@@ -2358,7 +2344,7 @@ void RenderCloudCS(uint3 GroupID : SV_GroupID,
 	distanceStart = (nearPlanePosWS.z <= horizonHeight && camDir.z <= 0.0f) ? distanceEnd : distanceStart;
 
 	// if min-depth equals to far depth, it should be beyond far plane.
-	distanceTargetMin = (distanceTargetMin == distanceFar || (bSkyRayUnclamped && linearMinDepth >= 0.999f)) ? distanceEnd : distanceTargetMin;
+	distanceTargetMin = (distanceTargetMin == distanceFar) ? distanceEnd : distanceTargetMin;
 
 	// stop ray-marching if it isn't needed.
 	float maxStepNum = (distanceStart >= distanceEnd) ? 0.0f : MaxStepRaymarch;
@@ -2526,10 +2512,14 @@ void RenderCloudCS(uint3 GroupID : SV_GroupID,
 
 
 	// ReCS edge fade (decisions/s9-cloud-edge.md, 2026-09-09): whatever ends a SKY ray's march - the
-	// max viewable distance, the max ray-march length - does so with a hard boundary in elevation.
-	// Fade the pass's contribution out over the last kilometres of marched segment so the cloud
-	// region's sky blends into the plain sky below instead of stepping. Sky rays only: a ray that
-	// stops on geometry keeps its full contribution (the cloud in front of a mountain is real).
+	// depth-buffer clamp at the far plane, the max viewable distance, the max ray-march length -
+	// does so with a hard boundary in elevation (asin((cloud base - camera) / limit)). The reach
+	// itself is Crytek's and stays: low clouds dissolve into the atmosphere, they do not run crisply
+	// to the horizon (user, 2026-09-09). Only the seam goes: the pass's contribution fades out over
+	// the last kilometres of marched segment, so the cloud region's sky blends into the plain sky
+	// below. Sky rays only - a ray that stops on geometry keeps its full contribution (the cloud
+	// in front of a mountain is real). Unconditional: the clouds must look the same through every
+	// camera, so this is an engine behaviour change (like the e_VolumetricFog default).
 	{
 		const float fadeLength = 4000.0f;
 		const float edgeFade = (linearMaxDepth >= 0.999f && maxStepNum != 0.0f) ? saturate((distanceEnd - distanceStart) / fadeLength) : 1.0f;
