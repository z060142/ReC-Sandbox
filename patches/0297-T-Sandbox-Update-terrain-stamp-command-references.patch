From: z060142 <z060142@yahoo.com.tw>
Date: Thu, 3 Sep 2026 05:17:54 +0800
Subject: [PATCH 297/307] !T (Sandbox) Update terrain stamp command references.

---
 Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.cpp | 4 ++--
 Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.h   | 4 ++--
 2 files changed, 4 insertions(+), 4 deletions(-)

diff --git a/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.cpp b/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.cpp
index f015299d..6cdc7a37 100644
--- a/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.cpp
+++ b/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.cpp
@@ -25,7 +25,7 @@ using Cry::DefaultComponents::ITerrainPlateCommit;
 //! A plate that reports itself settling is held back entirely; this is the backstop for the others.
 const uint32 kRepaintFrameInterval = 6;
 
-//! Below this a weight contributes less than half a quantisation step. terrain.commit_plate_colour uses
+//! Below this a weight contributes less than half a quantisation step. terrain.stamp_plate_colour uses
 //! the same epsilon, which is what keeps the two footprints identical.
 const float  kWeightEpsilon = 0.002f;
 
@@ -383,7 +383,7 @@ static int ApplyPlatesToRow(const std::vector<SLivePlate>& plates, uint32* pRow,
 			if (worldY < plate.worldYMin || worldY > plate.worldYMax)
 				continue;
 
-			// The same rim weight call terrain.commit_plate_colour makes, so the two cannot drift.
+			// The same rim weight call terrain.stamp_plate_colour makes, so the two cannot drift.
 			const float weight = pCommit->GetCommitWeightAtWorld(worldX, worldY, sampleSize);
 			if (weight <= kWeightEpsilon)
 				continue;
diff --git a/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.h b/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.h
index c21a9239..ac06bcdd 100644
--- a/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.h
+++ b/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.h
@@ -6,7 +6,7 @@
 #include <CryEntitySystem/IEntityBasicTypes.h>   // EntityId, for the stamp's one plate
 
 //! The terrain plate's diffuse as the terrain's macro colour, live and non destructive. The source is
-//! ITerrainPlateCommit::GetCommitAlbedoAtWorld, the same call terrain.commit_plate_colour makes at the
+//! ITerrainPlateCommit::GetCommitAlbedoAtWorld, the same call terrain.stamp_plate_colour makes at the
 //! same resolution, so Commit Colour means "make what you are looking at permanent".
 //!
 //! The engine's editor side macro colour is a PULL: a dirty node makes
@@ -21,7 +21,7 @@
 namespace TerrainPlateColourOverlay
 {
 
-//! THE blend, shared by the live overlay and by terrain.commit_plate_colour. Both sides to linear, lerp
+//! THE blend, shared by the live overlay and by terrain.stamp_plate_colour. Both sides to linear, lerp
 //! there, back to gamma - the terrain painter's own recipe; blending gamma values directly makes the rim
 //! band read too dark.
 //! destination and the return value are one terrain colour texel in the RGB layer's packed layout,
