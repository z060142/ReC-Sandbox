From 3885832b8d7684bcc5ec2f41d4d325617f8e8d92 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Fri, 28 Aug 2026 09:42:42 +0800
Subject: [PATCH 086/119] fix: the LUT textures follow the tree's own Texture3D
 declaration style

Declared as plain Texture3D rather than Texture3D<float4>, and SampleLut3D takes the same. The
only precedent in this tree for passing a 3D texture to a function is Clouds.cfx's GetFBM, which
is untyped on both sides; a typed declaration passed to an untyped parameter is the kind of
mismatch the CryFX front end reports late and unhelpfully. float4 is the default template
argument, so nothing about the fetch changes.

Co-Authored-By: Claude Opus <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01A72MFkdSczncE7au9UVnmu
---
 Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx b/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx
index c4463ee1..77f3aa50 100644
--- a/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx
+++ b/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx
@@ -838,8 +838,8 @@ float4 SceneCDLSlope;    // ASC CDL slope.rgb, .w = saturation (1 = neutral)
 float4 SceneCDLOffset;   // ASC CDL offset.rgb, .w = LMT grid size N (0 = no look loaded)
 float4 SceneCDLPower;    // ASC CDL power.rgb, .w = ODT grid size N (0 = no output transform loaded)
 
-Texture3D<float4> lmtTex : register(t3);   // creative look, ACEScct in / ACEScct out
-Texture3D<float4> odtTex : register(t4);   // output transform, ACEScct in / display-encoded out
+Texture3D lmtTex : register(t3);   // creative look, ACEScct in / ACEScct out
+Texture3D odtTex : register(t4);   // output transform, ACEScct in / display-encoded out
 SamplerState linearClamp3DSS : register(s1);
 
 // The standard half-texel inset for an N^3 grid: the first and last samples sit at the CENTRES
@@ -847,7 +847,7 @@ SamplerState linearClamp3DSS : register(s1);
 // mapped onto it. Exactly the correction TexColorChart2D makes for its unwrapped strip, one
 // dimension up. Getting it wrong is a small, uniform, entirely invisible error - which is why it
 // is spelled out here instead of being folded into the call.
-float3 SampleLut3D(Texture3D<float4> lut, SamplerState ss, float3 c, float fGridSize)
+float3 SampleLut3D(Texture3D lut, SamplerState ss, float3 c, float fGridSize)
 {
 	const float fScale = (fGridSize - 1.0) / fGridSize;
 	const float fBias  = 0.5 / fGridSize;
-- 
