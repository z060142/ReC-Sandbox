From 1b6a1ae942cd666cb9b4dce3c619217926c59e06 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Thu, 3 Sep 2026 14:14:20 +0800
Subject: [PATCH 299/307] !B (Sandbox) Hash the plate's own material into the
 colour overlay signature.

MakeLivePlate folded IEntity::GetMaterial() and GetSlotMaterial(0) into the
change detector's signature, but the plate mesh lives in the component's own
slot (GetEntitySlotId()). On an entity where the plate is not slot 0 - any
entity carrying another mesh component as well - assigning a different material
to the plate changed the picture the overlay would draw while the signature
stayed put, so no terrain texture sector was marked dirty and the ground kept
the old colour until the plate was nudged.

ITerrainPlateCommit gains GetCommitMaterial(), the plate's effective material
(slot override on its own slot, then the statobj's - the existing
GetPlateMaterial). The overlay hashes that instead of guessing at slot 0. The
editor calls it through the interface, as it must: the overrides are final, so
a call on the concrete type devirtualises and Sandbox has no symbol for it.
---
 .../DefaultComponents/Geometry/ITerrainPlateCommit.h       | 7 +++++++
 .../DefaultComponents/Geometry/TerrainPlateComponent.h     | 3 +++
 .../Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.cpp | 5 +++--
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/ITerrainPlateCommit.h b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/ITerrainPlateCommit.h
index 52beced0..05f31493 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/ITerrainPlateCommit.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/ITerrainPlateCommit.h
@@ -5,6 +5,8 @@
 #include <CryExtension/CryGUID.h>
 #include <CryMath/Cry_Color.h>
 
+struct IMaterial;
+
 namespace Cry
 {
 namespace DefaultComponents
@@ -81,6 +83,11 @@ struct ITerrainPlateCommit
 	virtual bool  GetLiveColourState(int& outX1, int& outY1, int& outSize, ColorB& outTint,
 	                                 bool& outSettling) const = 0;
 
+	//! The material the plate actually renders with: the override on the plate's OWN slot, then the mesh's.
+	//! The plate is not necessarily slot 0, so the editor cannot guess it from the entity. Only ever
+	//! compared, never dereferenced - it is the material identity the overlay's change detector hashes.
+	virtual const IMaterial* GetCommitMaterial() const = 0;
+
 	//! The editor has written the stamped ground into CHeightmap: adopt it as this plate's baseline. The
 	//! plate stays armed and keeps its live footprint - re-applying the bake over the ground it just
 	//! stamped is a no-op, and the restore now hands back the stamped ground rather than the old one.
diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
index befd13ce..f2237f46 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
@@ -453,6 +453,9 @@ public:
 	virtual bool  GetLiveColourState(int& outX1, int& outY1, int& outSize, ColorB& outTint,
 	                                 bool& outSettling) const final;
 	void          ClearColourStamp() const;
+	//! @see ITerrainPlateCommit::GetCommitMaterial. Inline, because GetPlateMaterial is protected and the
+	//! editor can only reach the plate through the interface.
+	virtual const IMaterial* GetCommitMaterial() const final { return GetPlateMaterial(); }
 	virtual void  OnHeightStamped() final;
 	virtual void  OnColourStamped() final;
 	virtual bool  IsColourStamped() const final;
diff --git a/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.cpp b/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.cpp
index 6cdc7a37..9df565f5 100644
--- a/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.cpp
+++ b/Code/Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.cpp
@@ -172,8 +172,9 @@ bool MakeLivePlate(IEntity* pEntity, float unitSize, SLivePlate& out)
 	signature = HashFloat(signature, plate.worldXMax);
 	signature = HashFloat(signature, plate.worldYMax);
 	signature = HashCombine(signature, ((uint32)tint.r << 16) | ((uint32)tint.g << 8) | (uint32)tint.b);
-	signature = HashCombine(signature, (uint32)(uintptr_t)pEntity->GetMaterial());
-	signature = HashCombine(signature, (uint32)(uintptr_t)pEntity->GetSlotMaterial(0));
+	// The plate's OWN material, through the interface: the plate is not necessarily slot 0, so the entity's
+	// slot 0 override would miss a material change on any other slot.
+	signature = HashCombine(signature, (uint32)(uintptr_t)pCommit->GetCommitMaterial());
 	plate.signature = signature;
 	plate.bSettling = bSettling;
 
-- 
