From 3b45551df37d128e3484534ecf0f7111ff606e46 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Mon, 31 Aug 2026 14:28:34 +0800
Subject: [PATCH 251/307] !F (Terrain Integration) Draw integrated geometry in
 the terrain base pass.

Optionally include accepted integrated triangles in the LOD 0 terrain base-pass
chunk so they receive terrain macro colour and normal-atlas shading. The stock
index range remains unchanged while the feature CVar is disabled.
---
 Code/CryEngine/Cry3DEngine/3dEngine.cpp       |  4 ++-
 Code/CryEngine/Cry3DEngine/cvars.cpp          | 15 +++++++++
 Code/CryEngine/Cry3DEngine/cvars.h            |  2 ++
 .../Cry3DEngine/terrain_sector_render.cpp     | 32 +++++++++++++++++--
 4 files changed, 50 insertions(+), 3 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/3dEngine.cpp b/Code/CryEngine/Cry3DEngine/3dEngine.cpp
index 3507494d..daa8718c 100644
--- a/Code/CryEngine/Cry3DEngine/3dEngine.cpp
+++ b/Code/CryEngine/Cry3DEngine/3dEngine.cpp
@@ -760,7 +760,9 @@ void C3DEngine::ProcessCVarsChange()
 		GetCVars()->e_TerrainBlendingDebug +
 		GetCVars()->e_TerrainDetailMaterialsWeightedBlending +
 		GetCVars()->e_TerrainIntegrateObjectsMaxVertices +
-		GetCVars()->e_TerrainIntegrateObjectsMaxHeight;
+		GetCVars()->e_TerrainIntegrateObjectsMaxHeight +
+		GetCVars()->e_TerrainIntegrateObjectsFull +
+		GetCVars()->e_TerrainIntegrateObjectsPushOut;
 
 	if (m_fRefreshSceneDataCVarsSumm != -1 && m_fRefreshSceneDataCVarsSumm != fNewCVarsSumm)
 	{
diff --git a/Code/CryEngine/Cry3DEngine/cvars.cpp b/Code/CryEngine/Cry3DEngine/cvars.cpp
index 30c88c41..cb491f95 100644
--- a/Code/CryEngine/Cry3DEngine/cvars.cpp
+++ b/Code/CryEngine/Cry3DEngine/cvars.cpp
@@ -542,6 +542,21 @@ void CVars::Init()
 	              "flushed once no movement has been seen for that many frames.\n"
 	              "Entering and leaving the mode, and (un)registering a node, always rebuild at once.\n"
 	              "0 - off, rebuild immediately on every move (stock behaviour)");
+	REGISTER_CVAR(e_TerrainIntegrateObjectsFull, 0, VF_NULL,
+	              "How much of the terrain an object with the GI mode 'Integrate Into Terrain' becomes.\n"
+	              "0 - stock: the appended copy of the object is drawn by the terrain detail layers only,\n"
+	              "    the object keeps drawing its own material underneath (bit identical to stock CE)\n"
+	              "1 - the appended copy is also drawn by the terrain BASE pass, so it gets the terrain\n"
+	              "    macro colour and normal atlas. The object still draws itself as well, so the\n"
+	              "    surface is drawn twice (the appended copy wins the depth test)\n"
+	              "2 - additionally hide the object from camera passes where terrain fully took it\n"
+	              "    (not implemented yet - behaves like 1)");
+	REGISTER_CVAR(e_TerrainIntegrateObjectsPushOut, 0.02f, VF_NULL,
+	              "Meters the vertices of an integrated object are pushed out along their normal before\n"
+	              "they are appended to the terrain sector mesh. The push exists so the appended copy\n"
+	              "beats the object's own opaque pixels; it costs exactly that much geometric error\n"
+	              "against the object's collision surface, its shadow and the road drape.\n"
+	              "0.02 - stock behaviour");
 	DefineConstIntCVar(e_TerrainDeformations, 0, VF_CHEAT,
 	                   "Allows in-game terrain surface deformations");
 	REGISTER_CVAR(e_TerrainEditPostponeTexturesUpdate, 10, VF_NULL,
diff --git a/Code/CryEngine/Cry3DEngine/cvars.h b/Code/CryEngine/Cry3DEngine/cvars.h
index 132da71c..9e261481 100644
--- a/Code/CryEngine/Cry3DEngine/cvars.h
+++ b/Code/CryEngine/Cry3DEngine/cvars.h
@@ -223,6 +223,8 @@ struct CVars : public Cry3DEngineBase
 	float e_TerrainIntegrateObjectsMaxHeight;
 	int   e_TerrainIntegrateObjectsDebug;
 	int   e_TerrainIntegrateObjectsRebuildDelay;
+	int   e_TerrainIntegrateObjectsFull;
+	float e_TerrainIntegrateObjectsPushOut;
 	DeclareConstIntCVar(e_SkyBox, 1);
 	float e_CoverageBufferAABBExpand;
 	int   e_CoverageBufferEarlyOut;
diff --git a/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp b/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
index 2a8735f4..dc3dd7a9 100644
--- a/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
+++ b/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
@@ -612,7 +612,28 @@ void CTerrainNode::UpdateRenderMesh(CStripsInfo* pArrayInfo)
 	AABB boxWS = GetBBox();
 	pRenderMesh->SetBBox(boxWS.min, boxWS.max);
 
-	pRenderMesh->SetChunk(GetTerrain()->m_pTerrainEf, 0, pRenderMesh->GetVerticesCount(), 0, min(m_pUpdateTerrainTempData->m_StripsInfo.nNonBorderIndicesCount, pArrayInfo->idx_array.Count()), 1.0f, 0);
+	// Index range of the single base pass chunk.
+	//
+	// Stock CE clamps it to the grid indices, so the triangles AppendTrianglesFromObjects added past
+	// nNonBorderIndicesCount sit in the index buffer but in no chunk: they are reachable only by the
+	// detail layer meshes (which walk the whole idx_array), never by the terrain base pass.
+	//
+	// With e_TerrainIntegrateObjectsFull the appended range joins the base chunk, so the integrated
+	// triangles also get the terrain macro colour and normal atlas. That is correct for free: the base
+	// pass derives its atlas texcoord from the world position in the VS (Terrain.cfx, basesectorTC),
+	// not from a mesh UV, and the LOD 0 path reads Z from the vertex stream rather than the elevation
+	// atlas. Only accepted triangles are ever appended (the height band / slope classifier in
+	// AppendTrianglesFromObjects 'continue's on rejection), so widening the chunk draws exactly the
+	// triangles the detail layer overlay accepted - nothing else is pulled into the base pass.
+	//
+	// Not applicable to the instancing / shadow path: that one uses the shared flat grid mesh, which
+	// has no appended triangles at all.
+	int nBaseChunkIndices = min(m_pUpdateTerrainTempData->m_StripsInfo.nNonBorderIndicesCount, pArrayInfo->idx_array.Count());
+
+	if (GetCVars()->e_TerrainIntegrateObjectsFull && !m_nTreeLevel && Get3DEngine()->m_bIntegrateObjectsIntoTerrain)
+		nBaseChunkIndices = pArrayInfo->idx_array.Count();
+
+	pRenderMesh->SetChunk(GetTerrain()->m_pTerrainEf, 0, pRenderMesh->GetVerticesCount(), 0, nBaseChunkIndices, 1.0f, 0);
 
 	if (pRenderMesh->GetChunks().size() && pRenderMesh->GetChunks()[0].pRE)
 		pRenderMesh->GetChunks()[0].pRE->m_CustomData = GetLeafData()->m_arrTexGen[0];
@@ -1476,6 +1497,13 @@ void CTerrainNode::AppendTrianglesFromObjects(const int nOriginX, const int nOri
 	float fHeightMapMax = aabbTNode.max.z;
 	aabbTNode.max.z += GetCVars()->e_TerrainIntegrateObjectsMaxHeight;
 
+	// Distance the appended vertices are pushed out along their normal. It exists only so the appended
+	// copy beats the object's own opaque pixels; it costs exactly that much geometric error against the
+	// object's collision surface, its shadow and the road drape. Stock is the literal 0.02f this
+	// replaces. Once the object's own draw is suppressed (e_TerrainIntegrateObjectsFull 2) the push has
+	// no job left and should be set to 0.
+	const float fPushOut = GetCVars()->e_TerrainIntegrateObjectsPushOut;
+
 	PodArray<IRenderNode*> lstObjects;
 	Get3DEngine()->GetObjectsByTypeGlobal(lstObjects, eERType_MovableBrush, &aabbTNode);
 
@@ -1643,7 +1671,7 @@ void CTerrainNode::AppendTrianglesFromObjects(const int nOriginX, const int nOri
 
 								vNormWS[v] = m34.TransformVector(basis.GetN()).GetNormalized();
 
-								vPosWS[v] += vNormWS[v] * 0.02f;
+								vPosWS[v] += vNormWS[v] * fPushOut;
 
 								triBox.Add(vPosWS[v]);
 
