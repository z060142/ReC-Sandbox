+// Copyright 2026 ReC Sandbox. Distributed under the terms in LICENSE.md at the repository root.
+#pragma once
+
+#include <LevelEditor/Tools/EditTool.h>
+#include <LevelEditor/Tools/PickObjectTool.h>
+#include <LevelEditor/LevelEditorSharedState.h>
+
+#include <CryExtension/CryGUID.h>
+
+//! The editor half of the Area function component's link list (decision 03).
+//!
+//! An area's links are the entities that receive its enter/leave/fade events, and they are
+//! authored by pointing at an entity in the viewport - there is no inspector entity picker an
+//! engine component can use, because Serialization::EntityTarget and its property row live in
+//! EditorQt. The component therefore stores GUIDs and declares two editor ACTIONS
+//! (IEditorActionComponent, CryCommon/CryEntitySystem/IEntityComponent.h); the inspector turns
+//! each of them into a button that starts one of the tools below for that component instance,
+//! handing it the object and component GUIDs in SEntityComponentEditToolTarget.
+//!
+//! Neither tool ever holds a pointer between calls: both resolve object and component from the two
+//! GUIDs on every use (MEMORY.md, fix bde12cd8).
+
+//! "Pick Link Target": the standard pick-object mode, with the picked entity's GUID appended to
+//! the area's link list. One pick, one undo step, then the tool ends - the same gesture
+//! CShapeObject's legacy "Pick" row produces with ShapeTargetTool.
+class CAreaPickLinkTargetTool : public CPickObjectTool, public IPickObjectCallback
+{
+	DECLARE_DYNCREATE(CAreaPickLinkTargetTool)
+
+public:
+	CAreaPickLinkTargetTool();
+
+	// CEditTool
+	virtual string GetDisplayName() const override { return "Pick Link Target"; }
+	virtual void   SetUserData(const char* key, void* userData) override;
+	// ~CEditTool
+
+	// IPickObjectCallback
+	virtual void OnPick(CBaseObject* pPicked) override;
+	virtual void OnCancelPick() override {}
+	virtual bool OnPickFilter(CBaseObject* pFilterObject) override;
+	// ~IPickObjectCallback
+
+protected:
+	virtual ~CAreaPickLinkTargetTool();
+	virtual void DeleteThis() override { delete this; }
+
+private:
+	CryGUID m_objectGuid = CryGUID::Null();
+	CryGUID m_componentGuid = CryGUID::Null();
+};
+
+//! "Clear Links": not really a viewport mode at all - it clears the list, records one undo step and
+//! immediately pops itself off the level editor.
+//!
+//! It is a tool rather than an ActionButton inside the reflected member's Serialize() because an
+//! ActionButton would have to capture something that can reach the component, and the only thing
+//! in scope there is the reflected struct itself - which must never hold a raw pointer (MEMORY.md:
+//! reflected values are copied into scratchpads and outlive the component). Going through the
+//! action/tool plumbing means the identity travels as two GUIDs, exactly as it does for every
+//! other component action, and the undo and save sync are the ones every other tool here uses.
+class CAreaClearLinksTool : public CEditTool
+{
+	DECLARE_DYNCREATE(CAreaClearLinksTool)
+
+public:
+	CAreaClearLinksTool() = default;
+
+	// CEditTool
+	virtual string GetDisplayName() const override { return "Clear Links"; }
+	virtual void   SetUserData(const char* key, void* userData) override;
+	virtual void   Display(SDisplayContext& dc) override {}
+	virtual bool   MouseCallback(CViewport* pView, EMouseEvent event, CPoint& point, int flags) override { return false; }
+	virtual bool   OnKeyDown(CViewport* pView, uint32 nChar, uint32 nRepCnt, uint32 nFlags) override     { return false; }
+	virtual bool   IsNeedMoveTool() override { return false; }
+	// ~CEditTool
+
+protected:
+	virtual ~CAreaClearLinksTool() = default;
+	virtual void DeleteThis() override { delete this; }
+};
