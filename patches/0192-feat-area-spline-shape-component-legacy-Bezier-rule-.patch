+// Copyright 2026 ReC Sandbox. Distributed under the terms in LICENSE.md at the repository root.
+#include "StdAfx.h"
+#include "AreaLinkTools.h"
+#include "ShapeToolCommon.h"
+
+#include <IEditor.h>
+#include <IEditorClassFactory.h>
+#include <IObjectManager.h>
+#include <IUndoManager.h>
+#include <LevelEditor/LevelEditorSharedState.h>
+#include <Objects/BaseObject.h>
+
+#include <CryEntitySystem/IEntity.h>
+#include <CrySchematyc/Reflection/TypeDesc.h>
+
+#include <IAreaFunctionComponent.h>
+
+using Cry::AreaComponents::IAreaFunctionComponent;
+
+namespace
+{
+
+//! The Area function component of an editor object, resolved from the two GUIDs the inspector
+//! button handed over. The reflected base list is the cross-DLL proof that the component really
+//! implements the interface, exactly as AreaShapeTools::AsShape does for a shape.
+IAreaFunctionComponent* ResolveAreaComponent(const CryGUID& objectGuid, const CryGUID& componentGuid, CBaseObject** ppObjectOut)
+{
+	if (ppObjectOut != nullptr)
+	{
+		*ppObjectOut = nullptr;
+	}
+
+	CBaseObject* pObject = AreaShapeTools::FindObject(objectGuid);
+	if (pObject == nullptr || componentGuid == CryGUID::Null())
+		return nullptr;
+
+	IEntity* pEntity = pObject->GetIEntity();
+	if (pEntity == nullptr)
+		return nullptr;
+
+	IEntityComponent* pComponent = pEntity->GetComponentByGUID(componentGuid);
+	if (pComponent == nullptr)
+		return nullptr;
+
+	if (pComponent->GetClassDesc().FindBaseByTypeID(Schematyc::GetTypeDesc<IAreaFunctionComponent>().GetGUID()) == nullptr)
+		return nullptr;
+
+	if (ppObjectOut != nullptr)
+	{
+		*ppObjectOut = pObject;
+	}
+
+	return static_cast<IAreaFunctionComponent*>(pComponent);
+}
+
+//! One undo step around one change to the link list, followed by the sync a viewport edit has to
+//! perform by hand (research/06 section 5): the Schematyc save snapshot, the property-changed
+//! event, the modified flag and the prefab.
+void CommitLinkChange(CBaseObject* pObject, IEntityComponent* pComponent, const char* szUndoName)
+{
+	IUndoManager* pUndoManager = GetIEditor()->GetIUndoManager();
+	if (pUndoManager != nullptr && !pUndoManager->IsUndoRecording())
+	{
+		pUndoManager->Begin();
+		if (pObject != nullptr)
+		{
+			pObject->StoreUndo(szUndoName);
+		}
+		pUndoManager->Accept(szUndoName);
+	}
+
+	AreaShapeTools::SyncEditedComponent(pObject, pComponent);
+
+	// The inspector shows the link list as a read-only row, so it has to be rebuilt to show the
+	// change; the property tree does not poll.
+	if (IObjectManager* pObjectManager = GetIEditor()->GetObjectManager())
+	{
+		pObjectManager->EmitPopulateInspectorEvent();
+	}
+}
+
+} // anonymous namespace
+
+// ---------------------------------------------------------------------------
+// Pick Link Target
+// ---------------------------------------------------------------------------
+
+class CAreaPickLinkTargetTool_ClassDesc : public IClassDesc
+{
+	virtual ESystemClassID SystemClassID() override   { return ESYSTEM_CLASS_EDITTOOL; }
+	virtual const char*    ClassName() override       { return "EditTool.AreaPickLinkTarget"; }
+	virtual const char*    Category() override        { return "Area"; }
+	virtual CRuntimeClass* GetRuntimeClass() override { return RUNTIME_CLASS(CAreaPickLinkTargetTool); }
+};
+
+REGISTER_CLASS_DESC(CAreaPickLinkTargetTool_ClassDesc);
+
+IMPLEMENT_DYNCREATE(CAreaPickLinkTargetTool, CPickObjectTool);
+
+CAreaPickLinkTargetTool::CAreaPickLinkTargetTool()
+	: CPickObjectTool(this)
+{
+	// One pick, one link. Holding the mode open would need a way to end it that the inspector
+	// button does not offer.
+	SetMultiplePicks(false);
+}
+
+CAreaPickLinkTargetTool::~CAreaPickLinkTargetTool()
+{
+}
+
+void CAreaPickLinkTargetTool::SetUserData(const char* key, void* userData)
+{
+	if (userData == nullptr || key == nullptr || strcmp(key, SEntityComponentEditToolTarget::GetUserDataKey()) != 0)
+		return;
+
+	const SEntityComponentEditToolTarget* pTarget = static_cast<const SEntityComponentEditToolTarget*>(userData);
+	m_objectGuid = pTarget->objectGuid;
+	m_componentGuid = pTarget->componentGuid;
+
+	// Refuse a payload that does not resolve, instead of discovering it one virtual call later.
+	if (ResolveAreaComponent(m_objectGuid, m_componentGuid, nullptr) == nullptr)
+	{
+		CryWarning(VALIDATOR_MODULE_EDITOR, VALIDATOR_WARNING,
+		           "Pick Link Target: the Area component this button belongs to could not be resolved - the tool does nothing.");
+		m_objectGuid = CryGUID::Null();
+		m_componentGuid = CryGUID::Null();
+	}
+}
+
+bool CAreaPickLinkTargetTool::OnPickFilter(CBaseObject* pFilterObject)
+{
+	// Anything but the area itself: an area that links to its own entity is what AttachSelf()
+	// already does, and doing it twice through the link list would make removing the link detach
+	// the host from its own area.
+	return pFilterObject != nullptr && pFilterObject->GetId() != m_objectGuid;
+}
+
+void CAreaPickLinkTargetTool::OnPick(CBaseObject* pPicked)
+{
+	if (pPicked == nullptr)
+		return;
+
+	CBaseObject*            pObject = nullptr;
+	IAreaFunctionComponent* pArea = ResolveAreaComponent(m_objectGuid, m_componentGuid, &pObject);
+	if (pArea == nullptr)
+		return;
+
+	// The editor object's GUID is the entity's GUID (CEntityObject::CreateGameObject sets
+	// SEntitySpawnParams::guid from GetId()), which is the identity the component resolves with
+	// IEntitySystem::FindEntityByGuid - and the identity the legacy <Area> node stores.
+	if (!pArea->AddLinkTarget(pPicked->GetId()))
+		return;
+
+	CommitLinkChange(pObject, static_cast<IEntityComponent*>(pArea), "Add Area Link");
+}
+
+// ---------------------------------------------------------------------------
+// Clear Links
+// ---------------------------------------------------------------------------
+
+class CAreaClearLinksTool_ClassDesc : public IClassDesc
+{
+	virtual ESystemClassID SystemClassID() override   { return ESYSTEM_CLASS_EDITTOOL; }
+	virtual const char*    ClassName() override       { return "EditTool.AreaClearLinks"; }
+	virtual const char*    Category() override        { return "Area"; }
+	virtual CRuntimeClass* GetRuntimeClass() override { return RUNTIME_CLASS(CAreaClearLinksTool); }
+};
+
+REGISTER_CLASS_DESC(CAreaClearLinksTool_ClassDesc);
+
+IMPLEMENT_DYNCREATE(CAreaClearLinksTool, CEditTool);
+
+void CAreaClearLinksTool::SetUserData(const char* key, void* userData)
+{
+	if (userData == nullptr || key == nullptr || strcmp(key, SEntityComponentEditToolTarget::GetUserDataKey()) != 0)
+		return;
+
+	const SEntityComponentEditToolTarget* pTarget = static_cast<const SEntityComponentEditToolTarget*>(userData);
+
+	CBaseObject*            pObject = nullptr;
+	IAreaFunctionComponent* pArea = ResolveAreaComponent(pTarget->objectGuid, pTarget->componentGuid, &pObject);
+
+	if (pArea != nullptr && pArea->ClearLinks())
+	{
+		CommitLinkChange(pObject, static_cast<IEntityComponent*>(pArea), "Clear Area Links");
+	}
+
+	// This is an action, not a mode: leave immediately. SetEditTool(nullptr) destroys this tool,
+	// so it has to be the last statement (the pattern CShapeCreateTool::FinishCreation uses).
+	GetIEditor()->GetLevelEditorSharedState()->SetEditTool(nullptr);
+}
