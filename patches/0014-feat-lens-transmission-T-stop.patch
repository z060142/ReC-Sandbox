From b4973af977e3e2f75e2dc698915a1fdc51eb3f4e Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sun, 23 Aug 2026 20:48:17 +0800
Subject: [PATCH 14/31] feat: lens transmission (T-stop)

Radiometry and geometry split like a real lens: the new Transmission
property (Lens group, default 1.0 = bit-identical to before) defines
T = f / sqrt(transmission). Exposure and the grain light term follow
the T-stop, while depth of field, bokeh shape and diffraction streaks
stay on the geometric f-number. Modern prime ~0.9, zoom ~0.8, vintage
~0.75; a log line reports the effective T-stop on lens changes. Preset
material for the lens-package layer later.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_017nykaDjTHxHDSo11CsYx6M
---
 .../Module/CinematicCameraComponent.cpp       | 23 +++++++++++++++++--
 .../Module/CinematicCameraComponent.h         |  6 +++++
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp
index c0c9a82b..d352e8a7 100644
--- a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp
+++ b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp
@@ -511,7 +511,8 @@ float CCinematicCameraComponent::ComputeFilmGrain01() const
 	const float g = clamp_tpl(gainStops / 8.0f, 0.0f, 1.0f);
 	const float base = 0.25f * powf(g, 1.2f) + powf(g, 3.5f);
 
-	const float lightStops = log2f((t / (N * N)) / ((1.0f / 50.0f) / (5.6f * 5.6f))) - (float)(int)m_lens.ndFilterStops;
+	const float transmission = clamp_tpl((float)m_lens.transmission, 0.25f, 1.0f);
+	const float lightStops = log2f((transmission * t / (N * N)) / ((1.0f / 50.0f) / (5.6f * 5.6f))) - (float)(int)m_lens.ndFilterStops;
 	const float lowLightBoost = clamp_tpl(powf(2.0f, -lightStops * 0.35f), 0.6f, 2.2f);
 
 	return clamp_tpl(base * lowLightBoost, 0.0f, 1.5f);
@@ -748,7 +749,12 @@ float CCinematicCameraComponent::ComputeManualEV100() const
 	const float t = 1.0f / (float)max((int)m_body.shutterDenominator, 1);
 	const float iso = (float)max((int)m_body.iso, 1);
 
-	const float ev100 = log2f(N * N / t) - log2f(iso / 100.0f) - (float)m_exposure.evCompensation + (float)(int)m_lens.ndFilterStops;
+	// Radiometry follows the T-stop, not the f-stop: T^2 = N^2 / transmission, so glass
+	// losses darken the image exactly like a real lens while geometry (DOF, bokeh,
+	// diffraction) stays on N.
+	const float transmission = clamp_tpl((float)m_lens.transmission, 0.25f, 1.0f);
+
+	const float ev100 = log2f(N * N / (transmission * t)) - log2f(iso / 100.0f) - (float)m_exposure.evCompensation + (float)(int)m_lens.ndFilterStops;
 	return clamp_tpl(ev100, -6.0f, 24.0f);
 }
 
@@ -782,6 +788,19 @@ void CCinematicCameraComponent::FinalizeGameCamera()
 
 void CCinematicCameraComponent::ApplyExposureGlobalParam()
 {
+	// Diagnostic: report the effective T-stop whenever the lens changes.
+	{
+		static float s_lastN = -1.0f, s_lastTrans = -1.0f;
+		const float N = max((float)m_lens.aperture, 0.7f);
+		const float trans = clamp_tpl((float)m_lens.transmission, 0.25f, 1.0f);
+		if (fabs_tpl(N - s_lastN) > 0.05f || fabs_tpl(trans - s_lastTrans) > 0.005f)
+		{
+			s_lastN = N;
+			s_lastTrans = trans;
+			CryLog("[CinematicCamera] f/%.1f at transmission %.2f -> T%.1f", N, trans, N / sqrtf(trans));
+		}
+	}
+
 	if (!m_exposure.bEnableExposure)
 	{
 		RestoreExposure();
diff --git a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.h b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.h
index 618c89bd..a6f8227f 100644
--- a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.h
+++ b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.h
@@ -166,6 +166,11 @@ struct SCineLensParams
 		desc.AddMember(&SCineLensParams::apertureBlades,
 			'blad', "ApertureBlades", "Aperture Blades",
 			"Iris blade count. Shapes the bokeh: round when wide open, this polygon when stopped down.", 9);
+		desc.AddMember(&SCineLensParams::transmission,
+			'trns', "Transmission", "Transmission",
+			"Fraction of light the glass actually passes; defines the T-stop as T = f / sqrt(transmission). "
+			"Exposure and grain follow T, while depth of field, bokeh and streaks stay on the geometric f-number. "
+			"1 = ideal glass (T equals f), modern prime ~0.9, zoom ~0.8, vintage ~0.75.", 1.0f);
 		desc.AddMember(&SCineLensParams::ndFilterStops,
 			'ndf_', "NDFilterStops", "ND Filter (stops)",
 			"Neutral density in front of the lens: darkens by whole stops without touching depth of field or motion blur - how a real crew holds wide apertures in daylight.", 0);
@@ -185,6 +190,7 @@ struct SCineLensParams
 	Schematyc::Range<0, 2, 0, 1> focalStepTime = 0.25f;
 	Schematyc::Range<1, 64> aperture = 5.6f;
 	Schematyc::Range<3, 16, 5, 12, int> apertureBlades = 9;
+	Schematyc::Range<0, 1, 0, 1> transmission = 1.0f;
 	Schematyc::Range<0, 10, 0, 6, int> ndFilterStops = 0;
 	Schematyc::Range<0, 10000> focusDistance = 5.f;
 	Schematyc::Range<0, 2, 0, 1> breathingIntensity = 1.0f;
