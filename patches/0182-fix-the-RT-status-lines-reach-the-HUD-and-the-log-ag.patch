 void CSvoEnv::RTCachePoolDims()
 {
+	// SRTBuildStats is a plain struct inside CSvoEnv, so without this the status line printed
+	// whatever was on the heap until the first BVH was built
+	m_rtStats.Reset();
+
 	if (m_rtPoolXY)
