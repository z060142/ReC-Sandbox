+class CTerrainPlateComponent;
+
+//! Panel grouping helper. The plate's property panel had grown past twenty flat rows, so the rows are
+//! collected into four collapsible groups (Shape / Bake / Weld / Editor).
+//!
+//! Mechanism, and why it looks like this. A component's rows come from
+//! Schematyc::Utils::CClassSerializer, which walks the AddMember list and emits one row per member
+//! (CryCommon/CrySchematyc/Reflection/TypeDesc.inl:52-88). The entity inspector calls that walker
+//! directly (Sandbox/EditorQt/Objects/EntityObject.cpp:907), so a Serialize() on the component itself is
+//! never used and an openBlock() cannot be injected into the walk. What the walk does honour is a MEMBER
+//! whose type carries its own Serialize(): the property tree renders such a member as a nested,
+//! collapsible row - which is exactly how "Rendering Settings" (SRenderParameters) and "Physics Settings"
+//! (SPhysicsParameters, ComponentHelpers/PhysicsParameters.h:25) already look on this very panel.
+//!
+//! Grouping by MOVING the data into those structs would rename every archive key (<Normalize> would
+//! become <ShapeGroup><Normalize>) and every saved level would lose its values. So the data members stay
+//! exactly where they are - same AddMember, same id, same szName, same order - and only their LABEL is
+//! emptied, which hides their row (PropertyTreeLegacy/PropertyRow.cpp:491) while the archive keeps
+//! reading and writing them under their szName. That is the same trick the parked Commit Bake block uses.
+//! The groups below own no data at all: each holds a back pointer to the component and, in the editor
+//! archive only, emits the very same members again with their real labels.
+//!
+//! Two rules keep that safe:
+//!  * the four group members are AddMember'd AFTER every member they show. A property tree input pass
+//!    walks the rows in AddMember order, so the hidden row writes back the value it was last refreshed
+//!    with and the group row - the one the user actually edited - writes last and wins.
+//!  * a COPY of a group never carries the owner. Copies of a component's members live in Schematyc
+//!    scratchpads (CClassProperties::Read) and in undo buffers, never on an entity, and Serialize() bails
+//!    out on a null owner, so those copies emit nothing even in an edit archive. Assignment keeps the
+//!    DESTINATION's owner, so "Revert to Defaults" - which copy-assigns the reflected default over the
+//!    member (CClassProperties::Apply) - cannot blank the pointer of a live component.
+struct STerrainPlateUIGroup
+{
+	STerrainPlateUIGroup() = default;
+	STerrainPlateUIGroup(const STerrainPlateUIGroup&) {}
+	STerrainPlateUIGroup& operator=(const STerrainPlateUIGroup&) { return *this; }
+	//! The groups hold no data, so two of them are always equal. This keeps CClassProperties::Compare
+	//! (the panel's "did anything change" test) looking only at the real members.
+	bool operator==(const STerrainPlateUIGroup&) const { return true; }
+
+	CTerrainPlateComponent* m_pOwner = nullptr;
+};
+
+//! Shape: where the relief comes from and how it is tessellated.
+struct STerrainPlateShapeGroup : public STerrainPlateUIGroup
+{
+	void Serialize(Serialization::IArchive& archive);
+};
+
+//! Bake: writing the plate into the live terrain. The three tuning rows only appear once the bake is on.
+struct STerrainPlateBakeGroup : public STerrainPlateUIGroup
+{
+	void Serialize(Serialization::IArchive& archive);
+};
+
+//! Weld: sealing the border against the terrain. The three tuning rows only appear once the weld is on.
+struct STerrainPlateWeldGroup : public STerrainPlateUIGroup
+{
+	void Serialize(Serialization::IArchive& archive);
+};
+
+//! Editor: how the plate behaves while it is being edited. No effect at game time.
+struct STerrainPlateEditorGroup : public STerrainPlateUIGroup
+{
+	void Serialize(Serialization::IArchive& archive);
+};
+
