 // Component
 //////////////////////////////////////////////////////////////////////////
 
+// ---------------------------------------------------------------------------------------------------
+// Panel groups. Each of these draws members of the component it belongs to, with the labels those
+// members used to carry directly, nested inside one collapsible row. The members themselves still own
+// their AddMember and therefore their archive key, so nothing here touches persistence.
+// @see STerrainPlateUIGroup in the header for the mechanism and for the two invariants (groups come
+// last in the AddMember order; a copy of a group never carries an owner).
+//
+// The early out is the whole safety net: every archive other than the property panel - level save and
+// load, prefabs, copy paste, undo, the Schematyc scratchpad - runs with isEdit() == false and gets
+// nothing from these groups at all.
+
+void STerrainPlateShapeGroup::Serialize(Serialization::IArchive& archive)
+{
+	if (!archive.isEdit() || m_pOwner == nullptr)
+		return;
+
+	CTerrainPlateComponent& plate = *m_pOwner;
+	archive(plate.m_heightmapPath, "HeightmapFile", "Heightmap File");
+	archive(plate.m_bNormalize, "Normalize", "Normalize");
+	archive(plate.m_gridMode, "GridMode", "Grid Mode");
+
+	// Only the row that the current Grid Mode actually reads. The other one keeps its value: nothing
+	// writes a member whose row was not emitted, and both are persisted by their own AddMember anyway.
+	if (plate.m_gridMode == ETerrainPlateGridMode::Fixed)
+	{
+		archive(plate.m_grid, "Grid", "Grid");
+	}
+	else
+	{
+		archive(plate.m_vertexSpacing, "VertexSpacing", "Vertex Spacing");
+	}
+
+	archive(plate.m_effectiveGridInfo, "EffectiveGrid", "Effective Grid");
+	archive(plate.m_bMirrorX, "MirrorX", "Mirror X");
+	archive(plate.m_bMirrorY, "MirrorY", "Mirror Y");
+}
+
+void STerrainPlateBakeGroup::Serialize(Serialization::IArchive& archive)
+{
+	if (!archive.isEdit() || m_pOwner == nullptr)
+		return;
+
+	CTerrainPlateComponent& plate = *m_pOwner;
+	archive(plate.m_bBakeIntoTerrain, "BakeIntoTerrain", "Bake Into Terrain");
+
+	// The three tuning rows only mean anything while the bake is on, so they only appear then.
+	// The Commit Bake rows stay parked (see scene-notes/terrain/reports/31-commit-ui-parked.md):
+	// they are deliberately not drawn here either, and are still persisted by their own AddMember.
+	if (plate.m_bBakeIntoTerrain)
+	{
+		archive(plate.m_bakeMode, "BakeMode", "Bake Mode");
+		archive(plate.m_bakePriority, "BakePriority", "Bake Priority");
+		archive(plate.m_bakeOffset, "BakeOffset", "Bake Offset");
+	}
+}
+
+void STerrainPlateWeldGroup::Serialize(Serialization::IArchive& archive)
+{
+	if (!archive.isEdit() || m_pOwner == nullptr)
+		return;
+
+	CTerrainPlateComponent& plate = *m_pOwner;
+	archive(plate.m_bEdgeWeld, "EdgeWeld", "Edge Weld");
+
+	if (plate.m_bEdgeWeld)
+	{
+		archive(plate.m_weldSink, "WeldSink", "Weld Sink");
+		archive(plate.m_weldInnerFalloff, "WeldInnerFalloff", "Weld Inner Falloff");
+		archive(plate.m_skirt, "Skirt", "Skirt");
+	}
+}
+
+void STerrainPlateEditorGroup::Serialize(Serialization::IArchive& archive)
+{
+	if (!archive.isEdit() || m_pOwner == nullptr)
+		return;
+
+	CTerrainPlateComponent& plate = *m_pOwner;
+	archive(plate.m_bUpdateDuringDrag, "UpdateDuringDrag", "Update During Drag");
+}
