+// The skybox unit readout (SceneReferredSpec.md S2, decisions/s2-sky-scale.md).
+//
+// The decision note asks for the times-ten at Renderer.cpp:4007 to be PROVEN before it is
+// changed, by measuring the illuminance a sky of known lux actually delivers. That measurement
+// needs a running engine, so this is the instrument for it: it prints, side by side, what the
+// time of day was AUTHORED with and what the renderer is actually about to multiply the sky
+// texture by, both converted to real units.
+//
+//   authored lux  - recovered from E3DPARAM_SKY_SKYBOX_EMITTANCE, which is the authored
+//                   "Skybox / Intensity (lux)" after ConvertIlluminanceToLightColor's
+//                   / RENDERER_LIGHT_UNIT_SCALE and / PI. Multiplying both back out is exact.
+//   used cd/m2    - m_SkyInfo.m_vSkyBoxEmittance as UpdateSkyInfo() left it (the times-ten, plus
+//                   the sky material's emittance if one is authored), in cd/m^2.
+//   implied lux   - the illuminance a uniform sky of that luminance delivers on a horizontal
+//                   surface, E = PI * L. THIS IS THE NUMBER TO COMPARE: with the times-ten
+//                   gated off it equals the authored lux; with it on it is ten times larger.
+//
+// Luminance is taken as the maximum channel rather than a weighted luminance so that a tinted
+// sky colour does not muddy the ratio being checked.
+void CToneMappingStage::DisplaySkyboxUnitInfo()
+{
+	Vec3 authored(0.0f, 0.0f, 0.0f);
+	gEnv->p3DEngine->GetGlobalParameter(E3DPARAM_SKY_SKYBOX_EMITTANCE, authored);
+
+	const auto threadID = gRenDev->GetRenderThreadID();
+	const Vec3& used = gcpRendD3D->m_p3DEngineCommon[threadID].m_SkyInfo.m_vSkyBoxEmittance;
+
+	// Exact inverse of ConvertIlluminanceToLightColor(lux, colour, true) on the brightest channel.
+	const float authoredLux = max(max(authored.x, authored.y), authored.z) * gf_PI * RENDERER_LIGHT_UNIT_SCALE;
+	const float usedNits = max(max(used.x, used.y), used.z) * RENDERER_LIGHT_UNIT_SCALE;
+	const float impliedLux = usedNits * gf_PI;
+
+	char str[256];
+	sprintf(str, "Skybox: authored %.0f lux -> renderer %.0f cd/m2 (implies %.0f lux, ratio %.2fx)%s",
+	        authoredLux, usedNits, impliedLux,
+	        (authoredLux > 1e-3f) ? (impliedLux / authoredLux) : 0.0f,
+	        gcpRendD3D->m_p3DEngineCommon[threadID].m_SkyInfo.m_bApplySkyBox ? "" : "  [no sky texture: term unused]");
+	IRenderAuxText::DrawText(Vec3(5, 95, 1), IRenderAuxText::ASize(1.0f), ColorF(1, 0, 1, 1), eDrawText_800x600 | eDrawText_2D, str);
 }
