+// Shared cinecam render-state code: the pieces the entity component and the plugin-owned
+// editor-preview publisher (Sandbox viewport camera "CineCam") both need.
+//
+// Nothing here knows about entities or reflected properties. The component keeps one copy of
+// SAutoMeterState and passes its own reflected settings in; the publisher keeps a second copy
+// and passes the fixed editor-look settings in. There is exactly one definition of the meter,
+// of the light-unit convention flip and of the display-LUT slots - a second copy of any of them
+// would be a second answer to "what is correctly exposed", which is the one thing the
+// scene-referred pipeline cannot have.
+#pragma once
+
+#include <CryRenderer/IRenderer.h>   // SSceneReferredMeterHistogram, RENDERER_LIGHT_UNIT_SCALE
+
+namespace CineCam
+{
+
+//! WHY the meter is not moving the EV this frame, published as Global_User_MeterHold so that
+//! r_HDRDebug 1 can print it in words. 0 = live and acting. The table is the renderer's
+//! (CToneMappingStage::DisplaySceneReferredMeterInfo); this side only writes the numbers.
+enum EMeterHold : uint32
+{
+	eMeterHold_Live         = 0,  //!< a target was produced and the EV is following it
+	eMeterHold_NoSample     = 1,  //!< no histogram and no log-mean has come back yet
+	eMeterHold_ZeroTotal    = 2,  //!< the histogram arrived with nothing in it
+	eMeterHold_BandEmpty    = 3,  //!< the percentile band collected no weight
+	eMeterHold_BandInBottom = 4,  //!< the band sits entirely in bin 0 (black, or a source read as black)
+	eMeterHold_BandInTop    = 5,  //!< the band sits entirely in bin 63 (clipped / Inf)
+	eMeterHold_OutOfWindow  = 6,  //!< NaN, or outside the plausibility window
+	eMeterHold_Locked       = 7,  //!< Auto Exposure Lock
+	eMeterHold_LogMean      = 8,  //!< the log-mean fallback is driving (r_SceneReferredMeterHistogram 0)
+	eMeterHold_Manual       = 9,  //!< Manual mode: nothing is metered
+};
+
+//! Everything the AUTO metering loop carries between frames, plus the readouts the
+//! r_HDRDebug 1 overlay is fed from. One instance per driver, never shared: two cameras
+//! metering the same scene still have their own adaptation state, and a cut must snap.
+struct SAutoMeterState
+{
+	//! The smoothed metered EV100, before any bias or compensation.
+	float  autoMeteredEV = 0.f;
+	//! False = "snap on the next measurement" - the camera-cut behaviour AutoExposure.cpp:165
+	//! has, which a camera must reproduce or every cut ramps.
+	bool   bValid = false;
+	//! The EV is asked for more than once a frame; the smoothing step must advance exactly once.
+	uint32 frameId = 0;
+
+	// Published on the post-effect bus for the overlay. Nothing is drawn with them.
+	float  bandLowLum    = 0.f;
+	float  bandHighLum   = 0.f;
+	float  targetEV      = 0.f;
+	//! The band's log-mean in EXPOSED stops over mid grey - the loop's error signal, 0 = on target.
+	float  bandMeanStops = 0.f;
+	uint32 hold = eMeterHold_NoSample;
+
+	//! Log-once flag for an inverted percentile band (an authoring mistake, not a meter failure).
+	bool   bLoggedBandInverted = false;
+};
+
+//! The operator's half of the loop. The component fills this from its reflected Exposure group;
+//! the editor-look publisher fills it with the same defaults a fresh component runs with.
+struct SAutoMeterSettings
+{
+	float bandLowPercent  = 50.f;   //!< Metering Band Low
+	float bandHighPercent = 90.f;   //!< Metering Band High
+	float tau             = 1.f;    //!< Auto Exposure Response Time, seconds
+	float darkenTime      = 0.5f;   //!< Auto Darken Time, seconds (0 = one time constant for both)
+	float response        = 0.6f;   //!< Exposure Response: the fraction of a measured change followed per tau
+	bool  bLock           = false;  //!< Auto Exposure Lock
+};
+
+//! Reduce the renderer's 64-bin metering histogram to the EV that lands the log-mean of the
+//! [bandLowPercent, bandHighPercent] percentile band on mid grey. False = the band could not be
+//! trusted (it resolved inside a saturating bucket, or left the plausibility window) and the
+//! caller must hold its last EV. The reason is left in state.hold either way.
+bool ReduceMeterHistogram(const SSceneReferredMeterHistogram& hist, const SAutoMeterSettings& settings,
+                          SAutoMeterState& state, float& targetEV);
+
+//! One frame of the AUTO metering loop: query both meters, reduce, advance the smoother.
+//! Returns false when nothing has been measured yet - the caller then exposes as Manual rather
+//! than at EV 0, which would be a white frame.
+bool UpdateAutoMeteredEV(const SAutoMeterSettings& settings, SAutoMeterState& state, float& outEV);
+
+//! Mirror the scene-referred switch into the 3D engine (E3DPARAM_SCENE_REFERRED) and, ON A FLIP,
+//! force a full time-of-day re-evaluation and sky-dome recompute so nothing stays cached or
+//! mid-crossfade. See SceneReferredSpec.md S2 / decisions/s2-engine-side-switch.md.
+void PublishSceneReferredConvention(bool bSceneReferred);
+
+//! Load (or reload) the two display-chain .cube files into fp16 3D textures and publish their
+//! renderer texture IDs on the post-effect bus. An empty ODT path stands in the shipped default;
+//! an empty LMT path is the identity look. Cheap on every frame but the first after a change.
+void ApplyDisplayLuts(const char* szODTFile, const char* szLMTFile);
+
+//! Take the LUT ids off the bus and release both textures. Safe to call repeatedly.
+void RestoreDisplayLuts();
+
+} // namespace CineCam
