+// ---------------------------------------------------------------------------
+// Sandbox editor preview (decisions/s9-editor-cinecam-preview.md)
+// ---------------------------------------------------------------------------
+void CCinematicCameraPlugin::SetViewportPreview(ECineCamEditorPreviewMode mode, EntityId entityId, const CCamera& camera)
+{
+	// The camera itself is not needed yet: in edit mode the viewport writes the system view camera
+	// itself immediately before RenderWorld, so nothing here may touch it. It is part of the
+	// contract because the alternative - having the plugin guess the viewport's frustum - is the
+	// fragile pose-matching approach this design rejected (research/editor-ccam-activation.md, B2).
+	(void)camera;
+
+	m_previewMode = mode;
+	m_previewEntityId = (mode == ECineCamEditorPreviewMode::Entity) ? entityId : INVALID_ENTITYID;
+	m_previewFrameId = gEnv->nMainFrameID;
+}
+
+void CCinematicCameraPlugin::ClearViewportPreview()
+{
+	m_previewMode = ECineCamEditorPreviewMode::Default;
+	m_previewEntityId = INVALID_ENTITYID;
+	m_previewFrameId = 0;
+
+	// Hand the render state back at once rather than waiting for a frame that may never come: this
+	// is called when the viewport is destroyed or the level is closing.
+	CCinematicCameraComponent::SetEditorPreviewOwner(nullptr);
+	m_editorLook.Restore();
+}
+
+void CCinematicCameraPlugin::LogPreviewOwnerChange(ECineCamEditorPreviewMode mode, const CCinematicCameraComponent* pOwner)
+{
+	const EntityId ownerId = (pOwner && pOwner->GetEntity()) ? pOwner->GetEntity()->GetId() : INVALID_ENTITYID;
+
+	if (m_bLoggedPreviewOnce && mode == m_loggedPreviewMode && ownerId == m_loggedPreviewEntityId)
+		return;
+
+	m_bLoggedPreviewOnce = true;
+	m_loggedPreviewMode = mode;
+	m_loggedPreviewEntityId = ownerId;
+
+	switch (mode)
+	{
+	case ECineCamEditorPreviewMode::CineCam:
+		CryLog("[cinecam] editor preview -> CineCam");
+		break;
+	case ECineCamEditorPreviewMode::Entity:
+		CryLog("[cinecam] editor preview -> Entity %s",
+		       (pOwner && pOwner->GetEntity()) ? pOwner->GetEntity()->GetName() : "<gone>");
+		break;
+	default:
+		CryLog("[cinecam] editor preview -> Default");
+		break;
+	}
+}
+
+void CCinematicCameraPlugin::UpdateEditorPreview()
