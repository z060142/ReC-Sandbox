From 0d892c5c2083637cf85391cedfc7ef8549404aff Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Thu, 13 Aug 2026 00:13:58 +0800
Subject: [PATCH 199/206] fix: sun-ward RSM occlusion becomes a knob
 (r_LPVRsmClipRange, default 0)

The fixed 2500m clip range made the sun-ward geometry occlude the
volume honestly - which at this level's grazing sun elevation blacked
out the whole volume (a 20m tree line shadows ~150m of ground at ~8
degrees). The user's known-good baseline was produced by the previous
behaviour, where the overhang got clipped away.

The trade-off is now explicit: r_LPVRsmClipRange 0 (default) restores
the sweep-tight near plane (distant occluders cannot darken the volume;
erasure blobs may return at large cascade scales), larger values render
the sun-ward geometry for honest occlusion. Mid values (~300-500) clip
the distant hills while keeping nearby occluders and most blob sources
out of the pancake zone.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tu9cj9ax1mqCV93HVfCfpW
---
 Code/CryEngine/Cry3DEngine/ShadowCache.cpp    | 19 ++++++++++---------
 .../RenderDll/Common/RendererCVars.cpp        |  7 +++++++
 .../RenderDll/Common/RendererCVars.h          |  1 +
 3 files changed, 18 insertions(+), 9 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/ShadowCache.cpp b/Code/CryEngine/Cry3DEngine/ShadowCache.cpp
index e9ebe56f..b3581839 100644
--- a/Code/CryEngine/Cry3DEngine/ShadowCache.cpp
+++ b/Code/CryEngine/Cry3DEngine/ShadowCache.cpp
@@ -394,15 +394,16 @@ void ShadowCacheGenerator::InitLPVRsmFrustum(ShadowMapFrustumPtr& pFr, int nLod,
 	// Everything between the sun and the volume can throw light into it, so extend the near plane.
 	const float casterRange = max(Get3DEngine()->m_fSunClipPlaneRange, 2.0f * halfExtent);
 
-	// The CLIP range has to be much larger than the caster collection sweep: collection is by AABB
-	// overlap, so huge nodes (terrain hills, merged tree patches) become members even though most
-	// of their geometry lies sun-ward of the sweep - with the near plane at the sweep distance that
-	// geometry gets pancaked onto the near plane and its silhouette ERASES everything behind it
-	// from the RSM (observed as solid canopy/hill blobs blotting out the hangar and the ground, and
-	// growing with r_LPVCascadeScale because the bigger swept box overlaps more of those nodes).
-	// D16 precision over the enlarged range stays at centimeter level, which is far below the cell
-	// size.
-	const float clipRange = max(casterRange, 2500.0f);
+	// Sun-ward occlusion fidelity trade-off (r_LPVRsmClipRange):
+	// - 0 (default): the near plane sits at the collection sweep distance. Geometry overhanging the
+	//   sweep towards the sun is CLIPPED AWAY, so distant tree lines / hills do not occlude the
+	//   volume in the RSM. At grazing sun elevations this is what keeps the volume lit at all (a
+	//   20m tree line shadows ~150m of ground at 7.6 degrees), at the cost of some wrongly sunlit
+	//   injection in areas that are genuinely shadowed by external geometry - and of erasure blobs
+	//   when huge member nodes (hills, merged tree patches) get their overhang pancaked.
+	// - > 0: the clip range extends to this many meters, members render fully and occlude honestly.
+	static ICVar* pClipRange = gEnv->pConsole->GetCVar("r_LPVRsmClipRange");
+	const float clipRange = max(casterRange, pClipRange ? pClipRange->GetFVal() : 0.0f);
 
 	// Virtual light distance instead of the astronomic distance to the real sun light origin: with
 	// fDist ~1e6 the resulting projection (near ~= far ~= 1e6, FOV ~0.01 deg) is so ill conditioned
diff --git a/Code/CryEngine/RenderDll/Common/RendererCVars.cpp b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
index 05aeca8f..71d138fa 100644
--- a/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
+++ b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
@@ -427,6 +427,7 @@ float CRendererCVars::CV_r_LPVMaxIrradiance;
 float CRendererCVars::CV_r_LPVSpecular;
 float CRendererCVars::CV_r_LPVPointLights;
 float CRendererCVars::CV_r_LPVRsmMinCasterSize;
+float CRendererCVars::CV_r_LPVRsmClipRange;
 int   CRendererCVars::CV_r_LPVUpdateInterval;
 int   CRendererCVars::CV_r_LPVDebug;
 
@@ -2251,6 +2252,12 @@ void CRendererCVars::InitCVars()
 	               "this defaulted to 150 - the old operator lost ~90% of the energy per cell step.)\n");
 	REGISTER_CVAR3("r_LPVInjectionBias", CV_r_LPVInjectionBias, 0.5f, VF_NULL,
 	               "Offset in cells applied to injected virtual point lights, reduces self illumination and thin wall bleeding.\n");
+	REGISTER_CVAR3("r_LPVRsmClipRange", CV_r_LPVRsmClipRange, 0.0f, VF_NULL,
+	               "Sun-ward clip range in meters of the LPV RSM view. 0 (default) clips everything beyond\n"
+	               "the caster collection sweep: distant tree lines / hills do not occlude the volume in the\n"
+	               "RSM, which keeps it lit at grazing sun elevations (at the cost of some wrongly sunlit\n"
+	               "injection in genuinely shadowed areas). Larger values render the sun-ward geometry fully\n"
+	               "for honest occlusion - expect a much darker volume when the sun is low.\n");
 	REGISTER_CVAR3("r_LPVRsmMinCasterSize", CV_r_LPVRsmMinCasterSize, 0.5f, VF_NULL,
 	               "Objects with a bounding radius below this (meters) are skipped by the LPV RSM render:\n"
 	               "sub-texel props cannot produce meaningful bounce surfels, they only cost draw calls.\n"
diff --git a/Code/CryEngine/RenderDll/Common/RendererCVars.h b/Code/CryEngine/RenderDll/Common/RendererCVars.h
index e088c429..484e18ba 100644
--- a/Code/CryEngine/RenderDll/Common/RendererCVars.h
+++ b/Code/CryEngine/RenderDll/Common/RendererCVars.h
@@ -672,6 +672,7 @@ public:
 	static float CV_r_LPVSpecular;
 	static float CV_r_LPVPointLights;
 	static float CV_r_LPVRsmMinCasterSize;
+	static float CV_r_LPVRsmClipRange;
 	static int   CV_r_LPVUpdateInterval;
 	static int   CV_r_LPVDebug;
 
