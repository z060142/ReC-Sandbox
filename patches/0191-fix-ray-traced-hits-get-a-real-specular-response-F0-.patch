+///////////////////////////////////////////////////////////////////////////////////
+// rt stage 2D - the hit's reflectance and smoothness lane (HITPOS.w)
+//
+// WHY THIS EXISTS. Until 2D the hit's F0 travelled through PackRGB, which is 3 bits per
+// channel (RT_RGB_RANGE 8, eight levels). CE's dielectric F0 is MatSpecColor averaged, which
+// is 0.0369 for a plain material and a hard-coded 0.02 for terrain, and
+//     round(0.0369 * 7) = 0
+// so EVERY dielectric hit arrived at ShadePS with F0 exactly 0. shadeLib.cfi SpecularBRDF
+// then computes f90 = saturate(dot(f0, 1/3) / 0.02) = 0 and returns fresnel * spec = 0: no
+// sun highlight, no local-light highlight, nothing, at every non-metal hit in every
+// reflection. The first surviving step of the old encoding was 1/7 = 0.143, i.e. only a
+// material with F0 >= 0.0714 kept any specular at all.
+//
+// THE BUDGET. The g-data has exactly two spare lanes and both are needed:
+//   ALD.w      RGBA16F  - integers are exact to 2048, so 11 bits, and the sign is free.
+//   HITPOS.w   RGBA32F  - a 24 bit mantissa, so integers are exact to 2^24 - 1.
+// RAYDIR.w is the hit distance and the "is this an RT pixel" sentinel, RGB.w is the
+// reflecting pixel's linear depth that DemosaicPS bilaterally weights on, ALD.xyz is the
+// normal times (1 + emittance) and RGB.xyz is the albedo. Nothing else is free.
+//
+// THE LAYOUT. The emissive hue moves out to ALD.w (it fits in 9 bits and fp16 holds it
+// exactly), which frees the whole 24 bit HITPOS.w mantissa for the three values that the
+// specular lobe actually reads:
+//
+//   HITPOS.w = ((hueCode * 256) + greyIdx) * 256 + smoothIdx        (max 14 155 775 < 2^24)
+//
+//     smoothIdx  8 bits, linear        smoothness = smoothIdx / 255
+//     greyIdx    8 bits, SQUARE law    F0max      = (greyIdx / 255)^2
+//     hueCode    PackRGB base 6 (216)  F0         = F0max * hue,  hue.max == 1 by construction
+//
+// The square law is the point of the fix: a linear 8 bit grey has a 0.0039 step, which is 11 %
+// of a 0.0369 dielectric; the square law puts 49 of its 256 steps below 0.04, so a dielectric
+// resolves to about 4 % RELATIVE - two orders of magnitude better than the old encoding, which
+// resolved it to zero. The hue is max-channel normalised before quantisation so the maximum
+// channel always lands on exactly 1.0 and the magnitude is carried entirely by greyIdx; a
+// coloured metal (gold, copper) keeps its tint to ~2.6 bits per channel, which is what is left
+// after the dielectric case has been given the precision it needs. Both are exact integers, so
+// the round trip is deterministic and testable.
+///////////////////////////////////////////////////////////////////////////////////
+
+#define RT_HUE_RANGE     6      // levels per channel in the reflectance hue code (6^3 = 216)
+#define RT_SMOOTH_STEPS  255    // smoothIdx in [0, 255]
+#define RT_GREY_STEPS    255    // greyIdx   in [0, 255]
+
+float RT_PackHitMaterial(const float3 vReflectance, const float fSmoothness)
+{
+	const float3 vRefl = max(vReflectance, 0.f);
+	const float  fMax  = min(max(vRefl.x, max(vRefl.y, vRefl.z)), 1.f);
+
+	// hue, max-channel normalised; a black F0 gets the white hue so that greyIdx alone decides
+	const float3 vHue = (fMax > 1e-5f) ? saturate(vRefl / fMax) : (float3)1.f;
+	const uint3  hueI = (uint3)clamp((int3)(vHue * (RT_HUE_RANGE - 1) + 0.5f), 0, RT_HUE_RANGE - 1);
+	const uint   hueCode = hueI.x + hueI.y * RT_HUE_RANGE + hueI.z * RT_HUE_RANGE * RT_HUE_RANGE;
+
+	const uint greyIdx   = (uint)clamp((int)(sqrt(fMax) * RT_GREY_STEPS + 0.5f), 0, RT_GREY_STEPS);
+	const uint smoothIdx = (uint)clamp((int)(saturate(fSmoothness) * RT_SMOOTH_STEPS + 0.5f), 0, RT_SMOOTH_STEPS);
+
+	return (float)(((hueCode * 256u) + greyIdx) * 256u + smoothIdx);
+}
+
+void RT_UnpackHitMaterial(const float fPacked, out float3 vReflectance, out float fSmoothness)
+{
+	uint code = (uint)(abs(fPacked) + 0.5f);
+
+	const uint smoothIdx = code & 255u; code /= 256u;
+	const uint greyIdx   = code & 255u; code /= 256u;
+	uint       hueCode   = code;
+
+	fSmoothness = (float)smoothIdx * (1.f / RT_SMOOTH_STEPS);
+
+	const float fGrey = (float)greyIdx * (1.f / RT_GREY_STEPS);
+
+	float3 vHue;
+	vHue.x = hueCode % RT_HUE_RANGE; hueCode /= RT_HUE_RANGE;
+	vHue.y = hueCode % RT_HUE_RANGE; hueCode /= RT_HUE_RANGE;
+	vHue.z = hueCode % RT_HUE_RANGE;
+
+	vReflectance = (fGrey * fGrey) * (vHue * (1.f / (RT_HUE_RANGE - 1)));
+}
+
+// ALD.w: the emissive hue code, offset by one so the lane is never zero, signed by the
+// lighting model. Decoded with RT_UnpackEmissiveHue in ShadePS.
+float RT_PackEmissiveHue(const float3 vHue, const bool bVegLeaves)
+{
+	return (bVegLeaves ? -1.f : 1.f) * (PackRGB(vHue) + 1.f);
+}
+
+float3 RT_UnpackEmissiveHue(const float fPacked)
+{
+	return UnpackRGB(max(abs(fPacked) - 1.f, 0.f));
+}
