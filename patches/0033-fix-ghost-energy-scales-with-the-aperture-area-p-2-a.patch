From 0391f529f2a8ea9b8529ba133050b682e0fe03d6 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 26 Aug 2026 20:20:02 +0800
Subject: [PATCH 033/119] fix: ghost energy scales with the aperture area (p^2)
 and is decoupled from the bokeh highlight gain - ghosts shrink when stopping
 down instead of turning into blazing specks

---
 .../XRenderD3D9/GraphicsPipeline/DepthOfField.cpp | 15 ++++++++++++++-
 Code/CryPlugins/CinematicCamera/LensGhostSpec.md  |  6 +++++-
 2 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
index 3e46f9b5..07115fc1 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
@@ -1141,7 +1141,20 @@ void CDepthOfFieldStage::ExecuteSplatLayers(const SDepthOfFieldParams& dofParams
 			const Vec3 cTint = RotateHueAroundGrey(vGhostTint, (float)i * dofParams.fGhostHueSpread * DEG2RAD(120.0f));
 
 			const Vec4 vGhost0(fK, fRadiusPx, fGhostThreshold, fGhostKnee);
-			const Vec4 vGhost1(cTint.x, cTint.y, cTint.z, dofParams.fGhostAmount);
+			// Energy of a ghost goes with the AREA of the aperture, like everything else the lens
+			// passes: the pixel shader spreads a fixed energy over the disc, and the disc area is
+			// itself proportional to p^2, so without this factor a ghost got 1/p^2 brighter as the
+			// iris closed - blazing specks at f/8 that then fed the streak threshold. With it the
+			// per-pixel brightness relative to the scene is what the coating decides and stays
+			// put at every f-number; the ghost only shrinks and hardens, as on a real lens.
+			// The bokeh splat's user gain (vDofBokehHighlight.z, applied in the shared pixel
+			// shader) is divided back out so a lens preset's ghosts do not move with its
+			// highlight gain; the pupil-fill correction inside that constant is kept, since a
+			// ghost is the same silhouette. kGhostGain = 3 puts amount 1 at the splat's default.
+			const float kGhostGain = 3.0f;
+			const float fGhostEnergy = dofParams.fGhostAmount * dofParams.fPupilScale * dofParams.fPupilScale
+			                           * kGhostGain / max(dofParams.fHighlightGain, 0.05f);
+			const Vec4 vGhost1(cTint.x, cTint.y, cTint.z, fGhostEnergy);
 
 			CRenderPrimitive& ghostPrim = m_ghostPrimitives[i];
 			ghostPrim.SetFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_VS | CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
diff --git a/Code/CryPlugins/CinematicCamera/LensGhostSpec.md b/Code/CryPlugins/CinematicCamera/LensGhostSpec.md
index eb91980a..7f0e2a74 100644
--- a/Code/CryPlugins/CinematicCamera/LensGhostSpec.md
+++ b/Code/CryPlugins/CinematicCamera/LensGhostSpec.md
@@ -33,7 +33,11 @@ aperture, so it shrinks when the iris closes), colour
 `c_i = excess * amount * tint rotated in hue by i * hueSpread * 120°`
 
 (`excess` = the source's luminance above the ghost threshold with the same quadratic knee the
-splat uses; the hue rotation is the cheap stand-in for different coatings on different
+splat uses, times `p²` - the energy a ghost carries goes with the aperture AREA like everything
+else the lens passes, and since the disc area is also ∝ p² the per-pixel brightness relative to
+the scene is constant at every f-number: stopping down makes ghosts smaller and harder-edged,
+never brighter (the first cut lacked this and produced blazing specks at f/8 that then grew
+streaks); the bokeh splat's user Highlight Gain is divided out so presets do not couple; the hue rotation is the cheap stand-in for different coatings on different
 surfaces — one base tint, the rest fan out around it), deposited energy-conservingly over the
 disc exactly as a bokeh sprite is (`fSplatNorm` with `QuadPos.w = r_i`, `Field.z`, dither).
 
