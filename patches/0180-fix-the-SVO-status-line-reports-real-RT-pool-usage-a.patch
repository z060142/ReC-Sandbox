From 2bef67c21a454cf01d448b2a1ed18788e271d4c8 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sun, 13 Sep 2026 18:27:47 +0800
Subject: [PATCH 180/215] fix: the SVO status line reports real RT pool usage
 and BVH build statistics

The old "RT pools" line divided Count() by capacity() for the three RT pools,
but PodArray::CheckAllocated sets Count() to the full capacity on the first
allocation, so all three values always read 1.00 and the fill level was not
observable (research/01 finding 15).

It now reports the chunk allocator's used records against the size of the
STATIC segment plus the pool's memory footprint, and the atlas free list's used
slices against e_svoTI_RT_TexPoolZ. A second line carries the accumulated static
BVH build statistics: cells, triangles, nodes, leaves, deepest leaf, biggest
leaf, material records, triangles whose UVs did not fit [0, 16), rejected
degenerates and total build time. Both lines appear only with
e_svoTI_RT_Active and r_DisplayInfo 2.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SCUvWGLCsqzm3VNMzp4uiS
---
 .../Cry3DEngine/SVO/SceneTreeManager.cpp      | 23 +++++++++++++++----
 1 file changed, 18 insertions(+), 5 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/SVO/SceneTreeManager.cpp b/Code/CryEngine/Cry3DEngine/SVO/SceneTreeManager.cpp
index 3c36269a..da788a2d 100644
--- a/Code/CryEngine/Cry3DEngine/SVO/SceneTreeManager.cpp
+++ b/Code/CryEngine/Cry3DEngine/SVO/SceneTreeManager.cpp
@@ -125,12 +125,25 @@ char* CSvoManager::GetStatusString(int lineId)
 		return szText;
 	}
 
-	if (lineId == (slotId++) && gSvoEnv->m_arrRTPoolInds.Count())
+	// RT pool fill: PodArray::CheckAllocated sets Count() to the full capacity, so the old
+	// "Count / capacity" always printed 1.00 (research/01 finding 15). Report the allocator instead.
+	if (lineId == (slotId++) && Cry3DEngineBase::GetCVars()->e_svoTI_RT_Active)
 	{
-		cry_sprintf(szText, "RT pools: tex %.2f, verts %.2f, inds %.2f",
-		            (float)gSvoEnv->m_arrRTPoolTexs.Count() / max((float)gSvoEnv->m_arrRTPoolTexs.capacity(), 1.f),
-		            (float)gSvoEnv->m_arrRTPoolTris.Count() / max((float)gSvoEnv->m_arrRTPoolTris.capacity(), 1.f),
-		            (float)gSvoEnv->m_arrRTPoolInds.Count() / max((float)gSvoEnv->m_arrRTPoolInds.capacity(), 1.f));
+		const int recordsTotal = max(1, gSvoEnv->GetRTPoolRecords() - SVO_RT_SEG_STATIC);
+		cry_sprintf(szText, "RT pools: records %d of %d = %.1f%% (%d MB), atlas %d of %d (%d MB)",
+		            gSvoEnv->m_rtRecordsUsed, recordsTotal, 100.f * gSvoEnv->m_rtRecordsUsed / recordsTotal,
+		            int((int64)gSvoEnv->GetRTPoolXY() * gSvoEnv->GetRTPoolXY() * gSvoEnv->GetRTPoolZ() * sizeof(Vec4) / 1024 / 1024),
+		            gSvoEnv->m_rtTexSlicesUsed, gSvoEnv->GetRTTexPoolZ(),
+		            int((int64)gSvoEnv->GetRTTexRes() * gSvoEnv->GetRTTexRes() * gSvoEnv->GetRTTexPoolZ() * sizeof(ColorB) / 1024 / 1024));
+		return szText;
+	}
+
+	if (lineId == (slotId++) && Cry3DEngineBase::GetCVars()->e_svoTI_RT_Active)
+	{
+		const SRTBuildStats& st = gSvoEnv->m_rtStats;
+		cry_sprintf(szText, "RT BVH: %d cells, %d K tris, %d K nodes, %d leaves, depth %d, maxLeaf %d, %d mats, uvClamp %d, skip %d, %.0f ms",
+		            st.cells, st.tris / 1000, st.nodes / 1000, st.leaves, st.maxDepth, st.maxLeafTris,
+		            st.mats, st.uvClamped, st.trisSkipped, st.buildMs);
 		return szText;
 	}
 
