 .../RenderDll/Common/RendererCVars.h          |  1 +
 .../GraphicsPipeline/DepthOfField.cpp         | 48 +++++++++++++++----
 .../Module/CinematicCameraComponent.cpp       |  5 +-
 4 files changed, 49 insertions(+), 10 deletions(-)

diff --git a/Code/CryEngine/RenderDll/Common/RendererCVars.cpp b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
index c914cd91..9df571fc 100644
--- a/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
+++ b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
@@ -327,6 +327,7 @@ int CRendererCVars::CV_r_MotionBlurQuality;
 int CRendererCVars::CV_r_MotionBlurGBufferVelocity;
 float CRendererCVars::CV_r_MotionBlurThreshold;
 int CRendererCVars::CV_r_MaxFrameLatency;
+float CRendererCVars::CV_r_DofBokehShapeStrength;
 float CRendererCVars::CV_r_MotionBlurShutterSpeed;
 float CRendererCVars::CV_r_MotionBlurCameraMotionScale;
 float CRendererCVars::CV_r_MotionBlurMaxViewDist;
@@ -1475,6 +1476,10 @@ void CRendererCVars::InitCVars()
 	               "Usage: r_MotionBlurThreshold (val)\n"
 	               "Default is 0.0001.  0 - disabled\n");
 
+	REGISTER_CVAR3("r_DofBokehShapeStrength", CV_r_DofBokehShapeStrength, 2.0f, VF_NULL,
+	               "Exaggeration exponent for the polygonal bokeh kernel. "
+	               "1 = physical radius modulation (subtle for high blade counts), "
+	               "2-3 = clearly readable polygons, 4 = star-like caricature.");
 	REGISTER_CVAR3("r_MotionBlurShutterSpeed", CV_r_MotionBlurShutterSpeed, 250.0f, 0,
 	               "Sets camera exposure time for motion blur as 1/x seconds.\n"
 	               "Default: 250 (1/250 of a second)");
diff --git a/Code/CryEngine/RenderDll/Common/RendererCVars.h b/Code/CryEngine/RenderDll/Common/RendererCVars.h
index 203aadaf..19cfa148 100644
--- a/Code/CryEngine/RenderDll/Common/RendererCVars.h
+++ b/Code/CryEngine/RenderDll/Common/RendererCVars.h
@@ -515,6 +515,7 @@ public:
 	static float CV_r_DrawNearZRange;
 	static float CV_r_DrawNearFarPlane;
 	static float CV_r_rainamount;
+	static float CV_r_DofBokehShapeStrength;
 	static float CV_r_MotionBlurShutterSpeed;
 	static float CV_r_MotionBlurCameraMotionScale;
 	static float CV_r_MotionBlurMaxViewDist;
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
index b335afb7..6bfcb91f 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
@@ -13,9 +13,10 @@ float NGon_Rad(float theta, float n)
 Vec4 CDepthOfFieldStage::ToUnitDisk(Vec4& origin, float blades, float fstop)
 {
 	// Wide open irises are round (blades retracted); stopping down reveals the polygon.
-	// f/1.4 or faster stays circular, f/8 and slower is the full n-gon.
-	const float minFstops = 1.4f;
-	const float maxFstops = 8.0f;
+	// The window must overlap with LARGE bokeh discs or the shape is never readable, so the
+	// polygon is fully formed one stop past wide open: round at f/1.2, complete by f/2.8.
+	const float minFstops = 1.2f;
+	const float maxFstops = 2.8f;
 	const float normalizedStops = clamp_tpl((fstop - minFstops) / (maxFstops - minFstops), 0.0f, 1.0f);
 
 	float phi;
@@ -33,11 +34,20 @@ Vec4 CDepthOfFieldStage::ToUnitDisk(Vec4& origin, float blades, float fstop)
 		phi = (PI / 2.0f) - (PI / 4.0f) * (a / (b + 1e-6f));
 	}
 
-	float rr = r * powf(NGon_Rad(phi, blades), normalizedStops);
-	rr = abs(rr) * (rr > 0 ? 1.0f : -1.0f);
+	// Shirley's mapping yields signed radii; fold the sign into the ANGLE before evaluating
+	// the polygon. The legacy code multiplied the sign back into the radius instead, which
+	// point-mirrors half the taps while keeping the un-mirrored polygon radius - harmless
+	// for the hardcoded (centro-symmetric) 8-gon it always ran with, but it averages any
+	// odd-sided polygon with its own mirror image and washes it back into a circle.
+	const float finalAngle = phi + (r < 0.0f ? PI : 0.0f);
 
-	//normalizedStops *= -0.4f * PI;
-	return Vec4(rr * cosf(phi + normalizedStops), rr * sinf(phi + normalizedStops), 0.0f, 0.0f);
+	// Shape strength exaggerates the polygon's radius modulation (cos(pi/n) between edge
+	// centre and vertex is only 19% for a pentagon, 8% for an octagon - too subtle after
+	// the quarter-res gather and TAA). Live-tunable via r_DofBokehShapeStrength.
+	const float shapeStrength = clamp_tpl(CRenderer::CV_r_DofBokehShapeStrength, 0.25f, 4.0f);
+	const float rr = fabsf(r) * powf(NGon_Rad(finalAngle, blades), normalizedStops * shapeStrength);
+
+	return Vec4(rr * cosf(finalAngle), rr * sinf(finalAngle), 0.0f, 0.0f);
 }
 
 void CDepthOfFieldStage::Execute()
@@ -57,8 +67,28 @@ void CDepthOfFieldStage::Execute()
 	Vec4 vFocus = dofParams.vFocus;
 	vFocus.w *= 2;  // For backwards compatibility
 
-	const float fFNumber = dofParams.fApertureFNumber;
-	const float fNumApertureSides = clamp_tpl(dofParams.fApertureBlades, 3.0f, 16.0f);
+	float fFNumber = dofParams.fApertureFNumber;
+	float fNumApertureSides = clamp_tpl(dofParams.fApertureBlades, 3.0f, 16.0f);
+
+	// r_DepthOfFieldBokehQuality N (N >= 3): diagnostic force mode - N blades at full
+	// polygon blend, independent of whatever game code feeds the params. A triangle (3)
+	// is unmissable if the kernel shaping works at all.
+	if (CRenderer::CV_r_DofBokehQuality >= 3)
+	{
+		fNumApertureSides = (float)CRenderer::CV_r_DofBokehQuality;
+		fFNumber = 8.0f;
+	}
+
+	// Ground truth log: what actually reaches the kernel, once per change.
+	static float s_lastLoggedBlades = -1.0f;
+	static float s_lastLoggedFNumber = -1.0f;
+	if (fabsf(fNumApertureSides - s_lastLoggedBlades) > 0.01f || fabsf(fFNumber - s_lastLoggedFNumber) > 0.01f)
+	{
+		s_lastLoggedBlades = fNumApertureSides;
+		s_lastLoggedFNumber = fFNumber;
+		CryLog("[DOF] kernel blades=%.0f fNumber=%.1f%s", fNumApertureSides, fFNumber,
+		       CRenderer::CV_r_DofBokehQuality >= 3 ? " (FORCED)" : "");
+	}
 
 	if (dofParams.bGameMode)
 	{
diff --git a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp
index 82ce03e3..c0c9a82b 100644
--- a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp
+++ b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp
@@ -400,7 +400,10 @@ void CCinematicCameraComponent::ComputeDOFBounds(float& outNear, float& outFar)
 // Normalised blur: maxBokeh_mm = focalLength / aperture; reference = 85mm / f1.4 ≈ 60mm.
 float CCinematicCameraComponent::ComputeMaxBlurAmount() const
 {
-	return clamp_tpl(GetEffectiveFocalLength() / max((float)m_lens.aperture, 0.7f) / 60.0f, 0.0f, 1.0f);
+	// Experimentally unclamped past 1.0 (engine side has no hard cap; the value scales the
+	// CoC). Long lenses wide open now produce genuinely larger discs - watch for gather
+	// undersampling (sparse/ringy discs) at the top end, the kernel is still 49 taps.
+	return clamp_tpl(GetEffectiveFocalLength() / max((float)m_lens.aperture, 0.7f) / 60.0f, 0.0f, 4.0f);
 }
 
 // What to feed Dof_User_FocusRange.
