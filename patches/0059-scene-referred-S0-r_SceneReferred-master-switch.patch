+		desc.SetGUID("{0B4F1E27-9C3A-4D56-8E71-5A2C6F0D8B93}"_cry_guid);
+		desc.SetLabel("Scene Referred");
+		desc.AddMember(&SCineSceneReferredParams::bSceneReferred,
+			'scnr', "SceneReferred", "Scene Referred",
+			"Ask the renderer for the scene-referred pipeline: everything between the lights and "
+			"the display transform stays in scene units - real luminance, no [0,1], no display "
+			"encoding - so exposure, white balance, grading and the optical effects work on how "
+			"much light is in the scene instead of on a picture already squeezed onto a monitor. "
+			"Gated again by the r_SceneReferred cvar; off = the stock engine pipeline, byte for "
+			"byte. Default off while the pipeline is being built stage by stage.", false);
+	}
+
+	bool bSceneReferred = false;
+};
