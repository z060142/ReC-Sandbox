+// The component asks; the cvar may refuse. Same shape as the lens model's gate in
+// CDepthOfFieldStage::Execute(): the request travels on the post-effect parameter bus (it is
+// per-frame, per-camera data and the bus already has the reset/handover semantics for it), and
+// r_SceneReferred ANDs it away. When this returns false not one line of the scene-referred work
+// runs and every target, pass and constant keeps its stock value.
+bool CRendererResources::IsSceneReferred()
+{
+	if (CRenderer::CV_r_SceneReferred == 0)
+		return false;
+
+	CPostEffectsMgr* pPostMgr = PostEffectMgr();
+	if (!pPostMgr)
+		return false;
+
+	CEffectParam* pRequest = pPostMgr->GetByName("Global_User_SceneReferred");
+	return pRequest != nullptr && pRequest->GetParam() > 0.5f;
+}
