+	virtual const char*    ClassName() override       { return "EditTool.AreaShapeEdit"; }
+	virtual const char*    Category() override        { return "Area"; }
+	virtual CRuntimeClass* GetRuntimeClass() override { return RUNTIME_CLASS(CShapeEditTool); }
+};
