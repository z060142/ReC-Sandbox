+	{
+		for (int direction = 0; direction < kMaxStreakDirections; ++direction)
+		{
+			for (int iteration = 0; iteration < kStreakIterations; ++iteration)
+				m_passStreakStretch[direction][iteration].SetGraphicsPipeline(&graphicsPipeline);
+		}
+	}
 
 	bool IsStageActive(EShaderRenderingFlags flags) const final
 	{
@@ -25,8 +39,13 @@ public:
 	void Execute();
 
 private:
+	void ExecuteStreaks();
+
 	CFullscreenPass m_pass1H;
 	CFullscreenPass m_pass1V;
 	CFullscreenPass m_pass2H;
 	CFullscreenPass m_pass2V;
+
+	CFullscreenPass m_passStreakThreshold;
+	CFullscreenPass m_passStreakStretch[kMaxStreakDirections][kStreakIterations];
 };
