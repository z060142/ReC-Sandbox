 #include "StdAfx.h"
 #include "Bloom.h"
+#include "D3DPostProcess.h"
+
+// Taps per stretch iteration. Must match the unrolled loop in HDRStreakStretchPS.
+static const int s_nStreakTapCount = 8;
+// Per tap intensity falloff of the first iteration. Later iterations raise it by the tap
+// count so the combined falloff stays exponential in distance rather than in iteration.
+static const float s_fStreakDecay = 0.93f;
 
 void CBloomStage::Execute()
 {
@@ -95,4 +102,129 @@ void CBloomStage::Execute()
 	m_pass2V.BeginConstantUpdate();
 	m_pass2V.SetConstant(hdrParams0Name, Vec4(0, (sigma2 / sigma1) * scaleH, 0, 0), eHWSC_Pixel);
 	m_pass2V.Execute();
+
+	ExecuteStreaks();
+}
+
+// Aperture diffraction streaks (sunstars).
+//
+// Runs after the bloom chain, which leaves both quarter resolution HDR scratch targets free:
+// $HDRTarget 1/4b holds the thresholded sources and $HDRTarget 1/4a is the ping-pong buffer,
+// so the streaks cost no permanent memory of their own. The half resolution HDR scene is
+// still intact at this point (the sun shafts stage reads it afterwards) and serves as the
+// threshold input. The last stretch iteration blends straight into $HDRFinalBloom, so the
+// streaks travel through the existing bloom composition instead of a second tone-map hook.
+void CBloomStage::ExecuteStreaks()
+{
+	if (!CRenderer::CV_r_HDRStreaks)
+		return;
+
+	CHDRStreaks* pStreaksTech = static_cast<CHDRStreaks*>(PostEffectMgr()->GetEffect(EPostEffectID::HDRStreaks));
+	if (pStreaksTech == nullptr)
+		return;
+
+	SHDRStreaksParams streakParams = pStreaksTech->GetParams();
+
+	// r_HDRStreaks 2: diagnostic force mode - full strength, low threshold, four rays,
+	// independent of any game code driving the params.
+	if (CRenderer::CV_r_HDRStreaks == 2)
+	{
+		streakParams.bActive = true;
+		streakParams.fAmount = 1.0f;
+		streakParams.nDirectionCount = 8;
+		streakParams.fAngle = 0.4f;
+		streakParams.fThreshold = 0.5f;
+		streakParams.fLength = 0.6f;
+	}
+
+	if (!streakParams.bActive || streakParams.fAmount < 0.001f || streakParams.nDirectionCount < 4)
+		return;
+
+	PROFILE_LABEL_SCOPE("HDR_STREAKS");
+
+	static CCryNameTSCRC techStreakThreshold("HDRStreakThreshold");
+	static CCryNameTSCRC techStreakStretch("HDRStreakStretch");
+	static CCryNameR streakParams0Name("StreakParams0");
+	static CCryNameR streakParams1Name("StreakParams1");
+
+	CTexture* pStreakSource = m_graphicsPipelineResources.m_pTexHDRTargetScaled[1][1];
+	CTexture* pStreakPingPong = m_graphicsPipelineResources.m_pTexHDRTargetScaled[1][0];
+
+	// The Count param carries the SPIKE count (even by construction: N for even blade
+	// counts, 2N for odd). Each pass draws a symmetric line = two opposed spikes, so the
+	// lines span 180 degrees and there are half as many passes as spikes.
+	const int nLineCount = clamp_tpl(streakParams.nDirectionCount / 2, 2, kMaxStreakDirections);
+
+	// Threshold. The knee is a quarter of the threshold, wide enough to stop the sources
+	// popping in and out between frames but far too narrow to catch a merely bright sky.
+	if (m_passStreakThreshold.IsDirty())
+	{
+		m_passStreakThreshold.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passStreakThreshold.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passStreakThreshold.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakThreshold, 0);
+		m_passStreakThreshold.SetRenderTarget(0, pStreakSource);
+		m_passStreakThreshold.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A);
+		m_passStreakThreshold.SetTexture(0, m_graphicsPipelineResources.m_pTexHDRTargetScaled[0][0]);
+		m_passStreakThreshold.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passStreakThreshold.BeginConstantUpdate();
+	m_passStreakThreshold.SetConstant(streakParams1Name, Vec4(streakParams.fThreshold, max(streakParams.fThreshold * 0.25f, 0.01f), 0, 0), eHWSC_Pixel);
+	m_passStreakThreshold.Execute();
+
+	// Directional stretch. The rays are evenly spread over the full circle and rotate with
+	// the blade phase; each one is grown by a chain of exponentially widening blurs.
+	const float fTexelScaleX = 1.0f / (float)pStreakSource->GetWidth();
+	const float fTexelScaleY = 1.0f / (float)pStreakSource->GetHeight();
+	// Perceived spike length is governed by how slowly the tail decays, not just by the
+	// sampling reach: short stubby spikes at length 0 (decay 0.55 per tap) grow into long
+	// persistent tails at length 1 (decay 0.95), while the stride widens the footprint.
+	const float fBaseStride = 0.5f + 2.0f * streakParams.fLength;
+	const float fLengthDecay = 0.55f + 0.40f * clamp_tpl(streakParams.fLength, 0.0f, 1.0f);
+
+	// The tone mapper blends the bloom target in with weight bloomAmount * 0.3 / 8 (about
+	// 0.004 at the default TOD bloom of 0.1). Anything added to the bloom target inherits
+	// that crush, so divide it back out - the streaks then keep the same on-screen energy
+	// regardless of the scene's bloom setting.
+	Vec4 vHDRSetupParams[5];
+	gEnv->p3DEngine->GetHDRSetupParams(vHDRSetupParams);
+	const float fBloomCompositeWeight = clamp_tpl(vHDRSetupParams[1].x / 8.0f, 0.0005f, 1.0f);
+	const float fOutputScale = streakParams.fAmount / ((float)nLineCount * fBloomCompositeWeight);
+
+	for (int direction = 0; direction < nLineCount; ++direction)
+	{
+		const float fAngle = streakParams.fAngle + (float)direction * (PI / (float)nLineCount);
+		const float fDirX = cosf(fAngle);
+		const float fDirY = sinf(fAngle);
+
+		float fStride = fBaseStride;
+		float fDecay = fLengthDecay;
+
+		for (int iteration = 0; iteration < kStreakIterations; ++iteration)
+		{
+			const bool bLastIteration = (iteration == kStreakIterations - 1);
+			CFullscreenPass& pass = m_passStreakStretch[direction][iteration];
+
+			if (pass.IsDirty())
+			{
+				const uint64 nBlendState = bLastIteration ? (GS_BLSRC_ONE | GS_BLDST_ONE) : 0;
+
+				pass.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+				pass.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+				pass.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakStretch, 0);
+				pass.SetRenderTarget(0, bLastIteration ? m_graphicsPipelineResources.m_pTexHDRFinalBloom : pStreakPingPong);
+				pass.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A | nBlendState);
+				pass.SetTexture(0, (iteration == 0) ? pStreakSource : pStreakPingPong);
+				pass.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+			}
+
+			pass.BeginConstantUpdate();
+			pass.SetConstant(streakParams0Name, Vec4(fDirX * fTexelScaleX, fDirY * fTexelScaleY, fStride, bLastIteration ? fOutputScale : 1.0f), eHWSC_Pixel);
+			pass.SetConstant(streakParams1Name, Vec4(0, 0, fDecay, 0), eHWSC_Pixel);
+			pass.Execute();
+
+			fStride *= (float)s_nStreakTapCount;
+			fDecay = powf(fDecay, (float)s_nStreakTapCount);
+		}
+	}
 }
