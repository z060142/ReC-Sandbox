@@ -12,9 +12,11 @@ float NGon_Rad(float theta, float n)
 // Shirley's concentric mapping
 Vec4 CDepthOfFieldStage::ToUnitDisk(Vec4& origin, float blades, float fstop)
 {
-	//float max_fstops = 8;
