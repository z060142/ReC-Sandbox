+//! Aperture diffraction streaks (sunstars). Light diffracting off the straight edges of the
+//! iris blades throws a set of evenly spaced rays out of every very bright source: an even
+//! blade count gives one ray per blade, an odd count gives two.
+struct SHDRStreaksParams
+{
+	SHDRStreaksParams()
+		: bActive(false), nDirectionCount(8), fAngle(0.0f), fAmount(0.0f), fThreshold(4.0f), fLength(0.5f)
+	{
+	};
+
+	bool  bActive;
+	int   nDirectionCount;  //!< Ray count, already clamped to the shader budget by the caller.
+	float fAngle;           //!< Rotation of the whole set in radians, i.e. the blade phase.
+	float fAmount;          //!< 0-1 intensity, driven by how far the lens is stopped down.
+	float fThreshold;       //!< Scene HDR value a source has to exceed before it grows rays.
+	float fLength;          //!< 0-1, scales the stretch stride and therefore the ray length.
+};
+
+//! Parameter container only - the passes live in CBloomStage, which reads these the same way
+//! CDepthOfFieldStage reads SDepthOfFieldParams.
+class CHDRStreaks : public CPostEffect
+{
+public:
+	CHDRStreaks()
+	{
+		m_nRenderFlags = 0;
+		m_nID = EPostEffectID::HDRStreaks;
+
+		AddParamBool("HDR_Streaks_Active", m_pActive, 0);
+		AddParamFloatNoTransition("HDR_Streaks_Amount", m_pAmount, 0.0f);
+		AddParamFloatNoTransition("HDR_Streaks_Count", m_pCount, 8.0f);
+		AddParamFloatNoTransition("HDR_Streaks_Angle", m_pAngle, 0.0f);
+		AddParamFloatNoTransition("HDR_Streaks_Threshold", m_pThreshold, 4.0f);
+		AddParamFloatNoTransition("HDR_Streaks_Length", m_pLength, 0.5f);
+	}
+
+	//! Never preprocessed or executed: the effect exists purely to own the parameters.
+	virtual bool Preprocess(const SRenderViewInfo& viewInfo) override
+	{
+		return false;
+	}
+
+	virtual void Execute() override
+	{
+	}
+
+	virtual void        Reset(bool bOnSpecChange = false) override;
+
+	SHDRStreaksParams   GetParams() const;
+
+	virtual const char* GetName() const override
+	{
+		return "HDRStreaks";
+	}
+
+	//! Performance ceiling. A 16 blade iris would ask for 16 rays and an odd blade count for
+	//! twice its blade count; both are clamped down to this, which is not a bug.
+	static const int s_nMaxDirections = 24; //!< Spike count cap (each renderer pass draws two opposed spikes).
+
+private:
+	CEffectParam* m_pAmount, * m_pCount, * m_pAngle, * m_pThreshold, * m_pLength;
+};
