@@ -152,6 +152,67 @@ float3 HDRBloomGaussianPS(vtxOut IN) : SV_Target
 ////////////////////////////////////////////////////////////////////////////////////////////////////
 ////////////////////////////////////////////////////////////////////////////////////////////////////
 
+// Aperture diffraction streaks (sunstars). Light bending around the straight edges of the
+// iris blades throws a set of evenly spaced rays out of every very bright source. The
+// renderer reproduces them at bloom resolution: one high threshold pass isolates the
+// sources, then each ray direction is grown by a chain of exponentially widening
+// directional blurs and added back into the bloom target.
+
+float4 StreakParams0;   // (dirX / targetWidth, dirY / targetHeight, tapStride in pixels, output scale)
+float4 StreakParams1;   // (threshold, soft knee, per tap decay, unused)
+
+Texture2D<float4> HDRStreak_Src        : register(t0);
+SamplerState HDRStreak_LClampSampler   : register(s0); // LinearClamp
+
+float3 HDRStreakThresholdPS(vtxOut IN) : SV_Target
+{
+	float3 cColor = GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy, 0.0f).rgb;
+
+	// Soft knee high pass expressed in scene HDR units. The threshold sits far above the
+	// white point on purpose: a merely bright sky must not grow rays, only sources that
+	// genuinely overload the aperture do.
+	const float fThreshold = StreakParams1.x;
+	const float fKnee = max(StreakParams1.y, 0.0001f);
+	const float fLum = max(max(cColor.r, cColor.g), cColor.b);
+	const float fSoft = clamp(fLum - fThreshold + fKnee, 0.0f, 2.0f * fKnee);
+	const float fContribution = max(fSoft * fSoft / (4.0f * fKnee), fLum - fThreshold);
+
+	// Rescale instead of subtracting so the source keeps its own hue and never washes to white.
+	return cColor * (fContribution / max(fLum, 0.0001f));
+}
+
+float3 HDRStreakStretchPS(vtxOut IN) : SV_Target
+{
+	const float2 vStep = StreakParams0.xy * StreakParams0.z;
+	const float fDecay = StreakParams1.z;
+
+	// Symmetric march: one pass paints a full line through each source (two opposed rays),
+	// so an N-spike star needs only N/2 passes and the spikes are guaranteed collinear.
+	float2 tcPos = IN.baseTC.xy;
+	float2 tcNeg = IN.baseTC.xy;
+	float3 cSum = GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, tcPos, 0.0f).rgb;
+	float fWeight = 1.0f;
+	float fWeightSum = 1.0f;
+
+	// Fixed mip, so the growing stride cannot pull the sampler into a different level.
+	[unroll]
+	for (int i = 0; i < 7; ++i)
+	{
+		fWeight *= fDecay;
+		tcPos += vStep;
+		tcNeg -= vStep;
+		cSum += (GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, tcPos, 0.0f).rgb
+		       + GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, tcNeg, 0.0f).rgb) * fWeight;
+		fWeightSum += 2.0f * fWeight;
+	}
+
+	// Normalised weights keep the total energy independent of the iteration count.
+	return cSum * (StreakParams0.w / max(fWeightSum, 0.0001f));
+}
+
