+	//! Ray count ceiling for the diffraction streaks, mirrored by CHDRStreaks::s_nMaxDirections.
+	static const int kMaxStreakDirections = 12; //!< Line passes; each paints two opposed spikes (24 max).
+	//! Stretch iterations per ray. Each one widens the tap stride by the tap count, so two
+	//! iterations of 8 taps already reach 63 tap distances from the source.
