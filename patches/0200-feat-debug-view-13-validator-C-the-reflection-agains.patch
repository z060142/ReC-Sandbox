diff --git a/Code/CryEngine/Cry3DEngine/SVO/SceneTreeCVars.inl b/Code/CryEngine/Cry3DEngine/SVO/SceneTreeCVars.inl
index 9af72f09..320925c5 100644
--- a/Code/CryEngine/Cry3DEngine/SVO/SceneTreeCVars.inl
+++ b/Code/CryEngine/Cry3DEngine/SVO/SceneTreeCVars.inl
@@ -256,7 +256,7 @@ REGISTER_CVAR_AUTO(float, e_svoTI_RT_SafetyBorder, 0.25f, VF_EXPERIMENTAL, "DEPR
 
 // Static BVH mesh ray tracing (decisions 02-05)
 REGISTER_CVAR_AUTO(int, e_svoTI_RT_StaticBVH, 1, VF_EXPERIMENTAL, "Build and trace one static BVH per SVO cell\n0 = voxel cone tracing only");
-REGISTER_CVAR_AUTO(int, e_svoTI_RT_Debug, 0, VF_EXPERIMENTAL, "Mesh ray tracing debug views\n0 = off\n1 = hit test count heat map (blue = few, red = many)\n2 = hit normals\n3 = hit albedo\n4 = hit distance\n5 = incomplete/overflow mask (magenta = the traversal stack ran out)\n6 = stage-1 provisional colour (no light data)\n7 = sun shadow at the hit (white = lit)\n8 = direct light at the hit, before probes\n9 = raw shade output, before fog and exposure\n10 = raw atlas normal at the hit, tangent space (magenta = no normal slot, flat lilac = no normal map)\n11 = hit smoothness (black = rough, white = mirror; modulated by the material gloss map, no longer flat per material)\n12 = hit reflectance F0, x8 (black = the material record really carries no reflectance)");
+REGISTER_CVAR_AUTO(int, e_svoTI_RT_Debug, 0, VF_EXPERIMENTAL, "Mesh ray tracing debug views\n0 = off\n1 = hit test count heat map (blue = few, red = many)\n2 = hit normals\n3 = hit albedo\n4 = hit distance\n5 = incomplete/overflow mask (magenta = the traversal stack ran out)\n6 = stage-1 provisional colour (no light data)\n7 = sun shadow at the hit (white = lit)\n8 = direct light at the hit, before probes\n9 = raw shade output, before fog and exposure\n10 = raw atlas normal at the hit, tangent space (magenta = no normal slot, flat lilac = no normal map)\n11 = hit smoothness (black = rough, white = mirror; modulated by the material gloss map, no longer flat per material)\n12 = hit reflectance F0, x8 (black = the material record really carries no reflectance)\n13 = validator C: for a hit that is also on screen, |reflected - direct| in STOPS (black = they agree, red = the reflection is that many stops too bright, green = too dark, blue = the hit is off screen or occluded so the test says nothing). Reads the PREVIOUS frame's pre-exposed HDR target, so judge it on a still camera");
 REGISTER_CVAR_AUTO(float, e_svoTI_RT_NormalsFading, 0, VF_EXPERIMENTAL, "Fade ray traced reflections into flat normals, in metres; 0 = off (normal maps at any distance)\nApplies to both the reflecting surface (a normal mapped mirror otherwise prints its detail map into the reflection) and to the hit's own normal map");
 REGISTER_CVAR_AUTO(int, e_svoTI_RT_TriPoolXY, 256, VF_EXPERIMENTAL, "XY size of the BVH node/triangle record pool texture (power of two, multiple of 4)");
 REGISTER_CVAR_AUTO(int, e_svoTI_RT_TriPoolZ, 64, VF_EXPERIMENTAL, "Z size of the BVH node/triangle record pool texture");
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/D3D_SVO.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/D3D_SVO.cpp
index ea694b2f..0c06c92d 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/D3D_SVO.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/D3D_SVO.cpp
@@ -951,6 +951,24 @@ void CSvoRenderer::ShadePass(SSvoTargetsSet* pTS)
 	SetupShadeForwardResources(rp);
 	SetupShadeSkyTextures(rp);
 
+	// rt stage 4A, debug view 13 = validator C (energy audit section 5). The only two resources
+	// the pass needs beyond hit shading, and they are bound ONLY for that view: the depth buffer
+	// to prove the camera really sees the hit, and the PREVIOUS frame's HDR target to read the
+	// direct shading of it. $HDRTargetPrev is pre-exposed, and feeding a pre-exposed buffer back
+	// into SVO maths is exactly what e_svoTI_SSDepthTrace is forced to 0 for on the scene-referred
+	// path - so it stays inside the debug branch, one frame stale, and never reaches a pixel that
+	// is drawn for real. t4 and t12 are free on this technique; TiledShading.cfi's CausticsRT at
+	// t12 lives inside TILED_DEFERRED_SHADING_TECHNIQUE, which this shader never compiles.
+	const bool bValidatorC = (e_svoTI_RT_Debug == 13);
+	if (bValidatorC)
+	{
+		const CGraphicsPipelineResources& pipelineResources = RenderView()->GetGraphicsPipeline()->GetPipelineResources();
+		rp.SetTexture(4, GetZBuffer(pipelineResources, true));
+
+		auto pTexHDRTargetPrev = pipelineResources.m_pTexHDRTargetPrev[RenderView()->GetCurrentEye()];
+		rp.SetTexture(12, (pTexHDRTargetPrev && pTexHDRTargetPrev->GetUpdateFrameID() > 1) ? pTexHDRTargetPrev : CRendererResources::s_ptexBlack);
+	}
+
 	rp.BeginConstantUpdate();
 
 	SetupRTLightGridConstants(rp);
@@ -974,6 +992,16 @@ void CSvoRenderer::ShadePass(SSvoTargetsSet* pTS)
 		rp.SetConstantArray(paramName, (Vec4*)&vData, 1);
 	}
 
+	if (bValidatorC)
+	{
+		// SVO_ViewProj lives in SetupCommonConstants, which ShadePass deliberately does not call
+		// (it needs none of the rest of it). Same matrix, same transpose, D3D_SVO.cpp:1039.
+		static CCryNameR paramName("SVO_ViewProj");
+		Matrix44A mViewProj = RenderView()->GetViewInfo(CCamera::eEye_Left).cameraProjMatrix;
+		mViewProj.Transpose();
+		rp.SetConstantArray(paramName, alias_cast<Vec4*>(&mViewProj), 4);
+	}
+
 	rp.Execute();
 
 	pTS->bShaded = true;
diff --git a/Engine/Shaders/HWScripts/CryFX/CommonSVO_RT.cfi b/Engine/Shaders/HWScripts/CryFX/CommonSVO_RT.cfi
index 2f5d9379..09a0f0a8 100644
--- a/Engine/Shaders/HWScripts/CryFX/CommonSVO_RT.cfi
+++ b/Engine/Shaders/HWScripts/CryFX/CommonSVO_RT.cfi
@@ -910,7 +910,9 @@ float3 RT_SampleVoxelIrradiance(const float3 tcMin, const float4 voxAreaMin, con
 // 1 hit test count, 2 hit normals, 3 hit albedo, 4 hit distance, 5 incomplete mask,
 // 6 stage-1 provisional colour (ConeTracePS), 7 sun shadow at the hit / 8 direct light before
 // probes / 9 raw ShadePass output (all three in ShadePS), 10 raw atlas normal, 11 hit
-// smoothness, 12 hit reflectance.
+// smoothness, 12 hit reflectance, 13 validator C - reflected minus direct in stops, for hits
+// that are also on screen (ShadePS; black = agreement, red = too bright, green = too dark,
+// blue = not testable).
 bool RT_GetDebugColor(out float3 vCol)
 {
 	vCol = 0;
diff --git a/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx b/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx
index b644ef87..8a63d61b 100644
--- a/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx
+++ b/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx
@@ -2148,6 +2148,55 @@ pixoutShade ShadePS(vtxOutWPOS IN)
 				// lerp, before the writer clamp and before the exposure divide.
 				bRawDebug = true;
 			}
+			else if (nDbg == 13)
+			{
+				// 13 = VALIDATOR C (energy audit section 5 / research 06 section 8, option C).
+				// The one test the picture cannot argue with: for a hit that also happens to be
+				// ON SCREEN, the reflected shading of that point and the DIRECT shading of the
+				// same point must agree. Project the hit back through SVO_ViewProj, check the
+				// depth buffer says the camera really sees that surface and not something in
+				// front of it, and compare luminances in STOPS.
+				//   black = agreement          red   = the reflection is N stops too BRIGHT
+				//   blue  = not testable       green = the reflection is N stops too DARK
+				//
+				// Both sides are read in EXPOSED units and no exposure is applied to either:
+				// `acc` here is pre-divide, i.e. already exposed, and $HDRTargetPrev is the
+				// pre-exposed HDR target, so the ratio is exposure-free by construction.
+				//
+				// Two caveats, both real, both the reason this lives ONLY in a debug branch:
+				// $HDRTargetPrev is the PREVIOUS frame (the camera has moved, so judge it on a
+				// still frame), and reading a pre-exposed buffer back into SVO maths is exactly
+				// what e_svoTI_SSDepthTrace is forced off for on the scene-referred path. This
+				// value must never reach a non-debug path.
+				const float3 vHitAbs = vGPO.xyz + GetWorldViewPos();
+				float4 vProjTC = mul(SVO_ViewProj, float4(vHitAbs, 1));
+				const bool bInFront = (vProjTC.w > 0);
+				vProjTC /= vProjTC.w;
+				vProjTC.xy = vProjTC.xy * 0.5f + 0.5f;
+				vProjTC.y = 1.f - vProjTC.y;
+
+				bool bTestable = bInFront && !bNoHit && all(vProjTC.xy == saturate(vProjTC.xy));
+
+				if (bTestable)
+				{
+					const float fScrDepth = SampleLinearDepth(sceneDepth, vProjTC.xy) * PS_NearFarClipDist.y;
+					const float fHitDepth = GetLinearDepth(g_PS_ProjRatio.y / (vProjTC.z - g_PS_ProjRatio.x)) * PS_NearFarClipDist.y;
+					bTestable = abs(fScrDepth - fHitDepth) < max(0.05f, fHitDepth * 0.02f);
+				}
+
+				if (!bTestable)
+				{
+					acc = float3(0, 0, 0.25f);
+				}
+				else
+				{
+					const float3 vDirect = sceneTargetPrev.SampleLevel(ssSvoPointClamp, vProjTC.xy, 0).rgb;
+					const float fStops = log2(max(GetLuminance(acc), 1e-6f) / max(GetLuminance(vDirect), 1e-6f));
+					acc = (fStops > 0.f) ? float3(saturate(fStops), 0, 0) : float3(0, saturate(-fStops), 0);
+				}
+
+				bRawDebug = true;
+			}
 		}
 #endif
 
