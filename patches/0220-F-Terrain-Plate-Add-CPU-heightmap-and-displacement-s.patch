+
+//! A height field sampled on the CPU, normalised to [0,1].
+//! Row major, row 0 is the +Y edge of the plate, column 0 is the -X edge. This is the orientation the
+//! Sandbox heightmap importer ends up with: CHeightmap::LoadRAW rotates the file by 270 degrees and
+//! CHeightmap::UpdateEngineTerrain then swaps X and Y again, so a file column ends up on world +X and
+//! file row 0 ends up at world +Y max (see scene-notes/terrain/research/03-terrain-plate.md section 1.1).
+struct STerrainPlateHeightField
+{
+	int                m_width = 0;
+	int                m_height = 0;
+	std::vector<float> m_values;
+
+	bool IsValid() const { return m_width > 1 && m_height > 1 && (int)m_values.size() == m_width * m_height; }
+	void Clear()         { m_width = 0; m_height = 0; m_values.clear(); }
+
+	//! Nearest sample, clamped to the border.
+	float At(int x, int y) const
+	{
+		x = clamp_tpl(x, 0, m_width - 1);
+		y = clamp_tpl(y, 0, m_height - 1);
+		return m_values[(size_t)y * m_width + x];
+	}
+
+	//! u/v in [0,1]; v = 0 is row 0, i.e. the +Y edge of the plate.
+	float SampleBilinear(float u, float v) const;
+};
+
+//! CPU loaders for the two plate sources. Everything goes through ICryPak, never through CImageEx:
+//! CImageEx is 8 bit per channel and editor only (research 03 section 1.2).
+namespace TerrainPlateLoader
+{
+//! Dispatches on the extension: .r16/.raw (headerless 16 bit LE, square), .pgm (binary P5, 8 or 16 bit),
+//! .bmp (uncompressed 8/24/32 bit, luminance).
+bool LoadHeightmapFile(const char* szPath, STerrainPlateHeightField& out);
+
+//! Uncompressed DDS only (R8, R16, R16F, R32F, RGBA8/BGRA8 luminance). Anything else fails and the
+//! caller warns and falls back to a flat plate. No GPU readback.
+bool LoadDisplacementTexture(const char* szPath, STerrainPlateHeightField& out);
+}
