From 408731392d3a5966b956c4e8692f1bcd82925dd0 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 9 Sep 2026 22:07:03 +0800
Subject: [PATCH 142/174] tune: cloud edge fade 4 km -> 12 km with smoothstep

The 4 km linear fade still read as a band at 18:00 through the Default camera; 12 km with a
smoothstep dissolves the cloud region into the plain sky with no visible seam at 17:30 or
18:00 (scene-notes/build-logs/sky_FADE12*.jpg).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HXzRVK4yBVDUNfdWXEwV5y
---
 Engine/Shaders/HWScripts/CryFX/Clouds.cfx | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Engine/Shaders/HWScripts/CryFX/Clouds.cfx b/Engine/Shaders/HWScripts/CryFX/Clouds.cfx
index df9e5b76..48dc525c 100644
--- a/Engine/Shaders/HWScripts/CryFX/Clouds.cfx
+++ b/Engine/Shaders/HWScripts/CryFX/Clouds.cfx
@@ -1631,8 +1631,8 @@ void RenderCloudMonolithicCS(uint3 GroupID : SV_GroupID,
 	// in front of a mountain is real). Unconditional: the clouds must look the same through every
 	// camera, so this is an engine behaviour change (like the e_VolumetricFog default).
 	{
-		const float fadeLength = 4000.0f;
-		const float edgeFade = (linearMaxDepth >= 0.999f && maxStepNum != 0.0f) ? saturate((distanceEnd - distanceStart) / fadeLength) : 1.0f;
+		const float fadeLength = 12000.0f;
+		const float edgeFade = (linearMaxDepth >= 0.999f && maxStepNum != 0.0f) ? smoothstep(0.0f, 1.0f, saturate((distanceEnd - distanceStart) / fadeLength)) : 1.0f;
 		inscatter.xyz *= edgeFade;
 		transmittance = lerp(1.0f, transmittance, edgeFade);
 		cloudColorMinDepth.xyz *= edgeFade;
@@ -2521,8 +2521,8 @@ void RenderCloudCS(uint3 GroupID : SV_GroupID,
 	// in front of a mountain is real). Unconditional: the clouds must look the same through every
 	// camera, so this is an engine behaviour change (like the e_VolumetricFog default).
 	{
-		const float fadeLength = 4000.0f;
-		const float edgeFade = (linearMaxDepth >= 0.999f && maxStepNum != 0.0f) ? saturate((distanceEnd - distanceStart) / fadeLength) : 1.0f;
+		const float fadeLength = 12000.0f;
+		const float edgeFade = (linearMaxDepth >= 0.999f && maxStepNum != 0.0f) ? smoothstep(0.0f, 1.0f, saturate((distanceEnd - distanceStart) / fadeLength)) : 1.0f;
 		inscatter.xyz *= edgeFade;
 		transmittance = lerp(1.0f, transmittance, edgeFade);
 		cloudColorMinDepth.xyz *= edgeFade;
-- 
