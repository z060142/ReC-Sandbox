+	const float fRowSpan = max(m_maskRowCDF[y] - fPrevRow, 1e-9f);
+	const float fy = ((float)y + clamp_tpl((v - fPrevRow) / fRowSpan, 0.0f, 1.0f)) / (float)h;
+
+	const float* pCol = &m_maskColCDF[(size_t)y * w];
+	int x = (int)(std::lower_bound(pCol, pCol + w, u) - pCol);
+	x = min(x, w - 1);
+	const float fPrevCol = (x > 0) ? pCol[x - 1] : 0.0f;
+	const float fColSpan = max(pCol[x] - fPrevCol, 1e-9f);
+	const float fx = ((float)x + clamp_tpl((u - fPrevCol) / fColSpan, 0.0f, 1.0f)) / (float)w;
