+Vec4 CDepthOfFieldStage::SampleMaskKernelTap(float u, float v) const
+{
+	// Standard 2D CDF inversion: the marginal row CDF with v, that row's conditional column
+	// CDF with u, linear interpolation inside the winning bin.
+	const int w = m_maskCDFWidth;
+	const int h = m_maskCDFHeight;
