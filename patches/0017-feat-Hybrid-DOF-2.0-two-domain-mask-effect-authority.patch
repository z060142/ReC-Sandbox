+// Mask-domain gather kernel. When the mask is the smaller aperture, the gather taps are
+// importance-sampled from the mask texture itself, so the gather's energy distribution - the
+// soft halo under each sharp splat - takes the mask's silhouette instead of staying a disc.
+// The texture is re-read from disk through CryPak (the GPU resource keeps no CPU copy); only
+// uncompressed 32-bit single-surface power-of-two DDS masks qualify - all six engine-shipped
+// bokeh masks do - and anything else keeps the polygon kernel and says so once. Taps cluster
+// in the mask's open regions, which IS the physical energy concentration of a low
+// transmittance mask; no extra normalization wanted.
+bool CDepthOfFieldStage::EnsureMaskKernelCDF(const char* szTexName)
+{
+	if (m_maskCDFTexName == szTexName)
+		return m_maskCDFValid;
+
+	m_maskCDFTexName = szTexName;
+	m_maskCDFValid = false;
+
+	const char* szFail = nullptr;
+	std::vector<uint8> data;
+	{
+		FILE* pFile = gEnv->pCryPak->FOpen(szTexName, "rb");
+		if (!pFile)
+			szFail = "file not found";
+		else
+		{
+			gEnv->pCryPak->FSeek(pFile, 0, SEEK_END);
+			const size_t nSize = (size_t)gEnv->pCryPak->FTell(pFile);
+			gEnv->pCryPak->FSeek(pFile, 0, SEEK_SET);
+			data.resize(nSize);
+			if (nSize < 128 + 16 || gEnv->pCryPak->FReadRaw(data.data(), 1, nSize, pFile) != nSize)
+				szFail = "read failed";
+			gEnv->pCryPak->FClose(pFile);
+		}
+	}
+
+	int w = 0, h = 0;
+	if (!szFail)
+	{
+		if (memcmp(data.data(), "DDS ", 4) != 0)
+			szFail = "not a DDS";
+		else
+		{
+			const uint32* pHdr = (const uint32*)(data.data() + 4);
+			h = (int)pHdr[2];
+			w = (int)pHdr[3];
+			const uint32 nPFFlags = pHdr[19];  // pixel format flags
+			const uint32 nFourCC = pHdr[20];
+			const uint32 nRGBBits = pHdr[21];
+			if ((nPFFlags & 0x40) == 0 || nFourCC != 0 || nRGBBits != 32)
+				szFail = "not uncompressed 32-bit";
+			else if (w < 4 || h < 4 || w > 512 || h > 512 || (w & (w - 1)) != 0 || (h & (h - 1)) != 0)
+				szFail = "unsupported dimensions";
+			else if (data.size() < 128 + (size_t)w * h * 4)
+				szFail = "truncated pixel data";
+		}
+	}
+
+	if (szFail)
+	{
+		CryLog("[DOF] gather kernel: '%s' not usable for importance sampling (%s), keeping the polygon kernel", szTexName, szFail);
+		return false;
+	}
+
+	// R channel (file byte order is B,G,R,A) -> marginal CDF over rows + conditional per row.
+	// A half-count floor keeps fully blocked regions measurable so both CDFs stay invertible.
+	const uint8* pPix = data.data() + 128;
+	m_maskCDFWidth = w;
+	m_maskCDFHeight = h;
+	m_maskRowCDF.resize(h);
+	m_maskColCDF.resize((size_t)h * w);
+	float fTotal = 0.0f;
+	for (int y = 0; y < h; y++)
+	{
+		float fRow = 0.0f;
+		for (int x = 0; x < w; x++)
+		{
+			fRow += (float)pPix[((size_t)y * w + x) * 4 + 2] + 0.5f;
+			m_maskColCDF[(size_t)y * w + x] = fRow;
+		}
+		const float fInvRow = 1.0f / fRow;
+		for (int x = 0; x < w; x++)
+			m_maskColCDF[(size_t)y * w + x] *= fInvRow;
+		fTotal += fRow;
+		m_maskRowCDF[y] = fTotal;
+	}
+	const float fInvTotal = 1.0f / fTotal;
+	for (int y = 0; y < h; y++)
+		m_maskRowCDF[y] *= fInvTotal;
+
+	m_maskCDFValid = true;
+	CryLog("[DOF] gather kernel: importance-sampled from '%s' (%dx%d, mean=%.2f)",
+	       szTexName, w, h, fTotal / ((float)w * (float)h * 255.0f));
+	return true;
+}
+
+// Van der Corput radical inverse in base 2; paired with (i + 0.5) / N it forms the
+// Hammersley set. The mask kernel needs a low-discrepancy pattern instead of the
+// stratified grid: a regular grid collapses under CDF inversion - only nSide distinct
+// v values means only nSide distinct mask ROWS ever get sampled, which turns thin
