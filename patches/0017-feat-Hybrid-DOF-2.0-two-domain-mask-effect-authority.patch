+// The splat layers live at full resolution and are only needed by the hybrid path, so they are
+// created on first use and dropped whenever the render resolution changes.
+bool CDepthOfFieldStage::AcquireSplatLayers(int width, int height)
+{
+	if (width <= 0 || height <= 0)
+		return false;
+
+	if (m_pTexSplatLayerNear && m_pTexSplatLayerFar &&
+	    m_splatLayerWidth == width && m_splatLayerHeight == height)
+		return true;
+
+	ReleaseSplatLayers();
+
+	const uint32 flags = FT_NOMIPS | FT_DONT_STREAM | FT_USAGE_RENDERTARGET;
+	const std::string nameNear = "$DofSplatLayerNear" + m_graphicsPipeline.GetUniqueIdentifierName();
+	const std::string nameFar  = "$DofSplatLayerFar"  + m_graphicsPipeline.GetUniqueIdentifierName();
+
+	m_pTexSplatLayerNear = CTexture::GetOrCreateRenderTarget(nameNear.c_str(), width, height, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+	m_pTexSplatLayerFar  = CTexture::GetOrCreateRenderTarget(nameFar.c_str(),  width, height, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+
+	if (!CTexture::IsTextureExist(m_pTexSplatLayerNear) || !CTexture::IsTextureExist(m_pTexSplatLayerFar))
+	{
+		ReleaseSplatLayers();
+		return false;
+	}
+
+	m_splatLayerWidth = width;
+	m_splatLayerHeight = height;
+	return true;
+}
+
+void CDepthOfFieldStage::ReleaseSplatLayers()
+{
+	m_pTexSplatLayerNear.reset();
+	m_pTexSplatLayerFar.reset();
+	m_splatLayerWidth = 0;
+	m_splatLayerHeight = 0;
+}
+
+void CDepthOfFieldStage::Resize(int renderWidth, int renderHeight)
+{
+	// Drop them; the next hybrid frame reallocates at the new size.
+	ReleaseSplatLayers();
+}
