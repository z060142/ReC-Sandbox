-// Shirley's concentric mapping
-Vec4 CDepthOfFieldStage::ToUnitDisk(Vec4& origin, float blades, float fstop, float rotation)
+// The sharpening exponent raised over the iris polygon's radius function: 0 = perfect circle,
+// ~1 = the physical polygon, 2+ = deliberately sharpened corners, 4 = caricature. THE single
+// place this is decided - the gather kernel and the splat mask are two views of one iris and
+// must never derive it separately.
+//
+// Two things drive it. Stopping down reveals the polygon (round at f/1.2, complete by f/2.8,
+// deliberately overlapping the apertures that produce LARGE discs or the shape would never be
+// readable). And blade curvature: only a CURVED blade can retract into a circle. Straight
+// blades keep the fully formed polygon at EVERY aperture and cut visibly sharper corners, so
+// low curvature both floors the formation window and pushes the exponent toward caricature.
+// The knob has to read at a glance - tuned to the picture, not to arithmetic timidity.
+static float ComputeIrisShapeExponent(float fstop, float curvature)
 {
-	// Wide open irises are round (blades retracted); stopping down reveals the polygon.
-	// The window must overlap with LARGE bokeh discs or the shape is never readable, so the
-	// polygon is fully formed one stop past wide open: round at f/1.2, complete by f/2.8.
 	const float minFstops = 1.2f;
 	const float maxFstops = 2.8f;
-	const float normalizedStops = clamp_tpl((fstop - minFstops) / (maxFstops - minFstops), 0.0f, 1.0f);
+	const float stopBlend = clamp_tpl((fstop - minFstops) / (maxFstops - minFstops), 0.0f, 1.0f);
+	const float straight = 1.0f - clamp_tpl(curvature, 0.0f, 1.0f);
+	// Straight blades are always fully formed; curved blades follow the f-stop window.
+	const float formed = straight + (1.0f - straight) * stopBlend;
+	const float strength = clamp_tpl(CRenderer::CV_r_DofBokehShapeStrength, 0.25f, 4.0f);
+	// Straight blades sharpen on top of forming: at curvature 0 the polygon runs at double
+	// strength (a caricature on purpose); at curvature 1 this reduces exactly to the legacy
+	// stopBlend * strength.
+	return formed * strength * (1.0f + straight);
+}
 
+// Shirley's concentric mapping
+Vec4 CDepthOfFieldStage::ToUnitDisk(Vec4& origin, float blades, float shapeExponent, float rotation)
+{
