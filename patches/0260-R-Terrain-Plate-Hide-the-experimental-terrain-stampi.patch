From 604fe15b07d3f414b57fd407a63863bcc5076ab6 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Tue, 1 Sep 2026 14:13:58 +0800
Subject: [PATCH 260/307] !R (Terrain Plate) Hide the experimental terrain
 stamping controls.

Keep stamping settings serialized while hiding their unfinished property rows.
The feature data remains compatible with saved levels and can be exposed again
without changing its archive names.
---
 .../Geometry/TerrainPlateComponent.cpp        |  6 +++
 .../Geometry/TerrainPlateComponent.h          | 50 ++++++++++++-------
 2 files changed, 38 insertions(+), 18 deletions(-)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index c6c5f918..511aa70c 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -985,6 +985,12 @@ void CTerrainPlateComponent::Initialize()
 	// turns this into ENTITY_SLOT_STATIC_GEOMETRY on the slot.
 	m_bForceStaticGeometry = true;
 
+	// Commit Bake UI parked per user 2026-09-01 (scene-notes/terrain/reports/31-commit-ui-parked.md): the two
+	// buttons are no longer reflected onto the property panel (their AddMember calls in ReflectType are commented
+	// out), so nothing can press them at the moment. The wiring below is deliberately left live and compiled, so
+	// un-parking is a header-only change. The same two editor commands stay reachable from the Terrain menu and
+	// from the console, which is how they are meant to be run while the panel is parked.
+	//
 	// The two commit buttons. They only mean anything in the editor - the terrain API they end up in is
 	// exported from Sandbox.exe (research 12 section 6.0) - and they reach it the only way an engine
 	// plugin can: by asking the editor to run its own command (CryLinkUtils.h:56 / sc_rpcShow is the
diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
index 32f01af4..1c009f6b 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
@@ -284,7 +284,16 @@ public:
 		               "Only matters when two baking plates overlap.",
 		               0);
 
-		desc.AddMember(&CTerrainPlateComponent::m_bBakeCommitted, 'bcmt', "BakeCommitted", "Committed",
+		// --- Commit Bake UI parked per user 2026-09-01 (see scene-notes/terrain/reports/31-commit-ui-parked.md):
+		// the user asked for the stamping UI to be commented out because one component's panel is far too cluttered,
+		// and wants to decide later how it should be presented. The whole Commit Bake block below is
+		// hidden from the property panel, NOT removed. AddMember is the one call that does both the panel row and
+		// the level persistence, so the values that have to survive a save/reload keep their AddMember and lose only
+		// their label: PropertyRow.cpp:491 makes a row with an empty label invisible, while the archive still reads
+		// and writes it under its szName. The original labels sit in the /*...*/ next to each "" - restore them (and
+		// uncomment the two buttons) to un-park. Nothing below this changes behaviour: the terrain.commit_plate /
+		// terrain.commit_plate_colour editor commands reach the component through ITerrainPlateCommit, not the panel.
+		desc.AddMember(&CTerrainPlateComponent::m_bBakeCommitted, 'bcmt', "BakeCommitted", /*"Committed"*/ "",
 		               "Read only, set by Commit Height To Terrain (the terrain.commit_plate editor command): the relief has been written "
 		               "into the level's own heightmap and is now ordinary terrain. While this is on the plate never writes the live "
 		               "bake again and deleting it leaves the committed ground alone, so the plate can be removed whenever you like. "
@@ -298,34 +307,39 @@ public:
 		// run alone, in either order. Both buttons fire an editor command through the console, because the
 		// editor's terrain API is exported from Sandbox.exe and no engine plugin can ever link it
 		// (research 12 section 6.0); the entity whose panel is open IS the selection the command walks.
-		desc.AddMember(&CTerrainPlateComponent::m_commitHeightButton, 'cbth', "CommitHeight", "Commit Height To Terrain",
-		               "Writes the relief this plate currently holds in the live terrain into the level's own heightmap, so it "
-		               "becomes ordinary terrain and stays after the plate is deleted. Needs a live bake (tick Bake Into Terrain "
-		               "first). Refused when the ground would not fit the level's Max Height. Same as the terrain.commit_plate "
-		               "editor command.",
-		               Serialization::FunctorActionButton<std::function<void()>>());
-		desc.AddMember(&CTerrainPlateComponent::m_commitColourButton, 'cbtc', "CommitColour", "Commit Colour To Terrain",
-		               "Stamps the plate's appearance - terrain colour and the Commit Layer's surface weights - into the level "
-		               "over the plate's footprint, fading into the existing terrain over the same rim band the height bake uses. "
-		               "Independent of the height commit: run it before, after or instead. Same as the terrain.commit_plate_colour "
-		               "editor command.",
-		               Serialization::FunctorActionButton<std::function<void()>>());
-
-		desc.AddMember(&CTerrainPlateComponent::m_commitLayer, 'clay', "CommitLayer", "Commit Layer",
+		// Commit Bake UI parked per user 2026-09-01 - the two panel buttons are commented out whole, because an
+		// action button carries no data and so has nothing to persist. The buttons are still wired up in
+		// CTerrainPlateComponent::Initialize (they just fire the two editor commands), so un-parking is only a
+		// matter of uncommenting these two AddMember calls. Menu / console route is unaffected.
+		//desc.AddMember(&CTerrainPlateComponent::m_commitHeightButton, 'cbth', "CommitHeight", "Commit Height To Terrain",
+		//               "Writes the relief this plate currently holds in the live terrain into the level's own heightmap, so it "
+		//               "becomes ordinary terrain and stays after the plate is deleted. Needs a live bake (tick Bake Into Terrain "
+		//               "first). Refused when the ground would not fit the level's Max Height. Same as the terrain.commit_plate "
+		//               "editor command.",
+		//               Serialization::FunctorActionButton<std::function<void()>>());
+		//desc.AddMember(&CTerrainPlateComponent::m_commitColourButton, 'cbtc', "CommitColour", "Commit Colour To Terrain",
+		//               "Stamps the plate's appearance - terrain colour and the Commit Layer's surface weights - into the level "
+		//               "over the plate's footprint, fading into the existing terrain over the same rim band the height bake uses. "
+		//               "Independent of the height commit: run it before, after or instead. Same as the terrain.commit_plate_colour "
+		//               "editor command.",
+		//               Serialization::FunctorActionButton<std::function<void()>>());
+
+		desc.AddMember(&CTerrainPlateComponent::m_commitLayer, 'clay', "CommitLayer", /*"Commit Layer"*/ "",
 		               "Name of the terrain layer that Commit Colour To Terrain blends the footprint towards, exactly as it is "
 		               "spelled in the Terrain Editor's layer list. The layer decides which detail material the committed ground "
 		               "wears. Empty: the surface weights are left alone and only the colour is stamped.", Schematyc::CSharedString());
-		desc.AddMember(&CTerrainPlateComponent::m_bCommitColour, 'cclr', "CommitColourEnabled", "Commit Colour",
+		desc.AddMember(&CTerrainPlateComponent::m_bCommitColour, 'cclr', "CommitColourEnabled", /*"Commit Colour"*/ "",
 		               "Whether Commit Colour To Terrain writes the terrain colour at all. Off: only the Commit Layer weights are "
 		               "stamped, and the ground keeps whatever colour was painted there.", true);
-		desc.AddMember(&CTerrainPlateComponent::m_bCommitAlbedo, 'calb', "CommitAlbedo", "Commit Albedo",
+		desc.AddMember(&CTerrainPlateComponent::m_bCommitAlbedo, 'calb', "CommitAlbedo", /*"Commit Albedo"*/ "",
 		               "On: the stamped colour is sampled from this plate's own material, through the low resolution CPU copy the "
 		               "renderer keeps of the diffuse texture (at most 32 x 32, so it carries the plate's colour distribution and "
 		               "not its detail - the terrain macro texture is a low frequency base anyway). Off: the flat Commit Tint is "
 		               "stamped. Either way Commit Tint multiplies the result.", false);
-		desc.AddMember(&CTerrainPlateComponent::m_commitTint, 'ctnt', "CommitTint", "Commit Tint",
+		desc.AddMember(&CTerrainPlateComponent::m_commitTint, 'ctnt', "CommitTint", /*"Commit Tint"*/ "",
 		               "Colour stamped into the terrain by Commit Colour To Terrain, and the filter colour multiplied into the "
 		               "albedo when Commit Albedo is on. White with Commit Albedo off stamps white.", ColorF(0.5f, 0.45f, 0.38f));
+		// --- end of the parked Commit Bake block.
 
 		desc.AddMember(&CTerrainPlateComponent::m_renderParameters, 'rend', "Render", "Rendering Settings", "Settings for the rendered representation of the component", plateRenderDefaults);
 		desc.AddMember(&CTerrainPlateComponent::m_physics, 'phys', "Physics", "Physics Settings",
