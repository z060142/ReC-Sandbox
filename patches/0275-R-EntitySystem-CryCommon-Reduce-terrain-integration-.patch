From aa94ac384204551b911b9d66793655baf1636c48 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 2 Sep 2026 10:20:17 +0800
Subject: [PATCH 275/307] !R (EntitySystem, CryCommon) Reduce terrain
 integration comments.

---
 .../CryCommon/Cry3DEngine/I3DEngine.h         |  7 ++--
 .../CryCommon/Cry3DEngine/IRenderNode.h       | 24 +++++---------
 .../CryCommon/CryEntitySystem/IEntity.h       | 16 ++++-----
 .../CryEntitySystem/IEntityBasicTypes.h       |  4 +--
 Code/CryEngine/CryEntitySystem/EntitySlot.cpp | 33 +++++++------------
 Code/CryEngine/CryEntitySystem/EntitySlot.h   |  7 ++--
 .../CryEngine/CryEntitySystem/RenderProxy.cpp |  5 ++-
 7 files changed, 37 insertions(+), 59 deletions(-)

diff --git a/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h b/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h
index 57b53a0c..860520e3 100644
--- a/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h
+++ b/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h
@@ -818,10 +818,9 @@ struct ITerrain
 	//! x1, y1, nSizeX, nSizeY are in terrain units
 	//! pTerrainBlock points to a square 2D array with dimensions GetTerrainSize()
 	//! by default update only elevation.
-	//! pSurfaceData may be nullptr: every touched cell then keeps its existing surface type
-	//! ids, blend weights and hole flag, and only the heights change (nSurfOrgX/Y and
-	//! nSurfSizeX/Y are ignored). Use this for heights-only writes - there is no lossless
-	//! surface read-back, so a read-modify-write round trip would collapse blended weights.
+	//! pSurfaceData may be nullptr: only the heights change, every touched cell keeps its surface bits
+	//! (nSurfOrgX/Y and nSurfSizeX/Y are ignored). Use this for heights-only writes - there is no
+	//! lossless surface read-back, so a read-modify-write round trip would collapse blended weights.
 	virtual void SetTerrainElevation(int x1, int y1, int nSizeX, int nSizeY, float* pTerrainBlock, SSurfaceTypeItem* pSurfaceData, int nSurfOrgX, int nSurfOrgY, int nSurfSizeX, int nSurfSizeY, uint32* pResolMap, int nResolMapSizeX, int nResolMapSizeY) = 0;
 
 	//! Checks if it is possible to paint on the terrain with a given surface type ID.
diff --git a/Code/CryEngine/CryCommon/Cry3DEngine/IRenderNode.h b/Code/CryEngine/CryCommon/Cry3DEngine/IRenderNode.h
index 03a31e4c..83bfe93f 100644
--- a/Code/CryEngine/CryCommon/Cry3DEngine/IRenderNode.h
+++ b/Code/CryEngine/CryCommon/Cry3DEngine/IRenderNode.h
@@ -777,22 +777,19 @@ struct IVegetation : public IRenderNode
 	virtual float GetScale(void) const = 0;
 };
 
-//! Per instance parameters of the eGM_IntegrateIntoTerrain global illumination / usage mode.
-//! The default constructed value reproduces the stock behaviour bit for bit: no slope test, no
-//! transition band and the global e_TerrainIntegrateObjectsMaxHeight height band.
+//! Per instance parameters of the eGM_IntegrateIntoTerrain usage mode.
+//! Default constructed = stock behaviour: no slope test, no transition band, global height band.
 struct STerrainIntegrationParams
 {
-	//! Maximum angle between the triangle plane and the horizontal plane, in degrees, range [0, 90].
-	//! Triangles steeper than this keep the object's own material and are not copied into the terrain
-	//! sector mesh. 90 means "no slope test" and is the stock behaviour.
+	//! Max angle between triangle plane and horizontal, in degrees, [0, 90]. Steeper triangles keep the
+	//! object's own material. 90 = no slope test (stock).
 	float slopeLimitDeg = 90.0f;
 
-	//! Width of the fade out band directly below slopeLimitDeg, in degrees. Inside the band the
-	//! terrain layer weights of the copied triangle are ramped down to zero. 0 means "hard edge".
+	//! Width in degrees of the fade out band below slopeLimitDeg, over which the terrain layer weights
+	//! ramp down to zero. 0 = hard edge.
 	float slopeBlendDeg = 0.0f;
 
-	//! Per object override of e_TerrainIntegrateObjectsMaxHeight, in metres. A negative value means
-	//! "use the cvar", which is the stock behaviour.
+	//! Per object override of e_TerrainIntegrateObjectsMaxHeight, in metres. Negative = use the cvar.
 	float heightBand = -1.0f;
 
 	bool operator==(const STerrainIntegrationParams& other) const
@@ -819,11 +816,8 @@ struct IBrush : public IRenderNode
 	// Only implemented by few nodes.
 	virtual void SetSubObjectHideMask(hidemask subObjHideMask) {}
 
-	//////////////////////////////////////////////////////////////////////////
-	// ABI: new virtual methods MUST be appended here, at the very end of IBrush.
-	// Inserting one anywhere above shifts the vtable index of every method below it, which breaks
-	// every binary that was compiled against the previous header.
-	//////////////////////////////////////////////////////////////////////////
+	// ABI: new virtual methods MUST be appended at the very end of IBrush; inserting one above shifts
+	// every vtable index below it.
 
 	//! Per instance parameters of the eGM_IntegrateIntoTerrain mode, @see STerrainIntegrationParams.
 	virtual void                             SetTerrainIntegrationParams(const STerrainIntegrationParams& params) = 0;
diff --git a/Code/CryEngine/CryCommon/CryEntitySystem/IEntity.h b/Code/CryEngine/CryCommon/CryEntitySystem/IEntity.h
index afda22bc..fa72c4e3 100644
--- a/Code/CryEngine/CryCommon/CryEntitySystem/IEntity.h
+++ b/Code/CryEngine/CryCommon/CryEntitySystem/IEntity.h
@@ -1364,20 +1364,16 @@ public:
 		return GetWorldRotation().GetColumn2();
 	}
 
-	//////////////////////////////////////////////////////////////////////////
-	// ABI: new virtual methods MUST be appended here, at the very end of IEntity.
-	// Inserting one anywhere above shifts the vtable index of every method below it, which breaks
-	// every binary that was compiled against the previous header (stock game DLLs, editor plugins).
-	//////////////////////////////////////////////////////////////////////////
+	// ABI: new virtual methods MUST be appended at the very end of IEntity; inserting one above shifts
+	// every vtable index below it and breaks stock game DLLs and editor plugins.
 
-	//! Sets the per instance parameters of the eGM_IntegrateIntoTerrain mode for a slot.
-	//! The values are stored on the slot, not on the render node, because the render node is
-	//! recreated whenever the slot geometry changes. @see STerrainIntegrationParams.
+	//! Sets the per instance parameters of the eGM_IntegrateIntoTerrain mode for a slot. Stored on the
+	//! slot, not the render node, which is recreated whenever the slot geometry changes.
 	//! \param nSlot Index of the slot.
 	virtual void SetSlotTerrainIntegrationParams(int nSlot, const STerrainIntegrationParams& params) = 0;
 
-	//! Returns the per instance parameters of the eGM_IntegrateIntoTerrain mode of a slot,
-	//! or the default constructed (= stock behaviour) value if the slot is not valid.
+	//! Returns the per instance parameters of the eGM_IntegrateIntoTerrain mode of a slot, or the
+	//! default constructed value if the slot is not valid.
 	//! \param nSlot Index of the slot.
 	virtual const STerrainIntegrationParams& GetSlotTerrainIntegrationParams(int nSlot) const = 0;
 };
diff --git a/Code/CryEngine/CryCommon/CryEntitySystem/IEntityBasicTypes.h b/Code/CryEngine/CryCommon/CryEntitySystem/IEntityBasicTypes.h
index cf7d96c1..708eff4b 100644
--- a/Code/CryEngine/CryCommon/CryEntitySystem/IEntityBasicTypes.h
+++ b/Code/CryEngine/CryCommon/CryEntitySystem/IEntityBasicTypes.h
@@ -532,8 +532,8 @@ enum EEntitySlotFlags : uint16
 	ENTITY_SLOT_ALLOW_TERRAIN_LAYER_BLEND   = BIT16(12),
 	ENTITY_SLOT_ALLOW_DECAL_BLEND           = BIT16(13),
 	ENTITY_SLOT_CUSTOM_VIEWDIST_RATIO       = BIT16(14), //!< This slot will use a custom view dist ratio and ignores the view dist ratio set for the entity.
-	//! The slot's geometry never moves at runtime; treat it as static for rendering (stencil reserved bit
-	//! -> deferred decals, static object paths) even when the entity has no physical entity.
+	//! The slot's geometry never moves at runtime; treat it as static for rendering (stencil reserved
+	//! bit -> deferred decals) even when the entity has no physical entity.
 	ENTITY_SLOT_STATIC_GEOMETRY             = BIT16(15),
 };
 
diff --git a/Code/CryEngine/CryEntitySystem/EntitySlot.cpp b/Code/CryEngine/CryEntitySystem/EntitySlot.cpp
index 24b61ea5..316d0d3e 100644
--- a/Code/CryEngine/CryEntitySystem/EntitySlot.cpp
+++ b/Code/CryEngine/CryEntitySystem/EntitySlot.cpp
@@ -180,7 +180,7 @@ void CEntitySlot::UpdateRenderNode(bool bForceRecreateNode)
 			SetRenderNodeFlags(renderNodeFlags, ERF_ENABLE_ENTITY_RENDER_CALLBACK, 0 != (entityFlags & ENTITY_FLAG_SEND_RENDER_EVENT));
 			SetRenderNodeFlags(renderNodeFlags, ERF_CUSTOM_VIEW_DIST_RATIO, 0 != (entityFlags & ENTITY_FLAG_CUSTOM_VIEWDIST_RATIO));
 
-			// Resolve the GI mode first: it is the OR of the entity extended flags and the slot flags.
+			// The GI mode is the OR of the entity extended flags and the slot flags.
 			const bool bGiModeBit0 = (0 != (m_pEntity->m_flagsExtended & ENTITY_FLAG_EXTENDED_GI_MODE_BIT0)) || (0 != (GetFlags() & ENTITY_SLOT_GI_MODE_BIT0));
 			const bool bGiModeBit1 = (0 != (m_pEntity->m_flagsExtended & ENTITY_FLAG_EXTENDED_GI_MODE_BIT1)) || (0 != (GetFlags() & ENTITY_SLOT_GI_MODE_BIT1));
 			const bool bGiModeBit2 = (0 != (m_pEntity->m_flagsExtended & ENTITY_FLAG_EXTENDED_GI_MODE_BIT2)) || (0 != (GetFlags() & ENTITY_SLOT_GI_MODE_BIT2));
@@ -188,11 +188,9 @@ void CEntitySlot::UpdateRenderNode(bool bForceRecreateNode)
 			const IRenderNode::EGIMode giMode = (IRenderNode::EGIMode)((bGiModeBit0 ? 1 : 0) | (bGiModeBit1 ? 2 : 0) | (bGiModeBit2 ? 4 : 0));
 			const bool bIntegrateIntoTerrain = (giMode == IRenderNode::eGM_IntegrateIntoTerrain);
 
-			// The terrain layer overlay produced by the "integrate into terrain" path is stencil gated on
-			// BIT_STENCIL_ALLOW_TERRAINLAYERBLEND, which the object's own opaque draw only writes when it
-			// carries ERF_FOB_ALLOW_TERRAIN_LAYER_BLEND. Without the flag the integrated triangles are
-			// generated and then killed by the stencil test, i.e. the feature silently does nothing.
-			// Force the flag on whenever the resolved GI mode asks for terrain integration.
+			// The terrain layer overlay is stencil gated on BIT_STENCIL_ALLOW_TERRAINLAYERBLEND, which the
+			// object's own opaque draw only writes with ERF_FOB_ALLOW_TERRAIN_LAYER_BLEND set. Without it
+			// the integrated triangles are generated and then killed by the stencil test.
 			SetRenderNodeFlags(renderNodeFlags, ERF_FOB_ALLOW_TERRAIN_LAYER_BLEND, bIntegrateIntoTerrain || (0 != (GetFlags() & ENTITY_SLOT_ALLOW_TERRAIN_LAYER_BLEND)));
 			SetRenderNodeFlags(renderNodeFlags, ERF_FOB_ALLOW_DECAL_BLEND, 0 != (GetFlags() & ENTITY_SLOT_ALLOW_DECAL_BLEND));
 			SetRenderNodeFlags(renderNodeFlags, ERF_FOB_RENDER_AFTER_POSTPROCESSING, 0 != (GetFlags() & ENTITY_SLOT_RENDER_AFTER_POSTPROCESSING));
@@ -212,13 +210,10 @@ void CEntitySlot::UpdateRenderNode(bool bForceRecreateNode)
 				pe_type eType = pPhysEnt->GetType();
 				bPhysicsIsStatic = eType == PE_NONE || eType == PE_STATIC || eType == PE_AREA;
 			}
-			// An entity with no physical entity at all falls through as "not static" above. That is stock
-			// behaviour and has to stay: a script driven entity without physics must keep
-			// ERF_MOVES_EVERY_FRAME. ENTITY_SLOT_STATIC_GEOMETRY is the explicit opt out for geometry that
-			// is known never to move, so that CBrush::Render does not flag it FOB_DYNAMIC_OBJECT
-			// (Brush.cpp:152), which would suppress BIT_STENCIL_RESERVED (CompiledRenderObject.cpp:641) and
-			// with it every deferred decal on the object (DeferredDecals.cpp:275). The 3 frame
-			// m_lastMoveFrameId guard in CBrush::Render still covers an actual move (e.g. an editor drag).
+			// An entity with no physical entity falls through as "not static" above, which must stay: a
+			// script driven entity without physics needs ERF_MOVES_EVERY_FRAME. This flag is the explicit
+			// opt out, so CBrush::Render does not set FOB_DYNAMIC_OBJECT, which would suppress
+			// BIT_STENCIL_RESERVED and with it every deferred decal on the object.
 			bPhysicsIsStatic = bPhysicsIsStatic || (0 != (GetFlags() & ENTITY_SLOT_STATIC_GEOMETRY));
 
 			SetRenderNodeFlags(renderNodeFlags, ERF_MOVES_EVERY_FRAME, !bPhysicsIsStatic);
@@ -227,10 +222,8 @@ void CEntitySlot::UpdateRenderNode(bool bForceRecreateNode)
 
 		m_pRenderNode->SetRndFlags(renderNodeFlags);
 
-		// The terrain sector meshes contain a copy of the geometry of every eGM_IntegrateIntoTerrain
-		// node, and are only rebuilt on request. Any transition into or out of that mode therefore has to
-		// invalidate the sectors the node covers - on enable as well as on disable (the shipped code only
-		// did it on disable, and relied on the re-registration to catch the enable case).
+		// The terrain sector meshes hold a copy of every eGM_IntegrateIntoTerrain node and are rebuilt
+		// only on request, so both directions of the transition must invalidate the covered sectors.
 		if (bWasIntegratedIntoTerrain != (m_pRenderNode->GetGIMode() == IRenderNode::eGM_IntegrateIntoTerrain))
 		{
 			if (ITerrain* pTerrain = gEnv->p3DEngine ? gEnv->p3DEngine->GetITerrain() : nullptr)
@@ -240,8 +233,7 @@ void CEntitySlot::UpdateRenderNode(bool bForceRecreateNode)
 			}
 		}
 
-		// The render node is recreated whenever the slot geometry changes, so the per instance terrain
-		// integration parameters have to be pushed onto it again from their storage on the slot.
+		// The render node is recreated whenever the slot geometry changes, so push the parameters again.
 		ApplyTerrainIntegrationParams();
 
 		m_pRenderNode->SetRndFlags(ERF_HIDDEN, !bSlotShouldRender);
@@ -656,8 +648,7 @@ void CEntitySlot::ApplyTerrainIntegrationParams()
 
 	pBrush->SetTerrainIntegrationParams(m_terrainIntegrationParams);
 
-	// The terrain sector meshes hold a classified copy of the geometry of every integrating node, so
-	// changing the classification parameters has to invalidate the sectors the node covers.
+	// The sector meshes hold a classified copy, so changing the classification invalidates them.
 	if (m_pRenderNode->GetGIMode() == IRenderNode::eGM_IntegrateIntoTerrain)
 	{
 		if (ITerrain* pTerrain = gEnv->p3DEngine ? gEnv->p3DEngine->GetITerrain() : nullptr)
diff --git a/Code/CryEngine/CryEntitySystem/EntitySlot.h b/Code/CryEngine/CryEntitySystem/EntitySlot.h
index 1069528f..3e95d027 100644
--- a/Code/CryEngine/CryEntitySystem/EntitySlot.h
+++ b/Code/CryEngine/CryEntitySystem/EntitySlot.h
@@ -80,13 +80,12 @@ public:
 	void       SetMaterial(IMaterial* pMtl);
 	IMaterial* GetMaterial() const { return m_pMaterial; }
 
-	//! Per instance parameters of the eGM_IntegrateIntoTerrain mode. They are kept on the slot
-	//! because CEntitySlot::UpdateRenderNode recreates the render node behind our back.
+	//! Per instance parameters of the eGM_IntegrateIntoTerrain mode. Kept on the slot because
+	//! UpdateRenderNode recreates the render node.
 	void                             SetTerrainIntegrationParams(const STerrainIntegrationParams& params);
 	const STerrainIntegrationParams& GetTerrainIntegrationParams() const { return m_terrainIntegrationParams; }
 
-	//! Pushes m_terrainIntegrationParams onto the render node and invalidates the terrain sectors
-	//! the node covers when the value actually changed and the node integrates into the terrain.
+	//! Pushes m_terrainIntegrationParams onto the render node and invalidates the covered sectors.
 	void                             ApplyTerrainIntegrationParams();
 
 	//! Fill SEntitySlotInfo structure with contents of the Entity Slot
diff --git a/Code/CryEngine/CryEntitySystem/RenderProxy.cpp b/Code/CryEngine/CryEntitySystem/RenderProxy.cpp
index 57c5c443..03a724f4 100644
--- a/Code/CryEngine/CryEntitySystem/RenderProxy.cpp
+++ b/Code/CryEngine/CryEntitySystem/RenderProxy.cpp
@@ -780,9 +780,8 @@ int CEntityRender::LoadGeometry(int nSlot, const char* szFilename, const char* s
 	}
 	else
 	{
-		// The GI mode is the OR of the entity extended flags and the slot flags: a component mesh
-		// (CBaseMeshComponent and friends) sets it on the slot, so looking at the entity alone missed
-		// the supported carrier of the "integrate into terrain" feature entirely.
+		// The GI mode is the OR of the entity extended flags and the slot flags: a component mesh sets it
+		// on the slot, so the entity flags alone are not enough.
 		const uint32 slotFlags = pSlot->GetFlags();
 		const uint32 slotGiMode = ((slotFlags & ENTITY_SLOT_GI_MODE_BIT0) ? 1 : 0)
 		                          | ((slotFlags & ENTITY_SLOT_GI_MODE_BIT1) ? 2 : 0)
