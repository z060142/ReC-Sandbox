diff --git a/Code/CryEngine/CryCommon/CryEntitySystem/IEntityComponent.h b/Code/CryEngine/CryCommon/CryEntitySystem/IEntityComponent.h
index 7a9eb8b9..84f0b437 100644
--- a/Code/CryEngine/CryCommon/CryEntitySystem/IEntityComponent.h
+++ b/Code/CryEngine/CryCommon/CryEntitySystem/IEntityComponent.h
@@ -905,6 +905,16 @@ struct IEntityAreaComponent : public IEntityComponent
 
 	//! Set this area's inner fade distance.
 	virtual void SetInnerFadeDistance(float const distance) = 0;
+
+	//! Moves the points of a SHAPE area without changing their number, the cheap counterpart of
+	//! SetPoints(): SetPoints() releases every a2DSegment, wipes the per-entity containment cache
+	//! and clears the area's "initialized" state while it rebuilds, which is far too much work for
+	//! a point that was merely dragged. Use this whenever the point COUNT, the closed flag and the
+	//! sound-obstruction array are unchanged, and SetPoints() when any of them changed.
+	//! Points are in local entity space, exactly as in SetPoints(). A count that does not match the
+	//! points already set, or an area that is not a shape, is ignored.
+	//! Appended at the end of this interface on purpose - it is called across DLL boundaries.
+	virtual void MovePoints(Vec3 const* const pPoints, size_t const numLocalPoints) = 0;
 };
 
 struct IClipVolumeComponent : public IEntityComponent
diff --git a/Code/CryEngine/CryEntitySystem/AreaProxy.cpp b/Code/CryEngine/CryEntitySystem/AreaProxy.cpp
index 8a69a46c..6b84e18f 100644
--- a/Code/CryEngine/CryEntitySystem/AreaProxy.cpp
+++ b/Code/CryEngine/CryEntitySystem/AreaProxy.cpp
@@ -641,6 +641,35 @@ void CEntityComponentArea::SetPoints(Vec3 const* const pPoints, bool const* cons
 	GetEntity()->SendEvent(evt);
 }
 
+//////////////////////////////////////////////////////////////////////////
+void CEntityComponentArea::MovePoints(Vec3 const* const pPoints, size_t const numLocalPoints)
+{
+	// The cheap geometry push, the counterpart of SetPoints(): the point count is unchanged, so
+	// CArea updates its segments in place instead of releasing and re-allocating them, keeping its
+	// per-entity containment cache and its "initialized" state (see the doc comment on
+	// IEntityAreaComponent::MovePoints). Anything the cheap path cannot express is ignored here -
+	// the caller is expected to fall back to SetPoints().
+	if (pPoints == nullptr || m_pEntity == nullptr || numLocalPoints == 0)
+		return;
+
+	if (m_pArea->GetAreaType() != ENTITY_AREA_TYPE_SHAPE || numLocalPoints != m_localPoints.size())
+		return;
+
+	memcpy(&m_localPoints[0], pPoints, numLocalPoints * sizeof(Vec3));
+
+	Matrix34 const& worldTM = m_pEntity->GetWorldTM();
+	CRY_ASSERT(s_tmpWorldPoints.empty());
+
+	s_tmpWorldPoints.resize(numLocalPoints);
+	for (size_t i = 0; i < numLocalPoints; ++i)
+	{
+		s_tmpWorldPoints[i] = worldTM.TransformPoint(m_localPoints[i]);
+	}
+
+	m_pArea->MovePoints(&s_tmpWorldPoints[0], numLocalPoints);
+	s_tmpWorldPoints.clear();
+}
+
 //////////////////////////////////////////////////////////////////////////
 const Vec3* CEntityComponentArea::GetPoints()
 {
diff --git a/Code/CryEngine/CryEntitySystem/AreaProxy.h b/Code/CryEngine/CryEntitySystem/AreaProxy.h
