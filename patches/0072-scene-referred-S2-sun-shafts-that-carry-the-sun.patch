+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.h
@@ -146,6 +146,11 @@ public:
 	//! satellite targets when the switch flips. Render thread, between frames.
 	void UpdateHDRSatelliteFormats();
 
+	//! Scene-referred pipeline (SceneReferredSpec.md S2): re-format the three scaled display
+	//! targets and their two Temp siblings when the switch flips. They are the sun-shaft stage's
+	//! borrowed working set and are UNORM in stock CE. Render thread, between frames.
+	void UpdateDisplayTargetScaledFormats();
+
 	void PrepareRainOcclusionMaps();
 	void CreateRainOcclusionMaps(int resourceWidth, int resourceHeight);
 	void DestroyRainOcclusionMaps();
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SunShafts.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SunShafts.cpp
index eb112e0d..f6091b70 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SunShafts.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SunShafts.cpp
@@ -30,6 +30,16 @@ void CSunShaftsStage::Init()
 
 int CSunShaftsStage::GetDownscaledTargetsIndex()
 {
+	// Scene-referred pipeline: pin to half resolution. At eRQ_Medium and below the stock code
+	// picks index 1 and the mask pass then samples $HDRTargetScaled 1/4, but the quarter-res
+	// downsample in CStandardGraphicsPipeline::ExecuteHDRPostProcessing does NOT list the
+	// sun-shafts stage among its triggers - so with bloom and auto-exposure off that target is
+	// never filled and the shafts are built from stale or uninitialised data. That is a stock
+	// bug (research/s2-sun-shafts.md section 2); fixing it would change the stock path at medium
+	// quality, so it is left alone and only the scene-referred path steps around it.
+	if (CRendererResources::IsSceneReferred())
+		return 0;
+
 	return gRenDev->EF_GetRenderQuality() >= eRQ_High ? 0 : 1;
 }
 
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp
index a74847b2..0ec3b116 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp
@@ -105,6 +105,14 @@ void CToneMappingStage::Execute()
 		{
 			// Scene-referred exposure. S0: the EV path, so SAMPLE4 stays clear exactly as it does
 			// in mode 1 and the shader keeps using ComputeExposure(). S1 replaces this branch.
+			//
+			// S2 claims SAMPLE0 as THE scene-referred permutation of HDRFinalPass. It selects the
+			// additive, pre-curve sun-shaft composite instead of the stock post-saturate headroom
+			// blend (decisions/s2-sun-shafts.md approach A) and it is the same bit S4's output
+			// transform will branch the body of FilmMapping on, which is why it is spent here and
+			// not on the exposure - S1 pinned that with a constant precisely so this bit stayed
+			// free. One extra permutation of one fullscreen pass.
+			rtMask |= g_HWSR_MaskBit[HWSR_SAMPLE0];
 		}
 		else if (CRenderer::CV_r_HDREyeAdaptationMode == 2)
 		{
@@ -194,7 +202,31 @@ void CToneMappingStage::Execute()
 		Vec4 sunShaftParams[2];
 		pSunShaftsStage->GetCompositionParams(sunShaftParams[0], sunShaftParams[1]);
 		Vec3 sunColor = gEnv->p3DEngine->GetSunColor();
-		sunColor.Normalize();
+
+		// Normalize() throws the sun's magnitude away and keeps only its hue as a unit vector, so
+		// on the stock path a white sun is (0.577, 0.577, 0.577) whatever the time of day, and
+		// shaft brightness is SunShafts_RaysAmount and nothing else. That is a workaround for the
+		// UNORM working set, not a rendering decision (research/s2-sun-shafts.md section 3): with
+		// unclamped HDR sun values, multiplying a [0,1] mask by the raw sun colour would saturate
+		// instantly and make the amount slider useless.
+		//
+		// The scene-referred path has an fp16 working set and composites before the tone curve,
+		// so the magnitude can be kept - and must be, or the shafts are the one thing in the
+		// frame that does not follow the aperture. The amount keeps its meaning exactly: it is
+		// the fraction of the sun that the shafts carry. Its useful VALUE changes, because it is
+		// now a scattering coefficient rather than a display fraction; see
+		// docs/SceneReferredCalibration.md section 3.
+		//
+		// E3DPARAM_SUN_COLOR is the UNEXPOSED sun: the pre-exposure is applied one level down, in
+		// CRenderView::GetSunLightColor(), which this does not go through. So the latched scale is
+		// applied here by hand - the same value the lights used this frame - and the shafts then
+		// follow T-stop, ND and the whole exposure triangle continuously, like everything else in
+		// the frame.
+		if (!bSceneReferred)
+			sunColor.Normalize();
+		else
+			sunColor *= gcpRendD3D->GetSceneReferredExposure();
+
 		sunColor.SetLerp(Vec3(sunShaftParams[0].x, sunShaftParams[0].y, sunShaftParams[0].z), sunColor, sunShaftParams[1].w);
 		shaftsSunCol = Vec4(sunColor * sunShaftParams[1].z, 1);
 	}
diff --git a/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx b/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx
index c4deae7b..9e2a6045 100644
--- a/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx
+++ b/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx
@@ -957,10 +957,27 @@ pixout HDRFinalScenePS(vert2frag IN)
 
 	half3 vAdaptedLum = luminanceTex.Load(int3(0, 0, 0));
 	half3 vSample = hdrTex.Load(int3(IN.WPos.xy, 0));
+
+	// Sun shafts, scene-referred composite (SceneReferredSpec.md S2, decisions/s2-sun-shafts.md
+	// approach A). SAMPLE0 is the scene-referred permutation of this pass; SAMPLE5 still means
+	// "shafts are present". BEFORE the tone curve, so the shafts are scene radiance like
+	// everything else and S4's output transform sees them, and ADDITIVE, because the stock
+	// blend's (1 - oSample) headroom term has no meaning in scene-referred space - there is no
+	// "1.0 white" to have headroom against. Physically scattering IS additive; the visible
+	// consequence is that shafts are no longer suppressed over bright regions.
+	//
+	// The constant it multiplies by is the sun's own exposed radiance times the shaft amount
+	// (CToneMappingStage::Execute), not the unit-length hue vector the stock path uses, so the
+	// shafts follow T-stop, ND and time of day continuously.
+#if %_RT_SAMPLE0 && %_RT_SAMPLE5
+	vSample += sunShaftsTex.Sample(linearClampSS, ScreenTC.xy).rgb * SunShafts_SunCol.rgb;
+#endif
+
 	half3 oSample = HDRToneMapSample( IN, vSample, cBloom, vAdaptedLum, fVignetting);
 
 	// Apply merged post processes
-#if %_RT_SAMPLE5
+	// The stock composite, untouched, and now only reachable off the scene-referred permutation.
+#if !%_RT_SAMPLE0 && %_RT_SAMPLE5
 	oSample += sunShaftsTex.Sample(linearClampSS, ScreenTC.xy) * SunShafts_SunCol * (1 - oSample); // Blend in ldr sunshafts	
 #endif
 
