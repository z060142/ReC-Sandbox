diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp
index 1d0b47b6..d2d2e5df 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp
@@ -521,6 +521,79 @@ void CGraphicsPipelineResources::UpdateHDRSatelliteFormats()
 	       (double(sizeAfter) - double(sizeBefore)) / (1024.0 * 1024.0));
 }
 
+// Re-format the five scaled display targets when the scene-referred switch flips
+// (SceneReferredSpec.md S2, decisions/s2-sun-shafts.md approach A).
+//
+// $DisplayTarget 1/2a, 1/4a, 1/8 and their two Temp siblings are R10G10B10A2 UNORM - hard
+// clamped to [0,1] with 2 bits of alpha. That is the format the sun-shaft stage borrows, and it
+// is the reason the whole shaft effect is display-referred: the mask
+// (linearDepth * 1.32 * (R+G+B), Sunshafts.cfx) clips to white for any pixel above about a
+// quarter of a mid-grey sunlit surface, so the shaft source is a binary silhouette rather than a
+// luminance image, and the shaft colour has to be Normalize()d to survive at all. On the
+// scene-referred path the shafts carry the sun's real exposed radiance, which needs a target
+// that can hold it.
+//
+// Same mechanism as the HDR satellites above and for the same reason - the objects stay alive,
+// only their device texture is swapped - and the same all-or-none rule: the three Scaled targets
+// and the two Temps are ping-ponged and are also addressable BY NAME from content-side shader
+// scripts as $backbufferscaled_d2 / _d4 / _d8, so a mixed set would be a silent precision cliff
+// that content could stumble into.
+//
+// $DisplayTarget and $DisplayTargetDst are deliberately NOT in this set. Those are the tone
+// map's output, still display-referred by design, and moving them is S4's problem (the PostAA
+// history, the LDR post stage and the swap chain all key off that format). nLDRPFormat itself is
+// untouched, so with the switch off every one of these targets is bit-for-bit stock, including
+// the SSAO albedo downsample and the snow velocity passes that share them.
+void CGraphicsPipelineResources::UpdateDisplayTargetScaledFormats()
+{
+	const ETEX_Format wanted = CRendererResources::IsSceneReferred()
+	                           ? eTF_R16G16B16A16F
+	                           : CRendererResources::GetLDRFormat(true);
+
+	CTexture* const scaled[] =
+	{
+		m_pTexDisplayTargetScaled[0],
+		m_pTexDisplayTargetScaled[1],
+		m_pTexDisplayTargetScaled[2],
+		m_pTexDisplayTargetScaledTemp[0],
+		m_pTexDisplayTargetScaledTemp[1],
+	};
+
+	uint64 sizeBefore = 0;
+	bool bMismatch = false;
+	for (CTexture* pTex : scaled)
+	{
+		if (!pTex)
+			continue;
+
+		sizeBefore += pTex->GetDeviceDataSize();
+		bMismatch |= (pTex->GetDstFormat() != wanted);
+	}
+
+	if (!bMismatch)
+		return;
+
+	uint64 sizeAfter = 0;
+	for (CTexture* pTex : scaled)
+	{
+		if (!pTex)
+			continue;
+
+		if (pTex->GetDstFormat() != wanted)
+			pTex->ReformatRenderTarget(wanted);
+
+		sizeAfter += pTex->GetDeviceDataSize();
+	}
+
+	// Once per flip. Roughly +5 MiB at 1080p and +21 MiB at 4K for the whole set, per graphics
+	// pipeline; the shaft pair alone is about +4 MiB and +17 MiB of that.
+	CryLog("[SceneReferred] scaled display targets -> %s at %dx%d; %.1f MiB -> %.1f MiB (%+.1f MiB)",
+	       (wanted == eTF_R16G16B16A16F) ? "R16G16B16A16F" : "R10G10B10A2",
+	       m_resourceWidth, m_resourceHeight,
+	       sizeBefore / (1024.0 * 1024.0), sizeAfter / (1024.0 * 1024.0),
+	       (double(sizeAfter) - double(sizeBefore)) / (1024.0 * 1024.0));
+}
+
 void CGraphicsPipelineResources::Update(EShaderRenderingFlags renderingFlags)
 {
 	// Scene-referred pipeline: pick up a flip of the switch. Update() is the sanctioned place
@@ -528,6 +601,7 @@ void CGraphicsPipelineResources::Update(EShaderRenderingFlags renderingFlags)
 	// CompileModifiedRenderObjects() and before Execute(), so nothing is bound yet - and the
 	// rain occlusion texture right below is created and released on demand in the same way.
 	UpdateHDRSatelliteFormats();
+	UpdateDisplayTargetScaledFormats();
 
 	const auto shouldApplyOcclusion = gcpRendD3D->m_bDeferredRainOcclusionEnabled && CRendererCVars::IsRainEnabled();
 
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.h b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.h
