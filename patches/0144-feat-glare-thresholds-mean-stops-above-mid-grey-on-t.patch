@@ -660,13 +664,68 @@ float CRendererResources::GetSceneReferredSkyPeakClamp(float sceneExposure)
 // difference.
 float CRendererResources::ResolveThreshold(float stored)
 {
-	// Stage 5 on the bisection gate: reading the same stored number as stops above mid grey is
-	// part of the camera-grade half of the pipeline (S7), and below that stage every threshold
-	// keeps its absolute engine-unit meaning exactly as on the stock path.
-	if (!IsSceneReferredStage(5))
-		return max(stored, 0.0f);
+	const float fStops = powf(2.0f, clamp_tpl(stored, -6.0f, 16.0f));
 
-	return kSceneReferredMidGrey * powf(2.0f, clamp_tpl(stored, -6.0f, 16.0f));
+	// Stage 5 on the bisection gate: the frame is pre-exposed, so mid grey IS 0.18 in the buffer
+	// and the stored number is stops above it (S7).
+	if (IsSceneReferredStage(5))
+		return kSceneReferredMidGrey * fStops;
+
+	// S9 - the STOCK path, same rule, its own mid grey (decisions/s9-glare-stock-threshold.md).
+	//
+	// Off the switch the HDR target holds RAW scene radiance: nothing has divided it by the
+	// exposure, so 0.18 is not mid grey there and the stored 4.0 used to mean 4.0 engine units =
+	// 40 000 cd/m2, an ABSOLUTE luminance. That made "what grows rays" a completely different set
+	// of objects on the two paths - with the skybox x10 still in force off the switch, an entire
+	// full-sun sky cleared it (research/s9-wave-glare-stock-fps.md) - and it made the set move
+	// with nothing at all: change the aperture and the same objects streak, because the raw buffer
+	// does not know the aperture exists.
+	//
+	// The stock frame is exposed too; it is just exposed LAST, in the tone mapper, by exactly the
+	// same factor the scene-referred path applies first. So the scene value that lands on mid grey
+	// is 0.18 / fExposure, and reading the stored number as stops above THAT makes the two paths
+	// select the same physical set of sources - N stops above the frame's own mid grey, on both.
+	//
+	// Demand-latched: the number is only measured while something asks for it, and this call IS
+	// the asking. Nothing on the stock path calls ResolveThreshold unless one of our own effects
+	// (the glare family, halation, the front filter, the DOF's highlights and ghosts - none of
+	// which exist in stock CRYENGINE) is gathering its parameters.
+	s_fStockMidGreyDemandTime = gEnv->pTimer ? gEnv->pTimer->GetAsyncCurTime() : 0.0f;
+
+	const float fStockMidGrey = s_fStockMidGrey;
+	if (fStockMidGrey > 0.0f)
+		return fStockMidGrey * fStops;
+
+	// No measurement yet (the first frames after the camera comes up, a pipeline with no eye
+	// adaptation, or a readback that has not landed). Fall back to the absolute reading rather
+	// than to a guess: that is what this line has always done and it cannot surprise anyone.
+	return max(stored, 0.0f);
+}
+
+float CRendererResources::GetStockMidGrey()
+{
+	return s_fStockMidGrey;
+}
+
+void CRendererResources::PublishStockMidGrey(float midGreyRaw)
+{
+	// Anything outside this window is not a scene's mid grey, it is a meter that has lost its
+	// footing: 1e-6 engine units is 0.01 cd/m2 (starlight on a grey card) and 1e3 is 10 Mcd/m2,
+	// three decades over a sunlit one. Out of range publishes NOTHING, so ResolveThreshold falls
+	// back to the absolute reading instead of acting on a number that would move the threshold by
+	// decades for one frame.
+	s_fStockMidGrey = (NumberValid(midGreyRaw) && midGreyRaw > 1e-6f && midGreyRaw < 1e3f) ? midGreyRaw : 0.0f;
+}
+
+bool CRendererResources::IsStockMidGreyDemanded()
+{
+	if (s_fStockMidGreyDemandTime <= 0.0f || gEnv->pTimer == nullptr)
+		return false;
+
+	// One second of hysteresis. The demand is set by the effect stages, which run AFTER the auto
+	// exposure stage in the frame, so a window shorter than a frame would never see it; and a
+	// camera that is toggled on and off must not make the readback target churn.
+	return (gEnv->pTimer->GetAsyncCurTime() - s_fStockMidGreyDemandTime) < 1.0f;
 }
 
