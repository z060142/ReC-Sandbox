diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.cpp
index aa9fc49f..e9aed42b 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.cpp
@@ -648,4 +648,159 @@ void CAutoExposureStage::Execute()
 	MeasureLuminance();
 	AdjustExposure();
 	UpdateSceneReferredMeterReadback();
+	// After AdjustExposure(), which is what sets s_ptexCurLumTexture for this frame.
+	UpdateStockMidGreyReadback();
+}
+
+// S9 - the STOCK path's mid grey (decisions/s9-glare-stock-threshold.md).
+//
+// The problem it solves is in CRendererResources::ResolveThreshold: off the scene-referred switch
+// the HDR target holds RAW scene radiance, so a glare threshold of "4" meant 4 engine units =
+// 40 000 cd/m2 - an absolute luminance that has nothing to do with how the frame is exposed. What
+// grows rays was therefore a different set of objects on the two paths, and on neither path did it
+// follow the aperture. The fix is to read the same stored number as stops above mid grey on both,
+// and mid grey on the stock path is the scene value the frame's own exposure puts on 0.18:
+//
+//     midGrey_raw = 0.18 / fExposure
+//
+// fExposure is not a constant the CPU has. It is computed in the tone-mapping shader from the 1x1
+// ADAPTED luminance texture (FilmMapping, HDRPostProcess.cfx), so this reads that texture back and
+// evaluates the same formula here. A CPU replica of ComputeExposure() / the Krawczyk branch already
+// exists in CToneMappingStage::DisplayDebugInfo() for the r_HDRDebug overlay; this is the second,
+// and both have to be kept in step with the shader by hand - which is why the branch below tests
+// exactly the cvar the shader's %_RT_SAMPLE4 permutation tests.
+//
+// Two or three frames of lag, and it does not matter: what is being read is the output of an
+// exponential eye-adaptation filter whose time constant (r_HDREyeAdaptationSpeed) is measured in
+// tenths of a second. A threshold that trails the exposure by two frames cannot be seen; a
+// threshold that ignores the exposure entirely is what this replaces.
+//
+// The whole thing is demand-driven. Nothing on the stock path calls ResolveThreshold unless one of
+// our own effects is gathering parameters, so with no cinematic camera on the bus the target below
+// is released and not one byte is allocated or copied.
+void CAutoExposureStage::UpdateStockMidGreyReadback()
+{
+	const bool bCubemapGen = (m_graphicsPipeline.GetRenderFlags() & SHDF_CUBEMAPGEN) != 0;
+	// Scene-referred: mid grey is 0.18 in the buffer by construction and ResolveThreshold never
+	// asks. Cube-map generation renders at unity exposure and is not a picture anybody grades.
+	const bool bWanted = !bCubemapGen
+	                     && !CRendererResources::IsSceneReferredStage(5)
+	                     && CRendererResources::IsStockMidGreyDemanded();
+
+	if (!bWanted)
+	{
+		// Do not free while a download is still in flight - the staging resource is the target of
+		// a GPU copy that has not necessarily retired.
+		if (!m_bStockLumReadbackIssued)
+		{
+			m_pTexStockLumReadback.reset();
+			m_bStockLumReadbackStalled = false;
+		}
+		CRendererResources::PublishStockMidGrey(0.0f);
+		return;
+	}
+
+	CTexture* pLumTex = CRendererResources::s_ptexCurLumTexture;
+	if (!CTexture::IsTextureExist(pLumTex))
+		return;
+
+	if (!CTexture::IsTextureExist(m_pTexStockLumReadback))
+	{
+		if (m_bStockLumReadbackIssued)
+			return;
+
+		// FT_STAGE_READBACK is what gives the texture a PERSISTENT staging resource, and that is
+		// what makes the download two-phase (issue now, map later) instead of a full pipeline
+		// stall. R16G16F, the same format as the adapted-luminance texture, so the blit is a copy
+		// and not a conversion.
+		const uint32 flags = FT_NOMIPS | FT_DONT_STREAM | FT_USAGE_RENDERTARGET | FT_STAGE_READBACK;
+		const std::string id = m_graphicsPipeline.GetUniqueIdentifierName();
+		m_pTexStockLumReadback = CTexture::GetOrCreateRenderTarget(("$StockMidGreyReadback" + id).c_str(),
+		                                                           1, 1, Clr_Transparent, eTT_2D, flags, eTF_R16G16F);
+
+		if (!CTexture::IsTextureExist(m_pTexStockLumReadback))
+		{
+			m_pTexStockLumReadback.reset();
+			CryLogAlways("[SceneReferred] stock mid grey: could not create the 1x1 staging target - "
+			             "the glare thresholds stay ABSOLUTE on the stock path");
+			return;
+		}
+
+		CryLog("[SceneReferred] stock mid grey armed: the glare family's thresholds are now stops above "
+		       "the frame's own mid grey on the stock path too (0.18 / the tone map's exposure)");
+	}
+
+	CDeviceTexture* pDevTex = m_pTexStockLumReadback->GetDevTexture();
+	if (pDevTex == nullptr)
+		return;
+
+	const float fNow = gEnv->pTimer->GetAsyncCurTime();
+
+	if (m_bStockLumReadbackIssued)
+	{
+		// Not signalled yet: come back next frame. Never block.
+		if (!pDevTex->AccessCurrStagingResource(0, false))
+		{
+			if ((fNow - m_fStockLumIssuedTime) > 5.0f && !m_bStockLumReadbackStalled)
+			{
+				m_bStockLumReadbackStalled = true;
+				CryLogAlways("[SceneReferred] stock mid grey: the staging download has not signalled in 5 s - "
+				             "the glare thresholds are holding their last value");
+			}
+			return;
+		}
+		m_bStockLumReadbackStalled = false;
+
+		float fAdaptedLum = 0.0f, fAdaptedIllum = 0.0f;
+		const auto readbackData = [&fAdaptedLum, &fAdaptedIllum](void* pData, uint32 rowPitch, uint32 slicePitch) -> bool
+		{
+			// R16G16F: .x is the adapted geometric-mean luminance, .y the adapted illuminance
+			// estimate. The tone map uses .y in mode 1 and .x in mode 2 - exactly as below.
+			const CryHalf* pDataHalf = static_cast<const CryHalf*>(pData);
+			fAdaptedLum   = CryConvertHalfToFloat(pDataHalf[0]);
+			fAdaptedIllum = CryConvertHalfToFloat(pDataHalf[1]);
+			return true;
+		};
+		pDevTex->AccessCurrStagingResource(0, false, readbackData);
+		m_bStockLumReadbackIssued = false;
+
+		Vec4 hdrSetupParams[5];
+		gEnv->p3DEngine->GetHDRSetupParams(hdrSetupParams);
+
+		float fExposure = 0.0f;
+
+		if (CRenderer::CV_r_HDREyeAdaptationMode == 2)
+		{
+			// The legacy Krawczyk branch (%_RT_SAMPLE4 in HDRFinalPass, set by CToneMappingStage
+			// under exactly this test). It is the ENGINE DEFAULT, so it is the branch that matters
+			// most here. .y/.z of hdrSetupParams[4] are min and max EXPOSURE, not an EV window.
+			const float fLum = max(fAdaptedLum, 1e-9f);
+			const float fSceneKey = 1.03f - 2.0f / (2.0f + logf(fLum + 1.0f) / logf(2.0f));
+			fExposure = clamp_tpl(fSceneKey / fLum, hdrSetupParams[4].y, hdrSetupParams[4].z);
+		}
+		else
+		{
+			// ComputeExposure(), verbatim, with hdrSetupParams[3] = (EV min, EV max, EV auto
+			// compensation) - the constant CToneMappingStage binds as HDREyeAdaptation in mode 1.
+			const float fIllum = max(fAdaptedIllum, 1e-9f);
+			float fEV100 = logf(fIllum * RENDERER_LIGHT_UNIT_SCALE * 100.0f / 330.0f) / logf(2.0f);
+			fEV100 -= ((clamp_tpl(log10f(fIllum * RENDERER_LIGHT_UNIT_SCALE + 1.0f), 0.1f, 5.2f) - 3.0f) / 2.0f) * hdrSetupParams[3].z;
+			fEV100 = clamp_tpl(fEV100, hdrSetupParams[3].x, hdrSetupParams[3].y);
+			fExposure = (RENDERER_LIGHT_UNIT_SCALE / 1.2f) / powf(2.0f, fEV100);
+		}
+
+		// The one line this function exists for. The vignette in FilmMapping is spatial and is not
+		// part of it: mid grey is defined at the centre of the frame, where the vignette is 1.
+		CRendererResources::PublishStockMidGrey((fExposure > 1e-12f)
+		                                        ? (CRendererResources::kSceneReferredMidGrey / fExposure)
+		                                        : 0.0f);
+		return;
+	}
+
+	// Every frame, not on a cadence: this is a threshold the picture is judged against, and a
+	// once-a-second update would step visibly through a pan from shade into sun.
+	m_passStockLumCopy.Execute(pLumTex, m_pTexStockLumReadback);
+	pDevTex->DownloadToStagingResource(0);
+	m_bStockLumReadbackIssued = true;
+	m_fStockLumIssuedTime = fNow;
 }
