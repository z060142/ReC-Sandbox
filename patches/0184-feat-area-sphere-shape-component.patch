diff --git a/Code/CryPlugins/AreaComponents/Module/Shapes/ShapeDisplay.h b/Code/CryPlugins/AreaComponents/Module/Shapes/ShapeDisplay.h
new file mode 100644
index 00000000..3d164c61
--- /dev/null
