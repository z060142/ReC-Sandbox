+//////////////////////////////////////////////////////////////////////////
+// Sunken plate hiding (P17 half A). @see the e_TerrainPlateHideSunken comment at the top of this file.
+//////////////////////////////////////////////////////////////////////////
+
+bool CTerrainPlateComponent::IsPlateFullySunken(float clearance) const
+{
+	if (m_pEntity == nullptr || gEnv == nullptr || gEnv->p3DEngine == nullptr)
+		return false;
+
+	const SBakeTerrainMetrics metrics = GetBakeTerrainMetrics();
+	if (!metrics.IsValid())
+		return false;
+
+	const Matrix34 worldTM = GetPlateWorldTM();
+
+	// The same unit box the bake footprint is built from: local Z runs 0..1 and carries the relief, so
+	// the transformed box is the world extent of the plate surface, skirt excluded (the skirt only ever
+	// goes down, and a skirt hanging below buried ground is buried too).
+	const AABB localBox(Vec3(-0.5f, -0.5f, 0.f), Vec3(0.5f, 0.5f, 1.f));
+	const AABB worldBox = AABB::CreateTransformedAABB(worldTM, localBox);
+
+	const float sizeX = worldBox.max.x - worldBox.min.x;
+	const float sizeY = worldBox.max.y - worldBox.min.y;
+	if (sizeX <= 0.f || sizeY <= 0.f)
+		return false;
+
+	// At least two samples per terrain unit along each axis, so no bump of the plate can hide between two
+	// samples of the surface the terrain mesh interpolates. @see kSunkenMaxSamplesPerAxis for the cap.
+	const float wantedSpacing = metrics.unitSize * 0.5f;
+	const int   samplesX = (int)ceilf(sizeX / wantedSpacing) + 1;
+	const int   samplesY = (int)ceilf(sizeY / wantedSpacing) + 1;
+
+	if (samplesX > kSunkenMaxSamplesPerAxis || samplesY > kSunkenMaxSamplesPerAxis)
+	{
+		if (!m_bSunkenSizeWarningIssued)
+		{
+			m_bSunkenSizeWarningIssued = true;
+			CryWarning(VALIDATOR_MODULE_ENTITYSYSTEM, VALIDATOR_WARNING,
+			           "Terrain Plate '%s': footprint of %.0f x %.0f m is too large for the sunken plate test "
+			           "(e_TerrainPlateHideSunken); the plate keeps drawing itself, as it did before the test existed",
+			           GetPlateName(), sizeX, sizeY);
+		}
+		return false;
+	}
+
+	const int nx = max(2, samplesX);
+	const int ny = max(2, samplesY);
+	const float stepX = sizeX / (float)(nx - 1);
+	const float stepY = sizeY / (float)(ny - 1);
+
+	const float invUnit = 1.f / metrics.unitSize;
+
+	bool bAnyInside = false;
+
+	for (int sx = 0; sx < nx; ++sx)
+	{
+		const float worldX = worldBox.min.x + stepX * (float)sx;
+
+		for (int sy = 0; sy < ny; ++sy)
+		{
+			const float worldY = worldBox.min.y + stepY * (float)sy;
+
+			float plateZ = 0.f, lx = 0.f, ly = 0.f;
+			if (!SamplePlateSurface(worldTM, worldX, worldY, plateZ, lx, ly))
+				continue;   // outside the rotated plate: the terrain there is nobody's business
+
+			bAnyInside = true;
+
+			// The terrain mesh draws the quad between four heightmap nodes, so over that quad it is
+			// never lower than the lowest of the four. Comparing against that minimum is what makes the
+			// answer safe for the surface that is actually rasterised, rather than for the single node
+			// GetZ would have returned - and it is the same GetZ the depth test's LOD 0 mesh is built
+			// from (BuildVertices, terrain_sector_render.cpp).
+			const int ux = (int)floorf(worldX * invUnit);
+			const int uy = (int)floorf(worldY * invUnit);
+
+			float terrainZ = SampleTerrainUnit(metrics, ux, uy);
+			terrainZ = min(terrainZ, SampleTerrainUnit(metrics, ux + 1, uy));
+			terrainZ = min(terrainZ, SampleTerrainUnit(metrics, ux, uy + 1));
+			terrainZ = min(terrainZ, SampleTerrainUnit(metrics, ux + 1, uy + 1));
+
+			if (terrainZ - plateZ < clearance)
+				return false;   // this much of the plate is at or above the ground: it has to keep drawing
+		}
+	}
+
+	return bAnyInside;
+}
+
+void CTerrainPlateComponent::ApplySunkenHideFlag(bool bHide)
+{
+	if (m_pEntity == nullptr || GetEntitySlotId() == IEntityComponent::EmptySlotId)
+		return;
+
+	// ERF_HIDDEN_FROM_CAMERA, not ERF_HIDDEN: CBrush::Render tests it only outside shadow and recursive
+	// passes (Brush.cpp:158-163, :820-825), and no other consumer in the engine reads it, so the shadow
+	// caster list, the static shadow cache, HeightMap AO, the SVOGI voxelisation, physics and the
+	// editor's CPU hit test are all untouched. @see research 10, section 3.2.
+	if (IRenderNode* pRenderNode = m_pEntity->GetSlotRenderNode(GetEntitySlotId()))
+	{
+		pRenderNode->SetRndFlags(ERF_HIDDEN_FROM_CAMERA, bHide);
+	}
+}
+
+void CTerrainPlateComponent::ClearSunkenHide()
+{
+	// Unconditional, and it runs BEFORE the thing that will change the answer, never after. A hide that
+	// survives the plate being lifted, the ground being dug out or the mesh being rebuilt is a hole in
+	// the world for as long as it lasts, and the streaming retry latch of the terrain integration is the
+	// standing example of exactly that mistake (@see research 10, hazard 6).
+	m_bSunkenRecheckPending = true;
+
+	if (m_bSunkenHidden)
+	{
+		m_bSunkenHidden = false;
+		ApplySunkenHideFlag(false);
+	}
+}
+
+void CTerrainPlateComponent::UpdateSunkenHide()
+{
+	m_bSunkenRecheckPending = false;
+	m_lastSunkenCheckFrameId = (gEnv != nullptr) ? gEnv->nMainFrameID : 0;
+
+	if (g_terrainPlateHideSunken == 0)
+	{
+		// Turned off from the console: give the draw back in the same frame.
+		if (m_bSunkenHidden)
+		{
+			m_bSunkenHidden = false;
+			ApplySunkenHideFlag(false);
+		}
+		return;
+	}
+
+	const bool bSunken = IsPlateFullySunken(m_bSunkenHidden ? kSunkenShowClearance : kSunkenHideClearance);
+
+	if (bSunken != m_bSunkenHidden)
+	{
+		m_bSunkenHidden = bSunken;
+
+		if (GetPlateDebugLevel() >= 1)
+		{
+			CryLog("TerrainPlate '%s': %s (sunken plate hiding)", GetPlateName(),
+			       bSunken ? "hidden from camera, the terrain covers it everywhere" : "drawing again, part of it is above the ground");
+		}
+	}
+
+	// Written every time, not only on a change: the slot render node is recreated by every mesh rebuild
+	// and by anything else that reassigns the slot, and a recreated node comes back with the flag clear.
+	ApplySunkenHideFlag(m_bSunkenHidden);
+}
+
+void CTerrainPlateComponent::OnHideSunkenCVarChanged(ICVar* /*pCVar*/)
+{
+	for (CTerrainPlateComponent* pPlate : g_terrainPlates)
+	{
+		pPlate->m_bSunkenRecheckPending = true;
+
+		if (pPlate->m_pEntity != nullptr)
+		{
+			pPlate->m_pEntity->UpdateComponentEventMask(pPlate);
+		}
+	}
+}
+
+bool CTerrainPlateComponent::WantsSunkenHideTick() const
+{
+	// A visible plate costs nothing per frame: it is re-tested by the events that can change the answer
+	// (a transform, a property change, a rebuild, a bake) and not by a poll. A HIDDEN one keeps ticking,
+	// because from then on the thing that has to be noticed is the ground above it going away, and
+	// nothing sends an event for that.
+	return m_bSunkenHidden || (m_bSunkenRecheckPending && g_terrainPlateHideSunken != 0);
+}
