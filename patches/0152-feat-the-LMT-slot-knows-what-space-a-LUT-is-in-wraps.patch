+// The two reflected types the display chain's .cube properties need (S10 item 4).
+//
+// Shared by BOTH components: the camera owns the ODT path (its monitor) and the CineCam Grade
+// component owns the LMT path (the look), and neither should invent its own answer to "what is a
+// cube file property" or "what space is a cube in".
+#pragma once
+
+#include <CrySchematyc/ResourceTypes.h>       // SerializationUtils::SResourceNameSerializer
+#include <CrySchematyc/Reflection/TypeDesc.h>
+#include <CrySerialization/Decorators/ResourceFilePath.h>
+
+namespace Schematyc
+{
+
+// ---------------------------------------------------------------------------
+// A .cube file path property with a "..." button (S10 item 4.5)
+// ---------------------------------------------------------------------------
+// Typing an asset path from memory is not a user interface. CRYENGINE 5.7.1 has two reflected
+// path families (CrySchematyc/ResourceTypes.h):
+//
+//   * SResourceNameSelector<&Serialization::XxxPicker<string>> - an ASSET picker, backed by a
+//     registered resource selector and therefore by a registered asset type. That is the family
+//     Schematyc::TextureFileName belongs to (this plugin already uses it for the bokeh shape and
+//     the filter PSF). A .cube is not a registered asset type in 5.7.1, so this family is not
+//     available yet - it is what work item 4b will bring.
+//
+//   * SResourceNameSerializer<&fn> where fn returns Serialization::ResourceFilePath - a plain
+//     FILE picker: a filter string, a "..." button, an engine file dialog. Two shipped instances,
+//     MannequinAnimationDatabasePath and MannequinControllerDefinitionPath
+//     (ResourceTypes.h:255/263, Resources.h:60-61). Nothing else is needed to use it.
+//
+// The second is what a .cube can have today, so that is what it gets. The row is drawn by
+// PropertyRowResourceFilePath (registered at PropertyRowResourceFilePath.cpp:99) in the legacy
+// yasli tree the entity inspector uses; its button runs CEngineFileDialog::RunGameOpen, which
+// returns an ENGINE-RELATIVE path - exactly the string the loader already resolves ("as given"
+// first, then under %ENGINE%). So the stored value, the reflected default and every saved level
+// are unchanged by this: outside the editor the type serialises as `ar(*value.path, name, label)`,
+// which is byte-for-byte what Schematyc::CSharedString wrote before.
+//
+// Two stock quirks, worth knowing rather than patching:
+//   * PropertyRowResourceFilePath::setValueAndContext copies the decorator's filter, flags and
+//     path pointer but NOT its startFolder, so the start folder below is inert in 5.7.1. It is
+//     passed anyway because it states the intent and costs nothing.
+//   * The dialog only accepts files the editor's file-system enumerator knows, i.e. files under
+//     the project. A LUT installed ONLY into <engine>/engine/Assets/ODT/ has to be typed - it
+//     still resolves and still loads.
+inline Serialization::ResourceFilePath CineCubeFilePath(string& value)
+{
+	return Serialization::ResourceFilePath(value, "Cube LUT (cube)|*.cube", "Assets/ODT");
+}
+
+typedef SerializationUtils::SResourceNameSerializer<&CineCubeFilePath> CineCubeFileName;
+
+inline void ReflectType(CTypeDesc<CineCubeFileName>& desc)
+{
+	desc.SetGUID("{9C21A4F7-3E58-4B06-8D19-6A5F0C7E24B3}"_cry_guid);
+	desc.SetLabel("Cube LUT File");
+	desc.SetDescription("Path to a Resolve-dialect .cube LUT");
+}
+
+} // namespace Schematyc
+
+// ---------------------------------------------------------------------------
+// What a .cube expects at its input (S10 item 4.1)
+// ---------------------------------------------------------------------------
+// A Rec.709 display LUT and an ACEScct LMT are both three floats in [0,1] on a unit domain, so
+// the wrong one loads without complaint and produces a wrong picture SILENTLY. Nothing in the
+// .cube format distinguishes them - the Adobe/Resolve dialect has TITLE, the two sizes,
+// DOMAIN_MIN/MAX and comments, and no metadata field at all.
+//
+// So there are two answers, in this order (decisions/s10-grade-component.md 4.1):
+//   1. a `# ReC-LUT-Space: <value>` line in the file's comment block, which our bake tool writes
+//      and the plugin parses. Authoritative when present: it was written by whoever made the LUT.
+//   2. this property, for a foreign LUT that has no tag and never will. Its default is ACEScct,
+//      so an untagged file with an untouched property is exactly the behaviour that existed
+//      before this enum did - parse, convert, upload, bit-identical.
+// Both present and disagreeing: the tag wins, and one warning names the file.
+enum class ELutSpace : uint32
+{
+	//! The grading space this chain works in. No conversion: the file goes straight to the GPU.
+	ACEScct = 0,
+	//! Linear ACEScg. Wrapped with the analytic shaper. NOTE that a unit-domain LINEAR cube covers
+	//! scene linear [0,1] and nothing above, while ACEScctToLinear(1.0) = 222.86 - a linear look
+	//! LUT really wants a shaper, which this chain's parser refuses.
+	ACEScg,
+	//! An ordinary Rec.709 / sRGB DISPLAY look LUT - the overwhelmingly common kind. Wrapped with
+	//! the ACES 2.0 SDR 100 nit sRGB output transform and its inverse.
+	Rec709Display,
+};
+
+inline void ReflectType(Schematyc::CTypeDesc<ELutSpace>& desc)
+{
+	desc.SetGUID("{2F6B8D50-91C3-4A7E-B248-05E7D9A16C3F}"_cry_guid);
+	desc.SetLabel("LUT Input Space");
+	desc.SetDefaultValue(ELutSpace::ACEScct);
+	desc.AddConstant(ELutSpace::ACEScct,       "ACEScct",       "ACEScct (an LMT)");
+	desc.AddConstant(ELutSpace::ACEScg,        "ACEScg",        "ACEScg linear");
+	desc.AddConstant(ELutSpace::Rec709Display, "Rec709Display", "Rec.709 display (a normal LUT)");
+}
