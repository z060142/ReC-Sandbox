+			// mistake for the ODT slot. The loader does not judge; the tone map does.
+			ClearLutSlot(slot);
+			return;
+		}
+
+		LoadLutIntoSlot(slot, szWanted, szCacheName, szRole, fallbackSpace, bAllowWrap, false);
+		return;
+	}
+
