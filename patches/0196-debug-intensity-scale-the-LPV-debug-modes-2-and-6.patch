From 626cbc260983d4e91496eca061c6b0fe88122994 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 12 Aug 2026 18:24:49 +0800
Subject: [PATCH 196/307] debug: intensity-scale the LPV debug modes 2 and 6

The raw grid/accumulator units are far below 8-bit visibility, so the
staged-diagnosis screenshots of these modes were unreadable black while
hunting the cascade-scale energy loss. Both modes now multiply by
r_LPVIntensity like the mosaic mode already did.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tu9cj9ax1mqCV93HVfCfpW
---
 Engine/Shaders/HWScripts/CryFX/LPV.cfi | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/Engine/Shaders/HWScripts/CryFX/LPV.cfi b/Engine/Shaders/HWScripts/CryFX/LPV.cfi
index a7f1ea11..cd516ca8 100644
--- a/Engine/Shaders/HWScripts/CryFX/LPV.cfi
+++ b/Engine/Shaders/HWScripts/CryFX/LPV.cfi
@@ -887,7 +887,9 @@ void LPVApplyCS(uint3 DTid : SV_DispatchThreadID)
 			const float3 accumL0 = float3(abs((float)LPVApplyAccum[accumBase + 0u]),
 			                              abs((float)LPVApplyAccum[accumBase + 4u]),
 			                              abs((float)LPVApplyAccum[accumBase + 8u])) * LPV_FP_INV_SCALE;
-			LPVIrradianceUAV[pixelCoord] = float4(accumL0, 1.0f);
+			// Scaled by the display intensity: the raw accumulator units are far below 8 bit
+			// visibility, un-scaled screenshots of this mode were unreadable black.
+			LPVIrradianceUAV[pixelCoord] = float4(accumL0 * LPVApplyParams.x, 1.0f);
 			return;
 		}
 		// Debug mode 12: geometry volume blocking potential (L0 magnitude) as a surface mosaic.
@@ -938,7 +940,8 @@ void LPVApplyCS(uint3 DTid : SV_DispatchThreadID)
 			const float4 dbgR = LPVGridR.SampleLevel(LPVGridSampler, saturate(gridUV), 0);
 			const float4 dbgG = LPVGridG.SampleLevel(LPVGridSampler, saturate(gridUV), 0);
 			const float4 dbgB = LPVGridB.SampleLevel(LPVGridSampler, saturate(gridUV), 0);
-			LPVIrradianceUAV[pixelCoord] = float4(abs(dbgR.x), abs(dbgG.x), abs(dbgB.x), 1.0f);
+			// Scaled by the display intensity, see the mode 6 comment.
+			LPVIrradianceUAV[pixelCoord] = float4(float3(abs(dbgR.x), abs(dbgG.x), abs(dbgB.x)) * LPVApplyParams.x, 1.0f);
 			return;
 		}
 		if (debugMode == 3)
-- 
