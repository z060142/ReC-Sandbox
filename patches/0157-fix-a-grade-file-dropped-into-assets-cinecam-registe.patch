@@ -2,6 +2,23 @@
 #include "StdAfx.h"
 #include "CinematicCameraEditorPlugin.h"
 
+#include "CineCamAssetRegistration.h"
+
 #include <CryCore/Platform/platform_impl.inl>
 
+// The constructor runs after REGISTER_PLUGIN has installed GetIEditor() and ISystem, and before
+// RegisterPlugin() drains the auto-register lists - which is fine: the file listener is keyed on our
+// own extension table, not on the asset types. Both CAssetManager and CEditorFileMonitor already
+// exist by then (IEditorImpl.cpp:141/143), and CAssetManager::Init - which starts the scan the sweep
+// waits for - runs afterwards (CryEdit.cpp:557 loads plugins, :721 initialises the asset manager).
+CCinematicCameraEditorPlugin::CCinematicCameraEditorPlugin()
+{
+	CineCamAssets::Install();
+}
+
+CCinematicCameraEditorPlugin::~CCinematicCameraEditorPlugin()
+{
+	CineCamAssets::Uninstall();
+}
+
