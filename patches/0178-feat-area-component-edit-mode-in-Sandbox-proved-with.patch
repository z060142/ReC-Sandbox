+bool CShapeEditTool::GetManipulatorMatrix(Matrix34& tm)
+{
+	IShapeComponent* pShape = ResolveShape();
+	if (pShape == nullptr)
+		return false;
+
+	tm = pShape->GetWorldTransformMatrix();
+	tm.OrthonormalizeFast();
+	return true;
