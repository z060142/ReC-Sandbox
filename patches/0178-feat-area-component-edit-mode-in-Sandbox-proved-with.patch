+//! The payload the "Edit Shape" row hands to the tool (IEntityComponent.h). CEditTool::SetUserData
+//! takes a bare void* that must stay valid for as long as the row lives, and the row is rebuilt on
+//! every selection change - so the payloads live here, one per component instance, in a node-based
+//! container whose element addresses never move. Both fields are GUIDs, so a stale entry is inert:
+//! the tool re-resolves object and component through the managers on every use.
+static SEntityComponentEditToolTarget* GetComponentEditToolTarget(const CryGUID& objectGuid, const CryGUID& componentGuid)
+{
+	static std::map<CryGUID, SEntityComponentEditToolTarget> targets;
+
+	SEntityComponentEditToolTarget& target = targets[componentGuid];
+	target.objectGuid = objectGuid;
+	target.componentGuid = componentGuid;
+	return &target;
+}
