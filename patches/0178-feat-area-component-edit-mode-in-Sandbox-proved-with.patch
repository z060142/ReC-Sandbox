+
 bool CShapeEditTool::MouseCallback(CViewport* pView, EMouseEvent event, CPoint& point, int flags)
 {
-	// Stage 0: swallow nothing, so the viewport keeps behaving exactly as it does today.
+	IShapeComponentEdit* pEdit = ResolveShapeEdit();
+	if (pEdit == nullptr)
+		return false;
+
+	if (event != eMouseLDown && event != eMouseMove)
+		return false;
+
+	Vec3 raySrc, rayDir;
+	pView->ViewToWorldRay(point, raySrc, rayDir);
+	rayDir.Normalize();
+
+	// Nearest handle under the cursor, in the tolerance CEditShapeTool uses.
+	int   nearestPoint = -1;
+	float nearestDistance = FLT_MAX;
+
+	const int pointCount = pEdit->GetPointCount();
+	for (int i = 0; i < pointCount; ++i)
+	{
+		const Vec3  worldPos = GetPointWorldPos(i);
+		const float rayT = max(0.0f, rayDir.Dot(worldPos - raySrc));
+		const float distance = (raySrc + rayDir * rayT - worldPos).GetLength();
+
+		const float tolerance = kPointCloseDistance * pView->GetScreenScaleFactor(worldPos) * 0.01f + pView->GetSelectionTolerance();
+		if (distance <= tolerance && rayT < nearestDistance)
+		{
+			nearestDistance = rayT;
+			nearestPoint = i;
+		}
+	}
+
+	if (event == eMouseMove)
+	{
+		if (nearestPoint >= 0)
+			pView->SetCurrentCursor(STD_CURSOR_HIT);
+		else
+			pView->ResetCursor();
+
+		return false;
+	}
+
+	// eMouseLDown: select the handle under the cursor (or drop the selection), and put the
+	// construction plane on it so that a drag maps to the plane the user is looking at.
+	if (nearestPoint != m_selectedPoint)
+	{
+		m_selectedPoint = nearestPoint;
+		if (m_pManipulator != nullptr)
+			m_pManipulator->Invalidate();
+	}
+
+	if (m_selectedPoint >= 0)
+	{
+		Matrix34 constructionMatrix(IDENTITY);
+		constructionMatrix.SetTranslation(GetPointWorldPos(m_selectedPoint));
+		pView->SetConstructionMatrix(constructionMatrix);
+		return true;
+	}
+
+	return false;
+}
