+//! Picking for components that own geometry without owning a slot: the legacy path in
+//! HitTestEntity() needs an IStatObj / character / geom cache to answer, so a shape volume would
+//! never be clickable without this. Returns the nearest component hit in world-space distance.
+bool CEntityObject::HitTestEditorShapeComponents(HitContext& hc)
+{
+	if (m_pEntity == nullptr)
+	{
+		return false;
+	}
+
+	DynArray<IEditorShapeComponent*> editorShapeComponents;
+	m_pEntity->GetAllComponents(editorShapeComponents);
+	if (editorShapeComponents.empty())
+	{
+		return false;
+	}
+
+	// The same tolerance CShapeObject::HitTest uses, so a wireframe edge stays as clickable here as
+	// it is on a legacy shape object.
+	float tolerance = hc.distanceTolerance;
+	if (hc.view != nullptr)
+	{
+		tolerance += 0.8f * hc.view->GetScreenScaleFactor(GetWorldPos()) * 0.01f;
+	}
+
+	const Ray worldRay(hc.raySrc, hc.rayDir.GetNormalized());
+
+	bool  bHit = false;
+	float nearestDistance = FLT_MAX;
+
+	for (IEditorShapeComponent* pEditorShapeComponent : editorShapeComponents)
+	{
+		float distance;
+		if (pEditorShapeComponent != nullptr && pEditorShapeComponent->EditorHitTest(worldRay, tolerance, distance) && distance < nearestDistance)
+		{
+			nearestDistance = distance;
+			bHit = true;
+		}
+	}
+
+	if (bHit)
+	{
+		hc.dist = nearestDistance;
+		hc.object = this;
+	}
+
+	return bHit;
 }
 
