+void CShapeEditTool::OnManipulatorBeginDrag(IDisplayViewport* pView, ITransformManipulator*, const Vec2i&, int flags)
+{
+	if (GetIEditor()->GetLevelEditorSharedState()->GetEditMode() != CLevelEditorSharedState::EditMode::Move)
+		return;
