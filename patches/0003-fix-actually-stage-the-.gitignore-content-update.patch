From 71a87cb0a3eba893ccf8fbdc3ef3adac9e1f1267 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sat, 4 Jul 2026 21:34:15 +0800
Subject: [PATCH 03/33] fix: actually stage the .gitignore content update

The previous commit only staged the untracked-file removals; the
.gitignore edits themselves (agent-tool dirs, SDK zip rule, extra
log/user patterns) were never git-added and got reverted when
filter-repo reset the working tree to the last real commit.

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
---
 .gitignore | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/.gitignore b/.gitignore
index bf0e26a1..17bcb5b8 100644
--- a/.gitignore
+++ b/.gitignore
@@ -1,7 +1,17 @@
+# Agents
+.opencode/
+opencode.json
+.agents/
+.claude/
+.codex/
+
 # Asset files.
 *.pak
 *.caf
 
+# Large SDK archive - not needed in version control.
+/CRYENGINE_v5.7.0_SDKs.zip
+
 # Config files
 /user.cfg
 /system.cfg
@@ -10,6 +20,9 @@
 
 # Temporary files.
 *.log
+**/[Ll]og.txt
+**/[Ll]og *.txt
+**/[Ll]og([0-9]*).txt
 *.dmp
 *.pyo
 *.pyc
@@ -29,7 +42,9 @@ _WAF_/user_settings.options
 /.depproj/*
 /project.sln
 /[Ll]og[Bb]ackups
+**/[Ll]og[Bb]ackups/
 /[Uu]ser*/
+**/[Uu]ser*/
 __pycache__/*
 
 # Might contain a license key, so don't add it to a repo.
@@ -47,4 +62,4 @@ __pycache__/*
 /Engine/EngineAssets/**/*.dds
 
 # MSVC build artifact dropped in repo root by older toolchains.
-/vc140.pdb
\ No newline at end of file
+/vc140.pdb
-- 
2.47.1.windows.1

