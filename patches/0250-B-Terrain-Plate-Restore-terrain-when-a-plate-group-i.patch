--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
@@ -350,6 +350,12 @@ protected:
 	//! ENTITY_EVENT_DONE (the earliest point, with the entity and the terrain still whole), OnShutDown
 	//! (a component removed from a surviving entity) and the destructor (the backstop).
 	void  RestoreBakeOnTeardown();
+	//! P16. The teardown half of the ordered unwind: when live plates are stacked ON TOP of the footprint
+	//! this plate is handing back, the plain restore would write their relief into the ground as terrain
+	//! nobody owns (deleting a GROUP tears every member down in one frame, so nothing heals in between).
+	//! Runs RunBakeCascade over the survivors with this plate as the unwind-only member and returns true;
+	//! returns false when the plain restore is already correct, which is every single plate delete.
+	bool  RestoreBakeOnTeardownCascaded();
 	//! Captures the baseline, computes the block and writes it. Does nothing until the level is loaded.
 	void  ApplyBake();
 	//! Decals, shadows and navmesh over a footprint that just changed.
@@ -384,6 +390,10 @@ protected:
 	//! Every baking plate transitively connected to this one by an overlapping rect, this one included,
 	//! sorted by Bake Priority and then by entity GUID.
 	void  CollectBakeCascadeSet(std::vector<CTerrainPlateComponent*>& out) const;
+	//! The closure itself, seeded with rects rather than with a plate, so that a plate which is no longer
+	//! in the registry (a teardown) can still ask who is standing on the footprint it is giving back.
+	//! Appends to a pre-seeded out and sorts it; rects is grown as members join.
+	static void CollectBakeCascadeSetFromRects(std::vector<int>& rects, std::vector<CTerrainPlateComponent*>& out);
 	//! Cascade order: lower Bake Priority bakes first; ties by entity GUID, which is stable across loads.
 	bool  BakesBefore(const CTerrainPlateComponent& other) const;
 	//! ApplyBake for a plate that owns its footprint alone, the whole restore / re-bake cascade when it
@@ -392,7 +402,10 @@ protected:
 	//! The cascade driver itself, shared by ApplyBakeCascaded and the move batch: restore every member's
 	//! footprint in DESCENDING priority, regenerate and re-bake in ASCENDING priority, then refresh every
 	//! member's composite expectation. The set is sorted here, so callers only have to collect it.
-	static void RunBakeCascade(std::vector<CTerrainPlateComponent*>& affected, CTerrainPlateComponent* pSeed, const char* szReason);
+	//! pRemoved, when given, is a plate that is being torn down: it takes part in the ordered UNWIND but
+	//! is not re-baked afterwards. @see RestoreBakeOnTeardownCascaded.
+	static void RunBakeCascade(std::vector<CTerrainPlateComponent*>& affected, CTerrainPlateComponent* pSeed, const char* szReason,
+	                           CTerrainPlateComponent* pRemoved = nullptr);
 
 	// ------------------------------------------------------- move batch (P14: several plates at once)
 	//! Puts this plate on the list of plates whose move still owes a restore / re-bake, and pulls the
