@@ -291,7 +309,7 @@ CCineWheelControl::CCineWheelControl(const QString& title, float neutral, float
 
 	QHBoxLayout* pDiscRow = new QHBoxLayout();
 	pDiscRow->setContentsMargins(0, 0, 0, 0);
