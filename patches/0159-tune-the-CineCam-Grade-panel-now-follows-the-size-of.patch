--- a/Code/Sandbox/Plugins/CinematicCameraEditor/CineGradePanel.cpp
+++ b/Code/Sandbox/Plugins/CinematicCameraEditor/CineGradePanel.cpp
@@ -29,6 +29,10 @@ REGISTER_VIEWPANE_FACTORY_AND_MENU(CCineGradePanel, "CineCam Grade", "Tools", tr
 //! Must match CINECAM_ASSET_TYPE_LUT / CCineLutAssetType::GetTypeName().
 static const char* const kLutAssetType = "CineLut";
 
+//! Below this panel width the three wheels stop being three usable discs in a row and become three
+//! stamps, so they stack instead. One breakpoint is enough; there is no third arrangement.
+static const int kWheelRowMinWidth = 520;
+
 // ---------------------------------------------------------------------------
 // Construction
 // ---------------------------------------------------------------------------
@@ -116,16 +120,50 @@ QWidget* CCineGradePanel::BuildWheels()
 	Wire(m_pGain);
 
 	QGroupBox* pGroup = new QGroupBox(tr("Primaries"), this);
-	QHBoxLayout* pLayout = new QHBoxLayout();
-	pLayout->setContentsMargins(6, 6, 6, 6);
-	pLayout->addWidget(m_pLift);
-	pLayout->addWidget(m_pGamma);
-	pLayout->addWidget(m_pGain);
-	pLayout->addStretch(1);
-	pGroup->setLayout(pLayout);
+	m_pWheelLayout = new QGridLayout();
+	m_pWheelLayout->setContentsMargins(6, 6, 6, 6);
+	pGroup->setLayout(m_pWheelLayout);
+	// A grid rather than a row, because the same three cells are re-addressed on the breakpoint.
+	// No trailing stretch: the wheels are meant to take the width, not to sit in the left corner.
+	ApplyWheelLayout(false);
 	return pGroup;
 }
 
+void CCineGradePanel::ApplyWheelLayout(bool bStacked)
+{
+	if (m_pWheelLayout == nullptr)
+		return;
+
+	CCineWheelControl* const pWheels[3] = { m_pLift, m_pGamma, m_pGain };
+	for (int i = 0; i < 3; ++i)
+	{
+		m_pWheelLayout->removeWidget(pWheels[i]);
+		// The stretches of the arrangement being left behind would otherwise survive it.
+		m_pWheelLayout->setColumnStretch(i, 0);
+		m_pWheelLayout->setRowStretch(i, 0);
+	}
+
+	for (int i = 0; i < 3; ++i)
+	{
+		m_pWheelLayout->addWidget(pWheels[i], bStacked ? i : 0, bStacked ? 0 : i);
+		if (!bStacked)
+			m_pWheelLayout->setColumnStretch(i, 1);
+	}
+	if (bStacked)
+		m_pWheelLayout->setColumnStretch(0, 1);
+
+	m_wheelsStacked = bStacked;
+}
+
+void CCineGradePanel::resizeEvent(QResizeEvent* pEvent)
+{
+	CDockableEditor::resizeEvent(pEvent);
+
+	const bool bStacked = (width() < kWheelRowMinWidth);
+	if (bStacked != m_wheelsStacked)
+		ApplyWheelLayout(bStacked);
+}
