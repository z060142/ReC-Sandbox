 	desc.fPhase = DEG2RAD(floorf(RAD2DEG(desc.fPhase) + 0.5f));
 	desc.fIrisRadius = floorf(clamp_tpl(desc.fIrisRadius, 0.2f, 2.0f) * 20.0f + 0.5f) / 20.0f;
 	desc.fMaskRotation = DEG2RAD(floorf(RAD2DEG(desc.fMaskRotation) + 0.5f));
+
+	// The pupil scale is the one shape parameter that moves with the aperture ring, so it is
+	// quantised only in the range where it changes the pupil at all. The barrel sits at
+	// cos(pi/n)^exponent / p and the polygon's corners at 1: for p below cos(pi/n)^exponent the
+	// barrel is outside every corner and the pupil is the bare polygon, the same pupil for every
+	// value down there. All of it collapses onto that one boundary, so a normal aperture sweep -
+	// which lives there - never rebuilds the kernel, and only the last stop or so before wide
+	// open steps in 0.02. Uses the ALREADY QUANTISED blades and exponent, so the bucket is
+	// reproducible.
+	{
+		const float fCorner = powf(cosf(PI / max(desc.fBlades, 3.0f)), desc.fExponent);
+		const float p = clamp_tpl(desc.fPupilScale, 0.0f, 1.0f);
+		desc.fPupilScale = (p < fCorner - 0.02f) ? fCorner
+		                                        : floorf(p * 50.0f + 0.5f) / 50.0f;
+	}
 	desc.fKsa = floorf(clamp_tpl(desc.fKsa, -1.0f, 1.0f) * 20.0f + 0.5f) / 20.0f;
 	desc.fSaWaves = floorf(clamp_tpl(desc.fSaWaves, 0.0f, 2.0f) * 100.0f + 0.5f) / 100.0f;
 
@@ -370,6 +385,23 @@ void CDiffractionKernel::BuildJob()
 	const bool  bMask = !m_jobMaskPixels.empty() && m_jobMaskWidth > 0 && m_jobMaskHeight > 0;
 	const float fMaskBound = bMask ? min(m_jobDesc.fIrisRadius, 1.0f) : 1.0f;
 	const float fPolyRadius = bMask ? m_jobDesc.fIrisRadius / max(fMaskBound, 1e-3f) : 1.0f;
+	// The barrel is the round mechanical opening the blades retract INTO, and it does not move
+	// with the iris. p = N_open / N_geo is the polygon's size divided by the barrel's, so the
+	// barrel's radius is (the polygon's size) / p. "The polygon's size" is its INSCRIBED radius,
+	// where the blade edges are - NGon_Rad is normalised to the CIRCUMRADIUS, so that is
+	// cos(pi/n) raised to the shape exponent (which is 1 for a circle, i.e. curved blades that
+	// have no corners to hide are never clipped).
+	//
+	// Wide open (p = 1) the barrel disc therefore sits exactly on the blade edges and lies inside
+	// the polygon everywhere else: the intersection IS the circle, tangent to the edges at their
+	// midpoints, and a circular pupil diffracts into rings, not rays. Stop down and the polygon
+	// shrinks inside the barrel, its corners and flats emerge whole, and the rays appear. That is
+	// the other half of "sunstars appear when you stop down" - the first half being the lambda*N
+	// scale on the sensor. Below p = cos(pi/n)^exponent the barrel is past the corners and clips
+	// nothing at all, which is where a normal working aperture lives.
+	const float fPupilScale = max(clamp_tpl(m_jobDesc.fPupilScale, 0.0f, 1.0f), 1e-3f);
+	const float fBladeRadius = powf(cosf(PI / max(m_jobDesc.fBlades, 3.0f)), m_jobDesc.fExponent);
+	const float fBarrelRadius = fPolyRadius * fBladeRadius / fPupilScale;
 	const float fMaskCos = cosf(-m_jobDesc.fMaskRotation);
 	const float fMaskSin = sinf(-m_jobDesc.fMaskRotation);
 
