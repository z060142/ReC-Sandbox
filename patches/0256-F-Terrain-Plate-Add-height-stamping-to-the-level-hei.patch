+bool CTerrainPlateComponent::GetCommitFootprint(int& outX1, int& outY1, int& outSize) const
+{
+	// Only a plate that currently holds a bake in the engine terrain has something to commit: the editor
+	// reads the block straight back out of the terrain (research 12 section 0.4), so what it stamps is
+	// literally what the live bake wrote - the same batches, cascades and rim shape, not a recomputation.
+	if (!m_bBakeApplied || m_bBakeCommitted || m_bakeRectSize <= 0)
+		return false;
+
+	outX1 = m_bakeRectX1;
+	outY1 = m_bakeRectY1;
+	outSize = m_bakeRectSize;
+	return true;
+}
+
+float CTerrainPlateComponent::GetCommitWeightAtWorld(float /*worldX*/, float /*worldY*/) const
+{
+	// Step 2 (appearance stamp). Declared now so that adding it later does not move the vtable.
+	return 0.f;
+}
+
+bool CTerrainPlateComponent::GetCommitAlbedoAtWorld(float /*worldX*/, float /*worldY*/, ColorB& /*outColor*/) const
+{
+	// Step 2 (appearance stamp).
+	return false;
+}
+
+void CTerrainPlateComponent::OnCommitted()
+{
+	// ORDER MATTERS - decision 07 settled fact 8 / research 12 section 2.6. The committed ground has to
+	// become this plate's baseline BEFORE Bake Into Terrain goes off, or the untick that follows would run
+	// RestoreBakeBaseline and push the OLD ground back into the engine, where it would disagree with
+	// CHeightmap until the next whole map push.
+	if (!m_bakeResult.empty())
+	{
+		m_bakeBaseline = m_bakeResult;
+	}
+
+	// The disarm proper. m_bBakeApplied false is what makes the teardown a no-op: RestoreBakeBaseline,
+	// RestoreBakeOnTeardown and RestoreBakeOnTeardownCascaded are all gated on it, so deleting a committed
+	// plate leaves the ground exactly where the commit put it. The probes go with it - they exist to put
+	// the live bake back when somebody sculpts over it, and there is no live bake left to defend.
+	m_bBakeApplied = false;
+	m_bakeProbes.clear();
+	m_bakeReapplyCount = 0;
+	m_bakeBackoffFrames = 0;
+	m_bakeReapplyWindowStart = 0;
+
+	// Serialised, so the panel still says "committed" after a reload, and so a second commit is refused.
+	// Every path that could write the terrain again is gated on it as well (ApplyBake, the overlap
+	// cascade, the move batch), which is what makes a stale property panel harmless.
+	m_bBakeCommitted = true;
+	m_bBakeIntoTerrain = false;
+
+	if (m_pEntity != nullptr)
+	{
+		m_pEntity->UpdateComponentEventMask(this);
+	}
+
+	CryLog("TerrainPlate '%s': committed into the level heightmap. The live bake is off, and deleting the "
+	       "plate no longer restores the old ground. Undo puts the terrain back; untick Committed and "
+	       "re-tick Bake Into Terrain to resume the live bake.", GetPlateName());
+}
