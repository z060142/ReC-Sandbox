+//! Commit Bake, step 1: stamps the LIVE bake of every selected terrain plate into the level's own
+//! heightmap, so that the relief stops being a plate's runtime footprint and becomes ordinary terrain -
+//! saved in Heightmap.dat, pushed back into the engine on every load (CryEditDoc.cpp:122) and therefore
+//! there after the plate is deleted. Decision 07 step 1; the traced facts behind every line below are in
+//! research/12-commit-bake.md.
+//!
+//! The block is read straight back out of the live engine terrain rather than recomputed, which is what
+//! makes it the SAME block the bake produced: every batch, cascade, priority and rim shape that went into
+//! the live footprint is already in the ground. The loss is the engine's 12 bit per sector quantisation,
+//! a few mm, against the heightmap's own 1.6 cm save quantisation (research 12 section 0.4).
+static void PyCommitTerrainPlate()
+{
+	using Cry::DefaultComponents::CTerrainPlateComponent;
+	using Cry::DefaultComponents::ITerrainPlateCommit;
+
+	CHeightmap* pHeightmap = GetIEditorImpl()->GetHeightmap();
+	I3DEngine* p3DEngine = GetIEditorImpl()->Get3DEngine();
+	if (pHeightmap == nullptr || p3DEngine == nullptr || p3DEngine->GetITerrain() == nullptr)
+	{
+		CryWarning(VALIDATOR_MODULE_EDITOR, VALIDATOR_WARNING, "terrain.commit_plate: no terrain (is a level loaded?)");
+		return;
+	}
+
+	const CSelectionGroup* pSelection = GetIEditorImpl()->GetSelection();
+	if (pSelection == nullptr || pSelection->IsEmpty())
+	{
+		CryWarning(VALIDATOR_MODULE_EDITOR, VALIDATOR_WARNING,
+		           "terrain.commit_plate: nothing selected. Select the terrain plate entities to commit and run it again.");
+		return;
+	}
+
+	// The plates first, so that a refusal below can be reported before a single height is written.
+	std::vector<std::pair<IEntity*, CTerrainPlateComponent*>> plates;
+	for (int i = 0; i < pSelection->GetCount(); ++i)
+	{
+		CBaseObject* pObject = pSelection->GetObject(i);
+		if (pObject == nullptr || !pObject->IsKindOf(RUNTIME_CLASS(CEntityObject)))
+			continue;
+
+		IEntity* pEntity = static_cast<CEntityObject*>(pObject)->GetIEntity();
+		if (pEntity == nullptr)
+			continue;
+
+		IEntityComponent* pComponent = pEntity->GetComponentByTypeId(ITerrainPlateCommit::GetComponentTypeId());
+		if (pComponent == nullptr)
+			continue;
+
+		plates.emplace_back(pEntity, static_cast<CTerrainPlateComponent*>(pComponent));
+	}
+
+	if (plates.empty())
+	{
+		CryWarning(VALIDATOR_MODULE_EDITOR, VALIDATOR_WARNING,
+		           "terrain.commit_plate: no Terrain Plate component in the selection.");
+		return;
+	}
+
+	const float unitSize = pHeightmap->GetUnitSize();
+	// The heightmap is stored transposed against the world: heightmap X is the world Y unit and heightmap
+	// Y is the world X unit, with the linear index x + y * width (Heightmap.h:82,
+	// CHeightmap::WorldToHmap/HmapToWorld, Heightmap.cpp:557-566, and the same swap in every consumer -
+	// the sculpt brush at TerrainBrushTool.cpp:461-462, the texture painter at
+	// TerrainTexturePainter.cpp:691-692). The plate's own rect is in ENGINE units, which are not swapped
+	// (SetTerrainElevation reads pTerrainBlock[worldXunit * stride + worldYunit], terran_edit.cpp:266), so
+	// the mapping here is  hmapX = worldYunit,  hmapY = worldXunit.
+	const int hmapUnitsY = (int)pHeightmap->GetWidth();    // heightmap X axis: world Y
+	const int hmapUnitsX = (int)pHeightmap->GetHeight();   // heightmap Y axis: world X
+	if (unitSize <= 0.f || hmapUnitsX <= 0 || hmapUnitsY <= 0)
+	{
+		CryWarning(VALIDATOR_MODULE_EDITOR, VALIDATOR_WARNING, "terrain.commit_plate: the level has no usable heightmap.");
+		return;
+	}
+
+	const CTimeValue startTime = gEnv->pTimer->GetAsyncTime();
+	int committed = 0;
+
+	// One undo group for the whole run: Ctrl+Z puts the terrain of every committed plate back at once.
+	// The undo does NOT reach the components' Committed flag - it is runtime state, not a terrain edit -
+	// so an undo leaves disarmed plates over restored ground; the log line says how to re-arm them.
+	CUndo undo("Commit Terrain Plate");
+
+	for (const std::pair<IEntity*, CTerrainPlateComponent*>& entry : plates)
+	{
+		IEntity* pEntity = entry.first;
+		ITerrainPlateCommit* pCommit = entry.second;
+
+		int rectX1 = 0, rectY1 = 0, rectSize = 0;
+		if (!pCommit->GetCommitFootprint(rectX1, rectY1, rectSize))
+		{
+			CryWarning(VALIDATOR_MODULE_EDITOR, VALIDATOR_WARNING,
+			           "terrain.commit_plate: '%s' has no live bake to commit. Tick Bake Into Terrain first (or it is committed already).",
+			           pEntity->GetName());
+			continue;
+		}
+
+		// The engine block covers units rectX1 .. rectX1 + rectSize INCLUSIVE (terran_edit.cpp:264), so the
+		// square is rectSize + 1 cells on a side.
+		const int dim = rectSize + 1;
+		const int hx0 = rectY1;   // heightmap X, world Y
+		const int hy0 = rectX1;   // heightmap Y, world X
+		const int cols = min(dim, hmapUnitsY - hx0);   // along heightmap X
+		const int rows = min(dim, hmapUnitsX - hy0);   // along heightmap Y
+		if (cols <= 0 || rows <= 0)
+		{
+			CryWarning(VALIDATOR_MODULE_EDITOR, VALIDATOR_WARNING,
+			           "terrain.commit_plate: '%s' has its footprint off the heightmap, nothing written.", pEntity->GetName());
+			continue;
+		}
+
+		// Read the committed ground back out of the engine, and find the crest before anything is written.
+		std::vector<float> block((size_t)rows * cols, 0.f);
+		float blockMin = FLT_MAX;
+		float blockMax = -FLT_MAX;
+		for (int ux = 0; ux < rows; ++ux)      // along world X
+		{
+			for (int uy = 0; uy < cols; ++uy)  // along world Y
+			{
+				// GetTerrainZ is CTerrain::GetZ, which truncates to units and returns the stored node height
+				// with no interpolation; the half unit offset only defends against a float multiply landing
+				// just under the integer. Same sampler the plate's own baseline capture uses.
+				const float z = p3DEngine->GetTerrainZ(((float)(rectX1 + ux) + 0.5f) * unitSize,
+				                                       ((float)(rectY1 + uy) + 0.5f) * unitSize);
+				block[(size_t)ux * cols + uy] = z;
+				blockMin = min(blockMin, z);
+				blockMax = max(blockMax, z);
+			}
+		}
+
+		// THE showstopper check (research 12 section 0.5). CHeightmap::Serialize saves heights as
+		// uint16 scaled by 65535 / m_fMaxHeight and clamps to 0xFFFF (Heightmap.cpp:2682-2695), and a
+		// negative height wraps through the same clamp and comes back as the ceiling. Either way the level
+		// looks right until it is reloaded, which is the worst failure mode there is - so refuse, loudly,
+		// and write nothing.
+		const float maxHeight = pHeightmap->GetMaxHeight();
+		if (blockMax > maxHeight || blockMin < 0.f)
+		{
+			CryWarning(VALIDATOR_MODULE_EDITOR, VALIDATOR_ERROR,
+			           "terrain.commit_plate: REFUSED for '%s'. The committed ground spans %.2f .. %.2f m and the level's "
+			           "terrain range is 0 .. %.2f m (Max Height). Committing it would be silently flattened to %.2f m at the "
+			           "next save and reload. Raise Max Height in Terrain Editor > Modify, or lower the plate, and try again.",
+			           pEntity->GetName(), blockMin, blockMax, maxHeight, maxHeight);
+			continue;
+		}
+
+		pHeightmap->RecordUndo(hx0, hy0, cols, rows, /*bInfo*/ false);
+
+		// A cell the bake never moved reads back as the baseline plus at most one engine quantisation step,
+		// and the sector aligned square reaches well outside the plate. Writing those cells back would stamp
+		// that noise into a pristine heightmap for no gain, so a cell is only written when it moved by more
+		// than the readback is worth. The step is the coarsest one any touched sector can have
+		// (12 bits over the block's own span, terran_edit.cpp:281-286), with a floor for a flat block.
+		const float epsilon = max(0.0001f, (blockMax - blockMin) / 4095.f);
+
+		int cellsWritten = 0;
+		float minDelta = 0.f;
+		float maxDelta = 0.f;
+		for (int ux = 0; ux < rows; ++ux)
+		{
+			for (int uy = 0; uy < cols; ++uy)
+			{
+				const float z = block[(size_t)ux * cols + uy];
+				const float previous = pHeightmap->GetXY(hx0 + uy, hy0 + ux);
+				const float delta = z - previous;
+				if (fabsf(delta) <= epsilon)
+					continue;
+
+				pHeightmap->SetXY(hx0 + uy, hy0 + ux, z);
+				++cellsWritten;
+				minDelta = min(minDelta, delta);
+				maxDelta = max(maxDelta, delta);
+			}
+		}
+
+		// UpdateEngineTerrain ignores its 4th argument and always pushes a SQUARE of side areaSize snapped
+		// out to whole sectors (Heightmap.cpp:2461-2472), so it gets the larger of the two sides.
+		const int side = max(cols, rows);
+		pHeightmap->UpdateEngineTerrain(hx0, hy0, side, side, CHeightmap::ETerrainUpdateType::Elevation);
+		GetIEditorImpl()->GetTerrainManager()->SetModified(hx0, hy0, hx0 + cols, hy0 + rows);
+
+		AABB worldBox(Vec3((float)rectX1 * unitSize, (float)rectY1 * unitSize, blockMin - 1.f),
+		              Vec3((float)(rectX1 + rows) * unitSize, (float)(rectY1 + cols) * unitSize, blockMax + 1.f));
+		GetIEditorImpl()->UpdateViews(eUpdateHeightmap, &worldBox);
+
+		// The disarm, INSIDE the undo group and only now that the heights are in: the plate adopts the
+		// committed ground as its baseline before Bake Into Terrain goes off, so the untick that follows
+		// cannot write the old ground back (research 12 section 2.6).
+		pCommit->OnCommitted();
+		++committed;
+
+		CryLog("terrain.commit_plate: '%s' committed, %d of %d cells written, delta %.3f .. %.3f m, "
+		       "units (%d,%d)+%d, ground %.2f .. %.2f m of a %.2f m range",
+		       pEntity->GetName(), cellsWritten, rows * cols, minDelta, maxDelta,
+		       rectX1, rectY1, rectSize, blockMin, blockMax, maxHeight);
+	}
+
+	if (committed > 0)
+	{
+		p3DEngine->GetITerrain()->OnTerrainPaintActionComplete();
+		GetIEditorImpl()->SetModifiedFlag();
+	}
+
+	const float elapsedMs = (gEnv->pTimer->GetAsyncTime() - startTime).GetMilliSeconds();
+	CryLog("terrain.commit_plate: %d of %d selected plate(s) committed, %.1f ms. Save the level to keep it; "
+	       "undo restores the terrain but leaves the plates disarmed (untick Committed and re-tick Bake Into Terrain).",
+	       committed, (int)plates.size(), elapsedMs);
+}
+
