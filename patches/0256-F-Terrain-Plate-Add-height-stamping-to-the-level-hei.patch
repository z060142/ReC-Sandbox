+{
+
+//! Commit Bake (decision 07): the link the editor side of the commit needs into the terrain plate.
+//!
+//! Why an interface and not the component class: CHeightmap and CRGBLayer are SANDBOX_API, exported from
+//! Sandbox.exe, so the commit itself can only run inside EditorQt (research 12 section 6.0) - while
+//! CTerrainPlateComponent lives in an engine plugin that Sandbox never links. EditorQt already has the
+//! plugin's Module directory on its include path (Code/Sandbox/EditorQt/CMakeLists.txt:1508-1513), so it
+//! can see this header; every member below is pure virtual, so calling one costs a vtable slot and no
+//! link time symbol. The precedent is ILightComponent / LensFlareUtil.cpp:490-495.
+//!
+//! How the editor gets here from an IEntityComponent*: it includes TerrainPlateComponent.h and
+//! static_casts, exactly as Plugins/EditorParticle/EntityObjectWithParticleComponent.cpp:6/19 does with
+//! CParticleComponent (research 12 section 6.4). A downcast is a compile time pointer adjustment and the
+//! calls below are all virtual, so the include costs headers and no link time symbol. The two routes that
+//! do NOT work here and were tried first: a cross cast needs RTTI, which is off for every engine module
+//! (CommonMacros.cmake:629-636); and IEntityComponent::QueryInterface, the ICryUnknown door, is protected
+//! (IEntityComponent.h:314) and so cannot be called on an IEntityComponent* from outside. This interface
+//! also deliberately does not derive from IEntityComponent - the plate already reaches IEntityComponent
+//! through CBaseMeshComponent, and a second path would make that base ambiguous.
+//!
+//! Step 1 (height commit) only uses GetCommitFootprint and OnCommitted. The appearance stamp of step 2
+//! needs the other two, and they are declared now so that step 2 does not move the vtable under a build
+//! that has already shipped.
+struct ITerrainPlateCommit
+{
+	//! Type id of CTerrainPlateComponent, for IEntity::GetComponentByTypeId. Must stay in step with
+	//! CTerrainPlateComponent::ReflectType's desc.SetGUID.
+	static CryGUID GetComponentTypeId() { return "{3F1D8B4A-6C2E-4E9F-9A21-7B5C0D4E8A13}"_cry_guid; }
+
+	//! The sector aligned square the LIVE bake currently holds in the engine terrain, in terrain units:
+	//! outX1 along world X, outY1 along world Y, outSize the edge in units. The block itself covers
+	//! (outSize + 1)^2 cells, i.e. units outX1 .. outX1 + outSize inclusive, which is the range
+	//! ITerrain::SetTerrainElevation reads (terran_edit.cpp:264).
+	//! False when there is nothing to commit: no live bake, or the plate is committed already.
+	virtual bool  GetCommitFootprint(int& outX1, int& outY1, int& outSize) const = 0;
+
+	//! Step 2. smoothstep(t) * coverage at a world XY - the SAME rim curve the height bake used, so that
+	//! the colour edge sits exactly on the height edge. 0 outside the footprint.
+	virtual float GetCommitWeightAtWorld(float worldX, float worldY) const = 0;
+
+	//! Step 2. Albedo of the plate at a world XY, for the optional colour projection. False when the
+	//! plate has no usable projection (no material, or a material the CPU cannot sample).
+	virtual bool  GetCommitAlbedoAtWorld(float worldX, float worldY, ColorB& outColor) const = 0;
+
+	//! The editor has written the committed ground into CHeightmap: adopt it as this plate's baseline,
+	//! stop defending the footprint and stop restoring it on teardown. Called INSIDE the editor's undo
+	//! group, after the heights are written and before it is accepted.
+	virtual void  OnCommitted() = 0;
+
+protected:
+	~ITerrainPlateCommit() {}
+};
+
+}
+}
