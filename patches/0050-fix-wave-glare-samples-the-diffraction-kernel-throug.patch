+			CryLog("[BLOOM] diffraction glare amount=%.2f reach=%.2f disp=%.2f N=%.1f -> pitch=%.3f q-px/texel (%.1f texels/px) lod=%.1f of %.0f sprite=%.0f q-px (%.0f texels) core=%.2f deposited glare fraction=%.3f norm=%.3g",
 			       streakParams.fWaveAmount, streakParams.fWaveReach, streakParams.fDispersion,
-			       pDofStage->GetDiffractionNGeo(), fPitchQuarterPx, fRadiusQuarterPx, fSpriteRadiusTexels,
+			       pDofStage->GetDiffractionNGeo(), fPitchQuarterPx, 1.0f / fPitchQuarterPx, fLodRef, fMaxLod,
