diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DiffractionKernel.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DiffractionKernel.cpp
index 7efed2f6..3741b35b 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DiffractionKernel.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DiffractionKernel.cpp
@@ -520,12 +520,61 @@ void CDiffractionKernel::BuildJob()
 		}
 	}
 
+	// A PREFILTERED MIP CHAIN of the pattern, and the reason it exists is the whole point of the
+	// pass. The kernel's texel pitch on screen is lambda * N * d / L, a small FRACTION of a
+	// pixel: 0.23 native pixels at f/16, so a quarter-resolution pixel covers some seventeen
+	// kernel texels (a hundred at f/2.8). The rays themselves are one or two texels wide. One
+	// tap per pixel therefore lands on a ray about one time in seventeen and misses the pattern
+	// everywhere else - which is exactly what "no rays at all at f/16" looks like. The average
+	// energy was right; the sampling was not integrated. With the chain the shader picks the
+	// level whose texel IS the pixel's footprint and reads the footprint's mean in one tap.
+	//
+	// Filter the LINEAR intensity and encode afterwards, never the other way round: sqrt is not
+	// linear, so a box filter of sqrt(I) is not sqrt(mean I), and the pixel shader's k*k would
+	// then be systematically too dark. Level by level, k^2 is the mean intensity over the texel.
+	const int nMips = nLogL + 1;                     // L down to 1x1
+	size_t nTotalTexels = 0;
+	for (int m = 0; m < nMips; ++m)
+	{
+		const size_t w = (size_t)(L >> m);
+		nTotalTexels += w * w;
+	}
+
+	m_resultKernel.resize(nTotalTexels);
+	m_resultMipCount = nMips;
+
 	// sqrt encoding in both textures: the tails run down to 1e-8, which is below half float's
 	// denormals, and the square root lifts them to 1e-4 where R16F is exact. The pixel shader
 	// squares them back.
-	m_resultKernel.resize((size_t)L * L);
-	for (size_t i = 0; i < intensity.size(); ++i)
-		m_resultKernel[i] = CryConvertFloatToHalf(sqrtf(max(intensity[i], 0.0f)));
+	std::vector<float> level(std::move(intensity));   // level 0, linear
+	std::vector<float> coarser;
+	size_t nOffset = 0;
+	for (int m = 0; m < nMips; ++m)
+	{
+		const int w = L >> m;
+		for (size_t i = 0; i < (size_t)w * w; ++i)
+			m_resultKernel[nOffset + i] = CryConvertFloatToHalf(sqrtf(max(level[i], 0.0f)));
+		nOffset += (size_t)w * w;
+
+		if (m + 1 >= nMips)
+			break;
+
+		// Box 2x2 of the linear intensity: the mean of four means over equal areas IS the mean
+		// over their union, so every level stays the true footprint average.
+		const int hw = w >> 1;
+		coarser.resize((size_t)hw * hw);
+		for (int y = 0; y < hw; ++y)
+		{
+			for (int x = 0; x < hw; ++x)
+			{
+				coarser[(size_t)y * hw + x] = 0.25f * (level[(size_t)(2 * y) * w + (2 * x)]
+				                                       + level[(size_t)(2 * y) * w + (2 * x + 1)]
+				                                       + level[(size_t)(2 * y + 1) * w + (2 * x)]
+				                                       + level[(size_t)(2 * y + 1) * w + (2 * x + 1)]);
+			}
+		}
+		level.swap(coarser);
+	}
 
 	m_resultRing.resize((size_t)kRingBins);
 	double fRingMean = 0.0;
@@ -574,12 +623,19 @@ void CDiffractionKernel::Update(const char* szNameSuffix)
 void CDiffractionKernel::UploadResult(const char* szNameSuffix)
 {
 	const int L = m_jobDesc.nGridSize;
-	if (m_resultKernel.size() != (size_t)L * L || m_resultRing.size() != (size_t)kRingBins)
+	size_t nExpected = 0;
+	for (int m = 0; m < m_resultMipCount; ++m)
+	{
+		const size_t w = (size_t)(L >> m);
+		nExpected += w * w;
+	}
+
+	if (m_resultKernel.size() != nExpected || m_resultRing.size() != (size_t)kRingBins)
 		return;
 
 	// The grid size changing means new textures; everything else is a re-upload into the same
 	// two, which is what keeps a blade-rotation pull from churning resources.
-	if (m_pTexKernel && (m_pTexKernel->GetWidth() != L))
+	if (m_pTexKernel && (m_pTexKernel->GetWidth() != L || m_pTexKernel->GetNumMips() != m_resultMipCount))
 		ReleaseTextures();
 
 	const std::string suffix = szNameSuffix ? szNameSuffix : "";
@@ -587,7 +643,11 @@ void CDiffractionKernel::UploadResult(const char* szNameSuffix)
 	{
 		const std::string kernelName = "$DiffractionKernel" + suffix;
 		const std::string ringName = "$DiffractionRing" + suffix;
-		m_pTexKernel = CTexture::GetOrCreate2DTexture(kernelName.c_str(), L, L, 1, FT_DONT_STREAM | FT_NOMIPS,
+		// WITH mips, and therefore without FT_NOMIPS: the whole chain is uploaded here, level
+		// after level, and the sprite pass reads it with an explicit LOD. Both the creation path
+		// and UpdateTextureRegion walk a source buffer whose levels are consecutive, which is
+		// exactly how BuildJob laid it out.
+		m_pTexKernel = CTexture::GetOrCreate2DTexture(kernelName.c_str(), L, L, m_resultMipCount, FT_DONT_STREAM,
 		                                              (const byte*)m_resultKernel.data(), eTF_R16F);
 		m_pTexRing = CTexture::GetOrCreate2DTexture(ringName.c_str(), kRingBins, 1, 1, FT_DONT_STREAM | FT_NOMIPS,
 		                                            (const byte*)m_resultRing.data(), eTF_R16F);
@@ -606,6 +666,7 @@ void CDiffractionKernel::UploadResult(const char* szNameSuffix)
 
 	m_builtDesc = m_jobDesc;
 	m_bBuiltValid = true;
+	m_nKernelMips = m_pTexKernel->GetNumMips();
 	m_fRingRadius = (float)L * 0.5f - 2.0f;
 	m_fTexelPitchPupilUnits = 0.5f;      // d / L, and d is L/2 by construction
 	m_fTextureIntegral = m_resultIntegral;
@@ -622,6 +683,8 @@ void CDiffractionKernel::UploadResult(const char* szNameSuffix)
 	       m_builtDesc.maskName.empty() ? "none" : m_builtDesc.maskName.c_str(),
 	       RAD2DEG(m_builtDesc.fMaskRotation), m_builtDesc.fIrisRadius, m_builtDesc.fKsa,
 	       m_fCoreFraction, m_fTailCoefficient, 1.0f - m_fCoreFraction, L, m_resultJobMs);
+	CryLog("[BLOOM] diffraction kernel mip chain: %d levels (%d..1), %.0f KB", m_nKernelMips, L,
+	       (float)(m_resultKernel.size() * sizeof(uint16)) / 1024.0f);
 }
 
 void CDiffractionKernel::ReleaseTextures()
