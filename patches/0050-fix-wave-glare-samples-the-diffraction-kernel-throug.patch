 	prim.SetTexture(1, kernel.GetKernelTexture(), EDefaultResourceViews::Default, EShaderStage_Pixel);
 	prim.SetTexture(2, kernel.GetRingTexture(), EDefaultResourceViews::Default, EShaderStage_Pixel);
