+float CRendererResources::GetSceneReferredSkyPeakClamp(float sceneExposure)
+{
+	const float writerClamp = GetSceneReferredWriterClamp();
+
+	// Same stage-2 gate as the writer clamp, by construction: off the switch that returns 0 and
+	// so does this, which is what the sky shader reads as "stock NaN filter, unchanged".
+	if (!IsSceneReferredStage(2))
+		return 0.0f;
+
+	const float peakNits = max(CRenderer::CV_r_SceneReferredSkyPeakLuminance, 0.0f);
+	if (peakNits <= 0.0f)
+		return writerClamp;
+
+	// cd/m2 -> engine units -> exposed. Doing the pre-exposure HERE is the whole point: the
+	// resulting number moves with the aperture in exposed units precisely so that the physical
+	// luminance it stands for does NOT (research/s8-nishita-sky.md 5.5).
+	const float peakExposed = (peakNits / RENDERER_LIGHT_UNIT_SCALE) * max(sceneExposure, 0.0f);
+
+	return (writerClamp > 0.0f) ? min(peakExposed, writerClamp) : peakExposed;
+}
