-//! One undo step around one change to the link list, followed by the sync a viewport edit has to
-//! perform by hand (research/06 section 5): the Schematyc save snapshot, the property-changed
-//! event, the modified flag and the prefab.
-void CommitLinkChange(CBaseObject* pObject, IEntityComponent* pComponent, const char* szUndoName)
-{
-	IUndoManager* pUndoManager = GetIEditor()->GetIUndoManager();
-	if (pUndoManager != nullptr && !pUndoManager->IsUndoRecording())
-	{
-		pUndoManager->Begin();
-		if (pObject != nullptr)
-		{
-			pObject->StoreUndo(szUndoName);
-		}
-		pUndoManager->Accept(szUndoName);
-	}
-
-	AreaShapeTools::SyncEditedComponent(pObject, pComponent);
-
-	// The inspector shows the link list as a read-only row, so it has to be rebuilt to show the
-	// change; the property tree does not poll.
-	if (IObjectManager* pObjectManager = GetIEditor()->GetObjectManager())
-	{
-		pObjectManager->EmitPopulateInspectorEvent();
-	}
-}
