-//! The editor-facing half of the Area function component (scene-notes/area/decisions/03-area-runtime.md).
-//!
-//! An area's "links" - the entities that receive ENTERAREA / LEAVEAREA / AREAFADE - are authored by
-//! picking entities in the viewport, and there is no entity picker an engine component can put in
-//! the inspector: Serialization::EntityTarget and its property row live in EditorQt
-//! (Include/Serialization/Decorators/EntityLink.h), the same wall SEditToolButton stands behind.
-//! So the engine component stores the GUIDs and the editor plugin owns the picking, reaching the
-//! component through this interface.
-//!
-//! Like IShapeComponent it is a *reflected interface base*, and for the same reason: the lookup
-//! from EditorQt or from a Sandbox plugin is by reflected type GUID, not by RTTI. It derives from
-//! IEditorActionComponent (CryCommon/CryEntitySystem/IEntityComponent.h) rather than from
-//! IEntityComponent directly, because a second IEntityComponent base would make the
-//! entity-component base ambiguous and break the static_cast IEntity::GetAllComponents<>() does -
-//! exactly the reasoning written down in IShapeComponent.h.
-//!
-//! HEAP RULE, as in IShapeComponent.h: no STL container ever crosses this interface. An engine
-//! module allocates through CryModuleMalloc and a Sandbox editor plugin through the plain CRT
-//! heap, so a container filled on one side and freed on the other is silent corruption. Links are
-//! passed one CryGUID at a time.
-//!
-//! ABI: append-only. New virtuals go at the END and existing ones never change signature.
-
-#include <CryEntitySystem/IEntityComponent.h>
-#include <CrySchematyc/Reflection/TypeDesc.h>
-#include <CryExtension/CryGUID.h>
-
-namespace Cry
-{
-namespace AreaComponents
-{
-
-struct IAreaFunctionComponent : public IEditorActionComponent
-{
-	static void ReflectType(Schematyc::CTypeDesc<IAreaFunctionComponent>& desc)
-	{
-		desc.SetGUID("{B4E27C09-8A16-4D53-9C70-1F5D3E8A4602}"_cry_guid);
-		desc.SetLabel("Area");
-	}
-
-	//! How many link targets are authored on this area. Unresolved GUIDs count too - a link to an
-	//! entity in a layer that is not loaded yet is still a link.
-	virtual int     GetLinkCount() const = 0;
-
-	//! The entity GUID of link `index`, or a null GUID when the index is out of range. This is the
-	//! editor object's GUID (CBaseObject::GetId(), which becomes SEntitySpawnParams::guid), the
-	//! same identity the legacy <Area><Entities><Entity GUID=.../> node stores.
-	virtual CryGUID GetLink(int index) const = 0;
-
-	//! Append a link target. Returns false when the GUID is null or already linked, so the caller
-	//! can tell "nothing changed" from "added" and skip an empty undo step.
-	virtual bool    AddLinkTarget(const CryGUID& entityGuid) = 0;
-
-	//! Drop every link. Returns false when there was nothing to drop.
-	virtual bool    ClearLinks() = 0;
-};
-
-} // namespace AreaComponents
-} // namespace Cry
