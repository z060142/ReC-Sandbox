@@ -398,6 +398,7 @@ public:
 	static int CV_r_DofBokehQuality;
 	static int CV_r_DofSpriteBokehDebug;
 	static int CV_r_DofResolutionScale;
+	static float CV_r_DofSpriteBokehFadeCoC;
 	DeclareStaticConstIntCVar(CV_r_nohwgamma, 2);
 	DeclareStaticConstIntCVar(CV_r_wireframe, 0);
