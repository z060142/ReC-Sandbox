+
+// ---------------------------------------------------------------------------
+// The preset file
+// ---------------------------------------------------------------------------
+// Schematyc::Utils::SerializeClass is the same walk the entity inspector performs (CClassSerializer,
+// TypeDesc.inl:52-86): it visits the reflected members in AddMember order and calls each member
+// type's own serialize operator. Using it here rather than a hand-written mirror is the whole
+// reason a control added to the component next month lands in the preset for free - and the reason
+// the XML's element names are the component's member names, so the file is readable and pasteable.
+//
+// Note what the archive is NOT: it is not an edit archive, so the LMT slot's ResourceSelector
+// writes a plain string and the two action buttons in the preset slot write nothing at all
+// (ActionButton.h - Serialize returns false outside edit mode). A preset therefore never contains
+// a picker or a button, only values.
+void SGradePreset::Serialize(Serialization::IArchive& archive)
+{
+	archive(version, "Version", "Version");
+	archive(source, "Source", "Source");
+	Schematyc::Utils::SerializeClass<SCineGradeParams>(archive, &grade, "Grade", "Grade");
+	Schematyc::Utils::SerializeClass<SCineCurveParams>(archive, &curves, "Curves", "Curves");
+	Schematyc::Utils::SerializeClass<SCineLookParams>(archive, &look, "Look", "Look");
+}
+
+// ---------------------------------------------------------------------------
+// Paths
+// ---------------------------------------------------------------------------
+string SanitiseAssetName(const char* szName)
+{
+	string out;
+	for (const char* p = szName ? szName : ""; *p; ++p)
+	{
+		const char c = *p;
+		const bool bOk = (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')
+		                 || c == '_' || c == '-';
+		out += bOk ? c : '_';
+	}
+	if (out.empty())
+		out = "grade";
+	return out;
+}
+
+bool EnsureAssetFolder(const char* szRelFolder, string& outAbsFolder)
+{
+	if (!gEnv->pCryPak)
+		return false;
+
+	CryPathString resolved;
+	// FLAGS_FOR_WRITING sends this to the project's writable asset directory rather than to
+	// whichever pak or engine tree happens to hold a read-only copy - the same pair of flags the
+	// EXR exporter's ResolveCaptureFolder uses (SceneReferredExport.cpp:65).
+	gEnv->pCryPak->AdjustFileName(szRelFolder, resolved, ICryPak::FLAGS_PATH_REAL | ICryPak::FLAGS_FOR_WRITING);
+	if (resolved.empty())
+	{
+		CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING,
+		           "[cinecam] cannot resolve a writable path for '%s'", szRelFolder);
+		return false;
+	}
+
+	gEnv->pCryPak->MakeDir(resolved.c_str());
+	outAbsFolder = resolved.c_str();
+	return true;
+}
+
+// ---------------------------------------------------------------------------
+// The .cryasset sidecar
+// ---------------------------------------------------------------------------
+// The shape is fixed by AssetLoader::Metadata (Metadata.cpp:91-168) and is already in this
+// repository by hand for the .env we ship (Assets/Environment/ReC_Physical.env.cryasset). Written
+// with plain file I/O rather than through XmlNodeRef because it has to work identically in the
+// launcher, where no editor and no resource compiler exist.
+//
+// A fresh GUID every time: a .cryasset is per FILE, and two files that shared a guid would fight
+// in CAssetManager's guid map. Overwriting an existing sidecar therefore re-identifies the asset;
+// that is correct for the export case (the file's contents just changed) and is why this is not
+// called for files that already have one.
+bool WriteCryAssetSidecar(const char* szAbsDataFile, const char* szDataFileName, const char* szTypeName)
+{
+	const string sidecarPath = string(szAbsDataFile) + ".cryasset";
+
+	FILE* pFile = fopen(sidecarPath.c_str(), "wt");
+	if (!pFile)
+	{
+		CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING,
+		           "[cinecam] could not write the asset metadata '%s' - the file is on disk but the "
+		           "Asset Browser will not see it until you run Generate/Repair Metadata",
+		           sidecarPath.c_str());
+		return false;
+	}
+
+	const string guid = CryGUID::Create().ToString();
+	fprintf(pFile,
+	        "<AssetMetadata version=\"0\" type=\"%s\" guid=\"%s\" source=\"\" timestamp=\"0\">\n"
+	        " <Files>\n"
+	        "  <File path=\"%s\"/>\n"
+	        " </Files>\n"
+	        "</AssetMetadata>\n",
+	        szTypeName, guid.c_str(), szDataFileName);
+	fclose(pFile);
+	return true;
+}
+
+// ---------------------------------------------------------------------------
+// Save / load
+// ---------------------------------------------------------------------------
+bool SavePreset(const char* szRelPath, const SGradePreset& preset)
+{
+	if (!szRelPath || !szRelPath[0])
+		return false;
+
+	const string relFolder = PathUtil::GetPathWithoutFilename(szRelPath);
+	const string leaf = PathUtil::GetFile(szRelPath);
+
+	string absFolder;
+	if (!EnsureAssetFolder(relFolder.c_str(), absFolder))
+		return false;
+
+	const string absFile = PathUtil::Make(absFolder, leaf);
+
+	// The root node name is the type name, so that a person opening the file in a text editor is
+	// told what it is on line one.
+	if (!Serialization::SaveXmlFile(absFile.c_str(), preset, CINECAM_ASSET_TYPE_GRADE))
+	{
+		CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING,
+		           "[cinecam] could not write the grade preset '%s'", absFile.c_str());
+		return false;
+	}
+
+	WriteCryAssetSidecar(absFile.c_str(), leaf.c_str(), CINECAM_ASSET_TYPE_GRADE);
+	CryLogAlways("[cinecam] grade preset written: '%s'", absFile.c_str());
+	return true;
+}
+
+bool LoadPreset(const char* szRelPath, SGradePreset& preset)
+{
+	if (!szRelPath || !szRelPath[0])
+		return false;
+
+	// Deliberately NOT resolved by hand: LoadXmlFile goes through ICryPak, which expands %ENGINE%
+	// and maps into the asset root exactly like the .cube loader does, so a preset shipped in the
+	// engine tree resolves for a project that never copied it.
+	const int wanted = preset.version;
+	preset.version = 0;
+	if (!Serialization::LoadXmlFile(preset, szRelPath))
+	{
+		CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING,
+		           "[cinecam] grade preset '%s' could not be read (missing, or not a %s file)",
+		           szRelPath, CINECAM_ASSET_TYPE_GRADE);
+		preset.version = wanted;
+		return false;
+	}
+
+	if (preset.version > kPresetVersion)
+	{
+		CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING,
+		           "[cinecam] grade preset '%s' is version %d and this build understands %d - not "
+		           "applied. Nothing on the component was changed.",
+		           szRelPath, preset.version, kPresetVersion);
+		return false;
+	}
+
+	return true;
+}
+
+// ---------------------------------------------------------------------------
+// cinecam_ImportGradeAssets - the capture path's outputs, adopted into the asset tree
+// ---------------------------------------------------------------------------
+// The EXR exporter writes a take's .cdl / .curve_master.cube / .curves.txt beside the frames, under
+// %USER% (SceneReferredExport.cpp:55-68). That is where a take belongs and it is deliberately not
+// the asset tree: an EXR sequence is not an asset and every take would litter the browser. This
+// command is the explicit step that says "this one is worth keeping": it copies the grade files -
+// never the frames - into Assets/cinecam/{cdl,luts} and writes their sidecars.
+namespace
+{
+
+bool CopyFileTo(const char* szSrcAbs, const char* szDstAbs)
+{
+	FILE* pIn = fopen(szSrcAbs, "rb");
+	if (!pIn)
+		return false;
+
+	FILE* pOut = fopen(szDstAbs, "wb");
+	if (!pOut)
+	{
+		fclose(pIn);
+		return false;
+	}
+
+	char buffer[64 * 1024];
+	size_t nRead = 0;
+	bool bOk = true;
+	while ((nRead = fread(buffer, 1, sizeof(buffer), pIn)) > 0)
+	{
+		if (fwrite(buffer, 1, nRead, pOut) != nRead)
+		{
+			bOk = false;
+			break;
+		}
+	}
+
+	fclose(pOut);
+	fclose(pIn);
+	return bOk;
+}
+
+void CmdImportGradeAssets(IConsoleCmdArgs* pArgs)
+{
+	if (!gEnv->pCryPak)
+		return;
+
+	// Default: the EXR exporter's own default folder, which is where a take just went.
+	const char* szFolder = (pArgs && pArgs->GetArgCount() > 1) ? pArgs->GetArg(1) : "CaptureEXR";
+
+	string folder = szFolder;
+	folder.replace('\\', '/');
+	const bool bAbsolute = (folder.size() > 1 && folder[1] == ':') || folder[0] == '/';
+	if (!bAbsolute)
+		folder = string("%USER%/") + folder;
+
+	CryPathString srcFolder;
+	gEnv->pCryPak->AdjustFileName(folder.c_str(), srcFolder, ICryPak::FLAGS_PATH_REAL);
+	if (srcFolder.empty())
+	{
+		CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING,
+		           "[cinecam] cinecam_ImportGradeAssets: cannot resolve '%s'", szFolder);
+		return;
+	}
+
+	string absCdl, absLut;
+	if (!EnsureAssetFolder(CINECAM_FOLDER_CDL, absCdl) || !EnsureAssetFolder(CINECAM_FOLDER_LUTS, absLut))
+		return;
+
+	int nCopied = 0;
+	_finddata_t fd;
+	const intptr_t handle = gEnv->pCryPak->FindFirst(string(srcFolder.c_str()) + "/*.*", &fd, ICryPak::FLAGS_PATH_REAL);
+	if (handle != -1)
+	{
+		do
+		{
+			if (fd.attrib & _A_SUBDIR)
+				continue;
+
+			const string name = fd.name;
+			const string ext = PathUtil::GetExt(name.c_str());
+
+			const char* szType = nullptr;
+			const char* szDstFolder = nullptr;
+			if (stricmp(ext.c_str(), "cdl") == 0)
+			{
+				szType = CINECAM_ASSET_TYPE_CDL;
+				szDstFolder = absCdl.c_str();
+			}
+			else if (stricmp(ext.c_str(), "cube") == 0)
+			{
+				szType = CINECAM_ASSET_TYPE_LUT;
+				szDstFolder = absLut.c_str();
+			}
+			else
+			{
+				// .curves.txt is documentation for the pair above; it travels with them but it is
+				// not an asset type of its own (nothing picks a .txt).
+				continue;
+			}
+
+			const string src = PathUtil::Make(string(srcFolder.c_str()), name);
+			const string dst = PathUtil::Make(string(szDstFolder), name);
+			if (!CopyFileTo(src.c_str(), dst.c_str()))
+			{
+				CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING,
+				           "[cinecam] could not copy '%s' to '%s'", src.c_str(), dst.c_str());
+				continue;
+			}
+
+			WriteCryAssetSidecar(dst.c_str(), name.c_str(), szType);
+			CryLogAlways("[cinecam] imported '%s' -> '%s' (%s)", name.c_str(), dst.c_str(), szType);
+			++nCopied;
+		}
+		while (gEnv->pCryPak->FindNext(handle, &fd) >= 0);
+
+		gEnv->pCryPak->FindClose(handle);
+	}
+
+	// The .curves.txt of a take carries the chain order and the exact axis definition, so it is
+	// worth having beside the two files it explains - copied without a sidecar, on purpose.
+	if (nCopied > 0)
+	{
+		_finddata_t fdTxt;
+		const intptr_t h2 = gEnv->pCryPak->FindFirst(string(srcFolder.c_str()) + "/*.curves.txt", &fdTxt, ICryPak::FLAGS_PATH_REAL);
+		if (h2 != -1)
+		{
+			do
+			{
+				if (fdTxt.attrib & _A_SUBDIR)
+					continue;
+				CopyFileTo(PathUtil::Make(string(srcFolder.c_str()), string(fdTxt.name)).c_str(),
+				           PathUtil::Make(absCdl, string(fdTxt.name)).c_str());
+			}
+			while (gEnv->pCryPak->FindNext(h2, &fdTxt) >= 0);
+			gEnv->pCryPak->FindClose(h2);
+		}
+	}
+
+	if (nCopied == 0)
+	{
+		CryLogAlways("[cinecam] cinecam_ImportGradeAssets: nothing to import from '%s' (looked for "
+		             "*.cdl and *.cube)", srcFolder.c_str());
+	}
+	else
+	{
+		CryLogAlways("[cinecam] cinecam_ImportGradeAssets: %d file(s) imported from '%s'. They are "
+		             "assets now - the Asset Browser picks them up on its next scan.",
+		             nCopied, srcFolder.c_str());
+	}
+}
+
+} // anonymous namespace
+
+void RegisterGradeAssetCommands()
+{
+	REGISTER_COMMAND("cinecam_ImportGradeAssets", CmdImportGradeAssets, VF_NULL,
+	                 "cinecam_ImportGradeAssets [folder]\n"
+	                 "Copy the .cdl and .cube files a capture wrote (default: the CaptureEXR folder "
+	                 "under %USER%) into " CINECAM_FOLDER_CDL " and " CINECAM_FOLDER_LUTS ", with "
+	                 "the .cryasset metadata that makes them pickable.");
+}
+
+void RemoveGradeAssetCommands()
+{
+	if (gEnv->pConsole)
+		gEnv->pConsole->RemoveCommand("cinecam_ImportGradeAssets");
+}
