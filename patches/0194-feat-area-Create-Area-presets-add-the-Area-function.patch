From 819c85b4991f3e88a850ae2cb4b169a7262ee39a Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Fri, 11 Sep 2026 23:55:11 +0800
Subject: [PATCH 194/209] feat(area): Create -> Area presets add the Area
 function

Create -> Area -> Box / Sphere / Polygon now spawn the shape AND the Area
function component, because "an area" is what the user asked for when they
picked that menu entry. A bare shape is still one Add Component away, and the
Spline preset deliberately gets nothing: a spline is a path, not a volume.

CShapeCreateTool gains one virtual, GetFunctionComponentGuid(), defaulting to
"none" so that no existing preset changes behaviour by inheritance. Box and
Sphere override it directly; Polygon gets a three-line subclass registered as
"EditTool.AreaPolygonCreate", which its class desc now names, because the base
class IS the polygon tool and the spline tool derives from it.

The component is added exactly the way CEntityObjectWithComponent adds the
shape - CreateComponentByInterfaceID plus the UserAdded flag, which is what
makes it serialize and show in the inspector - and inside the creation's own
undo transaction, so one Ctrl+Z still removes the whole entity rather than
half of it.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../Objects/AreaShapeObjectClassDescs.cpp     |  2 +-
 .../Tools/ShapeCreateTool.cpp                 | 57 +++++++++++++++++++
 .../Tools/ShapeCreateTool.h                   | 10 ++++
 .../Tools/ShapeDragCreateTool.h               |  8 ++-
 4 files changed, 74 insertions(+), 3 deletions(-)

diff --git a/Code/Sandbox/Plugins/AreaComponentsEditor/Objects/AreaShapeObjectClassDescs.cpp b/Code/Sandbox/Plugins/AreaComponentsEditor/Objects/AreaShapeObjectClassDescs.cpp
index abb4a598..d223e8f4 100644
--- a/Code/Sandbox/Plugins/AreaComponentsEditor/Objects/AreaShapeObjectClassDescs.cpp
+++ b/Code/Sandbox/Plugins/AreaComponentsEditor/Objects/AreaShapeObjectClassDescs.cpp
@@ -89,7 +89,7 @@ public:
 	virtual CRuntimeClass* GetRuntimeClass() override          { return Private_AreaShapeObjectClassDescs::GetEntityWithComponentRuntimeClass(); }
 	virtual const char*    GetFileSpec() override              { return Private_AreaShapeObjectClassDescs::szPolygonShapeComponentGuid; }
 	virtual const char*    GetDataFilesFilterString() override { return ""; }
-	virtual const char*    GetToolClassName() override         { return "EditTool.AreaShapeCreate"; }
+	virtual const char*    GetToolClassName() override         { return "EditTool.AreaPolygonCreate"; }
 
 	virtual bool IsCreatedByListEnumeration() override { return false; }
 
diff --git a/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.cpp b/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.cpp
index 474ac2ce..9256fee5 100644
--- a/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.cpp
+++ b/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.cpp
@@ -30,6 +30,9 @@ const float kMinPointSpacing = 0.01f;
 const int kMaxDrawPoints = 1024;
 }
 
+//! CAreaFunctionComponent::ReflectType, CryPlugins/AreaComponents/Module/Functions/AreaFunctionComponent.h.
+const char* const szAreaFunctionComponentGuid = "6C3A81D5-0F47-4E9A-B4D1-72E5C8A96210";
+
 class CShapeCreateTool_ClassDesc : public IClassDesc
 {
 	virtual ESystemClassID SystemClassID() override   { return ESYSTEM_CLASS_EDITTOOL; }
@@ -42,6 +45,34 @@ REGISTER_CLASS_DESC(CShapeCreateTool_ClassDesc);
 
 IMPLEMENT_DYNCREATE(CShapeCreateTool, CEditTool);
 
+//! "Create Object -> Area -> Polygon": the same draw gesture, but the entity ends up with the Area
+//! function component beside the shape, because that is what "an area" means to the user. The bare
+//! polygon shape stays reachable through Add Component.
+class CAreaPolygonCreateTool : public CShapeCreateTool
+{
+	DECLARE_DYNCREATE(CAreaPolygonCreateTool)
+
+public:
+	CAreaPolygonCreateTool() = default;
+
+protected:
+	virtual ~CAreaPolygonCreateTool() = default;
+
+	virtual const char* GetFunctionComponentGuid() const override { return szAreaFunctionComponentGuid; }
+};
+
+class CAreaPolygonCreateTool_ClassDesc : public IClassDesc
+{
+	virtual ESystemClassID SystemClassID() override   { return ESYSTEM_CLASS_EDITTOOL; }
+	virtual const char*    ClassName() override       { return "EditTool.AreaPolygonCreate"; }
+	virtual const char*    Category() override        { return "Area"; }
+	virtual CRuntimeClass* GetRuntimeClass() override { return RUNTIME_CLASS(CAreaPolygonCreateTool); }
+};
+
+REGISTER_CLASS_DESC(CAreaPolygonCreateTool_ClassDesc);
+
+IMPLEMENT_DYNCREATE(CAreaPolygonCreateTool, CShapeCreateTool);
+
 CShapeCreateTool::CShapeCreateTool()
 {
 }
@@ -140,6 +171,32 @@ bool CShapeCreateTool::StartCreation(const Vec3& worldPos)
 		return false;
 	}
 
+	// The preset's function component, if it has one. Added exactly the way
+	// CEntityObjectWithComponent adds the shape itself (EntityObjectWithComponent.cpp:22-40) -
+	// UserAdded is what makes it serialize and show up in the inspector - and inside the same undo
+	// transaction, so one Ctrl+Z removes the whole entity, not half of it.
+	if (const char* szFunctionComponentGuid = GetFunctionComponentGuid())
+	{
+		const CryGUID functionGuid = CryGUID::FromString(szFunctionComponentGuid);
+
+		if (IEntity* pEntity = pObject->GetIEntity())
+		{
+			if (!functionGuid.IsNull() && pEntity->QueryComponentByInterfaceID(functionGuid) == nullptr)
+			{
+				if (IEntityComponent* pFunctionComponent = pEntity->CreateComponentByInterfaceID(functionGuid, false))
+				{
+					pFunctionComponent->GetComponentFlags().Add(EEntityComponentFlags::UserAdded);
+				}
+				else
+				{
+					CryWarning(VALIDATOR_MODULE_EDITOR, VALIDATOR_WARNING,
+					           "Create Shape: the function component %s could not be added - the shape was created without it.",
+					           szFunctionComponentGuid);
+				}
+			}
+		}
+	}
+
 	m_bCreating = true;
 
 	SeedShape();
diff --git a/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.h b/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.h
index 6d857659..8082b7d1 100644
--- a/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.h
+++ b/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.h
@@ -50,6 +50,16 @@ protected:
 	//! The object class the tool creates. A subclass changes this to serve another shape kind.
 	virtual const char* GetObjectClassName() const { return "AreaShapePolygon"; }
 
+	//! A FUNCTION component the tool adds beside the shape, as a GUID string in the form
+	//! CryGUID::ToString() writes. Null (the default) adds nothing, which is what a preset that
+	//! means "a bare shape" wants - and what the spline preset wants, because a spline is a path
+	//! and has no area volume.
+	//!
+	//! The Create -> Area -> Box / Sphere / Polygon presets return the Area function component
+	//! here, because "an area" is what the user asked for when they picked that menu entry; a
+	//! pure shape is still one Add Component away.
+	virtual const char* GetFunctionComponentGuid() const { return nullptr; }
+
 	//! Fewest points the finished shape must have, or the draw counts as cancelled. A kind with a
 	//! fixed point set (box, sphere) has nothing to count and answers 0.
 	virtual int  GetMinPointCount() const { return 3; }
diff --git a/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeDragCreateTool.h b/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeDragCreateTool.h
index 06a1199d..26b8c376 100644
--- a/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeDragCreateTool.h
+++ b/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeDragCreateTool.h
@@ -76,7 +76,9 @@ public:
 protected:
 	virtual ~CShapeBoxCreateTool() = default;
 
-	virtual const char* GetObjectClassName() const override { return "AreaShapeBox"; }
+	virtual const char* GetObjectClassName() const override        { return "AreaShapeBox"; }
+	//! CAreaFunctionComponent - Create -> Area -> Box makes an AREA, not a bare box.
+	virtual const char* GetFunctionComponentGuid() const override  { return "6C3A81D5-0F47-4E9A-B4D1-72E5C8A96210"; }
 	virtual void        SizeToDrag(const Vec3& anchorWorld, const Vec3& worldPos, bool bDefaultSize) override;
 
 private:
@@ -101,7 +103,9 @@ public:
 protected:
 	virtual ~CShapeSphereCreateTool() = default;
 
-	virtual const char* GetObjectClassName() const override { return "AreaShapeSphere"; }
+	virtual const char* GetObjectClassName() const override        { return "AreaShapeSphere"; }
+	//! CAreaFunctionComponent - Create -> Area -> Sphere makes an AREA, not a bare sphere.
+	virtual const char* GetFunctionComponentGuid() const override  { return "6C3A81D5-0F47-4E9A-B4D1-72E5C8A96210"; }
 	virtual void        SizeToDrag(const Vec3& anchorWorld, const Vec3& worldPos, bool bDefaultSize) override;
 
 private:
