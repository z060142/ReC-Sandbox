From ea4e55aed86bcdfe223f8e9c9b8211b76c592778 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 2 Sep 2026 11:24:57 +0800
Subject: [PATCH 288/307] !B (3DEngine) Preserve the terrain sector height
 quantizer when possible.

Reuse a sector's height offset and range when rewritten values remain within
its quantization envelope. First writes and values outside the envelope retain
the existing range derivation path.
---
 Code/CryEngine/Cry3DEngine/terran_edit.cpp | 42 ++++++++++++++++++----
 1 file changed, 36 insertions(+), 6 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/terran_edit.cpp b/Code/CryEngine/Cry3DEngine/terran_edit.cpp
index 5b58b8be..96a16f29 100644
--- a/Code/CryEngine/Cry3DEngine/terran_edit.cpp
+++ b/Code/CryEngine/Cry3DEngine/terran_edit.cpp
@@ -241,7 +241,10 @@ void CTerrain::SetTerrainElevation(int X1, int Y1, int nSizeX, int nSizeY, float
 
 			SRangeInfo& ri = pTerrainNode->m_rangeInfo;
 
-			if (ri.nSize != nMaxStep / nStep + 1)
+			// A freshly allocated sector has no quantiser worth keeping (see the sticky block below).
+			const bool bFreshHMData = (ri.nSize != nMaxStep / nStep + 1);
+
+			if (bFreshHMData)
 			{
 				delete[] ri.pHMData;
 				ri.nSize = nMaxStep / nStep + 1;
@@ -282,15 +285,34 @@ void CTerrain::SetTerrainElevation(int X1, int Y1, int nSizeX, int nSizeY, float
 				}
 			}
 
+			const float fBlockMin = fMin;
+
 			// reserve some space for in-game deformations
 			fMin = max(0.f, fMin - TERRAIN_DEFORMATION_MAX_DEPTH);
 
-			pTerrainNode->m_bHMDataIsModified = (ri.fOffset != fMin);
+			// Keep the sector's existing quantiser when the new block still fills its envelope end to end.
+			// Re-deriving it slides fOffset down by fmod(reserve, fRange) every write, so a caller that rewrites
+			// heights it just read out (bake restore, sculpt/undo) sags the whole sector a little per cycle.
+			// Both ends must be within one step, which keeps the deformation reserve and the resolution intact.
+			const float fEnvMax = ri.fOffset + float(0x0FFF) * ri.fRange;
+			const bool bStickyRange = !bFreshHMData && ri.pHMData && ri.fRange > 0.f
+			                          && fBlockMin >= ri.fOffset
+			                          && fabs_tpl(fMin - ri.fOffset) <= ri.fRange
+			                          && fabs_tpl(fMax - fEnvMax) <= ri.fRange;
+
+			if (bStickyRange)
+			{
+				pTerrainNode->m_bHMDataIsModified = false;
+			}
+			else
+			{
+				pTerrainNode->m_bHMDataIsModified = (ri.fOffset != fMin);
 
-			ri.fOffset = fMin;
-			ri.fRange = (fMax - fMin) / float(0x0FFF);
+				ri.fOffset = fMin;
+				ri.fRange = (fMax - fMin) / float(0x0FFF);
+			}
 
-			pTerrainNode->m_boxHeigtmapLocal.min.Set((float)((x1 - x0) * unitSize), (float)((y1 - y0) * unitSize), fMin);
+			pTerrainNode->m_boxHeigtmapLocal.min.Set((float)((x1 - x0) * unitSize), (float)((y1 - y0) * unitSize), ri.fOffset);
 			pTerrainNode->m_boxHeigtmapLocal.max.Set((float)((x2 - x0) * unitSize), (float)((y2 - y0) * unitSize), max(fMax, GetWaterLevel()));
 
 			for (int x = x1; x <= x2; x += nStep)
@@ -301,7 +323,15 @@ void CTerrain::SetTerrainElevation(int X1, int Y1, int nSizeX, int nSizeY, float
 					int ylocal = (y - y1) / nStep;
 					int nCellLocal = xlocal * ri.nSize + ylocal;
 
-					uint32 height = ri.fRange ? int((rawHeightmap[nCellLocal] - fMin) / ri.fRange) : 0;
+					// Truncating a height this same quantiser produced can land one step short, because
+					// fOffset + k*fRange does not divide back to exactly k in float. The sticky path must be
+					// bit exact, so it rounds and clamps; the re-derived path truncates as it always did.
+					uint32 height = 0;
+					if (ri.fRange)
+					{
+						const float fSteps = (rawHeightmap[nCellLocal] - ri.fOffset) / ri.fRange;
+						height = bStickyRange ? (uint32)CLAMP(int(fSteps + 0.5f), 0, 0x0FFF) : (uint32)int(fSteps);
+					}
 
 					SHeightMapItem nNewValue;
 					nNewValue.height = height;
-- 
