+	const bool bSkyRayUnclamped = (linearMaxDepth >= 0.999f);
 	distanceEnd = (!bSkyRayUnclamped && distanceTarget < distanceEnd && distanceFar > distanceTarget) ? distanceTarget : distanceEnd;
 
 	// intersection with ocean or horizon to stop ray-marching under the horizon.
@@ -2517,6 +2525,20 @@ void RenderCloudCS(uint3 GroupID : SV_GroupID,
 	}
 
 
+	// ReCS edge fade (decisions/s9-cloud-edge.md, 2026-09-09): whatever ends a SKY ray's march - the
+	// max viewable distance, the max ray-march length - does so with a hard boundary in elevation.
+	// Fade the pass's contribution out over the last kilometres of marched segment so the cloud
+	// region's sky blends into the plain sky below instead of stepping. Sky rays only: a ray that
+	// stops on geometry keeps its full contribution (the cloud in front of a mountain is real).
+	{
+		const float fadeLength = 4000.0f;
+		const float edgeFade = (linearMaxDepth >= 0.999f && maxStepNum != 0.0f) ? saturate((distanceEnd - distanceStart) / fadeLength) : 1.0f;
+		inscatter.xyz *= edgeFade;
+		transmittance = lerp(1.0f, transmittance, edgeFade);
+		cloudColorMinDepth.xyz *= edgeFade;
+		cloudColorMinDepth.w = lerp(1.0f, cloudColorMinDepth.w, edgeFade);
+	}
+
 	// write the frontmost depth of cloud
 	float cloudDepth = (maxStepNum == 0.0) ? 0.0f : distanceToDepth * distanceStart; // outputs 0 as empty flag.
 	cloudDepth = cloudDepth * reciprocalFarClipDist;
