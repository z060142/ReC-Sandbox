+			cry_sprintf(str, "  clouds [on] x%.4g: sun %.4g  sky %.4g  atmos-sun %.4g  zenith haze %.4g exposed (%+.1f stops vs grey)  sky rays past ZF + edge fade %s (ReCS, all cameras)  | Rayleigh k %.3g/m unexposed by design",
