@@ -129,6 +129,19 @@ void CAreaComponent::ProcessEvent(const SEntityEvent& event)
 		bool const bIsAudioListener = (m_triggeringObjects == ETriggeringObjects::AudioListeners && (pIEntity->GetFlagsExtended() & ENTITY_FLAG_EXTENDED_AUDIO_LISTENER) != 0);
 		bool const bIsAreaTriggeringEntity = (m_triggeringObjects == ETriggeringObjects::Entities && (pIEntity->GetFlags() & ENTITY_FLAG_TRIGGER_AREAS) != 0);
 
+		// All six CArea events carry the area's HOST entity in nParam[2] (Area.cpp, EnterArea /
+		// LeaveArea / EnterNearArea / LeaveNearArea and the two "move" senders; for MOVEINSIDEAREA
+		// it is the LOW area, with the high one in nParam[3]). The SetPos() calls below move this
+		// entity onto the listener or onto the area hull, which is correct while the emitter and
+		// the area live on two different, linked entities - the only arrangement legacy content
+		// produces. When the area is hosted by THIS entity (the Area function component of
+		// CryPlugins/AreaComponents attaches its host to its own area so that this component works
+		// unmodified on the same entity) the same call is a feedback loop: moving the entity moves
+		// the area, which produces a new event, which moves it again. Comparing the two ids is the
+		// cheapest correct test and can never fire for legacy content.
+		bool const bAreaIsSelf = (static_cast<EntityId>(event.nParam[2]) == m_pEntity->GetId());
+		bool const bMoveSelf = bIsAudioListener && !bAreaIsSelf;
+
 		if (bIsAudioListener || bIsAreaTriggeringEntity)
 		{
