diff --git a/Code/CryEngine/CryEntitySystem/EntityAudioProxy.cpp b/Code/CryEngine/CryEntitySystem/EntityAudioProxy.cpp
index a28c205e..bd7dbf1c 100644
--- a/Code/CryEngine/CryEntitySystem/EntityAudioProxy.cpp
+++ b/Code/CryEngine/CryEntitySystem/EntityAudioProxy.cpp
@@ -95,6 +95,25 @@ void CEntityComponentAudio::OnListenerMoveNear(Vec3 const& closestPointToArea)
 	m_pEntity->SetPos(closestPointToArea);
 }
 
+//////////////////////////////////////////////////////////////////////////
+bool CEntityComponentAudio::IsSelfHostedArea(SEntityEvent const& event) const
+{
+	// All six CArea events carry the area's HOST entity in nParam[2] (Area.cpp, EnterArea /
+	// LeaveArea / EnterNearArea / LeaveNearArea / the two "move" senders, and the cached-event
+	// replay). The four OnListener* handlers above move THIS entity onto the area's hull so that
+	// the audio emitter follows the listener; that is right while the emitter and the area live on
+	// two different, linked entities - which is the only arrangement legacy content produces,
+	// because CArea::AddEntity is never called with the area's own entity there.
+	//
+	// A component that hosts its own area and attaches itself to it (the BoidsProxy pattern, and
+	// what the Area function component of CryPlugins/AreaComponents does so that these audio
+	// components keep working unmodified on the same entity) turns that into a feedback loop:
+	// moving this entity moves the area with it, which produces a new near event, which moves it
+	// again. Comparing the two ids is the cheapest correct test - no entity lookup, no walk of the
+	// area's attached list - and it cannot fire for legacy content, where the two are never equal.
+	return m_pEntity != nullptr && static_cast<EntityId>(event.nParam[2]) == m_pEntity->GetId();
+}
