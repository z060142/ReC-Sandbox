From 6bca6a9769fbd466cfc9bc676dc8cb2004d493dc Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Thu, 10 Sep 2026 11:43:07 +0800
Subject: [PATCH 155/174] fix: a grade preset shipped in the engine tree
 resolves too

LoadXmlFile goes through ICryPak but, unlike the .cube loader's OpenLutFile, does not try
%ENGINE% by itself, so a preset installed only in the engine tree was unreadable. Second
attempt with the alias prefix, matching the two-tree promise every other file of this
chain makes.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01ADgAiBYv9AxSd54s1FPREm
---
 .../CinematicCamera/Module/CineGradeAsset.cpp         | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/Code/CryPlugins/CinematicCamera/Module/CineGradeAsset.cpp b/Code/CryPlugins/CinematicCamera/Module/CineGradeAsset.cpp
index 68730d0a..3876a04f 100644
--- a/Code/CryPlugins/CinematicCamera/Module/CineGradeAsset.cpp
+++ b/Code/CryPlugins/CinematicCamera/Module/CineGradeAsset.cpp
@@ -148,12 +148,15 @@ bool LoadPreset(const char* szRelPath, SGradePreset& preset)
 	if (!szRelPath || !szRelPath[0])
 		return false;
 
-	// Deliberately NOT resolved by hand: LoadXmlFile goes through ICryPak, which expands %ENGINE%
-	// and maps into the asset root exactly like the .cube loader does, so a preset shipped in the
-	// engine tree resolves for a project that never copied it.
+	// Serialization::LoadXmlFile goes through ISystem::LoadXmlFromFile and therefore through
+	// ICryPak, so the path as given resolves relative to the project's asset directory - but,
+	// unlike the .cube loader's OpenLutFile, it does NOT try %ENGINE% by itself. The second
+	// attempt is here so that a preset shipped in the engine tree reaches a project that never
+	// copied it, which is the same two-tree promise every other file of this chain makes.
 	const int wanted = preset.version;
 	preset.version = 0;
-	if (!Serialization::LoadXmlFile(preset, szRelPath))
+	if (!Serialization::LoadXmlFile(preset, szRelPath)
+	    && !Serialization::LoadXmlFile(preset, (string("%ENGINE%/") + szRelPath).c_str()))
 	{
 		CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING,
 		           "[cinecam] grade preset '%s' could not be read (missing, or not a %s file)",
-- 
