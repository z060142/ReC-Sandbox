From 7c2283b168aeadec102a23e2f8cca516a40f62da Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sun, 30 Aug 2026 16:17:11 +0800
Subject: [PATCH 210/307] !B (3DEngine) Preserve vertical faces on integrated
 geometry.

The terrain-grid degeneracy check treated equal XY coordinates as invalid and
discarded vertical faces copied from objects. Exempt triangles whose vertices
carry the integrated-geometry marker.
---
 .../Cry3DEngine/terrain_sector_render.cpp     | 19 +++++++++++++++----
 1 file changed, 15 insertions(+), 4 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp b/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
index aa55c1d9..a2f8be7f 100644
--- a/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
+++ b/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
@@ -1037,10 +1037,21 @@ void CTerrainNode::GenerateIndicesForAllSurfaces(IRenderMesh* pRM, int arrpNonBo
 				continue;
 
 			// skip safety border triangles
-			CryHalf2 xy0 = ((SVF_P2S_N4B_C4B_T1F*)pPosPtr)[arrTriangle[0]].xy;
-			CryHalf2 xy1 = ((SVF_P2S_N4B_C4B_T1F*)pPosPtr)[arrTriangle[1]].xy;
-			CryHalf2 xy2 = ((SVF_P2S_N4B_C4B_T1F*)pPosPtr)[arrTriangle[2]].xy;
-			if (xy0 == xy1 || xy0 == xy2 || xy1 == xy2)
+			const SVF_P2S_N4B_C4B_T1F* pVerts = (SVF_P2S_N4B_C4B_T1F*)pPosPtr;
+			CryHalf2 xy0 = pVerts[arrTriangle[0]].xy;
+			CryHalf2 xy1 = pVerts[arrTriangle[1]].xy;
+			CryHalf2 xy2 = pVerts[arrTriangle[2]].xy;
+
+			// Vertices copied in by AppendTrianglesFromObjects carry normal.bcolor[3] == 0, genuine
+			// terrain vertices carry 255 (SetVertexNormal). For the terrain grid, equal sector local
+			// half-float XY means a degenerate skirt triangle; for integrated object geometry it just
+			// means a vertical face, which is exactly what a rock or a plate edge is made of. Exempt
+			// fully integrated triangles from the filter so their vertical walls survive.
+			const bool bIntegratedTriangle = (pVerts[arrTriangle[0]].normal.bcolor[3] == 0)
+			                                 && (pVerts[arrTriangle[1]].normal.bcolor[3] == 0)
+			                                 && (pVerts[arrTriangle[2]].normal.bcolor[3] == 0);
+
+			if (!bIntegratedTriangle && (xy0 == xy1 || xy0 == xy2 || xy1 == xy2))
 			{
 				continue;
 			}
