+// Film halation.
+//
+// Light from a source bright enough to overload the emulsion passes through it, reflects off
+// the film base and re-exposes the emulsion from behind. The red-sensitive layer sits deepest,
+// so the re-exposure reads red-orange; it is much wider than the core itself and its edge is
+// soft. Halation is a property of the FILM STOCK, not of the lens, so unlike the diffraction
+// streaks nothing here follows the f-number.
+//
+// Runs after ExecuteStreaks so the two quarter resolution HDR scratch targets are free again,
+// and blends into $HDRFinalBloom through the same bloom-weight compensation the streaks use.
+void CBloomStage::ExecuteHalation()
+{
+	if (!CRenderer::CV_r_HDRHalation)
+		return;
+
+	CHDRHalation* pHalationTech = static_cast<CHDRHalation*>(PostEffectMgr()->GetEffect(EPostEffectID::HDRHalation));
+	if (pHalationTech == nullptr)
+		return;
+
+	SHDRHalationParams halationParams = pHalationTech->GetParams();
+
+	// r_HDRHalation 2: diagnostic force mode - full strength, low threshold, wide halo,
+	// independent of any game code driving the params.
+	if (CRenderer::CV_r_HDRHalation == 2)
+	{
+		halationParams.fAmount = 1.0f;
+		halationParams.fThreshold = 0.5f;
+		halationParams.fRadius = 0.7f;
+	}
+
+	if (halationParams.fAmount < 0.001f)
+		return;
+
+	PROFILE_LABEL_SCOPE("HDR_HALATION");
+
+	static CCryNameTSCRC techStreakThreshold("HDRStreakThreshold");
+	static CCryNameTSCRC techStreakStretch("HDRStreakStretch");
+	static CCryNameR streakParams0Name("StreakParams0");
+	static CCryNameR streakParams1Name("StreakParams1");
+	static CCryNameR streakParams2Name("StreakParams2");
+
+	CTexture* pHalationSource = m_graphicsPipelineResources.m_pTexHDRTargetScaled[1][1];
+	CTexture* pHalationTemp = m_graphicsPipelineResources.m_pTexHDRTargetScaled[1][0];
+
+	const float fTexelScaleX = 1.0f / (float)pHalationSource->GetWidth();
+	const float fTexelScaleY = 1.0f / (float)pHalationSource->GetHeight();
+
+	// Same bloom-weight divide as the streaks: the tone mapper blends the bloom target in with
+	// weight bloomAmount * 0.3 / 8, so anything added here inherits that crush and has to have
+	// it divided back out to keep a constant on-screen energy.
+	Vec4 vHDRSetupParams[5];
+	gEnv->p3DEngine->GetHDRSetupParams(vHDRSetupParams);
+	const float fBloomCompositeWeight = clamp_tpl(vHDRSetupParams[1].x / 8.0f, 0.0005f, 1.0f);
+
+	const float fRadius01 = clamp_tpl(halationParams.fRadius, 0.0f, 1.0f);
+
+	// 1. Threshold into the scratch target. Same soft knee (a quarter of the threshold) as the
+	//    streaks: wide enough to stop sources popping between frames, far too narrow to catch
+	//    a merely bright sky - which is exactly the point, a sky must not halate.
+	if (m_passHalationThreshold.IsDirty())
+	{
+		m_passHalationThreshold.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passHalationThreshold.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passHalationThreshold.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakThreshold, 0);
+		m_passHalationThreshold.SetRenderTarget(0, pHalationSource);
+		m_passHalationThreshold.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A);
+		m_passHalationThreshold.SetTexture(0, m_graphicsPipelineResources.m_pTexHDRTargetScaled[0][0]);
+		m_passHalationThreshold.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passHalationThreshold.BeginConstantUpdate();
+	m_passHalationThreshold.SetConstant(streakParams1Name, Vec4(halationParams.fThreshold, max(halationParams.fThreshold * 0.25f, 0.01f), 0, 0), eHWSC_Pixel);
+	m_passHalationThreshold.Execute();
+
+	// 2. Wide separable spread, horizontal then vertical, through the streak stretch shader
+	//    with an isotropic (unrotated) direction. That shader's tap stride is what actually
+	//    sets the halo's width: CGaussianBlurPass cannot, because its 16 bilinear taps are
+	//    pinned to +-8 texels no matter how large its distribution gets. At radius 0.5 the
+	//    stride is 7 quarter-res texels, so the 7 taps per side reach 49 texels ~ 196 full-res
+	//    pixels on a 1080p frame, for a halo sigma of about 27 texels ~ 109 pixels. The bloom
+	//    core next to it sits at roughly 24 pixels, so the halo reads about four times wider.
+	const float fSpreadStride = 2.0f + 10.0f * fRadius01;
+	// Near-flat per tap decay: emulsion scatter has no sharp falloff, and a flat weight set
+	// puts the mass out at the far taps, which is where the halo has to be seen.
+	const float fSpreadDecay = 0.90f;
+
+	for (int axis = 0; axis < 2; ++axis)
+	{
+		const bool bHorizontal = (axis == 0);
+		CFullscreenPass& pass = bHorizontal ? m_passHalationSpreadH : m_passHalationSpreadV;
+
+		if (pass.IsDirty())
+		{
+			pass.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+			pass.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+			pass.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakStretch, 0);
+			pass.SetRenderTarget(0, bHorizontal ? pHalationTemp : pHalationSource);
+			pass.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A);
+			pass.SetTexture(0, bHorizontal ? pHalationSource : pHalationTemp);
+			pass.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+		}
+
+		pass.BeginConstantUpdate();
+		pass.SetConstant(streakParams0Name, Vec4(bHorizontal ? fTexelScaleX : 0.0f, bHorizontal ? 0.0f : fTexelScaleY, fSpreadStride, 1.0f), eHWSC_Pixel);
+		pass.SetConstant(streakParams1Name, Vec4(0, 0, fSpreadDecay, 0), eHWSC_Pixel);
+		// Untinted here - the stock's colour is applied once, on the composite.
+		pass.SetConstant(streakParams2Name, Vec4(1.0f, 1.0f, 1.0f, 0.0f), eHWSC_Pixel);
+		pass.Execute();
+	}
+
+	// 3. Round the profile off. The spread above lands 15 discrete taps per axis, which on a
+	//    small source shows as a cross of ticks; a couple of narrow Gaussian passes smear the
+	//    gaps between them into the soft continuous edge halation actually has. The
+	//    distribution is the Gaussian's rho in texels over a FIXED +-8 texel footprint, so it
+	//    only controls the SHAPE: below ~3 the kernel is too peaked to fill the tap gaps,
+	//    above ~8 it is flat enough to be a box and hands back a hard edge. 3 -> 8 across the
+	//    radius range keeps it inside that band.
+	const float fDistribution = 3.0f + 5.0f * fRadius01;
+
+	for (int iteration = 0; iteration < kHalationBlurIterations; ++iteration)
+		m_passHalationBlur.Execute(pHalationSource, pHalationTemp, 1.0f, fDistribution, false);
+
+	// 4. Composite into the bloom target. The stretch shader is reused with a ZERO step, so all
+	//    15 taps land on the same texel and the normalised sum is a plain tinted sample.
+	//
+	//    The energy conserving blur spreads a source over thousands of texels, which leaves the
+	//    halo far dimmer per pixel than the core it came from - correct as physics, invisible in
+	//    practice. The gain below puts it back at the strength an overloaded frame really shows,
+	//    so amount 1 is an obvious red-orange glow rather than a hint of one.
+	const float fHalationGain = 8.0f;
+	const float fOutputScale = halationParams.fAmount * fHalationGain / fBloomCompositeWeight;
+	const Vec4 vTint(halationParams.vTint.x, halationParams.vTint.y, halationParams.vTint.z, 0.0f);
+
+	if (m_passHalationComposite.IsDirty())
+	{
+		m_passHalationComposite.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passHalationComposite.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passHalationComposite.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakStretch, 0);
+		m_passHalationComposite.SetRenderTarget(0, m_graphicsPipelineResources.m_pTexHDRFinalBloom);
+		m_passHalationComposite.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A | GS_BLSRC_ONE | GS_BLDST_ONE);
+		m_passHalationComposite.SetTexture(0, pHalationSource);
+		m_passHalationComposite.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passHalationComposite.BeginConstantUpdate();
+	m_passHalationComposite.SetConstant(streakParams0Name, Vec4(0.0f, 0.0f, 0.0f, fOutputScale), eHWSC_Pixel);
+	m_passHalationComposite.SetConstant(streakParams1Name, Vec4(0, 0, 1.0f, 0), eHWSC_Pixel);
+	m_passHalationComposite.SetConstant(streakParams2Name, vTint, eHWSC_Pixel);
+	m_passHalationComposite.Execute();
+}
