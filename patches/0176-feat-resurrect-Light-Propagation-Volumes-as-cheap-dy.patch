+namespace
+{
+// Thread group sizes, must match the ones declared in Engine/Shaders/HWScripts/CryFX/LPV.cfi.
+const int32 LPVGridTileSize = 4;
+const int32 LPVInjectTileSize = 8;
+const int32 LPVApplyTileSize = 8;
+
+const ETEX_Format LPVGridFormat = eTF_R16G16B16A16F;
+const ETEX_Format LPVRsmFormat = eTF_R8G8B8A8;
+const ETEX_Format LPVIrradianceFormat = eTF_R16G16B16A16F;
+
+uint32 lpvDispatchSize(int32 size, int32 tileSize)
+{
+	return (uint32)((size / tileSize) + ((size % tileSize) > 0 ? 1 : 0));
+}
+}
+
+CLPVStage::CLPVStage(CGraphicsPipeline& graphicsPipeline)
+	: CGraphicsPipelineStage(graphicsPipeline)
+	, m_pIrradiance(nullptr)
+	, m_pRsmColor(nullptr)
+	, m_pRsmNormal(nullptr)
+	, m_passClear(&graphicsPipeline, CComputeRenderPass::eFlags_ReflectConstantBuffersFromShader)
+	, m_passInject(&graphicsPipeline, CComputeRenderPass::eFlags_ReflectConstantBuffersFromShader)
+	, m_passResolve(&graphicsPipeline, CComputeRenderPass::eFlags_ReflectConstantBuffersFromShader)
+	, m_passApply(&graphicsPipeline, CComputeRenderPass::eFlags_ReflectConstantBuffersFromShader)
+	, m_gridOrigin(ZERO)
+	, m_cellSize(1.0f)
+	, m_gridSize(0)
+	, m_rsmSize(0)
+	, m_rsmSampleCount(0)
+	, m_rsmSampleStride(1)
+	, m_finalGridIndex(0)
+	, m_accIndex(0)
+	, m_prevGridOrigin(ZERO)
+	, m_bHistoryValid(false)
+	, m_bResultValid(false)
+{
+	m_rsmToWorld.SetIdentity();
+
+	for (auto& pass : m_passPropagate)
+	{
+		pass.SetFlags(CComputeRenderPass::eFlags_ReflectConstantBuffersFromShader);
+		pass.SetGraphicsPipeline(&graphicsPipeline);
+	}
+
+	for (auto& pass : m_passTemporal)
+	{
+		pass.SetFlags(CComputeRenderPass::eFlags_ReflectConstantBuffersFromShader);
+		pass.SetGraphicsPipeline(&graphicsPipeline);
+	}
+
+	for (auto& gridSet : m_pGridSH)
+		std::fill(std::begin(gridSet), std::end(gridSet), nullptr);
+	for (auto& gridSet : m_pGridAcc)
+		std::fill(std::begin(gridSet), std::end(gridSet), nullptr);
+
+	// The RSM texture objects have to exist before CShadowMapStage::Init() runs, which happens before
+	// CLPVStage::Init(). The device resources are created on demand in GetRsmColorMap()/GetRsmNormalMap().
+	std::string texName = "LPV_SUN_RSM_COLOR" + m_graphicsPipeline.GetUniqueIdentifierName();
+	m_pRsmColor = CTexture::GetOrCreateTextureObjectPtr(texName.c_str(), 0, 0, 1, eTT_2D, FT_STATE_CLAMP, LPVRsmFormat);
+
+	texName = "LPV_SUN_RSM_NORMAL" + m_graphicsPipeline.GetUniqueIdentifierName();
+	m_pRsmNormal = CTexture::GetOrCreateTextureObjectPtr(texName.c_str(), 0, 0, 1, eTT_2D, FT_STATE_CLAMP, LPVRsmFormat);
+}
+
+int32 CLPVStage::GetValidGridSize()
+{
+	int32 size = CRendererCVars::CV_r_LPVGridSize;
+
+	// The volume depth is limited by CTexture::CreateTextureArray and has to be a multiple of 4.
+	size = clamp_tpl(size, 8, 64);
+	size = size - (size % 4);
+
+	return size;
+}
+
+void CLPVStage::Init()
+{
+	const uint32 commonFlags = FT_NOMIPS | FT_DONT_STREAM;
+	const uint32 uavFlags = commonFlags | FT_USAGE_UNORDERED_ACCESS;
+
+	// Only create the texture objects here, the device resources are allocated by ResizeGrid()/Resize().
+	for (int32 i = 0; i < 2; ++i)
+	{
+		for (int32 c = 0; c < SHChannelNum; ++c)
+		{
+			CRY_ASSERT(m_pGridSH[i][c] == nullptr);
+			std::string texName = "$LPVGridSH" + std::to_string(i) + std::to_string(c) + m_graphicsPipeline.GetUniqueIdentifierName();
+			m_pGridSH[i][c] = CTexture::GetOrCreateTextureObjectPtr(texName.c_str(), 0, 0, 0, eTT_3D, uavFlags, LPVGridFormat);
+
+			CRY_ASSERT(m_pGridAcc[i][c] == nullptr);
+			texName = "$LPVGridAcc" + std::to_string(i) + std::to_string(c) + m_graphicsPipeline.GetUniqueIdentifierName();
+			m_pGridAcc[i][c] = CTexture::GetOrCreateTextureObjectPtr(texName.c_str(), 0, 0, 0, eTT_3D, uavFlags, LPVGridFormat);
+		}
+	}
+
+	CRY_ASSERT(m_pIrradiance == nullptr);
+	std::string texName = "$LPVIrradiance" + m_graphicsPipeline.GetUniqueIdentifierName();
+	m_pIrradiance = CTexture::GetOrCreateTextureObjectPtr(texName.c_str(), 0, 0, 1, eTT_2D, uavFlags, LPVIrradianceFormat);
+
+	ResizeGrid(GetValidGridSize());
+}
+
+void CLPVStage::ResizeGrid(int32 gridSize)
+{
+	const uint32 commonFlags = FT_NOMIPS | FT_DONT_STREAM;
+	const uint32 uavFlags = commonFlags | FT_USAGE_UNORDERED_ACCESS;
+
+	auto createTexture3D = [=](CTexture* pTex) -> void
+	{
+		if (pTex != nullptr
+		    && (gridSize != pTex->GetDepth()
+		        || !CTexture::IsTextureExist(pTex)
+		        || pTex->Invalidate(gridSize, gridSize, LPVGridFormat)))
+		{
+			pTex->Create3DTexture(gridSize, gridSize, gridSize, 1, uavFlags, nullptr, LPVGridFormat);
+			if (pTex->GetFlags() & FT_FAILED)
+				CryFatalError("Couldn't allocate texture.");
+		}
+	};
+
+	for (auto& gridSet : m_pGridSH)
+	{
+		for (auto& pTex : gridSet)
+			createTexture3D(pTex);
+	}
+	for (auto& gridSet : m_pGridAcc)
+	{
+		for (auto& pTex : gridSet)
+			createTexture3D(pTex);
+	}
+
+	const uint32 elementCount = gridSize * gridSize * gridSize * AccumulatorStride;
+	if (elementCount != m_injectionBuffer.GetElementCount() || m_injectionBuffer.GetDevBuffer() == nullptr)
+	{
+		m_injectionBuffer.Create(elementCount, sizeof(int32), DXGI_FORMAT_R32_SINT,
+		                         CDeviceObjectFactory::BIND_SHADER_RESOURCE | CDeviceObjectFactory::BIND_UNORDERED_ACCESS, nullptr);
+	}
+
+	m_gridSize = gridSize;
+	m_bHistoryValid = false;
+	m_bResultValid = false;
+}
+
+void CLPVStage::Resize(int renderWidth, int renderHeight)
+{
+	const uint32 uavFlags = FT_NOMIPS | FT_DONT_STREAM | FT_USAGE_UNORDERED_ACCESS;
+
+	if (m_pIrradiance != nullptr
+	    && (!CTexture::IsTextureExist(m_pIrradiance)
+	        || m_pIrradiance->Invalidate(renderWidth, renderHeight, LPVIrradianceFormat)))
+	{
+		m_pIrradiance->Create2DTexture(renderWidth, renderHeight, 1, uavFlags, nullptr, LPVIrradianceFormat);
+		if (m_pIrradiance->GetFlags() & FT_FAILED)
+			CryFatalError("Couldn't allocate texture.");
+	}
+
+	m_bResultValid = false;
+}
+
+void CLPVStage::OnCVarsChanged(const CCVarUpdateRecorder& cvarUpdater)
+{
+	if (cvarUpdater.GetCVar("r_LPVGridSize"))
+	{
+		const int32 gridSize = GetValidGridSize();
+		if (gridSize != m_gridSize)
+			ResizeGrid(gridSize);
+	}
+}
+
+CTexture* CLPVStage::GetIrradianceRT() const
+{
+	// The CVar check is required: when the stage is toggled off Execute() is not called anymore, so
+	// m_bResultValid would keep the value of the last active frame and the stale result would stay
+	// applied forever.
+	return (CRendererCVars::CV_r_LPV > 0 && m_bResultValid && CTexture::IsTextureExist(m_pIrradiance)) ? m_pIrradiance.get() : nullptr;
+}
+
+bool CLPVStage::IsSvoProvidingRsm() const
+{
+#if defined(FEATURE_SVO_GI)
+	return CSvoRenderer::IsActive();
+#else
+	return false;
+#endif
+}
+
+bool CLPVStage::IsRsmFrustum(const ShadowMapFrustum& rFr) const
+{
+	if (CRendererCVars::CV_r_LPV <= 0 || IsSvoProvidingRsm())
+		return false;
+
+	// Directional sun cascades only, the local light / shadow pool RSM path stays owned by SVOGI.
+	// IsDynamicGsmCascade() also accepts e_GsmDynamicDistance, which cascades become when the
+	// shadow cascade cache (r_ShadowsCache) is enabled.
+	return !rFr.bUseShadowsPool
+	       && rFr.IsDynamicGsmCascade()
+	       && rFr.nShadowMapLod == CRendererCVars::CV_r_LPVCascadeLod
+	       && rFr.nShadowMapSize > 0;
+}
+
+void CLPVStage::CheckCreateUpdateRsmTarget(_smart_ptr<CTexture>& pTex, int32 size, const char* szName)
+{
+	if (!CTexture::IsTextureExist(pTex) || pTex->GetWidth() != size || pTex->GetHeight() != size)
+	{
+		// NOTE: SPostEffectsUtils::GetOrCreateRenderTarget adds a reference when !CTexture::IsTextureExist
+		const bool bNeedsDecRef = !CTexture::IsTextureExist(pTex);
+
+		CTexture* pTexRaw = pTex;
+		if (SD3DPostEffectsUtils::GetOrCreateRenderTarget(szName, pTexRaw, size, size, Clr_Transparent, 0, false, LPVRsmFormat))
+		{
+			pTex = pTexRaw;
+			pTex->DisableMgpuSync();
+
+			if (bNeedsDecRef)
+				pTex->Release();
+		}
+	}
+}
+
+CTexture* CLPVStage::GetRsmColorMap(const ShadowMapFrustum& rFr, bool bCheckUpdate)
+{
+#if defined(FEATURE_SVO_GI)
+	// Never fight SVOGI over the single sun RSM pass slot.
+	if (CSvoRenderer::GetRsmColorMap(m_graphicsPipeline, rFr))
+		return nullptr;
+#endif
+
+	if (!IsRsmFrustum(rFr))
+		return nullptr;
+
+	if (bCheckUpdate)
+	{
+		const std::string texName = "LPV_SUN_RSM_COLOR" + m_graphicsPipeline.GetUniqueIdentifierName();
+		CheckCreateUpdateRsmTarget(m_pRsmColor, rFr.nShadowMapSize, texName.c_str());
+	}
+
+	return CTexture::IsTextureExist(m_pRsmColor) ? m_pRsmColor.get() : nullptr;
+}
+
+CTexture* CLPVStage::GetRsmNormalMap(const ShadowMapFrustum& rFr, bool bCheckUpdate)
+{
+#if defined(FEATURE_SVO_GI)
+	if (CSvoRenderer::GetRsmNormlMap(m_graphicsPipeline, rFr))
+		return nullptr;
+#endif
+
+	if (!IsRsmFrustum(rFr))
+		return nullptr;
+
+	if (bCheckUpdate)
+	{
+		const std::string texName = "LPV_SUN_RSM_NORMAL" + m_graphicsPipeline.GetUniqueIdentifierName();
+		CheckCreateUpdateRsmTarget(m_pRsmNormal, rFr.nShadowMapSize, texName.c_str());
+	}
+
+	return CTexture::IsTextureExist(m_pRsmNormal) ? m_pRsmNormal.get() : nullptr;
+}
+
+const ShadowMapFrustum* CLPVStage::FindRsmFrustum() const
+{
+	const CRenderView* pRenderView = RenderView();
+	if (!pRenderView)
+		return nullptr;
+
+	for (const auto& pFrustumToRender : pRenderView->GetShadowFrustumsByType(CRenderView::eShadowFrustumRenderType_SunDynamic))
+	{
+		const ShadowMapFrustum* pFrustum = pFrustumToRender->pFrustum;
+		if (pFrustum && pFrustum->nShadowMapLod == CRendererCVars::CV_r_LPVCascadeLod && !pFrustum->bUseShadowsPool)
+			return pFrustum;
+	}
+
+	return nullptr;
+}
+
+bool CLPVStage::UpdateFrameParameters(const ShadowMapFrustum& frustum, const CTexture* pRsmColor)
+{
+	if (!CTexture::IsTextureExist(frustum.pDepthTex))
+		return false;
+
+	// The injection pass reads depth, albedo and normal at the same texel, so all three RSM targets
+	// have to share the resolution of the cascade.
+	m_rsmSize = pRsmColor->GetWidth();
+	if (m_rsmSize <= 0 || m_rsmSize != frustum.pDepthTex->GetWidth())
+		return false;
+
+	const int32 wantedSamples = clamp_tpl(CRendererCVars::CV_r_LPVRSMSamples, 64, MaxRsmSampleCount);
+	m_rsmSampleStride = max(1, m_rsmSize / wantedSamples);
+	m_rsmSampleCount = max(1, m_rsmSize / m_rsmSampleStride);
+
+	// Volume extent, snapped to whole cells to avoid sampling discontinuities while the camera moves.
+	const float extent = max(1.0f, CRendererCVars::CV_r_LPVSize);
+	m_cellSize = extent / (float)m_gridSize;
+
+	const Vec3 camPos = GetCurrentViewInfo().cameraOrigin;
+	const float halfExtent = extent * 0.5f;
+	m_gridOrigin.x = floorf(camPos.x / m_cellSize) * m_cellSize - halfExtent;
+	m_gridOrigin.y = floorf(camPos.y / m_cellSize) * m_cellSize - halfExtent;
+	m_gridOrigin.z = floorf(camPos.z / m_cellSize) * m_cellSize - halfExtent;
+
+	// Build the RSM texture space -> world space transform used to place the VPLs.
+	// ConfigShadowTexgen() returns world -> (u, v, z, w). For the orthographic sun cascades the depth
+	// buffer stores the raw clip space z of exactly this matrix, so it inverts directly.
+	// Do NOT scale the z row by RecpFarDist: fFarDist of the sun frustums is the (astronomic) distance
+	// to the sun light source, the scale would make the matrix numerically singular. SVOGI applies that
+	// scale but never reconstructs positions from RSM depth, so it is harmless there.
+	CShadowUtils::SShadowsSetupInfo shadowsSetup = gcpRendD3D->ConfigShadowTexgen(RenderView(), &frustum, 0);
+
+	Matrix44A worldToRsm = shadowsSetup.ShadowMat;
+
+	m_rsmToWorld = worldToRsm.GetInverted();
+
+	if (CRendererCVars::CV_r_LPVDebug > 0)
+	{
+		// CPU side sanity check of the matrix chain: the RSM centre at mid depth has to land in the
+		// vicinity of the cascade (and the camera), and the roundtrip has to reproduce the input.
+		const Vec4 rsmCenter(0.5f, 0.5f, 0.5f, 1.0f);
+		const Vec4 worldH = m_rsmToWorld * rsmCenter;
+		const Vec3 world = Vec3(worldH.x, worldH.y, worldH.z) / worldH.w;
+		const Vec4 roundtripH = worldToRsm * Vec4(world, 1.0f);
+		const Vec3 camPos = GetCurrentViewInfo().cameraOrigin;
+		CryLog("LPV debug: rsm(0.5,0.5,0.5) -> world (%.1f, %.1f, %.1f) w=%.3f | roundtrip (%.3f, %.3f, %.3f) | cam (%.1f, %.1f, %.1f) | gridOrigin (%.1f, %.1f, %.1f) ext %.1f | RecpFarDist %.5f | lod %d",
+		       world.x, world.y, world.z, worldH.w,
+		       roundtripH.x, roundtripH.y, roundtripH.z,
+		       camPos.x, camPos.y, camPos.z,
+		       m_gridOrigin.x, m_gridOrigin.y, m_gridOrigin.z, extent,
+		       shadowsSetup.RecpFarDist, frustum.nShadowMapLod);
+	}
+
+	return true;
+}
+
+void CLPVStage::SetGridConstants(CComputeRenderPass& pass)
+{
+	static CCryNameR paramGrid("LPVGridParams");
+	static CCryNameR paramGrid2("LPVGridParams2");
+
+	const float fGridSize = (float)m_gridSize;
+
+	pass.SetConstant(paramGrid, Vec4(m_gridOrigin.x, m_gridOrigin.y, m_gridOrigin.z, m_cellSize));
+	pass.SetConstant(paramGrid2, Vec4(fGridSize, 1.0f / fGridSize, 1.0f / m_cellSize, fGridSize * m_cellSize));
+}
+
+void CLPVStage::Execute()
+{
+	FUNCTION_PROFILER_RENDERER();
+
+	m_bResultValid = false;
+
+	// SVOGI owns the GI combine point and the sun RSM slot, LPV steps aside completely while it is active.
+	if (IsSvoProvidingRsm())
+		return;
+
+	if (!CShaderMan::s_shDeferredShading)
+		return;
+
+	if (m_gridSize <= 0 || !CTexture::IsTextureExist(m_pIrradiance) || !CTexture::IsTextureExist(m_pGridSH[0][0]))
+		return;
+
+	if (!m_injectionBuffer.IsAvailable())
+		return;
+
+	const ShadowMapFrustum* pFrustum = FindRsmFrustum();
+	if (!pFrustum)
+		return;
+
+	CTexture* pRsmColor = GetRsmColorMap(*pFrustum);
+	CTexture* pRsmNormal = GetRsmNormalMap(*pFrustum);
+	if (!pRsmColor || !pRsmNormal)
+		return;
+
+	if (!UpdateFrameParameters(*pFrustum, pRsmColor))
+		return;
+
+	PROFILE_LABEL_SCOPE("LPV");
+
+	const bool bAsynchronous = false;
+	SScopedComputeCommandList commandList(bAsynchronous);
+
+	ExecuteClear(commandList);
+	ExecuteInject(commandList, pFrustum->pDepthTex, pRsmColor, pRsmNormal);
+	ExecuteResolve(commandList);
+	ExecutePropagate(commandList);
+	ExecuteTemporal(commandList);
+	ExecuteApply(commandList, pFrustum->pDepthTex);
+
+	m_prevGridOrigin = m_gridOrigin;
+	m_bHistoryValid = true;
+	m_bResultValid = true;
+}
+
+void CLPVStage::ExecuteClear(const SScopedComputeCommandList& commandList)
+{
+	auto& pass = m_passClear;
+
+	if (pass.IsDirty(m_gridSize))
+	{
+		static CCryNameTSCRC techName("LPVClear");
+		pass.SetTechnique(CShaderMan::s_shDeferredShading, techName, 0);
+		pass.SetOutputUAV(0, &m_injectionBuffer);
+	}
+
+	pass.BeginConstantUpdate();
+	SetGridConstants(pass);
+
+	const uint32 dispatchSize = lpvDispatchSize(m_gridSize, LPVGridTileSize);
+	pass.SetDispatchSize(dispatchSize, dispatchSize, dispatchSize);
+	pass.PrepareResourcesForUse(commandList);
+	pass.Execute(commandList);
+}
+
+void CLPVStage::ExecuteInject(const SScopedComputeCommandList& commandList, CTexture* pRsmDepth, CTexture* pRsmColor, CTexture* pRsmNormal)
+{
+	auto& pass = m_passInject;
+
+	if (pass.IsDirty(m_gridSize, pRsmColor->GetID(), pRsmNormal->GetID(), pRsmDepth->GetID()))
+	{
+		static CCryNameTSCRC techName("LPVInject");
+		pass.SetTechnique(CShaderMan::s_shDeferredShading, techName, 0);
+		pass.SetOutputUAV(0, &m_injectionBuffer);
+		pass.SetTexture(0, pRsmDepth);
+		pass.SetTexture(1, pRsmColor);
+		pass.SetTexture(2, pRsmNormal);
+	}
+
+	pass.BeginConstantUpdate();
+	SetGridConstants(pass);
+
+	static CCryNameR paramRsm("LPVRsmParams");
+	pass.SetConstant(paramRsm, Vec4((float)m_rsmSampleCount, (float)m_rsmSampleStride, CRendererCVars::CV_r_LPVInjectionBias, 0.0f));
+
+	static CCryNameR paramRsmSize("LPVRsmSize");
+	pass.SetConstant(paramRsmSize, Vec4((float)m_rsmSize, 1.0f / (float)m_rsmSize, (float)CRendererCVars::CV_r_LPVDebug, 0.0f));
+
+	static CCryNameR paramSunDir("LPVSunDir");
+	const Vec3 sunDir = RenderView()->GetSunLightDirection();
+	pass.SetConstant(paramSunDir, Vec4(sunDir.x, sunDir.y, sunDir.z, 0.0f));
+
+	static CCryNameR paramSunColor("LPVSunColor");
+	const Vec4 sunColor = RenderView()->GetSunLightColor();
+	pass.SetConstant(paramSunColor, Vec4(sunColor.x, sunColor.y, sunColor.z, 0.0f));
+
+	static CCryNameR paramRsmToWorld("LPVRsmToWorld");
+	pass.SetConstant(paramRsmToWorld, m_rsmToWorld);
+
+	const uint32 dispatchSize = lpvDispatchSize(m_rsmSampleCount, LPVInjectTileSize);
+	pass.SetDispatchSize(dispatchSize, dispatchSize, 1);
+	pass.PrepareResourcesForUse(commandList);
+	pass.Execute(commandList);
+}
+
+void CLPVStage::ExecuteResolve(const SScopedComputeCommandList& commandList)
+{
+	auto& pass = m_passResolve;
+
+	if (pass.IsDirty(m_gridSize))
+	{
+		static CCryNameTSCRC techName("LPVResolve");
+		pass.SetTechnique(CShaderMan::s_shDeferredShading, techName, 0);
+		pass.SetOutputUAV(0, m_pGridSH[0][0]);
+		pass.SetOutputUAV(1, m_pGridSH[0][1]);
+		pass.SetOutputUAV(2, m_pGridSH[0][2]);
+		pass.SetBuffer(0, &m_injectionBuffer);
+	}
+
+	pass.BeginConstantUpdate();
+	SetGridConstants(pass);
+
+	// The surfel weight compensates for the different footprints of an RSM texel and a grid cell.
+	// It is applied here in float instead of pre-quantization in the inject pass, otherwise high
+	// sample counts push the per VPL contribution below the fixed point resolution.
+	const float fSampleCount = (float)m_rsmSampleCount;
+	const float injectionWeight = ((float)m_gridSize * (float)m_gridSize) / (fSampleCount * fSampleCount);
+
+	static CCryNameR paramResolve("LPVResolveParams");
+	pass.SetConstant(paramResolve, Vec4(injectionWeight, 0.0f, 0.0f, 0.0f));
+
+	const uint32 dispatchSize = lpvDispatchSize(m_gridSize, LPVGridTileSize);
+	pass.SetDispatchSize(dispatchSize, dispatchSize, dispatchSize);
+	pass.PrepareResourcesForUse(commandList);
+	pass.Execute(commandList);
+}
+
+void CLPVStage::ExecutePropagate(const SScopedComputeCommandList& commandList)
+{
+	const int32 iterations = clamp_tpl<int32>(CRendererCVars::CV_r_LPVIterations, 0, 32);
+	const uint32 dispatchSize = lpvDispatchSize(m_gridSize, LPVGridTileSize);
+
+	// LPVResolve wrote into set 0, every iteration ping-pongs between the two sets.
+	m_finalGridIndex = iterations & 1;
+
+	for (int32 i = 0; i < iterations; ++i)
+	{
+		const int32 src = i & 1;
+		const int32 dst = 1 - src;
+		auto& pass = m_passPropagate[src];
+
+		if (pass.IsDirty(m_gridSize))
+		{
+			static CCryNameTSCRC techName("LPVPropagate");
+			pass.SetTechnique(CShaderMan::s_shDeferredShading, techName, 0);
+			pass.SetOutputUAV(0, m_pGridSH[dst][0]);
+			pass.SetOutputUAV(1, m_pGridSH[dst][1]);
+			pass.SetOutputUAV(2, m_pGridSH[dst][2]);
+			pass.SetTexture(0, m_pGridSH[src][0]);
+			pass.SetTexture(1, m_pGridSH[src][1]);
+			pass.SetTexture(2, m_pGridSH[src][2]);
+		}
+
+		pass.BeginConstantUpdate();
+		SetGridConstants(pass);
+
+		pass.SetDispatchSize(dispatchSize, dispatchSize, dispatchSize);
+		pass.PrepareResourcesForUse(commandList);
+		pass.Execute(commandList);
+	}
+}
+
+void CLPVStage::ExecuteTemporal(const SScopedComputeCommandList& commandList)
+{
+	const float alpha = clamp_tpl(CRendererCVars::CV_r_LPVTemporalAlpha, 0.01f, 1.0f);
+
+	// The reprojection is a pure integer cell shift because both origins are snapped to the cell size.
+	Vec3 deltaCells(ZERO);
+	if (m_bHistoryValid)
+		deltaCells = (m_gridOrigin - m_prevGridOrigin) / m_cellSize;
+
+	// Blend weight 1 (or no usable history) means the accumulator is a plain copy of the current frame.
+	const float effectiveAlpha = m_bHistoryValid ? alpha : 1.0f;
+
+	const int32 src = m_accIndex;
+	const int32 dst = 1 - m_accIndex;
+	auto& pass = m_passTemporal[src];
+
+	if (pass.IsDirty(m_gridSize, m_finalGridIndex))
+	{
+		static CCryNameTSCRC techName("LPVTemporal");
+		pass.SetTechnique(CShaderMan::s_shDeferredShading, techName, 0);
+		pass.SetOutputUAV(0, m_pGridAcc[dst][0]);
+		pass.SetOutputUAV(1, m_pGridAcc[dst][1]);
+		pass.SetOutputUAV(2, m_pGridAcc[dst][2]);
+		pass.SetTexture(0, m_pGridSH[m_finalGridIndex][0]);
+		pass.SetTexture(1, m_pGridSH[m_finalGridIndex][1]);
+		pass.SetTexture(2, m_pGridSH[m_finalGridIndex][2]);
+		pass.SetTexture(3, m_pGridAcc[src][0]);
+		pass.SetTexture(4, m_pGridAcc[src][1]);
+		pass.SetTexture(5, m_pGridAcc[src][2]);
+	}
+
+	pass.BeginConstantUpdate();
+	SetGridConstants(pass);
+
+	static CCryNameR paramTemporal("LPVTemporalParams");
+	pass.SetConstant(paramTemporal, Vec4(deltaCells.x, deltaCells.y, deltaCells.z, effectiveAlpha));
+
+	const uint32 dispatchSize = lpvDispatchSize(m_gridSize, LPVGridTileSize);
+	pass.SetDispatchSize(dispatchSize, dispatchSize, dispatchSize);
+	pass.PrepareResourcesForUse(commandList);
+	pass.Execute(commandList);
+
+	m_accIndex = dst;
+}
+
+void CLPVStage::ExecuteApply(const SScopedComputeCommandList& commandList, CTexture* pRsmDepth)
+{
+	auto& pass = m_passApply;
+
+	const int32 screenWidth = m_pIrradiance->GetWidth();
+	const int32 screenHeight = m_pIrradiance->GetHeight();
+
+	if (pass.IsDirty(m_gridSize, screenWidth, screenHeight, m_accIndex, pRsmDepth->GetID()))
+	{
+		static CCryNameTSCRC techName("LPVApply");
+		pass.SetTechnique(CShaderMan::s_shDeferredShading, techName, 0);
+		pass.SetOutputUAV(0, m_pIrradiance);
+		pass.SetTexture(0, m_graphicsPipelineResources.m_pTexLinearDepth);
+		pass.SetTexture(1, m_graphicsPipelineResources.m_pTexSceneNormalsMap);
+		pass.SetTexture(2, m_pGridAcc[m_accIndex][0]);
+		pass.SetTexture(3, m_pGridAcc[m_accIndex][1]);
+		pass.SetTexture(4, m_pGridAcc[m_accIndex][2]);
+		pass.SetBuffer(5, &m_injectionBuffer);
+		pass.SetTexture(6, pRsmDepth);
+		pass.SetSampler(0, EDefaultSamplerStates::TrilinearClamp);
+	}
+
+	pass.SetInlineConstantBuffer(eConstantBufferShaderSlot_PerView, m_graphicsPipeline.GetMainViewConstantBuffer());
+
+	pass.BeginConstantUpdate();
+	SetGridConstants(pass);
+
+	static CCryNameR paramScreenSize("LPVScreenSize");
+	const float fScreenWidth = (float)screenWidth;
+	const float fScreenHeight = (float)screenHeight;
+	pass.SetConstant(paramScreenSize, Vec4(fScreenWidth, fScreenHeight, 1.0f / fScreenWidth, 1.0f / fScreenHeight));
+
+	static CCryNameR paramApply("LPVApplyParams");
+	pass.SetConstant(paramApply, Vec4(CRendererCVars::CV_r_LPVIntensity, (float)CRendererCVars::CV_r_LPVDebug, 0.0f, 0.0f));
+
+	static CCryNameR paramRsmSizeApply("LPVRsmSize");
+	pass.SetConstant(paramRsmSizeApply, Vec4((float)m_rsmSize, 1.0f / (float)m_rsmSize, (float)CRendererCVars::CV_r_LPVDebug, 0.0f));
+
+	pass.SetDispatchSize(lpvDispatchSize(screenWidth, LPVApplyTileSize), lpvDispatchSize(screenHeight, LPVApplyTileSize), 1);
+	pass.PrepareResourcesForUse(commandList);
+	pass.Execute(commandList);
+}
