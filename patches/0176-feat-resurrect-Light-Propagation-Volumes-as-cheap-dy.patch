+// Copyright 2016-2021 Crytek GmbH / Crytek Group. All rights reserved.
+
+// Light Propagation Volumes (single cascade, sun only).
+//
+// Pass order (driven by CLPVStage, GraphicsPipeline/LPV.cpp):
+//   LPVClear     -> zero the fixed point injection accumulator
+//   LPVInject    -> scatter the RSM texels (VPLs) into the accumulator
+//   LPVResolve   -> convert the accumulator into the RGB SH L1 grid textures
+//   LPVPropagate -> iterative 6 neighbour gather, ping-pong between two grid sets
+//   LPVApply     -> full resolution screen space irradiance
+//
+// SH conventions follow the CryEngine 3 LPV shaders: 2 band (L0 + L1) spherical harmonics,
+// one float4 per colour channel, three volume textures per grid set.
+
+//////////////////////////////////////////////////////////////////////////////////////////
+// Constants
+//////////////////////////////////////////////////////////////////////////////////////////
+
+// xyz: world space origin of the grid (corner of cell 0,0,0), w: cell size in meters
+float4 LPVGridParams;
+// x: cells per axis, y: 1 / cells per axis, z: 1 / cell size, w: world space extent of the grid
+float4 LPVGridParams2;
+// x: RSM samples per axis, y: RSM texel stride, z: injection bias in cells, w: surfel weight
+float4 LPVRsmParams;
+// x: RSM resolution, y: 1 / RSM resolution, z: debug mode
+float4 LPVRsmSize;
+// xyz: normalized direction towards the sun
+float4 LPVSunDir;
+// rgb: sun colour
+float4 LPVSunColor;
+// x: GI intensity multiplier, y: debug mode (0 off, 1 grid uv, 2 raw L0, 3 edge fade)
+float4 LPVApplyParams;
+// xy: screen size, zw: 1 / screen size
+float4 LPVScreenSize;
+// RSM texture space (u, v, depth, 1) -> world space
+float4x4 LPVRsmToWorld;
+
+// SH basis constants: 1 / (2 * sqrt(PI)) and sqrt(3) / (2 * sqrt(PI))
+#define LPV_SH_C0     0.2820947918f
+#define LPV_SH_C1     0.4886025119f
+
+// Zonal harmonics of a clamped cosine lobe: sqrt(PI) / 2 and sqrt(PI / 3)
+#define LPV_ZH_COS0   0.8862269255f
+#define LPV_ZH_COS1   1.0233267079f
+
+// Zonal harmonics of a 90 degree aperture cone: 0.5 * (1 - cos(45)) and 0.75 * sin(45)^2
+#define LPV_ZH_CONE0  0.1464466094f
+#define LPV_ZH_CONE1  0.375f
+
+// Fixed point scale of the injection accumulator, must match CLPVStage::AccumulatorFixedPointScale
+#define LPV_FP_SCALE      4096.0f
+#define LPV_FP_INV_SCALE  (1.0f / LPV_FP_SCALE)
+
+// Thread group sizes, must match the constants in GraphicsPipeline/LPV.cpp
+#define LPV_GRID_TILE_SIZE    4
+#define LPV_INJECT_TILE_SIZE  8
+#define LPV_APPLY_TILE_SIZE   8
+
+//////////////////////////////////////////////////////////////////////////////////////////
+// SH helpers
+//////////////////////////////////////////////////////////////////////////////////////////
+
+// Rotates a zonal harmonics pair towards 'dir' and folds in the SH basis constants.
+float4 LPVProjectZH(float3 dir, float2 zh)
+{
+	return float4( zh.x * LPV_SH_C0,
+	              -zh.y * LPV_SH_C1 * dir.y,
+	               zh.y * LPV_SH_C1 * dir.z,
+	              -zh.y * LPV_SH_C1 * dir.x);
+}
+
+float4 LPVCosineLobe(float3 dir)
+{
+	return LPVProjectZH(dir, float2(LPV_ZH_COS0, LPV_ZH_COS1));
+}
+
+float4 LPVCone90(float3 dir)
+{
+	return LPVProjectZH(dir, float2(LPV_ZH_CONE0, LPV_ZH_CONE1));
+}
+
+// Linear index of the first accumulator element of a cell.
+uint LPVCellBase(uint3 cell, uint gridSize)
+{
+	return ((cell.z * gridSize + cell.y) * gridSize + cell.x) * 12u;
+}
+
+//////////////////////////////////////////////////////////////////////////////////////////
+// LPVClear
+//////////////////////////////////////////////////////////////////////////////////////////
+
+RWBuffer<int> LPVInjectionUAV : register(u0);
+
+[numthreads(LPV_GRID_TILE_SIZE, LPV_GRID_TILE_SIZE, LPV_GRID_TILE_SIZE)]
+void LPVClearCS(uint3 DTid : SV_DispatchThreadID)
+{
+	const uint gridSize = (uint)LPVGridParams2.x;
+	if (DTid.x >= gridSize || DTid.y >= gridSize || DTid.z >= gridSize)
+		return;
+
+	const uint base = LPVCellBase(DTid, gridSize);
+
+	[unroll] for (uint i = 0; i < 12; ++i)
+		LPVInjectionUAV[base + i] = 0;
+}
+
+technique LPVClear
+{
+	pass p0
+	{
+		ComputeShader = LPVClearCS();
+	}
+}
+
+//////////////////////////////////////////////////////////////////////////////////////////
+// LPVInject
+//////////////////////////////////////////////////////////////////////////////////////////
+
+Texture2D<float>  LPVRsmDepth  : register(t0);
+Texture2D<float4> LPVRsmColor  : register(t1);
+Texture2D<float4> LPVRsmNormal : register(t2);
+
+[numthreads(LPV_INJECT_TILE_SIZE, LPV_INJECT_TILE_SIZE, 1)]
+void LPVInjectCS(uint3 DTid : SV_DispatchThreadID)
+{
+	const uint sampleCount = (uint)LPVRsmParams.x;
+	if (DTid.x >= sampleCount || DTid.y >= sampleCount)
+		return;
+
+	const int debugMode = (int)LPVRsmSize.z;
+
+	// Debug modes 5/6: bypass the RSM and the matrix entirely, flood the whole grid with unit flux.
+	// The dispatch is 2D, so every xy thread fills a full z column to cover the volume.
+	// If the resolved grid stays black in this mode the accumulator/atomics/resolve chain is broken.
+	if (debugMode >= 5)
+	{
+		const uint dbgGridSize = (uint)LPVGridParams2.x;
+		if (DTid.x >= dbgGridSize || DTid.y >= dbgGridSize)
+			return;
+
+		const int dbgValue = (int)(LPV_SH_C0 * LPV_FP_SCALE);
+		for (uint z = 0; z < dbgGridSize; ++z)
+		{
+			const uint dbgBase = LPVCellBase(uint3(DTid.xy, z), dbgGridSize);
+			InterlockedAdd(LPVInjectionUAV[dbgBase + 0u], dbgValue);
+			InterlockedAdd(LPVInjectionUAV[dbgBase + 4u], dbgValue);
+			InterlockedAdd(LPVInjectionUAV[dbgBase + 8u], dbgValue);
+		}
+		return;
+	}
+
+	const uint stride = max(1u, (uint)LPVRsmParams.y);
+	const uint2 texel = DTid.xy * stride + (stride >> 1u);
+
+	// Debug mode 4: keep the matrix path but disable all the rejection tests.
+	// Debug mode 7: like mode 4, but with the depth forced to the middle of the sun frustum,
+	// separating "matrix is wrong" from "depth texture reads zero/garbage".
+	const bool debugBypass = (debugMode == 4 || debugMode == 7);
+
+	// Sun cascades store a linear normalized depth, the far plane clear value is 1
+	const float depth = (debugMode == 7) ? 0.5f : LPVRsmDepth.Load(int3(texel, 0)).x;
+	if (!debugBypass && depth >= 1.0f)
+		return;
+
+	float3 normal = LPVRsmNormal.Load(int3(texel, 0)).xyz * 2.0f - 1.0f;
+	const float normalLenSq = dot(normal, normal);
+	if (!debugBypass && normalLenSq < 1e-4f)
+		return;
+	normal = (normalLenSq < 1e-4f) ? float3(0.0f, 0.0f, 1.0f) : normal * rsqrt(normalLenSq);
+
+	const float3 dirToLight = LPVSunDir.xyz;
+	const float ndotl = debugBypass ? 1.0f : saturate(dot(normal, dirToLight));
+	if (ndotl <= 0.0f)
+		return;
+
+	const float2 uv = ((float2)texel + 0.5f) * LPVRsmSize.y;
+	const float4 worldPosH = mul(LPVRsmToWorld, float4(uv, depth, 1.0f));
+	const float3 worldPos = worldPosH.xyz / worldPosH.w;
+
+	const float3 albedo = LPVRsmColor.Load(int3(texel, 0)).rgb;
+	// The surfel weight is deliberately NOT applied here: with high sample counts it shrinks the
+	// per VPL contribution below the fixed point resolution and the smaller G/B channels of the warm
+	// sun colour quantize to zero (visible as a red tint). LPVResolve applies it in float instead.
+	const float3 flux = debugBypass ? (float3)1.0f : albedo * LPVSunColor.rgb * ndotl;
+
+	// Offset the VPL along the surface normal and towards the light to reduce self illumination
+	// and thin wall bleeding.
+	const float bias = LPVRsmParams.z * LPVGridParams.w;
+	const float3 injectPos = worldPos + (normal + dirToLight) * bias;
+
+	const int gridSize = (int)LPVGridParams2.x;
+	const int3 cell = (int3)floor((injectPos - LPVGridParams.xyz) * LPVGridParams2.z);
+	if (cell.x < 0 || cell.y < 0 || cell.z < 0 || cell.x >= gridSize || cell.y >= gridSize || cell.z >= gridSize)
+		return;
+
+	const float4 sh = LPVCosineLobe(normal);
+	const uint base = LPVCellBase((uint3)cell, (uint)gridSize);
+
+	[unroll] for (uint k = 0; k < 4; ++k)
+	{
+		// floor(x + 0.5) rounds instead of truncating, keeping the quantization bias symmetric.
+		InterlockedAdd(LPVInjectionUAV[base + 0u + k], (int)floor(sh[k] * flux.r * LPV_FP_SCALE + 0.5f));
+		InterlockedAdd(LPVInjectionUAV[base + 4u + k], (int)floor(sh[k] * flux.g * LPV_FP_SCALE + 0.5f));
+		InterlockedAdd(LPVInjectionUAV[base + 8u + k], (int)floor(sh[k] * flux.b * LPV_FP_SCALE + 0.5f));
+	}
+}
+
+technique LPVInject
+{
+	pass p0
+	{
+		ComputeShader = LPVInjectCS();
+	}
+}
+
+//////////////////////////////////////////////////////////////////////////////////////////
+// LPVResolve
+//////////////////////////////////////////////////////////////////////////////////////////
+
+// x: surfel weight (applied here in float instead of pre-quantization in the inject pass)
+float4 LPVResolveParams;
+
+Buffer<int> LPVInjectionSRV : register(t0);
+
+RWTexture3D<float4> LPVResolveOutR : register(u0);
+RWTexture3D<float4> LPVResolveOutG : register(u1);
+RWTexture3D<float4> LPVResolveOutB : register(u2);
+
+[numthreads(LPV_GRID_TILE_SIZE, LPV_GRID_TILE_SIZE, LPV_GRID_TILE_SIZE)]
+void LPVResolveCS(uint3 DTid : SV_DispatchThreadID)
+{
+	const uint gridSize = (uint)LPVGridParams2.x;
+	if (DTid.x >= gridSize || DTid.y >= gridSize || DTid.z >= gridSize)
+		return;
+
+	const uint base = LPVCellBase(DTid, gridSize);
+
+	float4 shR = 0;
+	float4 shG = 0;
+	float4 shB = 0;
+
+	const float weight = LPVResolveParams.x * LPV_FP_INV_SCALE;
+
+	[unroll] for (uint k = 0; k < 4; ++k)
+	{
+		shR[k] = (float)LPVInjectionSRV[base + 0u + k] * weight;
+		shG[k] = (float)LPVInjectionSRV[base + 4u + k] * weight;
+		shB[k] = (float)LPVInjectionSRV[base + 8u + k] * weight;
+	}
+
+	LPVResolveOutR[DTid] = shR;
+	LPVResolveOutG[DTid] = shG;
+	LPVResolveOutB[DTid] = shB;
+}
+
+technique LPVResolve
+{
+	pass p0
+	{
+		ComputeShader = LPVResolveCS();
+	}
+}
+
+//////////////////////////////////////////////////////////////////////////////////////////
+// LPVPropagate
+//////////////////////////////////////////////////////////////////////////////////////////
+
+Texture3D<float4> LPVPropSrcR : register(t0);
+Texture3D<float4> LPVPropSrcG : register(t1);
+Texture3D<float4> LPVPropSrcB : register(t2);
+
+RWTexture3D<float4> LPVPropDstR : register(u0);
+RWTexture3D<float4> LPVPropDstG : register(u1);
+RWTexture3D<float4> LPVPropDstB : register(u2);
+
+[numthreads(LPV_GRID_TILE_SIZE, LPV_GRID_TILE_SIZE, LPV_GRID_TILE_SIZE)]
+void LPVPropagateCS(uint3 DTid : SV_DispatchThreadID)
+{
+	// Axial "cross" stencil, no diagonal neighbours (Kaplanyan, SIGGRAPH 2009, appendix C).
+	static const int3 neighbourOffset[6] =
+	{
+		int3( 1,  0,  0),
+		int3(-1,  0,  0),
+		int3( 0,  1,  0),
+		int3( 0, -1,  0),
+		int3( 0,  0,  1),
+		int3( 0,  0, -1),
+	};
+
+	const int gridSize = (int)LPVGridParams2.x;
+	const int3 cell = (int3)DTid;
+	if (cell.x >= gridSize || cell.y >= gridSize || cell.z >= gridSize)
+		return;
+
+	// Self + gathered variant: the destination keeps the source cell content so that the light
+	// accumulates over the iterations without an extra accumulation texture set.
+	float4 dstR = LPVPropSrcR.Load(int4(cell, 0));
+	float4 dstG = LPVPropSrcG.Load(int4(cell, 0));
+	float4 dstB = LPVPropSrcB.Load(int4(cell, 0));
+
+	[unroll] for (int i = 0; i < 6; ++i)
+	{
+		const int3 offset = neighbourOffset[i];
+		const int3 neighbour = cell + offset;
+
+		if (neighbour.x < 0 || neighbour.y < 0 || neighbour.z < 0 ||
+		    neighbour.x >= gridSize || neighbour.y >= gridSize || neighbour.z >= gridSize)
+			continue;
+
+		const float4 srcR = LPVPropSrcR.Load(int4(neighbour, 0));
+		const float4 srcG = LPVPropSrcG.Load(int4(neighbour, 0));
+		const float4 srcB = LPVPropSrcB.Load(int4(neighbour, 0));
+
+		// Direction the light travels when it moves from the neighbour into the current cell.
+		const float4 cone = LPVCone90(-(float3)offset);
+
+		float3 incident;
+		incident.r = max(0.0f, dot(srcR, cone));
+		incident.g = max(0.0f, dot(srcG, cone));
+		incident.b = max(0.0f, dot(srcB, cone));
+
+		dstR += cone * incident.r;
+		dstG += cone * incident.g;
+		dstB += cone * incident.b;
+	}
+
+	LPVPropDstR[DTid] = dstR;
+	LPVPropDstG[DTid] = dstG;
+	LPVPropDstB[DTid] = dstB;
+}
+
+technique LPVPropagate
+{
+	pass p0
+	{
+		ComputeShader = LPVPropagateCS();
+	}
+}
+
+//////////////////////////////////////////////////////////////////////////////////////////
+// LPVTemporal
+//////////////////////////////////////////////////////////////////////////////////////////
+
+// xyz: cell offset into the previous frame grid (integer, both origins are cell snapped),
+// w: blend weight of the current frame (1 = no history)
+float4 LPVTemporalParams;
+
+Texture3D<float4> LPVTempCurR  : register(t0);
+Texture3D<float4> LPVTempCurG  : register(t1);
+Texture3D<float4> LPVTempCurB  : register(t2);
+Texture3D<float4> LPVTempPrevR : register(t3);
+Texture3D<float4> LPVTempPrevG : register(t4);
+Texture3D<float4> LPVTempPrevB : register(t5);
+
+RWTexture3D<float4> LPVTempOutR : register(u0);
+RWTexture3D<float4> LPVTempOutG : register(u1);
+RWTexture3D<float4> LPVTempOutB : register(u2);
+
+[numthreads(LPV_GRID_TILE_SIZE, LPV_GRID_TILE_SIZE, LPV_GRID_TILE_SIZE)]
+void LPVTemporalCS(uint3 DTid : SV_DispatchThreadID)
+{
+	const int gridSize = (int)LPVGridParams2.x;
+	const int3 cell = (int3)DTid;
+	if (cell.x >= gridSize || cell.y >= gridSize || cell.z >= gridSize)
+		return;
+
+	const float4 curR = LPVTempCurR.Load(int4(cell, 0));
+	const float4 curG = LPVTempCurG.Load(int4(cell, 0));
+	const float4 curB = LPVTempCurB.Load(int4(cell, 0));
+
+	float alpha = LPVTemporalParams.w;
+
+	// Same world position in the previous frame grid, an integer shift because of the cell snapping.
+	const int3 prevCell = cell + (int3)round(LPVTemporalParams.xyz);
+
+	float4 prevR = curR;
+	float4 prevG = curG;
+	float4 prevB = curB;
+
+	if (prevCell.x >= 0 && prevCell.y >= 0 && prevCell.z >= 0 &&
+	    prevCell.x < gridSize && prevCell.y < gridSize && prevCell.z < gridSize)
+	{
+		prevR = LPVTempPrevR.Load(int4(prevCell, 0));
+		prevG = LPVTempPrevG.Load(int4(prevCell, 0));
+		prevB = LPVTempPrevB.Load(int4(prevCell, 0));
+	}
+	else
+	{
+		// No history outside the previous volume.
+		alpha = 1.0f;
+	}
+
+	LPVTempOutR[DTid] = lerp(prevR, curR, alpha);
+	LPVTempOutG[DTid] = lerp(prevG, curG, alpha);
+	LPVTempOutB[DTid] = lerp(prevB, curB, alpha);
+}
+
+technique LPVTemporal
+{
+	pass p0
+	{
+		ComputeShader = LPVTemporalCS();
+	}
+}
+
+//////////////////////////////////////////////////////////////////////////////////////////
+// LPVApply
+//////////////////////////////////////////////////////////////////////////////////////////
+
+Texture2D<float>  LPVSceneDepth   : register(t0);
+Texture2D<float4> LPVSceneNormals : register(t1);
+Texture3D<float4> LPVGridR        : register(t2);
+Texture3D<float4> LPVGridG        : register(t3);
+Texture3D<float4> LPVGridB        : register(t4);
+Buffer<int>       LPVApplyAccum   : register(t5);
+Texture2D<float>  LPVApplyRsmDepth : register(t6);
+
+SamplerState LPVGridSampler : register(s0);
+
+RWTexture2D<float4> LPVIrradianceUAV : register(u0);
+
+[numthreads(LPV_APPLY_TILE_SIZE, LPV_APPLY_TILE_SIZE, 1)]
+void LPVApplyCS(uint3 DTid : SV_DispatchThreadID)
+{
+	const uint2 pixelCoord = DTid.xy;
+	if (pixelCoord.x >= (uint)LPVScreenSize.x || pixelCoord.y >= (uint)LPVScreenSize.y)
+		return;
+
+	// Debug mode 8: show the raw RSM depth exactly as the inject pass reads it.
+	// r = depth, g = frac(depth * 100) to make small variations visible, b = 1 where cleared (>= 1).
+	if ((int)LPVApplyParams.y == 8)
+	{
+		const uint2 rsmTexel = (uint2)(((float2)pixelCoord + 0.5f) * LPVScreenSize.zw * LPVRsmSize.x);
+		const float rsmDepth = LPVApplyRsmDepth.Load(int3(rsmTexel, 0)).x;
+		LPVIrradianceUAV[pixelCoord] = float4(rsmDepth, frac(rsmDepth * 100.0f), (rsmDepth >= 1.0f) ? 1.0f : 0.0f, 1.0f);
+		return;
+	}
+
+	float3 irradiance = 0;
+
+	const float linearDepth = LPVSceneDepth.Load(int3(pixelCoord, 0)).x;
+	const int debugMode = (int)LPVApplyParams.y;
+
+	[branch] if (linearDepth < 1.0f)
+	{
+		const float3 normal = DecodeGBufferNormal(LPVSceneNormals.Load(int3(pixelCoord, 0)));
+		const float3 worldPos = ReconstructWorldPos((int2)pixelCoord, linearDepth, false);
+
+		// Receiver side offset along the surface normal (half a cell): moves the sample point away
+		// from the wall so that the trilinear lookup does not pick up cells on the far side of thin
+		// geometry (CryEngine 3 shipped the same trick, see 04_ce3_shader_reconstruction.md).
+		const float3 samplePos = worldPos + normal * (LPVGridParams.w * 0.5f);
+
+		const float3 gridUV = (samplePos - LPVGridParams.xyz) / LPVGridParams2.w;
+
+		// Fade out over the outer 10% of the volume so that the boundary is not a hard edge.
+		const float3 centered = abs(gridUV - 0.5f) * 2.0f;
+		const float edge = max(centered.x, max(centered.y, centered.z));
+		const float fade = 1.0f - smoothstep(0.8f, 1.0f, edge);
+
+		if (debugMode == 1)
+		{
+			LPVIrradianceUAV[pixelCoord] = float4(frac(gridUV), 1.0f);
+			return;
+		}
+		// Debug mode 6: read the injection accumulator directly, bypassing resolve/propagate/textures.
+		if (debugMode == 6)
+		{
+			const int accumGridSize = (int)LPVGridParams2.x;
+			const int3 accumCell = clamp((int3)(gridUV * accumGridSize), 0, accumGridSize - 1);
+			const uint accumBase = LPVCellBase((uint3)accumCell, (uint)accumGridSize);
+			const float3 accumL0 = float3(abs((float)LPVApplyAccum[accumBase + 0u]),
+			                              abs((float)LPVApplyAccum[accumBase + 4u]),
+			                              abs((float)LPVApplyAccum[accumBase + 8u])) * LPV_FP_INV_SCALE;
+			LPVIrradianceUAV[pixelCoord] = float4(accumL0, 1.0f);
+			return;
+		}
+
+		if (debugMode == 2 || debugMode >= 4)
+		{
+			const float4 dbgR = LPVGridR.SampleLevel(LPVGridSampler, saturate(gridUV), 0);
+			const float4 dbgG = LPVGridG.SampleLevel(LPVGridSampler, saturate(gridUV), 0);
+			const float4 dbgB = LPVGridB.SampleLevel(LPVGridSampler, saturate(gridUV), 0);
+			LPVIrradianceUAV[pixelCoord] = float4(abs(dbgR.x), abs(dbgG.x), abs(dbgB.x), 1.0f);
+			return;
+		}
+		if (debugMode == 3)
+		{
+			LPVIrradianceUAV[pixelCoord] = float4(fade.xxx, 1.0f);
+			return;
+		}
+
+		[branch] if (fade > 0.0f)
+		{
+			const float4 shR = LPVGridR.SampleLevel(LPVGridSampler, gridUV, 0);
+			const float4 shG = LPVGridG.SampleLevel(LPVGridSampler, gridUV, 0);
+			const float4 shB = LPVGridB.SampleLevel(LPVGridSampler, gridUV, 0);
+
+			// The stored SH describes the direction the light flows in, so the receiver lobe points
+			// against the surface normal.
+			const float4 receiver = LPVCosineLobe(-normal);
+
+			irradiance.r = max(0.0f, dot(shR, receiver));
+			irradiance.g = max(0.0f, dot(shG, receiver));
+			irradiance.b = max(0.0f, dot(shB, receiver));
+
+			irradiance *= fade * LPVApplyParams.x;
+		}
+	}
+
+	// Irradiance only, TiledShading.cfi multiplies with the surface albedo.
+	LPVIrradianceUAV[pixelCoord] = float4(irradiance, 1.0f);
+}
+
+technique LPVApply
+{
+	pass p0
+	{
+		ComputeShader = LPVApplyCS();
+	}
+}
