+
+	void Execute();
+
+	// RSM provider, mirrors CSvoRenderer::GetRsmColorMap()/GetRsmNormlMap(). Returns nullptr when LPV
+	// does not want to own the sun RSM for the given frustum.
+	CTexture* GetRsmColorMap(const ShadowMapFrustum& rFr, bool bCheckUpdate = false);
+	CTexture* GetRsmNormalMap(const ShadowMapFrustum& rFr, bool bCheckUpdate = false);
+
+	// Texture objects handed to CShadowMapStage::Init() before any device resource exists.
+	CTexture* GetRsmColorTexture() const  { return m_pRsmColor.get(); }
+	CTexture* GetRsmNormalTexture() const { return m_pRsmNormal.get(); }
+
+	// GI combine, mirrors CSvoRenderer::GetDiffuseFinRT(). Only valid after a successful Execute().
+	CTexture* GetIrradianceRT() const;
+
+private:
+	static int32 GetValidGridSize();
+
+	bool IsSvoProvidingRsm() const;
+	bool IsRsmFrustum(const ShadowMapFrustum& rFr) const;
+
+	void ResizeGrid(int32 gridSize);
+	void CheckCreateUpdateRsmTarget(_smart_ptr<CTexture>& pTex, int32 size, const char* szName);
+
+	const ShadowMapFrustum* FindRsmFrustum() const;
+	bool                    UpdateFrameParameters(const ShadowMapFrustum& frustum, const CTexture* pRsmColor);
+
+	void ExecuteClear(const SScopedComputeCommandList& commandList);
+	void ExecuteInject(const SScopedComputeCommandList& commandList, CTexture* pRsmDepth, CTexture* pRsmColor, CTexture* pRsmNormal);
+	void ExecuteResolve(const SScopedComputeCommandList& commandList);
+	void ExecutePropagate(const SScopedComputeCommandList& commandList);
+	void ExecuteTemporal(const SScopedComputeCommandList& commandList);
+	void ExecuteApply(const SScopedComputeCommandList& commandList, CTexture* pRsmDepth);
+
+	void SetGridConstants(CComputeRenderPass& pass);
+
+private:
+	// Propagation ping-pong pair, each entry holds the R/G/B SH textures of one iteration.
+	_smart_ptr<CTexture> m_pGridSH[2][SHChannelNum];
+	// Temporal accumulation ping-pong pair (exponential moving average of the propagated grid).
+	_smart_ptr<CTexture> m_pGridAcc[2][SHChannelNum];
+	// Screen space output (irradiance, never pre-multiplied with albedo).
+	_smart_ptr<CTexture> m_pIrradiance;
+	// Sun RSM owned by LPV (only used when SVOGI is not providing one).
+	_smart_ptr<CTexture> m_pRsmColor;
+	_smart_ptr<CTexture> m_pRsmNormal;
+
+	CGpuBuffer           m_injectionBuffer;
+
+	CComputeRenderPass   m_passClear;
+	CComputeRenderPass   m_passInject;
+	CComputeRenderPass   m_passResolve;
+	CComputeRenderPass   m_passPropagate[2];
+	CComputeRenderPass   m_passTemporal[2];
+	CComputeRenderPass   m_passApply;
+
+	Matrix44A            m_rsmToWorld;
+	Vec3                 m_gridOrigin;
+	float                m_cellSize;
+	int32                m_gridSize;
+	int32                m_rsmSize;
+	int32                m_rsmSampleCount;
+	int32                m_rsmSampleStride;
+	// Index of the ping-pong set holding the propagation result of the current frame.
+	int32                m_finalGridIndex;
+	// Index of the accumulation set holding the temporal result of the current frame.
+	int32                m_accIndex;
+	// Grid origin of the previous frame, used for the integer cell reprojection of the accumulation.
+	Vec3                 m_prevGridOrigin;
+	bool                 m_bHistoryValid;
+	bool                 m_bResultValid;
+};
