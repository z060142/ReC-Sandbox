From 49d61fd01bad0760fe5fbd4885d5d02a6ac29365 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 9 Sep 2026 22:30:55 +0800
Subject: [PATCH 143/162] fix: the wave-glare source budget was scene-referred
 only - the stock path drew every source unbudgeted

User: through a cinematic camera with Scene Referred off, sun in frame, the frame rate fell to
single digits; Scene Referred on, or the analytic streaks, restored it; lowering
r_HDRDiffractionMaxSources to 10 changed nothing. The once-a-second report said it outright:
"raw above threshold = 38107 ... budget 256 is SET but not in force: the scene-referred path
is off and the budget is scene-referred only - every one of them drew a full sprite"
(28 000 Mpx of blending per frame).

Why the stock path is the worse one: below stage 5 the threshold is raw engine units (4.0 =
40 000 cd/m2, not stops over grey), and the skybox x10 is gated off only under the switch, so a
full sun sky sits at 10-20 engine units - the whole sky clears the threshold, not just the disc.
The budget was wired to IsSceneReferredStage(5) on the assumption that only the exposed path
could produce a large population. It is now unconditional: at most N full sprites, every
source below the cutoff a one-texel quad carrying its whole energy, so nothing darkens or pops.
The stock (camera-off) pipeline is untouched - the wave path is never entered without a camera.

research/s9-wave-glare-stock-fps.md; STRUCTURE.md wave-glare row.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HXzRVK4yBVDUNfdWXEwV5y
---
 .../RenderDll/Common/RendererCVars.cpp        |  8 +++---
 .../XRenderD3D9/GraphicsPipeline/Bloom.cpp    | 25 ++++++++++++++++---
 2 files changed, 27 insertions(+), 6 deletions(-)

diff --git a/Code/CryEngine/RenderDll/Common/RendererCVars.cpp b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
index 3024b437..7f0e4e0f 100644
--- a/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
+++ b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
@@ -1322,7 +1322,8 @@ void CRendererCVars::InitCVars()
 	REGISTER_CVAR3("r_HDRDiffractionMaxSources", CV_r_HDRDiffractionMaxSources, 256, VF_NULL,
 	               "Wave-optics glare SOURCE BUDGET: the largest number of half-resolution texels "
 	               "that may draw a diffraction sprite in one frame. The pass costs one large "
-	               "sprite per texel above HDR_Streaks_Threshold, so a pre-exposed bright sky can "
+	               "sprite per texel above HDR_Streaks_Threshold, so a bright sky - and, off the "
+	               "scene-referred switch, the raw sun disc against an absolute threshold - can "
 	               "put tens of thousands of them on screen and the frame rate follows the "
 	               "brightness down. Above the budget the dimmest sources lose their STAR but not "
 	               "their LIGHT: the energy their pattern would have spread is deposited at the "
@@ -1330,8 +1331,9 @@ void CRendererCVars::InitCVars()
 	               "unlimited is NOT allowed any more (0 or less now means the cap) and values "
 	               "above 4096 are clamped, because measurement showed the sun's star stops "
 	               "changing past about 2048 while the frame time keeps growing, and 32768 held "
-	               "the main thread long enough for Windows to kill the editor. Scene-referred "
-	               "path only. Measure the population AND its GPU cost with "
+	               "the main thread long enough for Windows to kill the editor. In force on BOTH "
+	               "exposure paths since S9 (it was scene-referred only, and the stock path with "
+	               "the sun in frame is the worse of the two). Measure the population AND its GPU cost with "
 	               "r_HDRDiffractionDebug 3, whose SOURCES lines print the raw count first and "
 	               "the glare pass' milliseconds under it (those need r_profiler 1).");
 
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp
index 560e4b24..f4124ea0 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp
@@ -757,7 +757,24 @@ void CBloomStage::ExecuteDiffraction(const SHDRStreaksParams& streakParams, floa
 	const int  nSourceBudget    = (nRequestedBudget <= 0)
 	                              ? kDiffractionMaxSourceBudget
 	                              : min(nRequestedBudget, kDiffractionMaxSourceBudget);
-	const bool bBudgetActive    = bSceneReferredGlare;
+	// The budget binds on BOTH exposure paths (S9, research/s9-wave-glare-stock-fps.md). It was
+	// scene-referred only, on the reading that only a pre-exposed frame can put tens of thousands
+	// of texels over the threshold. That reading was exactly backwards for the sun. Off the
+	// switch the HDR target holds RAW scene radiance - no pre-exposure divides it down - and
+	// ResolveThreshold() is the identity there, so the shipped HDR_Streaks_Threshold 4.0 is 4.0
+	// engine units, about two stops over a lit diffuse surface and some four DECADES under the
+	// sun disc. Sun in frame, stock exposure: the disc, its bloom skirt and most of the sky
+	// around it clear the threshold, a six-figure population draws six-figure large sprites, and
+	// the editor falls to single digits. Turning the switch ON was "fixing" it only because the
+	// switch is what turned the budget on.
+	//
+	// So it is unconditional now. Nothing about the cutoff controller is scene-referred: it is
+	// multiplicative and scale-free (HDRDiffractionBudgetPS), it converges on whatever the
+	// population's own energy distribution is, and it costs the same three small passes either
+	// way. What keeps the STOCK pipeline byte-identical is not this flag - it is that the whole
+	// wave path only runs when a camera turns HDR_Streaks_Active on and asks for mode 1. With no
+	// camera driving it this function is never entered.
+	const bool bBudgetActive    = true;
 
 	if (bBudgetActive || nDebugMode == 3)
 		ExecuteDiffractionBudget(pSource, bBudgetActive ? nSourceBudget : 0);
@@ -1465,8 +1482,10 @@ void CBloomStage::PrintDiffractionReport(const SDiffractionReport& report, float
 		}
 		else
 		{
-			CryLog("[BLOOM]            budget %d is SET but not in force: the scene-referred path is off and the budget is"
-			       " scene-referred only -- every one of them drew a full sprite", report.nBudget);
+			// Since S9 the budget binds on both exposure paths, so the only way here is a missing
+			// stats target - the one case the vertex shader must not read a cutoff from.
+			CryLog("[BLOOM]            budget %d is SET but not in force: the stats target does not exist this frame,"
+			       " so every one of them drew a full sprite", report.nBudget);
 		}
 
 		// The hard cap, said out loud whenever the value in force is not the value the user typed.
