+void CLPVStage::ExecuteInjectScreen(const SScopedComputeCommandList& commandList)
+{
+	auto& pass = m_passInjectScreen;
+
+	CTexture* pDepth = m_graphicsPipelineResources.m_pTexLinearDepth;
+	CTexture* pNormals = m_graphicsPipelineResources.m_pTexSceneNormalsMap;
+	CTexture* pDiffuse = m_graphicsPipelineResources.m_pTexSceneDiffuse;
+
+	if (!CTexture::IsTextureExist(pDepth) || !CTexture::IsTextureExist(pNormals)
+	    || !CTexture::IsTextureExist(pDiffuse) || !CTexture::IsTextureExist(m_pIrradiance))
+		return;
+
+	const int32 screenWidth = m_pIrradiance->GetWidth();
+	const int32 screenHeight = m_pIrradiance->GetHeight();
+	const int32 pixelStep = 3;
+	const int32 samplesX = (screenWidth + pixelStep - 1) / pixelStep;
+	const int32 samplesY = (screenHeight + pixelStep - 1) / pixelStep;
+
+	if (pass.IsDirty(m_gridSize, screenWidth, screenHeight, pDiffuse->GetID()))
+	{
+		static CCryNameTSCRC techName("LPVInjectScreen");
+		pass.SetTechnique(CShaderMan::s_shDeferredShading, techName, 0);
+		pass.SetOutputUAV(0, &m_injectionBuffer);
+		pass.SetTexture(0, pDepth);
+		pass.SetTexture(1, pNormals);
+		pass.SetTexture(2, pDiffuse);
+		pass.SetTexture(3, m_pIrradiance);
+	}
+
+	pass.SetInlineConstantBuffer(eConstantBufferShaderSlot_PerView, m_graphicsPipeline.GetMainViewConstantBuffer());
+
+	pass.BeginConstantUpdate();
+	SetGridConstants(pass);
+
+	// Area of one screen VPL relative to one RSM texel so that the shared surfel weight in
+	// LPVResolve stays correct for both injection sources. The depth dependent part (linearDepth^2)
+	// is applied in the shader.
+	// The inverse is only defined up to a projective scale, both corners have to be dehomogenized
+	// before the span is measured (skipping the divide made the texel size garbage and silently
+	// zeroed the whole secondary bounce).
+	Vec4 rsmCorner0 = m_rsmToWorld * Vec4(0.0f, 0.0f, 0.5f, 1.0f);
+	Vec4 rsmCorner1 = m_rsmToWorld * Vec4(1.0f, 0.0f, 0.5f, 1.0f);
+	if (fabsf(rsmCorner0.w) > 1e-12f)
+		rsmCorner0 = rsmCorner0 / rsmCorner0.w;
+	if (fabsf(rsmCorner1.w) > 1e-12f)
+		rsmCorner1 = rsmCorner1 / rsmCorner1.w;
+	const Vec3 rsmSpan = Vec3(rsmCorner1.x - rsmCorner0.x, rsmCorner1.y - rsmCorner0.y, rsmCorner1.z - rsmCorner0.z);
+	const float rsmTexelSize = rsmSpan.GetLength() / (float)m_rsmSampleCount;
+
+	const CCamera& camera = RenderView()->GetCamera(CCamera::eEye_Left);
+	const float farDist = camera.GetFarPlane();
+	const float tanHalfFov = tanf(camera.GetFov() * 0.5f);
+	const float screenVplSize = (2.0f * tanHalfFov * farDist * (float)pixelStep) / (float)screenHeight;
+
+	float areaWeight = 0.0f;
+	if (rsmTexelSize > 1e-4f)
+		areaWeight = (screenVplSize * screenVplSize) / (rsmTexelSize * rsmTexelSize);
+
+	const float gain = max(0.0f, CRendererCVars::CV_r_LPVSecondaryBounce);
+	const float biasMeters = CRendererCVars::CV_r_LPVInjectionBias * m_cellSize;
+
+	static CCryNameR paramScreen("LPVScreenInjectParams");
+	pass.SetConstant(paramScreen, Vec4((float)pixelStep, (float)samplesX, (float)samplesY, gain));
+
+	static CCryNameR paramScreen2("LPVScreenInjectParams2");
+	pass.SetConstant(paramScreen2, Vec4(areaWeight, (float)screenWidth, (float)screenHeight, biasMeters));
+
+	pass.SetDispatchSize(lpvDispatchSize(samplesX, LPVInjectTileSize), lpvDispatchSize(samplesY, LPVInjectTileSize), 1);
+	pass.PrepareResourcesForUse(commandList);
+	pass.Execute(commandList);
+}
