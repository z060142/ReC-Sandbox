+
 void CLPVStage::Execute()
 {
 	FUNCTION_PROFILER_RENDERER();
 
+	// Never run for recursive views (e.g. water reflections): they would overwrite the shared
+	// irradiance target and the frozen grid state with the recursion camera, and the main view
+	// combine would alternate between the correct and the recursion result. Do not touch
+	// m_bResultValid here - the main view result stays valid.
+	if (RenderView() && RenderView()->IsRecursive())
+		return;
+
+	if (CRendererCVars::CV_r_LPVDebug > 0)
+	{
+		// Identity of the executing view, logged on change: two interleaving identities would mean a
+		// second view runs the LPV and clobbers the shared output.
+		const CRenderView* pView = RenderView();
+		static const void* pLastView = nullptr;
+		static int lastViewportWidth = -1;
+		if ((const void*)pView != pLastView || (pView && pView->GetViewport().width != lastViewportWidth))
+		{
+			CryLog("LPV debug: executing on view %p viewport %dx%d",
+			       (const void*)pView,
+			       pView ? pView->GetViewport().width : -1,
+			       pView ? pView->GetViewport().height : -1);
+			pLastView = (const void*)pView;
+			lastViewportWidth = pView ? pView->GetViewport().width : -1;
+		}
+	}
+
 	m_bResultValid = false;
 
 	// SVOGI owns the GI combine point and the sun RSM slot, LPV steps aside completely while it is active.
 	if (IsSvoProvidingRsm())
+	{
+		LpvDebugLogExecuteState(1);
 		return;
+	}
 
 	if (!CShaderMan::s_shDeferredShading)
+	{
+		LpvDebugLogExecuteState(2);
 		return;
+	}
 
 	if (m_gridSize <= 0 || !CTexture::IsTextureExist(m_pIrradiance) || !CTexture::IsTextureExist(m_pGridSH[0][0]))
+	{
+		LpvDebugLogExecuteState(3);
 		return;
+	}
 
 	if (!m_injectionBuffer.IsAvailable())
+	{
+		LpvDebugLogExecuteState(4);
 		return;
+	}
 
 	const ShadowMapFrustum* pFrustum = FindRsmFrustum();
 	if (!pFrustum)
+	{
+		LpvDebugLogExecuteState(5);
 		return;
+	}
 
 	CTexture* pRsmColor = GetRsmColorMap(*pFrustum);
 	CTexture* pRsmNormal = GetRsmNormalMap(*pFrustum);
 	if (!pRsmColor || !pRsmNormal)
+	{
+		LpvDebugLogExecuteState(6);
 		return;
+	}
 
 	if (!UpdateFrameParameters(*pFrustum, pRsmColor))
+	{
+		LpvDebugLogExecuteState(7);
 		return;
