+// Debug instrumentation (r_LPVDebug >= 2): name every object that had the LPV RSM pass bit removed
+// by UpdateCullMask, so deterministic view dependent losses can be attributed to concrete objects.
+static void LpvDebugLogRsmCulledObject(IRenderNode* pObj, FrustumMaskType maskBefore, FrustumMaskType maskAfter, float fEntDistance, const SRenderingPassInfo& passInfo)
+{
+	static ICVar* pLPVDebug = gEnv->pConsole->GetCVar("r_LPVDebug");
+	if (!pLPVDebug || pLPVDebug->GetIVal() < 2)
+		return;
+
+	const std::vector<SRenderingPassInfo>* shadowPasses = passInfo.GetShadowPasses();
+	if (!shadowPasses)
+		return;
+
+	for (uint32 n = 0, passId = 1; n < (uint32)shadowPasses->size(); ++n, ++passId)
+	{
+		const ShadowMapFrustum* pFr = shadowPasses->at(n).GetIRenderView()->GetShadowFrustumOwner();
+		if (pFr && pFr->m_eFrustumType == ShadowMapFrustum::e_LPVRsm)
+		{
+			if ((maskBefore & FMBIT(passId)) != 0 && (maskAfter & FMBIT(passId)) == 0)
+			{
+				// cap the log volume per frame
+				static uint32 lastFrame = 0;
+				static int logsThisFrame = 0;
+				if (lastFrame != passInfo.GetMainFrameID())
+				{
+					lastFrame = passInfo.GetMainFrameID();
+					logsThisFrame = 0;
+				}
+				if (++logsThisFrame <= 20)
+				{
+					const Vec3 c = pObj->GetBBox().GetCenter();
+					CryLog("LPV debug: culled from RSM: '%s' (%s) dist %.1f maxViewDist %.1f markedThisFrame %d cascadeBits 0x%x pos (%.0f, %.0f, %.0f)",
+					       pObj->GetName(), pObj->GetEntityClassName(),
+					       fEntDistance, pObj->m_fWSMaxViewDist,
+					       (int)(pObj->m_onePassTraversalFrameId == passInfo.GetMainFrameID()),
+					       pObj->m_onePassTraversalShadowCascades,
+					       c.x, c.y, c.z);
+				}
+			}
+			return;
+		}
+	}
+}
