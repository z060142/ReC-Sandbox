diff --git a/Code/CryEngine/RenderDll/Common/RendererResources.cpp b/Code/CryEngine/RenderDll/Common/RendererResources.cpp
index 77ada394..909615eb 100644
--- a/Code/CryEngine/RenderDll/Common/RendererResources.cpp
+++ b/Code/CryEngine/RenderDll/Common/RendererResources.cpp
@@ -483,6 +483,20 @@ bool CRendererResources::IsSceneReferred()
 	return pRequest != nullptr && pRequest->GetParam() > 0.5f;
 }
 
+const float CRendererResources::kSceneReferredMidGrey = 0.18f;
+
+// D11's one line of arithmetic, in one place, so that seven effects cannot each grow their own
+// slightly different idea of what a threshold means. The apply sites call this and store the
+// result; nothing downstream - no shader, no constant layout, no serialised default - knows the
+// difference.
+float CRendererResources::ResolveThreshold(float stored)
+{
+	if (!IsSceneReferred())
+		return max(stored, 0.0f);
+
+	return kSceneReferredMidGrey * powf(2.0f, clamp_tpl(stored, -6.0f, 16.0f));
+}
+
 // The working space of the HDR TARGET, which is a third question again: the scene-referred path
 // can be running while r_SceneReferredDebug 1 deliberately leaves the buffer in Rec.709 for an
 // A/B. Everything that reads the target's CONTENTS - the per-view luminance weights, and any
diff --git a/Code/CryEngine/RenderDll/Common/RendererResources.h b/Code/CryEngine/RenderDll/Common/RendererResources.h
index b61b4160..77acaa3d 100644
--- a/Code/CryEngine/RenderDll/Common/RendererResources.h
+++ b/Code/CryEngine/RenderDll/Common/RendererResources.h
@@ -183,6 +183,30 @@ public:
 	//! Rec.709 because that is what the tooltip, the preset file and the picker all mean.
 	static Vec3        ToWorkingSpace(const Vec3& rec709);
 
+	//! Mid grey in the working space. After the pre-exposure a correctly exposed 18 % reflector
+	//! lands here by construction (SceneReferredSpec.md D6), which is what makes "stops above mid
+	//! grey" a meaning the renderer can act on rather than a figure of speech.
+	static const float kSceneReferredMidGrey;
+
+	//! A highlight-extraction threshold, in whatever unit is in force this frame
+	//! (SceneReferredSpec.md D11, Stage S7).
+	//!
+	//! OFF the scene-referred switch this is the identity: the parameter is an absolute value in
+	//! engine light units, exactly as every one of these effects has always read it, and not one
+	//! bit of the stock path moves.
+	//!
+	//! ON it the same stored number is read as STOPS ABOVE MID GREY. That is the physical unit -
+	//! how far above a correctly exposed grey card a highlight has to be before the glass, the
+	//! emulsion or the sensor does something visible with it - and it is the unit that makes the
+	//! setting survive a change of exposure, which an absolute number under a moving pre-exposure
+	//! cannot. It is also what a photographer already thinks in.
+	//!
+	//! The clamp is on the STOPS, so a slider whose range was chosen for absolute values (ghosts
+	//! and the front filter both go to 64) cannot ask for 2^64 and produce a constant that means
+	//! nothing. 16 stops above mid grey is already "never" for any real frame.
+	static float       ResolveThreshold(float stored);
+
+
 public:
 	static bool m_bLoadedSystem;
 
