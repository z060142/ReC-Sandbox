From 5a2cd5264937ad9c3d2e23bd534e2cb52a792dff Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sun, 21 Jun 2026 15:06:23 +0800
Subject: [PATCH 01/44] fix: VS2022/C++17 compatibility fixes for full engine +
 Sandbox build

Changes required to compile CryEngine 5.7.1 source with
Visual Studio 2022 Community (v17.14, MSVC 19.44):

CMakeSettings.json
- Update generator from "Visual Studio 15 2017 Win64" to
  "Visual Studio 17 2022" with explicit "platform": "x64"
  (the old Win64 suffix syntax is not supported in VS2022)

Code/Tools/CryCommonTools/FileUtil.cpp
- Add missing #include <chrono> needed for std::chrono_literals
  used on line 113; implicit inclusion via <thread> was removed
  in newer MSVC STL headers

Tools/CMake/CRYENGINE-MSVC.cmake
- Add /D_SILENCE_STDEXT_ARR_ITERS_DEPRECATION_WARNING to
  MSVC_COMMON_FLAGS so that Qt 5.12.3 headers (qlist.h) can
  compile cleanly; Qt uses stdext::make_checked_array_iterator
  which VS2022 STL marks deprecated (STL4043), and the existing
  /WX flag would otherwise promote that warning to an error

.gitignore
- Add /Engine/EngineAssets/**/*.dds to exclude DDS textures
  generated at runtime by the RC tool
- Add /vc140.pdb to exclude MSVC build artifact
- Add /documents/ and /doc_validation/ as directory ignores
  (previous glob patterns did not cover nested git repos)

Note: three additional patches in Code/SDKs/ (Alembic
ArraySampleKey.h, OculusSDK OVR_DebugHelp.cpp and
Util_SystemInfo.cpp) are required for a successful build but
cannot be tracked here because /Code/SDKs/* is gitignored.
See project memory for details.

Co-Authored-By: Claude Sonnet 4.6 <noreply@anthropic.com>
---
 .gitignore                             | 10 ++++++++++
 CMakeSettings.json                     | 11 +++++++----
 Code/Tools/CryCommonTools/FileUtil.cpp |  1 +
 Tools/CMake/CRYENGINE-MSVC.cmake       |  3 ++-
 4 files changed, 20 insertions(+), 5 deletions(-)

diff --git a/.gitignore b/.gitignore
index a079477a..bf0e26a1 100644
--- a/.gitignore
+++ b/.gitignore
@@ -38,3 +38,13 @@ __pycache__/*
 
 # These are handled elsewhere.
 /Code/SDKs/*
+
+# User documents and validation output.
+/documents/
+/doc_validation/
+
+# Compiled engine assets generated at runtime (DDS are processed/compiled textures).
+/Engine/EngineAssets/**/*.dds
+
+# MSVC build artifact dropped in repo root by older toolchains.
+/vc140.pdb
\ No newline at end of file
diff --git a/CMakeSettings.json b/CMakeSettings.json
index 92a88359..8b4d166f 100644
--- a/CMakeSettings.json
+++ b/CMakeSettings.json
@@ -3,23 +3,26 @@
    {
     "name": "Windows x64 Debug",
 	"configurationType": "Debug",
-    "generator": "Visual Studio 15 2017 Win64",
+    "generator": "Visual Studio 17 2022",
+    "platform": "x64",
     "buildRoot": "${projectDir}\\Solutions\\Win64_Debug",
 	"cmakeCommandArgs": "-D CMAKE_TOOLCHAIN_FILE=Tools\\CMake\\toolchain\\windows\\WindowsPC-MSVC.cmake"
    },
    {
     "name": "Windows x64 Profile",
 	"configurationType": "Profile",
-    "generator": "Visual Studio 15 2017 Win64",
+    "generator": "Visual Studio 17 2022",
+    "platform": "x64",
     "buildRoot": "${projectDir}\\Solutions\\Win64_Profile",
 	"cmakeCommandArgs": "-D CMAKE_TOOLCHAIN_FILE=Tools\\CMake\\toolchain\\windows\\WindowsPC-MSVC.cmake"
    },
    {
     "name": "Windows x64 Release",
 	"configurationType": "Release",
-    "generator": "Visual Studio 15 2017 Win64",
+    "generator": "Visual Studio 17 2022",
+    "platform": "x64",
     "buildRoot": "${projectDir}\\Solutions\\Win64_Release",
 	"cmakeCommandArgs": "-D CMAKE_TOOLCHAIN_FILE=Tools\\CMake\\toolchain\\windows\\WindowsPC-MSVC.cmake"
    }
  ]
-}
\ No newline at end of file
+}
diff --git a/Code/Tools/CryCommonTools/FileUtil.cpp b/Code/Tools/CryCommonTools/FileUtil.cpp
index 6886e944..46ab4e99 100644
--- a/Code/Tools/CryCommonTools/FileUtil.cpp
+++ b/Code/Tools/CryCommonTools/FileUtil.cpp
@@ -7,6 +7,7 @@
 
 #include <io.h>
 #include <CryString/CryPath.h>
+#include <chrono>
 #include <thread>
 
 namespace Private_FileUtil
diff --git a/Tools/CMake/CRYENGINE-MSVC.cmake b/Tools/CMake/CRYENGINE-MSVC.cmake
index 9b5ee4a9..5686535c 100644
--- a/Tools/CMake/CRYENGINE-MSVC.cmake
+++ b/Tools/CMake/CRYENGINE-MSVC.cmake
@@ -1,5 +1,5 @@
 
-set(MSVC_COMMON_FLAGS 
+set(MSVC_COMMON_FLAGS
 	/nologo     # Don't show version info
 	/W3         # Enable warning level 3
 	/fp:fast    # Use fast floating point precision model
@@ -16,6 +16,7 @@ set(MSVC_COMMON_FLAGS
 	/wd4275     # non dll-interface class '' used as base for dll-interface class ''
 	/wd4961     # No profile data was merged into '', profile-guided optimizations disabled
 	/wd4068     # 'Unknown pragma' - sometimes need these in code to prevent global suppression.
+	/D_SILENCE_STDEXT_ARR_ITERS_DEPRECATION_WARNING  # Qt 5.12.3 uses stdext::make_checked_array_iterator, deprecated in VS2022
 )
 string(REPLACE ";" " " MSVC_COMMON_FLAGS "${MSVC_COMMON_FLAGS}")
 
