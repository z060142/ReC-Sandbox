-// Integer hash. There are no hash or PRNG helpers anywhere in PostEffectsLib.cfi, ShadeLib.cfi
-// or Common.cfi, and 5.7.1 ships no blue-noise texture, so the generator brings its own.
-//
-// pcg3d (Jarzynski and Olano, Hash Functions for GPU Rendering, JCGT 2020): three well-mixed
-// 32-bit words out of three, passing the statistical tests the ad-hoc sin(dot(...)) hashes fail,
-// for a handful of integer operations. Everything that decides the pattern is integer, so the
-// field is bit-identical between runs on the same GPU - which is what makes a shot reproducible,
-// and what makes the offline re-synthesis of G3 possible at all.
-// ------------------------------------------------------------------------------------------
-uint3 FilmGrainHash3(uint3 v)
-{
-	v = v * 1664525u + 1013904223u;
-	v.x += v.y * v.z;
-	v.y += v.z * v.x;
-	v.z += v.x * v.y;
-	v ^= v >> 16u;
-	v.x += v.y * v.z;
-	v.y += v.z * v.x;
-	v.z += v.x * v.y;
-	return v;
-}
-
-// [0,1) from the top 24 bits - the low bits of any LCG-derived word are the weakest, and 24 bits
-// is already far more resolution than an 8-bit target can show.
-float FilmGrainUnorm(uint h)
-{
-	return (float)(h >> 8u) * (1.0 / 16777216.0);
-}
-
-// Box-Muller: two independent uniforms in, one unit-variance Gaussian out. The sine branch of the
-// transform is thrown away - the hash hands us a third word for nothing, so there is no saving in
-// carrying it, and one value per call keeps the four fields below independent by construction.
-float FilmGrainGaussian(uint3 key)
-{
-	const uint3 h = FilmGrainHash3(key);
-	// u1 is never allowed to be 0: log(0) is -inf, and one inf pixel is a white dot on screen.
-	const float u1 = max(FilmGrainUnorm(h.x), 1.0 / 16777216.0);
-	const float u2 = FilmGrainUnorm(h.y);
-	return sqrt(-2.0 * log(u1)) * cos(6.283185307 * u2);
-}
-
-// ------------------------------------------------------------------------------------------
-// Display encoding. Written out here in FLOAT rather than calling CommonMath.cfi's half3
-// LinearToSRGB / SRGBToLinear: the whole point of the block is a signal a few code values tall,
-// and a half-precision round trip through a power of 2.4 loses more than that.
-// ------------------------------------------------------------------------------------------
-float3 FilmGrainDecode(float3 d)
-{
-	return (d <= 0.04045) ? (d / 12.92) : pow(abs(d + 0.055) / 1.055, 2.4);
-}
-
-float3 FilmGrainEncode(float3 x)
-{
-	return (x <= 0.0031308) ? (x * 12.92) : (1.055 * pow(abs(x), 1.0 / 2.4) - 0.055);
-}
