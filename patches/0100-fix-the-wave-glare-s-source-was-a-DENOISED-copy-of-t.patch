-		m_passDiffractionThreshold.SetTexture(0, pHalfHDR);
+		m_passDiffractionThreshold.SetTexture(0, pGlareSrc);
 		m_passDiffractionThreshold.SetSampler(0, EDefaultSamplerStates::LinearClamp);
 	}
 
