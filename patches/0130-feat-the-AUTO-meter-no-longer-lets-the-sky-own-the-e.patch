@@ -248,7 +248,12 @@ enum ERenderQueryTypes
 //! log-means may all be computed in exposed units and converted once, at the end.
 struct SSceneReferredMeterHistogram
 {
-	enum { kBinCount = 64 };
+	enum
+	{
+		kBinCount    = 64,
+		kExtraCount  = 2,                       //!< sky accumulators after the bins (decisions/s8-metering-sky.md)
+		kColumnCount = kBinCount + kExtraCount, //!< width of the readback row, in uints
+	};
 
 	float  bins[kBinCount];      //!< accumulated metering weight per bin
 	float  totalWeight;          //!< sum of the bins; 0 means "no measurement, hold the last EV"
@@ -257,6 +262,12 @@ struct SSceneReferredMeterHistogram
 	float  logMaxStops;          //!< upper edge of the top bin, same units
 	uint32 sampleId;             //!< increments once per completed readback; 0 = never measured
 	uint32 meteringMode;         //!< the mask the accumulation actually used (0 Avg, 1 Centre, 2 Spot)
+	//! Sky bookkeeping (decisions/s8-metering-sky.md). The pass classifies a quarter-res texel as
+	//! sky when the 4x4 MINIMUM linear depth under it is the far plane, and multiplies its mask
+	//! weight by skyWeight before binning - the engine's form of a matrix meter's sky detection.
+	float  skyFraction;          //!< sky texels / frame texels, 0..1
+	float  skyMeterShare;        //!< the sky's share of totalWeight AFTER the down-weight, 0..1
+	float  skyWeight;            //!< the multiplier the accumulation actually used
 };
 
