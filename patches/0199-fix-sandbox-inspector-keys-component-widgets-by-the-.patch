From a347acc4fdc79d930703c447acad6647b058e935 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sat, 12 Sep 2026 02:07:54 +0800
Subject: [PATCH 199/209] fix(sandbox): inspector keys component widgets by the
 full GUID

CEntityObject::CreateComponentWidgets built each component's inspector widget
id from GetClassDesc().GetGUID().hipart plus the component type index - the low
half of the GUID was thrown away. CInspectorWidgetCreator reads a repeated id
as "the same widget contributed by several selected objects" and erases every
widget whose usage count is not the number of selected objects
(InspectorWidgetCreator.h:40-43, 72-78), so two DIFFERENT component types on
one entity whose GUIDs happen to share their high half do not merge into one
row: they blank the entire inspector for that entity.

That is not a freak accident. Component GUIDs are routinely allocated as a
series that varies only in the low half, so any two components authored
together are likely to collide - which is exactly how it was found, with two
components of CryPlugins/AreaComponents.

Fold both halves into the id instead: hipart ^ (lopart * 0x9E3779B97F4A7C15),
an odd multiplier so that neighbouring lopart values spread across the whole
word and cannot cancel. componentTypeIndex is still added last and unchanged,
so two INSTANCES of the same component type keep the distinct ids they had.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 Code/Sandbox/EditorQt/Objects/EntityObject.cpp | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/Code/Sandbox/EditorQt/Objects/EntityObject.cpp b/Code/Sandbox/EditorQt/Objects/EntityObject.cpp
index 9376ba6a..c232bf99 100644
--- a/Code/Sandbox/EditorQt/Objects/EntityObject.cpp
+++ b/Code/Sandbox/EditorQt/Objects/EntityObject.cpp
@@ -1104,7 +1104,20 @@ void CEntityObject::CreateComponentWidgets(CInspectorWidgetCreator& creator)
 		std::unique_ptr<CEntityComponentCollapsibleFrame> pWidget =
 			std::make_unique<CEntityComponentCollapsibleFrame>(szComponentLabel, pComponent->GetClassDesc(), componentTypeIndex, pComponent->GetComponentFlags().Check(EEntityComponentFlags::UserAdded));
 
-		creator.AddPropertyTree(pComponent->GetClassDesc().GetGUID().hipart + componentTypeIndex, szComponentLabel, std::move(pWidget), [componentClassGUID, componentTypeIndex](CBaseObject* pObject, Serialization::IArchive& ar, bool bMultiEdit)
+		// The widget id has to separate two DIFFERENT component types on the same entity, because
+		// CInspectorWidgetCreator reads a repeated id as "the same widget contributed by several
+		// selected objects" and then erases every widget whose usage count is not the number of
+		// selected objects (InspectorWidgetCreator.h:40-43, 72-78) - so a collision blanks the
+		// whole inspector rather than merging two rows. Using only GUID::hipart made that happen
+		// for any two component types whose GUIDs share their high half, which is not a freak
+		// accident: GUIDs are routinely allocated in a series that varies only in the low half.
+		// Fold both halves instead. The odd multiplier spreads the low half across the whole word
+		// so that neighbouring lopart values cannot cancel, and componentTypeIndex is still added
+		// last so that two INSTANCES of one type keep their distinct ids exactly as before.
+		const uint64 componentWidgetId = pComponent->GetClassDesc().GetGUID().hipart
+		                                 ^ (pComponent->GetClassDesc().GetGUID().lopart * 0x9E3779B97F4A7C15ull);
+
+		creator.AddPropertyTree(componentWidgetId + componentTypeIndex, szComponentLabel, std::move(pWidget), [componentClassGUID, componentTypeIndex](CBaseObject* pObject, Serialization::IArchive& ar, bool bMultiEdit)
 		{
 			CreateComponentWidget(static_cast<CEntityObject*>(pObject), componentClassGUID, componentTypeIndex, ar);
 		});
