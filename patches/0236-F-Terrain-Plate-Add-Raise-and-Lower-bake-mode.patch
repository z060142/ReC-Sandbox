From f179b9315d3f19db17d5ebb5559eb1790f2d2cfd Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Mon, 31 Aug 2026 03:34:53 +0800
Subject: [PATCH 236/307] !F (Terrain Plate) Add Raise-and-Lower bake mode.

Keep Raise as the default mode and add Raise-and-Lower for relief that may cut
below the original ground. Both modes retain the same footprint falloff and
baseline restoration path.
---
 .../Geometry/TerrainPlateComponent.cpp        | 34 +++++++++++++++++--
 .../Geometry/TerrainPlateComponent.h          | 23 +++++++++++++
 2 files changed, 54 insertions(+), 3 deletions(-)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index ac25d047..b6ee7954 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -1768,6 +1768,7 @@ void CTerrainPlateComponent::ComputeBakeBlock(const SBakeTerrainMetrics& metrics
 				continue; // outside the rotated plate: this cell keeps the original ground
 
 			float plateMin = centreZ;
+			int   samplesTaken = 0;
 			for (int sx = 0; sx < samplesPerAxis; ++sx)
 			{
 				for (int sy = 0; sy < samplesPerAxis; ++sy)
@@ -1779,6 +1780,7 @@ void CTerrainPlateComponent::ComputeBakeBlock(const SBakeTerrainMetrics& metrics
 					if (SamplePlateSurface(worldTM, px, py, z, ignoreX, ignoreY))
 					{
 						plateMin = min(plateMin, z);
+						++samplesTaken;
 					}
 				}
 			}
@@ -1786,9 +1788,35 @@ void CTerrainPlateComponent::ComputeBakeBlock(const SBakeTerrainMetrics& metrics
 			const size_t index = (size_t)ux * dim + uy;
 			const float baseline = m_bakeBaseline[index];
 
-			// Raise only, and never above the mesh: decision 04 rule 1. Raise-and-lower is a Bake Mode
-			// in step 3.
-			const float combined = max(baseline, plateMin - kBakeEpsilonMeters);
+			// The plate surface the terrain is asked to meet, kept the epsilon below the mesh so the two
+			// can never fight (decision 04 rule 1).
+			const float plateSurface = plateMin - kBakeEpsilonMeters;
+
+			// Bake Mode.
+			//  * Raise:          max(baseline, plate). Where the plate is above the old ground the terrain
+			//                    comes up to it; where the plate is below, the old ground stays and pokes
+			//                    through the plate mesh. This is what step 2 did and it is still the
+			//                    default, because it can only ever add ground and is therefore safe on a
+			//                    level someone else authored.
+			//  * RaiseAndLower:  the plate surface, above or below. A valley modelled into the plate is cut
+			//                    into the terrain. Above the old ground the two modes are identical; below
+			//                    it, this one digs and Raise does not.
+			//
+			// Lowering is gated on the cell being FULLY covered by the plate. A cell at the edge of a
+			// rotated plate has only part of its footprint over the plate, and lowering it would dig
+			// outside the plate; the coverage weight fades the lowering out there, so a partly covered
+			// cell is never taken below the ground. The rim falloff below then blends the whole thing back
+			// to the baseline over the Weld Inner Falloff band, exactly as in Raise mode - so the border of
+			// the footprint is still the original ground, in both modes.
+			const float raised = max(baseline, plateSurface);
+			float combined = raised;
+
+			if (m_bakeMode == ETerrainPlateBakeMode::RaiseAndLower)
+			{
+				const int totalSamples = samplesPerAxis * samplesPerAxis;
+				const float coverage = (totalSamples > 0) ? clamp_tpl((float)samplesTaken / (float)totalSamples, 0.f, 1.f) : 0.f;
+				combined = raised + (plateSurface - raised) * coverage;
+			}
 
 			// Cosine falloff to the baseline over the rim, the curve CRYENGINE itself uses for the road
 			// falloff (RoadObject.cpp:631-635), so the border of the footprint is the baseline exactly.
diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
index 23d20f50..9e9fc868 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
@@ -112,6 +112,22 @@ static void ReflectType(Schematyc::CTypeDesc<ETerrainPlateGridMode>& desc)
 	desc.AddConstant(ETerrainPlateGridMode::Spacing, "Spacing", "Spacing");
 }
 
+enum class ETerrainPlateBakeMode
+{
+	Raise = 0,
+	RaiseAndLower,
+};
+
+static void ReflectType(Schematyc::CTypeDesc<ETerrainPlateBakeMode>& desc)
+{
+	desc.SetGUID("{4D8B1E60-3C79-45A2-9E31-0B6F2A84D5C7}"_cry_guid);
+	desc.SetLabel("Terrain Plate Bake Mode");
+	desc.SetDescription("How the baked terrain meets the original ground");
+	desc.SetDefaultValue(ETerrainPlateBakeMode::Raise);
+	desc.AddConstant(ETerrainPlateBakeMode::Raise, "Raise", "Raise");
+	desc.AddConstant(ETerrainPlateBakeMode::RaiseAndLower, "RaiseAndLower", "Raise And Lower");
+}
+
 //! Terrain metrics of the current level, in terrain units. Invalid when there is no terrain.
 //! Namespace scope rather than a member type, so that the file local bake helpers can take one.
 struct SBakeTerrainMetrics
@@ -241,6 +257,12 @@ public:
 		               "code at all. Turning it off (or moving, rescaling or deleting the plate) puts the original ground back first.",
 		               false);
 
+		desc.AddMember(&CTerrainPlateComponent::m_bakeMode, 'bmod', "BakeMode", "Bake Mode",
+		               "Raise: the terrain only ever goes up to meet the plate, so a plate that dips below the original ground leaves "
+		               "that ground alone (and the old ground then pokes through the plate mesh). Raise And Lower: the terrain follows "
+		               "the plate down as well, so a valley modelled into the plate is cut into the terrain. Either way the rim of the "
+		               "footprint blends back to the original ground, and a cell the plate only partly covers is never lowered.",
+		               ETerrainPlateBakeMode::Raise);
 		desc.AddMember(&CTerrainPlateComponent::m_bakePriority, 'bpri', "BakePriority", "Bake Priority",
 		               "Order in which overlapping baking plates are written into the terrain: the higher priority plate bakes last "
 		               "and therefore wins where two footprints meet, with the lower one showing through as the ground it sits on. "
@@ -371,6 +393,7 @@ protected:
 	Schematyc::Range<0, 1000, 0, 20, float>      m_skirt = 0.25f;
 	bool                                         m_bUpdateDuringDrag = false;
 	bool                                         m_bBakeIntoTerrain = false;
+	ETerrainPlateBakeMode                        m_bakeMode = ETerrainPlateBakeMode::Raise;
 	Schematyc::Range<-128, 127, -128, 127, int>  m_bakePriority = 0;
 
 	// Cached state, never serialised: the mesh is always rebuilt on load.
