+		desc.AddMember(&CDistributorComponent::m_bakeButton, 'bake', "BakeToBrushes", "Bake To Brushes", "Turn the instances into real, individually editable brush objects. Not implemented yet - see the report.", Serialization::FunctorActionButton<std::function<void()>>());
+
+		// Resource-name members last (see SDistributorMesh above).
