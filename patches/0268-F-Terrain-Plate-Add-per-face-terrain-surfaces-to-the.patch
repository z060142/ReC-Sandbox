 	// holding a part built from the old mesh. IStatObj::SetPhysGeom(nullptr) is the accessor that does
 	// unregister (StatObj.h:402), and the slot part must be removed before that, because
 	// CEntityPhysics::RemoveSlotGeometry decides what to remove from the statobj's phys geom.
-	// Decision 09. Sampled here, before the physics geometry exists, because the ids are an input to it:
-	// this is where the per face table of step 2 is solved. The rays are terrain only and cost nothing
-	// next to the mesh generation above, and this is the one place that always runs when the plate moves,
-	// is rescaled or is regenerated - i.e. exactly when the ground under it may be a different layer.
+	// Decision 09, option A2. The per face surface ids are an INPUT to the collision trimesh, so both the
+	// mesh snapshot and the sampling have to happen here, while the indexed mesh is still alive -
+	// Invalidate() below frees it (StatObjConstr.cpp:697). The snapshot is the whole mesh, culled
+	// triangles included: P18's rule is that a buried triangle leaves the drawn subset and stays in the
+	// physics trimesh, and building the trimesh by hand must not quietly change that.
+	//
+	// Note the ORDER: totalIndexCount, not visibleIndexCount, and the two subsets are irrelevant here.
+	// The render mesh is untouched by all of this - it stays one chunk with nMatID 0, so no draw call is
+	// added and the terrain integration path sees exactly what it saw before.
+	bool bPhysMeshCached = false;
+	if (bPhysicalize && IsPhysSurfaceFromTerrainEnabled())
+	{
+		bPhysMeshCached = CachePhysicsMesh(pPositions, totalVertexCount, pIndices, totalIndexCount);
+	}
+	else
+	{
+		// Type changed to Render, the property or the cvar turned off: drop the snapshot, so that nothing
+		// downstream can build a per face trimesh out of a mesh that is no longer the current one.
+		ReleasePhysicsMeshCache();
+	}
+
 	BuildPhysicsSurfaceMapping();
 
+	// Built BEFORE the old trimesh is dropped, so that a failure here cannot leave the plate without
+	// collision: on null the stock Invalidate(true) path below runs exactly as it always has.
+	phys_geometry* pPerFacePhysGeom = bPhysMeshCached ? CreatePhysicsGeometryFromCache() : nullptr;
+
 	ReleasePhysicsGeometry();
 
-	m_pStatObj->Invalidate(bPhysicalize);
+	if (pPerFacePhysGeom != nullptr)
+	{
+		m_pStatObj->SetPhysGeom(pPerFacePhysGeom, PHYS_GEOM_TYPE_DEFAULT);
+	}
+
+	m_pStatObj->Invalidate(bPhysicalize && pPerFacePhysGeom == nullptr);
+
+	// The cache only exists for the editor's repaint probe, which rebuilds the trimesh without
+	// regenerating the mesh. Nothing can repaint a layer at run time, so a launcher build gives the
+	// memory straight back.
+	if (gEnv == nullptr || !gEnv->IsEditor())
+	{
+		ReleasePhysicsMeshCache();
+	}
 
 	// CStatObj::PhysicalizeGeomType builds the trimesh with 16 bit indices and bails out on the first
 	// index >= 0xffff (StatObjPhys.cpp:166), so a plate denser than 65535 vertices silently ends up
@@ -3259,6 +3296,43 @@ bool CTerrainPlateComponent::GetCommitAppearance(SAppearance& outAppearance) con
 	return true;
 }
 
+//! Decision 08, the live terrain colour overlay. Everything here is READ ONLY and derived from the
+//! plate's current state: the overlay owns no data on the plate at all, because the thing it paints is a
+//! cache (the engine's terrain colour atlas) whose truth is the level's own CRGBLayer. There is no
+//! baseline to capture and nothing to restore - the editor marks the terrain texture sectors dirty and
+//! the engine's own pull repaints them from the untouched source. @see
+//! Sandbox/EditorQt/Terrain/TerrainPlateColourOverlay.h.
+//!
+//! The footprint, the tint and the albedo switch are the SAME ones GetCommitAppearance /
+//! GetCommitAppearanceFootprint give terrain.commit_plate_colour, and the editor evaluates the rim with
+//! the same GetCommitWeightAtWorld - so the preview is the commit, before the commit.
+bool CTerrainPlateComponent::GetLiveColourState(int& outX1, int& outY1, int& outSize, ColorB& outTint,
+                                                bool& outUseAlbedo, bool& outSettling) const
+{
+	// Bake Into Terrain gates it because the tick box lives in the Bake drawer, and that drawer is absent
+	// while Bake Into Terrain is off (@see Serialize(IArchive&, STerrainPlateBakeGroup&, ...)). A colour
+	// the user cannot see the switch for would be a trap.
+	if (!m_bLiveTerrainColour || !m_bBakeIntoTerrain)
+		return false;
+
+	SAppearance appearance;
+	if (!GetCommitAppearance(appearance) || !appearance.bWriteColour)
+		return false;
+
+	if (!GetCommitAppearanceFootprint(outX1, outY1, outSize) || outSize <= 0)
+		return false;
+
+	outTint = appearance.tint;
+	outUseAlbedo = appearance.bUseAlbedo;
+
+	// The debounce input. Every dirty terrain texture sector is a whole tile DXT recompress plus an
+	// upload, so a drag must not repaint per frame. These are exactly the flags the plate's own deferred
+	// rebuild rides on, so the colour settles on the same event the relief does: the drop, or the settle
+	// fallback e_TerrainPlateSettleFrames frames later.
+	outSettling = m_bDeferredXformPending || m_bBakeMoveBatchPending || m_bRegenPending;
+	return true;
+}
