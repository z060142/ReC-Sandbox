 {
 	// ORDER MATTERS - decision 07 settled fact 8 / research 12 section 2.6. The committed ground has to
@@ -4566,9 +4640,47 @@ int CTerrainPlateComponent::SampleFootprintSurfaceTypes(uint32& outHash) const
