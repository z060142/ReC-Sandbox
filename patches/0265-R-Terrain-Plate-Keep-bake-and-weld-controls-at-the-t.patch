 {
 	void Serialize(Serialization::IArchive& archive);
 };
 
-//! Weld: sealing the border against the terrain. The three tuning rows only appear once the weld is on.
+//! Weld: the three tuning rows of the weld. The drawer itself only exists while Edge Weld is on; the
+//! tick box is a top level row of its own and is not drawn here.
 struct STerrainPlateWeldGroup : public STerrainPlateUIGroup
 {
 	void Serialize(Serialization::IArchive& archive);
@@ -250,6 +269,17 @@ static void ReflectType(Schematyc::CTypeDesc<STerrainPlateEditorGroup>& desc)
 	desc.SetDescription("Panel grouping only, holds no data");
 }
 
+//! Free serialization overloads for the two conditional drawers. yasli looks a type's serialization up
+//! by ADL and prefers this non template four argument overload over the member Serialize()
+//! (yasli/Archive.h:325 -> :404; both names are "Serialize" here, ConfigLocal.h:22-23). Because it runs
+//! before the member's row is created and owns the row's name and label, returning false emits NOTHING:
+//! the drawer is absent rather than an empty collapsible line. When the tick box is on it hands the value
+//! straight back to the ordinary struct path, so the drawer looks exactly like any other nested settings
+//! row. Defined in the .cpp because they read the component's own members.
+//! @see STerrainPlateUIGroup for the whole grouping mechanism.
+bool Serialize(Serialization::IArchive& archive, STerrainPlateBakeGroup& value, const char* szName, const char* szLabel);
+bool Serialize(Serialization::IArchive& archive, STerrainPlateWeldGroup& value, const char* szName, const char* szLabel);
+
 //! A procedural grid mesh built from a heightmap, hosted in an entity slot so that it reaches the
