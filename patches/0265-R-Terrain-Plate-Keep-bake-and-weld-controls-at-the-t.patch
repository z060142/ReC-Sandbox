--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
@@ -177,6 +177,23 @@ class CTerrainPlateComponent;
 //! The groups below own no data at all: each holds a back pointer to the component and, in the editor
 //! archive only, emits the very same members again with their real labels.
 //!
+//! The two master tick boxes are the exception (user 2026-09-01: "Bake into terrain is always there,
+//! ticking it makes the Bake drawer appear, same for edge weld"). Bake Into Terrain and Edge Weld keep
+//! their real label on their own AddMember, so they render as ordinary TOP LEVEL rows, and their
+//! AddMember was moved to sit immediately in front of the drawer they open - the panel rows follow the
+//! AddMember order, so that is the only way to place a row. Neither of them is drawn by a group any more,
+//! so neither has a hidden duplicate row.
+//!
+//! A drawer that must be ABSENT, not empty, when its tick box is off cannot be done with the label trick:
+//! a member's label comes from AddMember and is fixed, and an empty group row would still take a line
+//! (an invisible row takes its whole subtree with it - PropertyRow.cpp:665 - so an invisible wrapper is
+//! no good either). What decides whether a row exists at all is the free serialization overload
+//! Serialize(IArchive&, T&, name, label), which yasli prefers over the member Serialize()
+//! (yasli/Archive.h:404 vs the non template overload; the names come from ConfigLocal.h:22-23). It runs
+//! BEFORE any row for the member is created and may simply return false, in which case nothing is emitted
+//! at all. Precedent for the idiom in the same include tree: CrySerialization/ColorImpl.h:37,
+//! CryStringsImpl.h:40, CRCRefImpl.h:60. @see Serialize(IArchive&, STerrainPlateBakeGroup&, ...) below.
+//!
 //! Two rules keep that safe:
 //!  * the four group members are AddMember'd AFTER every member they show. A property tree input pass
 //!    walks the rows in AddMember order, so the hidden row writes back the value it was last refreshed
@@ -204,13 +221,15 @@ struct STerrainPlateShapeGroup : public STerrainPlateUIGroup
 	void Serialize(Serialization::IArchive& archive);
 };
 
-//! Bake: writing the plate into the live terrain. The three tuning rows only appear once the bake is on.
+//! Bake: the three tuning rows of the bake. The drawer itself only exists while Bake Into Terrain is
+//! ticked; the tick box is a top level row of its own and is not drawn here.
