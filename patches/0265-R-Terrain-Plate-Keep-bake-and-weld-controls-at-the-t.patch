Date: Wed, 2 Sep 2026 06:04:31 +0800
Subject: [PATCH 265/307] !R (Terrain Plate) Keep bake and weld controls at the
 top level.

Leave Bake Into Terrain and Edge Weld as top-level switches and show their
grouped settings only while enabled. Serialization names and stored values are
unchanged.
---
 .../Geometry/TerrainPlateComponent.cpp        | 62 ++++++++++-----
 .../Geometry/TerrainPlateComponent.h          | 75 +++++++++++++++----
 2 files changed, 104 insertions(+), 33 deletions(-)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index b2652603..bc6db6be 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -977,39 +977,65 @@ void STerrainPlateShapeGroup::Serialize(Serialization::IArchive& archive)
 	archive(plate.m_bMirrorY, "MirrorY", "Mirror Y");
 }
 
+// The Bake drawer. Its master tick box, Bake Into Terrain, is a top level row of its own and is
+// deliberately NOT drawn here - the drawer as a whole only exists while that tick box is on, so a row
+// for it inside the drawer would be a row the user could never reach to switch off again. The Commit
+// Bake rows stay parked (see scene-notes/terrain/reports/31-commit-ui-parked.md): they are not drawn
+// here either, and are still persisted by their own AddMember.
 void STerrainPlateBakeGroup::Serialize(Serialization::IArchive& archive)
 {
 	if (!archive.isEdit() || m_pOwner == nullptr)
 		return;
 
 	CTerrainPlateComponent& plate = *m_pOwner;
-	archive(plate.m_bBakeIntoTerrain, "BakeIntoTerrain", "Bake Into Terrain");
-
-	// The three tuning rows only mean anything while the bake is on, so they only appear then.
-	// The Commit Bake rows stay parked (see scene-notes/terrain/reports/31-commit-ui-parked.md):
-	// they are deliberately not drawn here either, and are still persisted by their own AddMember.
-	if (plate.m_bBakeIntoTerrain)
-	{
-		archive(plate.m_bakeMode, "BakeMode", "Bake Mode");
-		archive(plate.m_bakePriority, "BakePriority", "Bake Priority");
-		archive(plate.m_bakeOffset, "BakeOffset", "Bake Offset");
-	}
+	archive(plate.m_bakeMode, "BakeMode", "Bake Mode");
+	archive(plate.m_bakePriority, "BakePriority", "Bake Priority");
+	archive(plate.m_bakeOffset, "BakeOffset", "Bake Offset");
 }
 
+// The Weld drawer. Edge Weld itself is a top level row, same as Bake Into Terrain above.
 void STerrainPlateWeldGroup::Serialize(Serialization::IArchive& archive)
 {
 	if (!archive.isEdit() || m_pOwner == nullptr)
 		return;
 
 	CTerrainPlateComponent& plate = *m_pOwner;
-	archive(plate.m_bEdgeWeld, "EdgeWeld", "Edge Weld");
+	archive(plate.m_weldSink, "WeldSink", "Weld Sink");
+	archive(plate.m_weldInnerFalloff, "WeldInnerFalloff", "Weld Inner Falloff");
+	archive(plate.m_skirt, "Skirt", "Skirt");
+}
 
-	if (plate.m_bEdgeWeld)
-	{
-		archive(plate.m_weldSink, "WeldSink", "Weld Sink");
-		archive(plate.m_weldInnerFalloff, "WeldInnerFalloff", "Weld Inner Falloff");
-		archive(plate.m_skirt, "Skirt", "Skirt");
-	}
+// ---------------------------------------------------------------------------------------------------
+// The two conditional drawers: present when their tick box is on, ABSENT (not empty) when it is off.
+//
+// yasli resolves a type's serialization through the free four argument overload in preference to the
+// member Serialize() (yasli/Archive.h:325 dispatches to :404, and the non template overload below wins
+// over that template; both names are "Serialize" because of ConfigLocal.h:22-23). This overload runs
+// before the property tree has created any row for the member and owns the row's name and label, so
+// returning false without touching the archive means no row is created at all. That is the only way to
+// suppress a whole member row: a member's label is fixed at AddMember time, and hiding a row by emptying
+// its label is not available here.
+//
+// Returning false also keeps these two out of every non panel archive (level save and load, prefabs,
+// copy paste, undo, the Schematyc scratchpad), which is what the isEdit() guard did before. The groups
+// hold no data, so nothing is lost: the values of the rows they draw are persisted by their own
+// AddMember whether the drawer is open, closed or absent.
+bool Serialize(Serialization::IArchive& archive, STerrainPlateBakeGroup& value, const char* szName, const char* szLabel)
+{
+	if (!archive.isEdit() || value.m_pOwner == nullptr || !value.m_pOwner->m_bBakeIntoTerrain)
+		return false;
+
+	Serialization::SStruct ser(value);
+	return archive(ser, szName, szLabel);
+}
+
+bool Serialize(Serialization::IArchive& archive, STerrainPlateWeldGroup& value, const char* szName, const char* szLabel)
+{
+	if (!archive.isEdit() || value.m_pOwner == nullptr || !value.m_pOwner->m_bEdgeWeld)
+		return false;
+
+	Serialization::SStruct ser(value);
+	return archive(ser, szName, szLabel);
 }
 
