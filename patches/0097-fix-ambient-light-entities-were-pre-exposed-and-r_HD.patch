+// WHICH contributors the pre-exposure actually reaches (SceneReferredSpec.md D3, S8).
+//
+// The exposure is applied on the LIGHT side, at the m_fAdaptedSceneScaleLBuffer sites, the sky
+// stage, and the per-view CV_SceneExposure that the forward and emissive writers multiply by. A
+// contributor that goes round all three - SVOGI's own light injection, the legacy fog's inscatter
+// colour - is exposure-INVARIANT, which does not look like a bug. It looks like the aperture
+// having no effect on the shadows, because the thing filling the shadows is the one thing not
+// following, and it is a symptom nothing in the picture explains.
+//
+// So the frame says so itself, computed from the live switch and cvar state rather than from a
+// comment that can go stale. A cross does not mean broken; it means "this one is still on the S8
+// list, and if the shadows do not respond, it is this".
+void CToneMappingStage::DisplaySceneReferredCoverage()
+{
+	const auto cvarOn = [](const char* szName) -> bool
+	{
+		ICVar* pVar = gEnv->pConsole ? gEnv->pConsole->GetCVar(szName) : nullptr;
+		return pVar != nullptr && pVar->GetIVal() != 0;
+	};
+
+	// Only what is actually contributing to THIS frame is listed: a line full of crosses for
+	// features that are switched off would send the reader chasing the wrong one.
+	const bool bSvo   = cvarOn("e_svoTI_Apply") && cvarOn("e_svoTI_Active");
+	const bool bFog   = cvarOn("e_Fog");
+	const bool bVFog  = cvarOn("e_VolumetricFog");
+
+	char str[256];
+	cry_sprintf(str, "  pre-exposure reaches: sun+lights YES  probes YES (tint; re-bake for PI)  sky YES  forward/emissive YES");
+	IRenderAuxText::DrawText(Vec3(5, 155, 1), IRenderAuxText::ASize(1.0f), ColorF(1, 0, 1, 1), eDrawText_800x600 | eDrawText_2D, str);
+
+	cry_sprintf(str, "  NOT reached (S8): SVOGI %s  global fog %s  volumetric fog sun/height %s   | ambient lights: n/a, they modulate",
+	            bSvo  ? "ON  <- shadow filler, try e_svoTI_Apply 0" : "off",
+	            bFog  ? "ON  <- try e_Fog 0"                        : "off",
+	            bVFog ? "ON"                                        : "off");
+	IRenderAuxText::DrawText(Vec3(5, 175, 1), IRenderAuxText::ASize(1.0f), ColorF(1, 0, 1, 1), eDrawText_800x600 | eDrawText_2D, str);
+}
