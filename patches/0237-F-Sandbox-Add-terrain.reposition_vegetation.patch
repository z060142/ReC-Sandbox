+void CVegetationMap::RepositionInstancesOnTerrain(const AABB& box, int& outMoved, int& outSkipped)
+{
+	// Below this difference an instance is already considered to be sitting on the ground.
+	const float kZTolerance = 0.001f;
+
+	outMoved = 0;
+	outSkipped = 0;
+
+	const float x1 = min(box.min.x, box.max.x);
+	const float y1 = min(box.min.y, box.max.y);
+	const float x2 = max(box.min.x, box.max.x);
+	const float y2 = max(box.min.y, box.max.y);
+
+	const int sx1 = max(int(x1 * m_worldToSector), 0);
+	const int sy1 = max(int(y1 * m_worldToSector), 0);
+	const int sx2 = min(int(x2 * m_worldToSector), m_numSectors - 1);
+	const int sy2 = min(int(y2 * m_worldToSector), m_numSectors - 1);
+
+	I3DEngine* p3DEngine = GetIEditorImpl()->Get3DEngine();
+	if (!p3DEngine)
+		return;
+
+	for (int sectY = sy1; sectY <= sy2; ++sectY)
+	{
+		for (int sectX = sx1; sectX <= sx2; ++sectX)
+		{
+			// RegisterInstance() never changes the XY position, so the sector list stays valid while
+			// it is being iterated.
+			SectorInfo& sector = GetVegSector(sectX, sectY);
+			for (auto pInst : sector)
+			{
+				if (pInst->pos.x < x1 || pInst->pos.x > x2 || pInst->pos.y < y1 || pInst->pos.y > y2)
+					continue;   // outside of the requested area, not reported at all
+
+				if (!pInst->object || pInst->object->IsAffectedByBrushes() || !pInst->object->IsAffectedByTerrain())
+				{
+					// Anchored to a brush or explicitly detached from the terrain: same rule as
+					// OnHeightMapChanged().
+					++outSkipped;
+					continue;
+				}
+
+				// The live engine terrain, not the editor CHeightmap: this is what picks up an
+				// engine side SetTerrainElevation (e.g. a terrain plate bake).
+				const float terrainZ = p3DEngine->GetTerrainElevation(pInst->pos.x, pInst->pos.y);
+				if (fabs(terrainZ - pInst->pos.z) < kZTolerance)
+				{
+					++outSkipped;
+					continue;
+				}
+
+				RecordUndo(pInst);
+				pInst->pos.z = terrainZ;
+
+				// Destroys and re-adds the render node. For auto-merged objects this re-adds the
+				// merged-mesh sample (CTerrain::AddVegetationInstance -> CMergedMeshesManager::AddInstance)
+				// with a freshly sampled terrain alignment, which is the only way to move merged-mesh
+				// grass. It also rebuilds the ground decal.
+				RegisterInstance(pInst);
+				++outMoved;
+			}
+		}
+	}
+}
+
 void CVegetationMap::RecordUndo(CVegetationInstance* pInst)
 {
 	if (CUndo::IsRecording())
diff --git a/Code/Sandbox/EditorQt/Vegetation/VegetationMap.h b/Code/Sandbox/EditorQt/Vegetation/VegetationMap.h
index c2a1d742..3450d80d 100644
--- a/Code/Sandbox/EditorQt/Vegetation/VegetationMap.h
+++ b/Code/Sandbox/EditorQt/Vegetation/VegetationMap.h
@@ -138,6 +138,16 @@ public:
 	//! Remove objects within specified area from 3D engine and then place it back again on top of terrain.
 	void RepositionArea(const AABB& box, const Vec3& offset = Vec3(0, 0, 0), int nRot = 0, bool isCopy = false);
 
+	//! Re-sample the Z of every vegetation instance inside \p box from the CURRENT ENGINE terrain and
+	//! re-register it. Unlike OnHeightMapChanged(), auto-merged (merged-mesh) instances are handled as
+	//! well, because the re-registration goes through RegisterInstance(), which destroys and re-adds the
+	//! render node resp. the merged-mesh sample.
+	//! XY positions are never changed, so no sector re-bucketing and no duplicate removal is needed.
+	//! \param box   World space area to process. Only XY is used, Z is ignored.
+	//! \param outMoved   Number of instances whose Z was changed.
+	//! \param outSkipped Number of instances inside the area that were left untouched.
+	void RepositionInstancesOnTerrain(const AABB& box, int& outMoved, int& outSkipped);
+
 	//! Scale all instances of this objects.
 	void ScaleObjectInstances(CVegetationObject* object, float fScale, AABB* outModifiedArea = NULL);
 	//! Randomly rotate all instances of this objects.
