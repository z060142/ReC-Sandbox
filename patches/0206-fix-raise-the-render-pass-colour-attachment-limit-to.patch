From 4471468570406c3996700eeb525e954a3029ddeb Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Mon, 14 Sep 2026 04:32:22 +0800
Subject: [PATCH 206/217] fix: raise the render pass colour attachment limit to
 the API's 8

CDeviceRenderPassDesc::MaxRendertargetCount was 4, and CDeviceRenderPassDesc::SetRenderTarget
indexes m_renderTargets[slot] with no clamp. Stock CE never binds above slot 3, so the constant
was never wrong in the shipped engine - but rt stage 4A added the HITGI g-data target at slot 4
(D3D_SVO.cpp ConeTracePass), which writes one element PAST THE END of a four element std::array
and lands in the adjacent m_outputUAVs member. GetDeviceRendertargetViews only ever walked the
four in-bounds entries, so the shader's SV_Target4 also had nothing bound to it.

Raised to 8, the colour attachment limit of D3D11, D3D12 and Vulkan alike, which makes it the
ceiling of the API rather than a new engine constant. Every other use of the value is derived
from it - the D3D11 / D3D12 / Vulkan view arrays, the non-release format validation array, the
pass hash input, the Vulkan attachment and image view arrays, RenderPassScheduler's clear loop -
so nothing else had to change. Slots 4-7 stay null on every stock pass, so no stock pass's hash,
PSO or attachment list moves.

rt stage 5B needs slot 5 for the HITMAT target and could not have worked without this.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SCUvWGLCsqzm3VNMzp4uiS
---
 .../XRenderD3D9/DeviceManager/DeviceRenderPass.h     | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/DeviceManager/DeviceRenderPass.h b/Code/CryEngine/RenderDll/XRenderD3D9/DeviceManager/DeviceRenderPass.h
index a0c6a778..acf40aba 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/DeviceManager/DeviceRenderPass.h
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/DeviceManager/DeviceRenderPass.h
@@ -12,7 +12,17 @@ class TMP_RENDER_API CDeviceRenderPassDesc : NoCopy
 	friend class CDeviceObjectFactory;
 
 public:
-	enum { MaxRendertargetCount = 4 };
+	// rt stage 5B. Was 4. Stock CE never binds a slot above 3, but the SVO ray tracing
+	// ConeTracePass does: stage 4A added the HITGI target at slot 4 and stage 5B adds HITMAT at
+	// slot 5, and SetRenderTarget indexes m_renderTargets[slot] unconditionally - with the old
+	// value that is a write PAST THE END of a 4 element std::array, straight into m_outputUAVs,
+	// and GetDeviceRendertargetViews never saw the target at all. 8 is the D3D11 / D3D12 /
+	// Vulkan colour attachment limit, so this is the ceiling of the API rather than a new one.
+	// Every other use of the constant is derived from it (the view arrays, the format
+	// validation array, the hash input, the Vulkan attachment arrays), so raising it costs a
+	// few pointers per render pass object and changes no behaviour on any stock pass: slots
+	// 4-7 stay null everywhere except here.
+	enum { MaxRendertargetCount = 8 };
 	enum { MaxOutputUAVCount = 3 };
 
 	struct SHash { uint64 operator() (const CDeviceRenderPassDesc& desc)                                  const; };
