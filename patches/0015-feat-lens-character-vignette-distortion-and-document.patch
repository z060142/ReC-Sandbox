+float4 vLensDistortionParams;  // x = k1 (positive barrel, negative pincushion), y = aspect
+
+// Corner anchored radial distortion: corners stay put so neither direction leaves borders,
+// the interior magnifies (barrel) or shrinks (pincushion) around the centre.
+float2 LensDistortUV(float2 tc)
+{
+	const float k1 = vLensDistortionParams.x;
+	const float aspect = vLensDistortionParams.y;
+
+	float2 d = tc - 0.5;
+	d.x *= aspect;
+
+	// Anchor choice keeps every sample inside [0,1] for BOTH signs: barrel (k1>0) anchors
+	// the corners (interior shrinks inward), pincushion (k1<0) anchors the inscribed circle
+	// (edge midpoints fixed, corners pulled inward) - otherwise the edge midpoints overshoot
+	// the border and clamp into smears.
+	const float anchorR2 = k1 >= 0.0 ? 0.25 * (aspect * aspect + 1.0) : 0.25;
+	const float r2 = dot(d, d) / anchorR2;
+	d *= (1.0 + k1 * r2) / (1.0 + k1);
+	d.x /= aspect;
+	return d + 0.5;
+}
