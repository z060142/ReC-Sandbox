From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 2 Sep 2026 05:14:16 +0800
Subject: [PATCH 262/307] !F (Terrain Plate) Add per-plate bake offset.

Add a plate-specific bake adjustment that is zero at the welded edge and grows
with relief toward the crest. This closes local gaps without translating the
entire footprint or changing the global bake epsilon.
---
 .../Geometry/TerrainPlateComponent.cpp        | 80 +++++++++++++++++--
 .../Geometry/TerrainPlateComponent.h          | 20 +++++
 2 files changed, 92 insertions(+), 8 deletions(-)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index 865a4fc6..d2d40a4c 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -2323,6 +2323,10 @@ void CTerrainPlateComponent::ComputeBakeBlock(const SBakeTerrainMetrics& metrics
 	outMinDelta = 0.f;
 	outMaxDelta = 0.f;
 
+	// The crest of the relief this bake produces, filled in by the cell loop and consumed by
+	// ApplyBakeOffset afterwards. @see ApplyBakeOffset for why the Bake Offset needs it.
+	float maxRelief = 0.f;
+
 	const Vec3 worldScale = GetWorldScale();
 
 	// Falloff band, in the same measure the edge weld uses: the distance to the nearest plate border as
@@ -2495,18 +2499,76 @@ void CTerrainPlateComponent::ComputeBakeBlock(const SBakeTerrainMetrics& metrics
 				weight *= coverage;
 
 			const float value = baseline + (combined - baseline) * weight;
-			const float delta = value - baseline;
 
-			if (fabs_tpl(delta) > 0.0001f)
-			{
-				++outCellsWritten;
-				outMinDelta = min(outMinDelta, delta);
-				outMaxDelta = max(outMaxDelta, delta);
-			}
+			maxRelief = max(maxRelief, value - baseline);
 
 			m_bakeResult[index] = value;
 		}
 	}
+
+	ApplyBakeOffset(maxRelief);
+
+	// The delta accounting is deliberately after the offset pass: what it reports is what
+	// WriteTerrainBlock is about to put in the ground, offset included.
+	for (size_t index = 0; index < m_bakeResult.size(); ++index)
+	{
+		const float delta = m_bakeResult[index] - m_bakeBaseline[index];
+
+		if (fabs_tpl(delta) > 0.0001f)
+		{
+			++outCellsWritten;
+			outMinDelta = min(outMinDelta, delta);
+			outMaxDelta = max(outMaxDelta, delta);
+		}
+	}
+}
+
+//! Bake Offset (user request 2026-09-01). NOT a flat additive offset: the user asked for a knob that
+//! leaves the welded seam alone and lifts the MAXIMUM, so the shape is scaled rather than translated.
+//!
+//!   relief(cell) = bakedHeight(cell) - baseline(cell)      // what the bake raised this cell by
+//!   height(cell) += BakeOffset * saturate(relief / maxRelief)
+//!
+//! with maxRelief the largest relief this bake produced anywhere in the footprint. At the rim relief is
+//! 0 - both the falloff weight and, in Raise mode, the max with the baseline see to that - so the term
+//! is exactly 0 there and decision 04 rule 2 (the border of the footprint IS the baseline) survives
+//! untouched, with no rim weighting of its own needed. At the crest the term is the full Bake Offset,
+//! which is why the panel value reads in metres "at the highest point". In between it is linear in the
+//! relief, so the whole baked shape is pulled towards the plate mesh (positive) or away from it
+//! (negative) in proportion to how high it stands.
+//!
+//! Two clamps:
+//!  * saturate() drops cells the bake LOWERED (RaiseAndLower digging a valley, relief < 0) to a factor
+//!    of 0. Raising the floor of a cut by the crest's offset would be meaningless, and it keeps the
+//!    dug side of the plate exactly where the plain bake put it.
+//!  * in Raise mode the result is floored at the baseline, so a negative offset larger than the relief
+//!    cannot turn the mode that "can only ever add ground" into one that digs.
+void CTerrainPlateComponent::ApplyBakeOffset(float maxRelief)
+{
+	const float offset = (float)m_bakeOffset;
+
+	// A footprint the bake did not raise anywhere (a plate flat against the ground, or one that only
+	// digs) has no crest to scale against, and relief / maxRelief would be a division by zero. The
+	// offset has nothing to act on there, so it does nothing - which is also the 0 default's path.
+	if (fabs_tpl(offset) < 0.0001f || maxRelief < 0.0001f)
+		return;
+
+	for (size_t index = 0; index < m_bakeResult.size(); ++index)
+	{
+		const float baseline = m_bakeBaseline[index];
+		const float relief = m_bakeResult[index] - baseline;
+		const float factor = clamp_tpl(relief / maxRelief, 0.f, 1.f);
+
+		if (factor <= 0.f)
+			continue;
+
+		float value = m_bakeResult[index] + offset * factor;
+
+		if (m_bakeMode == ETerrainPlateBakeMode::Raise)
+			value = max(value, baseline);
+
+		m_bakeResult[index] = value;
+	}
 }
 
 bool CTerrainPlateComponent::WriteTerrainBlock(const SBakeTerrainMetrics& metrics, const std::vector<float>& heights)
@@ -3246,6 +3308,7 @@ void CTerrainPlateComponent::BuildBakeProbes(const SBakeTerrainMetrics& metrics)
 	m_bakeSlopeCorrectUsed = g_terrainPlateBakeSlopeCorrect;
 	m_bakeEdgeAAUsed = g_terrainPlateBakeEdgeAA;
 	m_bakeWeldCurveUsed = g_terrainPlateBakeWeldCurve;
+	m_bakeOffsetUsed = (float)m_bakeOffset;
 
 	const int dim = m_bakeRectSize + 1;
 	if ((int)m_bakeResult.size() != dim * dim)
@@ -3379,7 +3442,8 @@ void CTerrainPlateComponent::PollBake()
 	if (m_bakeEpsilonUsed != GetBakeEpsilonMeters()
 	    || m_bakeSlopeCorrectUsed != g_terrainPlateBakeSlopeCorrect
 	    || m_bakeEdgeAAUsed != g_terrainPlateBakeEdgeAA
-	    || m_bakeWeldCurveUsed != g_terrainPlateBakeWeldCurve)
+	    || m_bakeWeldCurveUsed != g_terrainPlateBakeWeldCurve
+	    || m_bakeOffsetUsed != (float)m_bakeOffset)
 	{
 		ReapplyBakeAfterExternalEdit(metrics);
 		return;
diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
