@@ -1030,6 +1039,107 @@ pixout PostAAComposites_PS(vtxOut IN)
 	// No out-of-gammut pixels from here on
 	OUT.Color = saturate(OUT.Color);
 
+	// --- Viewfinder overlays: not part of the picture. ---
+	// Placed after grain and the saturate so the overlays carry no grain and no sharpening, and
+	// before the range compression. Both drivers are zeroed by the renderer when r_LensOverlays
+	// is 0, so with the overlays off this block leaves OUT.Color bit-for-bit untouched.
+	if (vLensPeakingParams.x > 0.0001 || vLensGuideParams.x >= 0.5)
+	{
+		const float2 vTexelHalf = PS_ScreenSize.zw;          // 0.5 texel
+		const float2 vTexel     = 2.0 * PS_ScreenSize.zw;    // 1 texel
+
+		// Focus peaking. Luminance edge response on the already final colour, sampled at the SAME
+		// remapped coordinate the picture used, weighted by how far inside the depth of field the
+		// pixel sits. The tint marks what is sharp; it never changes what was recorded.
+		const float fPeakStrength = vLensPeakingParams.x;
+		if (fPeakStrength > 0.0001)
