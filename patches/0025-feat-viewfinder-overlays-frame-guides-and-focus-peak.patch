+				if (abs(d.x - fHalfX) < vTexelHalf.x && d.y <= fHalfY) fLine = 1;
+			}
+
+			OUT.Color.rgb = lerp(OUT.Color.rgb, cLine, fLine * fOpacity);
+		}
+
+		OUT.Color = saturate(OUT.Color);
+	}
