+				const float fGuideAspect = max(vLensGuideParams.y, 0.01);
+				const float fHeightFrac = (fGuideAspect > fViewAspect) ? (fViewAspect / fGuideAspect) : 1.0;
+				const float fWidthFrac  = (fGuideAspect < fViewAspect) ? (fGuideAspect / fViewAspect) : 1.0;
