+			const float3 vLumWeights = float3(0.299, 0.587, 0.114);
+			const float fC = dot(GetTexture2D(PAAComp_CurTarg, PAAComp_LLSS, tcFinal).rgb, vLumWeights);
+			const float fL = dot(GetTexture2D(PAAComp_CurTarg, PAAComp_LLSS, tcFinal - float2(vTexel.x, 0)).rgb, vLumWeights);
+			const float fR = dot(GetTexture2D(PAAComp_CurTarg, PAAComp_LLSS, tcFinal + float2(vTexel.x, 0)).rgb, vLumWeights);
+			const float fT = dot(GetTexture2D(PAAComp_CurTarg, PAAComp_LLSS, tcFinal - float2(0, vTexel.y)).rgb, vLumWeights);
+			const float fB = dot(GetTexture2D(PAAComp_CurTarg, PAAComp_LLSS, tcFinal + float2(0, vTexel.y)).rgb, vLumWeights);
+			const float fEdge = saturate(max(max(abs(fC - fL), abs(fC - fR)), max(abs(fC - fT), abs(fC - fB))) * 6.0);
+
+			const float fNear = vLensPeakingParams.y;
+			const float fFar  = vLensPeakingParams.z;
+			const float fDepth = PAAComp_LinDepth.Load(int3(tcFinal * PS_ScreenSize.xy, 0)).x * PS_NearFarClipDist.y;
+			// 1 inside [near, far], 5% soft falloff on either side.
+			const float fInFocus = smoothstep(fNear * 0.95, fNear, fDepth) * (1.0 - smoothstep(fFar, fFar * 1.05, fDepth));
+
+			const int nColour = (int)(vLensPeakingParams.w + 0.5);
+			float3 cPeak = float3(1, 1, 1);
+			if (nColour == 1)      cPeak = float3(1, 0, 0);
+			else if (nColour == 2) cPeak = float3(0, 1, 0);
+			else if (nColour == 3) cPeak = float3(0, 0, 1);
+			else if (nColour == 4) cPeak = float3(1, 1, 0);
+
+			OUT.Color.rgb = lerp(OUT.Color.rgb, cPeak, saturate(fEdge * fInFocus * fPeakStrength));
+		}
+
+		// Frame guides. Monitor markings, so they live in viewport space (IN.baseTC), not in the
+		// remapped picture space: a guide that squeezed or distorted with the image would stop
+		// telling the operator where the edges of the frame are.
+		const int nGuides = (int)(vLensGuideParams.x + 0.5);
+		if (nGuides != 0)
+		{
+			const float2 tcGuide = IN.baseTC.xy;
+			const float2 d = abs(tcGuide - 0.5);
+			const float fOpacity = vLensGuideParams.z;
+			const float3 cLine = float3(1, 1, 1);
+			float fLine = 0;
+
+			// Rule of thirds.
+			if (nGuides & 1)
+			{
+				if (min(abs(tcGuide.x - 1.0 / 3.0), abs(tcGuide.x - 2.0 / 3.0)) < vTexelHalf.x) fLine = 1;
+				if (min(abs(tcGuide.y - 1.0 / 3.0), abs(tcGuide.y - 2.0 / 3.0)) < vTexelHalf.y) fLine = 1;
+			}
+
+			// Centre cross, 6% of the frame height long in both arms (equal pixel length).
+			if (nGuides & 2)
+			{
+				const float fArm = 0.03;
+				if (d.x < vTexelHalf.x && d.y < fArm) fLine = 1;
+				if (d.y < vTexelHalf.y && d.x < fArm / max(vLensGuideParams.w, 0.01)) fLine = 1;
+			}
+
+			// Action safe (90%) and title safe (80%) rectangles.
+			if (nGuides & 4)
