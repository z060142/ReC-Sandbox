+				for (int i = 0; i < 2; ++i)
+				{
+					const float fHalf = (i == 0) ? 0.45 : 0.40;
+					if (abs(d.x - fHalf) < vTexelHalf.x && d.y <= fHalf) fLine = 1;
+					if (abs(d.y - fHalf) < vTexelHalf.y && d.x <= fHalf) fLine = 1;
+				}
+			}
+
+			// Aspect framing guide: the band of the target aspect centred in the viewport is
+			// outlined and everything outside it is shaded down.
+			if (nGuides & 8)
