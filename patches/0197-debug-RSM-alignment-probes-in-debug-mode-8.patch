From b241de9351fb2f58f788c06223be4d1f0ff0f8d1 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 12 Aug 2026 18:56:54 +0800
Subject: [PATCH 197/307] debug: RSM alignment probes in debug mode 8

Content-vs-matrix investigation of the cascade-scale energy loss: mode 8
now overlays (g) the texels whose reconstructed world position lies
inside the near volume - exactly what the near cascade injection can
use - and a red crosshair where the forward matrix places the camera.
One screenshot shows whether content, injectable region and camera
agree.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tu9cj9ax1mqCV93HVfCfpW
---
 .../XRenderD3D9/GraphicsPipeline/LPV.cpp      |  6 ++++
 Engine/Shaders/HWScripts/CryFX/LPV.cfi        | 34 ++++++++++++++++---
 2 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
index 8e092f21..70e736b6 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
@@ -1197,6 +1197,12 @@ void CLPVStage::ExecuteApply(const SScopedComputeCommandList& commandList, CText
 	static CCryNameR paramRsmSizeApply("LPVRsmSize");
 	pass.SetConstant(paramRsmSizeApply, Vec4((float)m_rsmSize, 1.0f / (float)m_rsmSize, (float)CRendererCVars::CV_r_LPVDebug, 0.0f));
 
+	// Alignment probes of debug mode 8 (content vs matrix investigation).
+	static CCryNameR paramRsmToWorldApply("LPVRsmToWorld");
+	pass.SetConstant(paramRsmToWorldApply, m_rsmToWorld);
+	static CCryNameR paramWorldToRsmApply("LPVWorldToRsm");
+	pass.SetConstant(paramWorldToRsmApply, m_worldToRsm);
+
 	pass.SetDispatchSize(lpvDispatchSize(screenWidth, LPVApplyTileSize), lpvDispatchSize(screenHeight, LPVApplyTileSize), 1);
 	pass.PrepareResourcesForUse(commandList);
 	pass.Execute(commandList);
diff --git a/Engine/Shaders/HWScripts/CryFX/LPV.cfi b/Engine/Shaders/HWScripts/CryFX/LPV.cfi
index cd516ca8..19a4f7c3 100644
--- a/Engine/Shaders/HWScripts/CryFX/LPV.cfi
+++ b/Engine/Shaders/HWScripts/CryFX/LPV.cfi
@@ -836,13 +836,39 @@ void LPVApplyCS(uint3 DTid : SV_DispatchThreadID)
 	if (pixelCoord.x >= (uint)LPVScreenSize.x || pixelCoord.y >= (uint)LPVScreenSize.y)
 		return;
 
-	// Debug mode 8: show the raw RSM depth exactly as the inject pass reads it.
-	// r = depth, g = frac(depth * 100) to make small variations visible, b = 1 where cleared (>= 1).
+	// Debug mode 8: show the raw RSM depth exactly as the inject pass reads it, overlaid with the
+	// alignment probes for the content-vs-matrix investigation:
+	//   r = depth, b = 1 where cleared (>= 1)
+	//   g = 1 where the RECONSTRUCTED world position of the texel lies inside the near volume -
+	//       exactly the texels the near cascade injection can use. Their shape has to match the
+	//       geometry rendered around the volume, otherwise content and matrix disagree.
+	//   red crosshair = where the reconstruction matrix places the camera inside the RSM.
 	if ((int)LPVApplyParams.y == 8)
 	{
-		const uint2 rsmTexel = (uint2)(((float2)pixelCoord + 0.5f) * LPVScreenSize.zw * LPVRsmSize.x);
+		const float2 rsmUV = ((float2)pixelCoord + 0.5f) * LPVScreenSize.zw;
+		const uint2 rsmTexel = (uint2)(rsmUV * LPVRsmSize.x);
 		const float rsmDepth = LPVApplyRsmDepth.Load(int3(rsmTexel, 0)).x;
-		LPVIrradianceUAV[pixelCoord] = float4(rsmDepth, frac(rsmDepth * 100.0f), (rsmDepth >= 1.0f) ? 1.0f : 0.0f, 1.0f);
+
+		float4 col = float4(rsmDepth, 0.0f, (rsmDepth >= 1.0f) ? 1.0f : 0.0f, 1.0f);
+
+		// Green: this texel reconstructs into the near volume.
+		if (rsmDepth < 1.0f)
+		{
+			const float4 rsmWorldH = mul(LPVRsmToWorld, float4(rsmUV, rsmDepth, 1.0f));
+			const float3 rsmWorld = rsmWorldH.xyz / rsmWorldH.w;
+			const float3 volUV = (rsmWorld - LPVGridParams.xyz) / LPVGridParams2.w;
+			if (all(volUV >= 0.0f) && all(volUV <= 1.0f))
+				col.g = 1.0f;
+		}
+
+		// Red crosshair: the camera through the forward matrix.
+		float4 camH = mul(LPVWorldToRsm, float4(LPVCamPos.xyz, 1.0f));
+		camH /= (abs(camH.w) > 1e-12f) ? camH.w : 1.0f;
+		const float2 dist = abs(rsmUV - camH.xy);
+		if ((dist.x < 0.002f && dist.y < 0.03f) || (dist.y < 0.002f && dist.x < 0.03f))
+			col = float4(1.0f, 0.0f, 0.0f, 1.0f);
+
+		LPVIrradianceUAV[pixelCoord] = col;
 		return;
 	}
 
