From 8bbcf835451a08f06e985e716b8f50be1f5b847b Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sun, 13 Sep 2026 18:18:30 +0800
Subject: [PATCH 178/190] feat: the SVO shader type is precached for the three
 triangle RT bits

RunTime.ext lists the shader types a permutation bit is allowed to reach;
a bit not listed for a type is masked off that type's shaders. The SVO
tracing shaders are registered as ConeTraceDiffusePS, so %_RT_QUALITY,
%_RT_SAMPLE6 and %_RT_PARTICLE_SHADOW now list it alongside the existing
SVO bits (POINT_LIGHT, LIGHT_TEX_PROJ, BLEND_WITH_TERRAIN_COLOR,
MOTION_BLUR, LIGHTVOLUME0/1, HW_PCF_COMPARE, SPRITE).

Purely additive: no existing shader type loses a bit. The file must be
deployed loose next to the engine, not only inside the pak.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SCUvWGLCsqzm3VNMzp4uiS
---
 Engine/Shaders/RunTime.ext | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/Engine/Shaders/RunTime.ext b/Engine/Shaders/RunTime.ext
index 81a42a0f..ce9316ac 100644
--- a/Engine/Shaders/RunTime.ext
+++ b/Engine/Shaders/RunTime.ext
@@ -241,6 +241,7 @@ Property
   Precache = ParticleVS
   Precache = ParticleHS
   Precache = ParticleDS
+  Precache = ConeTraceDiffusePS
 }
 
 Property
@@ -508,6 +509,7 @@ Property
 	Precache = SSGI_PS
 
 	Precache = DeferredLightPassPS
+  Precache = ConeTraceDiffusePS
 }
 
 Property
@@ -1327,4 +1329,5 @@ Property
   Mask = 0x4000000000000000
   Precache = HDRPostProcessPS
   Precache = PostAA_PS
+  Precache = ConeTraceDiffusePS
 }
