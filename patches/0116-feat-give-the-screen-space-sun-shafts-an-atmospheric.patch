 }
 
+// The sun-shaft atmospheric condition, as it was actually applied (S8,
+// decisions/s8-sun-shafts-condition.md step 3).
+//
+// This exists so the acceptance is READ rather than judged by eye. The round-3 lesson was that an
+// unmeasured shaft term is exactly how the shafts went wrong the first time: the picture cannot
+// tell you whether a faint shaft is a correct clear-air condition or a broken amount, and the two
+// have opposite fixes. Four numbers settle it - what the air is (sigma_s and the visibility it
+// implies, which is the number a level author recognises), what the condition made of it, and the
+// authored amount beside the effective one.
+//
+// The values are the ones Execute() used this frame, not a recomputation.
+void CToneMappingStage::DisplayShaftConditionInfo()
+{
+	char str[256];
+
+	if (!m_bShaftCondActive)
+	{
+		cry_sprintf(str, "  shafts: atmosphere condition OFF (r_ShaftAtmosphereCondition 0, or no shafts this frame) - rays amount %.4f used as authored",
+		            m_shaftRaysAmount);
+	}
+	else
+	{
+		cry_sprintf(str, "  shafts: sigma_s %.4g /m (visibility ~%.2f km), condition %.4f (x), rays amount %.4f -> effective %.4f",
+		            m_shaftCondSigmaS, m_shaftCondVisibilityKm, m_shaftCondition,
+		            m_shaftRaysAmount, m_shaftRaysAmount * m_shaftCondition);
+	}
+
+	IRenderAuxText::DrawText(Vec3(5, 195, 1), IRenderAuxText::ASize(1.0f), ColorF(1, 0, 1, 1), eDrawText_800x600 | eDrawText_2D, str);
+}
