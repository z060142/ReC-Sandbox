+// ---------------------------------------------------------------------------
+// S8 - the ATMOSPHERIC CONDITION on the screen-space sun shafts
+// (decisions/s8-sun-shafts-condition.md approach A, research/s8-sun-shafts-condition.md).
+//
+// A crepuscular ray is not a property of a bright sun. It is single scattering along the view
+// ray, L = INTEGRAL sigma_s * p(theta) * E_perp * V dx, and every one of those four factors can
+// be zero. CE's screen-space effect implements none of them: p(theta) is approximated by the
+// radial falloff around the sun's screen position, E_perp was restored by S2, V is a
+// brightness-and-depth heuristic - and sigma_s, the one that decides whether the phenomenon
+// EXISTS, is simply absent. So the stock effect paints rays on a bone-dry cloudless day at
+// whatever RaysAmount the level authored, which is the user's round-3 observation.
+//
+// Clear air to fog is a factor of 50-1000 in sigma_s; a 100 m beam in clear air is about 4 % of
+// the sky it is drawn against, which is below the threshold at which anyone sees structure in a
+// soft gradient. That is the whole dynamic range of the effect, and there was no term carrying
+// any of it.
+//
+// The proxy: the fog system's own scattering coefficient at the camera, which is already on the
+// render thread in per-metre units. Both SRenderViewShaderConstants members hold
+// log2(e) * sigma at the viewer's height (D3DHWShader.cpp sGetVolumetricFogParams and
+// sGetVolumetricFogHeightDensityParams, both of which apply the editor's x 0.01), and both are
+// published UNCONDITIONALLY by the TOD - so this needs no new constant, no new plumbing and no
+// dependency on whether volumetric fog is actually rendering. e_VolumetricFog only selects WHICH
+// of the two systems is the one in force.
+//
+// The condition is the optical depth over a reference beam, saturating:
+//     cond = 1 - exp(-sigma_s * L_ref)
+// L_ref is the one invented number here and is labelled as one: no engine anywhere gives a
+// screen-space shaft a physical formulation to borrow a value from. See
+// r_ShaftAtmosphereRefLength and SceneReferredCalibration.md 3.
+//
+// Where this proxy is WRONG, on the record: it is the density AT THE CAMERA, not along the beam
+// (a camera above a ground-fog layer reads as clear), local fog volumes never reach the global
+// parameters, and there is still no occluder test. The hybrid with volumetric fog's real froxel
+// shafts (approach C) has none of those problems and is the destination; this scalar is the part
+// of it that can be had for one multiply.
+// ---------------------------------------------------------------------------
+struct SShaftAtmosphereCondition
+{
+	float sigmaS       = 0.0f;   //!< scattering coefficient at the camera, per metre
+	float visibilityKm = 0.0f;   //!< Koschmieder visual range 3.912 / sigma_e, km
+	float condition    = 1.0f;   //!< the multiplier applied to the shaft composite
+	bool  bActive      = false;  //!< false = the shafts were left at the authored amount
+};
+
+static SShaftAtmosphereCondition ResolveShaftAtmosphereCondition(const CRenderView* pRenderView)
+{
+	SShaftAtmosphereCondition result;
+
+	if (CRenderer::CV_r_ShaftAtmosphereCondition == 0 || pRenderView == nullptr)
+		return result;
+
+	const SRenderViewShaderConstants& PF = pRenderView->GetShaderConstants();
+
+	// Which fog system is the one describing this scene's air. e_VolumetricFog is
+	// VF_REQUIRE_APP_RESTART, so this cannot change under us mid-session.
+	ICVar* pVolFogVar = gEnv->pConsole ? gEnv->pConsole->GetCVar("e_VolumetricFog") : nullptr;
+	const bool bVolFog = (pVolFogVar != nullptr && pVolFogVar->GetIVal() != 0);
+
+	// Both are log2(e) * sigma; divide the log2(e) back out exactly as the shaders do
+	// (VolumeLighting.cfi). The result is extinction, per metre, at the viewer's height.
+	const float kInvLog2e = 1.0f / 1.44269502f;
+	const float sigmaE = max(0.0f, (bVolFog ? PF.pVolumetricFogHeightDensityParams.y
+	                                        : PF.pVolumetricFogParams.y) * kInvLog2e);
+
+	// Scattering is nearly all of extinction for water droplets and most aerosols (single-scatter
+	// albedo 0.85-1.0); soot is the exception and CE has no parameter for it. VOLFOG2_INSCATTER is
+	// the only albedo-shaped knob the engine exposes, default 1.0, so it doubles as the albedo for
+	// both fog systems - which at every stock preset is a multiply by one. Clamped to [0,1]
+	// because an albedo above 1 is not a thing, whatever the slider allows.
+	const float albedo = clamp_tpl(PF.pVolumetricFogScatteringParams.x, 0.0f, 1.0f);
+
+	result.sigmaS = sigmaE * albedo;
+
+	// Koschmieder, for the debug readout only - it is a property of extinction, not of scattering,
+	// so it is computed from sigmaE before the albedo.
+	result.visibilityKm = (sigmaE > 1e-9f) ? (3.912f / sigmaE) * 0.001f : 1e6f;
+
+	const float refLength = max(0.0f, CRenderer::CV_r_ShaftAtmosphereRefLength);
+	result.condition = 1.0f - expf(-result.sigmaS * refLength);
+	result.bActive = true;
+
+	return result;
+}
