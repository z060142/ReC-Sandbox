From cc58e5c83716517caaa0bfdb6f47cb7cfa67f48b Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Tue, 11 Aug 2026 23:35:35 +0800
Subject: [PATCH 184/307] fix: drop temporal history on any r_LPV cvar change

Intensity-compensated inputs (the sky light divides by r_LPVIntensity at
injection so the display multiply cancels) made cvar changes look
temporarily coupled: after raising the intensity the EMA kept blending
the old grid for seconds, visibly "boosting" the sky light until the
accumulator converged. A hard history cut on any r_LPV change shows the
true steady state after a single relight, which also makes A/B tuning
comparisons trustworthy.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tu9cj9ax1mqCV93HVfCfpW
---
 .../RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp        | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
index e8a11ab5..3b9e3f77 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
@@ -213,12 +213,18 @@ void CLPVStage::OnCVarsChanged(const CCVarUpdateRecorder& cvarUpdater)
 			ResizeGrid(gridSize);
 	}
 
-	// Any LPV parameter change invalidates the frozen grid of the relight gating.
+	// Any LPV parameter change invalidates the frozen grid of the relight gating - and drops the
+	// temporal history: parameters like r_LPVIntensity are compensated at injection time (the sky
+	// light divides by the intensity so the display multiply cancels), and blending the old grid
+	// into the new one through the EMA makes every such change look temporarily coupled (a raised
+	// intensity visibly "boosted" the sky light until the accumulator converged over seconds).
+	// A hard cut shows the true steady state immediately.
 	for (const auto& record : cvarUpdater.GetCVars())
 	{
 		if (strncmp(record.name, "r_LPV", 5) == 0)
 		{
 			m_bForceRelight = true;
+			m_bHistoryValid = false;
 			break;
 		}
 	}
