@@ -0,0 +1,524 @@
+// Copyright 2026 ReC Sandbox. Distributed under the terms in LICENSE.md at the repository root.
+#include "StdAfx.h"
+#include "CineGradePanel.h"
+#include "CineGradeWidgets.h"
+
+#include <QtViewPane.h>
+#include <IResourceSelectorHost.h>
+
+#include <QCheckBox>
+#include <QComboBox>
+#include <QDoubleSpinBox>
+#include <QGridLayout>
+#include <QGroupBox>
+#include <QHBoxLayout>
+#include <QLabel>
+#include <QLineEdit>
+#include <QPushButton>
+#include <QScrollArea>
+#include <QVBoxLayout>
+
+namespace CineCamGrade
+{
+
+// Tools -> Cinematic Camera -> CineCam Grade. One instance (the panel follows the selection, so a
+// second one would only ever show the same thing). Inside the namespace on purpose: the macro
+// pastes the class name into an identifier, which a qualified name cannot be.
+REGISTER_VIEWPANE_FACTORY_AND_MENU(CCineGradePanel, "CineCam Grade", "Tools", true, "Cinematic Camera")
+
+//! Must match CINECAM_ASSET_TYPE_LUT / CCineLutAssetType::GetTypeName().
+static const char* const kLutAssetType = "CineLut";
+
+// ---------------------------------------------------------------------------
+// Construction
+// ---------------------------------------------------------------------------
+
+CCineGradePanel::CCineGradePanel(QWidget* pParent)
+	: CDockableEditor(pParent)
+{
+	m_pHeader = new QLabel(this);
+	QFont headerFont = m_pHeader->font();
+	headerFont.setBold(true);
+	m_pHeader->setFont(headerFont);
+	m_pHeader->setWordWrap(true);
+
+	m_pBypass = new QCheckBox(tr("Bypass Grade (A/B the ungraded picture)"), this);
+	connect(m_pBypass, &QCheckBox::clicked, this, [this](bool)
+	{
+		if (m_updatingWidgets)
+			return;
+		BeginInteraction();
+		PushValues();
+		EndInteraction();
+	});
+
+	QVBoxLayout* pControlsLayout = new QVBoxLayout();
+	pControlsLayout->setContentsMargins(0, 0, 0, 0);
+	pControlsLayout->setSpacing(8);
+	pControlsLayout->addWidget(m_pBypass);
+	pControlsLayout->addWidget(BuildWheels());
+	pControlsLayout->addWidget(BuildTone());
+	pControlsLayout->addWidget(BuildCurves());
+	pControlsLayout->addWidget(BuildCdlBase());
+	pControlsLayout->addWidget(BuildLook());
+	pControlsLayout->addStretch(1);
+
+	m_pControls = new QWidget(this);
+	m_pControls->setLayout(pControlsLayout);
+
+	QScrollArea* pScroll = new QScrollArea(this);
+	pScroll->setWidgetResizable(true);
+	pScroll->setWidget(m_pControls);
+
+	QVBoxLayout* pMain = new QVBoxLayout();
+	pMain->setContentsMargins(6, 6, 6, 6);
+	pMain->setSpacing(6);
+	pMain->addWidget(m_pHeader);
+	pMain->addWidget(pScroll, 1);
+	SetContent(pMain);
+
+	GetIEditor()->RegisterNotifyListener(this);
+	Rebind(true);
+}
+
+CCineGradePanel::~CCineGradePanel()
+{
+	// An open transaction would otherwise outlive the window that opened it.
+	if (m_interacting)
+		EndInteraction();
+	GetIEditor()->UnregisterNotifyListener(this);
+}
+
+template<typename TControl>
+void CCineGradePanel::Wire(TControl* pControl)
+{
+	connect(pControl, &TControl::SignalBeginEdit, this, &CCineGradePanel::BeginInteraction);
+	connect(pControl, &TControl::SignalChanged, this, &CCineGradePanel::PushValues);
+	connect(pControl, &TControl::SignalEndEdit, this, &CCineGradePanel::EndInteraction);
+}
+
+QWidget* CCineGradePanel::BuildWheels()
+{
+	// Amplitudes: how far one full radius pushes a single channel. Lift is the smallest because a
+	// tenth of a code value in the shadows is already a strong cast; Gamma and Gain are wider
+	// because they are read as multipliers. Master ranges are the component's own declared ones
+	// (Range<-1,1> for Lift, Range<0,4,0,2> for Gamma and Gain).
+	m_pLift = new CCineWheelControl(tr("Lift"), 0.0f, 0.20f, -1.0f, 1.0f, 0.0f, this);
+	m_pGamma = new CCineWheelControl(tr("Gamma"), 1.0f, 0.50f, 0.0f, 4.0f, 1.0f, this);
+	m_pGain = new CCineWheelControl(tr("Gain"), 1.0f, 0.50f, 0.0f, 4.0f, 1.0f, this);
+
+	m_pLift->setToolTip(tr("The shadow end. Lifting the blacks leaves white exactly where it was."));
+	m_pGamma->setToolTip(tr("The midtones. Neither black nor white moves."));
+	m_pGain->setToolTip(tr("The highlight end. Raising the gain leaves black exactly where it was."));
+
+	Wire(m_pLift);
+	Wire(m_pGamma);
+	Wire(m_pGain);
+
+	QGroupBox* pGroup = new QGroupBox(tr("Primaries"), this);
+	QHBoxLayout* pLayout = new QHBoxLayout();
+	pLayout->setContentsMargins(6, 6, 6, 6);
+	pLayout->addWidget(m_pLift);
+	pLayout->addWidget(m_pGamma);
+	pLayout->addWidget(m_pGain);
+	pLayout->addStretch(1);
+	pGroup->setLayout(pLayout);
+	return pGroup;
+}
+
+QWidget* CCineGradePanel::BuildTone()
+{
+	m_pContrast = new CCineFloatRow(tr("Contrast"), 0.0f, 4.0f, 1.0f, 4, this);
+	m_pPivot = new CCineFloatRow(tr("Contrast Pivot"), 0.0f, 1.0f, 0.4135878f, 4, this);
+	m_pSaturation = new CCineFloatRow(tr("Saturation"), 0.0f, 4.0f, 1.0f, 4, this);
+
+	m_pPivot->setToolTip(tr("The code value Contrast turns about, in ACEScct. 0.4136 is 18 % grey."));
+
+	Wire(m_pContrast);
+	Wire(m_pPivot);
+	Wire(m_pSaturation);
+
+	QGroupBox* pGroup = new QGroupBox(tr("Contrast and saturation"), this);
+	QVBoxLayout* pLayout = new QVBoxLayout();
+	pLayout->setContentsMargins(6, 6, 6, 6);
+	pLayout->addWidget(m_pContrast);
+	pLayout->addWidget(m_pPivot);
+	pLayout->addWidget(m_pSaturation);
+	pGroup->setLayout(pLayout);
+	return pGroup;
+}
+
+QWidget* CCineGradePanel::BuildCurves()
+{
+	static const char* const szMaster[kKnotCount] =
+	{ "Master Black (stops)", "Master Shadow (stops)", "Master Mid (stops)", "Master Highlight (stops)", "Master White (stops)" };
+	static const char* const szSat[kKnotCount] =
+	{ "Sat @ 0 (neutrals)", "Sat @ 25 %", "Sat @ 50 %", "Sat @ 75 %", "Sat @ 100 %" };
+
+	QVBoxLayout* pLayout = new QVBoxLayout();
+	pLayout->setContentsMargins(6, 6, 6, 6);
+
+	for (int i = 0; i < kKnotCount; ++i)
+	{
+		m_pMasterCurve[i] = new CCineFloatRow(tr(szMaster[i]), -4.0f, 4.0f, 0.0f, 3, this);
+		Wire(m_pMasterCurve[i]);
+		pLayout->addWidget(m_pMasterCurve[i]);
+	}
+	for (int i = 0; i < kKnotCount; ++i)
+	{
+		m_pSatCurve[i] = new CCineFloatRow(tr(szSat[i]), 0.0f, 4.0f, 1.0f, 3, this);
+		Wire(m_pSatCurve[i]);
+		pLayout->addWidget(m_pSatCurve[i]);
+	}
+
+	QGroupBox* pGroup = new QGroupBox(tr("Curves"), this);
+	pGroup->setLayout(pLayout);
+	return pGroup;
+}
+
+QWidget* CCineGradePanel::BuildCdlBase()
+{
+	static const char* const szRow[3] = { "Slope", "Offset", "Power" };
+	static const char* const szChannel[3] = { "R", "G", "B" };
+	static const double kNeutral[3] = { 1.0, 0.0, 1.0 };
+
+	QGridLayout* pGrid = new QGridLayout();
+	pGrid->setContentsMargins(6, 6, 6, 6);
+	for (int c = 0; c < 3; ++c)
+		pGrid->addWidget(new QLabel(QString::fromLatin1(szChannel[c]), this), 0, c + 1, Qt::AlignHCenter);
+
+	for (int row = 0; row < 3; ++row)
+	{
+		pGrid->addWidget(new QLabel(tr(szRow[row]), this), row + 1, 0);
+		for (int c = 0; c < 3; ++c)
+		{
+			QDoubleSpinBox* pSpin = new QDoubleSpinBox(this);
+			pSpin->setRange(kNeutral[row] - 4.0, kNeutral[row] + 4.0);
+			pSpin->setDecimals(4);
+			pSpin->setSingleStep(0.01);
+			pSpin->setKeyboardTracking(false);
+			connect(pSpin, static_cast<void (QDoubleSpinBox::*)(double)>(&QDoubleSpinBox::valueChanged), this, [this](double)
+			{
+				if (m_updatingWidgets)
+					return;
+				BeginInteraction();
+				PushValues();
+				EndInteraction();
+			});
+			m_pCdl[row][c] = pSpin;
+			pGrid->addWidget(pSpin, row + 1, c + 1);
+		}
+	}
+
+	QGroupBox* pGroup = new QGroupBox(tr("ASC CDL base (what the wheels sit on top of)"), this);
+	pGroup->setToolTip(tr("Paste a .cdl from Resolve here. With the wheels neutral these three rows "
+	                      "are exactly what the camera publishes."));
+	pGroup->setLayout(pGrid);
+	return pGroup;
+}
+
+QWidget* CCineGradePanel::BuildLook()
+{
+	m_pLmtFile = new QLineEdit(this);
+	m_pLmtFile->setPlaceholderText(tr("(none - pure ACES)"));
+	connect(m_pLmtFile, &QLineEdit::editingFinished, this, [this]()
+	{
+		if (m_updatingWidgets)
+			return;
+		BeginInteraction();
+		PushValues();
+		EndInteraction();
+	});
+
+	QPushButton* pBrowse = new QPushButton(QStringLiteral("..."), this);
+	pBrowse->setFixedWidth(28);
+	connect(pBrowse, &QPushButton::clicked, this, &CCineGradePanel::OnBrowseLmt);
+
+	m_pLmtSpace = new QComboBox(this);
+	m_pLmtSpace->addItem(tr("ACEScct (an LMT)"));
+	m_pLmtSpace->addItem(tr("ACEScg linear"));
+	m_pLmtSpace->addItem(tr("Rec.709 display (a normal LUT)"));
+	connect(m_pLmtSpace, static_cast<void (QComboBox::*)(int)>(&QComboBox::currentIndexChanged), this, [this](int)
+	{
+		if (m_updatingWidgets)
+			return;
+		BeginInteraction();
+		PushValues();
+		EndInteraction();
+	});
+
+	m_pPreset = new QLineEdit(this);
+	m_pPreset->setReadOnly(true);
+	m_pPreset->setPlaceholderText(tr("(no preset)"));
+
+	QLabel* pNote = new QLabel(tr("Export Preset and Re-apply Preset are on the component itself, in the "
+	                              "entity inspector's Preset group."), this);
+	pNote->setWordWrap(true);
+
+	QHBoxLayout* pFileRow = new QHBoxLayout();
+	pFileRow->setContentsMargins(0, 0, 0, 0);
+	pFileRow->addWidget(m_pLmtFile, 1);
+	pFileRow->addWidget(pBrowse);
+
+	QGridLayout* pGrid = new QGridLayout();
+	pGrid->setContentsMargins(6, 6, 6, 6);
+	pGrid->addWidget(new QLabel(tr("LMT File"), this), 0, 0);
+	pGrid->addLayout(pFileRow, 0, 1);
+	pGrid->addWidget(new QLabel(tr("LMT Input Space"), this), 1, 0);
+	pGrid->addWidget(m_pLmtSpace, 1, 1);
+	pGrid->addWidget(new QLabel(tr("Grade Preset"), this), 2, 0);
+	pGrid->addWidget(m_pPreset, 2, 1);
+	pGrid->addWidget(pNote, 3, 0, 1, 2);
+	pGrid->setColumnStretch(1, 1);
+
+	QGroupBox* pGroup = new QGroupBox(tr("Look"), this);
+	pGroup->setLayout(pGrid);
+	return pGroup;
+}
+
+// ---------------------------------------------------------------------------
+// Binding and polling
+// ---------------------------------------------------------------------------
+
+void CCineGradePanel::OnEditorNotifyEvent(EEditorNotifyEvent event)
+{
+	switch (event)
+	{
+	case eNotify_OnSelectionChange:
+		Rebind(true);
+		break;
+	case eNotify_OnIdleUpdate:
+		Poll();
+		break;
+	case eNotify_OnBeginNewScene:
+	case eNotify_OnBeginSceneOpen:
+	case eNotify_OnBeginSceneClose:
+	case eNotify_OnClearLevelContents:
+		if (m_interacting)
+			EndInteraction();
+		m_pTarget.reset();
+		SetBoundState("no level");
+		break;
+	default:
+		break;
+	}
+}
+
+void CCineGradePanel::Rebind(bool bForce)
+{
+	if (m_interacting)
+		EndInteraction();
+
+	if (!bForce && m_pTarget && m_pTarget->IsValid())
+		return;
+
+	string reason;
+	m_pTarget.reset(CreateTargetForSelection(reason));
+	m_rebindCountdown = 15;
+
+	if (m_pTarget)
+	{
+		m_pTarget->Read(m_values);
+		RefreshWidgets();
+		SetBoundState(nullptr);
+	}
+	else
+	{
+		SetBoundState(reason.c_str());
+	}
+}
+
+void CCineGradePanel::SetBoundState(const char* szReason)
+{
+	const bool bBound = (szReason == nullptr) && m_pTarget;
+	if (bBound)
+	{
+		m_pHeader->setText(tr("Grading: %1").arg(QString::fromUtf8(m_pTarget->GetLabel())));
+	}
+	else
+	{
+		m_pHeader->setText(tr("Not editable - %1. Select the single entity that carries the CineCam Grade.")
+		                   .arg(QString::fromUtf8(szReason ? szReason : "nothing selected")));
+	}
+	m_pControls->setEnabled(bBound);
+}
+
+void CCineGradePanel::Poll()
+{
+	if (!isVisible() || m_interacting)
+		return;
+
+	if (!m_pTarget || !m_pTarget->IsValid())
+	{
+		// The component may appear on the already-selected entity a moment after it is added, so
+		// keep retrying - just not on every single frame.
+		if (--m_rebindCountdown <= 0)
+			Rebind(true);
+		return;
+	}
+
+	SGradeValues current;
+	if (!m_pTarget->Read(current))
+		return;
+
+	if (current != m_values)
+	{
+		m_values = current;
+		RefreshWidgets();
+	}
+}
+
+// ---------------------------------------------------------------------------
+// One transaction per gesture
+// ---------------------------------------------------------------------------
+
+// A gesture is open from the press to the release, but the undo transaction is only opened by the
+// first change inside it - so a click that moves nothing, or a line edit that merely loses focus,
+// leaves no empty step on the undo stack and never re-serialises the entity.
+void CCineGradePanel::BeginInteraction()
+{
+	if (m_interacting || !m_pTarget || !m_pTarget->IsValid())
+		return;
+
+	m_interacting = true;
+	m_changedInInteraction = false;
+}
+
+void CCineGradePanel::PushValues()
+{
+	if (m_updatingWidgets || !m_pTarget || !m_pTarget->IsValid())
+		return;
+
+	// Untouched controls hand back the exact float they were given (the widgets keep the value,
+	// not the rounded display), so collecting everything cannot quietly round a value the user
+	// never went near - the contrast pivot's 0.4135878 being the one that would show.
+	const SGradeValues before = m_values;
+	CollectFromWidgets();
+	if (m_values == before)
+		return;
+
+	if (!m_changedInInteraction)
+	{
+		// The component still holds the pre-edit values at this point, which is exactly what the
+		// undo step has to capture.
+		m_pTarget->BeginEdit();
+		m_changedInInteraction = true;
+	}
+
+	m_pTarget->Write(m_values);
+
+	// Not every change arrives inside a gesture: a slider moved with the wheel or the arrow keys,
+	// or a groove click, emits valueChanged with no press and no release. Such a change closes its
+	// own transaction here rather than leaving one open for ever.
+	if (!m_interacting)
+	{
+		m_pTarget->EndEdit(true);
+		m_changedInInteraction = false;
+	}
+}
+
+void CCineGradePanel::EndInteraction()
+{
+	if (!m_interacting)
+		return;
+
+	m_interacting = false;
+	if (m_pTarget && m_changedInInteraction)
+		m_pTarget->EndEdit(true);
+	m_changedInInteraction = false;
+}
+
+// ---------------------------------------------------------------------------
+// Widgets <-> values
+// ---------------------------------------------------------------------------
+
+void CCineGradePanel::CollectFromWidgets()
+{
+	m_values.bypass = m_pBypass->isChecked();
+
+	m_values.lift = m_pLift->GetRgb();
+	m_values.liftMaster = m_pLift->GetMaster();
+	m_values.gamma = m_pGamma->GetRgb();
+	m_values.gammaMaster = m_pGamma->GetMaster();
+	m_values.gain = m_pGain->GetRgb();
+	m_values.gainMaster = m_pGain->GetMaster();
+
+	m_values.contrast = m_pContrast->GetValue();
+	m_values.pivot = m_pPivot->GetValue();
+	m_values.saturation = m_pSaturation->GetValue();
+
+	for (int i = 0; i < kKnotCount; ++i)
+	{
+		m_values.masterStops[i] = m_pMasterCurve[i]->GetValue();
+		m_values.satMul[i] = m_pSatCurve[i]->GetValue();
+	}
+
+	Vec3* const pCdl[3] = { &m_values.slope, &m_values.offset, &m_values.power };
+	for (int row = 0; row < 3; ++row)
+	{
+		for (int c = 0; c < 3; ++c)
+			(*pCdl[row])[c] = (float)m_pCdl[row][c]->value();
+	}
+
+	m_values.lmtFile = m_pLmtFile->text().toUtf8().constData();
+	m_values.lmtSpace = (uint32)qMax(0, m_pLmtSpace->currentIndex());
+}
+
+void CCineGradePanel::RefreshWidgets()
+{
+	m_updatingWidgets = true;
+
+	m_pBypass->setChecked(m_values.bypass);
+
+	m_pLift->SetValues(m_values.lift, m_values.liftMaster);
+	m_pGamma->SetValues(m_values.gamma, m_values.gammaMaster);
+	m_pGain->SetValues(m_values.gain, m_values.gainMaster);
+
+	m_pContrast->SetValue(m_values.contrast);
+	m_pPivot->SetValue(m_values.pivot);
+	m_pSaturation->SetValue(m_values.saturation);
+
+	for (int i = 0; i < kKnotCount; ++i)
+	{
+		m_pMasterCurve[i]->SetValue(m_values.masterStops[i]);
+		m_pSatCurve[i]->SetValue(m_values.satMul[i]);
+	}
+
+	const Vec3* const pCdl[3] = { &m_values.slope, &m_values.offset, &m_values.power };
+	for (int row = 0; row < 3; ++row)
+	{
+		for (int c = 0; c < 3; ++c)
+			m_pCdl[row][c]->setValue((*pCdl[row])[c]);
+	}
+
+	m_pLmtFile->setText(QString::fromUtf8(m_values.lmtFile.c_str()));
+	m_pLmtSpace->setCurrentIndex((int)qMin<uint32>(m_values.lmtSpace, 2));
+	m_pPreset->setText(QString::fromUtf8(m_values.presetPath.c_str()));
+
+	m_updatingWidgets = false;
+}
+
+void CCineGradePanel::OnBrowseLmt()
+{
+	if (!m_pTarget || !m_pTarget->IsValid())
+		return;
+
+	IResourceSelectorHost* pHost = GetIEditor()->GetResourceSelectorHost();
+	if (pHost == nullptr)
+		return;
+
+	// The same Asset Browser picker the component's own LMT File property opens (item 4b).
+	const SResourceSelectionResult result = pHost->SelectResource(kLutAssetType, m_values.lmtFile.c_str(), this);
+	if (!result.selectionAccepted)
+		return;
+
+	m_updatingWidgets = true;
+	m_pLmtFile->setText(QString::fromUtf8(result.selectedResource.c_str()));
+	m_updatingWidgets = false;
+
+	BeginInteraction();
+	PushValues();
+	EndInteraction();
+}
+
+} // namespace CineCamGrade
