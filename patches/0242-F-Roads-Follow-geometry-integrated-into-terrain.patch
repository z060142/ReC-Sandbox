+		SIntegratedHeightScope heightScope(bFollowIntegrated && !areaBox.IsReset(), areaBox);
+
 		m_serializedData.worldSpaceBBox.Reset();
 		for (int i = 0; i < nVertsNumAll; i++)
 		{
-			Vec3 vTmp(m_arrVerts[i].x, m_arrVerts[i].y, Get3DEngine()->GetTerrainElevation(m_arrVerts[i].x, m_arrVerts[i].y) + fRoadTerrainZOffset);
+			const float fTerrainZ = Get3DEngine()->GetTerrainElevation(m_arrVerts[i].x, m_arrVerts[i].y);
+			Vec3 vTmp(m_arrVerts[i].x, m_arrVerts[i].y, RoadSurfaceZ(bFollowIntegrated, m_arrVerts[i].x, m_arrVerts[i].y, fTerrainZ) + fRoadTerrainZOffset);
 			m_serializedData.worldSpaceBBox.Add(vTmp);
 		}
 
@@ -203,21 +281,62 @@ void CRoadRenderNode::Compile() PREFAST_SUPPRESS_WARNING(6262) //function uses >
 			float y1 = std::floor(WSBBox.min.y / unitSize) * unitSize;
 			float y2 = std::floor(WSBBox.max.y / unitSize) * unitSize + unitSize;
 
+			// A road is tessellated on the heightmap grid, so it resolves an object that renders as terrain
+			// at terrain cell size at best. Subdivide that grid, but only over an object that is actually
+			// there, and only as far as the road vertex budget allows. The grid bounds stay cell aligned,
+			// so holes, the quad diagonal and the neighbouring trapezoids are unaffected.
+			int nSubdiv = 1;
+			float fStep = unitSize;
+
+			if (bFollowIntegrated && Get3DEngine()->HasIntegratedHeightSamplesIn2D(WSBBox))
+			{
+				nSubdiv = clamp_tpl(GetCVars()->e_RoadsFollowIntegratedObjectsSubdiv, 1, 8);
+
+				const int nCellsX = max(1, int((x2 - x1) / unitSize));
+				const int nCellsY = max(1, int((y2 - y1) / unitSize));
+				const int nMaxGridVerts = 4096; // per trapezoid; the whole road is capped at 32k below
+
+				while (nSubdiv > 1 && (nCellsX * nSubdiv + 1) * (nCellsY * nSubdiv + 1) > nMaxGridVerts)
+					nSubdiv--;
+
+				fStep = unitSize / (float)nSubdiv;
+			}
+
 			// make arrays of verts and indices used in trapezoid area
 			s_tempVertexPositions.Clear();
 			s_tempIndices.Clear();
 
-			for (float x = x1; x <= x2; x += unitSize)
+			if (nSubdiv > 1)
+			{
+				// Indexed rather than accumulated, so the vertex count cannot drift away from dx/dy below
+				// once the step is a fraction of the unit size.
+				const int nCountX = int((x2 - x1) / fStep) + 1;
+				const int nCountY = int((y2 - y1) / fStep) + 1;
+
+				for (int ix = 0; ix < nCountX; ix++)
+				{
+					for (int iy = 0; iy < nCountY; iy++)
+					{
+						const float x = x1 + (float)ix * fStep;
+						const float y = y1 + (float)iy * fStep;
+						s_tempVertexPositions.Add(Vec3(x, y, Get3DEngine()->GetTerrainOrIntegratedZ(x, y, GetTerrain()->GetZ(x, y, true))));
+					}
+				}
+			}
+			else
 			{
-				for (float y = y1; y <= y2; y += unitSize)
+				for (float x = x1; x <= x2; x += unitSize)
 				{
-					s_tempVertexPositions.Add(Vec3((float)x, (float)y, GetTerrain()->GetZ(x, y, true)));
+					for (float y = y1; y <= y2; y += unitSize)
+					{
+						s_tempVertexPositions.Add(Vec3((float)x, (float)y, RoadSurfaceZ(bFollowIntegrated, x, y, GetTerrain()->GetZ(x, y, true))));
+					}
 				}
 			}
 
 			// make indices
-			int dx = int((x2 - x1) / unitSize);
-			int dy = int((y2 - y1) / unitSize);
+			int dx = int((x2 - x1) / fStep);
+			int dy = int((y2 - y1) / fStep);
 
 			for (int x = 0; x < dx; x++)
 			{
@@ -228,14 +347,26 @@ void CRoadRenderNode::Compile() PREFAST_SUPPRESS_WARNING(6262) //function uses >
 					int nIdx2 = (x * (dy + 1) + y + 1);
 					int nIdx3 = (x * (dy + 1) + y + 1 + (dy + 1));
 
-					float X_in_meters = float(x1) + float(x) * unitSize;
-					float Y_in_meters = float(y1) + float(y) * unitSize;
+					float X_in_meters = float(x1) + float(x) * fStep;
+					float Y_in_meters = float(y1) + float(y) * fStep;
 
 					CTerrain* pTerrain = GetTerrain();
 
-					if (m_bIgnoreTerrainHoles || (pTerrain && !pTerrain->GetHole(X_in_meters, Y_in_meters)))
+					// A hole and the quad diagonal are properties of the terrain cell, not of the road
+					// grid, so a subdivided quad asks the cell it sits in and a cell is never half flipped.
+					// With nSubdiv == 1 these are the loop coordinates themselves, untouched.
+					float X_cell = X_in_meters;
+					float Y_cell = Y_in_meters;
+
+					if (nSubdiv > 1)
+					{
+						X_cell = std::floor(X_in_meters / unitSize) * unitSize;
+						Y_cell = std::floor(Y_in_meters / unitSize) * unitSize;
+					}
+
+					if (m_bIgnoreTerrainHoles || (pTerrain && !pTerrain->GetHole(X_cell, Y_cell)))
 					{
-						if (pTerrain && pTerrain->IsMeshQuadFlipped(X_in_meters, Y_in_meters, unitSize))
+						if (pTerrain && pTerrain->IsMeshQuadFlipped(X_cell, Y_cell, unitSize))
 						{
 							s_tempIndices.Add(nIdx0);
 							s_tempIndices.Add(nIdx1);
@@ -339,7 +470,10 @@ void CRoadRenderNode::Compile() PREFAST_SUPPRESS_WARNING(6262) //function uses >
 
 				s_tempVertices.Add(tmp);
 
-				Vec3 vNormal = GetTerrain()->GetTerrainSurfaceNormal(vWSPos, 0.25f);
+				// 0.25 is the stock sample radius, exactly reproduced while nSubdiv == 1. On a subdivided
