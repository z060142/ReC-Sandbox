Date: Mon, 31 Aug 2026 10:38:23 +0800
Subject: [PATCH 242/307] !F (Roads) Follow geometry integrated into terrain.

Route road height and normal samples through the integrated surface query.
Roads drape over integrated meshes at their real resolution and fall back to
the terrain heightmap where no integrated surface is found.
---
 Code/CryEngine/Cry3DEngine/RoadRenderNode.cpp | 166 ++++++++++++++++--
 Code/CryEngine/Cry3DEngine/cvars.cpp          |  15 ++
 Code/CryEngine/Cry3DEngine/cvars.h            |   2 +
 3 files changed, 171 insertions(+), 12 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/RoadRenderNode.cpp b/Code/CryEngine/Cry3DEngine/RoadRenderNode.cpp
index 6a7215f9..20bcfdc4 100644
--- a/Code/CryEngine/Cry3DEngine/RoadRenderNode.cpp
+++ b/Code/CryEngine/Cry3DEngine/RoadRenderNode.cpp
@@ -24,6 +24,65 @@ CPolygonClipContext CRoadRenderNode::s_tmpClipContext;
 ILINE Vec3 max(const Vec3& v0, const Vec3& v1) { return Vec3(max(v0.x, v1.x), max(v0.y, v1.y), max(v0.z, v1.z)); }
 ILINE Vec3 min(const Vec3& v0, const Vec3& v1) { return Vec3(min(v0.x, v1.x), min(v0.y, v1.y), min(v0.z, v1.z)); }
 
+namespace
+{
+
+//! Holds a road height sampling scope open on C3DEngine for one rebuild, so the LOD 0 meshes of the
+//! objects rendering as terrain under this road are read once and then sampled cheaply.
+struct SIntegratedHeightScope
+{
+	SIntegratedHeightScope(bool bEnabled, const AABB& areaBox)
+		: m_bEnabled(bEnabled)
+	{
+		if (m_bEnabled)
+			Cry3DEngineBase::Get3DEngine()->BeginIntegratedHeightSampling(areaBox);
+	}
+
+	~SIntegratedHeightScope()
+	{
+		if (m_bEnabled)
+			Cry3DEngineBase::Get3DEngine()->EndIntegratedHeightSampling();
+	}
+
+	SIntegratedHeightScope(const SIntegratedHeightScope&) = delete;
+	SIntegratedHeightScope& operator=(const SIntegratedHeightScope&) = delete;
+
+	const bool m_bEnabled;
+};
+
+//! The height of the surface a road lies on at (x, y): the terrain height the caller already has,
+//! raised onto any object that renders as terrain there. Returns fTerrainZ unchanged with
+//! e_RoadsFollowIntegratedObjects 0, or when no such object covers the point.
+ILINE float RoadSurfaceZ(bool bFollow, float x, float y, float fTerrainZ)
+{
+	return bFollow ? Cry3DEngineBase::Get3DEngine()->GetTerrainOrIntegratedZ(x, y, fTerrainZ) : fTerrainZ;
+}
+
+//! CTerrain::GetTerrainSurfaceNormal (terrain.cpp:595) with each of its four samples put through
+//! RoadSurfaceZ, so the road is shaded by the surface it is actually lying on. Bit for bit the stock
+//! function when bFollow is false, and numerically identical to it when nothing is integrating here.
+Vec3 RoadSurfaceNormal(bool bFollow, const Vec3& vPos, float fRange)
+{
+	CTerrain* const pTerrain = Cry3DEngineBase::GetTerrain();
+
+	if (!bFollow)
+		return pTerrain->GetTerrainSurfaceNormal(vPos, fRange);
+
+	fRange += 0.05f;
+
+	const float x0 = vPos.x - fRange, x1 = vPos.x + fRange;
+	const float y0 = vPos.y - fRange, y1 = vPos.y + fRange;
+
+	const Vec3 v1(x0, y0, RoadSurfaceZ(true, x0, y0, pTerrain->GetZApr(x0, y0)));
+	const Vec3 v2(x0, y1, RoadSurfaceZ(true, x0, y1, pTerrain->GetZApr(x0, y1)));
+	const Vec3 v3(x1, y0, RoadSurfaceZ(true, x1, y0, pTerrain->GetZApr(x1, y0)));
+	const Vec3 v4(x1, y1, RoadSurfaceZ(true, x1, y1, pTerrain->GetZApr(x1, y1)));
+
+	return (v3 - v2).Cross(v4 - v1).GetNormalized();
+}
+
+} // anonymous namespace
+
