From f593101de468807123754ae67e0f630538ec4643 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 2 Sep 2026 07:01:47 +0800
Subject: [PATCH 269/307] !F (Terrain Plate) Expose live terrain colour through
 ITerrainPlateCommit.

Expose the same footprint, appearance and blend sampling used by the live
preview through ITerrainPlateCommit. Permanent colour operations can therefore
reproduce the displayed result.
---
 .../Geometry/ITerrainPlateCommit.h               | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/ITerrainPlateCommit.h b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/ITerrainPlateCommit.h
index 8d7f6215..26bf67a0 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/ITerrainPlateCommit.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/ITerrainPlateCommit.h
@@ -83,6 +83,22 @@ struct ITerrainPlateCommit
 	//! plate has no usable projection (no material, or a material the CPU cannot sample).
 	virtual bool  GetCommitAlbedoAtWorld(float worldX, float worldY, ColorB& outColor) const = 0;
 
+	//! Decision 08 - the LIVE terrain colour overlay, the editor preview tier of the colour commit.
+	//! False when Terrain Colour From Plate is off, when Bake Into Terrain is off (the drawer that holds
+	//! the tick box goes with it), when the colour half of the commit is off, or when the plate has no
+	//! footprint on the terrain.
+	//!
+	//! The rect is the same square GetCommitAppearanceFootprint returns, in terrain units, and outTint /
+	//! outUseAlbedo are the same values GetCommitAppearance hands the commit - so the overlay blends the
+	//! same source, with the same GetCommitWeightAtWorld rim, as terrain.commit_plate_colour would write.
+	//! That equality is the point: the live tier is a preview of the commit, not a second look.
+	//!
+	//! outSettling is true while the plate has deferred transform work pending, i.e. a drag is in
+	//! progress. Every dirty terrain texture sector costs a whole tile DXT recompress plus an upload, so
+	//! the editor side uses this to hold the repaint back until the plate is dropped.
+	virtual bool  GetLiveColourState(int& outX1, int& outY1, int& outSize, ColorB& outTint,
+	                                 bool& outUseAlbedo, bool& outSettling) const = 0;
+
 	//! Step 2. The plate's appearance commit properties. False when the plate has nothing to stamp.
 	//! The strings point into the component and are only valid for the duration of the call chain.
 	virtual bool  GetCommitAppearance(SAppearance& outAppearance) const = 0;
-- 
