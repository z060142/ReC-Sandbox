+/////////////////////////////////////////////////////////////////////////////////////////////////
+// Lens ghost composite (LensGhostSpec.md, "Pipeline placement")
+//
+// The ghosts accumulate into a layer of their own instead of riding the splat layers, because
+// the pass above runs INSIDE the depth of field stage and everything it adds to the HDR target
+// is still a light source for the glare family that thresholds that target afterwards. A ghost
+// is a second-order internal reflection; a flare struck off one would be third order and
+// invisible. So this - a straight additive blit of the layer, no threshold, no depth, no mask -
+// runs later, once the streaks, the anamorphic flare, the filter PSF and halation have taken
+// their sources. Alpha is left at 0 exactly as the splat overlay leaves it.
+/////////////////////////////////////////////////////////////////////////////////////////////////
+pixout DofGhostCompositePS(vtxOut IN)
+{
+	pixout OUT = (pixout) 0;
+	OUT.Color = float4(GetTexture2D(texDofNrm_DofLayer0, ssDofNrm_DofLayer0, IN.baseTC.xy).rgb, 0);
+	return OUT;
+}
+
+technique DofGhostComposite
+{
+  pass p0
+  {
+    VertexShader = FullscreenTriVS() PostMotionBlurVS;
+    PixelShader = DofGhostCompositePS() PostMotionBlurPS;
+    CullMode = None;
   }
 }
 
