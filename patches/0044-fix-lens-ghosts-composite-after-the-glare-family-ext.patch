+		CClearSurfacePass::Execute(pGhostLayer, Clr_Transparent);
+	}
+
 	if (bSplat && !m_pSpritePerViewCB)
 	{
 		m_pSpritePerViewCB = gcpRendD3D->m_DevBufMan.CreateConstantBuffer(sizeof(HLSL_PerViewGlobalConstantBuffer));
@@ -1393,9 +1492,9 @@ void CDepthOfFieldStage::ExecuteSplatLayers(const SDepthOfFieldParams& dofParams
 			m_pGhostPerViewCB->SetDebugName("LensGhost Per-View CB");
 	}
 
-	// Internal reflection ghosts: one draw per ghost layer into the same near layer, with the
-	// same pixel shader and the same pupil constants the splat above just resolved.
-	if (bGhost && m_pGhostPerViewCB)
+	// Internal reflection ghosts: one draw per ghost layer into the dedicated ghost target, with
