+// The ghost layer. Same size and format as the splat layers - the ghost draws are rasterized at
+// native layer resolution, so anything smaller would only cost the discs their edges - but its
+// own allocation, because it must survive past the splat overlay: it is added to the frame after
+// the glare family has taken its light sources, not with the splats.
+bool CDepthOfFieldStage::AcquireGhostLayer(int width, int height)
+{
+	if (width <= 0 || height <= 0)
+		return false;
+
+	if (m_pTexGhostLayer && m_ghostLayerWidth == width && m_ghostLayerHeight == height)
+		return true;
+
+	ReleaseGhostLayer();
+
+	const uint32 flags = FT_NOMIPS | FT_DONT_STREAM | FT_USAGE_RENDERTARGET;
+	const std::string name = "$DofGhostLayer" + m_graphicsPipeline.GetUniqueIdentifierName();
+
+	m_pTexGhostLayer = CTexture::GetOrCreateRenderTarget(name.c_str(), width, height, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+
+	if (!CTexture::IsTextureExist(m_pTexGhostLayer))
+	{
+		ReleaseGhostLayer();
+		return false;
+	}
+
+	m_ghostLayerWidth = width;
+	m_ghostLayerHeight = height;
+	return true;
+}
+
+void CDepthOfFieldStage::ReleaseGhostLayer()
+{
+	m_pTexGhostLayer.reset();
+	m_ghostLayerWidth = 0;
+	m_ghostLayerHeight = 0;
+	m_bGhostLayerValid = false;
+}
+
 void CDepthOfFieldStage::Resize(int renderWidth, int renderHeight)
 {
 	// Drop them; the next hybrid frame reallocates at the new size.
 	ReleaseSplatLayers();
+	ReleaseGhostLayer();
+}
+
+//////////////////////////////////////////////////////////////////////////////////////////////////
+// Lens ghosts into the frame - the ONE place they reach it (LensGhostSpec.md, section 3.4).
+//
+// The pipeline calls this after the half and quarter resolution downsamples of the HDR target,
+// i.e. after every thresholded glare source has been extracted (diffraction streaks, the
+// anamorphic flare, the front filter PSF, halation) and after auto exposure has metered, and
+// before the tone map, which is the last reader of the HDR target. A ghost is an image of the
+// aperture formed by a SECOND-order reflection between two lens surfaces; a flare struck off one
+// would be third order, some 1/50 to 1/200 of the ghost, and invisible. So ghosts light nothing:
+// they are laid onto the finished frame and nothing downstream thresholds them.
+//
+// Being here also means they are not motion blurred by the scene's velocities - correct, a ghost
+// is formed in the glass and follows the source, not the geometry behind it - and not depth
+// masked, exactly as before.
+//////////////////////////////////////////////////////////////////////////////////////////////////
+void CDepthOfFieldStage::ExecuteGhostComposite()
+{
+	// Consume-once: whoever calls this ends the frame's ghosts, and a frame in which the DOF
+	// stage never ran (r_dof 0, no focus) leaves the flag false and this a no-op.
+	if (!m_bGhostLayerValid)
+		return;
+
+	m_bGhostLayerValid = false;
+
+	CTexture* pGhostLayer = m_pTexGhostLayer;
+	CTexture* pHDRTarget = m_graphicsPipelineResources.m_pTexHDRTarget;
+	if (!CTexture::IsTextureExist(pGhostLayer) || !CTexture::IsTextureExist(pHDRTarget))
+		return;
+
+	PROFILE_LABEL_SCOPE("LENS GHOST COMPOSITE");
+
+	CShader* pShader = CShaderMan::s_shPostDepthOfField;
+
+	if (m_passGhostComposition.IsDirty())
+	{
+		static CCryNameTSCRC techGhostCompose("DofGhostComposite");
+		m_passGhostComposition.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passGhostComposition.SetTechnique(pShader, techGhostCompose, 0);
+		m_passGhostComposition.SetRenderTarget(0, pHDRTarget);
+		// The layer carries only the energy the ghosts deposited, so it is added, not blended.
+		m_passGhostComposition.SetState(GS_NODEPTHTEST | GS_BLSRC_ONE | GS_BLDST_ONE);
+	}
+
+	// Bound every frame: the layer is lazily allocated and recreated on a resolution change, so
+	// its identity is not stable across the pass's cached state. 1:1 read, point sampled.
+	m_passGhostComposition.SetTextureSamplerPair(0, pGhostLayer, EDefaultSamplerStates::PointClamp);
+
+	m_passGhostComposition.BeginConstantUpdate();
+	m_passGhostComposition.Execute();
 }
 
 // Rotation of an RGB colour around the grey axis, the standard 3x3 form. Luminance is preserved
@@ -1271,11 +1361,20 @@ void CDepthOfFieldStage::ExecuteSplatLayers(const SDepthOfFieldParams& dofParams
 		}
 	}
 
-	// Clear the layers once, before either draw: both accumulate additively into them and the
-	// overlay composites whatever ends up there without knowing which pass wrote it.
