From d6cd093dd4d208686b4ce32b4f1f312ae66129eb Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 2 Sep 2026 11:06:34 +0800
Subject: [PATCH 279/307] !B (Terrain Plate) Guard plate frame inversion
 against zero scale.

Centralize plate-frame inversion and reject transforms with a near-zero
determinant. Welding is skipped rather than generating NaN vertices and bounds.
---
 .../Geometry/TerrainPlateComponent.cpp        | 30 ++++++++++++++++---
 .../Geometry/TerrainPlateComponent.h          |  3 ++
 2 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index aa4a7505..1a007b3c 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -1408,6 +1408,19 @@ Matrix34 CTerrainPlateComponent::GetPlateFrameTM() const
 	return m_pEntity->GetWorldTM() * GetTransformMatrix();
 }
 
+bool CTerrainPlateComponent::InvertPlateFrameTM(const Matrix34& frameTM, Matrix34& outInvTM)
+{
+	// Matrix34::Invert divides by the determinant unguarded, so a zero scale (entity, component or group parent)
+	// would fill every welded vertex with NaN and register a NaN AABB in the octree. Same epsilon as the 2x2
+	// solve in SamplePlateSurface, so "edge on" means the same thing everywhere in this component.
+	if (fabs_tpl(frameTM.Determinant()) < 1e-8f)
+		return false;
+
+	outInvTM = frameTM;
+	outInvTM.Invert();
+	return true;
+}
+
 Vec3 CTerrainPlateComponent::GetMeshBuildScale() const
 {
 	// The size RegenerateMesh multiplied into the position stream. It equals GetWorldScale() except
@@ -1721,11 +1734,20 @@ void CTerrainPlateComponent::RegenerateMesh()
 	// use a coarser mesh, and between two ring vertices the plate edge is straight while the terrain bends. So
 	// the fix is a guaranteed sign, not a better sample: the ring is pushed Weld Sink metres below the sampled
 	// surface over the outer quarter of the band, so the border always ends inside the terrain.
-	if (m_bEdgeWeld && gEnv->p3DEngine->GetITerrain() != nullptr)
+	const Matrix34 weldWorldTM = GetPlateFrameTM();
+	Matrix34 invWorldTM;
+	const bool bWeldFrameValid = InvertPlateFrameTM(weldWorldTM, invWorldTM);
+
+	// A degenerate frame is not an error the user cannot see: the plate is flat, so it simply keeps the
+	// generated surface and picks the weld back up as soon as the scale is a number again.
+	if (m_bEdgeWeld && !bWeldFrameValid && GetPlateDebugLevel() >= 1)
+	{
+		CryLog("TerrainPlate '%s': edge weld skipped, the plate has a zero scale on one axis", GetPlateName());
+	}
+
+	if (m_bEdgeWeld && bWeldFrameValid && gEnv->p3DEngine->GetITerrain() != nullptr)
 	{
-		const Matrix34 worldTM = GetPlateFrameTM();
-		Matrix34 invWorldTM = worldTM;
-		invWorldTM.Invert();
+		const Matrix34& worldTM = weldWorldTM;
 
 		const float falloff = clamp_tpl((float)m_weldInnerFalloff, 0.f, 1.f);
 		const float weldSink = max(0.f, (float)m_weldSink);
diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
index 9efebf12..2b09d256 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
@@ -508,6 +508,9 @@ protected:
 	//! world, so it carries the plate's size in its scale. Entity world TM times component TM - NOT the
 	//! slot world matrix, which carries no scale (@see GetPlateNodeTM). Valid before the slot exists.
 	Matrix34    GetPlateFrameTM() const;
+	//! Inverse of a plate frame, refused when the frame is singular. The single guard against a zero scale
+	//! turning every vertex it touches into NaN; Matrix34::Invert has none of its own.
+	static bool InvertPlateFrameTM(const Matrix34& frameTM, Matrix34& outInvTM);
 	//! The RENDER NODE's world matrix: the design frame with the size the MESH WAS BUILT AT divided out of
 	//! each column. The mesh is generated in world metres, so the slot cancels the scale (@see
 	//! ApplySlotScaleCompensation); the columns are unit length except during a deferred drag.
