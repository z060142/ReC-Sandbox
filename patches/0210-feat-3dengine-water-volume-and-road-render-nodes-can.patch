From 746aab612d0dcf19e810a6d867dd52d9ddf22f31 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sat, 12 Sep 2026 15:19:01 +0800
Subject: [PATCH 210/221] feat(3dengine): water volume and road render nodes
 can be entity-owned

CWaterVolumeRenderNode and CRoadRenderNode now implement SetOwnerEntity /
GetOwnerEntity, the two lines CMovableBrush (Brush.h:144-145) and
CFogVolumeRenderNode (FogVolumeRenderNode.h:44-45) already carry. The base
implementation is an assert ("Not supported by this object type",
IRenderNode.h:631), which is what a water node handed to an entity slot used to
hit, and GetOwnerEntity() stayed null - so COctreeNode::SaveObjects did not skip
it and the level export would have baked a second copy of a volume an entity
already owns (ObjectsTree_Serialize.cpp:295 and :321).

Nothing else in either class reads the owner, so a node that nobody owns - every
legacy WaterVolume, River and Road object - behaves exactly as before.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SCUvWGLCsqzm3VNMzp4uiS
---
 Code/CryEngine/Cry3DEngine/RoadRenderNode.h        | 13 +++++++++++++
 Code/CryEngine/Cry3DEngine/WaterVolumeRenderNode.h | 14 ++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/Code/CryEngine/Cry3DEngine/RoadRenderNode.h b/Code/CryEngine/Cry3DEngine/RoadRenderNode.h
index ced29d53..e5b2e209 100644
--- a/Code/CryEngine/Cry3DEngine/RoadRenderNode.h
+++ b/Code/CryEngine/Cry3DEngine/RoadRenderNode.h
@@ -82,6 +82,16 @@ public:
 	virtual void                SetLayerId(uint16 nLayerId) override { m_nLayerId = nLayerId; Get3DEngine()->C3DEngine::UpdateObjectsLayerAABB(this); }
 	virtual uint16              GetLayerId() const          override { return m_nLayerId; }
 
+	// An entity component may own a road (ReC Sandbox, AreaComponents). Recording the owner is what
+	// keeps COctreeNode::SaveObjects from baking the node into the level's octree blob
+	// (ObjectsTree_Serialize.cpp:295 and :321, "Do not serialize nodes owned by the Entity"), so the
+	// entity stays the single source of truth and the level never ships two copies of one road. The
+	// same two lines as CMovableBrush (Brush.h:144-145) and CFogVolumeRenderNode
+	// (FogVolumeRenderNode.h:44-45); the base is an assert (IRenderNode.h:631). Nothing else in this
+	// class reads the owner, so a node that nobody owns behaves exactly as before.
+	virtual void                SetOwnerEntity(IEntity* pEntity) override { m_pOwnerEntity = pEntity; }
+	virtual IEntity*            GetOwnerEntity() const           override { return m_pOwnerEntity; }
+
 	static bool                 ClipTriangle(PodArray<Vec3>& lstVerts, PodArray<vtx_idx>& lstInds, int nStartIdxId, Plane* pPlanes);
 	using IRenderNode::Physicalize;
 	virtual void                Dephysicalize(bool bKeepIfReferenced = false) override;
@@ -107,6 +117,9 @@ public:
 
 	uint16           m_nLayerId;
 
+	// When the render node is created by an entity component, the owner entity; null otherwise.
+	IEntity*         m_pOwnerEntity = nullptr;
+
 	// Temp buffers used during road mesh creation
 	static PodArray<Vec3>            s_tempVertexPositions;
 	static PodArray<vtx_idx>         s_tempIndices;
diff --git a/Code/CryEngine/Cry3DEngine/WaterVolumeRenderNode.h b/Code/CryEngine/Cry3DEngine/WaterVolumeRenderNode.h
index abe264a8..12618674 100644
--- a/Code/CryEngine/Cry3DEngine/WaterVolumeRenderNode.h
+++ b/Code/CryEngine/Cry3DEngine/WaterVolumeRenderNode.h
@@ -139,6 +139,17 @@ public:
 	virtual void         SetLayerId(uint16 nLayerId) override { m_nLayerId = nLayerId; Get3DEngine()->C3DEngine::UpdateObjectsLayerAABB(this); }
 	virtual uint16       GetLayerId() const          override { return m_nLayerId; }
 
+	// An entity component may own a water volume (ReC Sandbox, AreaComponents). Recording the owner
+	// is what keeps COctreeNode::SaveObjects from baking the node into the level's octree blob
+	// (ObjectsTree_Serialize.cpp:295 and :321, "Do not serialize nodes owned by the Entity"), so the
+	// entity stays the single source of truth and the level never ships two copies of one volume.
+	// The same two lines as CFogVolumeRenderNode (FogVolumeRenderNode.h:44-45) and CMovableBrush
+	// (Brush.h:144-145); the base is an assert (IRenderNode.h:631), which is what a node put into an
+	// entity slot used to hit. Nothing else in this class reads the owner, so a node that nobody
+	// owns behaves exactly as before.
+	virtual void         SetOwnerEntity(IEntity* pEntity) override { m_pOwnerEntity = pEntity; }
+	virtual IEntity*     GetOwnerEntity() const           override { return m_pOwnerEntity; }
+
 	void                 Render_JobEntry(SRendParams rParam, SRenderingPassInfo passInfo);
 	virtual bool         CanExecuteRenderAsJob() const override;
 
@@ -226,4 +237,7 @@ private:
 	pe_params_area             m_auxPhysParams;
 	float                      m_density = 1000;
 	float                      m_resistance = 1000;
+
+	// When the render node is created by an entity component, the owner entity; null otherwise.
+	IEntity*                   m_pOwnerEntity = nullptr;
 };
