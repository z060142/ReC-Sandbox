From dc854b0af76fc9ab3d1e1e27c5b345bf7132e8d6 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Thu, 13 Aug 2026 13:38:31 +0800
Subject: [PATCH 203/206] fix: LPV specular drowned cubemap reflections in
 white haze

The L1 SH reflection march is a very wide cone - physically a rough
reflection only. Fade it with (1 - smoothness)^2 in ApplyGI mode 3 so
sharp cubemap / SSR reflections stay in charge on smooth surfaces.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tu9cj9ax1mqCV93HVfCfpW
---
 Engine/Shaders/HWScripts/CryFX/TiledShading.cfi | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Engine/Shaders/HWScripts/CryFX/TiledShading.cfi b/Engine/Shaders/HWScripts/CryFX/TiledShading.cfi
index e9271399..6c94d1b5 100644
--- a/Engine/Shaders/HWScripts/CryFX/TiledShading.cfi
+++ b/Engine/Shaders/HWScripts/CryFX/TiledShading.cfi
@@ -144,7 +144,11 @@ void ApplyGI(inout float3 specularAcc, inout float3 diffuseAcc, float3 diffuseFo
 		diffuseAcc += TexGiDiffuse[pixelCoord].rgb;
 		// Reflected-ray march radiance, modulated by the surface reflectance. Black when
 		// r_LPVSpecular is 0 (the slot then holds the black texture).
-		specularAcc += TexGiSpecular[pixelCoord].rgb * surfSpecCol;
+		// The L1 SH march is a VERY wide cone - physically it approximates a rough reflection
+		// only. Fade it out with gloss so the sharp cubemap / SSR reflections stay in charge on
+		// smooth surfaces (added at full strength it drowned them in a uniform white haze).
+		const float3 roughnessWeight = saturate(1.0f - surfGloss);
+		specularAcc += TexGiSpecular[pixelCoord].rgb * surfSpecCol * roughnessWeight * roughnessWeight;
 	}
 }
 #endif
