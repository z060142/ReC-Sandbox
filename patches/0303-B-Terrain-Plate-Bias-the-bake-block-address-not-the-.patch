From 6dabd7eb5f24a1e4eff0fd549a6ea76c778b7be3 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Thu, 3 Sep 2026 14:22:50 +0800
Subject: [PATCH 303/307] !B (Terrain Plate) Bias the bake block address, not
 the pointer.

WriteTerrainBlock allocates only the rows the engine reads (dim rows of
the full terrain stride, ~3 MB for a 3-sector plate instead of 256 MB for
the whole map) and hands SetTerrainElevation a pointer biased back by X1
rows so that pTerrainBlock[ux * nHmapSize + uy] lands in the buffer for
ux from X1. The bias was computed as block.data() - X1 * hmapSize, which
forms a pointer before the start of the allocation. Nothing dereferences
it - CTerrain::SetTerrainElevation only touches rows X1 .. X1 + nSize,
all inside the buffer - but forming such a pointer is undefined behaviour
in C++, so a compiler is free to assume it cannot happen and miscompile
the call.

Do the same arithmetic in the integer domain instead: take the buffer
address as uintptr_t, subtract the byte offset, reinterpret_cast back.
Same address, same bytes written, no out-of-bounds pointer value. The
engine interface is untouched and the allocation stays row-sized.

The editor's own caller (Heightmap.cpp) passes the full m_pHeightmap, so
this trick exists nowhere else in the tree.
---
 .../DefaultComponents/Geometry/TerrainPlateComponent.cpp    | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index 03ba9936..8460807c 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -2898,7 +2898,11 @@ bool CTerrainPlateComponent::WriteTerrainBlock(const SBakeTerrainMetrics& metric
 		memcpy(&block[(size_t)ux * metrics.hmapSize + m_bakeRectY1], &heights[(size_t)ux * dim], sizeof(float) * copyCols);
 	}
 
-	float* const pBlock = block.data() - (size_t)m_bakeRectX1 * metrics.hmapSize;
+	// The bias is applied to the integer value, not to the pointer: block.data() - X1 * hmapSize would form a
+	// pointer before the allocation, which is undefined behaviour even though nothing ever dereferences it (the
+	// callee only touches rows X1 .. X1 + nSize, all inside the buffer). Same address, no UB.
+	const uintptr_t blockAddr = reinterpret_cast<uintptr_t>(block.data());
+	float* const    pBlock = reinterpret_cast<float*>(blockAddr - (uintptr_t)((size_t)m_bakeRectX1 * metrics.hmapSize * sizeof(float)));
 
 	pTerrain->SetTerrainElevation(m_bakeRectX1, m_bakeRectY1, m_bakeRectSize, m_bakeRectSize,
 	                              pBlock, nullptr, 0, 0, 0, 0, nullptr, 0, 0);
