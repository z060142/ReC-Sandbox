@@ -772,6 +781,26 @@ void CSnowStage::RenderSnowClusters()
 		renderState = ReverseDepthHelper::ConvertDepthFunc(renderState);
 	}
 
+	// The Rec.709 -> working-space matrix, minus identity, built from the one CPU conversion the
+	// tree owns. Identity (and therefore all zeros) whenever the HDR target is not actually AP1,
+	// so the stock path adds an exact zero and stays bit-identical.
+	Vec3 workingDelta[3];
+	{
+		const Vec3 basis[3] = { Vec3(1, 0, 0), Vec3(0, 1, 0), Vec3(0, 0, 1) };
+		for (int i = 0; i < 3; ++i)
+		{
+			const Vec3 converted = CRendererResources::ToWorkingSpace(basis[i]);
+			workingDelta[i] = Vec3(converted.x - basis[i].x, converted.y - basis[i].y, converted.z - basis[i].z);
+		}
+	}
+	// Column-major fill: row r of the matrix is (delta[0][r], delta[1][r], delta[2][r]).
+	{
+		const Vec3 c0 = workingDelta[0], c1 = workingDelta[1], c2 = workingDelta[2];
+		workingDelta[0] = Vec3(c0.x, c1.x, c2.x);
+		workingDelta[1] = Vec3(c0.y, c1.y, c2.y);
+		workingDelta[2] = Vec3(c0.z, c1.z, c2.z);
+	}
+
 	static CCryNameTSCRC tech0Name("SceneSnow");
 	const Vec4 vSnowFlakeParams = Vec4(snowVolParams.m_fSnowFallBrightness, min(10.0f, snowVolParams.m_fSnowFlakeSize), snowVolParams.m_fSnowFallTurbulence, snowVolParams.m_fSnowFallTurbulenceFreq);
 	const Vec4 vWaterLevel = Vec4(PF.vWaterLevel, 0.0f);
@@ -816,6 +845,9 @@ void CSnowStage::RenderSnowClusters()
 
 			auto constants = pPrim->GetConstantManager().BeginTypedConstantUpdate<SSnowClusterCB>(eConstantBufferShaderSlot_PerPrimitive, EShaderStage_Vertex | EShaderStage_Pixel);
 
+			constants->vSnowWorkingDelta0 = Vec4(workingDelta[0], 0.0f);
+			constants->vSnowWorkingDelta1 = Vec4(workingDelta[1], 0.0f);
+			constants->vSnowWorkingDelta2 = Vec4(workingDelta[2], 0.0f);
 			constants->vWaterLevel = vWaterLevel;
 			constants->vSnowFlakeParams = vSnowFlakeParams;
 			constants->vSnowClusterPos = Vec4(cluster.m_pPos, 1.0f);
