+	// Mask rotation: the mask is its own element, turned independently of the iris phase. The
+	// splat samples the texture through the inverse rotation, so both views turn together.
+	const float c = cosf(m_maskRotation);
+	const float s = sinf(m_maskRotation);
+	return Vec4(px * c - py * s, px * s + py * c, 0.0f, 0.0f);
