 	// is the smaller hole the mask coordinates are rescaled by it, same as the splat quad.
 	const float fInvBound = 1.0f / max(m_maskBound, 1e-3f);
-	return Vec4((fx * 2.0f - 1.0f) * fInvBound, (fy * 2.0f - 1.0f) * fInvBound, 0.0f, 0.0f);
+	const float px = (fx * 2.0f - 1.0f) * fInvBound;
+	const float py = (fy * 2.0f - 1.0f) * fInvBound;
