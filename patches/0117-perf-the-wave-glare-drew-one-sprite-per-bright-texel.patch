+// The source budget's reduction chain (decisions/s8-glare-budget.md).
+//
+// Three passes and no CPU round trip. Only the first reads the frame - one point read per
+// half-resolution texel, about 0.02 ms at 1080p - and the two after it work on 8 kpx and 256 px.
+//
+//   1. source            -> 8x8 tiles   (raw count, count above the cutoff, summed excess,
+//                                        excess below the cutoff)
+//   2. tiles             -> a fixed 16x16, same four sums, so that
+//   3. 16x16             -> ONE texel, always 256 taps, which also CORRECTS the cutoff from the
+//                           previous frame's count.
+//
+// The 1x1 is ping-ponged because step 3 has to read the previous cutoff in order to correct it,
+// and no pass may read the target it writes. That is also the controller's one frame of lag: the
+// population is measured against last frame's cutoff, so a hard cut to a bright sky overshoots
+// the budget for two or three frames and then settles. The alternative - a histogram, exact in
+// one frame - is three more passes and four more targets for a precision the vertex shader's
+// one-stop crossfade throws away anyway; the note records it as the fallback.
+//
+// N = 0 means "count, but do not budget": the chain still runs so r_HDRDiffractionDebug 3 can
+// report the raw population, and the cutoff decays to zero, which is the un-budgeted pass
+// bit for bit.
+CTexture* CBloomStage::ExecuteDiffractionBudget(CTexture* pSource, int nBudget)
+{
+	if (!CTexture::IsTextureExist(m_pTexDiffractionTileStats) || !CTexture::IsTextureExist(m_pTexDiffractionStatsMid) ||
+	    !CTexture::IsTextureExist(m_pTexDiffractionStats[0]) || !CTexture::IsTextureExist(m_pTexDiffractionStats[1]))
+		return nullptr;
+
+	PROFILE_LABEL_SCOPE("HDR_DIFFRACTION_BUDGET");
+
+	static CCryNameTSCRC techSourceStats("HDRDiffractionSourceStats");
+	static CCryNameTSCRC techStatsReduce("HDRDiffractionStatsReduce");
+	static CCryNameTSCRC techBudget("HDRDiffractionBudget");
+	static CCryNameR statsParams0Name("DiffractionStatsParams0");
+	static CCryNameR statsParams1Name("DiffractionStatsParams1");
+	static CCryNameR budgetParamsName("DiffractionBudgetParams");
+
+	CTexture* pPrev = m_pTexDiffractionStats[m_nDiffractionStatsIndex];
+	m_nDiffractionStatsIndex ^= 1;
+	CTexture* pCur = m_pTexDiffractionStats[m_nDiffractionStatsIndex];
+
+	const int nSrcW  = pSource->GetWidth();
+	const int nSrcH  = pSource->GetHeight();
+	const int nTileW = m_pTexDiffractionTileStats->GetWidth();
+	const int nTileH = m_pTexDiffractionTileStats->GetHeight();
+	const int nMidW  = m_pTexDiffractionStatsMid->GetWidth();
+	const int nMidH  = m_pTexDiffractionStatsMid->GetHeight();
+
+	// 1. Source -> tiles. kDiffractionStatsTileSize is the block, not the target size: the
+	//    target is whatever that many blocks cover.
+	if (m_passDiffractionSourceStats.IsDirty(pSource->GetTextureID(), pPrev->GetTextureID()))
+	{
+		m_passDiffractionSourceStats.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passDiffractionSourceStats.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passDiffractionSourceStats.SetTechnique(CShaderMan::s_shHDRPostProcess, techSourceStats, 0);
+		m_passDiffractionSourceStats.SetRenderTarget(0, m_pTexDiffractionTileStats);
+		m_passDiffractionSourceStats.SetState(GS_NODEPTHTEST);
+		m_passDiffractionSourceStats.SetTexture(0, pSource);
+		m_passDiffractionSourceStats.SetTexture(1, pPrev);
+		m_passDiffractionSourceStats.SetSampler(0, EDefaultSamplerStates::PointClamp);
+		m_passDiffractionSourceStats.SetSampler(1, EDefaultSamplerStates::PointClamp);
+	}
+
+	m_passDiffractionSourceStats.BeginConstantUpdate();
+	m_passDiffractionSourceStats.SetConstant(statsParams0Name,
+	                                         Vec4(1.0f / (float)max(nSrcW, 1), 1.0f / (float)max(nSrcH, 1),
+	                                              (float)kDiffractionStatsTileSize, (float)kDiffractionStatsTileSize), eHWSC_Pixel);
+	m_passDiffractionSourceStats.SetConstant(statsParams1Name,
+	                                         Vec4((float)nSrcW, (float)nSrcH, (float)nTileW, (float)nTileH), eHWSC_Pixel);
+	m_passDiffractionSourceStats.Execute();
+
+	// 2. Tiles -> the fixed 16x16. The block is whatever it takes to cover the tile grid, so
+	//    step 3 is always the same 256 taps at any resolution.
+	const int nReduceX = (nTileW + nMidW - 1) / nMidW;
+	const int nReduceY = (nTileH + nMidH - 1) / nMidH;
+
+	if (m_passDiffractionStatsReduce.IsDirty(m_pTexDiffractionTileStats->GetTextureID()))
+	{
+		m_passDiffractionStatsReduce.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passDiffractionStatsReduce.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passDiffractionStatsReduce.SetTechnique(CShaderMan::s_shHDRPostProcess, techStatsReduce, 0);
+		m_passDiffractionStatsReduce.SetRenderTarget(0, m_pTexDiffractionStatsMid);
+		m_passDiffractionStatsReduce.SetState(GS_NODEPTHTEST);
+		m_passDiffractionStatsReduce.SetTexture(0, m_pTexDiffractionTileStats);
+		m_passDiffractionStatsReduce.SetSampler(0, EDefaultSamplerStates::PointClamp);
+	}
+
+	m_passDiffractionStatsReduce.BeginConstantUpdate();
+	m_passDiffractionStatsReduce.SetConstant(statsParams0Name,
+	                                         Vec4(1.0f / (float)max(nTileW, 1), 1.0f / (float)max(nTileH, 1),
+	                                              (float)nReduceX, (float)nReduceY), eHWSC_Pixel);
+	m_passDiffractionStatsReduce.SetConstant(statsParams1Name,
+	                                         Vec4((float)nTileW, (float)nTileH, (float)nMidW, (float)nMidH), eHWSC_Pixel);
+	m_passDiffractionStatsReduce.Execute();
+
+	// 3. 16x16 -> one texel, and the cutoff with it.
+	if (m_passDiffractionBudget.IsDirty(m_pTexDiffractionStatsMid->GetTextureID(), pPrev->GetTextureID(), pCur->GetTextureID()))
+	{
+		m_passDiffractionBudget.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passDiffractionBudget.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passDiffractionBudget.SetTechnique(CShaderMan::s_shHDRPostProcess, techBudget, 0);
+		m_passDiffractionBudget.SetRenderTarget(0, pCur);
+		m_passDiffractionBudget.SetState(GS_NODEPTHTEST);
+		m_passDiffractionBudget.SetTexture(0, m_pTexDiffractionStatsMid);
+		m_passDiffractionBudget.SetTexture(1, pPrev);
+		m_passDiffractionBudget.SetSampler(0, EDefaultSamplerStates::PointClamp);
+		m_passDiffractionBudget.SetSampler(1, EDefaultSamplerStates::PointClamp);
+	}
+
+	m_passDiffractionBudget.BeginConstantUpdate();
+	m_passDiffractionBudget.SetConstant(statsParams0Name,
+	                                    Vec4(1.0f / (float)max(nMidW, 1), 1.0f / (float)max(nMidH, 1),
+	                                         (float)nMidW, (float)nMidH), eHWSC_Pixel);
+	m_passDiffractionBudget.SetConstant(statsParams1Name,
+	                                    Vec4((float)nMidW, (float)nMidH, 1.0f, 1.0f), eHWSC_Pixel);
+	m_passDiffractionBudget.SetConstant(budgetParamsName, Vec4((float)nBudget, 0.0f, 0.0f, 0.0f), eHWSC_Pixel);
+	m_passDiffractionBudget.Execute();
+
+	return pCur;
+}
