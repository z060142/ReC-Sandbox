 .../RenderDll/Common/RendererResources.cpp    | 53 +++++++++++++++----
 .../GraphicsPipeline/AutoExposure.cpp         |  8 ++-
 .../GraphicsPipeline/AutoExposure.h           |  4 ++
 3 files changed, 54 insertions(+), 11 deletions(-)

diff --git a/Code/CryEngine/RenderDll/Common/RendererResources.cpp b/Code/CryEngine/RenderDll/Common/RendererResources.cpp
index 28e4e241..1d99e1ea 100644
--- a/Code/CryEngine/RenderDll/Common/RendererResources.cpp
+++ b/Code/CryEngine/RenderDll/Common/RendererResources.cpp
@@ -12,6 +12,8 @@
 
 #include "RendElements/FlareSoftOcclusionQuery.h"
 
+#include <map>
+
 ////////////////////////////////////////////////////////////////////////////////////////////////////
 ////////////////////////////////////////////////////////////////////////////////////////////////////
 
@@ -470,9 +472,25 @@ ETEX_Format CRendererResources::GetDisplayFormat()
 // existed - the gate can only ever take work AWAY from a render, never add it.
 static bool        s_bSceneReferredPipelineGate = true;
 static const char* s_szSceneReferredPipelineName = "";
-static bool        s_bSceneReferredGateLogged = false;
-static bool        s_bSceneReferredGateLoggedState = true;
-static std::string s_sSceneReferredGateLoggedName;
+
+// The remembered verdict is PER PIPELINE, and it has to be: a routine editor session cycles six to
+// ten pipelines within a single frame, and this function is called once for each of them. A single
+// remembered (verdict, name) pair - which is what the first version of this gate kept - is
+// therefore invalidated by the very next call, so "log only on a change" degenerated into one line
+// per pipeline per frame, and the two lines for 'Minimum_1' (no) and 'Standard_0' (yes) buried
+// every other line in the console. Keyed by pipeline name, the alternation is no longer a change.
+//
+// The reason string is part of the key of the decision, not decoration: 'Standard_0' going from
+// "owns a display transform" to "map screenshot - an asset, not a picture" is the same verdict
+// (no longer scene-referred) for a different cause, and that IS worth a line.
+struct SSceneReferredGateVerdict
+{
+	bool   bOpen;
+	string sReason;
+};
+
+static std::map<string, SSceneReferredGateVerdict> s_sceneReferredGateVerdicts;
+static bool                                        s_bSceneReferredGateRequestLogged = false;
 
 void CRendererResources::SetSceneReferredPipelineGate(bool bOpen, const char* szPipelineName, const char* szReason)
 {
@@ -483,19 +501,34 @@ void CRendererResources::SetSceneReferredPipelineGate(bool bOpen, const char* sz
 	// see once when a preview stops being pre-exposed, and it is what a bug report needs to carry.
 	// It is only interesting while the camera is actually asking for the path.
 	if (!IsSceneReferredRequested())
+	{
+		// ...but the moment it stops asking is worth exactly one line, and it is also the moment to
+		// forget every verdict: the next time the switch comes on, the user wants the full roll call
+		// of pipelines again rather than silence left over from the previous session.
+		if (s_bSceneReferredGateRequestLogged)
+		{
+			s_bSceneReferredGateRequestLogged = false;
+			s_sceneReferredGateVerdicts.clear();
+			CryLogAlways("[SceneReferred] scene-referred no longer requested - the pipeline gate is idle");
+		}
 		return;
+	}
+
+	s_bSceneReferredGateRequestLogged = true;
+
+	const string sName(s_szSceneReferredPipelineName);
+	const string sReason(szReason ? szReason : "");
 
-	if (s_bSceneReferredGateLogged &&
-	    s_bSceneReferredGateLoggedState == bOpen &&
-	    s_sSceneReferredGateLoggedName == s_szSceneReferredPipelineName)
+	auto it = s_sceneReferredGateVerdicts.find(sName);
+	if (it != s_sceneReferredGateVerdicts.end() && it->second.bOpen == bOpen && it->second.sReason == sReason)
 		return;
 
-	s_bSceneReferredGateLogged = true;
-	s_bSceneReferredGateLoggedState = bOpen;
-	s_sSceneReferredGateLoggedName = s_szSceneReferredPipelineName;
+	SSceneReferredGateVerdict& verdict = s_sceneReferredGateVerdicts[sName];
+	verdict.bOpen = bOpen;
+	verdict.sReason = sReason;
 
 	CryLogAlways("[SceneReferred] pipeline '%s' scene-referred: %s (%s)",
-	             s_szSceneReferredPipelineName, bOpen ? "yes" : "no", szReason ? szReason : "");
+	             sName.c_str(), bOpen ? "yes" : "no", sReason.c_str());
 }
 
 bool CRendererResources::IsSceneReferredPipelineGateOpen()
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.cpp
index 1b7e784a..11d1f33c 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.cpp
@@ -407,10 +407,16 @@ bool CAutoExposureStage::EnsureMeterHistogramTexture()
 	if (!CTexture::IsTextureExist(m_pTexMeterHistogram) || m_pTexMeterHistogram->GetDevTexture() == nullptr)
 	{
 		m_pTexMeterHistogram.reset();
-		CryLogAlways("[SceneReferred] the metering histogram target could not be created - AUTO falls back to the log-mean meter");
+		if (!m_bMeterHistogramFailureLogged)
+		{
+			m_bMeterHistogramFailureLogged = true;
+			CryLogAlways("[SceneReferred] the metering histogram target could not be created - AUTO falls back to the log-mean meter");
+		}
 		return false;
 	}
 
+	m_bMeterHistogramFailureLogged = false;
+
 	const SResourceView typedUAV = SResourceView::UnorderedAccessView(DXGI_FORMAT_R32_UINT, 0, -1, 0,
 	                                                                  SResourceView::eUAV_ReadWrite);
 	m_meterHistogramUAV = m_pTexMeterHistogram->GetDevTexture()->GetOrCreateResourceViewHandle(typedUAV);
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.h b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.h
index bfc0780e..2ec25396 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.h
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/AutoExposure.h
@@ -64,6 +64,10 @@ private:
 	_smart_ptr<CTexture> m_pTexMeterHistogram;
 	ResourceViewHandle   m_meterHistogramUAV = EDefaultResourceViews::UnorderedAccess;
 	bool                 m_bMeterHistogramValid = false;
+	// The creation failure below is retried every frame the meter runs, so the line that reports it
+	// has to be latched or it becomes a per-frame log. Cleared when a target is created, so a
+	// failure that comes back after a device reset is reported again.
+	bool                 m_bMeterHistogramFailureLogged = false;
 
 	// Readback state. m_fMeterIssuedExposure is the pre-exposure that was in force for the frame
 	// whose sample is currently in flight: dividing by THAT, and not by the current one, is what
