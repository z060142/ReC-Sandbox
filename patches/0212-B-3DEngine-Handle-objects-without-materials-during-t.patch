From 44dc241de9a11689a546cb747332735797ccb72b Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sun, 30 Aug 2026 16:20:29 +0800
Subject: [PATCH 212/307] !B (3DEngine) Handle objects without materials during
 terrain integration.

Skip and report integrating nodes without a usable material instead of
dereferencing a null material while building the sector mesh. Release the
render-mesh lock before leaving this path.
---
 Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp b/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
index 0556773c..b3aa9854 100644
--- a/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
+++ b/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
@@ -1457,6 +1457,15 @@ void CTerrainNode::AppendTrianglesFromObjects(const int nOriginX, const int nOri
 
 				IMaterial* pMat = pRNode->GetMaterial();
 
+				if (!pMat)
+				{
+					// pMat is dereferenced unconditionally below (GetShaderItem); an entity slot with no
+					// material override and a statobj whose material failed to load would crash here.
+					WarnAboutIntegratedObjectOnce(pRNode, nullptr, "has no material and is skipped by terrain object integration");
+					pRM->UnLockForThreadAccess();
+					continue;
+				}
+
 				float unitSize2 = (float)CTerrain::GetHeightMapUnitSize() / 2;
 
 				TRenderChunkArray& Chunks = pRM->GetChunks();
-- 
