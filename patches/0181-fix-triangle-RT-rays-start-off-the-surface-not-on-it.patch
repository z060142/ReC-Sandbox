From 246f3a88ab3fbeb6e436a5007b12d028f95cedd1 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sun, 13 Sep 2026 18:32:49 +0800
Subject: [PATCH 181/215] fix: triangle-RT rays start off the surface, not on
 it

The G-buffer position lies within depth precision of the triangle that
produced it, so a ray started exactly there self-intersects at grazing
angles and far distances where the 1 mm hit epsilon is smaller than the
depth error. Push the origin along the shading normal by
max(2 mm, 0.2 mm per metre of camera distance) for RT pixels only
(inside the %_RT_QUALITY block; decision 03 section 3.6).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SCUvWGLCsqzm3VNMzp4uiS
---
 Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx b/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx
index 883dc4f7..e1781fea 100644
--- a/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx
+++ b/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx
@@ -1627,6 +1627,11 @@ pixoutMRTTrace ConeTracePS(vtxOutWPOS IN)
 			// triangle rays get their own length budget, not the cone length
 			fRayLen = VOX_MAX_RT_DIST_RAY;
 
+			// R01 (decision 03 section 3.6): the G-buffer position sits within depth precision of the
+			// triangle that produced it, so push the origin off the surface along the shading normal,
+			// scaled with distance, instead of relying on the 1 mm hit epsilon alone.
+			r.startpoint += normalize(vNor0) * max(0.002f, 0.0002f * fDistM);
+
 			RT_ResetInfo(vFocus, VOX_MAX_RT_DIST_RAY, fDistM, RT_GetStippleAlphaRef(nXY), false);
 		}
 #else
