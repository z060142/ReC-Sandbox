+	uint32                   m_lastBakeProbeFrameId = 0;
 	bool                     m_bBakeOverlapWarningIssued = false;
+	bool                     m_bBakeQuantWarningIssued = false;
 	bool                     m_bBakeSizeWarningIssued = false;
 };
