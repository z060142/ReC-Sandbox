 	// Only ticked while a rebuild was throttled away or held back, while the first bake is still owed,
 	// or while a live bake has to be watched - so a plate that is not baking costs nothing per frame.
-	if (m_bRegenPending || m_bDeferredXformPending || m_bInitialBakePending)
+	if (m_bRegenPending || m_bDeferredXformPending || m_bInitialBakePending
+	    || (m_bBakeIntoTerrain && GetBakeProbeFrames() > 0))
 	{
 		bitFlags |= ENTITY_EVENT_UPDATE;
 	}
@@ -737,6 +767,10 @@ void CTerrainPlateComponent::ProcessEvent(const SEntityEvent& event)
 					m_pEntity->UpdateComponentEventMask(this);
 				}
 			}
+			else
+			{
+				PollBake();
+			}
 		}
 		break;
 
@@ -1516,6 +1550,12 @@ float SampleTerrainUnit(const SBakeTerrainMetrics& metrics, int ux, int uy)
 	return gEnv->p3DEngine->GetTerrainZ(((float)cx + 0.5f) * metrics.unitSize, ((float)cy + 0.5f) * metrics.unitSize);
 }
 
+//! The quantisation step SetTerrainElevation will give a sector holding this height span
+//! (terran_edit.cpp:281-286).
+float TerrainQuantStep(float fMin, float fMax)
+{
+	return (max(0.f, fMin - kTerrainDeformationDepth) < fMax) ? ((fMax - max(0.f, fMin - kTerrainDeformationDepth)) / kTerrainHeightQuantSteps) : 0.f;
+}
 }
 
