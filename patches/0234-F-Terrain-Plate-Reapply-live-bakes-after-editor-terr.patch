Date: Mon, 31 Aug 2026 03:20:52 +0800
Subject: [PATCH 234/307] !F (Terrain Plate) Reapply live bakes after editor
 terrain updates.

Editor terrain operations can overwrite a live bake without notifying the
component. Probe the footprint at a low frequency and reapply the bake when
the terrain differs beyond its quantization tolerance.
---
 .../Geometry/TerrainPlateComponent.cpp        | 236 +++++++++++++++++-
 .../Geometry/TerrainPlateComponent.h          |  25 ++
 2 files changed, 259 insertions(+), 2 deletions(-)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index 5fa93f52..39c9f4e4 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -31,6 +31,12 @@ namespace
 int    g_terrainPlateSettleFrames = 6;
 ICVar* g_pTerrainPlateSettleFramesCVar = nullptr;
 
+//! Bake polling: any editor terrain push (sculpt, undo, even a layer paint) rewrites the sectors it
+//! covers and erases the bake there, and the engine has no notification for it
+//! (scene-notes/terrain/research/08-virtual-bake.md section 2.2, trigger T1).
+int    g_terrainPlateBakeProbeFrames = 16;
+ICVar* g_pTerrainPlateBakeProbeFramesCVar = nullptr;
+
 //! Every plate that currently holds a live bake. Only used to detect overlapping footprints; the
 //! priority cascade that would make an overlap actually correct is step 3 of decision 04.
 std::vector<CTerrainPlateComponent*> g_bakingPlates;
@@ -39,6 +45,11 @@ std::vector<CTerrainPlateComponent*> g_bakingPlates;
 //! rule 1). One centimetre would already be below the 12 bit quantisation of a tall sector; two is
 //! the value the decision fixed and it is still invisible.
 const float kBakeEpsilonMeters = 0.02f;
+//! Heights are stored as 12 bit per sector: fRange = (fMax - fMin) / 0x0FFF (terran_edit.cpp:291).
+const float kTerrainHeightQuantSteps = 4095.f;
+//! TERRAIN_DEFORMATION_MAX_DEPTH (I3DEngine.h:662): the head room SetTerrainElevation reserves below
+//! a sector's minimum before it quantises.
+const float kTerrainDeformationDepth = 3.f;
 
 //! e_TerrainIntegrateObjectsDebug, the cvar the rest of the terrain integration work logs under.
 int GetTerrainIntegrateDebugLevel()
@@ -62,6 +73,14 @@ void RegisterTerrainPlateCVars()
 	                                                 "runs anyway. This is only a fallback - the normal trigger is the editor's mouse up\n"
 	                                                 "event ENTITY_EVENT_XFORM_FINISHED_EDITOR.\n"
 	                                                 "0 - no fallback, only the mouse up event flushes");
+
+	g_pTerrainPlateBakeProbeFramesCVar = REGISTER_CVAR2("e_TerrainPlateBakeProbeFrames", &g_terrainPlateBakeProbeFrames, 16, VF_NULL,
+	                                                    "Terrain Plate component with Bake Into Terrain = true: number of frames between two\n"
+	                                                    "checks that the bake is still in the terrain. Any editor terrain operation (sculpt,\n"
+	                                                    "undo, layer paint, leaving game mode) re-pushes the editor heightmap over the sectors\n"
+	                                                    "it touches and erases the bake there, and the engine sends no notification for it, so\n"
+	                                                    "the plate watches nine cells of its own footprint and re-applies itself when they move.\n"
+	                                                    "0 - no polling, the bake stays erased until the plate is edited");
 }
 
