+void CTerrainPlateComponent::BuildBakeProbes(const SBakeTerrainMetrics& metrics, const Matrix34& worldTM)
+{
+	m_bakeProbeCount = 0;
+
+	const int dim = m_bakeRectSize + 1;
+	if ((int)m_bakeResult.size() != dim * dim)
+		return;
+
+	// The nine probes are the corners, the edge midpoints and the centre of the PLATE footprint, inset
+	// by 20 % so that the corner probes sample real relief instead of the falloff rim, where the bake is
+	// the baseline by construction and would never register a change.
+	const AABB localBox(Vec3(-0.5f, -0.5f, 0.f), Vec3(0.5f, 0.5f, 1.f));
+	const AABB worldBox = AABB::CreateTransformedAABB(worldTM, localBox);
+
+	const float insetX = (worldBox.max.x - worldBox.min.x) * 0.2f;
+	const float insetY = (worldBox.max.y - worldBox.min.y) * 0.2f;
+
+	for (int i = 0; i < 3; ++i)
+	{
+		for (int j = 0; j < 3; ++j)
+		{
+			const float wx = (worldBox.min.x + insetX) + (worldBox.max.x - worldBox.min.x - 2.f * insetX) * (float)i * 0.5f;
+			const float wy = (worldBox.min.y + insetY) + (worldBox.max.y - worldBox.min.y - 2.f * insetY) * (float)j * 0.5f;
+
+			const int ux = clamp_tpl((int)floorf(wx / metrics.unitSize), m_bakeRectX1, m_bakeRectX1 + m_bakeRectSize);
+			const int uy = clamp_tpl((int)floorf(wy / metrics.unitSize), m_bakeRectY1, m_bakeRectY1 + m_bakeRectSize);
+
+			SBakeProbe& probe = m_bakeProbes[m_bakeProbeCount++];
+			probe.ux = ux;
+			probe.uy = uy;
+			probe.expectedZ = m_bakeResult[(size_t)(ux - m_bakeRectX1) * dim + (uy - m_bakeRectY1)];
+		}
+	}
+
+	// Tolerance: a height never survives the round trip through SetTerrainElevation exactly, because the
+	// sector re-quantises to 12 bits over its own span. A few steps of the coarsest touched sector is
+	// still far below anything an editor operation would do.
+	float quantStep = 0.f;
+	const int sectorsPerSide = max(1, m_bakeRectSize / metrics.sectorUnits);
+	for (int sx = 0; sx < sectorsPerSide; ++sx)
+	{
+		for (int sy = 0; sy < sectorsPerSide; ++sy)
+		{
+			float fMin = FLT_MAX, fMax = -FLT_MAX;
+			for (int ux = sx * metrics.sectorUnits; ux <= (sx + 1) * metrics.sectorUnits; ++ux)
+			{
+				for (int uy = sy * metrics.sectorUnits; uy <= (sy + 1) * metrics.sectorUnits; ++uy)
+				{
+					const float z = m_bakeResult[(size_t)min(ux, dim - 1) * dim + min(uy, dim - 1)];
+					fMin = min(fMin, z);
+					fMax = max(fMax, z);
+				}
+			}
+			quantStep = max(quantStep, TerrainQuantStep(fMin, fMax));
+		}
+	}
+
+	m_bakeProbeTolerance = max(0.002f, quantStep * 4.f);
+}
+
+void CTerrainPlateComponent::PollBake()
+{
+	if (!m_bBakeApplied || m_bakeProbeCount == 0)
+		return;
+
+	const int probeFrames = GetBakeProbeFrames();
+	if (probeFrames <= 0)
+		return;
+
+	if ((int)(gEnv->nMainFrameID - m_lastBakeProbeFrameId) < probeFrames)
+		return;
+
+	m_lastBakeProbeFrameId = gEnv->nMainFrameID;
+
+	const SBakeTerrainMetrics metrics = GetBakeTerrainMetrics();
+	if (!metrics.IsValid())
+		return;
+
+	// Nine array lookups (CTerrain::GetZfromUnits is a clamp, a sector lookup and an index), so this is
+	// free even at every frame.
+	for (int i = 0; i < m_bakeProbeCount; ++i)
+	{
+		const SBakeProbe& probe = m_bakeProbes[i];
+		if (fabs_tpl(SampleTerrainUnit(metrics, probe.ux, probe.uy) - probe.expectedZ) > m_bakeProbeTolerance)
+		{
+			ReapplyBakeAfterExternalEdit(metrics);
+			return;
+		}
+	}
+}
+
+void CTerrainPlateComponent::ReapplyBakeAfterExternalEdit(const SBakeTerrainMetrics& metrics)
+{
+	const int dim = m_bakeRectSize + 1;
+	if ((int)m_bakeBaseline.size() != dim * dim || (int)m_bakeResult.size() != dim * dim)
+		return;
+
+	// What just happened: some editor operation pushed CHeightmap over part of this rect and erased the
+	// bake there. The naive answer - restore the stored baseline and bake again - would undo the user's
+	// edit, because the stored baseline is the ground as it was BEFORE the edit. The naive opposite -
+	// recapture the whole rect as the new baseline - would fold the surviving part of our own bake into
+	// the baseline, so turning Bake off later would never give the original ground back.
+	//
+	// So the baseline is rebuilt cell by cell, using the fact that we know exactly what we wrote:
+	//   * the cell still holds our baked height  -> the editor did not touch it, the stored baseline is
+	//                                               still the truth under the plate; keep it;
+	//   * the cell holds something else          -> the editor rewrote it, and what is there now IS the
+	//                                               new ground; take it as the new baseline.
+	// A sculpt next to the plate but inside the sector-aligned rect therefore survives, and a sculpt
+	// under the plate becomes the new ground the plate sits on. A full-map push (leaving game mode,
+	// resize, a layer paint, which re-pushes elevations too) fails the first test everywhere and hands
+	// the pristine CHeightmap back as the baseline, which is exactly right.
+	int recapturedCells = 0;
+	for (int ux = 0; ux < dim; ++ux)
+	{
+		for (int uy = 0; uy < dim; ++uy)
+		{
+			const size_t index = (size_t)ux * dim + uy;
+			const float current = SampleTerrainUnit(metrics, m_bakeRectX1 + ux, m_bakeRectY1 + uy);
+
+			if (fabs_tpl(current - m_bakeResult[index]) > m_bakeProbeTolerance)
+			{
+				m_bakeBaseline[index] = current;
+				++recapturedCells;
+			}
+		}
+	}
+
+	if (GetTerrainIntegrateDebugLevel() >= 1)
+	{
+		CryLog("TerrainPlate '%s': terrain changed under the bake, %d of %d cells re-captured as the new ground",
+		       m_pEntity->GetName(), recapturedCells, dim * dim);
+	}
+
+	// RegenerateMesh restores the corrected baseline first (so the rect now holds the NEW ground, the
+	// user's edit included), then re-welds the mesh against it and bakes on top of it. m_bBakeApplied is
+	// deliberately left true so that the restore actually runs.
+	RegenerateMesh();
+}
+
+void CTerrainPlateComponent::WarnOnBakeQuantisation(const SBakeTerrainMetrics& metrics)
+{
+	if (m_bBakeQuantWarningIssued)
+		return;
+
+	// A sector encodes its heights as 12 bits over its own span (terran_edit.cpp:281-291), so raising
+	// part of a sector by a lot costs precision everywhere in it - including the untouched terrain
+	// around the plate. Decision 04, rule 9: say so once.
+	const int dim = m_bakeRectSize + 1;
+	const int sectorsPerSide = max(1, m_bakeRectSize / metrics.sectorUnits);
+
+	for (int sx = 0; sx < sectorsPerSide; ++sx)
+	{
+		for (int sy = 0; sy < sectorsPerSide; ++sy)
+		{
+			float baseMin = FLT_MAX, baseMax = -FLT_MAX, bakedMin = FLT_MAX, bakedMax = -FLT_MAX;
+
+			for (int ux = sx * metrics.sectorUnits; ux <= (sx + 1) * metrics.sectorUnits; ++ux)
+			{
+				for (int uy = sy * metrics.sectorUnits; uy <= (sy + 1) * metrics.sectorUnits; ++uy)
+				{
+					const size_t index = (size_t)min(ux, dim - 1) * dim + min(uy, dim - 1);
+					baseMin = min(baseMin, m_bakeBaseline[index]);
+					baseMax = max(baseMax, m_bakeBaseline[index]);
+					bakedMin = min(bakedMin, m_bakeResult[index]);
+					bakedMax = max(bakedMax, m_bakeResult[index]);
+				}
+			}
+
+			const float stepBefore = TerrainQuantStep(baseMin, baseMax);
+			const float stepAfter = TerrainQuantStep(bakedMin, bakedMax);
+
+			if (stepBefore > 0.f && stepAfter > stepBefore * 2.f)
+			{
+				m_bBakeQuantWarningIssued = true;
+				CryWarning(VALIDATOR_MODULE_ENTITYSYSTEM, VALIDATOR_WARNING,
+				           "Terrain Plate '%s': the bake more than doubled the height quantisation step of the terrain sector at units (%d,%d) "
+				           "(%.1f mm -> %.1f mm). A sector stores 12 bit heights over its own span, so the terrain around the plate loses "
+				           "precision too. Use a shorter plate, or move it so that its relief does not cross a sector with a small height range.",
+				           m_pEntity->GetName(),
+				           m_bakeRectX1 + sx * metrics.sectorUnits, m_bakeRectY1 + sy * metrics.sectorUnits,
+				           stepBefore * 1000.f, stepAfter * 1000.f);
+				return;
+			}
+		}
+	}
+}
