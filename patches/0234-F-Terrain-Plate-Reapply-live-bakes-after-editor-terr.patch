 	std::vector<float>       m_bakeBaseline;   //!< the original ground, restored on any change
 	std::vector<float>       m_bakeResult;     //!< what the last bake actually wrote
+	SBakeProbe               m_bakeProbes[9];
+	int                      m_bakeProbeCount = 0;
