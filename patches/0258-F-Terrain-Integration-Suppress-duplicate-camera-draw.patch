+bool CTerrain::IsObjectDrawnByTerrain(const IRenderNode* pNode, const AABB& objBox, int nMainFrameId) const
+{
+	if (m_arrSecInfoPyramid.IsEmpty() || !m_pParentNode)
+		return false;
+
+	const int nSectorSize = CTerrain::GetSectorSize();
+	const int nTableSize = CTerrain::GetSectorsTableSize();
+
+	if (nSectorSize <= 0 || nTableSize <= 0)
+		return false;
+
+	// Anything hanging over the edge of the terrain has no sector to be drawn by, so it draws itself.
+	if (objBox.min.x < 0.f || objBox.min.y < 0.f || objBox.max.x >= (float)m_nTerrainSize || objBox.max.y >= (float)m_nTerrainSize)
+		return false;
+
+	// The footprint in XY only, deliberately, exactly as HasIntegratedObjectsInBoxXY: what decides
+	// which sectors have to agree is where the object lands, not how high or how deep it is.
+	const int nX0 = (int)objBox.min.x / nSectorSize;
+	const int nX1 = (int)objBox.max.x / nSectorSize;
+	const int nY0 = (int)objBox.min.y / nSectorSize;
+	const int nY1 = (int)objBox.max.y / nSectorSize;
+
+	if (nX0 < 0 || nY0 < 0 || nX1 >= nTableSize || nY1 >= nTableSize)
+		return false;
+
+	// AND over every covering sector: one object can straddle four LOD 0 sectors, each rebuilt and each
+	// LOD-selected independently, and one disagreement is enough to need the object's own draw again.
+	for (int x = nX0; x <= nX1; x++)
+	{
+		for (int y = nY0; y <= nY1; y++)
+		{
+			const CTerrainNode* pSector = m_arrSecInfoPyramid[0][x][y];
+
+			if (!pSector || !pSector->IsDrawingIntegratedObject(pNode, nMainFrameId))
+				return false;
+		}
+	}
+
+	return true;
+}
