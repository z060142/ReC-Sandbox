+// Decision 05 step 2. "Is this sector drawing all of that object's triangles right now?" - the per
+// sector half of the e_TerrainIntegrateObjectsFull 2 gate. Every condition is written so that the
+// unknown answer is "no": an object that is not certainly being drawn by the terrain keeps its own
+// draw, which costs a double draw, while the opposite mistake costs a hole.
+bool CTerrainNode::IsDrawingIntegratedObject(const IRenderNode* pNode, int nMainFrameId) const
+{
+	// The terrain traversal has to have stopped at THIS sector in this frame's general pass. If a
+	// coarser ancestor stopped instead (LOD >= 1), or the branch was culled, the stamp is stale.
+	if (!m_nIntegrationDrawFrameId || m_nIntegrationDrawFrameId != nMainFrameId)
+		return false;
+
+	// The mesh that carries the appended triangles has to exist. Between ResetTerrainVertBuffers and
+	// the lazy rebuild there is none, and while an integrated object's render mesh is still streaming
+	// in the sector is waiting for a retry - in both windows the object has to draw itself.
+	if (!m_pLeafData || !m_pLeafData->m_pRenderMesh || m_bIntegrationRetryPending)
+		return false;
+
+	for (int i = 0; i < m_lstFullyIntegratedObjects.Count(); i++)
+	{
+		if (m_lstFullyIntegratedObjects[i] == pNode)
+			return true;
+	}
+
+	return false;
+}
