diff --git a/Engine/Shaders/HWScripts/CryFX/Total_Illumination_Shading.cfi b/Engine/Shaders/HWScripts/CryFX/Total_Illumination_Shading.cfi
index 54bbffb0..2a50180c 100644
--- a/Engine/Shaders/HWScripts/CryFX/Total_Illumination_Shading.cfi
+++ b/Engine/Shaders/HWScripts/CryFX/Total_Illumination_Shading.cfi
@@ -62,6 +62,111 @@ float4 SVO_RTLightGridDims;
 // (ambientAlbedoAdd, debugAlbedo, aoRange, isSpecularSet)
 float4 SVO_ShadeParams0;
 
+///////////////////////////////////////////////////////////////////////////////////
+// rt stage 4A - the sky a ray sees when it misses (decision 09 section 9.1, energy audit
+// item 7 / E7).
+//
+// The deferred sky is NOT a render target we can sample: CSkyStage::Execute runs SkyPassPS
+// (Stars.cfx) straight into the HDR colour target, from the two Nishita dome textures the
+// sky-light manager uploads (Mie / Rayleigh, lat-long, 64 x 32) and, for a skybox level, from
+// the level's lat-long skybox texture. So the only way to give a reflection ray the SAME sky
+// the camera sees is to bind those textures here and evaluate the same closed form. This is
+// Stars.cfx SkyPassPS's day-sky gradient + night gradient + skybox lerp + peak clamp, verbatim.
+//
+// THE SUN DISC IS NOT A SEPARATE TERM. In CE 5.7.1 the procedural sky has no sun sprite at all:
+// what reads as the sun IS the Mie phase function peaking at cosine = 1 (see the long comment
+// at the end of SkyPassPS). Evaluating the phase function therefore gives the sun disc for
+// free, with exactly the same shape and the same SkyDome_ScenePeakClamp ceiling the direct
+// view gets. On a skybox level the sun is painted into the skybox texture. Nothing is added
+// on top - adding a sun lobe here is precisely the second-sun bug this replaces.
+//
+// EXPOSURE. Every radiance constant below is uploaded ALREADY MULTIPLIED by
+// CD3D9Renderer::GetSceneReferredExposure(), which is exactly what CSkyStage::SetSkyParameters
+// and SetHDRSkyParameters do for the deferred pass (Sky.cpp:158, :211) and is numerically the
+// same factor as PS_HDR_RANGE_ADAPT_MAX (= 1 + CV_SceneExposure.x, GraphicsPipeline.cpp:1303).
+// So the value this returns is EXPOSED radiance, in the same units as everything else `acc`
+// is built from, and ShadePS's single divide then cancels ApplyGI's multiply: net x1, the
+// emissive rule of decision 06 section 6.4. Off the scene-referred switch the factor is 1.0
+// and nothing moves.
+//
+// Not carried (documented gaps, not silent): the moon, the stars, and the fog blend SkyPassPS
+// applies with %_RT_FOG. Cloud shadow is deliberately absent - it darkens ground lighting, not
+// a sky lookup.
+///////////////////////////////////////////////////////////////////////////////////
+
+Texture2D SVO_SkyDomeMie      : register(t34);
+Texture2D SVO_SkyDomeRayleigh : register(t35);
+Texture2D SVO_SkyBoxTex       : register(t36);
+
+SamplerState ssSvoSkyLinear : register(s3);
+
+// (bProcedural, bSkyBox, skyBoxAngle, skyBoxStretching)
+float4 SVO_SkyParams;
+// (peak clamp in EXPOSED units, 0 = off; the sky pass's SkyDome_ScenePeakClamp)
+float4 SVO_SkyPeakClamp;
+float4 SVO_SkyMieConst;
+float4 SVO_SkyRayleighConst;
+float4 SVO_SkySunDirection;
+float4 SVO_SkyPhaseConst;
+float4 SVO_SkyNightColBase;
+float4 SVO_SkyNightColDelta;
+float4 SVO_SkyNightZenithColShift;
+float4 SVO_SkyBoxExposure;
+float4 SVO_SkyBoxOpacity;
+
+// Stars.cfx:154 GetSkyUV, byte for byte.
+float2 SVO_RT_GetSkyUV(float3 vSkyDir, float fAngleOffset, float fStretching)
+{
+	float2 langlatTC = float2((atan2(-vSkyDir.y, -vSkyDir.x) + fAngleOffset) / PI * 0.5f + 0.5f, asin(vSkyDir.z) / PI + 0.5f);
+	langlatTC.y = (1.f - langlatTC.y) * fStretching;
+	return langlatTC;
+}
+
+// Returns false when this level has no sky the pass could bind (an interior, or the sky stage
+// was never active); the caller then keeps the env-probe fallback, which is the right answer
+// for a ray that leaves a room rather than the world.
+bool SVO_RT_SampleSky(const float3 vDir, out float3 vRadiance)
+{
+	vRadiance = (float3)0.f;
+
+	const bool bProcedural = (SVO_SkyParams.x > 0.f);
+	const bool bSkyBox     = (SVO_SkyParams.y > 0.f);
+
+	if (!bProcedural && !bSkyBox)
+		return false;
+
+	if (bProcedural)
+	{
+		const float2 tcDome = SVO_RT_GetSkyUV(vDir, 0.f, 2.f);
+		const float3 cMie = SVO_SkyDomeMie.SampleLevel(ssSvoSkyLinear, tcDome, 0).rgb;
+		const float3 cRay = SVO_SkyDomeRayleigh.SampleLevel(ssSvoSkyLinear, tcDome, 0).rgb;
+
+		const float fCos  = -dot(SVO_SkySunDirection.xyz, vDir);
+		const float fCos2 = fCos * fCos;
+		const float fMieTmp = SVO_SkyPhaseConst.y + SVO_SkyPhaseConst.x * fCos;
+		const float fMiePhase = (fMieTmp > 0.f) ? (1.f + fCos2) * pow(fMieTmp, -1.5f) : 0.f;
+		const float fRayPhase = 0.75f * (1.f + fCos2);
+
+		vRadiance = cMie * SVO_SkyMieConst.rgb * fMiePhase + cRay * SVO_SkyRayleighConst.rgb * fRayPhase;
+
+		float fGr = saturate(vDir.z * SVO_SkyNightZenithColShift.x + SVO_SkyNightZenithColShift.y);
+		fGr *= 2.f - fGr;
+		vRadiance += SVO_SkyNightColBase.rgb + SVO_SkyNightColDelta.rgb * fGr;
+	}
+
+	if (bSkyBox)
+	{
+		const float2 tcBox = SVO_RT_GetSkyUV(vDir, SVO_SkyParams.z, SVO_SkyParams.w);
+		const float3 cBox = SVO_SkyBoxExposure.rgb * SVO_SkyBoxTex.SampleLevel(ssSvoSkyLinear, tcBox, 0).rgb;
+		vRadiance = lerp(vRadiance, cBox, SVO_SkyBoxOpacity.rgb);
+	}
+
+	if (SVO_SkyPeakClamp.x > 0.f)
+		vRadiance = any(isnan(vRadiance)) ? (float3)0.f : min(vRadiance, (float3)SVO_SkyPeakClamp.x);
+
+	return true;
+}
+
