+//////////////////////////////////////////////////////////////////////////
+// The entry to the scene-referred working space (SceneReferredSpec.md D5, Stage S3;
+// scene-notes/decisions/s3-working-space.md approach 1A).
+//
+// WHY HERE. Between the $HDRTargetPrev copy and the depth-of-field stage is the only window in
+// the frame where two things are true at once: every writer of Rec.709 scene colour has finished
+// (deferred and forward opaque, sky, ocean caustics, volumetric fog, global fog, clouds, water,
+// transparents, half-res particles, snow displacement and the rain layer), and nothing has read
+// the target for post yet. Converting earlier would leave the rain layer authoring 709 into an
+// AP1 target; converting later would mean depth of field had already run on mixed data.
+//
+// WHY IN PLACE. Each thread reads and writes only its own texel, so there is no cross-texel
+// dependency and no race: no scratch target, no copy-back and no pipeline pointer to swap. The
+// pixel-shader form of the same point costs TWO full-screen passes, because a render target
+// cannot be its own shader resource. $HDRTarget already carries FT_USAGE_UNORDERED_ACCESS
+// (CTiledShadingStage writes it through SetOutputUAV), so no plumbing is new here.
+//
+// If the typed UAV load of R16G16B16A16_FLOAT ever proves unavailable on some target hardware,
+// the documented fallback is decisions/s3-working-space.md approach 1B: a full-screen pixel pass
+// into $SceneTargetR11G11B10F[0] (which is dead at this point in the frame) and a copy back.
+//
+// WHY NOT AT THE WRITERS. A 3x3 is linear, so additive and alpha blending commute with it and
+// anything that blended before this point lands in the same place either way. Multiplicative and
+// min/max blends do NOT commute, and GS_BLSRC_DSTCOL / GS_BLDST_SRCCOL are reachable from
+// material shader scripts. Converting after all scene blending makes the question moot.
+void CStandardGraphicsPipeline::ExecuteSceneReferredConversion()
+{
+	if (!CRendererResources::IsSceneReferred())
+		return;
+
+	// r_SceneReferredDebug 1: leave the frame in Rec.709 while the rest of the scene-referred
+	// pipeline keeps running. The A/B that separates "the primaries moved" from everything else.
+	if (CRendererCVars::CV_r_SceneReferredDebug == 1)
+		return;
+
+	CTexture* pHDRTarget = m_pipelineResources.m_pTexHDRTarget;
+	if (!CTexture::IsTextureExist(pHDRTarget))
+		return;
+
+	PROFILE_LABEL_SCOPE("SCENE_REFERRED_CONVERT_709_TO_AP1");
+
+	CComputeRenderPass& pass = *m_SceneReferredConvertPass;
+
+	const int width = pHDRTarget->GetWidth();
+	const int height = pHDRTarget->GetHeight();
+
+	if (pass.IsDirty(pHDRTarget->GetTextureID()))
+	{
+		static CCryNameTSCRC techConvert("SceneReferredConvert");
+		pass.SetTechnique(CShaderMan::s_shHDRPostProcess, techConvert, 0);
+		pass.SetOutputUAV(0, pHDRTarget);
+	}
+
+	pass.BeginConstantUpdate();
+	{
+		static CCryNameR paramsName("SceneReferredParams");
+		const Vec4 params((float)width, (float)height, (float)CRendererCVars::CV_r_SceneReferredDebug, 0.0f);
+		pass.SetConstant(paramsName, params);
+	}
+
+	// One thread per texel; the group count is rounded up and the shader discards the padding.
+	const int tile = 8; // must match SCENE_REFERRED_CONVERT_TILE in HDRPostProcess.cfx
+	pass.SetDispatchSize((width + tile - 1) / tile, (height + tile - 1) / tile, 1);
+
+	pass.PrepareResourcesForUse(GetDeviceObjectFactory().GetCoreCommandList());
+
+	{
+		SScopedComputeCommandList computeCommandList(false);
+		pass.Execute(computeCommandList, EShaderStage_All);
+	}
+}
