+////////////////////////////////////////////////////////////////////////////////////////////////////
+// Rec.709 -> ACEScg, the entry to the scene-referred working space (SceneReferredSpec.md D5,
+// Stage S3; scene-notes/decisions/s3-working-space.md approach 1A).
+//
+// One 3x3 per texel, in place on $HDRTarget's UAV, dispatched from
+// CStandardGraphicsPipeline::ExecuteHDRPostProcessing() between the $HDRTargetPrev copy and the
+// depth-of-field stage. That is the only window in the frame where every writer of Rec.709 scene
+// colour has finished (deferred, forward opaque, sky, water, fog, clouds, transparents, particles,
+// snow displacement and rain) and nothing has read the target for post yet.
+//
+// In place is race-free because each thread reads and writes ONLY its own texel: no scratch
+// target, no copy-back, no pipeline pointer to swap. It costs one read plus one write of the
+// full-resolution fp16 target, about 0.08 ms at 1080p and 0.33 ms at 4K.
+//
+// The matrix is linear, so everything that BLENDED into the target before this point is
+// unaffected by the move (additive and alpha blending both commute with a 3x3). Multiplicative
+// and min/max blends do NOT commute, and they are reachable from material shader scripts - which
+// is the second reason the conversion sits after all scene blending rather than at the writers.
+//
+// $HDRTargetPrev deliberately stays Rec.709: it is filled by the copy immediately before this
+// dispatch and consumed NEXT frame inside the 709 lighting pass by screen-space reflections,
+// water reflection and the SVOGI bounce. See the comment at the copy site.
+RWTexture2D<float4> SceneReferredTargetUAV : register(u0);
+
+// .xy = target size in texels (the dispatch is padded up to the group size)
+// .z  = r_SceneReferredDebug: 2 paints the texels this pass could not produce
+// .w  = unused
+float4 SceneReferredParams;
+
+#define SCENE_REFERRED_CONVERT_TILE 8
+
+// Debug marker brightness. Far above anything the tone map or the ODT will resolve, so a marked
+// texel is unmistakably a flat primary and cannot be confused with scene content.
+#define SCENE_REFERRED_DEBUG_MARK 64.0
+
+[numthreads(SCENE_REFERRED_CONVERT_TILE, SCENE_REFERRED_CONVERT_TILE, 1)]
+void SceneReferredConvertCS(uint3 DispatchThreadID : SV_DispatchThreadID)
+{
+	const int2 vPixCoord = int2(DispatchThreadID.xy);
+	if (any(vPixCoord >= (int2)SceneReferredParams.xy))
+		return;
+
+	const float4 cSrc = SceneReferredTargetUAV[vPixCoord];
+	float3 cDst = Rec709ToACEScg(cSrc.rgb);
+
+	// r_SceneReferredDebug 2. Rec.709's primaries lie INSIDE AP1, so the forward matrix is
+	// entirely non-negative and a non-negative 709 frame cannot come out of it negative. A
+	// marked texel therefore means one of two things and neither is a property of the transform:
+	// either the frame already carried a NaN/Inf (red) or a negative channel (green) before the
+	// conversion, or the matrix is not being applied to what we think it is. This is the S3
+	// acceptance instrument taken at the conversion point itself; r_HDRDebug 3 is the same test
+	// at the END of the chain, where depth of field, the glare family and motion blur have all
+	// had their turn.
+	if (SceneReferredParams.z > 1.5)
+	{
+		if (any(isnan(cDst)) || any(isinf(cDst)))
+			cDst = float3(SCENE_REFERRED_DEBUG_MARK, 0.0, 0.0);
+		else if (any(cDst < 0.0))
+			cDst = float3(0.0, SCENE_REFERRED_DEBUG_MARK, 0.0);
+	}
+
+	SceneReferredTargetUAV[vPixCoord] = float4(cDst, cSrc.a);
+}
+
+technique SceneReferredConvert
+{
+  pass p0
+  {
+    ComputeShader = SceneReferredConvertCS();
+  }
+}
