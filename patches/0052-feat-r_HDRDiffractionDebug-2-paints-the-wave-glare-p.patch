+}
+
+// The readback half of r_HDRDiffractionDebug 3. Split out because it is a small state machine
+// and has nothing to do with the drawing above.
+void CBloomStage::UpdateDiffractionSourceReadback(int nDebugMode, CTexture* pSource, float fThreshold)
+{
+	if (nDebugMode != 3)
+	{
+		// Do not free while a download is still in flight - the staging resource is the target
+		// of a GPU copy that has not necessarily retired.
+		if (!m_bDiffractionReadbackIssued)
+			m_pTexDiffractionReadback.reset();
+		return;
+	}
+
+	const int nWidth = pSource->GetWidth();
+	const int nHeight = pSource->GetHeight();
+
+	if (!CTexture::IsTextureExist(m_pTexDiffractionReadback) ||
+	    m_pTexDiffractionReadback->GetWidth() != nWidth || m_pTexDiffractionReadback->GetHeight() != nHeight)
+	{
+		if (m_bDiffractionReadbackIssued)
+			return;
+
+		// FT_STAGE_READBACK is what gives the texture a PERSISTENT staging resource, which is
+		// what makes the two-phase (issue now, map later) download possible at all - the
+		// one-shot CDeviceTexture::DownloadToStagingResource(sub, hook) allocates a temporary
+		// one and Maps it immediately, which under D3D11 is a full pipeline stall.
+		const uint32 flags = FT_NOMIPS | FT_DONT_STREAM | FT_USAGE_RENDERTARGET | FT_STAGE_READBACK;
+		const std::string id = m_graphicsPipeline.GetUniqueIdentifierName();
+		// Half float RGBA regardless of what the HDR chain is packed in: the blit converts, and
+		// four halves per texel is a format the CPU side can decode without knowing anything
+		// about R11G11B10's exponent layout.
+		m_pTexDiffractionReadback = CTexture::GetOrCreateRenderTarget(("$DiffractionSourceReadback" + id).c_str(),
+		                                                             nWidth, nHeight, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+
+		if (!CTexture::IsTextureExist(m_pTexDiffractionReadback))
+		{
+			m_pTexDiffractionReadback.reset();
+			return;
+		}
+
+		m_fDiffractionReadbackTime = 0.0f;
+	}
+
+	CDeviceTexture* pDevTex = m_pTexDiffractionReadback->GetDevTexture();
+	if (pDevTex == nullptr)
+		return;
+
+	const float fNow = gEnv->pTimer->GetAsyncCurTime();
+
+	if (m_bDiffractionReadbackIssued)
+	{
+		// Not signalled yet: come back next frame. The whole point of the two-phase download is
+		// that this never blocks.
+		if (!pDevTex->AccessCurrStagingResource(0, false))
+			return;
+
+		float fMaxExcess = 0.0f;
+		int nMaxX = 0, nMaxY = 0;
+
+		const auto readbackData = [nWidth, nHeight, &fMaxExcess, &nMaxX, &nMaxY](void* pData, uint32 rowPitch, uint32 slicePitch) -> bool
+		{
+			const uint8* pRow = static_cast<const uint8*>(pData);
+			for (int y = 0; y < nHeight; ++y, pRow += rowPitch)
+			{
+				const CryHalf* pTexel = reinterpret_cast<const CryHalf*>(pRow);
+				for (int x = 0; x < nWidth; ++x, pTexel += 4)
+				{
+					// The threshold pass keeps the source's hue, so the brightest channel is
+					// the number that decides whether this source draws anything at all.
+					const float e = max(max(CryConvertHalfToFloat(pTexel[0]), CryConvertHalfToFloat(pTexel[1])),
+					                    CryConvertHalfToFloat(pTexel[2]));
+					if (e > fMaxExcess)
+					{
+						fMaxExcess = e;
+						nMaxX = x;
+						nMaxY = y;
+					}
+				}
+			}
+			return true;
+		};
+
+		pDevTex->AccessCurrStagingResource(0, false, readbackData);
+		m_bDiffractionReadbackIssued = false;
+		// Time the cadence from the REPORT, not from the request, so a slow fence cannot turn
+		// this into a per-frame download.
+		m_fDiffractionReadbackTime = fNow;
+
+		CryLog("[BLOOM] diffraction sources: max excess = %.1f (threshold %.1f) at (%d, %d) quarter-res",
+		       fMaxExcess, fThreshold, nMaxX, nMaxY);
+		return;
+	}
+
+	if (m_fDiffractionReadbackTime > 0.0f && (fNow - m_fDiffractionReadbackTime) < 1.0f)
+		return;
+
+	m_passDiffractionReadbackCopy.Execute(pSource, m_pTexDiffractionReadback);
+	pDevTex->DownloadToStagingResource(0);
+	m_bDiffractionReadbackIssued = true;
+	m_fDiffractionReadbackTime = fNow;
 }
 
