From 64d4c142c74cf4bc3ba06592d290f707cdf13504 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Mon, 31 Aug 2026 11:04:20 +0800
Subject: [PATCH 244/307] !B (Terrain Plate) Restore bake epsilon and slope
 correction defaults.

Roads now sample integrated geometry directly, so the tighter bake introduced
for road clearance is no longer required. Restore the wider separation that
avoids distant shadow acne and disable slope correction by default.
---
 .../Geometry/TerrainPlateComponent.cpp        | 67 ++++++++++++-------
 .../Geometry/TerrainPlateComponent.h          |  4 ++
 2 files changed, 47 insertions(+), 24 deletions(-)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index eaa4519b..89621bef 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -62,14 +62,14 @@ uint32 g_bakeCascadeFrameId = ~0u;
 const size_t kBakeCascadeMaxPlates = 16;
 
 //! The terrain is kept this far below the plate mesh, so the two surfaces never fight (decision 04,
-//! rule 1). It is also the whole budget a road or a terrain decal has to stay visible on a baked
-//! plate: a road renders at terrainZ + e_RoadsZOffset (0.01 m, RoadRenderNode::Render) with a LEQUAL
-//! depth test and no depth write, so anything standing above terrainZ + 0.01 buries it. The step 2
-//! value of 0.02 did exactly that. 0.005 leaves the road 5 mm of margin and is still four decimal
-//! orders above what the depth buffer can resolve at any distance a road is drawn at
-//! (scene-notes/terrain/reports/14-roads-decals-on-top.md section 2).
-//! Revert switch: e_TerrainPlateBakeEpsilon 0.02 restores step 2 behaviour exactly.
-float  g_terrainPlateBakeEpsilon = 0.005f;
+//! rule 1). Step 3 tightened this to 0.005 so that a road drawn on the TERRAIN surface
+//! (terrainZ + e_RoadsZOffset, 0.01 m) still cleared the baked terrain. P11 removed that need: a road
+//! over an integrating object now samples the plate mesh itself (e_RoadsFollowIntegratedObjects), so
+//! it no longer has to win against the bake by a millimetre margin. A near coplanar baked terrain and
+//! plate, on the other hand, cost shadow map precision at the junction and showed as shadow acne seen
+//! from far away, so the default goes back to the step 2 value of 0.02.
+//! Escape hatch, kept: e_TerrainPlateBakeEpsilon 0.005 restores the step 3 tight bake.
+float  g_terrainPlateBakeEpsilon = 0.02f;
 ICVar* g_pTerrainPlateBakeEpsilonCVar = nullptr;
 
 //! Slope correction of the bake Min filter. The plain Min filter takes the lowest plate height over
@@ -78,8 +78,11 @@ ICVar* g_pTerrainPlateBakeEpsilonCVar = nullptr;
 //! every road and terrain decal on the plate no matter how small the epsilon is. Subtracting the
 //! plate own tangent plane before taking the minimum removes exactly that linear part: the filter
 //! becomes exact on a locally planar plate and still catches every dip, which is what the Min filter
-//! is there for. Revert switch: e_TerrainPlateBakeSlopeCorrect 0.
-int    g_terrainPlateBakeSlopeCorrect = 1;
+//! is there for. It was needed only while roads and terrain decals had to survive on the baked
+//! TERRAIN surface; since P11 they follow the plate mesh, so the correction is off by default and the
+//! plain Min filter (the conservative one - it never leaves terrain above the plate) is back.
+//! Escape hatch, kept: e_TerrainPlateBakeSlopeCorrect 1 restores the step 3 slope corrected filter.
+int    g_terrainPlateBakeSlopeCorrect = 0;
 ICVar* g_pTerrainPlateBakeSlopeCorrectCVar = nullptr;
 
 //! Bake trigger / bake apply tracing. The bake chain has a dozen places where it can legitimately do
@@ -149,22 +152,25 @@ void RegisterTerrainPlateCVars()
 	                                                     "sector and to 33 per axis. Smaller catches a smaller sculpt in the middle of a large\n"
 	                                                     "plate; the cost is one array lookup per probe per poll.");
 
-	g_pTerrainPlateBakeEpsilonCVar = REGISTER_CVAR2("e_TerrainPlateBakeEpsilon", &g_terrainPlateBakeEpsilon, 0.005f, VF_NULL,
+	g_pTerrainPlateBakeEpsilonCVar = REGISTER_CVAR2("e_TerrainPlateBakeEpsilon", &g_terrainPlateBakeEpsilon, 0.02f, VF_NULL,
 	                                                "Terrain Plate component with Bake Into Terrain = true: how far in metres the baked\n"
-	                                                "terrain is kept below the plate mesh. It is also the margin a road or a terrain decal has\n"
-	                                                "to win by: both are drawn on the terrain surface with a LEQUAL depth test and no depth\n"
-	                                                "write, a road at terrainZ + e_RoadsZOffset (0.01), so a value at or above 0.01 makes roads\n"
-	                                                "and terrain decals disappear under the plate.\n"
-	                                                "0.02 - the step 2 value, roads and terrain decals are buried\n"
-	                                                "0.005 - default, 5 mm of margin for the road, still far above depth buffer noise");
-
-	g_pTerrainPlateBakeSlopeCorrectCVar = REGISTER_CVAR2("e_TerrainPlateBakeSlopeCorrect", &g_terrainPlateBakeSlopeCorrect, 1, VF_NULL,
+	                                                "terrain is kept below the plate mesh. A road no longer needs this to be tight: since\n"
+	                                                "e_RoadsFollowIntegratedObjects it drapes on the plate mesh instead of on the baked\n"
+	                                                "terrain. A tight value leaves the two surfaces nearly coplanar, which costs shadow map\n"
+	                                                "precision and shows as shadow acne at the plate / terrain junction seen from far away.\n"
+	                                                "0.02 - default, the two surfaces are clearly apart\n"
+	                                                "0.005 - the step 3 tight bake, for a road forced onto the terrain surface\n"
+	                                                "        (e_RoadsFollowIntegratedObjects 0); expect distant junction shadow acne");
+
+	g_pTerrainPlateBakeSlopeCorrectCVar = REGISTER_CVAR2("e_TerrainPlateBakeSlopeCorrect", &g_terrainPlateBakeSlopeCorrect, 0, VF_NULL,
 	                                                     "Terrain Plate component with Bake Into Terrain = true: subtract the plate local tangent\n"
-	                                                     "plane before the bake Min filter takes the lowest plate height over a terrain cell. Without\n"
-	                                                     "it the filter sinks a sloped plate terrain by about half a terrain cell of slope drop,\n"
-	                                                     "which buries roads and terrain decals on the plate.\n"
-	                                                     "0 - plain Min filter (step 2 behaviour)\n"
-	                                                     "1 - default, slope corrected: exact on a planar plate, still catches every dip");
+	                                                     "plane before the bake Min filter takes the lowest plate height over a terrain cell. It buys\n"
+	                                                     "back the half cell of slope drop the plain Min filter loses on a slope, which only mattered\n"
+	                                                     "while roads and terrain decals lived on the baked terrain surface; since\n"
+	                                                     "e_RoadsFollowIntegratedObjects a road follows the plate mesh instead, and keeping the baked\n"
+	                                                     "terrain that close under the plate only costs shadow map precision at the junction.\n"
+	                                                     "0 - default, plain Min filter: conservative, never leaves terrain above the plate\n"
+	                                                     "1 - slope corrected: exact on a planar plate, still catches every dip");
 
 	g_pTerrainPlateDebugCVar = REGISTER_CVAR2("e_TerrainPlateDebug", &g_terrainPlateDebug, 0, VF_NULL,
 	                                          "Terrain Plate component: trace the bake trigger and the bake itself.\n"
@@ -2380,6 +2386,10 @@ void CTerrainPlateComponent::BuildBakeProbes(const SBakeTerrainMetrics& metrics)
 {
 	m_bakeProbes.clear();
 
+	// The two knobs this bake was computed with, so PollBake can tell when the console changes them.
+	m_bakeEpsilonUsed = GetBakeEpsilonMeters();
+	m_bakeSlopeCorrectUsed = g_terrainPlateBakeSlopeCorrect;
+
 	const int dim = m_bakeRectSize + 1;
 	if ((int)m_bakeResult.size() != dim * dim)
 		return;
@@ -2489,6 +2499,15 @@ void CTerrainPlateComponent::PollBake()
 	if (!metrics.IsValid())
 		return;
 
+	// Changing a bake cvar moves nothing in the terrain, so the probes below - which compare the terrain
+	// against the heights this plate last wrote - can never see it. Compare the values the live bake was
+	// computed with instead, so the two knobs can be A / B'd from the console without re-ticking Bake.
+	if (m_bakeEpsilonUsed != GetBakeEpsilonMeters() || m_bakeSlopeCorrectUsed != g_terrainPlateBakeSlopeCorrect)
+	{
+		ReapplyBakeAfterExternalEdit(metrics);
+		return;
+	}
+
 	// One array lookup per probe (CTerrain::GetZfromUnits is a clamp, a sector lookup and an index), so
 	// even the 33 x 33 cap costs nothing at this rate.
 	for (const SBakeProbe& probe : m_bakeProbes)
diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
index bbe84067..26dfb764 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.h
@@ -454,6 +454,10 @@ protected:
 	std::vector<float>       m_bakeBaseline;   //!< the original ground, restored on any change
 	std::vector<float>       m_bakeResult;     //!< what the last bake actually wrote
 	std::vector<SBakeProbe>  m_bakeProbes;
+	//! e_TerrainPlateBakeEpsilon / e_TerrainPlateBakeSlopeCorrect as the live bake used them. A cvar
+	//! change does not move the terrain, so the probes cannot see it; PollBake compares these instead.
+	float                    m_bakeEpsilonUsed = 0.f;
+	int                      m_bakeSlopeCorrectUsed = 0;
 	//! A few quantisation steps of the coarsest touched sector: a height never survives a round trip
 	//! through SetTerrainElevation exactly.
 	float                    m_bakeProbeTolerance = 0.01f;
-- 
2.47.1.windows.1

