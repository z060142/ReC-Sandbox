From ad0456ff96641941d3d21d8feab7008a193bb524 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Tue, 11 Aug 2026 23:01:17 +0800
Subject: [PATCH 183/307] fix: sun shafts no longer count as open sky for the
 sky light injection

User spotted sky-lit cells against the interior ceiling (r_LPVDebug 11):
every cell inside a sun shaft entering through a window sees the sun, so
the "sun visible = open sky" proxy injected sky light columns straight
into interiors. The visibility now requires three conditions: the cell
above must be free of surfels (kills the layer below any roof), the cell
centre must see the sun, and the point two cells straight up must see
the sun (a shaft is tilted along the sun direction, a vertical offset
exits it; genuinely outdoor cells stay visible).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tu9cj9ax1mqCV93HVfCfpW
---
 Engine/Shaders/HWScripts/CryFX/LPV.cfi | 34 +++++++++++++++++++-------
 1 file changed, 25 insertions(+), 9 deletions(-)

diff --git a/Engine/Shaders/HWScripts/CryFX/LPV.cfi b/Engine/Shaders/HWScripts/CryFX/LPV.cfi
index cd4de95c..9b88c3ed 100644
--- a/Engine/Shaders/HWScripts/CryFX/LPV.cfi
+++ b/Engine/Shaders/HWScripts/CryFX/LPV.cfi
@@ -492,16 +492,32 @@ void LPVResolveCS(uint3 DTid : SV_DispatchThreadID)
 		// the same cell (that was the ceiling light panel bug).
 		const float3 cellCenter = LPVGridParams.xyz + ((float3)DTid + 0.5f) * LPVGridParams.w;
 
-		float4 rsmH = mul(LPVWorldToRsm, float4(cellCenter, 1.0f));
-		rsmH /= (abs(rsmH.w) > 1e-12f) ? rsmH.w : 1.0f;
-
-		// Outside the RSM coverage there is no occluder information, treat as visible.
-		bool skyVisible = true;
-		if (all(rsmH.xy >= 0.0f) && all(rsmH.xy <= 1.0f))
+		// "Sun visible" alone is a broken open sky proxy indoors: every cell inside a sun shaft
+		// entering through a window sees the sun, which injected sky light columns into interiors
+		// (observed as sky-lit cells against the ceiling). Three combined conditions:
+		//   1. the cell above must be free of surfels (sky access requires an open cell above -
+		//      also kills the layer directly below any roof),
+		//   2. the cell centre must see the sun,
+		//   3. the point two cells straight up must see the sun (a shaft is tilted along the sun
+		//      direction, a vertical offset exits it; a genuinely outdoor cell stays visible).
+		const uint gridSizeU = gridSize;
+		const uint aboveBase = LPVCellBase(uint3(DTid.x, DTid.y, min(DTid.z + 1u, gridSizeU - 1u)), gridSizeU);
+		bool skyVisible = (LPVInjectionSRV[aboveBase + LPV_ACCUM_COUNT] == 0);
+
+		for (uint s = 0; s < 2 && skyVisible; ++s)
 		{
-			const int2 rsmTexel = clamp((int2)(rsmH.xy * LPVRsmSize.x), 0, (int)LPVRsmSize.x - 1);
-			const float storedDepth = LPVResolveRsmDepth.Load(int3(rsmTexel, 0)).x;
-			skyVisible = (rsmH.z <= storedDepth);
+			const float3 samplePos = cellCenter + float3(0.0f, 0.0f, (float)s * 2.0f * LPVGridParams.w);
+
+			float4 rsmH = mul(LPVWorldToRsm, float4(samplePos, 1.0f));
+			rsmH /= (abs(rsmH.w) > 1e-12f) ? rsmH.w : 1.0f;
+
+			// Outside the RSM coverage there is no occluder information, treat as visible.
+			if (all(rsmH.xy >= 0.0f) && all(rsmH.xy <= 1.0f))
+			{
+				const int2 rsmTexel = clamp((int2)(rsmH.xy * LPVRsmSize.x), 0, (int)LPVRsmSize.x - 1);
+				const float storedDepth = LPVResolveRsmDepth.Load(int3(rsmTexel, 0)).x;
+				skyVisible = (rsmH.z <= storedDepth);
+			}
 		}
 
 		if (skyVisible)
