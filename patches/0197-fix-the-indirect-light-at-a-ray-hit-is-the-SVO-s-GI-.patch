 Texture2D refl_GLD: register (t3); // = RAYDIR
 
+// rt stage 4A: the fifth g-data target, the SVO GI + AO at the hit. t37 is free on the ShadePass
+// technique (the forward set claims t17-t24, t26-t31, t33, t40; t34-t36 are the sky).
+Texture2D refl_GGI: register (t37);
+
 /////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
 // Structures
 struct vtxOutWPOS
@@ -175,6 +179,13 @@ struct pixoutMRTTrace
 	//          (the "no hit => fall back to probes" sentinel). .w == 0 means "not an RT pixel".
 	float4 HitPos: SV_Target2;
 	half4  RayDir: SV_Target3;
+	//  HitGi:  rt stage 4A (energy audit error 1 + 2). .xyz = the SVO's DIFFUSE IRRADIANCE at
+	//          the hit, in the same unexposed units as TexGiDiffuse (the deferred consumer's
+	//          ApplyGI mode 2 input), .w = a voxel-derived ambient occlusion, 1 = unoccluded.
+	//          It has to be produced HERE and not in ShadePS: the irradiance is a brick-pool
+	//          fetch inside the SVO cell that produced the hit, and ShadePS may never touch a
+	//          brick pool (t0-t3 aliasing). A miss writes (0,0,0,1).
+	half4  HitGi: SV_Target4;
 #endif
 };
 
@@ -1940,6 +1951,27 @@ pixoutMRTTrace ConeTracePS(vtxOutWPOS IN)
 		OUT.HitPos = float4(g_rtInfo.hitpos.xyz - GetWorldViewPos(),
 		                    RT_PackHitMaterial(g_rtInfo.reflectance, abs(g_rtInfo.albedo_smoothness.w)));
 		OUT.RayDir = float4(g_rtInfo.raydir.xyz, g_rtInfo.raydir.w);
+
+		// rt stage 4A, energy audit error 1 + 2. The DIRECT view of a surface does not get the
+		// env probe's ambient at all: ApplyGI mode 2 replaces it with the SVO's GI
+		// (TiledShading.cfi:139-140). The hit used to get the full probe irradiance instead,
+		// with occlusion hard-wired to (1,1) - a different indirect model AND no occlusion, which
+		// between them are the dominant reason a reflected wall reads brighter than the wall.
+		// So the hit gets the same thing the primary surface gets: a voxel irradiance fetch in
+		// the cell the hit came from, plus a voxel AO, handed to ShadePS in a fifth target.
+		// Unexposed, like TexGiDiffuse; ShadePS multiplies by PS_HDR_RANGE_ADAPT_MAX exactly
+		// where ApplyGI would have.
+		if (g_rtInfo.best.vAlb.a > 0 && g_rtInfo.cellValid)
+		{
+			OUT.HitGi = float4(RT_SampleVoxelIrradiance(g_rtInfo.cellTC, g_rtInfo.cellMin, g_rtInfo.cellMax, g_rtInfo.hitpos.xyz),
+			                   RT_SampleVoxelAO(g_rtInfo.cellTC, g_rtInfo.cellMin, g_rtInfo.cellMax, g_rtInfo.hitpos.xyz, normalize(g_rtInfo.normal_emissive.xyz)));
+		}
+		else
+		{
+			// no cell (a miss, or a hit the traversal could not place): no GI, no occlusion.
+			// A miss is resolved by the sky and never reads this lane.
+			OUT.HitGi = float4(0, 0, 0, 1);
+		}
 	}
 #endif
 
