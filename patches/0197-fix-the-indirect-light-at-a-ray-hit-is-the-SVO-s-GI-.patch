+		const float4 vGGI = refl_GGI.SampleLevel(ssSvoPointClamp, IN.baseTC.xy, 0);
+
 		if (!bMissSky)
-			Fwd_StandardOpaqueShading_Raytracing(commonAttribs, fwdAttribs, diffuseAcc, specularAcc, dbgShade, true, !bNoHit);
+			Fwd_StandardOpaqueShading_Raytracing(commonAttribs, fwdAttribs, diffuseAcc, specularAcc, dbgShade, true, !bNoHit, !bNoHit, vGGI);
 
