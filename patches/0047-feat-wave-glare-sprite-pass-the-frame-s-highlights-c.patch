+			// there t1 is the kernel and s1 the linear clamp sampler.
+			m_passDiffractionDebug.SetTexture(1, kernel.GetKernelTexture());
+			m_passDiffractionDebug.SetSampler(1, EDefaultSamplerStates::LinearClamp);
+		}
+
+		// The kernel integrates to well under one over a quarter of a million texels, so a raw
+		// display is black. 1e6 puts a typical ray texel in the middle of the log curve.
+		const float kDebugGain = 1.0e6f;
+		m_passDiffractionDebug.BeginConstantUpdate();
+		m_passDiffractionDebug.SetConstant(diffDebugName,
+		                                   Vec4(fDisplaySize / (float)nGridWidth, fDisplaySize / (float)nGridHeight,
+		                                        kDebugGain, 1.0f / fBloomCompositeWeight), eHWSC_Pixel);
+		m_passDiffractionDebug.Execute();
+	}
+}
