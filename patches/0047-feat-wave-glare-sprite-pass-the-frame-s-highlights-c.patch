+// Wave-optics diffraction glare (DiffractionKernelSpec.md).
+//
+// The glare of a point source IS the Fraunhofer diffraction pattern of the pupil, |F{A}|^2. The
+// CPU has already transformed the pupil into $DiffractionKernel (sqrt-encoded, core removed:
+// the frame carries the source itself). What is left here is the two things that make it a
+// picture: the wavelength scaling and the far field.
+//
+//  * Scale. The kernel's texel pitch on the sensor is lambda * N * d / L, which at working
+//    apertures is a fraction of a pixel - the whole texture spans some tens of pixels. So the
+//    texture resolves the STRUCTURE and the reach comes from the far-field law: past its edge
+//    the pattern is extrapolated as I_ring(theta) * (R_tex / u)^2, the 1/u^2 of a straight
+//    edge. That is exact for a straight blade and pessimistic for anything smoother, so the
+//    extrapolated tail is never brighter than the physics allows.
+//
+//  * Colour. Each wavelength is a scaled copy: PSF_l(u) = (l0/l)^2 * PSF_l0(u * l0/l). Blue is
+//    compact, red is stretched, which is why a real sunstar's ray runs blue at the core and red
+//    at the tip. Six samples, weights pre-multiplied and normalised to white on the CPU.
+
+float4 DiffractionParams0;    // (sprite radius in quarter-res px, kernel texel pitch in the same px, R_tex, 1 / kernel integral)
+float4 DiffractionParams1;    // (dispersion 0..1, grid size L, unused, unused)
+float4 DiffractionParams2;    // (sprite half extent x in NDC, half extent y in NDC, energy per unit of source excess, unused)
+float4 DiffractionSpectrum[6];// rgb = colour * (l0/l)^2 normalised to white, w = l0 / l
+float4 DiffractionDebugParams;// (display width fraction, display height fraction, log gain, output scale)
+
+Texture2D<float4> HDRDiffraction_Src   : register(t0);  // thresholded quarter res source, vertex shader
+Texture2D<float4> HDRDiffraction_Kernel: register(t1);  // sqrt(|F{pupil}|^2), L x L, R16F
+Texture2D<float4> HDRDiffraction_Ring  : register(t2);  // sqrt(I) on the kernel's boundary ring, 256 x 1, R16F
+SamplerState HDRDiffraction_PClampSampler : register(s0);  // PointClamp
+SamplerState HDRDiffraction_LClampSampler : register(s1);  // LinearClamp
+SamplerState HDRDiffraction_LWrapSampler  : register(s2);  // LinearWrap - the ring is an angle
