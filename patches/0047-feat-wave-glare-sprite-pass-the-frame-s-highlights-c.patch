diff --git a/Code/CryEngine/RenderDll/Common/PostProcess/PostEffects.cpp b/Code/CryEngine/RenderDll/Common/PostProcess/PostEffects.cpp
index ada7390f..9e767908 100644
--- a/Code/CryEngine/RenderDll/Common/PostProcess/PostEffects.cpp
+++ b/Code/CryEngine/RenderDll/Common/PostProcess/PostEffects.cpp
@@ -170,6 +170,11 @@ void CHDRStreaks::Reset(bool bOnSpecChange)
 	m_pFilterRotation->ResetParam(0.0f);
 	m_pFilterThreshold->ResetParam(6.0f);
 	m_pFilterPoints->ResetParam(4.0f);
+
+	m_pMode->ResetParam(1.0f);
+	m_pWaveAmount->ResetParam(1.0f);
+	m_pWaveReach->ResetParam(0.35f);
+	m_pDispersion->ResetParam(1.0f);
 	// The PSF image is deliberately NOT dropped here, exactly as the DOF leaves its bokeh
 	// shape texture alone: the owner re-pushes the name every frame, and releasing it would
 	// only make the plate blink out for one frame on every spec change.
@@ -198,6 +203,11 @@ SHDRStreaksParams CHDRStreaks::GetParams() const
 	params.nFilterPoints = (int)clamp_tpl(m_pFilterPoints->GetParam(), 4.0f, 8.0f);
 	params.pFilterPSFTex = const_cast<CTexture*>(static_cast<CParamTexture*>(m_pFilterPSFTex)->GetParamTexture());
 
+	params.nMode = (m_pMode->GetParam() > 0.5f) ? 1 : 0;
+	params.fWaveAmount = clamp_tpl(m_pWaveAmount->GetParam(), 0.0f, 4.0f);
+	params.fWaveReach = clamp_tpl(m_pWaveReach->GetParam(), 0.02f, 1.0f);
+	params.fDispersion = clamp_tpl(m_pDispersion->GetParam(), 0.0f, 1.0f);
+
 	return params;
 }
 
