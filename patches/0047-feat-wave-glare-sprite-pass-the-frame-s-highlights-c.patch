+			m_passDiffractionDebug.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+			m_passDiffractionDebug.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+			m_passDiffractionDebug.SetTechnique(CShaderMan::s_shHDRPostProcess, techDiffractionDebug, 0);
+			m_passDiffractionDebug.SetRenderTarget(0, pTarget);
+			m_passDiffractionDebug.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A | GS_BLSRC_ONE | GS_BLDST_ONE);
