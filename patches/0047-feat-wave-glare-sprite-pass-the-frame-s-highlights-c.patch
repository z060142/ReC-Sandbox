diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp
index a641f3fb..29590310 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp
@@ -2,6 +2,7 @@
 
 #include "StdAfx.h"
 #include "Bloom.h"
+#include "DepthOfField.h"
 #include "D3DPostProcess.h"
 
 // Taps per stretch iteration. Must match the unrolled loop in HDRStreakStretchPS.
@@ -139,13 +140,45 @@ void CBloomStage::ExecuteStreaks()
 		streakParams.fLength = 0.6f;
 	}
 
-	// Two independent effects share this pass block: the iris diffraction spikes and the
-	// anamorphic horizontal flare thrown by a cylindrical front element. Either one alone is
-	// enough to run the block; only both being off skips it.
-	const bool bBlade = streakParams.bActive && streakParams.fAmount >= 0.001f && streakParams.nDirectionCount >= 4;
+	// The iris diffraction has two models of the SAME physics and they are exclusive.
+	//
+	//   Analytic - the original: N line pairs painted by directional stretch blurs, with an
+	//              f-number ramp tuned by eye. Untouched, byte for byte.
+	//   Wave     - DiffractionKernelSpec.md: the frame's highlights convolved with the pupil's
+	//              real Fraunhofer pattern, |FFT(pupil)|^2. No ramp; stopping down spreads the
+	//              pattern by itself, which IS why sunstars appear when you stop down.
+	//
+	// r_HDRStreaks 2 is the ANALYTIC diagnostic force and deliberately does not force Wave: it
+	// exists to prove the analytic passes still run, and forcing a different model would defeat
+	// exactly that.
+	//
+	// The kernel lives in the DOF stage, so Wave needs that stage to be running (r_dof > 0) -
+	// it is what resolves the pupil and ticks the job. Until the first kernel has landed, and
+	// for as long as it never does, the analytic lines carry the effect rather than nothing.
+	// Readiness is a latch, not a per-frame test: a rebuild keeps the PREVIOUS kernel live, so
+	// this cannot flicker between the two models while the pupil is being pulled.
+	const CDepthOfFieldStage* pDofStageForKernel = m_graphicsPipeline.GetStage<CDepthOfFieldStage>();
+	const bool bKernelReady = (pDofStageForKernel != nullptr) && pDofStageForKernel->GetDiffractionKernel().IsReady();
+
+	const bool bWaveMode = (streakParams.nMode == 1) && (CRenderer::CV_r_HDRStreaks != 2) && (CRenderer::CV_r_HDRDiffractionKernel != 0) && bKernelReady;
+	const bool bWave = bWaveMode && streakParams.bActive && streakParams.fWaveAmount >= 0.001f;
+	const bool bBlade = !bWaveMode && streakParams.bActive && streakParams.fAmount >= 0.001f && streakParams.nDirectionCount >= 4;
 	const bool bAnamorphic = streakParams.fAnamorphicAmount >= 0.001f;
 
-	if (!bBlade && !bAnamorphic)
+	// The kill switch: with the kernel refused, Wave mode falls back to the analytic lines, once
+	// per transition in the log rather than silently looking broken.
+	{
+		static int s_nLastFallback = -1;
+		const int nFallback = ((streakParams.nMode == 1) && (CRenderer::CV_r_HDRDiffractionKernel == 0)) ? 1 : 0;
+		if (nFallback != s_nLastFallback)
+		{
+			s_nLastFallback = nFallback;
+			if (nFallback)
+				CryLog("[BLOOM] r_HDRDiffractionKernel 0: streak mode Wave falls back to the analytic line pairs");
+		}
+	}
+
+	if (!bBlade && !bAnamorphic && !bWave)
 		return;
 
 	PROFILE_LABEL_SCOPE("HDR_STREAKS");
@@ -244,6 +277,12 @@ void CBloomStage::ExecuteStreaks()
 		}
 	}
 
+	// Wave-optics diffraction. Sits exactly where the analytic lines would have been - the two
+	// are alternatives, never both - and, like them, it consumes the scratch targets and hands
+	// them back before the anamorphic flare re-thresholds into them below.
+	if (bWave)
+		ExecuteDiffraction(streakParams, fBloomCompositeWeight);
+
 	// Anamorphic horizontal flare. A cylindrical front element throws one long tinted line
 	// across the frame instead of a star, so this is a single horizontal march - but a much
 	// longer one: three iterations of 8 taps span 8^3 tap distances, the whole frame width.
@@ -312,6 +351,286 @@ void CBloomStage::ExecuteStreaks()
 	}
 }
 
+// Wave-optics diffraction glare (DiffractionKernelSpec.md).
+//
+// The glare of a point source is not a set of lines someone painted: it is the Fraunhofer
+// diffraction pattern of the pupil the light came through, |F{A}|^2. A 9-blade iris throws 18
+// rays with a specific intensity pattern; a star-shaped mask throws its own; curved blades
+// soften and shorten the rays; an aberrated pupil puts rings around them. All of that is one
+// transform, which the DOF stage's job has already computed by the time we get here - the pupil
+// lives there, so the kernel does too.
+//
+// What is left for this pass is the CONVOLUTION and the SCALE.
+//
+// Scale: a DFT of a pupil d texels across on an L texel grid gives a pattern whose texel pitch
+// on the sensor is lambda * N * d / L. At f/11 on a full frame that is about 0.16 native pixels,
+// so the whole 512^2 texture spans only some 40 pixels of screen. The FFT resolves the
+// STRUCTURE; the REACH has to come from the far-field law, and the pixel shader extrapolates
+// past the texture's edge with the 1/u^2 of a straight edge, read off the kernel's boundary
+// ring. This is also where "sunstars appear when you stop down" comes from for free: N scales
+// the pattern, so stopping down spreads the same energy fraction over a larger pattern - longer
+// rays, dimmer per pixel. No f-number ramp exists anywhere in this path, by design.
+//
+// Convolution: the front filter's sparse sprite convolution, unchanged in shape - threshold the
+// quarter-resolution frame, one sprite per surviving texel, deposit additively into the bloom
+// target with the bloom composite weight divided back out.
+void CBloomStage::ExecuteDiffraction(const SHDRStreaksParams& streakParams, float fBloomCompositeWeight)
+{
+	CDepthOfFieldStage* pDofStage = m_graphicsPipeline.GetStage<CDepthOfFieldStage>();
+	if (pDofStage == nullptr)
+		return;
+
+	const CDiffractionKernel& kernel = pDofStage->GetDiffractionKernel();
+
+	// Not ready yet: the first job takes a frame or two to land, and a pupil change re-runs it.
+	// Draw NOTHING rather than falling back to the analytic lines - a per-frame fallback would
+	// flash the old model on every blade-rotation step.
+	if (!kernel.IsReady())
+		return;
+
+	CTexture* pSource = m_graphicsPipelineResources.m_pTexHDRTargetScaled[1][1];
+	CTexture* pTarget = m_graphicsPipelineResources.m_pTexHDRFinalBloom;
+
+	if (!CTexture::IsTextureExist(pSource) || !CTexture::IsTextureExist(pTarget))
+		return;
+
+	PROFILE_LABEL_SCOPE("HDR_DIFFRACTION");
+
+	static CCryNameTSCRC techStreakThreshold("HDRStreakThreshold");
+	static CCryNameTSCRC techDiffraction("HDRDiffractionPSF");
+	static CCryNameTSCRC techDiffractionDebug("HDRDiffractionDebug");
+	static CCryNameR streakParams1Name("StreakParams1");
+	static CCryNameR diffParams0Name("DiffractionParams0");
+	static CCryNameR diffParams1Name("DiffractionParams1");
+	static CCryNameR diffParams2Name("DiffractionParams2");
+	static CCryNameR diffSpectrumName("DiffractionSpectrum");
+	static CCryNameR diffDebugName("DiffractionDebugParams");
+
+	// 1. Threshold, the streaks' own technique and their own threshold - one source of glare
+	//    sources for the whole family, so a lamp that streaks also stars and halates.
+	if (m_passDiffractionThreshold.IsDirty())
+	{
+		m_passDiffractionThreshold.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passDiffractionThreshold.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passDiffractionThreshold.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakThreshold, 0);
+		m_passDiffractionThreshold.SetRenderTarget(0, pSource);
+		m_passDiffractionThreshold.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A);
+		m_passDiffractionThreshold.SetTexture(0, m_graphicsPipelineResources.m_pTexHDRTargetScaled[0][0]);
+		m_passDiffractionThreshold.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passDiffractionThreshold.BeginConstantUpdate();
+	m_passDiffractionThreshold.SetConstant(streakParams1Name, Vec4(streakParams.fThreshold, max(streakParams.fThreshold * 0.25f, 0.01f), 0, 0), eHWSC_Pixel);
+	m_passDiffractionThreshold.Execute();
+
+	const int32 nGridWidth = pSource->GetWidth();
+	const int32 nGridHeight = pSource->GetHeight();
+	const uint32 nVertexCount = uint32(nGridWidth) * uint32(nGridHeight) * 3 * 2;
+
+	if (!m_pDiffractionPerViewCB)
+	{
+		m_pDiffractionPerViewCB = gcpRendD3D->m_DevBufMan.CreateConstantBuffer(sizeof(HLSL_PerViewGlobalConstantBuffer));
+		if (m_pDiffractionPerViewCB)
+			m_pDiffractionPerViewCB->SetDebugName("Diffraction Per-View CB");
+	}
+
+	if (!m_pDiffractionPerViewCB)
+		return;
+
+	// The pattern's texel pitch on the sensor, in QUARTER RESOLUTION pixels - the unit the
+	// sprite grid is measured in.
+	//
+	//   s = lambda0 * N_geo * d / L        (metres on the sensor)
+	//   s_q = s * grid_width / sensor_width
+	//
+	// N is the geometric aperture the DOF resolved (max(N, N_mask) with a mask bound), because
+	// a mask stops the light down just as the iris does and the pattern follows the hole light
+	// actually passed.
+	const float kLambda0 = 550e-9f;
+	const float fSensorWidthM = max(pDofStage->GetDiffractionSensorWidthMM(), 1.0f) * 0.001f;
+	const float fPitchQuarterPx = max(kLambda0 * pDofStage->GetDiffractionNGeo() * kernel.GetTexelPitchPupilUnits()
+	                                  * (float)nGridWidth / fSensorWidthM, 1e-6f);
+
+	// Sprite radius, a fraction of the frame HEIGHT so the reach is the same at any aspect
+	// ratio. This is purely where the extrapolated tail is CUT OFF - a cost and coverage choice,
+	// not a property of the lens. Bigger = more of the faint tail, quadratically more pixels.
+	const float fRadiusQuarterPx = max(streakParams.fWaveReach * (float)nGridHeight, 2.0f);
+
+	// Anamorphic: the iris sits BEHIND the cylindrical front group, so its pattern is formed
+	// unsqueezed and then stretched horizontally by the desqueeze - the sprite's x half extent
+	// is multiplied by S. This is the OPPOSITE of the front filter PSF, which is a plate in
+	// front of the cylinder and is therefore squeezed like the rest of the picture. The analytic
+	// streaks do neither: they march in texel space and ignore the squeeze entirely, which is a
+	// known simplification of that model and is left exactly as it is.
+	const float fSqueeze = clamp_tpl(PostEffectMgr()->GetByNameF("Dof_User_AnamorphicSqueeze"), 1.0f, 2.0f);
+
+	const float fRadiusNdcY = 2.0f * fRadiusQuarterPx / (float)nGridHeight;
+	const float fRadiusNdcX = 2.0f * (fRadiusQuarterPx * fSqueeze) / (float)nGridWidth;
+
+	// Energy. The kernel's integral is the texture's own plus the extrapolated tail out to the
+	// sprite's rim; the tail is logarithmic, hence finite, and the CPU handed us its coefficient
+	// so the deposit is energy correct INCLUDING what the sprite cuts off. Dividing by the pitch
+	// squared converts "per kernel texel" into "per quarter-resolution pixel", which is what the
+	// sprite actually rasterizes.
+	//
+	// With that, amount 1 puts the source's whole thresholded excess into the pattern the pupil
+	// dictates - no gain constant tuned by eye anywhere. (The removed core is NOT added back:
+	// the frame already carries the source itself. Its fraction is in the kernel's log line, so
+	// how much of the light really went into the glare stays readable.)
+	const float fRingRadius = max(kernel.GetRingRadius(), 1.0f);
+	const float fSpriteRadiusTexels = max(fRadiusQuarterPx / fPitchQuarterPx, fRingRadius);
+	const float fIntegral = max(kernel.GetTextureIntegral()
+	                            + kernel.GetTailCoefficient() * logf(fSpriteRadiusTexels / fRingRadius), 1e-12f);
+	const float fNorm = 1.0f / (fIntegral * fPitchQuarterPx * fPitchQuarterPx);
+	const float fEnergy = streakParams.fWaveAmount / fBloomCompositeWeight;
+
+	// Spectral sampling. Each wavelength is a SCALED copy of the same pattern -
+	// PSF_lambda(u) = (l0/l)^2 * PSF_l0(u * l0/l) - so blue sits compact near the core and red
+	// runs out to the tips. That is what makes a real sunstar's rays rainbow: dispersion, not a
+	// hue ramp. The six columns are rescaled once so their weighted sum is exactly white.
+	Vec4 vSpectrum[6];
+	{
+		static const float s_lambdaNm[6] = { 420.0f, 470.0f, 520.0f, 570.0f, 620.0f, 670.0f };
+		static const Vec3  s_colour[6] =
+		{
+			Vec3(0.05f, 0.00f, 0.35f), Vec3(0.00f, 0.10f, 0.50f), Vec3(0.00f, 0.55f, 0.15f),
+			Vec3(0.35f, 0.35f, 0.00f), Vec3(0.45f, 0.00f, 0.00f), Vec3(0.15f, 0.00f, 0.00f)
+		};
+
+		Vec3 vSum(0.0f, 0.0f, 0.0f);
+		float fRatio[6];
+		float fWeight[6];
+		for (int i = 0; i < 6; ++i)
+		{
+			fRatio[i] = 550.0f / s_lambdaNm[i];
+			fWeight[i] = fRatio[i] * fRatio[i];
+			vSum += s_colour[i] * fWeight[i];
+		}
+
+		const Vec3 vScale(1.0f / max(vSum.x, 1e-4f), 1.0f / max(vSum.y, 1e-4f), 1.0f / max(vSum.z, 1e-4f));
+		for (int i = 0; i < 6; ++i)
+		{
+			const Vec3 c = s_colour[i] * fWeight[i];
+			vSpectrum[i] = Vec4(c.x * vScale.x, c.y * vScale.y, c.z * vScale.z, fRatio[i]);
+		}
+	}
+
+	// Once per change, never per frame: what the pattern actually resolves to on screen.
+	{
+		static float s_lastPitch = -1.0f, s_lastAmount = -1.0f, s_lastReach = -1.0f, s_lastDispersion = -1.0f, s_lastN = -1.0f;
