diff --git a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp
index f9540c32..81799480 100644
--- a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp
+++ b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp
@@ -1782,6 +1782,28 @@ void CCinematicCameraComponent::ApplyGrade()
 	gEnv->p3DEngine->SetPostEffectParamVec4("Global_User_GradeOffset", Vec4(grade.offset.x, grade.offset.y, grade.offset.z, 0.0f));
 	gEnv->p3DEngine->SetPostEffectParamVec4("Global_User_GradePower",  Vec4(grade.power.x, grade.power.y, grade.power.z, 0.0f));
 	gEnv->p3DEngine->SetPostEffectParam("Global_User_GradeSaturation", (float)grade.saturation);
+
+	// Diagnostic, edge-triggered exactly like the white balance's below: one line per change of
+	// the CDL this camera publishes. It is the answer to "I moved a grade slider and the picture
+	// did not move" - a line means the value left the component, reached the bus and the reason
+	// lies further down the chain (the Scene Referred switch, which is where the tone map reads
+	// these params at all); no line means it never got here. Two float compares per frame.
+	{
+		const float sat = (float)grade.saturation;
+		if (fabs_tpl(grade.slope.x - m_lastLoggedGradeSlopeX) > 1e-4f ||
+		    fabs_tpl(sat - m_lastLoggedGradeSaturation) > 1e-4f)
+		{
+			m_lastLoggedGradeSlopeX = grade.slope.x;
+			m_lastLoggedGradeSaturation = sat;
+			CryLog("[CinematicCamera] grade published: slope %.3f/%.3f/%.3f offset %.3f/%.3f/%.3f "
+			       "power %.3f/%.3f/%.3f saturation %.3f%s (scene referred %s)",
+			       grade.slope.x, grade.slope.y, grade.slope.z,
+			       grade.offset.x, grade.offset.y, grade.offset.z,
+			       grade.power.x, grade.power.y, grade.power.z, sat,
+			       bBypass ? " BYPASSED" : "",
+			       m_sceneReferred.bSceneReferred ? "on" : "OFF - the tone map does not read these");
+		}
+	}
 }
 
