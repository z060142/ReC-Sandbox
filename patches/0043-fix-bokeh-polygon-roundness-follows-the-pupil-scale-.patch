+	               "The result is clamped to [0, 1] - a real iris opening is convex and nothing "
+	               "may stretch its corners past the true polygon.");
 	REGISTER_CVAR3("r_DepthOfFieldSpriteBokehDebug", CV_r_DofSpriteBokehDebug, 0, VF_NULL,
