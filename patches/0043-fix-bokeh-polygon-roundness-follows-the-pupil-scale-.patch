 		desc.AddMember(&SCineLensParams::bladeCurvature,
 			'bcrv', "BladeCurvature", "Blade Curvature",
-			"How curved the iris blades are, which decides whether the aperture can actually "
-			"close to a circle. 0 = perfectly straight blades: the full polygon shows at every "
-			"f-stop and its edges are cut crisply, so a 3-blade iris stays a clean triangle even "
-			"wide open. 1 = fully curved blades that retract into a true circle wide open and "
-			"draw a slightly softer outline when stopped down. The silhouette is the same convex "
-			"polygon either way - curvature decides when it forms and how hard its edge is, it "
-			"never stretches the corners. Real lenses sit in between, and low blade counts show "
-			"it most - at 9 blades the polygon is nearly round anyway.", 0.4f);
+			"How curved the iris blades are, which decides how round the opening is at a given "
+			"aperture. 0 = perfectly straight blades: the exact polygon at every f-stop, edges "
+			"cut crisply, so a 3-blade iris stays a clean sharp triangle. 1 = fully curved "
+			"blades: a true circle wide open, and the polygon reappearing gradually as you stop "
+			"down (half way one stop down, three quarters two stops down), with a slightly "
+			"softer outline. At an ordinary working aperture this is the fat-rounded-triangle "
+			"versus sharp-triangle control. The silhouette is always the same convex polygon - "
+			"curvature decides how far its edges bulge and how hard they are cut, it never "
+			"stretches the corners. Real lenses sit in between, and low blade counts show it "
+			"most - at 9 blades the polygon is nearly round anyway.", 0.4f);
 		desc.AddMember(&SCineLensParams::transmission,
 			'trns', "Transmission", "Transmission",
 			"Fraction of light the glass actually passes; defines the T-stop as T = f / sqrt(transmission). "
