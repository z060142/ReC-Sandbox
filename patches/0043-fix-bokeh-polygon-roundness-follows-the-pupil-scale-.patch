diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
index a8046c6b..84fe0cd6 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
@@ -22,24 +22,33 @@ float NGon_Rad(float theta, float n)
 // always convex; exponents above 1 were a "make it readable" caricature tuned on 5-9 blades and
 // are not physical at any blade count.
 //
-// Two things drive what is left. Stopping down reveals the polygon (round at f/1.2, complete by
-// f/2.8, deliberately overlapping the apertures that produce LARGE discs or the shape would
-// never be readable). And blade curvature: only a CURVED blade can retract into a circle, so
-// straight blades keep the fully formed polygon at EVERY aperture - low curvature floors the
-// formation window. What makes a straight blade look SHARPER than a curved one is the edge, not
-// the corner length; that lives in ComputeIrisEdgeSoftness below.
-static float ComputeIrisShapeExponent(float fstop, float curvature)
+// What is left is one continuous geometric fact. A curved blade bounds the opening with a
+// circular ARC, and how much that arc bulges away from the polygon's chord is the ratio of the
+// OPENING radius to the blade's own arc radius. The blade is a fixed piece of metal, so its arc
+// radius never changes; only the opening does. Wide open the opening fills the arc and the
+// outline is round; stopped down the same arc subtends a small angle across a small opening and
+// reads as a straight chord, i.e. the polygon. Straight blades (curvature 0) have no arc at all
+// and give the exact polygon at every aperture.
+//
+// The opening radius relative to wide open is exactly the pupil scale p = N_open / N_geo the
+// field-pupil code already carries (1 wide open, 0.5 one stop down, 0.25 two stops down), so:
+//
+//     exponent = 1 - curvature * p        (0 = perfect circle, 1 = exact polygon)
+//
+// This is a function of the aperture at EVERY stop, not a window: the old f/1.2 - f/2.8 blend
+// was an approximation of exactly this curve for a f/1.2 lens, and it wrongly forced the exact
+// polygon on every lens above f/2.8, which killed the curvature control at ordinary working
+// apertures. What makes a straight blade look SHARPER than a curved one beyond the outline is
+// the edge; that lives in ComputeIrisEdgeSoftness below.
+static float ComputeIrisShapeExponent(float pupilScale, float curvature)
 {
-	const float minFstops = 1.2f;
-	const float maxFstops = 2.8f;
-	const float stopBlend = clamp_tpl((fstop - minFstops) / (maxFstops - minFstops), 0.0f, 1.0f);
-	const float straight = 1.0f - clamp_tpl(curvature, 0.0f, 1.0f);
-	// Straight blades are always fully formed; curved blades follow the f-stop window.
-	const float formed = straight + (1.0f - straight) * stopBlend;
+	const float p = clamp_tpl(pupilScale, 0.0f, 1.0f);
+	const float curv = clamp_tpl(curvature, 0.0f, 1.0f);
+	// r_DofBokehShapeStrength scales the ROUNDING term, i.e. the reach of the blade curvature:
+	// above 1 curved blades stay round further down the stops, below 1 they sharpen sooner.
+	// It can no longer push past the true polygon - that is what the clamp to 1 protects.
 	const float strength = clamp_tpl(CRenderer::CV_r_DofBokehShapeStrength, 0.25f, 4.0f);
-	// 1 is the true iris and the ceiling. r_DofBokehShapeStrength below 1 rounds the polygon
-	// back toward a circle; above 1 it can no longer push past the physical shape.
-	return clamp_tpl(formed * strength, 0.0f, 1.0f);
+	return clamp_tpl(1.0f - curv * p * strength, 0.0f, 1.0f);
 }
 
 // Soft width of the polygon's edge in the splat, in quad-local radius units. This is where the
@@ -377,17 +386,6 @@ void CDepthOfFieldStage::Execute()
 		fFNumber = 8.0f;
 	}
 
-	// Ground truth log: what actually reaches the kernel, once per change.
-	static float s_lastLoggedBlades = -1.0f;
-	static float s_lastLoggedFNumber = -1.0f;
-	if (fabsf(fNumApertureSides - s_lastLoggedBlades) > 0.01f || fabsf(fFNumber - s_lastLoggedFNumber) > 0.01f)
-	{
-		s_lastLoggedBlades = fNumApertureSides;
-		s_lastLoggedFNumber = fFNumber;
-		CryLog("[DOF] kernel blades=%.0f fNumber=%.1f%s", fNumApertureSides, fFNumber,
-		       CRenderer::CV_r_DofBokehQuality >= 3 ? " (FORCED)" : "");
-	}
-
 	if (dofParams.bGameMode)
 	{
 		dofParams.vFocus.x = 1.0f / (vFocus.z + 1e-6f);
@@ -410,13 +408,35 @@ void CDepthOfFieldStage::Execute()
 	const float fBladeRotation = dofParams.fBladeRotation;
 
 	// Resolved once, consumed by the gather taps below and by the splat mask in the hybrid
-	// overlay. The diagnostic force mode pins fFNumber to 8 and the curvature to fully curved,
-	// which reduces the exponent to the legacy strength-at-full-formation.
-	const float fBladeCurvatureEff = (CRenderer::CV_r_DofBokehQuality >= 3) ? 1.0f : dofParams.fBladeCurvature;
-	const float fIrisExponent = ComputeIrisShapeExponent(fFNumber, fBladeCurvatureEff);
+	// overlay. The diagnostic force mode wants the shape as readable as it gets, so it pins the
+	// blades straight: no arc, exponent 1, the fully formed polygon at any aperture.
+	const float fBladeCurvatureEff = (CRenderer::CV_r_DofBokehQuality >= 3) ? 0.0f : dofParams.fBladeCurvature;
+	// Roundness follows the opening radius relative to wide open, which is the same pupil scale
+	// the field-dependent pupil below uses - one aperture, one geometry.
+	const float fIrisPupilScale = clamp_tpl(dofParams.fPupilScale, 0.0f, 1.0f);
+	const float fIrisExponent = ComputeIrisShapeExponent(fIrisPupilScale, fBladeCurvatureEff);
 	// The other half of the curvature knob: how crisp the polygon's edge is cut in the splat.
 	const float fIrisEdgeSoft = ComputeIrisEdgeSoftness(fBladeCurvatureEff);
 
+	// Ground truth log: what actually reaches the kernel, once per change.
+	{
+		static float s_lastLoggedBlades = -1.0f;
+		static float s_lastLoggedFNumber = -1.0f;
+		static float s_lastLoggedExponent = -1.0f;
+		static float s_lastLoggedPupil = -1.0f;
+		if (fabsf(fNumApertureSides - s_lastLoggedBlades) > 0.01f || fabsf(fFNumber - s_lastLoggedFNumber) > 0.01f ||
+		    fabsf(fIrisExponent - s_lastLoggedExponent) > 0.01f || fabsf(fIrisPupilScale - s_lastLoggedPupil) > 0.01f)
+		{
+			s_lastLoggedBlades = fNumApertureSides;
+			s_lastLoggedFNumber = fFNumber;
+			s_lastLoggedExponent = fIrisExponent;
+			s_lastLoggedPupil = fIrisPupilScale;
+			CryLog("[DOF] kernel blades=%.0f fNumber=%.1f p=%.2f curv=%.2f irisExp=%.2f edgeSoft=%.3f%s",
+			       fNumApertureSides, fFNumber, fIrisPupilScale, fBladeCurvatureEff, fIrisExponent, fIrisEdgeSoft,
+			       CRenderer::CV_r_DofBokehQuality >= 3 ? " (FORCED)" : "");
+		}
+	}
+
 	// Anamorphic squeeze. The cylindrical element compresses the pupil image horizontally, so
 	// the gather kernel's horizontal reach shrinks by the same factor while the vertical reach
 	// stays the spherical CoC: every out-of-focus disc becomes a vertical oval of
