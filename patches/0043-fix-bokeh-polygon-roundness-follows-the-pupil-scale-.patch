 	REGISTER_CVAR3("r_DepthOfFieldBokehShapeStrength", CV_r_DofBokehShapeStrength, 1.0f, VF_NULL,
-	               "Formation exponent for the polygonal bokeh kernel. "
-	               "1 = physical: the bokeh is exactly the iris polygon; "
-	               "< 1 rounds the polygon back toward a circle; "
-	               "values above 1 are clamped - a real iris opening is convex and nothing may "
