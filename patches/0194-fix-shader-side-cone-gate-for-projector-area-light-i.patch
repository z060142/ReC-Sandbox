From bfc8816101a18810d1b9e8dafd655fbfd4f33f61 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 12 Aug 2026 05:48:39 +0800
Subject: [PATCH 194/307] fix: shader side cone gate for projector/area light
 injection

The previous commit uploaded LPVLightDir but the temporal shader never
declared or used it - projectors and area lights injected
omnidirectionally. The gate now weights the emission by a soft-edged
cone around the light axis (projector frustum / area hemisphere).

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tu9cj9ax1mqCV93HVfCfpW
---
 Engine/Shaders/HWScripts/CryFX/LPV.cfi | 24 +++++++++++++++++++-----
 1 file changed, 19 insertions(+), 5 deletions(-)

diff --git a/Engine/Shaders/HWScripts/CryFX/LPV.cfi b/Engine/Shaders/HWScripts/CryFX/LPV.cfi
index 358139a3..a7f1ea11 100644
--- a/Engine/Shaders/HWScripts/CryFX/LPV.cfi
+++ b/Engine/Shaders/HWScripts/CryFX/LPV.cfi
@@ -700,6 +700,9 @@ float4 LPVLightParams;
 float4 LPVLightPos[LPV_MAX_POINT_LIGHTS];
 // rgb: colour (scene scaled)
 float4 LPVLightColor[LPV_MAX_POINT_LIGHTS];
+// xyz: emission direction (projector axis / area light normal), w: cos of the outer cone
+// half-angle (projector), 0 (area light hemisphere) or -1.5 (omnidirectional point light)
+float4 LPVLightDir[LPV_MAX_POINT_LIGHTS];
 
 Texture3D<float4> LPVTempCurR  : register(t0);
 Texture3D<float4> LPVTempCurG  : register(t1);
@@ -740,12 +743,23 @@ void LPVTemporalCS(uint3 DTid : SV_DispatchThreadID)
 			if (dist >= radius)
 				continue;
 
-			const float falloff = 1.0f - dist / radius;
-			const float atten = falloff * falloff * LPVLightParams.y;
-
-			// The light flows outward: 60% radial cosine lobe + 40% isotropic (a pure lobe is
-			// degenerate in the cell containing the light itself).
 			const float3 dirOut = (dist > 1e-3f) ? toCell / dist : float3(0.0f, 0.0f, 1.0f);
+
+			// Cone gate: projectors only emit into their frustum cone, area lights into the
+			// hemisphere in front of the plane; -1.5 (point lights) always passes. Soft edge over
+			// the outer part of the cone.
+			float coneWeight = 1.0f;
+			const float cosOuter = LPVLightDir[i].w;
+			if (cosOuter > -1.0f)
+			{
+				const float cosAngle = dot(dirOut, LPVLightDir[i].xyz);
+				coneWeight = smoothstep(cosOuter, lerp(cosOuter, 1.0f, 0.35f), cosAngle);
+			}
+			if (coneWeight <= 0.0f)
+				continue;
+
+			const float falloff = 1.0f - dist / radius;
+			const float atten = falloff * falloff * coneWeight * LPVLightParams.y;
 			const float4 sh = LPVCosineLobe(dirOut) * 0.6f + float4(LPV_SH_C0 * 0.4f, 0.0f, 0.0f, 0.0f);
 
 			curR += sh * (LPVLightColor[i].r * atten);
