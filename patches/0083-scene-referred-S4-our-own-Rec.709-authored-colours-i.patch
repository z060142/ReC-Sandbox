diff --git a/Code/CryEngine/RenderDll/Common/RendererResources.cpp b/Code/CryEngine/RenderDll/Common/RendererResources.cpp
index b77c2408..77ada394 100644
--- a/Code/CryEngine/RenderDll/Common/RendererResources.cpp
+++ b/Code/CryEngine/RenderDll/Common/RendererResources.cpp
@@ -503,6 +503,34 @@ bool CRendererResources::IsSceneReferredWorkingSpace()
 // ccam publishes it, the sun's value changes only when the time of day is re-evaluated. Reading
 // the same global that produced the number keeps the correction and the number in lockstep, which
 // is the entire point of the manual undos this gates.
+// Rec.709 linear -> ACEScg (AP1, D60 via Bradford), on the CPU, and ONLY while the HDR target is
+// actually in the working space.
+//
+// Every colour our own effects author - the anamorphic coating, the halation dye, the ghost
+// coatings, the diffraction spectrum - was picked by eye against a Rec.709 picture. Those numbers
+// stay Rec.709: they are what the artist chose, they are what the tooltips describe, and they are
+// what a preset file carries. What has to change is the moment they become a MULTIPLIER of AP1
+// data, and that is here, at the constant upload.
+//
+// The picture must not visibly move: this is the same colour expressed in different primaries,
+// not a different colour. What it fixes is a real error - a 709-encoded orange multiplying AP1
+// values is a slightly different orange, and the wider the gamut the further off it drifts.
+//
+// The matrix is CommonMath.cfi's REC709_TO_ACESCG to the digit, verified against PyOpenColorIO
+// 2.5 by tools/ocio-bake/verify_matrices.py. Every entry is non-negative and every row sums to
+// one, so (1,1,1) maps to (1,1,1) exactly: a white tint stays white and an untinted effect is
+// bit-identical either way.
+Vec3 CRendererResources::ToWorkingSpace(const Vec3& rec709)
+{
+	if (!IsSceneReferredWorkingSpace())
+		return rec709;
+
+	return Vec3(
+		0.61309740f * rec709.x + 0.33952315f * rec709.y + 0.04737945f * rec709.z,
+		0.07019372f * rec709.x + 0.91635388f * rec709.y + 0.01345240f * rec709.z,
+		0.02061559f * rec709.x + 0.10956977f * rec709.y + 0.86981463f * rec709.z);
+}
+
