+	// treating it as Rec.709 would be a guess dressed up as a correction.
+	const Vec4 vFilterParams1(fEnergy, (float)nPoints, bPSFTexValid ? 1.0f : 0.0f,
+	                          CRendererResources::IsSceneReferredWorkingSpace() ? 1.0f : 0.0f);
 
