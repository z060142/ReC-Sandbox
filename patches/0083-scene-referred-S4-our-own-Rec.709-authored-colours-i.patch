 		float fRatio[6];
 		float fWeight[6];
 		for (int i = 0; i < 6; ++i)
 		{
+			vColourWS[i] = CRendererResources::ToWorkingSpace(s_colour[i]);
 			fRatio[i] = 550.0f / s_lambdaNm[i];
