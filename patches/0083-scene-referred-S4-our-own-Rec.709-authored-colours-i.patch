@@ -635,20 +639,26 @@ void CBloomStage::ExecuteDiffraction(const SHDRStreaksParams& streakParams, floa
 			Vec3(0.35f, 0.35f, 0.00f), Vec3(0.45f, 0.00f, 0.00f), Vec3(0.15f, 0.00f, 0.00f)
 		};
 
+		// The six columns are Rec.709-authored responses. They are converted to the working
