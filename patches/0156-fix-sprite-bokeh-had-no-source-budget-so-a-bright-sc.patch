+	const float fExcess = 0.25 * (LensHighlightExcess(GetWorkingLuminance(c0), fThreshold, fKnee) +
+	                              LensHighlightExcess(GetWorkingLuminance(c1), fThreshold, fKnee) +
+	                              LensHighlightExcess(GetWorkingLuminance(c2), fThreshold, fKnee) +
+	                              LensHighlightExcess(GetWorkingLuminance(c3), fThreshold, fKnee));
+
+	// SKY DE-PRIORITISATION (r_DepthOfFieldSpriteBokehSkyWeight), the S9 finding applied here: a
+	// sky is enormous, sits at infinity so its discs are the largest and most expensive in the
+	// frame, and is routinely two to five stops over mid grey. On equal terms it takes every slot
+	// and the practicals in the scene lose their bokeh. This is a PRIORITY and never light: a sky
+	// cell that wins draws its full sprite, and one that loses keeps all of its excess in the
+	// gather, so the frame's total is identical at every value of the weight.
+	const float fSky = (min(min(rawDepths.x, rawDepths.y), min(rawDepths.z, rawDepths.w)) >= kDofSpriteSkyDepth) ? 1.0 : 0.0;
+
+	float fPriority = fExcess * fFade * lerp(1.0, vDofSpriteBudget.y, fSky);
+	if (fDiameterPx < 1.0 || fFade <= 0.001 || fExcess < 1e-4)
+		fPriority = 0.0;
+
+	const float fCut = DofSpriteW_Stats.SampleLevel(DofSpriteW_StatsS, float2(0.5, 0.5), 0).x;
+
+	// One STOP of crossfade, not a hard cut, so a source drifting past the budget while the camera
+	// pans loses its shape over several frames. A cell this pass cannot measure as a source
+	// (fPriority 0) is left at 1 and the sprite's own culls decide it, which is the safe direction:
+	// this pass may DEMOTE a source, it may never invent a cull the splat did not have.
+	float fWeight = 1.0;
+	if (fCut > 0.0 && fPriority > 0.0)
+		fWeight = smoothstep(fCut, fCut * 2.0, fPriority);
+
+	return float4(fPriority, fWeight, fExcess, 0.0);
+}
+
+Texture2D<float4> DofSpriteStats_Src  : register(t0);  // the weight map, or the previous stage
+SamplerState      DofSpriteStats_SrcS : register(s0);  // PointClamp
+
+float4 vDofSpriteStats0;   // (1 / source width, 1 / source height, block width, block height)
+float4 vDofSpriteStats1;   // (source width, source height, target width, target height)
+float4 vDofSpriteBudgetN;  // (budget N, unused x3)
+
+// Step 1. One output texel per 8x8 block of weight-map texels. The raw count uses exactly the
+// weight pass's own test, so "raw sources" in the report is the number of sprites this frame would
+// rasterize with no budget at all - not an estimate of it.
+float4 DofSpriteSourceStatsPS(vtxOut IN) : SV_Target
+{
+	const float2 vSrcSize    = vDofSpriteStats1.xy;
+	const float2 vTargetSize = vDofSpriteStats1.zw;
+	const float2 vInvSrc     = vDofSpriteStats0.xy;
+	const int2   vBlock      = (int2)vDofSpriteStats0.zw;
+
+	const int2 vBase = ((int2)floor(IN.baseTC.xy * vTargetSize)) * vBlock;
+
+	float4 acc = 0;
+
+	[loop] for (int j = 0; j < vBlock.y; ++j)
+	{
+		[loop] for (int i = 0; i < vBlock.x; ++i)
+		{
+			const int2 p = vBase + int2(i, j);
+			if (p.x >= (int)vSrcSize.x || p.y >= (int)vSrcSize.y)
+				continue;
+
+			const float4 c = DofSpriteStats_Src.SampleLevel(DofSpriteStats_SrcS, ((float2)p + 0.5) * vInvSrc, 0);
+			if (c.x <= 0.0)
+				continue;   // not a source at all: the splat would collapse this quad anyway
+
+			acc.x += 1.0;
+			// z and w are TRUE excess, not priority: they are what the report calls the source
+			// excess and what the bootstrap sizes the first cutoff from. Only SELECTION is weighted.
+			acc.z += c.z;
+			if (c.y > 0.0)
+				acc.y += 1.0;
+			else
+				acc.w += c.z;
+		}
+	}
+
+	return acc;
+}
+
+// Step 2. Plain block sum into the fixed 16x16, so step 3 is always 256 taps at any resolution.
+float4 DofSpriteStatsReducePS(vtxOut IN) : SV_Target
+{
+	const float2 vSrcSize    = vDofSpriteStats1.xy;
+	const float2 vTargetSize = vDofSpriteStats1.zw;
+	const float2 vInvSrc     = vDofSpriteStats0.xy;
+	const int2   vBlock      = (int2)vDofSpriteStats0.zw;
+
+	const int2 vBase = ((int2)floor(IN.baseTC.xy * vTargetSize)) * vBlock;
+
+	float4 acc = 0;
+
+	[loop] for (int j = 0; j < vBlock.y; ++j)
+	{
+		[loop] for (int i = 0; i < vBlock.x; ++i)
+		{
+			const int2 p = vBase + int2(i, j);
+			if (p.x >= (int)vSrcSize.x || p.y >= (int)vSrcSize.y)
+				continue;
+
+			acc += DofSpriteStats_Src.SampleLevel(DofSpriteStats_SrcS, ((float2)p + 0.5) * vInvSrc, 0);
+		}
+	}
+
+	return acc;
+}
+
+Texture2D<float4> DofSpriteBudget_Prev  : register(t1);  // the PREVIOUS frame's 1x1 stats
+SamplerState      DofSpriteBudget_PrevS : register(s1);  // PointClamp
+
+// Step 3. One texel: sum what is left, then correct the cutoff for the next frame.
+// The controller is HDRDiffractionBudgetPS's, line for line, and deliberately so: it has been
+// measured on this project and its failure modes are written down.
+float4 DofSpriteBudgetPS(vtxOut IN) : SV_Target
+{
+	const int2   vSrcSize = (int2)vDofSpriteStats1.xy;
+	const float2 vInvSrc  = vDofSpriteStats0.xy;
+
+	float4 acc = 0;
+	[loop] for (int j = 0; j < vSrcSize.y; ++j)
+	{
+		[loop] for (int i = 0; i < vSrcSize.x; ++i)
+		{
+			acc += DofSpriteStats_Src.SampleLevel(DofSpriteStats_SrcS, ((float2)int2(i, j) + 0.5) * vInvSrc, 0);
+		}
+	}
+
+	const float fRaw   = acc.x;
+	const float fAbove = acc.y;
+	const float fSum   = acc.z;
+	const float fBelow = acc.w;
+
+	const float fPrevCut = DofSpriteBudget_Prev.SampleLevel(DofSpriteBudget_PrevS, float2(0.5, 0.5), 0).x;
+	const float fBudget  = vDofSpriteBudgetN.x;
+
+	const float kMinCut = 1e-6;
+
+	float fCut;
+
+	if (fBudget < 0.5 || fRaw <= fBudget)
+	{
+		// The budget is off, or the whole population fits: DECAY rather than snap to zero, so a
+		// frame that drops back under the budget fades its shapes in over a few frames. A scene
+		// that has always fitted sits at 0, and both consumers are then bit-identical to today.
+		fCut = fPrevCut * 0.5;
+		if (fCut < kMinCut)
+			fCut = 0.0;
+	}
+	else if (fPrevCut <= 0.0)
+	{
+		// Bootstrap two decades below the mean excess and climb: starting at the answer would cull
+		// half the frame in one frame, which is the pop this exists to avoid.
+		fCut = max(0.01 * fSum / max(fRaw, 1.0), kMinCut);
+	}
+	else if (fAbove <= fBudget && fAbove >= 0.8 * fBudget)
+	{
+		// Dead band, or the controller hunts around N every frame - over exactly the sources that
+		// are on the crossfade, i.e. it would flicker them.
+		fCut = fPrevCut;
+	}
+	else
+	{
+		// Asymmetric on purpose: react fast when there are too many (that is the frame-rate cliff
+		// arriving) and relax slowly when there are too few (that is only a missing bokeh shape).
+		const float fRatio = clamp(fAbove / max(fBudget, 1.0), 0.02, 100.0);
+		const float fStep  = (fRatio > 1.0) ? 0.5 : 0.15;
+		fCut = max(fPrevCut * pow(fRatio, fStep), kMinCut);
+	}
+
+	return float4(fCut, fRaw, fAbove, (fSum > 0.0) ? (fBelow / fSum) : 0.0);
+}
+
+technique DofSpriteWeight
+{
+  pass p0
+  {
+    VertexShader = FullscreenTriVS() PostMotionBlurVS;
+    PixelShader = DofSpriteWeightPS() PostMotionBlurPS;
+    CullMode = None;
+  }
+}
+
+technique DofSpriteSourceStats
+{
+  pass p0
+  {
+    VertexShader = FullscreenTriVS() PostMotionBlurVS;
+    PixelShader = DofSpriteSourceStatsPS() PostMotionBlurPS;
+    CullMode = None;
+  }
+}
+
+technique DofSpriteStatsReduce
+{
+  pass p0
+  {
+    VertexShader = FullscreenTriVS() PostMotionBlurVS;
+    PixelShader = DofSpriteStatsReducePS() PostMotionBlurPS;
+    CullMode = None;
+  }
+}
+
+technique DofSpriteBudget
+{
+  pass p0
+  {
+    VertexShader = FullscreenTriVS() PostMotionBlurVS;
+    PixelShader = DofSpriteBudgetPS() PostMotionBlurPS;
+    CullMode = None;
   }
 }
 
