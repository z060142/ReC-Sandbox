+		GetTexture2DLod(DofSpriteW_Depth, DofSpriteW_DepthS, float4(IN.baseTC.xy + vTap * float2( 1,  1), 0, 0)).x,
+		GetTexture2DLod(DofSpriteW_Depth, DofSpriteW_DepthS, float4(IN.baseTC.xy + vTap * float2( 1, -1), 0, 0)).x,
+		GetTexture2DLod(DofSpriteW_Depth, DofSpriteW_DepthS, float4(IN.baseTC.xy + vTap * float2(-1,  1), 0, 0)).x);
