+
+//////////////////////////////////////////////////////////////////////////////////////////////////
+// THE SPRITE BOKEH SOURCE BUDGET (S10, decisions/s10-sprite-bokeh-budget.md)
+//
+// The splat pass draws one sprite per grid cell over the highlight threshold, and a threshold does
+// not bound a population: under a physically lit frame "+2 stops over mid grey" is most of a
+// sunlit image, and each of those cells rasterizes a disc of up to
+// r_DepthOfFieldLensModelSplatMaxCoC native pixels into two blended RGBA16F targets. That is the
+// reported "sprite bokeh on, frame rate gone", and it is the same failure the wave glare had
+// before decisions/s8-glare-budget.md - measured there, fixed there, and never carried across to
+// this pass because the DOF's energy split was assumed to govern it. It governs where the light
+// GOES; it says nothing about how many sprites are drawn.
+//
+// Four passes, no CPU round trip in the hot path:
+//
+//   0. DofSpriteWeight       the grid -> (priority, weight, excess). THE weight, for both consumers.
+//   1. DofSpriteSourceStats  that -> 8x8 tiles: (raw, drawn, summed excess, excess handed back)
+//   2. DofSpriteStatsReduce  tiles -> a fixed 16x16
+//   3. DofSpriteBudget       16x16 -> one texel, and the cutoff for the NEXT frame
+//
+// The cutoff step 0 reads is the PREVIOUS frame's, which is the controller's one frame of lag (the
+// glare's, unchanged): a hard cut into a bright scene overshoots for two or three frames and then
+// settles. r_DepthOfFieldSpriteBokehDebug 2 prints the count, so it is observable rather than
+// theoretical.
+//////////////////////////////////////////////////////////////////////////////////////////////////
+
+// The first reduction block, in weight-map texels per axis.
+static const int kSpriteStatsTileSize = 8;
+// HARD CAP on the budget, enforced at the CONSUMER so no console value or config line can get past
+// it - the glare's own lesson (decisions/s8-glare-budget.md, addendum 2026-09-05: an unbounded
+// budget is what let Windows kill Sandbox as AppHangB1). A bokeh sprite is larger than a glare
+// sprite and lands in two blended targets, so this is deliberately the same 4096 and not more.
+static const int kSpriteMaxSourceBudget = 4096;
+
+CTexture* CDepthOfFieldStage::ExecuteSpriteBudget(const SDepthOfFieldParams& dofParams, const Vec4& vDofParams0, const Vec4& vDofParams1,
+                                                  const Vec4& vFieldPupil2, const Vec4& vLensModel, const Vec4& vLensModel2,
+                                                  const Vec4& vDownscaleHighlight, uint64 nLensRTMask, bool bSplat)
+{
+	const int nRequestedBudget = CRenderer::CV_r_DofSpriteBokehMaxSources;
+	const int nDebugMode       = CRenderer::CV_r_DofSpriteBokehDebug;
+
+	// No splat this frame: nothing to budget, and the targets are dropped so pure gather DOF
+	// (r_DepthOfFieldMode 1, the engine default) costs exactly what it always did.
+	if (!bSplat)
+	{
+		ReleaseSpriteBudgetTargets();
+		UpdateSpriteBudgetReport(0, 0, 0, 0, 0, false);
+		return nullptr;
+	}
+
+	CTexture* pSceneTarget = m_graphicsPipelineResources.m_pTexSceneTarget;
+	CTexture* pDepth       = m_graphicsPipelineResources.m_pTexLinearDepth;
+	CTexture* pHalfRes     = m_graphicsPipelineResources.m_pTexHDRTargetMaskedScaled[0][0];
+
+	if (!CTexture::IsTextureExist(pSceneTarget) || !CTexture::IsTextureExist(pDepth) || !CTexture::IsTextureExist(pHalfRes))
+		return nullptr;
+
+	// Sized to the DOWNSCALE's own target, not to the splat grid: the downscale is the other
+	// consumer and the energy split has to be exact against it. On the native splat grid
+	// (r_DepthOfFieldResolutionScale 1) four sprite cells therefore share one weight - see the
+	// decision file, "Native grid".
+	if (!AcquireSpriteBudgetTargets(pHalfRes->GetWidth(), pHalfRes->GetHeight()))
+		return nullptr;
+
+	PROFILE_LABEL_SCOPE("SPRITE BOKEH BUDGET");
+
+	const int nBudget = (nRequestedBudget <= 0) ? kSpriteMaxSourceBudget
+	                                            : min(nRequestedBudget, kSpriteMaxSourceBudget);
+
+	static CCryNameTSCRC techSpriteWeight("DofSpriteWeight");
+	static CCryNameTSCRC techSourceStats("DofSpriteSourceStats");
+	static CCryNameTSCRC techStatsReduce("DofSpriteStatsReduce");
+	static CCryNameTSCRC techBudget("DofSpriteBudget");
+	static CCryNameR dofFocusParam0Name("vDofParamsFocus0");
+	static CCryNameR dofFocusParam1Name("vDofParamsFocus1");
+	static CCryNameR dofFieldPupil2Name("vDofFieldPupil2");
+	static CCryNameR dofLensModelName("vDofLensModel");
+	static CCryNameR dofLensModel2Name("vDofLensModel2");
+	static CCryNameR dofBokehHighlightName("vDofBokehHighlight");
+	static CCryNameR spriteBudgetName("vDofSpriteBudget");
+	static CCryNameR spriteBudget2Name("vDofSpriteBudget2");
+	static CCryNameR spriteStats0Name("vDofSpriteStats0");
+	static CCryNameR spriteStats1Name("vDofSpriteStats1");
+	static CCryNameR spriteBudgetNName("vDofSpriteBudgetN");
+
+	CShader* pShader = CShaderMan::s_shPostDepthOfField;
+
+	const int nGridW = m_pTexSpriteWeight->GetWidth();
+	const int nGridH = m_pTexSpriteWeight->GetHeight();
+
+	// The texel THIS frame's weights are measured against: the one the controller wrote last
+	// frame. The chain below then writes the other half of the ping-pong.
+	CTexture* pPrev = m_pTexSpriteStats[m_nSpriteStatsIndex];
+
+	// -------- step 0: the weight map, the one number both consumers read --------
+	{
+		if (m_passSpriteWeight.IsDirty(nLensRTMask, pSceneTarget->GetTextureID(), pPrev->GetTextureID()))
+		{
+			m_passSpriteWeight.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+			m_passSpriteWeight.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+			m_passSpriteWeight.SetTechnique(pShader, techSpriteWeight, nLensRTMask);
+			m_passSpriteWeight.SetRenderTarget(0, m_pTexSpriteWeight);
+			m_passSpriteWeight.SetState(GS_NODEPTHTEST);
+			m_passSpriteWeight.SetTextureSamplerPair(0, pSceneTarget, EDefaultSamplerStates::PointClamp);
+			m_passSpriteWeight.SetTextureSamplerPair(1, pDepth, EDefaultSamplerStates::PointClamp);
+			m_passSpriteWeight.SetTextureSamplerPair(2, pPrev, EDefaultSamplerStates::PointClamp);
+			// The circle of confusion is derived here from the same helper the downscale uses,
+			// which reads the field curvature out of the per-view constants.
+			m_passSpriteWeight.SetRequirePerViewConstantBuffer(true);
+		}
+
+		// One quarter of a grid texel in this pass's UV: the four taps then land on exactly the
+		// four native texels of the cell, which is the set DofBokehRefVS thresholds.
+		const float fTapU = 0.25f / (float)max(nGridW, 1);
+		const float fTapV = 0.25f / (float)max(nGridH, 1);
+		const float fSkyWeight = clamp_tpl(CRenderer::CV_r_DofSpriteBokehSkyWeight, 0.0f, 1.0f);
+
+		// Native pixels of disc DIAMETER per unit of circle of confusion - the sprite's own scale
+		// (LensCoCUnitPixels x 2), so the sub-pixel cull in the weight pass is the sprite's cull
+		// and not a second, different one.
+		const float fFrameW = (float)m_graphicsPipelineResources.m_pTexHDRTarget->GetWidth();
+		const float fFrameH = (float)m_graphicsPipelineResources.m_pTexHDRTarget->GetHeight();
+		const float fDiameterPerUnit = 8.0f * max(fFrameW / 1920.0f, fFrameH / 1080.0f);
+
+		m_passSpriteWeight.BeginConstantUpdate();
+		m_passSpriteWeight.SetConstant(dofFocusParam0Name, vDofParams0, eHWSC_Pixel);
+		m_passSpriteWeight.SetConstant(dofFocusParam1Name, vDofParams1, eHWSC_Pixel);
+		m_passSpriteWeight.SetConstant(dofFieldPupil2Name, vFieldPupil2, eHWSC_Pixel);
+		m_passSpriteWeight.SetConstant(dofLensModelName, vLensModel, eHWSC_Pixel);
+		m_passSpriteWeight.SetConstant(dofLensModel2Name, vLensModel2, eHWSC_Pixel);
+		// The DOWNSCALE's packing of the highlight constant (threshold, knee, fade CoC, splat on),
+		// deliberately: this pass has to select the same cells the split hands energy over for.
+		m_passSpriteWeight.SetConstant(dofBokehHighlightName, vDownscaleHighlight, eHWSC_Pixel);
+		m_passSpriteWeight.SetConstant(spriteBudgetName, Vec4(1.0f, fSkyWeight, fTapU, fTapV), eHWSC_Pixel);
+		m_passSpriteWeight.SetConstant(spriteBudget2Name, Vec4(fDiameterPerUnit, 0.0f, 0.0f, 0.0f), eHWSC_Pixel);
+		m_passSpriteWeight.Execute();
+	}
+
+	// -------- steps 1-3: the cutoff controller, for the NEXT frame --------
+	m_nSpriteStatsIndex ^= 1;
+	CTexture* pCur = m_pTexSpriteStats[m_nSpriteStatsIndex];
+
+	const int nTileW = m_pTexSpriteTileStats->GetWidth();
+	const int nTileH = m_pTexSpriteTileStats->GetHeight();
+	const int nMidW  = m_pTexSpriteStatsMid->GetWidth();
+	const int nMidH  = m_pTexSpriteStatsMid->GetHeight();
+
+	if (m_passSpriteSourceStats.IsDirty(m_pTexSpriteWeight->GetTextureID()))
+	{
+		m_passSpriteSourceStats.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passSpriteSourceStats.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passSpriteSourceStats.SetTechnique(pShader, techSourceStats, 0);
+		m_passSpriteSourceStats.SetRenderTarget(0, m_pTexSpriteTileStats);
+		m_passSpriteSourceStats.SetState(GS_NODEPTHTEST);
+		m_passSpriteSourceStats.SetTextureSamplerPair(0, m_pTexSpriteWeight, EDefaultSamplerStates::PointClamp);
+	}
+
+	m_passSpriteSourceStats.BeginConstantUpdate();
+	m_passSpriteSourceStats.SetConstant(spriteStats0Name,
+	                                    Vec4(1.0f / (float)max(nGridW, 1), 1.0f / (float)max(nGridH, 1),
+	                                         (float)kSpriteStatsTileSize, (float)kSpriteStatsTileSize), eHWSC_Pixel);
+	m_passSpriteSourceStats.SetConstant(spriteStats1Name,
+	                                    Vec4((float)nGridW, (float)nGridH, (float)nTileW, (float)nTileH), eHWSC_Pixel);
+	m_passSpriteSourceStats.Execute();
+
+	const int nReduceX = (nTileW + nMidW - 1) / nMidW;
+	const int nReduceY = (nTileH + nMidH - 1) / nMidH;
+
+	if (m_passSpriteStatsReduce.IsDirty(m_pTexSpriteTileStats->GetTextureID()))
+	{
+		m_passSpriteStatsReduce.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passSpriteStatsReduce.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passSpriteStatsReduce.SetTechnique(pShader, techStatsReduce, 0);
+		m_passSpriteStatsReduce.SetRenderTarget(0, m_pTexSpriteStatsMid);
+		m_passSpriteStatsReduce.SetState(GS_NODEPTHTEST);
+		m_passSpriteStatsReduce.SetTextureSamplerPair(0, m_pTexSpriteTileStats, EDefaultSamplerStates::PointClamp);
+	}
+
+	m_passSpriteStatsReduce.BeginConstantUpdate();
+	m_passSpriteStatsReduce.SetConstant(spriteStats0Name,
+	                                    Vec4(1.0f / (float)max(nTileW, 1), 1.0f / (float)max(nTileH, 1),
+	                                         (float)nReduceX, (float)nReduceY), eHWSC_Pixel);
+	m_passSpriteStatsReduce.SetConstant(spriteStats1Name,
+	                                    Vec4((float)nTileW, (float)nTileH, (float)nMidW, (float)nMidH), eHWSC_Pixel);
+	m_passSpriteStatsReduce.Execute();
+
+	if (m_passSpriteBudget.IsDirty(m_pTexSpriteStatsMid->GetTextureID(), pPrev->GetTextureID(), pCur->GetTextureID()))
+	{
+		m_passSpriteBudget.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passSpriteBudget.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passSpriteBudget.SetTechnique(pShader, techBudget, 0);
+		m_passSpriteBudget.SetRenderTarget(0, pCur);
+		m_passSpriteBudget.SetState(GS_NODEPTHTEST);
+		m_passSpriteBudget.SetTextureSamplerPair(0, m_pTexSpriteStatsMid, EDefaultSamplerStates::PointClamp);
+		m_passSpriteBudget.SetTextureSamplerPair(1, pPrev, EDefaultSamplerStates::PointClamp);
+	}
+
+	m_passSpriteBudget.BeginConstantUpdate();
+	m_passSpriteBudget.SetConstant(spriteStats0Name,
+	                               Vec4(1.0f / (float)max(nMidW, 1), 1.0f / (float)max(nMidH, 1),
+	                                    (float)nMidW, (float)nMidH), eHWSC_Pixel);
+	m_passSpriteBudget.SetConstant(spriteStats1Name,
+	                               Vec4((float)nMidW, (float)nMidH, 1.0f, 1.0f), eHWSC_Pixel);
+	m_passSpriteBudget.SetConstant(spriteBudgetNName, Vec4((float)nBudget, 0.0f, 0.0f, 0.0f), eHWSC_Pixel);
+	m_passSpriteBudget.Execute();
+
+	UpdateSpriteBudgetReport(nDebugMode, nRequestedBudget, nBudget, nGridW, nGridH, true);
+
+	return m_pTexSpriteWeight;
+}
+
+bool CDepthOfFieldStage::AcquireSpriteBudgetTargets(int halfWidth, int halfHeight)
+{
+	const int w = max(halfWidth, 1);
+	const int h = max(halfHeight, 1);
+
+	if (m_pTexSpriteWeight && m_pTexSpriteTileStats && m_pTexSpriteStatsMid &&
+	    m_pTexSpriteStats[0] && m_pTexSpriteStats[1] &&
+	    m_spriteBudgetWidth == w && m_spriteBudgetHeight == h)
+		return true;
+
+	ReleaseSpriteBudgetTargets();
+
+	const uint32 flags = FT_NOMIPS | FT_DONT_STREAM | FT_USAGE_RENDERTARGET;
+	const std::string id = m_graphicsPipeline.GetUniqueIdentifierName();
+
+	// The weight map is fp16: it carries a priority and an excess, both HDR, and a weight in
+	// [0,1]. Precision there is irrelevant - the weight is a crossfade the eye reads over frames.
+	m_pTexSpriteWeight = CTexture::GetOrCreateRenderTarget(("$DofSpriteWeight" + id).c_str(),
+	                                                       w, h, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+
+	// The stats chain is RGBA32F and has to be: the middle targets carry a COUNT of up to half a
+	// million next to a summed HDR excess, and fp16 runs out of mantissa at 2048 - it would report
+	// a population of "65504" for anything large and be believed.
+	const int nTileW = (w + kSpriteStatsTileSize - 1) / kSpriteStatsTileSize;
+	const int nTileH = (h + kSpriteStatsTileSize - 1) / kSpriteStatsTileSize;
+	m_pTexSpriteTileStats = CTexture::GetOrCreateRenderTarget(("$DofSpriteTileStats" + id).c_str(),
+	                                                          nTileW, nTileH, Clr_Transparent, eTT_2D, flags, eTF_R32G32B32A32F);
+	m_pTexSpriteStatsMid  = CTexture::GetOrCreateRenderTarget(("$DofSpriteStatsMid" + id).c_str(),
+	                                                          16, 16, Clr_Transparent, eTT_2D, flags, eTF_R32G32B32A32F);
+	// FT_STAGE_READBACK on the 1x1 pair: a persistent staging resource is what makes the report's
+	// download two-phase instead of a pipeline stall.
+	const uint32 statsFlags = flags | FT_STAGE_READBACK;
+	m_pTexSpriteStats[0] = CTexture::GetOrCreateRenderTarget(("$DofSpriteStats0" + id).c_str(),
+	                                                         1, 1, Clr_Transparent, eTT_2D, statsFlags, eTF_R32G32B32A32F);
+	m_pTexSpriteStats[1] = CTexture::GetOrCreateRenderTarget(("$DofSpriteStats1" + id).c_str(),
+	                                                         1, 1, Clr_Transparent, eTT_2D, statsFlags, eTF_R32G32B32A32F);
+
+	if (!CTexture::IsTextureExist(m_pTexSpriteWeight) || !CTexture::IsTextureExist(m_pTexSpriteTileStats) ||
+	    !CTexture::IsTextureExist(m_pTexSpriteStatsMid) ||
+	    !CTexture::IsTextureExist(m_pTexSpriteStats[0]) || !CTexture::IsTextureExist(m_pTexSpriteStats[1]))
+	{
+		ReleaseSpriteBudgetTargets();
+		return false;
+	}
+
+	// A cutoff of zero is "no budget", which is the only safe thing for the first frame to read.
+	CClearSurfacePass::Execute(m_pTexSpriteStats[0], Clr_Transparent);
+	CClearSurfacePass::Execute(m_pTexSpriteStats[1], Clr_Transparent);
+	m_nSpriteStatsIndex = 0;
+
+	m_spriteBudgetWidth = w;
+	m_spriteBudgetHeight = h;
+	CryLog("[DOF] sprite bokeh budget targets acquired: %d x %d weight map, %d x %d tiles", w, h, nTileW, nTileH);
+	return true;
+}
+
+void CDepthOfFieldStage::ReleaseSpriteBudgetTargets()
+{
+	m_pTexSpriteWeight.reset();
+	// Not while a download is in flight: the staging resource is the target of a GPU copy that has
+	// not necessarily retired.
+	if (!m_pTexSpriteStatsInFlight)
+	{
+		m_pTexSpriteTileStats.reset();
+		m_pTexSpriteStatsMid.reset();
+		m_pTexSpriteStats[0].reset();
+		m_pTexSpriteStats[1].reset();
+		m_spriteBudgetWidth = 0;
+		m_spriteBudgetHeight = 0;
+	}
+}
+
+//////////////////////////////////////////////////////////////////////////////////////////////////
+// r_DepthOfFieldSpriteBokehDebug 2 - the population, said out loud once a second.
+//
+// The count is the one number that decides what this pass COSTS, and until now nothing on this
+// path counted anything: the user's only instrument was the frame rate. Sixteen bytes come back
+// from the GPU a second, two-phase, so nothing ever blocks; the GPU milliseconds come from the
+// pass's own PROFILE_LABEL_SCOPE via the render pipeline profiler, which this mode cannot switch
+// on and says so rather than printing a zero that would read as "free".
+//////////////////////////////////////////////////////////////////////////////////////////////////
+void CDepthOfFieldStage::UpdateSpriteBudgetReport(int nDebugMode, int nRequestedBudget, int nBudget,
+                                                  int nGridW, int nGridH, bool bInForce)
+{
+	const bool bWantReport = (nDebugMode == 2 || nDebugMode == 3) && bInForce;
+
+	if (!bWantReport)
+	{
+		if (!m_bSpriteReadbackIssued)
+		{
+			m_pTexSpriteStatsInFlight.reset();
+			m_bSpriteReadbackStalled = false;
+			m_fSpriteReadbackTime = 0.0f;
+		}
+		return;
+	}
+
+	if (gEnv->pTimer == nullptr)
+		return;
+
+	const float fNow = gEnv->pTimer->GetAsyncCurTime();
+
+	if (m_bSpriteReadbackIssued)
+	{
+		CTexture* pInFlight = m_pTexSpriteStatsInFlight;
+		CDeviceTexture* pDevTex = CTexture::IsTextureExist(pInFlight) ? pInFlight->GetDevTexture() : nullptr;
+		if (pDevTex == nullptr)
+		{
+			m_bSpriteReadbackIssued = false;
+			m_pTexSpriteStatsInFlight.reset();
+			return;
+		}
+
+		// Not signalled yet: come back next frame. The whole point of the two-phase download is
+		// that this never blocks.
+		if (!pDevTex->AccessCurrStagingResource(0, false))
+		{
+			if ((fNow - m_fSpriteReadbackTime) > 5.0f && !m_bSpriteReadbackStalled)
+			{
+				m_bSpriteReadbackStalled = true;
+				CryLogAlways("[DOF] sprite bokeh budget: the stats download has not signalled in 5 s - no reports");
+			}
+			return;
+		}
+		m_bSpriteReadbackStalled = false;
+
+		float fCutoff = 0.0f, fRaw = 0.0f, fDrawn = 0.0f, fResidualFrac = 0.0f;
+		const auto statsData = [&fCutoff, &fRaw, &fDrawn, &fResidualFrac](void* pData, uint32 rowPitch, uint32 slicePitch) -> bool
+		{
+			const float* pTexel = static_cast<const float*>(pData);
+			fCutoff = pTexel[0];
+			fRaw = pTexel[1];
+			fDrawn = pTexel[2];
+			fResidualFrac = pTexel[3];
+			return true;
+		};
+		pDevTex->AccessCurrStagingResource(0, false, statsData);
+
+		m_bSpriteReadbackIssued = false;
+		m_pTexSpriteStatsInFlight.reset();
+		// Time the cadence from the REPORT, not from the request, so a slow fence cannot turn this
+		// into a per-frame download.
+		m_fSpriteReadbackTime = fNow;
+
+		// The unit every "stops" figure is in: 0.18 on the scene-referred path because the frame is
+		// pre-exposed, and 0.18 / the tone map's own exposure off it (S9). Zero means the stock
+		// measurement was not available this frame, in which case the threshold itself fell back to
+		// its absolute reading and the report says so instead of printing stops over a mid grey
+		// that is not the one in force.
+		const float fMidGrey = CRendererResources::IsSceneReferredStage(5)
+		                       ? CRendererResources::kSceneReferredMidGrey
+		                       : CRendererResources::GetStockMidGrey();
+		const float fReportGrey = (fMidGrey > 0.0f) ? fMidGrey : CRendererResources::kSceneReferredMidGrey;
+		const float fInvLn2 = 1.0f / logf(2.0f);
+
+		float fSplatMs = -1.0f, fBudgetMs = -1.0f;
+		if (gcpRendD3D != nullptr)
+		{
+			const DynArray<RPProfilerDetailedStats>* pStats = gcpRendD3D->GetRPPDetailedStatsArray(false);
+			if (pStats != nullptr)
+			{
+				for (const RPProfilerDetailedStats& stat : *pStats)
+				{
+					if (strcmp(stat.name, "HIGHLIGHT SPLATS") == 0)
+						fSplatMs = stat.gpuTimeSmoothed;
+					else if (strcmp(stat.name, "SPRITE BOKEH BUDGET") == 0)
+						fBudgetMs = stat.gpuTimeSmoothed;
+				}
+			}
+		}
+
+		const float fSpriteCapPx = max(CRenderer::CV_r_DofLensModelSplatMaxCoC, 1.0f);
+
+		CryLog("[DOF] ---- sprite bokeh sources, once a second (r_DepthOfFieldSpriteBokehDebug 2) ----");
+		CryLog("[DOF]   SOURCES: raw above the highlight threshold = %.0f of the %d x %d grid"
+		       " -- one sprite each, up to %.0f x %.0f native px per sprite (r_DepthOfFieldLensModelSplatMaxCoC)",
+		       fRaw, nGridW, nGridH, fSpriteCapPx, fSpriteCapPx);
+		CryLog("[DOF]            budget %d (r_DepthOfFieldSpriteBokehMaxSources): %.0f drew a shaped disc,"
+		       " cutoff %.4g = %+.1f stops over mid grey -- the other %.0f kept their LIGHT (%.1f%% of the"
+		       " source excess, handed back to the GATHER and blurred there) and lost their shape",
+		       nBudget, fDrawn, fCutoff,
+		       (fCutoff > 1e-12f) ? (logf(fCutoff / fReportGrey) * fInvLn2) : -99.0f,
+		       max(fRaw - fDrawn, 0.0f), fResidualFrac * 100.0f);
+		if (fCutoff <= 0.0f)
+		{
+			CryLog("[DOF]            cutoff 0 = the budget is NOT binding: the whole population fits, and both"
+			       " the downscale's energy split and the splat are bit-identical to the un-budgeted pass");
+		}
+		if (nRequestedBudget != nBudget)
+		{
+			CryLog("[DOF]            r_DepthOfFieldSpriteBokehMaxSources %d was CLAMPED to %d: %s",
+			       nRequestedBudget, nBudget,
+			       (nRequestedBudget <= 0)
+			       ? "0 does not mean unlimited here - unlimited is the bug this budget exists for"
+			       : "beyond a few thousand shaped discs the picture stops changing and only the frame time grows");
+		}
+		const float fSkyWeight = clamp_tpl(CRenderer::CV_r_DofSpriteBokehSkyWeight, 0.0f, 1.0f);
+		CryLog("[DOF]            sky weight %.2f (r_DepthOfFieldSpriteBokehSkyWeight): a cell at the far plane"
+		       " enters that cutoff at %.2f of its excess, so a practical in the scene wins a slot over a sky"
+		       " texel of the same brightness. Priority only -- a losing cell keeps every bit of its light in"
+		       " the gather, so the frame's total does not move with this number",
+		       fSkyWeight, fSkyWeight);
+		if (fSplatMs >= 0.0f)
+		{
+			CryLog("[DOF]            GPU %.2f ms in the splat draw + %.2f ms in the budget's own passes,"
+			       " for %.0f sprites (%.1f us each)",
+			       fSplatMs, max(fBudgetMs, 0.0f), fDrawn,
+			       (fDrawn > 0.5f) ? (1000.0f * fSplatMs / fDrawn) : 0.0f);
+		}
+		else
+		{
+			CryLog("[DOF]            GPU time not measured: the render pipeline profiler is not recording."
+			       " Set r_profiler 1 (or r_DisplayInfo 3) to put the splat's milliseconds on this line.");
+		}
+		if (fMidGrey <= 0.0f)
+		{
+			CryLog("[DOF]            NOTE: the stock path's mid grey is not measured this frame, so the"
+			       " highlight threshold is being read as an ABSOLUTE value and the stops above are nominal");
+		}
+		return;
+	}
+
+	if (m_fSpriteReadbackTime > 0.0f && (fNow - m_fSpriteReadbackTime) < 1.0f)
+		return;
+
+	// Our own target, downloadable where it stands - no blit.
+	CTexture* pStatsTex = m_pTexSpriteStats[m_nSpriteStatsIndex];
+	if (!CTexture::IsTextureExist(pStatsTex) || pStatsTex->GetDevTexture() == nullptr)
+		return;
+
+	if (m_fSpriteReadbackTime <= 0.0f)
+		CryLog("[DOF] sprite bokeh budget report armed (one line group a second)");
+
+	pStatsTex->GetDevTexture()->DownloadToStagingResource(0);
+	m_pTexSpriteStatsInFlight = pStatsTex;
+	m_bSpriteReadbackIssued = true;
+	m_fSpriteReadbackTime = fNow;
 }
 
