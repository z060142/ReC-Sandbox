index def383cf..10c1ec2c 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -66,6 +66,19 @@ const size_t kBakeCascadeMaxPlates = 16;
 //! ping pong between two overlapping plates starts.
 const uint32 kBakeCascadeQuietFrames = 3;
 
+//! P14, the move batch. Plates whose move still owes a restore of the OLD footprint and a re-bake at the
+//! new one. Moving SEVERAL baking plates in one gesture is the case this exists for: each plate finishing
+//! its move on its own would do restore-old -> capture-new -> bake-new while the others still hold their
+//! old bakes in the ground, so with overlapping footprints (old OR new) the baselines are captured out of
+//! a terrain that is half unwound, and the old footprint of one plate can be resurrected as "ground" by
+//! the next plate's restore - the terrain left behind at the old location. Collecting the movers and
+//! running ONE ordered cascade over all of them is the only ordering that is well defined.
+std::vector<CTerrainPlateComponent*> g_bakeMoveBatch;
+//! Frame of the last plate that joined. The batch runs on the first frame after that, which is what makes
+//! it collect every plate of one gesture: a multi selection sends all its XFORM_FINISHED_EDITOR events in
+//! one frame, and a group (whose children get no such event at all) settles all its children in one frame.
+uint32 g_bakeMoveBatchFrameId = 0;
+
 //! Safety valve for the probe repair loop. A bake repair is a user visible cost (a mesh regeneration, a
 //! SetTerrainElevation, a sector rebuild), so a configuration that repairs itself over and over has to
 //! say so and then stop doing it at full rate, rather than eat the frame time in silence. The plate is
@@ -236,6 +249,27 @@ int CTerrainPlateComponent::GetSettleFrames()
 	return max(0, g_terrainPlateSettleFrames);
 }
 
+bool CTerrainPlateComponent::WantsBakeMoveBatch() const
+{
+	// A plate that does not write the terrain has no footprint to unwind and no ordering to respect, so it
+	// keeps the plain path. A torn down plate must not bake again at all (report 18, B2).
+	return m_bBakeIntoTerrain && !m_bBakeTornDown && m_pEntity != nullptr;
+}
+
+int CTerrainPlateComponent::GetEffectiveSettleFrames() const
+{
+	if (WantsBakeMoveBatch())
+	{
+		// A baking plate can never take the immediate path: whatever moved it, its old footprint is still
+		// in the ground and has to be restored together with every other plate that moved in the same
+		// gesture. So the deferral is mandatory here, e_TerrainPlateSettleFrames 0 cannot switch it off,
+		// and Update During Drag only means "wait one frame", not "do it now".
+		return m_bUpdateDuringDrag ? 1 : max(1, GetSettleFrames());
+	}
+
+	return GetSettleFrames();
+}
