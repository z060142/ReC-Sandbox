+void CTerrainPlateComponent::FlushBakeMoveBatch()
+{
+	if (g_bakeMoveBatch.empty() || g_bakeCascadeDepth > 0)
+		return;
+
+	// Wait for anything that is still mid-gesture. Component update order is whatever the entity system
+	// happened to register, so "one frame after the last join" on its own would let the plate that ticks
+	// first run the batch in the same frame a straggler is about to join it. This makes the rule order
+	// independent: no baking plate anywhere is still holding a transform it has not handed over. It cannot
+	// hang - JoinBakeMoveBatch pulls every such plate's settle forward to the next tick, and a baking
+	// plate's settle window is always at least one frame (@see GetEffectiveSettleFrames).
+	for (CTerrainPlateComponent* pOther : g_terrainPlates)
+	{
+		if (pOther->m_bDeferredXformPending && pOther->WantsBakeMoveBatch())
+			return;
+	}
+
+	// Drain the queue first: everything below regenerates meshes and writes the terrain, and must not be
+	// able to re-enter the batch it is draining.
+	std::vector<CTerrainPlateComponent*> movers;
+	movers.swap(g_bakeMoveBatch);
+
+	for (CTerrainPlateComponent* pMover : movers)
+	{
+		pMover->m_bBakeMoveBatchPending = false;
+
+		// The flag is one of the reasons a plate subscribes to ENTITY_EVENT_UPDATE, so a plate that only
+		// ticks because of it has to be allowed to stop ticking again.
+		if (pMover->m_pEntity != nullptr)
+		{
+			pMover->m_pEntity->UpdateComponentEventMask(pMover);
+		}
+	}
+
+	// The set is the union of each mover's cascade closure. A mover's closure is taken from BOTH the
+	// footprint it still holds and the one it is about to take (@see GetBakeCascadeRects), so a plate that
+	// only touches the ground a mover is leaving, and a plate that only touches the ground a mover is
+	// landing on, are both unwound with it. A mover that overlaps nothing at all is still its own closure
+	// of one, which is what guarantees its old footprint is restored rather than orphaned.
+	std::vector<CTerrainPlateComponent*> affected;
+	std::vector<CTerrainPlateComponent*> closure;
+
+	for (CTerrainPlateComponent* pMover : movers)
+	{
+		if (!pMover->WantsBakeMoveBatch())
+			continue;
+
+		pMover->CollectBakeCascadeSet(closure);
+
+		for (CTerrainPlateComponent* pPlate : closure)
+		{
+			if (affected.size() >= kBakeCascadeMaxPlates)
+				break;
+
+			if (std::find(affected.begin(), affected.end(), pPlate) == affected.end())
+			{
+				affected.push_back(pPlate);
+			}
+		}
+	}
+
+	if (affected.empty())
+		return;
+
+	// One ordered unwind for the whole gesture: restore every old footprint (descending priority, from the
+	// stored baselines), regenerate every mesh, re-capture every baseline at the new footprint, re-bake
+	// (ascending priority), then the composite refresh of report 18 B3. RunBakeCascade is the same driver
+	// the single plate overlap cascade uses - there is deliberately no second implementation.
+	RunBakeCascade(affected, nullptr, "move batch");
+}
