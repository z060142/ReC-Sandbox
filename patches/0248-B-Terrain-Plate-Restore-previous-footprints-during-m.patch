+void CTerrainPlateComponent::JoinBakeMoveBatch()
+{
+	if (m_bBakeMoveBatchPending)
+	{
+		// Already queued. Do NOT re-stamp the batch frame here: a plate that keeps being nudged would
+		// otherwise push the flush out for ever and the old footprint would sit in the ground indefinitely.
+		return;
+	}
+
+	m_bBakeMoveBatchPending = true;
+	g_bakeMoveBatch.push_back(this);
+	g_bakeMoveBatchFrameId = gEnv->nMainFrameID;
+
+	// Everything else that is still holding a deferred transform belongs to the same gesture as far as the
+	// terrain is concerned, and has to land in THIS batch rather than form a second one that would restore
+	// its old footprints after ours have already been re-baked over. This is the mixed selection: a plain
+	// plate gets ENTITY_EVENT_XFORM_FINISHED_EDITOR on mouse up and joins immediately, while a plate inside
+	// a GROUP gets no such event and is still counting settle frames (SelectionGroup.cpp:646-668 only sends
+	// it to the selected OBJTYPE_ENTITY objects, and the selected object of a group move is the group). So
+	// their settle is pulled forward to the next tick, and the flush - one frame after the last join -
+	// waits for them by construction.
+	for (CTerrainPlateComponent* pOther : g_terrainPlates)
+	{
+		if (pOther == this || !pOther->m_bDeferredXformPending || !pOther->WantsBakeMoveBatch())
+			continue;
+
+		pOther->m_lastXformFrameId = gEnv->nMainFrameID - (uint32)max(1, pOther->GetEffectiveSettleFrames());
 	}
 }
 
+void CTerrainPlateComponent::LeaveBakeMoveBatch()
+{
+	m_bBakeMoveBatchPending = false;
+
+	auto it = std::find(g_bakeMoveBatch.begin(), g_bakeMoveBatch.end(), this);
+	if (it != g_bakeMoveBatch.end())
+	{
+		g_bakeMoveBatch.erase(it);
+	}
+}
