+CSceneReferredExport::CSceneReferredExport()
+	: m_state(eState_Idle)
+	, m_tap(eSceneReferredExportTap_Graded)
+	, m_encoding(eSceneReferredExportEncoding_ACES2065)
+	, m_frameIndex(0)
+	, m_nextSlot(0)
