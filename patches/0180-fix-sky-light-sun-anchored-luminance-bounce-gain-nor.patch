diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
index cce75f95..482101ac 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
@@ -847,7 +847,12 @@ void CLPVStage::ExecuteResolve(const SScopedComputeCommandList& commandList, CTe
 	Vec3 deltaCells(ZERO);
 	if (m_bHistoryValid)
 		deltaCells = (m_gridOrigin - m_prevGridOrigin) / m_cellSize;
-	const float bounceGain = m_bHistoryValid ? max(0.0f, CRendererCVars::CV_r_LPVSecondaryBounce) : 0.0f;
+	// Normalized so that r_LPVSecondaryBounce is directly the feedback loop gain: 0.0705 is the
+	// SH round trip of one feedback step (iso receiver transfer 0.25 x emission projection C0),
+	// so a cvar value of 1 re-emits exactly the irradiance the cell received (a physical single
+	// bounce, marginally stable on white scenes). Empirically confirmed: the pre-normalization
+	// equilibrium was found at a raw gain of ~13, and 13 x 0.0705 = 0.92 - right at loop gain 1.
+	const float bounceGain = m_bHistoryValid ? max(0.0f, CRendererCVars::CV_r_LPVSecondaryBounce) / 0.0705f : 0.0f;
 
 	static CCryNameR paramResolve2("LPVResolveParams2");
 	pass.SetConstant(paramResolve2, Vec4(deltaCells.x, deltaCells.y, deltaCells.z, bounceGain));
@@ -862,18 +867,28 @@ void CLPVStage::ExecuteResolve(const SScopedComputeCommandList& commandList, CTe
 	static CCryNameR paramWorldToRsm("LPVWorldToRsm");
 	pass.SetConstant(paramWorldToRsm, m_worldToRsm);
 
-	// Sky light, premultiplied so that r_LPVSkyLight is the irradiance an upward facing outdoor
-	// surface ends up with in units of the sky colour, independent of the display intensity:
-	// the apply pass computes dot(cosineLobe(down) * sky, cosineLobe(down)) * intensity, and
-	// dot(cosineLobe(d), cosineLobe(d)) = (ZH_COS0 * SH_C0)^2 + (ZH_COS1 * SH_C1)^2 = 0.3125.
+	// Sky light, premultiplied so that r_LPVSkyLight 1 gives an upward facing outdoor surface an
+	// irradiance of 0.2 x the sun luminance (in the sky hue), independent of the display intensity.
+	// The luminance is anchored to the sun instead of the raw TOD sky colour: levels that drive
+	// their ambient through environment probes can have a near black GetSkyColor(), which silently
+	// disabled the whole feature (observed: r_LPVSkyLight 0 vs 1000 indistinguishable). shTransfer
+	// is the apply side SH transfer of the injected lobe mix (0.6 x downward cosine lobe self dot
+	// 0.3125 + 0.4 x isotropic transfer 0.0705 = 0.2157).
 	Vec3 skyPremult(ZERO);
 	const float skyGain = max(0.0f, CRendererCVars::CV_r_LPVSkyLight);
 	if (skyGain > 0.0f && gEnv->p3DEngine)
 	{
+		const Vec3 lumWeights(0.2126f, 0.7152f, 0.0722f);
 		const Vec3 skyColor = gEnv->p3DEngine->GetSkyColor();
-		const float shTransfer = 0.3125f;
+		const Vec4 sunColor = RenderView()->GetSunLightColor();
+		const float lumSky = skyColor.Dot(lumWeights);
+		const float lumSun = Vec3(sunColor.x, sunColor.y, sunColor.z).Dot(lumWeights);
+		// Hue of the TOD sky, normalized to unit luminance; neutral cool fallback when it is black.
+		const Vec3 tint = (lumSky > 1e-4f) ? skyColor / lumSky : Vec3(0.6f, 0.8f, 1.0f) / 0.7719f;
+		const Vec3 skyEffective = tint * (lumSun * 0.2f);
+		const float shTransfer = 0.2157f;
 		const float displayIntensity = max(1.0f, CRendererCVars::CV_r_LPVIntensity);
-		skyPremult = skyColor * (skyGain / (shTransfer * displayIntensity));
+		skyPremult = skyEffective * (skyGain / (shTransfer * displayIntensity));
 	}
 
 	if (CRendererCVars::CV_r_LPVDebug > 0)
@@ -1073,7 +1088,8 @@ void CLPVStage::ExecuteApply(const SScopedComputeCommandList& commandList, CText
 	pass.SetConstant(paramFrustumRB, Vec4(viewInfo.m_frustumCorners[SRenderViewInfo::eFrustum_RB], 0.0f));
 
 	static CCryNameR paramApply("LPVApplyParams");
-	pass.SetConstant(paramApply, Vec4(CRendererCVars::CV_r_LPVIntensity, (float)CRendererCVars::CV_r_LPVDebug, 0.0f, 0.0f));
+	pass.SetConstant(paramApply, Vec4(CRendererCVars::CV_r_LPVIntensity, (float)CRendererCVars::CV_r_LPVDebug,
+	                                  max(0.0f, CRendererCVars::CV_r_LPVMaxIrradiance), 0.0f));
 
 	static CCryNameR paramRsmSizeApply("LPVRsmSize");
 	pass.SetConstant(paramRsmSizeApply, Vec4((float)m_rsmSize, 1.0f / (float)m_rsmSize, (float)CRendererCVars::CV_r_LPVDebug, 0.0f));
diff --git a/Engine/Shaders/HWScripts/CryFX/LPV.cfi b/Engine/Shaders/HWScripts/CryFX/LPV.cfi
index e67c2cd3..6c39f3a2 100644
--- a/Engine/Shaders/HWScripts/CryFX/LPV.cfi
+++ b/Engine/Shaders/HWScripts/CryFX/LPV.cfi
@@ -28,7 +28,8 @@ float4 LPVRsmSize;
 float4 LPVSunDir;
 // rgb: sun colour, w: intensity calibration for the secondary bounce feedback
 float4 LPVSunColor;
-// x: GI intensity multiplier, y: debug mode (0 off, 1 grid uv, 2 raw L0, 3 edge fade)
+// x: GI intensity multiplier, y: debug mode (0 off, 1 grid uv, 2 raw L0, 3 edge fade),
+// z: soft luminance rolloff ceiling of the applied irradiance (0 disables)
 float4 LPVApplyParams;
 // xy: screen size, zw: 1 / screen size
 float4 LPVScreenSize;
@@ -461,8 +462,11 @@ void LPVResolveCS(uint3 DTid : SV_DispatchThreadID)
 
 		if (skyVisible)
 		{
-			// The sky flux travels into the lower hemisphere.
-			const float4 skySH = LPVCosineLobe(float3(0.0f, 0.0f, -1.0f));
+			// 60% downward cosine lobe (sky flux travels into the lower hemisphere) + 40% isotropic:
+			// a pure downward lobe barely propagates sideways, so almost nothing entered interiors
+			// through vertical openings like windows. The CPU side shTransfer accounts for this mix.
+			const float4 skySH = LPVCosineLobe(float3(0.0f, 0.0f, -1.0f)) * 0.6f
+			                   + float4(LPV_SH_C0 * 0.4f, 0.0f, 0.0f, 0.0f);
 			shR += skySH * LPVSkyColor.r;
 			shG += skySH * LPVSkyColor.g;
 			shB += skySH * LPVSkyColor.b;
@@ -827,6 +831,17 @@ void LPVApplyCS(uint3 DTid : SV_DispatchThreadID)
 			irradiance.b = max(0.0f, dot(shB, receiver));
 
 			irradiance *= fade * LPVApplyParams.x;
+
+			// Soft highlight rolloff (Reinhard on luminance): the dim indirect response stays
+			// linear while hot spots (sun facing white walls, outdoor single bounce paths) are
+			// compressed towards the r_LPVMaxIrradiance ceiling - a high intensity can brighten
+			// the interiors without overexposing the outdoors.
+			const float maxIrradiance = LPVApplyParams.z;
+			[branch] if (maxIrradiance > 0.0f)
+			{
+				const float lum = dot(irradiance, float3(0.2126f, 0.7152f, 0.0722f));
+				irradiance *= maxIrradiance / (maxIrradiance + lum);
+			}
 		}
 	}
 
