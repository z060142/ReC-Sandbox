-float CTerrainPlateComponent::GetCommitWeightAtWorld(float /*worldX*/, float /*worldY*/) const
+bool CTerrainPlateComponent::GetCommitAppearanceFootprint(int& outX1, int& outY1, int& outSize) const
 {
-	// Step 2 (appearance stamp). Declared now so that adding it later does not move the vtable.
-	return 0.f;
+	// Deliberately NOT m_bakeRect*: the appearance commit is its own operation and must work on a plate
+	// that never baked, on one whose height was already committed (m_bBakeApplied is false by then), and
+	// on one that is baking right now. The rect it wants is the one the plate covers TODAY, which is
+	// exactly what ComputeBakeRect answers from the current transform. Sector alignment comes along for
+	// free and is what UpdateEngineTerrain wants for the surface bit push anyway.
+	const SBakeTerrainMetrics metrics = GetBakeTerrainMetrics();
+	if (!metrics.IsValid())
+		return false;
+
+	return ComputeBakeRect(metrics, GetPlateWorldTM(), outX1, outY1, outSize);
 }
 
-bool CTerrainPlateComponent::GetCommitAlbedoAtWorld(float /*worldX*/, float /*worldY*/, ColorB& /*outColor*/) const
+float CTerrainPlateComponent::GetCommitWeightAtWorld(float worldX, float worldY, float sampleSizeMeters) const
 {
-	// Step 2 (appearance stamp).
-	return false;
+	// THE rim weight, and the reason colour, layer weights and height fade together: this is the very
+	// expression ComputeBakeBlock evaluates per terrain cell (see the block around the distanceToBorder /
+	// band / smoothstep lines there), reading the same knobs - Weld Inner Falloff, the plate's world
+	// scale, e_TerrainPlateBakeWeldCurve, e_TerrainPlateBakeEdgeAA. It is a closed form in plate local
+	// coordinates, so it can be asked at ANY sample rate; only the C1 coverage term is an area measure,
+	// and sampleSizeMeters is the area to measure it over (one terrain cell for the layer stamp, one RGB
+	// texel for the colour stamp).
+	const SBakeTerrainMetrics metrics = GetBakeTerrainMetrics();
+	if (!metrics.IsValid())
+		return 0.f;
+
+	const Matrix34 worldTM = GetPlateWorldTM();
+
+	float centreZ = 0.f, localX = 0.f, localY = 0.f;
+	if (!SamplePlateSurface(worldTM, worldX, worldY, centreZ, localX, localY))
+		return 0.f;   // outside the rotated plate, exactly as the bake decides it per cell
+
+	const Vec3 worldScale = GetWorldScale();
+
+	// Same band as ComputeBakeBlock, including the one-cell minimum: a falloff of 0 must still meet the
+	// baseline at the border rather than step to it.
+	const float minBandLocal = clamp_tpl(metrics.unitSize / max(0.0001f, 0.5f * min(worldScale.x, worldScale.y)), 0.f, 1.f);
+	const float band = clamp_tpl(max((float)m_weldInnerFalloff, minBandLocal), 0.0001f, 1.f);
+
+	const float distanceToBorder = min(0.5f - fabs_tpl(localX), 0.5f - fabs_tpl(localY)) * 2.f;
+	const float t = clamp_tpl(distanceToBorder / band, 0.f, 1.f);
+	float weight = (g_terrainPlateBakeWeldCurve != 0)
+	               ? (t * t * (3.f - 2.f * t))            // smoothstep(t), the mesh weld's 1 - smoothstep(t) inverted
+	               : (1.f - cosf(gf_PI * t)) * 0.5f;      // the road falloff
+
+	// C1: the plan view boundary is a coverage, not a boolean. Reproduced with the same supersample grid
+	// the bake uses, over the caller's own footprint - so at sampleSizeMeters == unitSize this returns
+	// bit for bit what ComputeBakeBlock computed for that cell, and at texel size it degenerates to a
+	// sub-texel antialias of the same boundary.
+	if (g_terrainPlateBakeEdgeAA != 0 && sampleSizeMeters > 0.f)
+	{
+		const float meshSpacing = (m_lastGridX > 1 && m_lastGridY > 1)
+		                          ? min(worldScale.x / (float)(m_lastGridX - 1), worldScale.y / (float)(m_lastGridY - 1))
+		                          : metrics.unitSize;
+		const int   samplesPerAxis = clamp_tpl((int)(sampleSizeMeters / max(0.0001f, meshSpacing)) + 1, 4, 6);
+		const float sampleStep = sampleSizeMeters / (float)(samplesPerAxis - 1);
+
+		int samplesTaken = 0;
+		for (int sx = 0; sx < samplesPerAxis; ++sx)
+		{
+			for (int sy = 0; sy < samplesPerAxis; ++sy)
+			{
+				const float px = worldX - sampleSizeMeters * 0.5f + (float)sx * sampleStep;
+				const float py = worldY - sampleSizeMeters * 0.5f + (float)sy * sampleStep;
+
+				float z, ignoreX, ignoreY;
+				if (SamplePlateSurface(worldTM, px, py, z, ignoreX, ignoreY))
+					++samplesTaken;
+			}
+		}
+
+		const int totalSamples = samplesPerAxis * samplesPerAxis;
+		weight *= clamp_tpl((float)samplesTaken / (float)totalSamples, 0.f, 1.f);
+	}
+
+	return clamp_tpl(weight, 0.f, 1.f);
+}
+
+bool CTerrainPlateComponent::GetCommitAlbedoAtWorld(float worldX, float worldY, ColorB& outColor) const
+{
+	// The colour source, stated plainly: the plate's own material's DIFFUSE texture, read through
+	// ITexture::GetLowResSystemCopy - the CPU side copy the renderer keeps of every streamed texture, at
+	// most 32 x 32 (ITexture.h:497). That is not a shortcut invented here: it is the exact source
+	// CRYENGINE's own terrain colour synthesis uses for the same job
+	// (CImagePainter::CalculateBaseColorFromSurfaceInfo, ImagePainter.cpp:408-436, the
+	// e_TerrainAutoGenerateBaseTexture path). There is no CPU readable full resolution copy of a streamed
+	// GPU texture to sample instead, and the terrain macro texture is a low frequency base that the
+	// terrain's own detail materials multiply over anyway, so a 32 x 32 average of the plate's albedo is
+	// the right band of the signal to stamp - the detail comes back from the Commit Layer's material.
+	if (gEnv == nullptr || gEnv->p3DEngine == nullptr)
+		return false;
+
+	IMaterialManager* pMaterialManager = gEnv->p3DEngine->GetMaterialManager();
+	if (pMaterialManager == nullptr)
+		return false;
+
+	IMaterial* pMaterial = nullptr;
+	if (!m_materialPath.value.empty())
+		pMaterial = pMaterialManager->LoadMaterial(m_materialPath.value, false);
+	if (pMaterial == nullptr && m_pStatObj != nullptr)
+		pMaterial = m_pStatObj->GetMaterial();
+	if (pMaterial == nullptr)
+		return false;
+
+	// A multi sub material has no shader item of its own worth sampling; take the first sub material,
+	// which is what a plate built from one grid mesh actually renders with.
+	if (pMaterial->GetSubMtlCount() > 0 && pMaterial->GetSubMtl(0) != nullptr)
+		pMaterial = pMaterial->GetSubMtl(0);
+
+	const SShaderItem& shaderItem = pMaterial->GetShaderItem();
+	if (shaderItem.m_pShaderResources == nullptr)
+		return false;
+
+	SEfResTexture* pResTexture = shaderItem.m_pShaderResources->GetTexture(EFTT_DIFFUSE);
+	ITexture* pTexture = (pResTexture != nullptr) ? pResTexture->m_Sampler.m_pITex : nullptr;
+
+	const ColorF diffuse = shaderItem.m_pShaderResources->GetColorValue(EFTT_DIFFUSE);
+
+	// Where on the plate: the same inverse transform the bake uses, then the mesh's own UV mapping.
+	// RegenerateMesh gives the vertex at local (-0.5 + c/(nx-1), 0.5 - r/(ny-1)) the UV (c/(nx-1),
+	// r/(ny-1)) with the mirror flags applied to the SAMPLING coordinate, so the inverse is exactly this.
+	float centreZ = 0.f, localX = 0.f, localY = 0.f;
+	if (!SamplePlateSurface(GetPlateWorldTM(), worldX, worldY, centreZ, localX, localY))
+		return false;
+
+	float u = clamp_tpl(localX + 0.5f, 0.f, 1.f);
+	float v = clamp_tpl(0.5f - localY, 0.f, 1.f);
+	if (m_bMirrorX) u = 1.f - u;
+	if (m_bMirrorY) v = 1.f - v;
+
+	ColorF albedo(1.f, 1.f, 1.f, 1.f);
+
+	if (pTexture != nullptr)
+	{
+		uint16 textureWidth = 0, textureHeight = 0;
+		int*   pLowResSystemCopyAtlasId = nullptr;
+		const ColorB* pTexRgb = pTexture->GetLowResSystemCopy(textureWidth, textureHeight, &pLowResSystemCopyAtlasId);
+
+		if (pTexRgb == nullptr || textureWidth == 0 || textureHeight == 0)
+			return false;   // a material the CPU cannot sample: the caller falls back to the flat tint
+
+		// Bilinear, wrapping, in the texture's own (gamma) space - the same space the RGB layer stores.
+		const float fx = u * (float)textureWidth - 0.5f;
+		const float fy = v * (float)textureHeight - 0.5f;
+		const int   x0 = (int)floorf(fx);
+		const int   y0 = (int)floorf(fy);
+		const float rx = fx - (float)x0;
+		const float ry = fy - (float)y0;
+
+		const auto texel = [pTexRgb, textureWidth, textureHeight](int x, int y)
+		{
+			const int wx = ((x % (int)textureWidth) + (int)textureWidth) % (int)textureWidth;
+			const int wy = ((y % (int)textureHeight) + (int)textureHeight) % (int)textureHeight;
+			const ColorB& c = pTexRgb[wx + wy * (int)textureWidth];
+			return ColorF((float)c.r / 255.f, (float)c.g / 255.f, (float)c.b / 255.f, 1.f);
+		};
+
+		const ColorF top = texel(x0, y0) * (1.f - rx) + texel(x0 + 1, y0) * rx;
+		const ColorF bottom = texel(x0, y0 + 1) * (1.f - rx) + texel(x0 + 1, y0 + 1) * rx;
+		albedo = top * (1.f - ry) + bottom * ry;
+	}
+	else if (diffuse.r == 0.f && diffuse.g == 0.f && diffuse.b == 0.f)
+	{
+		return false;   // no texture and no colour: nothing to project
+	}
+
+	albedo.r *= diffuse.r;
+	albedo.g *= diffuse.g;
+	albedo.b *= diffuse.b;
+
+	outColor = ColorB((uint8)clamp_tpl((int)(albedo.r * 255.f + 0.5f), 0, 255),
+	                  (uint8)clamp_tpl((int)(albedo.g * 255.f + 0.5f), 0, 255),
+	                  (uint8)clamp_tpl((int)(albedo.b * 255.f + 0.5f), 0, 255),
+	                  255);
+	return true;
+}
+
+bool CTerrainPlateComponent::GetCommitAppearance(SAppearance& outAppearance) const
+{
+	const char* szLayer = m_commitLayer.c_str();
+	const bool bHasLayer = (szLayer != nullptr && szLayer[0] != '\0');
+
+	if (!bHasLayer && !m_bCommitColour)
+		return false;   // nothing asked for
+
+	outAppearance.szLayerName = bHasLayer ? szLayer : nullptr;
+	outAppearance.bUseAlbedo = m_bCommitAlbedo;
+	outAppearance.bWriteColour = m_bCommitColour;
+	outAppearance.tint = ColorB((uint8)clamp_tpl((int)(m_commitTint.r * 255.f + 0.5f), 0, 255),
+	                           (uint8)clamp_tpl((int)(m_commitTint.g * 255.f + 0.5f), 0, 255),
+	                           (uint8)clamp_tpl((int)(m_commitTint.b * 255.f + 0.5f), 0, 255),
+	                           255);
+	return true;
 }
 
 void CTerrainPlateComponent::OnCommitted()
