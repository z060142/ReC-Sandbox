--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/ITerrainPlateCommit.h
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/ITerrainPlateCommit.h
@@ -29,11 +29,28 @@ namespace DefaultComponents
 //! also deliberately does not derive from IEntityComponent - the plate already reaches IEntityComponent
 //! through CBaseMeshComponent, and a second path would make that base ambiguous.
 //!
-//! Step 1 (height commit) only uses GetCommitFootprint and OnCommitted. The appearance stamp of step 2
-//! needs the other two, and they are declared now so that step 2 does not move the vtable under a build
-//! that has already shipped.
+//! Step 1 (height commit) uses GetCommitFootprint and OnCommitted; step 2 (appearance commit) uses the
+//! rest. The two are SEPARATE user operations with separate undo groups, so the second set is written to
+//! stand on its own: nothing below depends on the height having been committed, or on a live bake being
+//! applied at all - the footprint and the rim weight are derived from the plate's CURRENT transform and
+//! knobs, exactly as ComputeBakeRect / ComputeBakeBlock derive them.
 struct ITerrainPlateCommit
 {
+	//! What the appearance commit should stamp. Filled by GetCommitAppearance.
+	struct SAppearance
+	{
+		//! Terrain layer to blend towards, matched with CTerrainManager::FindLayer. Empty or null: leave
+		//! the surface type weights alone.
+		const char* szLayerName = nullptr;
+		//! Multiplied into the stamped colour. White (the default) leaves the albedo alone; with albedo
+		//! off it IS the stamped colour. Gamma space, 0..255 per channel, like the RGB layer itself.
+		ColorB      tint = ColorB(255, 255, 255, 255);
+		//! Sample the plate's own material for the colour instead of using the flat tint.
+		bool        bUseAlbedo = false;
+		//! Write terrain colour at all. Off: layer weights only.
+		bool        bWriteColour = true;
+	};
+
 	//! Type id of CTerrainPlateComponent, for IEntity::GetComponentByTypeId. Must stay in step with
 	//! CTerrainPlateComponent::ReflectType's desc.SetGUID.
 	static CryGUID GetComponentTypeId() { return "{3F1D8B4A-6C2E-4E9F-9A21-7B5C0D4E8A13}"_cry_guid; }
@@ -45,14 +62,31 @@ struct ITerrainPlateCommit
 	//! False when there is nothing to commit: no live bake, or the plate is committed already.
 	virtual bool  GetCommitFootprint(int& outX1, int& outY1, int& outSize) const = 0;
 
+	//! Step 2. The square the APPEARANCE commit covers, in terrain units, same convention as
+	//! GetCommitFootprint. Unlike GetCommitFootprint this is derived from the plate's current transform
+	//! (ComputeBakeRect), so it is available whether or not a bake is live and whether or not the height
+	//! has been committed - the colour commit is an independent operation.
+	virtual bool  GetCommitAppearanceFootprint(int& outX1, int& outY1, int& outSize) const = 0;
+
 	//! Step 2. smoothstep(t) * coverage at a world XY - the SAME rim curve the height bake used, so that
 	//! the colour edge sits exactly on the height edge. 0 outside the footprint.
-	virtual float GetCommitWeightAtWorld(float worldX, float worldY) const = 0;
+	//!
+	//! sampleSizeMeters is the edge of the sample's own footprint, and it is the ONLY thing that differs
+	//! between the three consumers: the height bake evaluates it over one terrain cell, the layer stamp
+	//! does the same (so those two agree exactly), and the colour stamp evaluates it over one RGB texel
+	//! (0.5 m by default). smoothstep(t) is a closed form in plate local coordinates and does not care;
+	//! only the C1 coverage term is an area measure, and this is the area it measures. 0 or less means a
+	//! point sample.
+	virtual float GetCommitWeightAtWorld(float worldX, float worldY, float sampleSizeMeters) const = 0;
 
 	//! Step 2. Albedo of the plate at a world XY, for the optional colour projection. False when the
 	//! plate has no usable projection (no material, or a material the CPU cannot sample).
 	virtual bool  GetCommitAlbedoAtWorld(float worldX, float worldY, ColorB& outColor) const = 0;
 
+	//! Step 2. The plate's appearance commit properties. False when the plate has nothing to stamp.
+	//! The strings point into the component and are only valid for the duration of the call chain.
+	virtual bool  GetCommitAppearance(SAppearance& outAppearance) const = 0;
+
 	//! The editor has written the committed ground into CHeightmap: adopt it as this plate's baseline,
 	//! stop defending the footprint and stop restoring it on teardown. Called INSIDE the editor's undo
 	//! group, after the heights are written and before it is accepted.
