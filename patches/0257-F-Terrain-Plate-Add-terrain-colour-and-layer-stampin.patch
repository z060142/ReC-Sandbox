+//! Blends one heightmap cell's surface type weights towards szLayer by weight, without copying the two
+//! bugs in the stock CImagePainter::LerpTerrainSurfaceType (ImagePainter.cpp:123 indexes we[3] on a three
+//! element array, and :202 seeds a 15 scale value into a 255 scale field). Same idea as the stock one:
+//! unroll both sides into a per layer histogram, keep the three heaviest, renormalise - because the
+//! engine cell can only carry three types (SSurfaceTypeItem::kMaxSurfaceTypesNum, and 4 bit weights and a
+//! 16 entry palette per sector below that, research 12 section 5.3).
+static SSurfaceTypeItem BlendSurfaceTypeTowards(const SSurfaceTypeItem& src, uint32 layerId, float weight)
+{
+	float histogram[e_layerIdHole] = { 0.f };
+
+	for (int c = 0; c < SSurfaceTypeItem::kMaxSurfaceTypesNum; ++c)
+	{
+		if (src.ty[c] < e_layerIdHole)
+			histogram[src.ty[c]] += (1.f - weight) * (float)src.we[c];
+	}
+
+	if (layerId < e_layerIdHole)
+		histogram[layerId] += weight * 255.f;
+
+	SSurfaceTypeItem out;
+	out.hole = src.hole;   // SetLayerIdAt preserves it too (Heightmap.cpp:2798), but do not rely on that
+
+	float total = 0.f;
+	for (int c = 0; c < SSurfaceTypeItem::kMaxSurfaceTypesNum; ++c)
+	{
+		int   best = -1;
+		float bestWeight = 0.f;
+		for (int s = 0; s < e_layerIdHole; ++s)
+		{
+			if (histogram[s] > bestWeight)
+			{
+				bestWeight = histogram[s];
+				best = s;
+			}
+		}
+
+		if (best < 0)
+			break;
+
+		out.ty[c] = (uint8)best;
+		out.we[c] = (uint8)clamp_tpl((int)(bestWeight + 0.5f), 0, 255);
+		total += bestWeight;
+		histogram[best] = 0.f;
+	}
+
+	// Renormalise the tail, then give the dominant slot whatever is left: we[0] is IMPLICIT in the engine
+	// encoding (terrain_sector.h:65-94 derives it as 15 - we[1] - we[2]), so it is the one that must
+	// absorb the rounding, not the ones that survive the trip.
+	if (total > 0.f)
+	{
+		int tail = 0;
+		for (int c = 1; c < SSurfaceTypeItem::kMaxSurfaceTypesNum; ++c)
+		{
+			out.we[c] = (uint8)clamp_tpl((int)((float)out.we[c] * 255.f / total + 0.5f), 0, 255);
+			tail += out.we[c];
+		}
+		out.we[0] = (uint8)clamp_tpl(255 - tail, 0, 255);
+	}
+
+	return out;
+}
