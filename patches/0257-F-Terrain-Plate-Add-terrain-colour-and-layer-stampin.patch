+void RecordTerrainAppearanceUndo(float fpx, float fpy, float radius)
+{
+	if (!CUndo::IsRecording())
+		return;
+
+	// AddSector snapshots both halves of the appearance in one go: the RGB tile regions the square
+	// touches, and the 64 x 64 blocks of the layer id bitmap under it. CUndoTPElement::Paste puts both
+	// back and re-pushes the engine surface bits, so one Ctrl+Z restores colour and layer weights
+	// together, which is precisely what the commit needs.
+	CUndoTPElement* pElement = new CUndoTPElement;
+	pElement->AddSector(fpx, fpy, radius);
+
+	CUndo::Record(new CUndoTexturePainter(pElement));
+}
