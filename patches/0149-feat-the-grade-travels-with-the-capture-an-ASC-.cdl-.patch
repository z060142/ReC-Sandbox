+		               out.cdlSlope.x, out.cdlSlope.y, out.cdlSlope.z,
+		               out.cdlOffset.x, out.cdlOffset.y, out.cdlOffset.z,
+		               out.cdlPower.x, out.cdlPower.y, out.cdlPower.z,
+		               out.cdlSaturation, out.bCdlBypassed ? " (bypassed)" : "");
