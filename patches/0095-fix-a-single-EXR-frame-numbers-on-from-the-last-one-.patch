+++ b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
@@ -741,11 +741,15 @@ static void Cmd_CaptureEXRStop(IConsoleCmdArgs* pArgs)
 	CSceneReferredExport::Get().Stop("stopped from the console");
 }
 
+// NAME FIRST, folder second - the opposite of rec_CaptureEXR, deliberately. Taking one frame is
+// something you do repeatedly while looking at something, and what you want to say about it is
+// what it is ("rec_CaptureEXRFrame dusk_wide"), not where it goes; the folder is the default
+// nearly always. Making the name reachable without also typing the folder is the whole point.
 static void Cmd_CaptureEXRFrame(IConsoleCmdArgs* pArgs)
 {
-	const char* szFolder = (pArgs && pArgs->GetArgCount() > 1) ? pArgs->GetArg(1) : "";
-	const char* szPrefix = (pArgs && pArgs->GetArgCount() > 2) ? pArgs->GetArg(2) : "";
-	CSceneReferredExport::Get().RequestSingleFrame(szFolder, szPrefix);
+	const char* szName   = (pArgs && pArgs->GetArgCount() > 1) ? pArgs->GetArg(1) : "";
+	const char* szFolder = (pArgs && pArgs->GetArgCount() > 2) ? pArgs->GetArg(2) : "";
+	CSceneReferredExport::Get().RequestSingleFrame(szFolder, szName);
 }
 
 static void OnChange_CV_r_HDRTexFormat(ICVar* pCVar)
@@ -3298,7 +3302,15 @@ void CRendererCVars::InitCVars()
 	                 "abandoned.");
 	REGISTER_COMMAND("rec_CaptureEXRFrame", &Cmd_CaptureEXRFrame, VF_NULL,
 	                 "Write exactly ONE scene-referred EXR and disarm.\n"
-	                 "Usage: rec_CaptureEXRFrame [folder] [prefix]\n"
+	                 "Usage: rec_CaptureEXRFrame [name] [folder]\n"
+	                 "  name   - default 'frame'. NAME FIRST here, unlike rec_CaptureEXR: taking single "
+	                 "frames is something you do repeatedly while looking at something, and what you want to "
+	                 "say about one is what it is, not where it goes.\n"
+	                 "  folder - as rec_CaptureEXR. Default 'CaptureEXR' under the user folder.\n"
+	                 "Numbering CONTINUES for the whole session, per destination: the first free "
+	                 "<name>.%06d.exr is used, so repeated captures are consecutive and files already on disk "
+	                 "- from this session or a previous one - are never overwritten. A sequence still starts "
+	                 "at zero; it is one artefact.\n"
 	                 "Same settings as rec_CaptureEXR, but t_FixedStep is left alone - one frame "
 	                 "has no cadence to fix.");
 	REGISTER_COMMAND("r_PrecacheShaderList", &ShadersPrecacheList, VF_NULL, "");
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SceneReferredExport.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SceneReferredExport.cpp
index 653c5c5d..4352e890 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SceneReferredExport.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SceneReferredExport.cpp
@@ -148,7 +148,26 @@ bool CSceneReferredExport::RequestSingleFrame(const char* szFolder, const char*
 
 	m_folder = ResolveCaptureFolder(szFolder);
 	m_prefix = (szPrefix && *szPrefix) ? szPrefix : "frame";
-	m_frameIndex = 0;
+
+	// A SINGLE frame numbers consecutively for the whole session, which is the one place this
+	// differs from a sequence. A sequence is one artefact and starts at zero by definition; single
+	// frames are taken one at a time while something is being looked at, and re-writing
+	// frame.000000.exr every time makes the command useless for exactly that.
+	//
+	// The counter is a hint, not the answer: the disk is asked. That way a file deleted between
+	// two captures gets its number back, and files left over from a previous session are not
+	// silently overwritten - neither of which a counter on its own can know. The key is the
+	// destination, so switching folder or name starts a fresh scan.
+	const string key = m_folder + "/" + m_prefix;
+	if (key != m_singleFrameKey)
+	{
+		m_singleFrameKey = key;
+		m_singleFrameNext = 0;
+	}
+
+	m_frameIndex = FirstFreeIndex(m_folder, m_prefix, m_singleFrameNext);
+	m_singleFrameNext = m_frameIndex + 1;
+
 	m_nextSlot = 0;
 	m_tap = clamp_tpl(CRenderer::CV_r_SceneReferredExportTap, 0, 1);
 	m_encoding = clamp_tpl(CRenderer::CV_r_SceneReferredExportEncoding, 0, 1);
@@ -158,6 +177,22 @@ bool CSceneReferredExport::RequestSingleFrame(const char* szFolder, const char*
 	return true;
 }
 
+int CSceneReferredExport::FirstFreeIndex(const string& folder, const string& prefix, int nStartAt)
+{
+	// FLAGS_PATH_REAL: the folder is already an absolute, adjusted path from ResolveCaptureFolder,
+	// and FLAGS_NEVER_IN_PAK because a capture destination is a disk folder - a name that happens
+	// to exist inside a .pak must not count as taken.
+	const int nMax = 1000000;   // the format is %06d; past this the name is not unique anyway
+	for (int i = max(nStartAt, 0); i < nMax; ++i)
+	{
+		string path;
+		path.Format("%s/%s.%06d.exr", folder.c_str(), prefix.c_str(), i);
+		if (!gEnv->pCryPak->IsFileExist(path.c_str(), ICryPak::eFileLocation_OnDisk))
+			return i;
+	}
+	return max(nStartAt, 0);
+}
+
 void CSceneReferredExport::Stop(const char* szReason)
 {
 	if (m_state == eState_Idle)
