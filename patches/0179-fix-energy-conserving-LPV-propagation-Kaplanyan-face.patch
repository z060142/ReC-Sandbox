diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
index c774bff0..cce75f95 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/LPV.cpp
@@ -687,6 +687,7 @@ void CLPVStage::ExecuteInject(const SScopedComputeCommandList& commandList, CTex
 	// needed. The inverse is only defined up to a projective scale, dehomogenize before measuring
 	// (same pitfall as the screen inject area weight).
 	float gvBlocking = 0.0f;
+	float rsmTexelSize = 0.0f;
 	if (CRendererCVars::CV_r_LPVOcclusion > 0.0f)
 	{
 		Vec4 rsmCorner0 = m_rsmToWorld * Vec4(0.0f, 0.0f, 0.5f, 1.0f);
@@ -696,10 +697,21 @@ void CLPVStage::ExecuteInject(const SScopedComputeCommandList& commandList, CTex
 		if (fabsf(rsmCorner1.w) > 1e-12f)
 			rsmCorner1 = rsmCorner1 / rsmCorner1.w;
 		const Vec3 rsmSpan = Vec3(rsmCorner1.x - rsmCorner0.x, rsmCorner1.y - rsmCorner0.y, rsmCorner1.z - rsmCorner0.z);
-		const float rsmTexelSize = rsmSpan.GetLength() / (float)m_rsmSampleCount;
+		rsmTexelSize = rsmSpan.GetLength() / (float)m_rsmSampleCount;
 		gvBlocking = min(1.0f, (rsmTexelSize * rsmTexelSize) / (m_cellSize * m_cellSize));
 	}
 
+	if (CRendererCVars::CV_r_LPVDebug > 0)
+	{
+		static float lastBlocking = -1.0f;
+		if (fabsf(gvBlocking - lastBlocking) > 1e-6f)
