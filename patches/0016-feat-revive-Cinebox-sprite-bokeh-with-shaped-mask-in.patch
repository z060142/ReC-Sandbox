+//////////////////////////////////////////////////////////////////////////////////////////////////
+// Sprite bokeh (r_DepthOfFieldMode 0)
+//
+// Port of the pre-5.7 CMotionBlur::Execute() splat path onto CPrimitiveRenderPass. One quad per
+// half-resolution pixel is expanded on the GPU from SV_VertexID - there is no vertex stream at
+// all, so the draw is a plain non-indexed triangle list of width * height * 6 vertices. Every
+// quad reads scene colour and depth in the vertex shader, sizes itself by the circle of
+// confusion, and is additively accumulated into a near and a far layer; a normalization pass
+// then divides by the accumulated weight and composites the result over the scene.
+//////////////////////////////////////////////////////////////////////////////////////////////////
+void CDepthOfFieldStage::ExecuteSpriteBokeh(const SDepthOfFieldParams& dofParams, const Vec4& vDofParams0, const Vec4& vDofParams1)
+{
+	PROFILE_LABEL_SCOPE("SPRITE DOF");
+
+	CShader* pShader = CShaderMan::s_shPostDepthOfField;
+
+	CTexture* pSceneTarget = m_graphicsPipelineResources.m_pTexSceneTarget;
+	CTexture* pSplatSource = m_graphicsPipelineResources.m_pTexHDRTargetScaled[0][0];
+	CTexture* pLayerNear = m_graphicsPipelineResources.m_pTexHDRTargetMaskedScaled[0][0];
+	CTexture* pLayerFar = m_graphicsPipelineResources.m_pTexHDRTargetMaskedScaled[0][1];
+
+	if (!CTexture::IsTextureExist(pSplatSource) || !CTexture::IsTextureExist(pLayerNear) || !CTexture::IsTextureExist(pLayerFar))
+		return;
+
+	// Untouched scene copy for the composition pass to blend against, plus the half resolution
+	// source the splats sample from.
+	m_passSpriteCopySceneTarget.Execute(m_graphicsPipelineResources.m_pTexHDRTarget, pSceneTarget);
+	m_passSpriteDownscale.Execute(m_graphicsPipelineResources.m_pTexHDRTarget, pSplatSource);
+
+	const int32 nWidth = pLayerNear->GetWidth();
+	const int32 nHeight = pLayerNear->GetHeight();
+	const uint32 nBokehVertexCount = uint32(nWidth) * uint32(nHeight) * 3 * 2;
+	// Assume tweaked for 1600x900 with render target scale of 0.8
+	const float fBokehNormFactor = (float)(640 * 360 * 3 * 2) / (float)nBokehVertexCount;
+
+	// Iris shaping, sharing the gather path's semantics: blade count from the post params and a
+	// polygon blend that stays round at f/1.2 and is fully formed by f/2.8.
+	float fFNumber = dofParams.fApertureFNumber;
+	float fNumApertureSides = clamp_tpl(dofParams.fApertureBlades, 3.0f, 16.0f);
+	if (CRenderer::CV_r_DofBokehQuality >= 3)
+	{
+		fNumApertureSides = (float)CRenderer::CV_r_DofBokehQuality;
+		fFNumber = 8.0f;
+	}
+
+	const float minFstops = 1.2f;
+	const float maxFstops = 2.8f;
+	const float fPolygonBlend = clamp_tpl((fFNumber - minFstops) / (maxFstops - minFstops), 0.0f, 1.0f);
+
+	CTexture* pShapeTex = dofParams.pBokehShapeTex;
+	const bool bShapeTexValid = CTexture::IsTextureExist(pShapeTex);
+	if (!bShapeTexValid)
+		pShapeTex = CRendererResources::s_ptexWhite;
+
+	const float fTargetWidth = (float)m_graphicsPipelineResources.m_pTexHDRTarget->GetWidth();
+	const float fTargetHeight = (float)m_graphicsPipelineResources.m_pTexHDRTarget->GetHeight();
+	const float fAspectRatio = (1920.0f / 1080.0f) * (fTargetHeight / fTargetWidth);
+	const Vec4 vAspectRatio(fAspectRatio * (fTargetWidth / 1920.0f), fTargetHeight / 1080.0f, fBokehNormFactor / 80.0f, CRenderer::CV_r_dofDilation);
+	const Vec4 vBokehShape(fNumApertureSides, fPolygonBlend, bShapeTexValid ? 1.0f : 0.0f, dofParams.fBladeRotation);
+
+	static CCryNameR dofFocusParam0Name("vDofParamsFocus0");
+	static CCryNameR dofFocusParam1Name("vDofParamsFocus1");
+	static CCryNameR dofAspectRatioName("vAspectRatio");
+	static CCryNameR dofBokehShapeName("vDofBokehShape");
+
+	// Ground truth log, once per change: what the splat grid and the iris actually resolve to.
+	{
+		static int   s_lastWidth = -1, s_lastHeight = -1, s_lastShapeBound = -1;
+		static float s_lastBlades = -1.0f, s_lastBlend = -1.0f;
+		if (nWidth != s_lastWidth || nHeight != s_lastHeight || (bShapeTexValid ? 1 : 0) != s_lastShapeBound ||
+		    fabsf(fNumApertureSides - s_lastBlades) > 0.01f || fabsf(fPolygonBlend - s_lastBlend) > 0.01f)
+		{
+			s_lastWidth = nWidth;
+			s_lastHeight = nHeight;
+			s_lastShapeBound = bShapeTexValid ? 1 : 0;
+			s_lastBlades = fNumApertureSides;
+			s_lastBlend = fPolygonBlend;
+			CryLog("[DOF] sprite grid %dx%d (%u verts) norm=%.4f blades=%.0f polyBlend=%.2f shapeTex=%s",
+			       nWidth, nHeight, nBokehVertexCount, fBokehNormFactor, fNumApertureSides, fPolygonBlend,
+			       bShapeTexValid ? "yes" : "no");
+		}
+	}
+
+	// Accumulate the splats
+	{
+		PROFILE_LABEL_SCOPE("QUAD BOKEH DOF");
+
+		CClearSurfacePass::Execute(pLayerNear, Clr_Transparent);
+		CClearSurfacePass::Execute(pLayerFar, Clr_Transparent);
+
+		if (!m_pSpritePerViewCB)
+		{
+			m_pSpritePerViewCB = gcpRendD3D->m_DevBufMan.CreateConstantBuffer(sizeof(HLSL_PerViewGlobalConstantBuffer));
+			if (m_pSpritePerViewCB)
+				m_pSpritePerViewCB->SetDebugName("SpriteBokeh Per-View CB");
+		}
+		if (!m_pSpritePerViewCB)
+			return;
+
+		// The vertex shader derives its quad grid and pixel size from the per-view screen size,
+		// so that has to describe the half resolution layer, not the full screen.
+		const SRenderViewInfo& viewInfo = m_graphicsPipeline.GetCurrentViewInfo(CCamera::eEye_Left);
+		const SRenderViewport customViewport(0, 0, nWidth, nHeight);
+		m_graphicsPipeline.GeneratePerViewConstantBuffer(&viewInfo, (int)m_graphicsPipeline.GetViewInfoCount(), m_pSpritePerViewCB, &customViewport);
+
+		D3DViewPort viewport;
+		viewport.TopLeftX = 0.0f;
+		viewport.TopLeftY = 0.0f;
+		viewport.Width = (float)nWidth;
+		viewport.Height = (float)nHeight;
+		viewport.MinDepth = 0.0f;
+		viewport.MaxDepth = 1.0f;
+
+		m_passSpriteSplat.SetRenderTarget(0, pLayerNear);
+		m_passSpriteSplat.SetRenderTarget(1, pLayerFar);
+		m_passSpriteSplat.SetViewport(viewport);
+		m_passSpriteSplat.BeginAddingPrimitives();
+
+		static CCryNameTSCRC techSpriteBokeh("DofBokehRef");
+		const uint64 rtMask = (CRenderer::CV_r_dofDilation > 0.001f) ? g_HWSR_MaskBit[HWSR_SAMPLE1] : 0;
+
+		CRenderPrimitive& prim = m_spriteSplatPrimitive;
+		prim.SetFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_VS | CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		prim.SetTechnique(pShader, techSpriteBokeh, rtMask);
+		prim.SetRenderState(GS_NODEPTHTEST | GS_BLSRC_ONE | GS_BLDST_ONE);
+		prim.SetCullMode(eCULL_None);
+
+		// Procedural geometry: no vertex or index stream, six vertices per source pixel.
+		prim.SetCustomVertexStream(~0u, EDefaultInputLayouts::Empty, 0);
+		prim.SetDrawInfo(eptTriangleList, 0, 0, nBokehVertexCount);
+
+		// Scene colour and depth are read from the vertex shader as well as the pixel shader.
+		prim.SetTexture(0, pSplatSource, EDefaultResourceViews::Default, EShaderStage_Vertex | EShaderStage_Pixel);
+		prim.SetTexture(1, m_graphicsPipelineResources.m_pTexLinearDepth, EDefaultResourceViews::Default, EShaderStage_Vertex | EShaderStage_Pixel);
+		prim.SetTexture(2, CRendererResources::s_ptexGrainFilterMap);
+		prim.SetTexture(3, pShapeTex);
+		prim.SetSampler(0, EDefaultSamplerStates::PointClamp, EShaderStage_Vertex | EShaderStage_Pixel);
+		prim.SetSampler(1, EDefaultSamplerStates::PointClamp, EShaderStage_Vertex | EShaderStage_Pixel);
+		prim.SetSampler(2, EDefaultSamplerStates::PointWrap);
+		prim.SetSampler(3, EDefaultSamplerStates::LinearClamp);
+
+		prim.SetInlineConstantBuffer(eConstantBufferShaderSlot_PerView, m_pSpritePerViewCB, EShaderStage_Vertex | EShaderStage_Pixel);
+
+		if (prim.Compile(m_passSpriteSplat) == CRenderPrimitive::eDirty_None)
+		{
+			auto& constantManager = prim.GetConstantManager();
+			constantManager.BeginNamedConstantUpdate();
+			constantManager.SetNamedConstant(dofFocusParam0Name, vDofParams0, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofFocusParam1Name, vDofParams1, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofAspectRatioName, vAspectRatio, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofFocusParam0Name, vDofParams0, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofFocusParam1Name, vDofParams1, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofAspectRatioName, vAspectRatio, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofBokehShapeName, vBokehShape, eHWSC_Pixel);
+			constantManager.EndNamedConstantUpdate(&viewport, m_graphicsPipeline.GetCurrentRenderView());
+
+			m_passSpriteSplat.AddPrimitive(&prim);
+			m_passSpriteSplat.Execute();
+		}
+		else
+		{
+			static bool s_bWarned = false;
+			if (!s_bWarned)
+			{
+				s_bWarned = true;
+				CryLogAlways("[DOF] sprite bokeh primitive failed to compile - splat pass skipped");
+			}
+		}
+	}
+
+	// Normalize the accumulated layers and composite them over the scene copy
+	{
+		PROFILE_LABEL_SCOPE("BOKEH DOF COMPOSE");
+
+		if (m_passSpriteComposition.IsDirty())
+		{
+			static CCryNameTSCRC techSpriteCompose("RefDofMbNormalizePass");
+			m_passSpriteComposition.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+			m_passSpriteComposition.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+			m_passSpriteComposition.SetTechnique(pShader, techSpriteCompose, 0);
+			m_passSpriteComposition.SetRenderTarget(0, m_graphicsPipelineResources.m_pTexHDRTarget);
+			// RefDofMBNormalizePS already returns the finished composite (it lerps the scene
+			// copy against the normalized layers itself), so write it straight out. The legacy
+			// src-alpha blend applied that same weight a second time against an HDR target that
+			// still held the identical scene, which quietly halved the effect.
+			m_passSpriteComposition.SetState(GS_NODEPTHTEST);
+
+			m_passSpriteComposition.SetTextureSamplerPair(0, pLayerNear, EDefaultSamplerStates::LinearClamp);
+			m_passSpriteComposition.SetTextureSamplerPair(1, pLayerFar, EDefaultSamplerStates::LinearClamp);
+			m_passSpriteComposition.SetTextureSamplerPair(2, pSceneTarget, EDefaultSamplerStates::PointClamp);
+			m_passSpriteComposition.SetTextureSamplerPair(3, m_graphicsPipelineResources.m_pTexLinearDepth, EDefaultSamplerStates::PointClamp);
+		}
+
+		m_passSpriteComposition.BeginConstantUpdate();
+		m_passSpriteComposition.SetConstant(dofFocusParam0Name, vDofParams0, eHWSC_Pixel);
+		m_passSpriteComposition.SetConstant(dofFocusParam1Name, vDofParams1, eHWSC_Pixel);
+		m_passSpriteComposition.Execute();
+	}
+
+	m_bWroteHDRTarget = true;
 }
