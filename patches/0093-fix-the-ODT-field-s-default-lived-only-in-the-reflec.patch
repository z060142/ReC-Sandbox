+//! The shipped ACES 2.0 SDR 100 nit sRGB output transform. One definition, used as the member's
+//! initialiser, as the reflected default, and as the fallback when the field is empty.
+constexpr const char* kDefaultODTFile = "Assets/ODT/odt_srgb_100nit_aces2_65.cube";
+
 struct SCineOutputParams
 {
 	inline bool operator==(const SCineOutputParams& rhs) const { return odtFile == rhs.odtFile; }
@@ -980,12 +984,19 @@ struct SCineOutputParams
 			"ACES 2.0 studio config. THE one place in the chain that knows a display exists. "
 			"The default is the ACES 2.0 SDR 100 nit sRGB view; swapping this file changes only "
 			"what the monitor shows, never the scene data. Empty or unreadable = the picture goes "
-			"deliberately, visibly wrong (a clamped encode) rather than silently falling back.",
-			Schematyc::CSharedString("Assets/ODT/odt_srgb_100nit_aces2_65.cube"));
+			"deliberately, visibly wrong (a clamped encode) rather than silently falling back. "
+			"Left empty, the built-in default below is loaded instead - an unset field is not a "
+			"statement about the display, and a component that has never been touched has to "
+			"come up looking right.",
+			Schematyc::CSharedString(kDefaultODTFile));
 	}
 
 	// Keep last: operator== compares the string by value.
-	Schematyc::CSharedString odtFile;
+	// The in-class initialiser is what the RUNTIME reads. AddMember's default value feeds
+	// Schematyc's reflected default (graph nodes, "reset to default", the serializer's
+	// skip-if-equal test) and never touches the member itself, so a member without one is an
+	// empty string at activation no matter what the reflection says.
+	Schematyc::CSharedString odtFile = kDefaultODTFile;
 };
 
