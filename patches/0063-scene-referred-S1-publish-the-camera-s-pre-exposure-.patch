 {
@@ -606,6 +651,13 @@ void CD3D9Renderer::RT_RenderScene(CRenderView* pRenderView)
 	m_vSceneLuminanceInfo = Vec4(1.0f, 1.0f, 1.0f, 1.0f);
 	m_fAdaptedSceneScale  = m_fAdaptedSceneScaleLBuffer = m_fScotopicSceneScale = 1.0f;
 
+	// ...and immediately re-assign the L-buffer scale from the camera's pre-exposure for this
+	// frame. Off the scene-referred path this writes the same 1.0f the line above just wrote, so
+	// the stock pipeline is unchanged. This is the only place the value is set for a frame; it
+	// runs before the graphics pipeline scope below, so it precedes Update() (which builds the
+	// per-view constant buffer) and Execute() (which builds the light lists).
+	LatchSceneReferredExposure(shaderRenderingFlags);
+
 	// This scope is the only one allowed to utilize the graphics pipeline
 	{
 		CRY_ASSERT(shaderRenderingFlags & SHDF_ALLOWHDR);
