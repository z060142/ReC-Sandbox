+// Scene-referred pre-exposure, latched once per render view (SceneReferredSpec.md D3,
+// decisions/s1-exposure-publication.md approach A).
+//
+// The Cinematic Camera computes the exposure on the MAIN thread, after ITimeOfDay::Update(), and
+// publishes it as a linear scale on the post-effect parameter bus. CParamFloat keeps one slot per
+// command buffer and SyncMainWithRender() copies fill -> process at the frame boundary, so the
+// value this reads is the one ccam asked for for THIS frame and it cannot move underneath a frame
+// already in flight. That is the property the bus was chosen for.
+//
+// It still has to be latched: the five m_fAdaptedSceneScaleLBuffer consumers run at different
+// points of the frame (CTiledLightVolumesStage, CRenderView::GetSunLightColor, CClipVolumesStage,
+// CVolumetricFogStage), and a scalar that is the whole image's brightness must not differ between
+// them. One read here, one assignment, and every consumer downstream reads the member.
+void CD3D9Renderer::LatchSceneReferredExposure(uint32 shaderRenderingFlags)
+{
+	float exposure = 1.0f;
+
+	// Probes are baked at unity exposure and exposed exactly once at sample time, by the tint
+	// multiply the hook already performs on the cubemap's light colour. Exposing the capture too
+	// would square the factor, and BC6UH cannot carry a compensating value back in - so cube-map
+	// generation always renders unexposed radiance in engine units, whatever the camera is doing.
+	// decisions/s1-probe-exposure.md approach A; it supersedes spec D3's "exclude probes from the
+	// hook" wording.
+	const bool bCubemapGen = (shaderRenderingFlags & SHDF_CUBEMAPGEN) != 0;
+
+	if (!bCubemapGen && CRendererResources::IsSceneReferred())
+	{
+		if (CPostEffectsMgr* pPostMgr = PostEffectMgr())
+		{
+			if (CEffectParam* pExposure = pPostMgr->GetSceneExposureParam())
+			{
+				// A zero or negative scale would black the frame out with no error anywhere, and
+				// an infinity would poison the luminance measure; the window is wide enough that
+				// no reachable EV100 in [-6, 24] comes near either end.
+				const float published = pExposure->GetParam();
+				if (published > 0.0f && NumberValid(published))
+					exposure = clamp_tpl(published, 1e-12f, 1e12f);
+			}
+		}
+	}
+
+	m_fSceneReferredExposure[GetRenderThreadID()] = exposure;
+	m_fAdaptedSceneScaleLBuffer = exposure;
+}
+
