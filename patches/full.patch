+// Mechanical light loss of the field-dependent pupil, packed for HDRVignetteParams
+// (.y = barrel offset per unit field height, .z = barrel radius, .w = diagnostic flag).
+//
+// This is the ONE place the loss is applied: the pupil is clipped by the barrel whether or not
+// a pixel is in focus, so it belongs to the whole picture and not just to the blurred parts.
+// The gather only reshapes its kernel and the splat divides its deposit back out, precisely so
+// that this term is not counted a second time.
+//
+// The values are read straight off the post effect params rather than through
+// CDepthOfField::GetParams(), which advances the time-of-day focus smoother on every call and
+// must stay at one call per frame (see the warning in DepthOfField.h).
+static Vec4 ResolveVignetteParams()
+{
+	const float fAmount = clamp_tpl(CRenderer::CV_r_HDRVignetteAmount, 0.0f, 4.0f);
+
+	CPostEffectsMgr* pPostMgr = PostEffectMgr();
+	if (!pPostMgr)
+		return Vec4(fAmount, 0.0f, 1.0f, 0.0f);
+
+	CEffectParam* pCatEye = pPostMgr->GetByName("Dof_User_CatEye");
+	CEffectParam* pPupilScale = pPostMgr->GetByName("Dof_User_PupilScale");
+	if (!pCatEye || !pPupilScale)
+		return Vec4(fAmount, 0.0f, 1.0f, 0.0f);
+
+	// Only the barrel geometry matters here: coma and astigmatism redistribute light inside the
+	// pupil, they do not block any of it.
+	const Vec4 vFieldPupil = CDepthOfFieldStage::ResolveFieldPupil(pCatEye->GetParam(), pPupilScale->GetParam(), 0.0f, 0.0f);
+
+	return Vec4(fAmount, vFieldPupil.x, vFieldPupil.y, (CRenderer::CV_r_DofFieldDebug > 0) ? 1.0f : 0.0f);
+}
