index 00000000..154ab25b
--- /dev/null
+++ b/Code/CryPlugins/CryPhoneTracker/Module/PhoneTrackerComponent.cpp
@@ -0,0 +1,749 @@
+// CryPhoneTracker - entity component driving an entity transform from the phone 6DoF tracker.
+#include "StdAfx.h"
+#include "PhoneTrackerComponent.h"
+
+#include <CryEntitySystem/IEntity.h>
+#include <CryRenderer/IRenderAuxGeom.h>
+#include <CryCore/Platform/CryLibrary.h>
+#include <CryPhysics/physinterface.h>
+
+#include <CrySchematyc/Reflection/TypeDesc.h>
+#include <CrySchematyc/Env/IEnvRegistry.h>
+#include <CrySchematyc/Env/Elements/EnvComponent.h>
+#include <CrySchematyc/Env/Elements/EnvFunction.h>
+#include <CryCore/StaticInstanceList.h>
+
+namespace Cry
+{
+namespace PhoneTracker
+{
+
+//! Engine wall clock in nanoseconds; the pose filter rebases the phone timestamps onto it.
+static int64 GetEngineNowNs()
+{
+	return gEnv->pTimer->GetAsyncTime().GetMicroSecondsAsInt64() * 1000;
+}
+
+std::vector<CPhoneTrackerComponent*> CPhoneTrackerComponent::s_registry;
+
+CPhoneTrackerComponent::~CPhoneTrackerComponent()
+{
+	CloseSocket();
+	stl::find_and_erase(s_registry, this);
+}
+
+void CPhoneTrackerComponent::Initialize()
+{
+	if (std::find(s_registry.begin(), s_registry.end(), this) == s_registry.end())
+		s_registry.push_back(this);
+}
+
+int CPhoneTrackerComponent::RegistryIndex() const
+{
+	const auto it = std::find(s_registry.begin(), s_registry.end(), this);
+	return it != s_registry.end() ? (int)(it - s_registry.begin()) : -1;
+}
+
+int CPhoneTrackerComponent::GetTrackerId() const
+{
+	if (m_connection.trackerId.value != 0)
+		return m_connection.trackerId.value;
+	return RegistryIndex() + 1;
+}
+
+const CPhoneTrackerComponent* CPhoneTrackerComponent::FindPortHolder() const
+{
+	for (const CPhoneTrackerComponent* p : s_registry)
+	{
+		if (p != this && p->m_socket != CRY_INVALID_SOCKET && p->m_connection.port.value == m_connection.port.value)
+			return p;
+	}
+	return nullptr;
+}
+
+void CPhoneTrackerComponent::Register(Schematyc::CEnvRegistrationScope& componentScope)
+{
+	{
+		auto pFunction = SCHEMATYC_MAKE_ENV_FUNCTION(&CPhoneTrackerComponent::Recenter, "{2A6C6F13-9F1B-4C33-9E5D-4B7F6D2C8A11}"_cry_guid, "Recenter");
+		pFunction->SetDescription("Uses the next received pose as the new tracker origin and asks the phone to recenter");
+		componentScope.Register(pFunction);
+	}
+	{
+		auto pFunction = SCHEMATYC_MAKE_ENV_FUNCTION(&CPhoneTrackerComponent::SetTrackingEnabled, "{3B7D7024-A02C-4D44-AF6E-5C806E3D9B22}"_cry_guid, "SetTrackingEnabled");
+		pFunction->SetDescription("Opens or closes the tracker socket at runtime");
+		pFunction->BindInput(1, 'enab', "Enabled");
+		componentScope.Register(pFunction);
+	}
+	{
+		auto pFunction = SCHEMATYC_MAKE_ENV_FUNCTION(&CPhoneTrackerComponent::IsTracking, "{4C8E8135-B13D-4E55-B07F-6D917F4EAC33}"_cry_guid, "IsTracking");
+		pFunction->SetDescription("True while valid poses keep arriving from the phone");
+		pFunction->BindOutput(0, 'res', "Result");
+		componentScope.Register(pFunction);
+	}
+}
+
+void CPhoneTrackerComponent::OnShutDown()
+{
+	CloseSocket();
+	stl::find_and_erase(s_registry, this);
+}
+
+Cry::Entity::EventFlags CPhoneTrackerComponent::GetEventMask() const
+{
+	return EEntityEvent::Update | EEntityEvent::Reset | EEntityEvent::GameplayStarted | EEntityEvent::EditorPropertyChanged;
+}
+
+void CPhoneTrackerComponent::ProcessEvent(const SEntityEvent& event)
+{
+	switch (event.event)
+	{
+	case EEntityEvent::GameplayStarted:
+		{
+			if (m_connection.enabled)
+			{
+				OpenSocket();
+			}
+		}
+		break;
+
+	case EEntityEvent::Reset:
+		{
+			const bool enteringGameMode = event.nParam[0] != 0;
+			if (enteringGameMode && m_connection.enabled)
+			{
+				OpenSocket();
+			}
+			else
+			{
+				CloseSocket();
+			}
+		}
+		break;
+
+	case EEntityEvent::EditorPropertyChanged:
+		{
+			// Re-open on the (possibly) new port, but only while we were already listening.
+			if (m_socket != CRY_INVALID_SOCKET)
+			{
+				CloseSocket();
+				if (m_connection.enabled)
+				{
+					OpenSocket();
+				}
+			}
+		}
+		break;
+
+	case EEntityEvent::Update:
+		{
+			const float frameTime = event.fParam[0];
+			UpdateTarget();
+			SyncFilterParams();
+			ReceivePackets();
+			ApplyPose(frameTime);
+
+			if (m_debug.debugDraw)
+			{
+				DrawDebug();
+			}
+		}
+		break;
+
+	default:
+		break;
+	}
+}
+
+void CPhoneTrackerComponent::OpenSocket()
+{
+	if (m_socket != CRY_INVALID_SOCKET)
+		return;
+
+	// Two trackers on one port would silently fight over the bind (and the loser gets no
+	// packets, no error). Name both sides so the operator knows which tracker owns the channel.
+	if (const CPhoneTrackerComponent* pHolder = FindPortHolder())
+	{
+		m_socketProblem.Format("PORT %d BUSY - held by tracker #%d '%s'", m_connection.port.value, pHolder->GetTrackerId(), pHolder->GetEntity()->GetName());
+		CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING, "[PhoneTracker] #%d '%s': %s", GetTrackerId(), m_pEntity->GetName(), m_socketProblem.c_str());
+		return;
+	}
+
+#if CRY_PLATFORM_WINAPI
+	if (!m_wsaStarted)
+	{
+		WSADATA wsaData;
+		if (::WSAStartup(MAKEWORD(2, 2), &wsaData) != 0)
+		{
+			CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING, "[PhoneTracker] WSAStartup failed");
+			return;
+		}
+		m_wsaStarted = true;
+	}
+#endif
+
+	CRYSOCKET socket = CrySock::socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP);
+	if (socket == CRY_INVALID_SOCKET)
+	{
+		CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING, "[PhoneTracker] Could not create UDP socket");
+		return;
+	}
+
+	CRYSOCKADDR_IN address;
+	ZeroStruct(address);
+	address.sin_family = AF_INET;
+	address.sin_addr.s_addr = htonl(INADDR_ANY);
+	address.sin_port = htons(static_cast<uint16>(m_connection.port.value));
+
+	if (CrySock::bind(socket, reinterpret_cast<CRYSOCKADDR*>(&address), sizeof(address)) == CRY_SOCKET_ERROR)
+	{
+		m_socketProblem.Format("PORT %d BIND FAILED - in use outside this level (another process?)", m_connection.port.value);
+		CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING, "[PhoneTracker] #%d '%s': %s", GetTrackerId(), m_pEntity->GetName(), m_socketProblem.c_str());
+		CrySock::closesocket(socket);
+		return;
+	}
+
+	m_socketProblem.clear();
+
+	CrySock::MakeSocketNonBlocking(socket);
+
+	m_socket = socket;
+	m_hasPeer = false;
+	m_hasOrigin = false;
+	m_hasTarget = false;
+	m_isTracking = false;
+	m_timeSinceValidPose = 0.0f;
+	m_packetsReceived = 0;
+	m_packetsLost = 0;
+	m_lastSeq = 0;
+	m_opticsLookedUp = false;
+	m_pOptics = nullptr;
+	m_signalWasLost = false;
+
+	SyncFilterParams();
+	m_poseFilter.Reset();
+
+	// Everything the phone sends is relative to wherever the entity sits right now.
+	m_referenceTransform = QuatT(GetTargetEntity()->GetWorldRotation(), GetTargetEntity()->GetWorldPos());
+	m_currentTransform = m_referenceTransform;
+
+	CryLog("[PhoneTracker] #%d '%s': listening for pose packets on UDP port %d", GetTrackerId(), m_pEntity->GetName(), m_connection.port.value);
+}
+
+void CPhoneTrackerComponent::CloseSocket()
+{
+	m_socketProblem.clear();
+	if (m_socket != CRY_INVALID_SOCKET)
+	{
+		CrySock::closesocket(m_socket);
+		m_socket = CRY_INVALID_SOCKET;
+		CryLog("[PhoneTracker] #%d '%s': stopped listening on UDP port %d", GetTrackerId(), m_pEntity ? m_pEntity->GetName() : "?", m_connection.port.value);
+	}
+
+#if CRY_PLATFORM_WINAPI
+	if (m_wsaStarted)
+	{
+		::WSACleanup();
+		m_wsaStarted = false;
+	}
+#endif
+
+	m_hasPeer = false;
+	m_isTracking = false;
+}
+
+void CPhoneTrackerComponent::ReceivePackets()
+{
+	if (m_socket == CRY_INVALID_SOCKET)
+		return;
+
+	const int64 engineNowNs = GetEngineNowNs();
+	const bool filtering = m_filter.filterMode != EPoseFilterMode::Off;
+
+	// Drain the socket so the entity always follows the newest pose instead of a backlog.
+	char buffer[256];
+	for (;;)
+	{
+		CRYSOCKADDR_IN from;
+		ZeroStruct(from);
+		CRYSOCKLEN_T fromLength = sizeof(from);
+
+		const int received = CrySock::recvfrom(m_socket, buffer, sizeof(buffer), 0, reinterpret_cast<CRYSOCKADDR*>(&from), &fromLength);
+		if (received <= 0)
+			break;
+
+		m_peer = from;
+		m_hasPeer = true;
+
+		if (received == kLensPacketSize)
+		{
+			SLensPacket lensPacket;
+			memcpy(&lensPacket, buffer, sizeof(lensPacket));
+			if (lensPacket.magic == kLensMagic && lensPacket.version == kProtocolVersion)
+			{
+				ApplyLensPacket(lensPacket);
+			}
+			continue;
+		}
+
+		if (received != kPosePacketSize)
+			continue;
+
+		SPosePacket packet;
+		memcpy(&packet, buffer, sizeof(packet));
+		if (packet.magic != kPoseMagic || packet.version != kProtocolVersion)
+			continue;
+
+		++m_packetsReceived;
+		if (m_packetsReceived > 1 && packet.seq > m_lastSeq + 1)
+		{
+			m_packetsLost += packet.seq - m_lastSeq - 1;
+		}
+		m_lastSeq = packet.seq;
+
+		m_batteryPct = packet.batteryPct;
+		m_appFps = packet.appFps;
+		m_trackingState = packet.trackingState;
+
+		if ((packet.flags & ePoseFlag_Valid) == 0)
+			continue;
+
+		const Vec3 position = ArCoreToCryPosition(packet);
+		const Quat rotation = ArCoreToCryRotation(packet);
+
+		if (filtering && ((packet.flags & ePoseFlag_SessionResumed) != 0 || m_signalWasLost))
+		{
+			// A resumed AR session or a recovered signal invalidates every derivative we hold.
+			m_poseFilter.Reset();
+		}
+		m_signalWasLost = false;
+
+		// The phone bumps originEpoch whenever it recenters; follow it so both ends agree.
+		const bool originChanged = !m_hasOrigin || packet.originEpoch != m_originEpoch || (packet.flags & ePoseFlag_OriginMark) != 0;
+		if (originChanged || m_recenterRequested)
+		{
+			// Capture the filtered pose rather than the raw one, so jitter never gets frozen
+			// into the origin itself.
+			Vec3 originPosition = position;
+			Quat originRotation = rotation;
+			if (filtering && m_poseFilter.HasOutput())
+			{
+				originPosition = m_poseFilter.GetOutput().t;
+				originRotation = m_poseFilter.GetOutput().q;
+			}
+
+			m_trackerOrigin = QuatT(originRotation, originPosition);
+			m_originEpoch = packet.originEpoch;
+			m_hasOrigin = true;
+			m_recenterRequested = false;
+
+			// Re-anchor to wherever the entity currently is, so recentering never teleports it.
+			m_referenceTransform = QuatT(GetTargetEntity()->GetWorldRotation(), GetTargetEntity()->GetWorldPos());
+
+			// Restart the pipeline so the new origin never carries a transient with it.
+			m_poseFilter.Reset();
+		}
+
+		if (filtering)
+		{
+			// The world mapping happens in ApplyPose, once the filter has been resampled.
+			m_poseFilter.Push(packet.frameNs, engineNowNs, position, rotation);
+		}
+		else
+		{
+			m_targetTransform = MapToWorld(position, rotation);
+
+			if (!m_hasTarget)
+			{
+				m_currentTransform = m_targetTransform;
+				m_hasTarget = true;
+			}
+		}
+
+		m_isTracking = true;
+		m_timeSinceValidPose = 0.0f;
+	}
+}
+
+//! Rotation about world Z carrying only the heading of q. With the phone looking straight
+//! up or down the forward axis has no horizontal part, so the heading is taken from the up
+//! axis instead (which is then roughly horizontal).
+static Quat ExtractYaw(const Quat& q)
+{
+	Vec3 forward = q.GetColumn1();
+	if (forward.x * forward.x + forward.y * forward.y < 1e-6f)
+	{
+		const Vec3 up = q.GetColumn2();
+		forward = forward.z > 0.0f ? -up : up;
+	}
+	return Quat::CreateRotationZ(atan2f(-forward.x, forward.y));
+}
+
+//! Maps a tracker space pose (metres, Cry axes) through origin / yaw / scale / offset into world space.
+QuatT CPhoneTrackerComponent::MapToWorld(const Vec3& trackerPosition, const Quat& trackerRotation) const
+{
+	QuatT delta;
+	if (m_mapping.relativeToStartTransform)
+	{
+		// With yaw alignment only the heading of the captured origin is cancelled; pitch and
+		// roll pass through absolute, keeping gravity vertical and the turn axis upright.
+		const Quat originFrame = m_mapping.alignYawOnStart ? ExtractYaw(m_trackerOrigin.q) : m_trackerOrigin.q;
+		const Quat inverseOrigin = originFrame.GetInverted();
+		delta.q = inverseOrigin * trackerRotation;
+		delta.t = inverseOrigin * (trackerPosition - m_trackerOrigin.t);
+	}
+	else
+	{
+		delta = QuatT(trackerRotation, trackerPosition);
+	}
+
+	const Quat yaw = Quat::CreateRotationZ(DEG2RAD(m_mapping.yawOffsetDegrees.value));
+	delta.q = yaw * delta.q;
+	delta.t = yaw * delta.t;
+
+	const QuatT reference = m_mapping.relativeToStartTransform ? m_referenceTransform : QuatT(IDENTITY);
+	// The entity's own tilt must not lean the frame either: heading comes from the entity,
+	// attitude comes from the phone.
+	const Quat referenceRotation = (m_mapping.relativeToStartTransform && m_mapping.alignYawOnStart) ? ExtractYaw(reference.q) : reference.q;
+
+	QuatT result;
+	result.q = referenceRotation * delta.q;
+	result.t = reference.t + referenceRotation * (delta.t * m_mapping.scale.value) + m_mapping.positionOffset;
+	result.q.Normalize();
+	return result;
+}
+
+//! Pushes the reflected properties into the filter; cheap enough to do once per frame.
+void CPhoneTrackerComponent::SyncFilterParams()
+{
+	SPoseFilterParams params;
+	params.posMinCutoff = m_filter.posMinCutoff.value;
+	params.posBeta = m_filter.posBeta.value;
+	params.rotMinCutoff = m_filter.rotMinCutoff.value;
+	params.rotBeta = m_filter.rotBeta.value;
+	params.interpDelayFactor = m_filter.interpDelayFactor.value;
+	params.maxExtrapolationMs = m_filter.maxExtrapolationMs.value;
+	params.tripodEnabled = m_tripod.tripodEnabled;
+	params.tripodEnterSpeed = m_tripod.tripodEnterSpeed.value;
+	params.tripodHoldTime = m_tripod.tripodHoldTime.value;
+	params.tripodExitPosition = m_tripod.tripodExitPosition.value;
+	params.tripodBlendTime = m_tripod.tripodBlendTime.value;
+	m_poseFilter.SetParams(params);
+}
+
+void CPhoneTrackerComponent::ApplyPose(float frameTime)
+{
+	if (m_socket == CRY_INVALID_SOCKET)
+		return;
+
+	if (m_filter.filterMode != EPoseFilterMode::Off)
+	{
+		// Fixed delay resampling plus the virtual tripod, still in tracker space.
+		QuatT filtered = QuatT(IDENTITY);
+		if (m_poseFilter.Sample(GetEngineNowNs(), frameTime, m_filter.filterMode == EPoseFilterMode::Cinematic, filtered))
+		{
+			m_targetTransform = MapToWorld(filtered.t, filtered.q);
+
+			if (!m_hasTarget)
+			{
+				m_currentTransform = m_targetTransform;
+				m_hasTarget = true;
+			}
+		}
+	}
+
+	if (!m_hasTarget)
+		return;
+
+	m_timeSinceValidPose += frameTime;
+	if (m_debug.signalTimeout.value > 0.0f && m_timeSinceValidPose > m_debug.signalTimeout.value)
+	{
+		m_isTracking = false;
+		m_signalWasLost = true;
+	}
+
+	// Framerate independent exponential smoothing; 0 half life means follow the tracker exactly.
+	float blend = 1.0f;
+	if (m_debug.smoothingHalfLife.value > 0.0f)
+	{
+		blend = 1.0f - expf(-gf_ln2 * frameTime / m_debug.smoothingHalfLife.value);
+		blend = clamp_tpl(blend, 0.0f, 1.0f);
+	}
+
+	m_currentTransform.t = Vec3::CreateLerp(m_currentTransform.t, m_targetTransform.t, blend);
+	m_currentTransform.q = Quat::CreateSlerp(m_currentTransform.q, m_targetTransform.q, blend);
+
+	IEntity* pTarget = GetTargetEntity();
+	const Vec3 position = m_mapping.applyPosition ? m_currentTransform.t : pTarget->GetWorldPos();
+	const Quat rotation = m_mapping.applyRotation ? m_currentTransform.q : pTarget->GetWorldRotation();
+
+	pTarget->SetWorldTM(Matrix34::Create(pTarget->GetScale(), rotation, position));
+}
+
+ICinematicCameraOptics* CPhoneTrackerComponent::GetOptics()
+{
+	if (!m_lensLink.driveLens)
+		return nullptr;
+
+	if (!m_opticsLookedUp)
+	{
+		m_opticsLookedUp = true;
+
+		// CinematicCamera.dll is already loaded by the plugin manager when the project uses it;
+		// resolving the entry point by name keeps this plugin usable without it.
+		if (HMODULE hModule = CryLoadLibraryDefName("CinematicCamera"))
+		{
+			if (auto pfn = (TGetCinematicCameraOpticsFn)CryGetProcAddress(hModule, CINEMATIC_CAMERA_OPTICS_ENTRY))
+			{
+				m_pOptics = pfn(GetTargetEntity());
+			}
+
+			if (m_pOptics == nullptr)
+			{
+				CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING, "[PhoneTracker] No Cinematic Camera component on '%s'; lens values from the phone are ignored", GetTargetEntity()->GetName());
+			}
+		}
+		else
+		{
+			CryWarning(VALIDATOR_MODULE_SYSTEM, VALIDATOR_WARNING, "[PhoneTracker] CinematicCamera plugin is not loaded; lens values from the phone are ignored");
+		}
+	}
+
+	return m_pOptics;
+}
+
+IEntity* CPhoneTrackerComponent::GetTargetEntity()
+{
+	if (m_mapping.followActiveCamera)
+	{
+		if (!m_activeCameraLookedUp)
+		{
+			m_activeCameraLookedUp = true;
+			if (HMODULE hModule = CryLoadLibraryDefName("CinematicCamera"))
+				m_pfnActiveCameraEntity = (TGetActiveCinematicCameraEntityFn)CryGetProcAddress(hModule, CINEMATIC_CAMERA_ACTIVE_ENTITY_ENTRY);
+		}
+
+		if (m_pfnActiveCameraEntity != nullptr)
+		{
+			if (IEntity* pActive = m_pfnActiveCameraEntity())
+				return pActive;
+		}
+	}
+
+	return m_pEntity;
+}
+
+void CPhoneTrackerComponent::UpdateTarget()
+{
+	IEntity* pTarget = GetTargetEntity();
+	if (pTarget->GetId() == m_targetEntityId)
+		return;
+
+	const bool firstBinding = (m_targetEntityId == INVALID_ENTITYID);
+	m_targetEntityId = pTarget->GetId();
+	if (firstBinding)
+		return;
+
+	// Camera switch: the controller moves over. The new camera keeps the spot it was placed
+	// at - the next pose re-captures the tracker origin against it (the recenter path), so
+	// the phone carries on from there. The phone's own frame is left alone: no control packet.
+	m_referenceTransform = QuatT(pTarget->GetWorldRotation(), pTarget->GetWorldPos());
+	m_currentTransform = m_referenceTransform;
+	m_targetTransform = m_referenceTransform;
+	m_hasTarget = false;
+	m_recenterRequested = true;
+	m_poseFilter.Reset();
+
+	// The lens link follows too: resolve the new camera's optics and hand it the lens state
+	// the phone last sent, so the cut does not land on stale lens values.
+	m_opticsLookedUp = false;
+	m_pOptics = nullptr;
+	if (m_hasLensState)
+	{
+		if (ICinematicCameraOptics* pOptics = GetOptics())
+		{
+			pOptics->SetFocalLength(m_focalLengthMm);
+			pOptics->SetAperture(m_apertureFNumber);
+			pOptics->SetFocusDistance(m_focusDistanceM);
+			pOptics->SetEVCompensation(m_evCompensation);
+			if (m_lensIso != 0)
+				pOptics->SetISO((float)m_lensIso);
+		}
+	}
+
+	CryLog("[PhoneTracker] #%d '%s': controller now drives '%s'", GetTrackerId(), m_pEntity->GetName(), pTarget->GetName());
+}
+
+void CPhoneTrackerComponent::ApplyLensPacket(const SLensPacket& packet)
+{
+	m_focalLengthMm = packet.focalLengthMm;
+	m_apertureFNumber = packet.apertureFNumber;
+	m_focusDistanceM = packet.focusDistanceM;
+	m_evCompensation = packet.evCompensation;
+	m_lensIso = packet.iso;
+
+	ICinematicCameraOptics* pOptics = GetOptics();
+	if (pOptics == nullptr)
+	{
+		m_hasLensState = true;
+		return;
+	}
+
+	if (m_lensLink.lensArmsEffects)
+	{
+		pOptics->SetDepthOfFieldEnabled((packet.flags & eLensFlag_EnableDepthOfField) != 0);
+		pOptics->SetExposureEnabled((packet.flags & eLensFlag_EnableExposure) != 0);
+	}
+
+	pOptics->SetFocalLength(m_focalLengthMm);
+	pOptics->SetAperture(m_apertureFNumber);
+	pOptics->SetFocusDistance(m_focusDistanceM);
+	pOptics->SetEVCompensation(m_evCompensation);
+	if (packet.iso != 0) // 0 = older phone app that predates the ISO fader
+		pOptics->SetISO((float)packet.iso);
+
+	if ((packet.flags & eLensFlag_AutofocusRequest) != 0)
+		RunAutofocus(pOptics);
+
+	m_hasLensState = true;
+}
+
+// Centre point autofocus: raycast the scene along the camera axis and rack focus to the
+// hit. The DOF user params are eased by the renderer itself (~0.3 s time constant), so the
+// rack glides like a real AF drive without any extra smoothing here. The result is reported
+// back to the phone so its focus fader follows and later 4 Hz lens resends carry it.
+void CPhoneTrackerComponent::RunAutofocus(ICinematicCameraOptics* pOptics)
+{
+	const Vec3 origin = GetTargetEntity()->GetWorldPos();
+	const Vec3 direction = GetTargetEntity()->GetWorldRotation().GetColumn1();
+
+	ray_hit hit;
+	const int hits = gEnv->pPhysicalWorld->RayWorldIntersection(
+		origin + direction * 0.3f, direction * 500.0f,
+		ent_static | ent_terrain | ent_rigid | ent_sleeping_rigid,
+		rwi_stop_at_pierceable | rwi_colltype_any, &hit, 1);
+
+	// No hit: focus to infinity, like an AF drive hunting out to the far stop.
+	const float distance = hits > 0 ? hit.dist + 0.3f : 10000.0f;
+
+	if (pOptics != nullptr)
+		pOptics->SetFocusDistance(distance);
+	m_focusDistanceM = distance;
+
+	SendControl(eControlCmd_SetFocus, (int32)(distance * 1000.0f));
+	CryLog("[PhoneTracker] Autofocus %s at %.2f m", hits > 0 ? "locked" : "no target, racked to infinity", distance);
+}
+
+void CPhoneTrackerComponent::SendControl(EControlCommand cmd, int32 param)
+{
+	if (m_socket == CRY_INVALID_SOCKET || !m_hasPeer)
+		return;
+
+	SControlPacket packet = MakeControlPacket(cmd, ++m_controlSeq, static_cast<int64>(gEnv->pTimer->GetAsyncTime().GetValue()), param);
+	CrySock::sendto(m_socket, reinterpret_cast<char*>(&packet), sizeof(packet), 0, reinterpret_cast<CRYSOCKADDR*>(&m_peer), sizeof(m_peer));
+}
+
+void CPhoneTrackerComponent::Recenter()
+{
+	m_recenterRequested = true;
+	SendControl(eControlCmd_Recenter);
+}
+
+void CPhoneTrackerComponent::SetTrackingEnabled(bool enable)
+{
+	m_connection.enabled = enable;
+	if (enable)
+	{
+		OpenSocket();
+	}
+	else
+	{
+		CloseSocket();
+	}
+}
+
+void CPhoneTrackerComponent::DrawDebug() const
+{
+	const float color[4] = { m_isTracking ? 0.0f : 1.0f, m_isTracking ? 1.0f : 0.3f, 0.3f, 1.0f };
+	const uint32 total = m_packetsReceived + m_packetsLost;
+	const float lossPercent = total > 0 ? 100.0f * m_packetsLost / total : 0.0f;
+
+	// One block per tracker, stacked by creation order so several overlays never overlap.
+	const int slot = max(RegistryIndex(), 0);
+	const float y0 = 20.0f + slot * 100.0f;
+
+	// Which phone feeds this channel: the sender address of the last packet.
+	char szPeer[32] = "no phone yet";
+	if (m_hasPeer)
+	{
+		const uint8* b = reinterpret_cast<const uint8*>(&m_peer.sin_addr.s_addr);
+		cry_sprintf(szPeer, "%u.%u.%u.%u", b[0], b[1], b[2], b[3]);
+	}
+
+	if (m_socket == CRY_INVALID_SOCKET)
+	{
+		const float problemColor[4] = { 1.0f, 0.55f, 0.1f, 1.0f };
+		IRenderAuxText::Draw2dLabel(20.0f, y0, 1.4f, problemColor, false,
+			"Tracker #%d '%s' :%d  %s", GetTrackerId(), m_pEntity->GetName(), m_connection.port.value,
+			!m_socketProblem.empty() ? m_socketProblem.c_str() : (m_connection.enabled ? "SOCKET CLOSED" : "DISABLED"));
+		return;
+	}
+
+	// Which entity the controller currently drives (the active cinematic camera when following).
+	const IEntity* pTarget = gEnv->pEntitySystem->GetEntity(m_targetEntityId);
+	const char* szTarget = pTarget ? pTarget->GetName() : m_pEntity->GetName();
+
+	IRenderAuxText::Draw2dLabel(20.0f, y0, 1.4f, color, false,
+		"Tracker #%d '%s' :%d  from %s  -> '%s'  %s  packets %u  loss %.2f%%  state %u  battery %u%%  app %u fps",
+		GetTrackerId(), m_pEntity->GetName(), m_connection.port.value, szPeer, szTarget,
+		m_isTracking ? "TRACKING" : "NO SIGNAL", m_packetsReceived, lossPercent,
+		m_trackingState, m_batteryPct, m_appFps);
+
+	IRenderAuxText::Draw2dLabel(20.0f, y0 + 20.0f, 1.4f, color, false,
+		"pos (%.3f, %.3f, %.3f)", m_currentTransform.t.x, m_currentTransform.t.y, m_currentTransform.t.z);
+
+	if (m_filter.filterMode != EPoseFilterMode::Off)
+	{
+		const SPoseFilterDebug& filterDebug = m_poseFilter.GetDebug();
+
+		const char* szState = "MOVING";
+		switch (filterDebug.state)
+		{
+		case EPoseFilterTripodState::Arming:   szState = "ARMING"; break;
+		case EPoseFilterTripodState::Steady:   szState = "STEADY"; break;
+		case EPoseFilterTripodState::Blending: szState = "BLEND"; break;
+		default: break;
+		}
+
+		const float filterColor[4] = { 0.85f, 0.9f, 0.7f, 1.0f };
+		IRenderAuxText::Draw2dLabel(20.0f, y0 + 40.0f, 1.4f, filterColor, false,
+			"filter %s  %s %.0f%%  v %.4f m/s  w %.2f deg/s  fc %.2f/%.2f Hz  buffer %d  delay %.1f ms%s",
+			m_filter.filterMode == EPoseFilterMode::Cinematic ? "Cinematic" : "OneEuro", szState,
+			filterDebug.blendWeight * 100.0f, filterDebug.speed, filterDebug.angularSpeedDeg,
+			filterDebug.posCutoff, filterDebug.rotCutoff, filterDebug.bufferDepth,
+			filterDebug.resampleDelayMs,
+			filterDebug.extrapolationMs > 0.0f ? "  EXTRAPOLATING" : "");
+	}
+
+	if (m_hasLensState)
+	{
+		const float lensColor[4] = { 0.7f, 0.85f, 1.0f, 1.0f };
+		IRenderAuxText::Draw2dLabel(20.0f, y0 + 60.0f, 1.4f, lensColor, false,
+			"lens %.0fmm  f/%.1f  focus %.2fm  EV %+.0f  ISO %u%s",
+			m_focalLengthMm, m_apertureFNumber, m_focusDistanceM, m_evCompensation, m_lensIso,
+			m_pOptics != nullptr ? "" : "  (no Cinematic Camera)");
+	}
+}
+
+static void RegisterPhoneTrackerComponent(Schematyc::IEnvRegistrar& registrar)
+{
+	Schematyc::CEnvRegistrationScope scope = registrar.Scope(IEntity::GetEntityScopeGUID());
+	{
+		Schematyc::CEnvRegistrationScope componentScope = scope.Register(SCHEMATYC_MAKE_ENV_COMPONENT(CPhoneTrackerComponent));
+		CPhoneTrackerComponent::Register(componentScope);
+	}
+}
+
+CRY_STATIC_AUTO_REGISTER_FUNCTION(&RegisterPhoneTrackerComponent)
+
+} // namespace PhoneTracker
+} // namespace Cry
