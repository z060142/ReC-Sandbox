+	desc.AddConstant(EFocalStepMode::Continuous, "Continuous", "Continuous");
+	desc.AddConstant(EFocalStepMode::PrimeSet,   "PrimeSet",   "Prime Lens Set");
+	desc.AddConstant(EFocalStepMode::Geometric,  "Geometric",  "Geometric Steps");
+}
