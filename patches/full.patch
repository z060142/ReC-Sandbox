+			m_passAnamorphicThreshold.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+			m_passAnamorphicThreshold.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+			m_passAnamorphicThreshold.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakThreshold, 0);
+			m_passAnamorphicThreshold.SetRenderTarget(0, pStreakSource);
+			m_passAnamorphicThreshold.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A);
+			m_passAnamorphicThreshold.SetTexture(0, m_graphicsPipelineResources.m_pTexHDRTargetScaled[0][0]);
+			m_passAnamorphicThreshold.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+		}
+
+		m_passAnamorphicThreshold.BeginConstantUpdate();
+		m_passAnamorphicThreshold.SetConstant(streakParams1Name, Vec4(streakParams.fAnamorphicThreshold, max(streakParams.fAnamorphicThreshold * 0.25f, 0.01f), 0, 0), eHWSC_Pixel);
+		m_passAnamorphicThreshold.Execute();
+
+		const float fFlareLength = clamp_tpl(streakParams.fAnamorphicLength, 0.0f, 1.0f);
+		float fStride = 1.0f + 3.0f * fFlareLength;
+		float fDecay = 0.60f + 0.38f * fFlareLength;
+
+		const float fFlareScale = streakParams.fAnamorphicAmount / fBloomCompositeWeight;
+		const Vec4 vTint(streakParams.vAnamorphicTint.x, streakParams.vAnamorphicTint.y, streakParams.vAnamorphicTint.z, 0.0f);
+
+		for (int iteration = 0; iteration < kAnamorphicIterations; ++iteration)
+		{
+			const bool bLastIteration = (iteration == kAnamorphicIterations - 1);
+			CFullscreenPass& pass = m_passAnamorphicStretch[iteration];
+
+			// Three iterations need a real ping-pong: source -> pingpong -> source -> bloom.
+			// Reading and writing the same scratch target in one pass is undefined.
+			CTexture* pIterSource = (iteration % 2 == 0) ? pStreakSource : pStreakPingPong;
+			CTexture* pIterTarget = bLastIteration ? m_graphicsPipelineResources.m_pTexHDRFinalBloom
+			                                       : ((iteration % 2 == 0) ? pStreakPingPong : pStreakSource);
+
+			if (pass.IsDirty())
+			{
+				const uint64 nBlendState = bLastIteration ? (GS_BLSRC_ONE | GS_BLDST_ONE) : 0;
+
+				pass.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+				pass.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+				pass.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakStretch, 0);
+				pass.SetRenderTarget(0, pIterTarget);
+				pass.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A | nBlendState);
+				pass.SetTexture(0, pIterSource);
+				pass.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+			}
+
+			pass.BeginConstantUpdate();
+			pass.SetConstant(streakParams0Name, Vec4(fTexelScaleX, 0.0f, fStride, bLastIteration ? fFlareScale : 1.0f), eHWSC_Pixel);
+			pass.SetConstant(streakParams1Name, Vec4(0, 0, fDecay, 0), eHWSC_Pixel);
+			// The coating's colour is applied once, on the pass that reaches the bloom target.
+			pass.SetConstant(streakParams2Name, bLastIteration ? vTint : Vec4(1.0f, 1.0f, 1.0f, 0.0f), eHWSC_Pixel);
+			pass.Execute();
+
+			fStride *= (float)s_nStreakTapCount;
+			fDecay = powf(fDecay, (float)s_nStreakTapCount);
+		}
+	}
+}
+
+// Wave-optics diffraction glare (DiffractionKernelSpec.md).
+//
+// The glare of a point source is not a set of lines someone painted: it is the Fraunhofer
+// diffraction pattern of the pupil the light came through, |F{A}|^2. A 9-blade iris throws 18
+// rays with a specific intensity pattern; a star-shaped mask throws its own; curved blades
+// soften and shorten the rays; an aberrated pupil puts rings around them. All of that is one
+// transform, which the DOF stage's job has already computed by the time we get here - the pupil
+// lives there, so the kernel does too.
+//
+// What is left for this pass is the CONVOLUTION and the SCALE.
+//
+// Scale: a DFT of a pupil d texels across on an L texel grid gives a pattern whose texel pitch
+// on the sensor is lambda * N * d / L. At f/11 on a full frame that is about 0.16 native pixels,
+// so the whole 512^2 texture spans only some 40 pixels of screen. The FFT resolves the
+// STRUCTURE; the REACH has to come from the far-field law, and the pixel shader extrapolates
+// past the texture's edge with the 1/u^2 of a straight edge, read off the kernel's boundary
+// ring. This is also where "sunstars appear when you stop down" comes from for free: N scales
+// the pattern, so stopping down spreads the same energy fraction over a larger pattern - longer
+// rays, dimmer per pixel. No f-number ramp exists anywhere in this path, by design.
+//
+// Convolution: the front filter's sparse sprite convolution in shape - one sprite per surviving
+// source texel, deposited additively - but at HALF resolution and into a layer of its own.
+//
+// Why not quarter, where the rest of the glare family lives. Two separate artefacts, both of
+// them properties of the RASTERIZATION and neither curable by windowing (the previous round
+// tried, and said so in its own comment):
+//
+//   * The SOURCE grid. A lamp clears the threshold over a 3x3 block of quarter-res texels, each
+//     of which spawns its own sprite. The sum of nine copies of a radially symmetric pattern,
+//     offset by the block, has the BLOCK's square as its centre - a square core with straight
+//     sides, whatever the pupil was. Half resolution halves the block in each axis, and the
+//     small Gaussian pre-blur below (sigma ~ 1 half-res texel) makes what is left a round blob
+//     rather than a square one. That blur is not cosmetic either: convolving the pattern with
+//     the source's own extent is exactly what a real extended source does.
+//   * The DEPOSIT grid. A quarter-res deposit is bilinearly magnified 4x on its way to the
+//     screen, and the pattern's slope just outside the core is 1/u^2 - it crosses a whole
+//     quarter-res texel in almost nothing, so the magnification draws 4x4 native blocks. At
+//     half resolution the blocks are 2x2 native and the inner window covers the rest.
+//
+// And why its own layer. The deposit used to go into $HDRFinalBloom, which the tone mapper
+// multiplies by the scene's bloom weight, so the pass had to divide that weight back out. A
+// half-resolution deposit cannot travel that way (the bloom target is quarter), so the glare now
+// owns a half-resolution RGBA16F layer that is composited straight into the HDR target after the
+// bloom stage - the same place and the same reasoning as the DOF's ghost layer. The bloom weight
+// therefore leaves the energy chain entirely: deposit * (1/w) * w becomes deposit. As with the
+// ghosts, the layer is added AFTER every glare threshold has been taken, so halation, the streaks
+// and the front filter never see it - a diffraction pattern cannot itself halate.
+void CBloomStage::ExecuteDiffraction(const SHDRStreaksParams& streakParams, float fBloomCompositeWeight)
+{
+	CDepthOfFieldStage* pDofStage = m_graphicsPipeline.GetStage<CDepthOfFieldStage>();
+	if (pDofStage == nullptr)
+		return;
+
+	const CDiffractionKernel& kernel = pDofStage->GetDiffractionKernel();
+
+	// Not ready yet: the first job takes a frame or two to land, and a pupil change re-runs it.
+	// Draw NOTHING rather than falling back to the analytic lines - a per-frame fallback would
+	// flash the old model on every blade-rotation step.
+	if (!kernel.IsReady())
+		return;
+
+	// $HDRTarget 1/2a is the plain half-resolution HDR downsample of the frame, and it is still
+	// intact here: the bloom chain above works entirely in the two quarter-res scratch targets
+	// and the sun shafts stage, which is the other reader, runs later. It is the same texture
+	// the threshold has always read - what changes is that the thresholded copy now stays at its
+	// resolution instead of being minified into a quarter-res scratch target.
+	CTexture* pHalfHDR = m_graphicsPipelineResources.m_pTexHDRTargetScaled[0][0];
+	if (!CTexture::IsTextureExist(pHalfHDR))
+		return;
+
+	if (!AcquireDiffractionTargets(pHalfHDR->GetWidth(), pHalfHDR->GetHeight()))
+		return;
+
+	CTexture* pSource = m_pTexDiffractionSource;
+	CTexture* pTarget = m_pTexDiffractionLayer;
+
+	if (!CTexture::IsTextureExist(pSource) || !CTexture::IsTextureExist(pTarget))
+		return;
+
+	PROFILE_LABEL_SCOPE("HDR_DIFFRACTION");
+
+	static CCryNameTSCRC techStreakThreshold("HDRStreakThreshold");
+	static CCryNameTSCRC techSourceBlur("HDRDiffractionSourceBlur");
+	static CCryNameR streakParams0Name("StreakParams0");
+	static CCryNameTSCRC techDiffraction("HDRDiffractionPSF");
+	static CCryNameTSCRC techDiffractionDebug("HDRDiffractionDebug");
+	static CCryNameR streakParams1Name("StreakParams1");
+	static CCryNameR diffParams0Name("DiffractionParams0");
+	static CCryNameR diffParams1Name("DiffractionParams1");
+	static CCryNameR diffParams2Name("DiffractionParams2");
+	static CCryNameR diffSpectrumName("DiffractionSpectrum");
+	static CCryNameR diffDebugName("DiffractionDebugParams");
+	static CCryNameR diffDebug1Name("DiffractionDebugParams1");
+
+	// 1. Threshold, the streaks' own technique and their own threshold - one source of glare
+	//    sources for the whole family, so a lamp that streaks also stars and halates. 1:1 now
+	//    (half-res in, half-res out) rather than the 2:1 minification the quarter-res copy was.
+	if (m_passDiffractionThreshold.IsDirty(m_pTexDiffractionSourceTemp->GetTextureID()))
+	{
+		m_passDiffractionThreshold.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passDiffractionThreshold.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passDiffractionThreshold.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakThreshold, 0);
+		m_passDiffractionThreshold.SetRenderTarget(0, m_pTexDiffractionSourceTemp);
+		m_passDiffractionThreshold.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A);
+		m_passDiffractionThreshold.SetTexture(0, pHalfHDR);
+		m_passDiffractionThreshold.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passDiffractionThreshold.BeginConstantUpdate();
+	m_passDiffractionThreshold.SetConstant(streakParams1Name, Vec4(streakParams.fThreshold, max(streakParams.fThreshold * 0.25f, 0.01f), 0, 0), eHWSC_Pixel);
+	m_passDiffractionThreshold.Execute();
+
+	// 1b. Source pre-blur, separable, sigma ~ 1 half-res texel over 5 taps, weights normalised
+	//     so the total excess is preserved exactly. Physically this is the convolution of the
+	//     pattern with the SOURCE's own extent, which is what an extended source really does;
+	//     practically it is what turns the surviving 2x2-ish block of thresholded texels into a
+	//     round blob, so the sum of its sprites no longer wears the grid's square as a core.
+	//     Temp -> source (horizontal) -> temp -> source (vertical) would need a third target, so
+	//     the threshold writes the temp, H goes temp -> source, V goes source -> temp, and the
+	//     pass reads the temp. Name the result once and forget which buffer it landed in.
+	const float fBlurTexelX = 1.0f / (float)max(pSource->GetWidth(), 1);
+	const float fBlurTexelY = 1.0f / (float)max(pSource->GetHeight(), 1);
+
+	if (m_passDiffractionBlurH.IsDirty(pSource->GetTextureID()))
+	{
+		m_passDiffractionBlurH.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passDiffractionBlurH.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passDiffractionBlurH.SetTechnique(CShaderMan::s_shHDRPostProcess, techSourceBlur, 0);
+		m_passDiffractionBlurH.SetRenderTarget(0, pSource);
+		m_passDiffractionBlurH.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A);
+		m_passDiffractionBlurH.SetTexture(0, m_pTexDiffractionSourceTemp);
+		m_passDiffractionBlurH.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passDiffractionBlurH.BeginConstantUpdate();
+	m_passDiffractionBlurH.SetConstant(streakParams0Name, Vec4(fBlurTexelX, 0.0f, 0.0f, 0.0f), eHWSC_Pixel);
+	m_passDiffractionBlurH.Execute();
+
+	if (m_passDiffractionBlurV.IsDirty(m_pTexDiffractionSourceTemp->GetTextureID()))
+	{
+		m_passDiffractionBlurV.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passDiffractionBlurV.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passDiffractionBlurV.SetTechnique(CShaderMan::s_shHDRPostProcess, techSourceBlur, 0);
+		m_passDiffractionBlurV.SetRenderTarget(0, m_pTexDiffractionSourceTemp);
+		m_passDiffractionBlurV.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A);
+		m_passDiffractionBlurV.SetTexture(0, pSource);
+		m_passDiffractionBlurV.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passDiffractionBlurV.BeginConstantUpdate();
+	m_passDiffractionBlurV.SetConstant(streakParams0Name, Vec4(0.0f, fBlurTexelY, 0.0f, 0.0f), eHWSC_Pixel);
+	m_passDiffractionBlurV.Execute();
+
+	// The blurred result is in the temp buffer; that is the sprite grid from here on.
+	pSource = m_pTexDiffractionSourceTemp;
+
+	// The layer is the pass's own and holds nothing from the previous frame.
+	CClearSurfacePass::Execute(pTarget, Clr_Transparent);
+
+	const int32 nGridWidth = pSource->GetWidth();
+	const int32 nGridHeight = pSource->GetHeight();
+	const uint32 nVertexCount = uint32(nGridWidth) * uint32(nGridHeight) * 3 * 2;
+
+	if (!m_pDiffractionPerViewCB)
+	{
+		m_pDiffractionPerViewCB = gcpRendD3D->m_DevBufMan.CreateConstantBuffer(sizeof(HLSL_PerViewGlobalConstantBuffer));
+		if (m_pDiffractionPerViewCB)
+			m_pDiffractionPerViewCB->SetDebugName("Diffraction Per-View CB");
+	}
+
+	if (!m_pDiffractionPerViewCB)
+		return;
+
+	// The pattern's texel pitch on the sensor, in HALF RESOLUTION pixels - the unit the sprite
+	// grid is measured in. The width in the conversion is the GRID's width, so moving the pass
+	// from quarter to half resolution doubles the pitch by itself; nothing else in this block
+	// knows or cares which resolution it is at.
+	//
+	//   s = lambda0 * N_geo * d / L        (metres on the sensor)
+	//   s_h = s * grid_width / sensor_width
+	//
+	// N is the geometric aperture the DOF resolved (max(N, N_mask) with a mask bound), because
+	// a mask stops the light down just as the iris does and the pattern follows the hole light
+	// actually passed.
+	const float kLambda0 = 550e-9f;
+	const float fSensorWidthM = max(pDofStage->GetDiffractionSensorWidthMM(), 1.0f) * 0.001f;
+	const float fPitchHalfPx = max(kLambda0 * pDofStage->GetDiffractionNGeo() * kernel.GetTexelPitchPupilUnits()
+	                                  * (float)nGridWidth / fSensorWidthM, 1e-6f);
+
+	// Sprite radius, a fraction of the frame HEIGHT so the reach is the same at any aspect
+	// ratio. This is purely where the extrapolated tail is CUT OFF - a cost and coverage choice,
+	// not a property of the lens. Bigger = more of the faint tail, quadratically more pixels.
+	const float fRadiusHalfPx = max(streakParams.fWaveReach * (float)nGridHeight, 2.0f);
+
+	// Anamorphic: the iris sits BEHIND the cylindrical front group, so its pattern is formed
+	// unsqueezed and then stretched horizontally by the desqueeze - the sprite's x half extent
+	// is multiplied by S. This is the OPPOSITE of the front filter PSF, which is a plate in
+	// front of the cylinder and is therefore squeezed like the rest of the picture. The analytic
+	// streaks do neither: they march in texel space and ignore the squeeze entirely, which is a
+	// known simplification of that model and is left exactly as it is.
+	const float fSqueeze = clamp_tpl(PostEffectMgr()->GetByNameF("Dof_User_AnamorphicSqueeze"), 1.0f, 2.0f);
+
+	const float fRadiusNdcY = 2.0f * fRadiusHalfPx / (float)nGridHeight;
+	const float fRadiusNdcX = 2.0f * (fRadiusHalfPx * fSqueeze) / (float)nGridWidth;
+
+	// Energy. The kernel texture is ALREADY the physical answer: the CPU normalised the full
+	// pattern to Parseval (sum I = 1 = the pupil's whole transmitted light) BEFORE removing the
+	// core, so what is left in the texture integrates to 1 - E_core, and the extrapolated tail
+	// out to the sprite's rim adds its own logarithmic share. A source of excess E therefore
+	// deposits E * amount * I(u) per kernel texel - and NOT one factor more. There is no
+	// renormalisation of the glare to unit integral here: that would hand the pattern the
+	// source's entire excess (some 14x too much for an 8-blade iris, whose diffracted fraction
+	// is 1 - E_core ~ 0.07) and would make the deposit depend on where the sprite happens to be
+	// cut off, which is a cost choice and not physics.
+	//
+	// The ONE conversion that stays is texel -> pixel: the sprite rasterizes half-resolution
+	// pixels, each of which covers 1 / s_h^2 kernel texels, so the per-pixel deposit is
+	// I / s_h^2. Amount 1 is then the physical fraction (the log line prints it); above 1 is
+	// explicitly the exaggeration side.
+	//
+	// Note what is NOT here any more: the 1 / bloom-composite-weight divide. The deposit used to
+	// land in $HDRFinalBloom, which the tone mapper scales by that weight, so the pass undid it
+	// first and the screen saw deposit * (1/w) * w. The layer is composited straight into the HDR
+	// target, so the screen sees deposit - the same number, one factor fewer. Moving to half
+	// resolution does not change the total either: the pitch doubles, so 1 / s_h^2 is a quarter
+	// of 1 / s_q^2, and the sprite covers four times as many pixels.
+	const float fRingRadius = max(kernel.GetRingRadius(), 1.0f);
+	const float fSpriteRadiusTexels = max(fRadiusHalfPx / fPitchHalfPx, fRingRadius);
+	// Diagnostic only now: the fraction of the source's light this pattern actually receives at
+	// amount 1, texture plus the tail the sprite is wide enough to hold.
+	//
+	// 0.9 R, not R: the pixel shader multiplies by a RADIAL window that feathers away over the
+	// last 20% of the sprite radius, because the quad's own boundary is otherwise a hard cut and
+	// draws a white square frame around every small emitter. The window removes rather more than
+	// half of that last fifth of the LOG integral, and 0.9 R is the honest one-line stand-in.
+	// (The shader also fades the innermost four half-res pixels out to stop the 1/u^2 slope
+	// showing as blocks - the same eight NATIVE pixels the quarter-res version faded over two of
+	// its own. That one is NOT in this number: it is the steepest
+	// part of the pattern and its integral needs the kernel's radial profile, which lives on the
+	// job side. The radius it removes is logged below in kernel texels so the size of the hole
+	// is at least visible.)
+	const float fGlareFraction = max(kernel.GetTextureIntegral()
+	                                 + kernel.GetTailCoefficient() * logf(max(0.9f * fSpriteRadiusTexels / fRingRadius, 1.0f)), 0.0f);
+	// The inner window's radius (4 half-res pixels = 8 native) expressed in kernel texels, for
+	// the log. Must match kDiffractionInnerWindowPx in the pixel shader.
+	const float fInnerWindowTexels = 4.0f / fPitchHalfPx;
+	const float fNorm = 1.0f / (fPitchHalfPx * fPitchHalfPx);
+	const float fEnergy = streakParams.fWaveAmount;
+
+	// The mip level the sprite reads the kernel at. One half-resolution pixel spans
+	// 1 / s_h kernel texels - seventeen at f/16, a hundred wide open - and the rays inside the
+	// kernel are one or two texels across, so a single tap lands on a ray about one time in
+	// seventeen and the pattern vanishes from the picture. Reading level log2(1 / s_h) instead
+	// gives the pixel the MEAN intensity over its own footprint in one tap, and the 1 / s_h^2
+	// above then turns that mean into the true integral over the footprint. The shader redoes
+	// this per wavelength (the pattern is stretched by lambda0 / lambda); what is passed is the
+	// ceiling, the coarsest level that exists.
+	const float fMaxLod = (float)max(kernel.GetKernelMipCount() - 1, 0);
+	const float fLodRef = clamp_tpl(logf(max(1.0f / fPitchHalfPx, 1.0f)) / logf(2.0f), 0.0f, fMaxLod);
+
+	// Spectral sampling. Each wavelength is a SCALED copy of the same pattern -
+	// PSF_lambda(u) = (l0/l)^2 * PSF_l0(u * l0/l) - so blue sits compact near the core and red
+	// runs out to the tips. That is what makes a real sunstar's rays rainbow: dispersion, not a
+	// hue ramp. The six columns are rescaled once so their weighted sum is exactly white.
+	Vec4 vSpectrum[6];
+	{
+		static const float s_lambdaNm[6] = { 420.0f, 470.0f, 520.0f, 570.0f, 620.0f, 670.0f };
+		static const Vec3  s_colour[6] =
+		{
+			Vec3(0.05f, 0.00f, 0.35f), Vec3(0.00f, 0.10f, 0.50f), Vec3(0.00f, 0.55f, 0.15f),
+			Vec3(0.35f, 0.35f, 0.00f), Vec3(0.45f, 0.00f, 0.00f), Vec3(0.15f, 0.00f, 0.00f)
+		};
+
+		Vec3 vSum(0.0f, 0.0f, 0.0f);
+		float fRatio[6];
+		float fWeight[6];
+		for (int i = 0; i < 6; ++i)
+		{
+			fRatio[i] = 550.0f / s_lambdaNm[i];
+			fWeight[i] = fRatio[i] * fRatio[i];
+			vSum += s_colour[i] * fWeight[i];
+		}
+
+		const Vec3 vScale(1.0f / max(vSum.x, 1e-4f), 1.0f / max(vSum.y, 1e-4f), 1.0f / max(vSum.z, 1e-4f));
+		for (int i = 0; i < 6; ++i)
+		{
+			const Vec3 c = s_colour[i] * fWeight[i];
+			vSpectrum[i] = Vec4(c.x * vScale.x, c.y * vScale.y, c.z * vScale.z, fRatio[i]);
+		}
+	}
+
+	// Diagnostics. The debug modes are all one cvar, read once here.
+	//   1 - the kernel texture in the corner (below).
+	//   2 - shape only: the sprite pass runs untouched but deposits the PATTERN at full
+	//       visibility instead of its energy, so "does it draw, where, how big, what shape"
+	//       is answered without any argument about brightness.
+	//   3 - the thresholded sources in the corner, plus the brightest excess in the log.
+	const int nDebugMode = CRenderer::CV_r_HDRDiffractionDebug;
+
+	// The sprite's half extent in NATIVE pixels - the number that says how big the figure is on
+	// the screen the user is looking at, as opposed to the half-resolution grid it is
+	// rasterized in. This is also the cost dial: the sprite is twice as wide in pixels as it was
+	// at quarter resolution and there are four times as many candidate cells, so if the scene
+	// gets slow, Streak Reach is the parameter to pull.
+	CTexture* pNativeTarget = m_graphicsPipelineResources.m_pTexHDRTarget;
+	const float fNativeScaleX = CTexture::IsTextureExist(pNativeTarget) ? (float)pNativeTarget->GetWidth() / (float)nGridWidth : 2.0f;
+	const float fNativeScaleY = CTexture::IsTextureExist(pNativeTarget) ? (float)pNativeTarget->GetHeight() / (float)nGridHeight : 2.0f;
+	const float fHalfExtentNativeX = fRadiusHalfPx * fSqueeze * fNativeScaleX;
+	const float fHalfExtentNativeY = fRadiusHalfPx * fNativeScaleY;
+
+	// Once per change, never per frame: what the pattern actually resolves to on screen.
+	{
+		static float s_lastPitch = -1.0f, s_lastAmount = -1.0f, s_lastReach = -1.0f, s_lastDispersion = -1.0f, s_lastN = -1.0f;
+		static int   s_lastDebug = -1;
+		if (fabsf(fPitchHalfPx - s_lastPitch) > 0.0005f || fabsf(streakParams.fWaveAmount - s_lastAmount) > 0.005f ||
+		    fabsf(streakParams.fWaveReach - s_lastReach) > 0.005f || fabsf(streakParams.fDispersion - s_lastDispersion) > 0.005f ||
+		    fabsf(pDofStage->GetDiffractionNGeo() - s_lastN) > 0.01f || nDebugMode != s_lastDebug)
+		{
+			s_lastPitch = fPitchHalfPx;
+			s_lastAmount = streakParams.fWaveAmount;
+			s_lastReach = streakParams.fWaveReach;
+			s_lastDispersion = streakParams.fDispersion;
+			s_lastN = pDofStage->GetDiffractionNGeo();
+			s_lastDebug = nDebugMode;
+			CryLog("[BLOOM] diffraction glare amount=%.2f reach=%.2f disp=%.2f N=%.1f -> pitch=%.3f half-px/texel (%.1f texels/px) lod=%.1f of %.0f sprite=%.0f half-px (%.0f texels, %.0f native px) core=%.2f window: outer 0.8-1.0 R, inner 4 half-px (%.0f texels) deposited glare fraction=%.3f norm=%.3g",
+			       streakParams.fWaveAmount, streakParams.fWaveReach, streakParams.fDispersion,
+			       pDofStage->GetDiffractionNGeo(), fPitchHalfPx, 1.0f / fPitchHalfPx, fLodRef, fMaxLod,
+			       fRadiusHalfPx, fSpriteRadiusTexels, fHalfExtentNativeY,
+			       kernel.GetCoreFraction(), fInnerWindowTexels, fGlareFraction * streakParams.fWaveAmount, fNorm);
+
+			// With a debug mode on, print the rest of the chain too: the whole path from a
+			// source's excess to a pixel is E * energy * I * norm, and energy already carries
+			// the bloom-weight divide, so these three numbers plus the ones above are the
+			// complete story.
+			if (nDebugMode > 0)
+			{
+				// energy IS the amount now: the layer is composited straight into the HDR
+				// target, so the tone mapper's bloom weight (printed for reference only) no
+				// longer stands between the deposit and the screen.
+				CryLog("[BLOOM] diffraction glare debug=%d energy=%.4g (= amount %.2f, own half-res layer, scene bloom weight %.4g no longer applies) sprite half extent = %.0f x %.0f native px",
+				       nDebugMode, fEnergy, streakParams.fWaveAmount, fBloomCompositeWeight,
+				       fHalfExtentNativeX, fHalfExtentNativeY);
+			}
+		}
+	}
+
+	// 2. One sprite per surviving source texel. The per-view constant buffer describes the
+	//    half-resolution GRID the vertex shader walks, not the render target - the same
+	//    separation the front filter and the DOF's splat and ghost passes use. Here the two
+	//    happen to be the same size, but the separation is what keeps that a coincidence.
+	const SRenderViewInfo& viewInfo = m_graphicsPipeline.GetCurrentViewInfo(CCamera::eEye_Left);
+	const SRenderViewport customViewport(0, 0, nGridWidth, nGridHeight);
+	m_graphicsPipeline.GeneratePerViewConstantBuffer(&viewInfo, (int)m_graphicsPipeline.GetViewInfoCount(), m_pDiffractionPerViewCB, &customViewport);
+
+	D3DViewPort viewport;
+	viewport.TopLeftX = 0.0f;
+	viewport.TopLeftY = 0.0f;
+	viewport.Width = (float)pTarget->GetWidth();
+	viewport.Height = (float)pTarget->GetHeight();
+	viewport.MinDepth = 0.0f;
+	viewport.MaxDepth = 1.0f;
+
+	m_passDiffraction.SetRenderTarget(0, pTarget);
+	m_passDiffraction.SetViewport(viewport);
+	m_passDiffraction.BeginAddingPrimitives();
+
+	CRenderPrimitive& prim = m_diffractionPrimitive;
+	prim.SetFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_VS | CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+	prim.SetTechnique(CShaderMan::s_shHDRPostProcess, techDiffraction, 0);
+	prim.SetRenderState(GS_NODEPTHTEST | GS_NOCOLMASK_A | GS_BLSRC_ONE | GS_BLDST_ONE);
+	prim.SetCullMode(eCULL_None);
+
+	prim.SetCustomVertexStream(~0u, EDefaultInputLayouts::Empty, 0);
+	prim.SetDrawInfo(eptTriangleList, 0, 0, nVertexCount);
+
+	prim.SetTexture(0, pSource, EDefaultResourceViews::Default, EShaderStage_Vertex);
+	prim.SetTexture(1, kernel.GetKernelTexture(), EDefaultResourceViews::Default, EShaderStage_Pixel);
+	prim.SetTexture(2, kernel.GetRingTexture(), EDefaultResourceViews::Default, EShaderStage_Pixel);
+	prim.SetSampler(0, EDefaultSamplerStates::PointClamp, EShaderStage_Vertex);
+	// TRILINEAR, not LinearClamp: FILTER_LINEAR is built with MaxLOD 0, which would silently
+	// pin every SampleLevel to mip 0 and undo the prefiltering the kernel exists for.
+	prim.SetSampler(1, EDefaultSamplerStates::TrilinearClamp, EShaderStage_Pixel);
+	// The ring is an angle, so it WRAPS: theta = -pi and theta = +pi are the same direction and
+	// a clamped sampler would flatten the pattern along the -x axis.
+	prim.SetSampler(2, EDefaultSamplerStates::LinearWrap, EShaderStage_Pixel);
+
+	prim.SetInlineConstantBuffer(eConstantBufferShaderSlot_PerView, m_pDiffractionPerViewCB, EShaderStage_Vertex | EShaderStage_Pixel);
+
+	if (prim.Compile(m_passDiffraction) != CRenderPrimitive::eDirty_None)
+	{
+		static bool s_bWarned = false;
+		if (!s_bWarned)
+		{
+			s_bWarned = true;
+			CryLogAlways("[BLOOM] diffraction primitive failed to compile - pass skipped");
+		}
+		return;
+	}
+
+	const Vec4 vDiffParams0(fRadiusHalfPx, fPitchHalfPx, fRingRadius, fNorm);
+	// w carries the debug mode into both the sprite shader (mode 2 replaces the deposit) and
+	// the corner shader (mode 3 draws the sources instead of the kernel). Mode 0 leaves it at
+	// zero, which is exactly what it was before the modes existed.
+	const Vec4 vDiffParams1(clamp_tpl(streakParams.fDispersion, 0.0f, 1.0f), (float)kernel.GetGridSize(), fMaxLod, (float)nDebugMode);
+	const Vec4 vDiffParams2(fRadiusNdcX, fRadiusNdcY, fEnergy, 0.0f);
+
+	auto& constantManager = prim.GetConstantManager();
+	constantManager.BeginNamedConstantUpdate();
+	constantManager.SetNamedConstant(diffParams2Name, vDiffParams2, eHWSC_Vertex);
+	constantManager.SetNamedConstant(diffParams0Name, vDiffParams0, eHWSC_Pixel);
+	constantManager.SetNamedConstant(diffParams1Name, vDiffParams1, eHWSC_Pixel);
+	constantManager.SetNamedConstantArray(diffSpectrumName, vSpectrum, 6, eHWSC_Pixel);
+	constantManager.EndNamedConstantUpdate(&viewport, m_graphicsPipeline.GetCurrentRenderView());
+
+	m_passDiffraction.AddPrimitive(&prim);
+	m_passDiffraction.Execute();
+
+	// 3. The corner view. r_HDRDiffractionDebug 1 draws the kernel itself on a log tone curve -
+	//    the whole L x L texture fitted into a square half the frame height (the spec's "4x"
+	//    would be 2048 px, larger than the frame at 1080p), which is what makes the ray
+	//    structure and the core hole readable at a glance. Mode 3 draws the pass's own
+	//    thresholded SOURCE texture in the same place at the same half-height scale, keeping the
+	//    frame's aspect so it reads as a small copy of the picture: it answers whether anything
+	//    at all cleared HDR_Streaks_Threshold and by how much. Mode 2 has no corner view - its
+	//    whole output is the sprite pass itself.
+	if (nDebugMode == 1 || nDebugMode == 3)
+	{
+		const float fDisplaySize = (float)max(nGridHeight / 2, 16);
+		// The kernel is square and fills the square; the source frame keeps its own aspect, so
+		// both axes are scaled by the same "half the frame height" factor.
+		const float fDisplayFracX = (nDebugMode == 3) ? (fDisplaySize / (float)nGridHeight) : (fDisplaySize / (float)nGridWidth);
+		const float fDisplayFracY = fDisplaySize / (float)nGridHeight;
+
+		if (m_passDiffractionDebug.IsDirty(kernel.GetKernelTexture()->GetTextureID(), pSource->GetTextureID(), nDebugMode))
+		{
+			m_passDiffractionDebug.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+			m_passDiffractionDebug.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+			m_passDiffractionDebug.SetTechnique(CShaderMan::s_shHDRPostProcess, techDiffractionDebug, 0);
+			m_passDiffractionDebug.SetRenderTarget(0, pTarget);
+			m_passDiffractionDebug.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A | GS_BLSRC_ONE | GS_BLDST_ONE);
+			// Slot 1 and sampler 1: the debug shader shares the sprite pass's declarations, and
+			// there t1 is the kernel and s1 the linear clamp sampler. Slot 0 is the source the
+			// sprite pass's vertex shader reads, which is what mode 3 puts on screen - point
+			// sampled, so one displayed pixel is one real source texel and a lone bright texel
+			// cannot be blurred away into invisibility.
+			m_passDiffractionDebug.SetTexture(1, kernel.GetKernelTexture());
+			m_passDiffractionDebug.SetSampler(1, EDefaultSamplerStates::LinearClamp);
+			m_passDiffractionDebug.SetTexture(0, pSource);
+			m_passDiffractionDebug.SetSampler(0, EDefaultSamplerStates::PointClamp);
+		}
+
+		// The kernel integrates to well under one over a quarter of a million texels, so a raw
+		// display is black. 1e6 puts a typical ray texel in the middle of the log curve.
+		const float kDebugGain = 1.0e6f;
+		m_passDiffractionDebug.BeginConstantUpdate();
+		// Output scale 1: the corner view draws into the glare's own layer, which is added to
+		// the HDR target as it stands. There is no bloom weight left to divide back out.
+		m_passDiffractionDebug.SetConstant(diffDebugName,
+		                                   Vec4(fDisplayFracX, fDisplayFracY,
+		                                        kDebugGain, 1.0f), eHWSC_Pixel);
+		m_passDiffractionDebug.SetConstant(diffParams1Name, vDiffParams1, eHWSC_Pixel);
+		// The source's own texel grid, which is what mode 3's 5x5 max walks. The panel is a half
+		// size copy of the half-resolution source, so it still minifies 2:1 and a one-texel
+		// source would be point sampled away three times out of four without it. What the panel
+		// shows now is the thresholded source AFTER the pre-blur - which is the right answer: it
+		// is what the sprite grid actually reads.
+		m_passDiffractionDebug.SetConstant(diffDebug1Name,
+		                                   Vec4(1.0f / (float)max(nGridWidth, 1), 1.0f / (float)max(nGridHeight, 1), 0.0f, 0.0f), eHWSC_Pixel);
+		m_passDiffractionDebug.Execute();
+	}
+
+	// 4. Mode 3 also puts a NUMBER on the sources, because "is that grey square bright enough"
+	//    is exactly the question the picture cannot answer. Once a second: blit the quarter
+	//    resolution excess into a readback target, issue the staging download, and map it on a
+	//    later frame when the fence has signalled - a copy of some 130 kpx at 1080p, off the
+	//    critical path, and only while the mode is on.
+	UpdateDiffractionSourceReadback(nDebugMode, pSource, streakParams.fThreshold);
+
+	// The layer now holds this frame's glare. ExecuteDiffractionComposite() adds it to the HDR
+	// target once the pipeline is past every glare threshold.
+	m_bDiffractionLayerValid = true;
+}
+
+// The readback half of r_HDRDiffractionDebug 3. Split out because it is a small state machine
+// and has nothing to do with the drawing above.
+void CBloomStage::UpdateDiffractionSourceReadback(int nDebugMode, CTexture* pSource, float fThreshold)
+{
+	if (nDebugMode != 3)
+	{
+		// Do not free while a download is still in flight - the staging resource is the target
+		// of a GPU copy that has not necessarily retired.
+		if (!m_bDiffractionReadbackIssued)
+		{
+			m_pTexDiffractionReadback.reset();
+			m_bDiffractionReadbackStalled = false;
+		}
+		return;
+	}
+
+	const int nWidth = pSource->GetWidth();
+	const int nHeight = pSource->GetHeight();
+
+	if (!CTexture::IsTextureExist(m_pTexDiffractionReadback) ||
+	    m_pTexDiffractionReadback->GetWidth() != nWidth || m_pTexDiffractionReadback->GetHeight() != nHeight)
+	{
+		if (m_bDiffractionReadbackIssued)
+			return;
+
+		// FT_STAGE_READBACK is what gives the texture a PERSISTENT staging resource, which is
+		// what makes the two-phase (issue now, map later) download possible at all - the
+		// one-shot CDeviceTexture::DownloadToStagingResource(sub, hook) allocates a temporary
+		// one and Maps it immediately, which under D3D11 is a full pipeline stall.
+		const uint32 flags = FT_NOMIPS | FT_DONT_STREAM | FT_USAGE_RENDERTARGET | FT_STAGE_READBACK;
+		const std::string id = m_graphicsPipeline.GetUniqueIdentifierName();
+		// Half float RGBA regardless of what the HDR chain is packed in: the blit converts, and
+		// four halves per texel is a format the CPU side can decode without knowing anything
+		// about R11G11B10's exponent layout.
+		m_pTexDiffractionReadback = CTexture::GetOrCreateRenderTarget(("$DiffractionSourceReadback" + id).c_str(),
+		                                                             nWidth, nHeight, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+
+		if (!CTexture::IsTextureExist(m_pTexDiffractionReadback))
+		{
+			m_pTexDiffractionReadback.reset();
+			CryLogAlways("[BLOOM] diffraction source readback: could not create the %d x %d staging target - no max-excess reports", nWidth, nHeight);
+			return;
+		}
+
+		// Once, when the mode is switched on. Without it, silence is ambiguous: it could mean
+		// the download never completes, or that this function is never reached at all.
+		CryLog("[BLOOM] diffraction source readback armed (%d x %d half-res, one report a second)", nWidth, nHeight);
+		m_fDiffractionReadbackTime = 0.0f;
+	}
+
+	CDeviceTexture* pDevTex = m_pTexDiffractionReadback->GetDevTexture();
+	if (pDevTex == nullptr)
+		return;
+
+	const float fNow = gEnv->pTimer->GetAsyncCurTime();
+
+	if (m_bDiffractionReadbackIssued)
+	{
+		// Not signalled yet: come back next frame. The whole point of the two-phase download is
+		// that this never blocks.
+		if (!pDevTex->AccessCurrStagingResource(0, false))
+		{
+			// A fence that never signals would otherwise be indistinguishable from "no sources":
+			// say so, once, rather than going quiet for the rest of the session.
+			if ((fNow - m_fDiffractionReadbackTime) > 5.0f && !m_bDiffractionReadbackStalled)
+			{
+				m_bDiffractionReadbackStalled = true;
+				CryLogAlways("[BLOOM] diffraction source readback: the staging download has not signalled in 5 s - no max-excess reports");
+			}
+			return;
+		}
+		m_bDiffractionReadbackStalled = false;
+
+		float fMaxExcess = 0.0f;
+		int nMaxX = 0, nMaxY = 0;
+
+		const auto readbackData = [nWidth, nHeight, &fMaxExcess, &nMaxX, &nMaxY](void* pData, uint32 rowPitch, uint32 slicePitch) -> bool
+		{
+			const uint8* pRow = static_cast<const uint8*>(pData);
+			for (int y = 0; y < nHeight; ++y, pRow += rowPitch)
+			{
+				const CryHalf* pTexel = reinterpret_cast<const CryHalf*>(pRow);
+				for (int x = 0; x < nWidth; ++x, pTexel += 4)
+				{
+					// The threshold pass keeps the source's hue, so the brightest channel is
+					// the number that decides whether this source draws anything at all.
+					const float e = max(max(CryConvertHalfToFloat(pTexel[0]), CryConvertHalfToFloat(pTexel[1])),
+					                    CryConvertHalfToFloat(pTexel[2]));
+					if (e > fMaxExcess)
+					{
+						fMaxExcess = e;
+						nMaxX = x;
+						nMaxY = y;
+					}
+				}
+			}
+			return true;
+		};
+
+		pDevTex->AccessCurrStagingResource(0, false, readbackData);
+		m_bDiffractionReadbackIssued = false;
+		// Time the cadence from the REPORT, not from the request, so a slow fence cannot turn
+		// this into a per-frame download.
+		m_fDiffractionReadbackTime = fNow;
+
+		CryLog("[BLOOM] diffraction sources: max excess = %.1f (threshold %.1f) at (%d, %d) half-res",
+		       fMaxExcess, fThreshold, nMaxX, nMaxY);
+		return;
+	}
+
+	if (m_fDiffractionReadbackTime > 0.0f && (fNow - m_fDiffractionReadbackTime) < 1.0f)
+		return;
+
+	m_passDiffractionReadbackCopy.Execute(pSource, m_pTexDiffractionReadback);
+	pDevTex->DownloadToStagingResource(0);
+	m_bDiffractionReadbackIssued = true;
+	m_fDiffractionReadbackTime = fNow;
+}
+
+// The glare layer's composite. Called by the pipeline right after the bloom stage, in the same
+// window as the DOF's ghost composite and for the same reason: every glare threshold in the frame
+// has already been taken, so nothing downstream can re-light off the pattern. A diffraction
+// pattern halating, or growing streaks of its own, would be a second-order effect of a
+// second-order effect - and the ghosts settled that argument already.
+//
+// Additive and bilinear: the layer holds only what the sprites deposited, and it is half
+// resolution against a native HDR target. Alpha is masked off - the HDR target's alpha is not
+// ours.
+void CBloomStage::ExecuteDiffractionComposite()
+{
+	// Consume-once. A frame in which the glare pass never ran leaves the flag false and this a
+	// no-op, exactly as with the ghosts.
+	if (!m_bDiffractionLayerValid)
+		return;
+
+	m_bDiffractionLayerValid = false;
+
+	CTexture* pLayer = m_pTexDiffractionLayer;
+	CTexture* pHDRTarget = m_graphicsPipelineResources.m_pTexHDRTarget;
+	if (!CTexture::IsTextureExist(pLayer) || !CTexture::IsTextureExist(pHDRTarget))
+		return;
+
+	PROFILE_LABEL_SCOPE("HDR_DIFFRACTION_COMPOSITE");
+
+	static CCryNameTSCRC techDiffractionComposite("HDRDiffractionComposite");
+
+	if (m_passDiffractionComposite.IsDirty(pLayer->GetTextureID()))
+	{
+		m_passDiffractionComposite.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passDiffractionComposite.SetTechnique(CShaderMan::s_shHDRPostProcess, techDiffractionComposite, 0);
+		m_passDiffractionComposite.SetRenderTarget(0, pHDRTarget);
+		m_passDiffractionComposite.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A | GS_BLSRC_ONE | GS_BLDST_ONE);
+		m_passDiffractionComposite.SetTexture(0, pLayer);
+		m_passDiffractionComposite.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passDiffractionComposite.BeginConstantUpdate();
+	m_passDiffractionComposite.Execute();
+}
+
+bool CBloomStage::AcquireDiffractionTargets(int halfWidth, int halfHeight)
+{
+	const int w = max(halfWidth, 1);
+	const int h = max(halfHeight, 1);
+
+	if (m_pTexDiffractionSource && m_pTexDiffractionSourceTemp && m_pTexDiffractionLayer &&
+	    m_diffractionLayerWidth == w && m_diffractionLayerHeight == h)
+		return true;
+
+	ReleaseDiffractionTargets();
+
+	// RGBA16F for all three: the source carries an HDR excess with its hue, and the layer
+	// carries a deposit that has already been multiplied by Streak Amount. R11G11B10 would cost
+	// the layer its blue precision exactly where the dispersion puts blue - at the core.
+	const uint32 flags = FT_NOMIPS | FT_DONT_STREAM | FT_USAGE_RENDERTARGET;
+	const std::string id = m_graphicsPipeline.GetUniqueIdentifierName();
+	m_pTexDiffractionSource     = CTexture::GetOrCreateRenderTarget(("$DiffractionSource" + id).c_str(),     w, h, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+	m_pTexDiffractionSourceTemp = CTexture::GetOrCreateRenderTarget(("$DiffractionSourceTemp" + id).c_str(), w, h, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+	m_pTexDiffractionLayer      = CTexture::GetOrCreateRenderTarget(("$DiffractionLayer" + id).c_str(),      w, h, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+
+	if (!CTexture::IsTextureExist(m_pTexDiffractionSource) || !CTexture::IsTextureExist(m_pTexDiffractionSourceTemp) ||
+	    !CTexture::IsTextureExist(m_pTexDiffractionLayer))
+	{
+		ReleaseDiffractionTargets();
+		return false;
+	}
+
+	m_diffractionLayerWidth = w;
+	m_diffractionLayerHeight = h;
+	CryLog("[BLOOM] diffraction glare targets acquired: %d x %d half-res (source, blur scratch, layer)", w, h);
+	return true;
+}
+
+void CBloomStage::ReleaseDiffractionTargets()
+{
+	m_pTexDiffractionSource.reset();
+	m_pTexDiffractionSourceTemp.reset();
+	m_pTexDiffractionLayer.reset();
+	m_diffractionLayerWidth = 0;
+	m_diffractionLayerHeight = 0;
+	m_bDiffractionLayerValid = false;
+}
+
+// Front filter point spread function (FilterPSFSpec.md).
+//
+// A cross-screen / star filter is a plate of etched grooves mounted in FRONT of the lens, so
+// every bright point in the frame is diffracted into the same fixed pattern - lines
+// perpendicular to the grooves, at whatever angle the plate is turned to, with rainbow
+// dispersion toward their ends. Brighter sources show LONGER lines not because the pattern
+// changes but because more of its faint tail rises above the scene, which is exactly what
+// falls out of a convolution: the picture is the scene convolved with one fixed PSF.
+//
+// The convolution is done sparsely - one textured sprite per bright quarter-resolution texel,
+// deposited additively into the bloom target - so the cost follows the number of bright
+// sources rather than the frame area. The PSF is an authored RGB texture (like the bokeh
+// shape mask), which is what makes the same pass cover any other front-element PSF a preset
+// may want; a procedural N-point star stands in when nothing is bound.
+//
+// Runs after ExecuteStreaks, in the window where both quarter resolution scratch targets are
+// free again (the same one ExecuteHalation uses). Nothing here follows the f-number and
+// nothing is turned by the iris phase: a plate is not the aperture.
+void CBloomStage::ExecuteFilterPSF()
+{
+	// r_HDRStreaks is the master switch for the whole streak / flare / PSF block. Its
+	// diagnostic force mode (2) deliberately does NOT force the filter on: the plate is a
+	// separate piece of kit from the iris, and forcing it would hide whether the params
+	// arrive at all.
+	if (!CRenderer::CV_r_HDRStreaks)
+		return;
+
+	CHDRStreaks* pStreaksTech = static_cast<CHDRStreaks*>(PostEffectMgr()->GetEffect(EPostEffectID::HDRStreaks));
+	if (pStreaksTech == nullptr)
+		return;
+
+	const SHDRStreaksParams streakParams = pStreaksTech->GetParams();
+
+	// Amount 0 is off, and off means no pass at all - not a pass depositing zero.
+	if (streakParams.fFilterAmount < 0.001f)
+		return;
+
+	CTexture* pFilterSource = m_graphicsPipelineResources.m_pTexHDRTargetScaled[1][1];
+	CTexture* pTarget = m_graphicsPipelineResources.m_pTexHDRFinalBloom;
+
+	if (!CTexture::IsTextureExist(pFilterSource) || !CTexture::IsTextureExist(pTarget))
+		return;
+
+	PROFILE_LABEL_SCOPE("HDR_FILTER_PSF");
+
+	static CCryNameTSCRC techStreakThreshold("HDRStreakThreshold");
+	static CCryNameTSCRC techFilterPSF("HDRFilterPSF");
+	static CCryNameR streakParams1Name("StreakParams1");
+	static CCryNameR filterParams0Name("FilterPSFParams0");
+	static CCryNameR filterParams1Name("FilterPSFParams1");
+
+	// 1. Threshold into the scratch target, the streaks' own technique and the same quarter
+	//    of the threshold as a soft knee - wide enough to stop sources popping between
+	//    frames, far too narrow to catch a merely bright sky.
+	if (m_passFilterThreshold.IsDirty())
+	{
+		m_passFilterThreshold.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passFilterThreshold.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passFilterThreshold.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakThreshold, 0);
+		m_passFilterThreshold.SetRenderTarget(0, pFilterSource);
+		m_passFilterThreshold.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A);
+		m_passFilterThreshold.SetTexture(0, m_graphicsPipelineResources.m_pTexHDRTargetScaled[0][0]);
+		m_passFilterThreshold.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passFilterThreshold.BeginConstantUpdate();
+	m_passFilterThreshold.SetConstant(streakParams1Name, Vec4(streakParams.fFilterThreshold, max(streakParams.fFilterThreshold * 0.25f, 0.01f), 0, 0), eHWSC_Pixel);
+	m_passFilterThreshold.Execute();
+
+	// 2. One sprite per source texel. The grid IS the thresholded target, so a cell and a
+	//    texel are the same thing and the vertex shader needs a single point read per quad.
+	const int32 nGridWidth = pFilterSource->GetWidth();
+	const int32 nGridHeight = pFilterSource->GetHeight();
+	const uint32 nVertexCount = uint32(nGridWidth) * uint32(nGridHeight) * 3 * 2;
+
+	if (!m_pFilterPSFPerViewCB)
+	{
+		m_pFilterPSFPerViewCB = gcpRendD3D->m_DevBufMan.CreateConstantBuffer(sizeof(HLSL_PerViewGlobalConstantBuffer));
+		if (m_pFilterPSFPerViewCB)
+			m_pFilterPSFPerViewCB->SetDebugName("FilterPSF Per-View CB");
+	}
+
+	if (!m_pFilterPSFPerViewCB)
+		return;
+
+	// The plate sits in FRONT of the anamorphic element, so its pattern is squeezed
+	// horizontally along with everything else in the frame. Read from the depth of field's
+	// user param, which is where the squeeze is authored - one knob, not two that can drift.
+	const float fSqueeze = clamp_tpl(PostEffectMgr()->GetByNameF("Dof_User_AnamorphicSqueeze"), 1.0f, 2.0f);
+
+	// Sprite half size. Size is a fraction of the frame HEIGHT so the reach is the same at
+	// any aspect ratio; the horizontal extent is then divided by the squeeze. R is in
+	// quarter-resolution pixels, which is also the unit the energy normalisation uses.
+	const float fRadiusPixels = max(streakParams.fFilterSize * (float)nGridHeight, 1.0f);
+	const float fRadiusNdcY = 2.0f * fRadiusPixels / (float)nGridHeight;
+	const float fRadiusNdcX = 2.0f * (fRadiusPixels / fSqueeze) / (float)nGridWidth;
+
+	// Same bloom-weight divide as the streaks and the halation: the tone mapper blends the
+	// bloom target in with weight bloomAmount * 0.3 / 8, so anything added here inherits that
+	// crush and has to have it divided back out to keep a constant on-screen energy.
+	Vec4 vHDRSetupParams[5];
+	gEnv->p3DEngine->GetHDRSetupParams(vHDRSetupParams);
+	const float fBloomCompositeWeight = clamp_tpl(vHDRSetupParams[1].x / 8.0f, 0.0005f, 1.0f);
+
+	// Dividing by the sprite AREA is what makes this a convolution rather than a glow: a
+	// wider plate spreads the same energy further instead of getting brighter. kNorm puts
+	// amount 1 at "clearly visible spikes on a lamp" for a PSF whose bright core is a few
+	// texels across; amount then absorbs whatever an authored PSF's own integral turns out to
+	// be, exactly as the bokeh splat's gain absorbs a shape mask's transmittance.
+	const float kNorm = 400.0f;
+	const float fEnergy = streakParams.fFilterAmount * kNorm / (fRadiusPixels * fRadiusPixels * fBloomCompositeWeight);
+
+	// N/2 line directions, so an odd point count rounds DOWN to the even star the procedural
+	// pattern can actually draw.
+	const int nPoints = clamp_tpl(streakParams.nFilterPoints & ~1, 4, 8);
+
+	CTexture* pPSFTex = streakParams.pFilterPSFTex;
+	const bool bPSFTexValid = CTexture::IsTextureExist(pPSFTex);
+	// Black, not white: the deposit is additive and the fallback slot is never read when the
+	// procedural star is selected, so a stray sample can only ever add nothing.
+	if (!bPSFTexValid)
+		pPSFTex = CRendererResources::s_ptexBlack;
+
+	// Ground truth log, once per change: what the plate actually resolves to.
+	{
+		static float s_lastAmount = -1.0f, s_lastSize = -1.0f, s_lastRotation = -1.0f, s_lastThreshold = -1.0f;
+		static int   s_lastPoints = -1;
+		static CryFixedStringT<256> s_lastName;
+		const char* szPSFName = bPSFTexValid ? pPSFTex->GetName() : "procedural";
+		if (fabsf(streakParams.fFilterAmount - s_lastAmount) > 0.005f ||
+		    fabsf(streakParams.fFilterSize - s_lastSize) > 0.005f ||
+		    fabsf(streakParams.fFilterRotation - s_lastRotation) > 0.005f ||
+		    fabsf(streakParams.fFilterThreshold - s_lastThreshold) > 0.05f ||
+		    nPoints != s_lastPoints || s_lastName != szPSFName)
+		{
+			s_lastAmount = streakParams.fFilterAmount;
+			s_lastSize = streakParams.fFilterSize;
+			s_lastRotation = streakParams.fFilterRotation;
+			s_lastThreshold = streakParams.fFilterThreshold;
+			s_lastPoints = nPoints;
+			s_lastName = szPSFName;
+			CryLog("[BLOOM] filter psf amount=%.2f size=%.2f rot=%.0f thresh=%.1f tex=%s",
+			       streakParams.fFilterAmount, streakParams.fFilterSize,
+			       RAD2DEG(streakParams.fFilterRotation), streakParams.fFilterThreshold, szPSFName);
+		}
+	}
+
+	// The per-view constant buffer describes the quarter-resolution GRID, not the render
+	// target: the vertex shader walks the quad grid and reads the source through it. Target
+	// and grid happen to be the same size here, but keeping them separate is what lets the
+	// sprite geometry stay pure NDC - the same trick the DOF's splat and ghost passes use.
+	const SRenderViewInfo& viewInfo = m_graphicsPipeline.GetCurrentViewInfo(CCamera::eEye_Left);
+	const SRenderViewport customViewport(0, 0, nGridWidth, nGridHeight);
+	m_graphicsPipeline.GeneratePerViewConstantBuffer(&viewInfo, (int)m_graphicsPipeline.GetViewInfoCount(), m_pFilterPSFPerViewCB, &customViewport);
+
+	D3DViewPort viewport;
+	viewport.TopLeftX = 0.0f;
+	viewport.TopLeftY = 0.0f;
+	viewport.Width = (float)pTarget->GetWidth();
+	viewport.Height = (float)pTarget->GetHeight();
+	viewport.MinDepth = 0.0f;
+	viewport.MaxDepth = 1.0f;
+
+	m_passFilterPSF.SetRenderTarget(0, pTarget);
+	m_passFilterPSF.SetViewport(viewport);
+	m_passFilterPSF.BeginAddingPrimitives();
+
+	CRenderPrimitive& prim = m_filterPSFPrimitive;
+	prim.SetFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_VS | CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+	prim.SetTechnique(CShaderMan::s_shHDRPostProcess, techFilterPSF, 0);
+	// Additive into the bloom target, exactly as the last stretch iteration of the streaks is.
+	prim.SetRenderState(GS_NODEPTHTEST | GS_NOCOLMASK_A | GS_BLSRC_ONE | GS_BLDST_ONE);
+	prim.SetCullMode(eCULL_None);
+
+	// Procedural geometry: no vertex or index stream, six vertices per source texel.
+	prim.SetCustomVertexStream(~0u, EDefaultInputLayouts::Empty, 0);
+	prim.SetDrawInfo(eptTriangleList, 0, 0, nVertexCount);
+
+	// The thresholded source is read by the VERTEX shader only (one point read to place and
+	// colour the sprite); the PSF image is read by the pixel shader only.
+	prim.SetTexture(0, pFilterSource, EDefaultResourceViews::Default, EShaderStage_Vertex);
+	prim.SetTexture(1, pPSFTex, EDefaultResourceViews::Default, EShaderStage_Pixel);
+	prim.SetSampler(0, EDefaultSamplerStates::PointClamp, EShaderStage_Vertex);
+	prim.SetSampler(1, EDefaultSamplerStates::LinearClamp, EShaderStage_Pixel);
+
+	prim.SetInlineConstantBuffer(eConstantBufferShaderSlot_PerView, m_pFilterPSFPerViewCB, EShaderStage_Vertex | EShaderStage_Pixel);
+
+	if (prim.Compile(m_passFilterPSF) != CRenderPrimitive::eDirty_None)
+	{
+		static bool s_bWarned = false;
+		if (!s_bWarned)
+		{
+			s_bWarned = true;
+			CryLogAlways("[BLOOM] filter psf primitive failed to compile - pass skipped");
+		}
+		return;
+	}
+
+	const Vec4 vFilterParams0(fRadiusNdcX, fRadiusNdcY, cosf(streakParams.fFilterRotation), sinf(streakParams.fFilterRotation));
+	const Vec4 vFilterParams1(fEnergy, (float)nPoints, bPSFTexValid ? 1.0f : 0.0f, 0.0f);
+
+	auto& constantManager = prim.GetConstantManager();
+	constantManager.BeginNamedConstantUpdate();
+	// Vertex: how big the sprite is and how much energy it carries.
+	constantManager.SetNamedConstant(filterParams0Name, vFilterParams0, eHWSC_Vertex);
+	constantManager.SetNamedConstant(filterParams1Name, vFilterParams1, eHWSC_Vertex);
+	// Pixel: the plate's rotation and which pattern to draw.
+	constantManager.SetNamedConstant(filterParams0Name, vFilterParams0, eHWSC_Pixel);
+	constantManager.SetNamedConstant(filterParams1Name, vFilterParams1, eHWSC_Pixel);
+	constantManager.EndNamedConstantUpdate(&viewport, m_graphicsPipeline.GetCurrentRenderView());
+
+	m_passFilterPSF.AddPrimitive(&prim);
+	m_passFilterPSF.Execute();
+}
+
+// Film halation.
+//
+// Light from a source bright enough to overload the emulsion passes through it, reflects off
+// the film base and re-exposes the emulsion from behind. The red-sensitive layer sits deepest,
+// so the re-exposure reads red-orange; it is much wider than the core itself and its edge is
+// soft. Halation is a property of the FILM STOCK, not of the lens, so unlike the diffraction
+// streaks nothing here follows the f-number.
+//
+// Runs after ExecuteStreaks so the two quarter resolution HDR scratch targets are free again,
+// and blends into $HDRFinalBloom through the same bloom-weight compensation the streaks use.
+void CBloomStage::ExecuteHalation()
+{
+	if (!CRenderer::CV_r_HDRHalation)
+		return;
+
+	CHDRHalation* pHalationTech = static_cast<CHDRHalation*>(PostEffectMgr()->GetEffect(EPostEffectID::HDRHalation));
+	if (pHalationTech == nullptr)
+		return;
+
+	SHDRHalationParams halationParams = pHalationTech->GetParams();
+
+	// r_HDRHalation 2: diagnostic force mode - full strength, low threshold, wide halo,
+	// independent of any game code driving the params.
+	if (CRenderer::CV_r_HDRHalation == 2)
+	{
+		halationParams.fAmount = 1.0f;
+		halationParams.fThreshold = 0.5f;
+		halationParams.fRadius = 0.7f;
+	}
+
+	if (halationParams.fAmount < 0.001f)
+		return;
+
+	PROFILE_LABEL_SCOPE("HDR_HALATION");
+
+	static CCryNameTSCRC techStreakThreshold("HDRStreakThreshold");
+	static CCryNameTSCRC techStreakStretch("HDRStreakStretch");
+	static CCryNameR streakParams0Name("StreakParams0");
+	static CCryNameR streakParams1Name("StreakParams1");
+	static CCryNameR streakParams2Name("StreakParams2");
+
+	CTexture* pHalationSource = m_graphicsPipelineResources.m_pTexHDRTargetScaled[1][1];
+
+	// Same bloom-weight divide as the streaks: the tone mapper blends the bloom target in with
+	// weight bloomAmount * 0.3 / 8, so anything added here inherits that crush and has to have
+	// it divided back out to keep a constant on-screen energy.
+	Vec4 vHDRSetupParams[5];
+	gEnv->p3DEngine->GetHDRSetupParams(vHDRSetupParams);
+	const float fBloomCompositeWeight = clamp_tpl(vHDRSetupParams[1].x / 8.0f, 0.0005f, 1.0f);
+
+	const float fRadius01 = clamp_tpl(halationParams.fRadius, 0.0f, 1.0f);
+
+	// 1. Threshold into the scratch target. Same soft knee (a quarter of the threshold) as the
+	//    streaks: wide enough to stop sources popping between frames, far too narrow to catch
+	//    a merely bright sky - which is exactly the point, a sky must not halate.
+	if (m_passHalationThreshold.IsDirty())
+	{
+		m_passHalationThreshold.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passHalationThreshold.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passHalationThreshold.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakThreshold, 0);
+		m_passHalationThreshold.SetRenderTarget(0, pHalationSource);
+		m_passHalationThreshold.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A);
+		m_passHalationThreshold.SetTexture(0, m_graphicsPipelineResources.m_pTexHDRTargetScaled[0][0]);
+		m_passHalationThreshold.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passHalationThreshold.BeginConstantUpdate();
+	m_passHalationThreshold.SetConstant(streakParams1Name, Vec4(halationParams.fThreshold, max(halationParams.fThreshold * 0.25f, 0.01f), 0, 0), eHWSC_Pixel);
+	m_passHalationThreshold.Execute();
+
+	// 2. Take the thresholded source down to 1/16 resolution in two bilinear halvings (each one
+	//    averages a 2x2 block, so a small source keeps its energy instead of aliasing away).
+	//    The halo's WIDTH comes from the resolution the blur runs at, not from a tap stride:
+	//    CGaussianBlurPass has a fixed +-8 texel footprint, which at 1/16 resolution is +-128
+	//    full-res pixels. And it is a true separable Gaussian, so the result is ISOTROPIC - a
+	//    round halo. The earlier separable exponential spread was not: two 1D geometric
+	//    falloffs multiply into |x|+|y| isolines, a diamond/square halo emulsion scatter never
+	//    shows (verified square on screen by the user).
+	if (!AcquireHalationTargets(pHalationSource->GetWidth(), pHalationSource->GetHeight()))
+		return;
+	m_passHalationDown0.Execute(pHalationSource, m_pTexHalationEighth);
+	m_passHalationDown1.Execute(m_pTexHalationEighth, m_pTexHalationLow);
+
+	// 3. Isotropic Gaussian at 1/16 resolution. The distribution is the Gaussian's rho in
+	//    1/16-res texels (16 full-res pixels each on a 1080p frame): 2 -> 8 across the radius
+	//    range is a per-pass sigma of 32 -> 128 pixels, two passes about 1.4x that - radius
+	//    0.5 lands near 110 px (roughly four times the bloom core), radius 1 near 180 px.
+	const float fDistribution = 2.0f + 6.0f * fRadius01;
+
+	for (int iteration = 0; iteration < kHalationBlurIterations; ++iteration)
+		m_passHalationBlur.Execute(m_pTexHalationLow, m_pTexHalationLowTemp, 1.0f, fDistribution, false);
+
+	// 4. Composite into the bloom target. The stretch shader is reused with a ZERO step, so all
+	//    15 taps land on the same texel and the normalised sum is a plain tinted sample.
+	//
+	//    The energy conserving blur spreads a source over thousands of texels, which leaves the
+	//    halo far dimmer per pixel than the core it came from - correct as physics, invisible in
+	//    practice. The gain below puts it back at the strength an overloaded frame really shows,
+	//    so amount 1 is an obvious red-orange glow rather than a hint of one.
+	const float fHalationGain = 8.0f;
+	const float fOutputScale = halationParams.fAmount * fHalationGain / fBloomCompositeWeight;
+	const Vec4 vTint(halationParams.vTint.x, halationParams.vTint.y, halationParams.vTint.z, 0.0f);
+
+	// The 1/16-res result is read through a bilinear sampler, which is all the upsampling a
+	// halo this soft needs. The texture id is part of the dirty check: the low-res targets are
+	// re-created on a resolution change.
+	if (m_passHalationComposite.IsDirty(m_pTexHalationLow->GetTextureID()))
+	{
+		m_passHalationComposite.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		m_passHalationComposite.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passHalationComposite.SetTechnique(CShaderMan::s_shHDRPostProcess, techStreakStretch, 0);
+		m_passHalationComposite.SetRenderTarget(0, m_graphicsPipelineResources.m_pTexHDRFinalBloom);
+		m_passHalationComposite.SetState(GS_NODEPTHTEST | GS_NOCOLMASK_A | GS_BLSRC_ONE | GS_BLDST_ONE);
+		m_passHalationComposite.SetTexture(0, m_pTexHalationLow);
+		m_passHalationComposite.SetSampler(0, EDefaultSamplerStates::LinearClamp);
+	}
+
+	m_passHalationComposite.BeginConstantUpdate();
+	m_passHalationComposite.SetConstant(streakParams0Name, Vec4(0.0f, 0.0f, 0.0f, fOutputScale), eHWSC_Pixel);
+	m_passHalationComposite.SetConstant(streakParams1Name, Vec4(0, 0, 1.0f, 0), eHWSC_Pixel);
+	m_passHalationComposite.SetConstant(streakParams2Name, vTint, eHWSC_Pixel);
+	m_passHalationComposite.Execute();
+}
+
+bool CBloomStage::AcquireHalationTargets(int quarterWidth, int quarterHeight)
+{
+	const int w8  = max(quarterWidth / 2, 1);
+	const int h8  = max(quarterHeight / 2, 1);
+	const int w16 = max(quarterWidth / 4, 1);
+	const int h16 = max(quarterHeight / 4, 1);
+
+	if (m_pTexHalationEighth && m_pTexHalationLow && m_pTexHalationLowTemp &&
+	    m_halationLowWidth == w16 && m_halationLowHeight == h16)
+		return true;
+
+	ReleaseHalationTargets();
+
+	const uint32 flags = FT_NOMIPS | FT_DONT_STREAM | FT_USAGE_RENDERTARGET;
+	const std::string id = m_graphicsPipeline.GetUniqueIdentifierName();
+	m_pTexHalationEighth  = CTexture::GetOrCreateRenderTarget(("$HalationEighth" + id).c_str(),  w8,  h8,  Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+	m_pTexHalationLow     = CTexture::GetOrCreateRenderTarget(("$HalationLow" + id).c_str(),     w16, h16, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+	m_pTexHalationLowTemp = CTexture::GetOrCreateRenderTarget(("$HalationLowTemp" + id).c_str(), w16, h16, Clr_Transparent, eTT_2D, flags, eTF_R16G16B16A16F);
+
+	if (!CTexture::IsTextureExist(m_pTexHalationEighth) || !CTexture::IsTextureExist(m_pTexHalationLow) || !CTexture::IsTextureExist(m_pTexHalationLowTemp))
+	{
+		ReleaseHalationTargets();
+		return false;
+	}
+
+	m_halationLowWidth = w16;
+	m_halationLowHeight = h16;
+	return true;
+}
+
+void CBloomStage::ReleaseHalationTargets()
+{
+	m_pTexHalationEighth.reset();
+	m_pTexHalationLow.reset();
+	m_pTexHalationLowTemp.reset();
+	m_halationLowWidth = 0;
+	m_halationLowHeight = 0;
 }
