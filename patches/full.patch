+		const float fy = ((float)y + 0.5f) / (float)h * 2.0f - 1.0f;
+		float fRow = 0.0f;
+		for (int x = 0; x < w; x++)
+		{
+			const float fx = ((float)x + 0.5f) / (float)w * 2.0f - 1.0f;
+			const bool bInIris = (fx * fx + fy * fy) <= fIrisSq;
+			const float fPupil = bInIris ? (float)m_maskPixels[(size_t)y * w + x] : 0.0f;
+			fRow += fPupil + 0.5f;
+			m_maskColCDF[(size_t)y * w + x] = fRow;
+			if (fabsf(fx) <= fBound && fabsf(fy) <= fBound)
+			{
+				fFillSum += fPupil / 255.0f;
+				nFillCount++;
+			}
+		}
+		const float fInvRow = 1.0f / fRow;
+		for (int x = 0; x < w; x++)
+			m_maskColCDF[(size_t)y * w + x] *= fInvRow;
+		fTotal += fRow;
+		m_maskRowCDF[y] = fTotal;
+	}
+	const float fInvTotal = 1.0f / fTotal;
+	for (int y = 0; y < h; y++)
