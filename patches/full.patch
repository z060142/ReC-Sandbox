+	cSum += (GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy + vStep, 0.0f).rgb
+	       + GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy - vStep, 0.0f).rgb) * w1;
+	cSum += (GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy + 2.0f * vStep, 0.0f).rgb
+	       + GetTexture2DLod(HDRStreak_Src, HDRStreak_LClampSampler, IN.baseTC.xy - 2.0f * vStep, 0.0f).rgb) * w2;
+
+	return cSum;
+}
+
+////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////
+
+// Front filter point spread function (FilterPSFSpec.md).
+//
+// A star / cross-screen filter is a plate of etched grooves in FRONT of the lens: every bright
+// point in the frame is convolved with one fixed pattern. The convolution is done sparsely -
+// one textured sprite per bright quarter-resolution texel, expanded from SV_VertexID with no
+// vertex stream at all, deposited additively into the bloom target. Nothing here follows the
+// iris: a plate is not the aperture, so there is no f-number term and no blade phase.
+
+float4 FilterPSFParams0;  // (sprite half extent x in NDC, half extent y in NDC, cos rotation, sin rotation)
+float4 FilterPSFParams1;  // (energy per unit of source excess, star point count, PSF texture bound 0/1, unused)
+
+Texture2D<float4> HDRFilterPSF_Src      : register(t0);  // thresholded quarter res source, vertex shader (the front filter stays at quarter res)
+Texture2D<float4> HDRFilterPSF_Tex      : register(t1);  // authored PSF image, pixel shader
+SamplerState HDRFilterPSF_PClampSampler : register(s0);  // PointClamp
+SamplerState HDRFilterPSF_LClampSampler : register(s1);  // LinearClamp
+
+struct v2fFilterPSF
+{
+	float4 Position : SV_POSITION;
+	float4 QuadUV   : TEXCOORD0;  // xy: quad local, 0..1 across the sprite. zw unused.
+	float4 Color    : TEXCOORD1;  // rgb: this source's deposit. a unused.
+};
+
+// Shared by every sparse-convolution sprite pass in this file (the front filter and the
+// wave-optics diffraction glare): the clip-space CENTRE of the quad a vertex belongs to.
+// One quad per grid cell, and the grid IS the thresholded target, so a cell and a source
+// texel are the same thing. Same integer walk the DOF's sprite passes use; the grid size
+// arrives through the pass's own per-view constant buffer.
+float4 SpriteGridCentrePos(uint nVertexID)
+{
+	const int nQuadID    = (int)(nVertexID / 6);
+	const int nGridWidth = (int)g_VS_ScreenSize.x;
+	float4 INPos = float4((float)(nQuadID % nGridWidth), (float)(nQuadID / nGridWidth), 0, 0);
+	INPos.xy /= g_VS_HPosScale.xy;
+
+	INPos.xy *= g_VS_ScreenSize.zw * 2.0;
+	INPos.xy += g_VS_ScreenSize.zw;
+
+	return float4(INPos.xy * 2 - 1, 0, 1);
+}
+
+// Two triangles, corners in [-1, 1]. The pixel shaders read the quad-local coordinate back out
+// of QuadUV, so the winding and the order here are part of both passes' contract.
+static const float2 g_SpriteQuadVerts[6] =
+{
+	float2( 1,  1),
+	float2(-1,  1),
+	float2( 1, -1),
+
+	float2( 1, -1),
+	float2(-1,  1),
+	float2(-1, -1)
+};
+
+v2fFilterPSF FilterPSFVS(uint nVertexID : SV_VertexID)
+{
+	v2fFilterPSF OUT = (v2fFilterPSF) 0;
+
+	OUT.Position = SpriteGridCentrePos(nVertexID);
+	const float4 screenProj = HPosToScreenTC(OUT.Position);
+
+	// One point read at the texel centre. The threshold pass already rescaled the source to
+	// its own excess above the knee with the hue preserved, so this IS the excess E.
+	const half3 cExcess = GetTexture2DLod(HDRFilterPSF_Src, HDRFilterPSF_PClampSampler, float4(screenProj.xy, 0, 0)).rgb;
+
+	// Nothing survived the threshold here: collapse the quad instead of rasterizing a sprite
+	// that would deposit zero. This is what keeps the pass proportional to the number of
+	// bright sources rather than to the frame area.
+	if (dot(cExcess, half3(1, 1, 1)) < 1e-4)
+	{
+		OUT.Position.xy = 0;
+		return OUT;
+	}
+
+	OUT.Color.rgb = cExcess * (half)FilterPSFParams1.x;
+
+	// Half extents arrive in NDC already divided by the anamorphic squeeze on x, so the
+	// pattern is compressed horizontally exactly as the rest of the picture is.
+	const float2 vHalfExtent = FilterPSFParams0.xy;
+
+	OUT.Position.xy += g_SpriteQuadVerts[nVertexID % 6].xy * vHalfExtent;
+	OUT.QuadUV = float4(g_SpriteQuadVerts[nVertexID % 6].xy * 0.5 + 0.5, 0, 0);
+
+	return OUT;
+}
+
+// Procedural stand-in for an authored PSF: an N-point star with rainbow tips, so the filter is
+// testable and has a sane default. d is quad local in [-1, 1], the plate's rotation already
+// walked back out of it.
+float3 ProceduralStarPSF(float2 d, float fPoints)
+{
+	// N points come from N/2 LINES, each of which paints two opposed spikes - the same
+	// symmetry the iris diffraction streaks are built on.
+	const int nLines = clamp((int)(fPoints * 0.5), 2, 4);
+
+	float3 cSum = 0;
+
+	[loop] for (int j = 0; j < nLines; ++j)
+	{
+		const float fTheta = (float)j * (PI / (float)nLines);
+		const float fCos = cos(fTheta);
+		const float fSin = sin(fTheta);
+
+		const float fAlong = dot(d, float2(fCos, fSin));
+		const float fPerp  = dot(d, float2(-fSin, fCos));
+
+		// Thin across (the groove is a line), fading quadratically along its length so the
+		// tail runs out at the edge of the sprite instead of being cut off.
+		const float fAbsAlong = min(abs(fAlong), 1.0);
+		const float fLine = exp(-abs(fPerp) * 40.0) * pow(saturate(1.0 - fAbsAlong), 2.0);
+
+		// Dispersion: the groove is a grating, so the far end of each line is where the
+		// wavelengths have separated most. Red near the core, blue at the tips, washed back
+		// to white as the line approaches the source it came from.
+		const float3 cHue = (fAbsAlong < 0.5)
+			? lerp(float3(1.0, 0.25, 0.15), float3(0.35, 1.0, 0.30), fAbsAlong * 2.0)
+			: lerp(float3(0.35, 1.0, 0.30), float3(0.20, 0.35, 1.0), fAbsAlong * 2.0 - 1.0);
+
+		cSum += fLine * lerp(cHue, 1.0, saturate(1.0 - fAbsAlong));
+	}
+
+	// The undiffracted core: the plate passes most of the light straight through, so the
+	// source itself is still there under the star.
+	cSum += exp(-dot(d, d) * 60.0);
+
+	return cSum;
+}
+
+float4 FilterPSFPS(v2fFilterPSF IN) : SV_Target
+{
+	// Turning the plate turns the pattern, so the PSF is SAMPLED through the inverse
+	// rotation. Around the sprite centre, which is where the source sits.
+	const float2 vLocal = IN.QuadUV.xy * 2.0 - 1.0;
+	const float fCos = FilterPSFParams0.z;
+	const float fSin = FilterPSFParams0.w;
+	const float2 d = float2(vLocal.x * fCos + vLocal.y * fSin,
+	                       -vLocal.x * fSin + vLocal.y * fCos);
+
+	float3 cPSF;
+	if (FilterPSFParams1.z > 0.5)
+	{
+		// Authored plate: the pattern is exactly this image, centred, black outside itself.
+		cPSF = GetTexture2D(HDRFilterPSF_Tex, HDRFilterPSF_LClampSampler, d * 0.5 + 0.5).rgb;
+	}
+	else
+	{
+		cPSF = ProceduralStarPSF(d, FilterPSFParams1.y);
+	}
+
+	// Alpha 0: the bloom target's alpha channel is not ours to touch.
+	return float4(IN.Color.rgb * cPSF, 0.0);
+}
+
+////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////
+
+// Wave-optics diffraction glare (DiffractionKernelSpec.md).
+//
+// The glare of a point source IS the Fraunhofer diffraction pattern of the pupil, |F{A}|^2. The
+// CPU has already transformed the pupil into $DiffractionKernel (sqrt-encoded, core removed:
+// the frame carries the source itself). What is left here is the two things that make it a
+// picture: the wavelength scaling and the far field.
+//
+//  * Scale. The kernel's texel pitch on the sensor is lambda * N * d / L, which at working
+//    apertures is a fraction of a pixel - the whole texture spans some tens of pixels. So the
+//    texture resolves the STRUCTURE and the reach comes from the far-field law: past its edge
+//    the pattern is extrapolated as I_ring(theta) * (R_tex / u)^2, the 1/u^2 of a straight
+//    edge. That is exact for a straight blade and pessimistic for anything smoother, so the
+//    extrapolated tail is never brighter than the physics allows.
+//
+//  * Sampling. Because the pitch is a fraction of a pixel, ONE PIXEL COVERS TENS OF KERNEL
+//    TEXELS - about 17 at f/16, about 100 wide open - while the rays inside the kernel are one
+//    or two texels wide. A single tap per pixel therefore hits a ray roughly one time in
+//    seventeen and the pattern disappears from the picture even though its average energy is
+//    correct. So the kernel carries a PREFILTERED MIP CHAIN of the LINEAR intensity (built on
+//    the CPU, sqrt-encoded only after filtering, because sqrt is not linear) and each
+//    wavelength is read with an explicit LOD: f = fScale / s_q texels per pixel along the
+//    pattern, lod = log2(max(f, 1)). The tap is then the MEAN intensity over the pixel's
+//    footprint, and the 1 / s_q^2 below turns that mean into the footprint's integral.
+//    The sampler must be TRILINEAR - a MIP_NONE sampler is created with MaxLOD 0 and would pin
+//    every read to level 0.
+//
+//  * Energy. The kernel is NOT renormalised. Its texels are the Parseval-normalised |F{A}|^2
+//    of the pupil - the whole pattern summed to 1 before the core was removed - so what the
+//    texture holds is literally the fraction of the source that was diffracted away. The only
+//    factor applied here is 1 / pitch^2, which converts "per kernel texel" into "per
+//    half-resolution pixel", the unit the sprite rasterizes in. Amount 1 is therefore the
+//    physical fraction (5-15% of the source for a typical iris), not the whole excess. There is
+//    no bloom-weight divide any more: the deposit goes into the glare's own half-resolution
+//    layer, which is added straight into the HDR target after the bloom stage, so nothing
+//    scales it on the way to the screen.
+//
+//  * Colour. Each wavelength is a scaled copy: PSF_l(u) = (l0/l)^2 * PSF_l0(u * l0/l). Blue is
+//    compact, red is stretched, which is why a real sunstar's ray runs blue at the core and red
+//    at the tip. Six samples, weights pre-multiplied and normalised to white on the CPU.
+
+float4 DiffractionParams0;    // (sprite radius in half-res px, kernel texel pitch in the same px, R_tex, 1 / pitch^2)
+float4 DiffractionParams1;    // (dispersion 0..1, grid size L, max LOD = mip count - 1, r_HDRDiffractionDebug mode)
+float4 DiffractionParams2;    // (sprite half extent x in NDC, half extent y in NDC, energy per unit of source excess, unused)
+float4 DiffractionSpectrum[6];// rgb = colour * (l0/l)^2 normalised to white, w = l0 / l
+float4 DiffractionDebugParams;// (display width fraction, display height fraction, log gain, output scale)
+float4 DiffractionDebugParams1;// (1 / source width, 1 / source height, unused, unused) - debug pass only
+
+Texture2D<float4> HDRDiffraction_Src   : register(t0);  // thresholded + pre-blurred half res source, vertex shader
+Texture2D<float4> HDRDiffraction_Kernel: register(t1);  // sqrt(|F{pupil}|^2), L x L, R16F
+Texture2D<float4> HDRDiffraction_Ring  : register(t2);  // sqrt(I) on the kernel's boundary ring, 256 x 1, R16F
+SamplerState HDRDiffraction_PClampSampler : register(s0);  // PointClamp
+SamplerState HDRDiffraction_LClampSampler : register(s1);  // TrilinearClamp - the kernel is mipped
+SamplerState HDRDiffraction_LWrapSampler  : register(s2);  // LinearWrap - the ring is an angle
+
+struct v2fDiffraction
+{
+	float4 Position : SV_POSITION;
+	float4 QuadUV   : TEXCOORD0;  // xy: quad local, 0..1 across the sprite. zw unused.
+	float4 Color    : TEXCOORD1;  // rgb: this source's deposit. a unused.
+};
+
+v2fDiffraction DiffractionPSFVS(uint nVertexID : SV_VertexID)
+{
+	v2fDiffraction OUT = (v2fDiffraction) 0;
+
+	OUT.Position = SpriteGridCentrePos(nVertexID);
+	const float4 screenProj = HPosToScreenTC(OUT.Position);
+
+	// One point read at the texel centre. The threshold pass already rescaled the source to its
+	// own excess above the knee with the hue preserved, so this IS the excess E.
+	const float3 cExcess = GetTexture2DLod(HDRDiffraction_Src, HDRDiffraction_PClampSampler, float4(screenProj.xy, 0, 0)).rgb;
+
+	// Nothing survived the threshold here: collapse the quad instead of rasterizing a sprite
+	// that would deposit zero. This is what keeps the cost proportional to the number of bright
+	// sources rather than to the frame area - and these sprites are large.
+	if (dot(cExcess, float3(1, 1, 1)) < 1e-4)
+	{
+		OUT.Position.xy = 0;
+		return OUT;
+	}
+
+	// float, not half: the deposit carries the bloom-weight divide (a factor of some 250) on top
+	// of an HDR excess, which overflows half long before it overflows anything visible.
+	OUT.Color.rgb = cExcess * DiffractionParams2.z;
+
+	// The x half extent already carries the anamorphic stretch: the iris sits BEHIND the
+	// cylindrical group, so its pattern is formed unsqueezed and the desqueeze widens it.
+	OUT.Position.xy += g_SpriteQuadVerts[nVertexID % 6].xy * DiffractionParams2.xy;
+	OUT.QuadUV = float4(g_SpriteQuadVerts[nVertexID % 6].xy * 0.5 + 0.5, 0, 0);
+
+	return OUT;
+}
+
+float4 DiffractionPSFPS(v2fDiffraction IN) : SV_Target
+{
+	// Quad local in [-1, 1] scaled to the PATTERN's own coordinates. The y flip puts us in the
+	// texture space the pupil was rastered in (v down), which is the space the bokeh shape mask
+	// is authored in and the space the iris phase is measured in - so a mask's diffraction
+	// pattern comes out the same way up as its bokeh, and Blade Rotation turns both together.
+	// x needs no undo of the anamorphic stretch: the quad was widened, so quad-local x = 1 is
+	// still one pattern radius.
+	const float2 vLocal = IN.QuadUV.xy * 2.0 - 1.0;
+	const float2 d = float2(vLocal.x, -vLocal.y) * DiffractionParams0.x;
+
+	const float r = length(d);
+
+	// Two windows, both in SCREEN space, both applied to the final intensity. They are the
+	// difference between "the maths is right" and "the picture is right", and neither is
+	// cosmetic:
+	//
+	//  * OUTER (w_out). The sprite is a square quad and the 1/u^2 extrapolation is still finite
+	//    at its boundary, so the boundary is a hard cut - and a hard cut around every small
+	//    emitter is a visible WHITE SQUARE FRAME. Feathering the last 20% of the radius and
+	//    zeroing everything past it turns the square into a round cut-off: the quad's corners
+	//    (r up to sqrt(2) R) never draw. The energy this removes is the outermost, faintest
+	//    part of the logarithmic tail - the CPU's tail estimate accounts for it by integrating
+	//    to 0.9 R instead of R.
+	//
+	//  * INNER (w_in). The deposit target is HALF resolution and, just outside the removed
+	//    core, the pattern falls as 1/u^2 from about six texels - roughly 1.4 native pixels -
+	//    so the slope crosses a whole deposit texel in almost nothing and the deposit shows as
+	//    native BLOCKS around the source (4x4 when this pass ran at quarter resolution, 2x2
+	//    now). The analytic streaks never exposed this
+	//    because their exponential falloff is orders of magnitude gentler. The first four
+	//    half-res pixels - the same EIGHT NATIVE the quarter-res version faded over two of its
+	//    own, so the figure on screen is unchanged - belong to the source itself and to the
+	//    bloom around it in any case, so fading the glare in over that radius costs nothing that can be seen
+	//    and removes the only part of the pattern the grid cannot represent. It is NOT free in
+	//    energy terms - it is the steepest part of the pattern - but the kernel's own core
+	//    removal (2.5 Airy radii) is unchanged, so the energy accounting is untouched and the
+	//    loss is a small extra deficit at the very centre, reported in the log as a radius in
+	//    kernel texels rather than estimated (it needs the kernel's radial profile, which is
+	//    not on this side of the job).
+	//
+	// The step the previous round named and did not take - "run the sprite pass into a
+	// half-resolution target of its own and composite that down" - has now been taken, because
+	// the windows alone did not cure the blocks: the SOURCE grid was half the problem, and no
+	// amount of windowing the deposit can fix a square that is already in the sum of the
+	// sprites. See the renderer's comment on ExecuteDiffraction.
+	const float fSpriteRadius = max(DiffractionParams0.x, 1e-4);
+	// Half-res pixels, so 8 native - the CPU's log prints this radius in kernel texels and
+	// computes it from the same constant.
+	const float kDiffractionInnerWindowPx = 4.0;
+	const float w_out = 1.0 - smoothstep(0.8, 1.0, r / fSpriteRadius);
+	const float w_in = smoothstep(0.0, kDiffractionInnerWindowPx, r);
+	const float fWindow = w_in * w_out;
+
+	// The quad's corners are outside the round cut-off: nothing there can ever be drawn, so
+	// skip the six kernel taps as well.
+	if (fWindow <= 0.0)
+		return float4(0, 0, 0, 0);
+
+	const float2 vDir = (r > 1e-6) ? (d / r) : float2(1, 0);
+	// Off the normalised direction, not off d: at the exact sprite centre atan2(0, 0) is not
+	// defined and would poison the ring lookup for that pixel.
+	const float fTheta = atan2(vDir.y, vDir.x);
+
+	// Distance from the source in KERNEL TEXELS at the reference wavelength.
+	const float fPitch = max(DiffractionParams0.y, 1e-6);
+	const float u0 = r / fPitch;
+	const float fRingRadius = DiffractionParams0.z;
+	const float fInvL = 1.0 / max(DiffractionParams1.y, 1.0);
+	const float fMaxLod = DiffractionParams1.z;
+	// r_HDRDiffractionDebug 2 - shape only. Everything above and below runs exactly as it does
+	// in mode 0 (same sources, same sprite, same mip LOD), only the DEPOSIT is replaced.
+	const bool bShapeOnly = abs(DiffractionParams1.w - 2.0) < 0.5;
+
+	// The boundary ring, once: it is a function of the angle only, and all six wavelengths
+	// extrapolate off the same edge. It is NOT mipped: its 256 bins already span 6+ texels of a
+	// ~1600-texel circumference, which is the same order as the angular footprint of a pixel
+	// covering 17 texels, so a bin is already the pixel's angular average to within a factor. The CPU binned it over [0, 2pi) starting at +x, so u is
+	// theta / 2pi with NO half-texture offset; atan2's negative half wraps round through the
+	// sampler, which is why the ring must be sampled wrapped and not clamped.
+	const float fRingEnc = GetTexture2D(HDRDiffraction_Ring, HDRDiffraction_LWrapSampler,
+	                                    float2(fTheta * (0.5 / PI), 0.5)).x;
+	const float fRingI = fRingEnc * fRingEnc;
+
+	float3 cSum = 0;
+	float fISum = 0;
+
+	[unroll]
+	for (int i = 0; i < 6; ++i)
+	{
+		// Dispersion 0 collapses every wavelength onto 550 nm: one white pattern, no rainbow.
+		const float fScale = lerp(1.0, DiffractionSpectrum[i].w, DiffractionParams1.x);
+		const float u = u0 * fScale;
+
+		float I;
+		if (u <= fRingRadius)
+		{
+			// This pixel's footprint in kernel texels at THIS wavelength: u = r * fScale / s_q,
+			// so one pixel of r is fScale / s_q texels of u. Never below one texel (the pattern
+			// can be magnified, in which case level 0 is already finer than the pixel).
+			const float fFootprint = fScale / fPitch;
+			const float fLod = clamp(log2(max(fFootprint, 1.0)), 0.0, fMaxLod);
+
+			// sqrt-encoded so the 1e-8 tails stay above half float's denormals. The chain was
+			// box filtered in LINEAR intensity, so k * k is the mean intensity over the
+			// footprint at every level - which is what makes one tap an integral.
+			const float k = GetTexture2DLod(HDRDiffraction_Kernel, HDRDiffraction_LClampSampler,
+			                                float4(0.5 + (u * fInvL) * vDir, 0, fLod)).x;
+			I = k * k;
+		}
+		else
+		{
+			const float t = fRingRadius / u;
+			I = fRingI * t * t;
+		}
+
+		cSum += DiffractionSpectrum[i].rgb * I;
+		fISum += I;
+	}
+
+	// r_HDRDiffractionDebug 2: paint the PATTERN, not its energy. The source's excess, the
+	// texel-to-pixel norm and the bloom-weight divide are all dropped and every source that
+	// passed the threshold deposits the same fully visible figure. The colour is the spectral
+	// sum renormalised to its own peak, so the dispersion rainbow stays readable at full
+	// brightness. This answers "does the pass draw at all, where does it land, how big is it,
+	// what shape is it" without any argument about how much light it should have received.
+	//
+	// The curve is a DECADE MAP, not the kernel view's log(1 + I * 1e6). That gain belongs to
+	// the corner view, which reads the kernel at level 0 where a ray texel is around 1e-4; what
+	// arrives HERE is the pixel's footprint MEAN - one deposit pixel covers some 17 kernel texels
+	// at f/16 and a hundred wide open - plus the 1/u^2 tail, which together run from about 1e-4
+	// just outside the core to 1e-12 at the rim of the sprite. Pushed through the old curve, a
+	// typical 1e-8 pixel came out at 0.0007: black. Mapping ten decades, 1e-13 (black) to 1e-3
+	// (white), puts that same pixel at mid grey and keeps the faint tail visible - which is the
+	// entire point of the mode.
+	if (bShapeOnly)
+	{
+		const float v = saturate((log10(max(fISum, 1e-20)) + 13.0) * 0.1);
+		const float fPeak = max(cSum.x, max(cSum.y, cSum.z));
+		const float3 cHue = (fPeak > 1e-20) ? (cSum / fPeak) : float3(1, 1, 1);
+		// The windows are geometry, not deposit: mode 2 must show the figure the pass actually
+		// rasterizes, round cut-off and faded centre included.
+		return float4(cHue * v * fWindow, 0.0);
+	}
+
+	// Alpha 0: the bloom target's alpha channel is not ours to touch.
+	return float4(IN.Color.rgb * cSum * (DiffractionParams0.w * fWindow), 0.0);
+}
+
+// r_HDRDiffractionDebug 1: the kernel itself, into the top-left corner on a log tone curve.
+// The pattern spans eight decades, so anything linear is a black square with a white dot.
+// r_HDRDiffractionDebug 3: the pass's own thresholded SOURCE texture in the same corner - the
+// excess above HDR_Streaks_Threshold that the sprites are fed - on a decade scale, so it can be
+// read off the picture whether there is any glare source on screen at all and how bright it is.
+float4 DiffractionDebugPS(vtxOut IN) : SV_Target
+{
+	const float2 uv = IN.baseTC.xy / max(DiffractionDebugParams.xy, 1e-4);
+	if (uv.x > 1.0 || uv.y > 1.0)
+		return float4(0, 0, 0, 0);
+
+	if (DiffractionParams1.w > 2.5)
+	{
+		// The panel is a HALF SIZE copy of a quarter-resolution texture, so it MINIFIES 2:1 -
+		// and the sources it exists to show are one or two texels across. Point sampling one tap
+		// per panel pixel therefore throws away three quarters of the isolated bright texels and
+		// the panel comes up black even with a lamp blazing away in the frame. So: a 5x5 MAX
+		// over the source's own texel grid. It cannot drop a texel (the taps are contiguous at
+		// one texel spacing, which covers the 2:1 footprint twice over) and it DILATES - a
+		// single hot texel paints a 3x3 block of panel pixels, some 12x12 native, which is
+		// something you can see rather than something you have to hunt for.
+		const float2 vTexel = DiffractionDebugParams1.xy;
+		float E = 0.0;
+		[unroll]
+		for (int y = -2; y <= 2; ++y)
+		{
+			[unroll]
