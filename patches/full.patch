+		return;
+
+	// Accumulate at full resolution: at half resolution a 64x64 shape mask was drawn into a
+	// quarter of the pixels and then bilinearly magnified back up, which is what smeared the
+	// silhouette at native res and why supersampling (which raises the internal resolution and
+	// therefore the layer resolution) appeared to fix it.
+	if (!AcquireSplatLayers(pHDRTarget->GetWidth(), pHDRTarget->GetHeight()))
+		return;
+
+	CTexture* pLayerNear = m_pTexSplatLayerNear;
+	CTexture* pLayerFar = m_pTexSplatLayerFar;
+
+	// The quad GRID stays at half resolution - one candidate splat per half-res cell, so the
+	// vertex count and the economics are unchanged - but the SOURCE is now the full resolution
+	// scene copy (sharp, pre-DOF). The old path downscaled the scene first, which averaged a
+	// small highlight into its dark neighbourhood BEFORE the threshold ever saw it; the vertex
+	// shader now samples the cell's four native texels and thresholds each one, so peak energy
+	// survives at native resolution - which is exactly what supersampling was accidentally
