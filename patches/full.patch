+
+//! Film halation. Light from a source bright enough to overload the emulsion passes through
+//! it, reflects off the film base and re-exposes the emulsion around the source. The
+//! red-sensitive layer sits deepest, so the halo reads red-orange, it is much wider than the
+//! core itself and its edge is soft. It is a property of the film stock, not of the lens, so
+//! it does not follow the f-number.
+struct SHDRHalationParams
+{
+	SHDRHalationParams()
+		: fAmount(0.0f), fThreshold(2.0f), fRadius(0.5f), vTint(1.0f, 0.35f, 0.15f, 0.0f)
+	{
+	};
+
+	float fAmount;    //!< 0-3 strength. 0 = the halation passes do not run at all.
+	float fThreshold; //!< Scene HDR value a source has to exceed before it halates.
+	float fRadius;    //!< 0-1, how far the halo spreads from the source.
+	Vec4  vTint;      //!< (rgb, unused) colour of the halo; colour negative stock gives red-orange.
+};
+
+//! Parameter container only - the passes live in CBloomStage, which reads these the same way
+//! CDepthOfFieldStage reads SDepthOfFieldParams.
+class CHDRHalation : public CPostEffect
+{
+public:
+	CHDRHalation()
+	{
+		m_nRenderFlags = 0;
+		m_nID = EPostEffectID::HDRHalation;
+
+		AddParamFloatNoTransition("HDR_Halation_Amount", m_pAmount, 0.0f);
+		AddParamFloatNoTransition("HDR_Halation_Threshold", m_pThreshold, 2.0f);
+		AddParamFloatNoTransition("HDR_Halation_Radius", m_pRadius, 0.5f);
+		AddParamVec4NoTransition("HDR_Halation_Tint", m_pTint, Vec4(1.0f, 0.35f, 0.15f, 0.0f));
+	}
+
+	//! Never preprocessed or executed: the effect exists purely to own the parameters.
+	virtual bool Preprocess(const SRenderViewInfo& viewInfo) override
+	{
+		return false;
+	}
+
+	virtual void Execute() override
+	{
+	}
+
+	virtual void        Reset(bool bOnSpecChange = false) override;
+
+	SHDRHalationParams  GetParams() const;
+
+	virtual const char* GetName() const override
+	{
+		return "HDRHalation";
+	}
+
+private:
+	CEffectParam* m_pAmount, * m_pThreshold, * m_pRadius, * m_pTint;
+};
