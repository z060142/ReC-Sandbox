+	void ApplyFilmGrain();
+	void RestoreFilmGrain();
+	void ApplyMotionBlur();
+	void RestoreMotionBlur();
+	void ApplySpriteBokeh();
+	void RestoreSpriteBokeh();
+	void ApplyLensCharacter();
+	void RestoreLensCharacter();
+	void ApplyStreaks();
+	void RestoreStreaks();
+	void ApplyHalation();
+	void RestoreHalation();
+	void ApplyWhiteBalance();
+	void RestoreWhiteBalance();
+	//! Viewfinder overlays (frame guides + focus peaking). Editor-live like the lens character.
+	void ApplyViewfinder();
+	void RestoreViewfinder();
+	//! Small monitor legend drawn next to the frame guides: aspect of the framing guide and
+	//! a one line framing readout. Overlay text, exactly like the guides themselves.
+	void DrawViewfinderText() const;
+
+private:
+	// Reflected properties
+
+	// Reflected property groups
+	SCineBodyParams m_body;
+	SCineLensParams m_lens;
+	SCineAnamorphicParams m_anamorphic;
+	SCineExposureParams m_exposure;
+	SCineDofParams m_dof;
+	SCineGrainParams m_grain;
+	SCineHalationParams m_halation;
+	SCineGhostParams m_ghosts;
+	SCineMotionBlurParams m_motionBlur;
+	SCineWhiteBalanceParams m_whiteBalance;
+	SCineStreaksParams m_streaks;
+	SCineFilterParams m_filter;
+	SCineViewfinderParams m_viewfinder;
+
+	// Zoom motor state: eased focal length chasing the quantised target.
+	float  m_focalMotorMm      = 0.0f;
+	uint32 m_focalMotorFrameId = 0;
+
+
+	// Sibling camera component (created in Initialize)
+	Cry::DefaultComponents::CCameraComponent* m_pCameraComponent = nullptr;
+
+	//! Set by Deactivate(): "no cinematic effects from this component until Activate()".
+	bool m_bCinematicSuspended = false;
+
+	// DOF saved params
+	float m_savedDofActive     = 0.f;
+	float m_savedDofUserActive = 0.f;
+	float m_savedDofFocusDist  = 3.5f;
+	float m_savedDofFocusRange = 5.f;
+	float m_savedDofBlurAmount = 1.f;
+	float m_savedDofBladeRotation = 0.f;
+	float m_savedDofBladeCurvature = 0.4f;
+	float m_savedDofMaskFNumber = 2.f;
+	float m_savedDofMaskRotation = 0.f;
+	float m_savedDofHighlightThreshold = 2.f;
+	float m_savedDofHighlightGain = 2.f;
+	float m_savedDofApertureBlades = 6.f;
+	float m_savedDofFNumber    = 2.f;
+	float m_savedDofAnamorphicSqueeze = 1.f;
+	float m_savedDofCatEye = 0.f;
+	float m_savedDofPupilScale = 1.f;
+	float m_savedDofComa = 0.f;
+	float m_savedDofAstigmatism = 0.f;
+	float m_savedDofFieldCurvature = 0.f;
+	float m_savedDofEdgeSoftness = 0.f;
+	float m_savedDofAxialChromatic = 0.f;
+	// Lens model (DofLensModelSpec.md): the switch plus the three quantities the stock focus
+	// range path never carried.
+	float m_savedDofLensModel = 0.f;
+	float m_savedDofLensFocal = 50.f;
+	float m_savedDofSensorWidth = 36.f;
+	float m_savedDofSphericalAberration = 0.f;
+	// Lens ghosts. They ride ApplyDOF because the renderer draws them inside the depth of field
+	// stage, sharing the splat layers - nothing about them depends on focus.
+	float m_savedDofGhostAmount = 0.f;
+	float m_savedDofGhostCount = 3.f;
+	float m_savedDofGhostSpread = 1.f;
+	float m_savedDofGhostSize = 1.f;
+	float m_savedDofGhostThreshold = 8.f;
+	float m_savedDofGhostHueSpread = 0.3f;
+	Vec4  m_savedDofGhostTint = Vec4(0.6f, 0.8f, 1.0f, 0.0f);
+	int   m_savedDofCVar       = 0;
+	bool  m_bDofParamsSaved    = false;
+
+	// Exposure saved param. Manual mode rewrites EV min and max as well as the auto
+	// compensation, so the whole vector has to be put back. AutoBiased tracks the TOD
+	// window through the base/last-written pair so its shift never compounds.
+	Vec3 m_savedEyeAdaptation = Vec3(4.5f, 17.0f, 1.5f);
+	Vec3 m_baseEyeAdaptationWindow = Vec3(4.5f, 17.0f, 1.5f);
+	Vec3 m_lastWrittenEyeAdaptation = Vec3(4.5f, 17.0f, 1.5f);
+	bool m_bExpParamsSaved    = false;
+
+	// Film grain saved param (FilterGrain_Amount post effect)
+	float m_savedGrainAmount  = 0.f;
+	bool  m_bGrainParamSaved  = false;
+
+	// White balance saved state (E3DPARAM_HDR_COLORGRADING_COLOR_BALANCE). The base tracks
+	// external (TOD) writes so our per-frame multiply never compounds on itself.
+	Vec3 m_savedColorBalance  = Vec3(1.0f);
+	Vec3 m_baseColorBalance   = Vec3(1.0f);
+	Vec3 m_lastWrittenBalance = Vec3(1.0f);
+	bool m_bWBParamsSaved     = false;
+
+	// Viewfinder saved cvars (r_LensGuides / r_LensGuide* / r_LensPeaking* / r_LensOverlays)
+	int   m_savedGuides         = 0;
+	float m_savedGuideAspect    = 2.39f;
+	float m_savedGuideOpacity   = 0.6f;
+	float m_savedPeaking        = 0.f;
+	float m_savedPeakingNear    = 0.f;
+	float m_savedPeakingFar     = 0.f;
+	int   m_savedPeakingColor   = 1;
+	int   m_savedOverlays       = 1;
+	bool  m_bViewfinderSaved    = false;
+
+	// Lens character saved cvars (r_HDRVignetteAmount / r_LensDistortion /
+	// r_LensChromaticAberration / r_LensLetterbox)
+	float m_savedVignetteAmount = 0.f;
+	float m_savedLensDistortion = 0.f;
+	float m_savedLensChromatic  = 0.f;
+	float m_savedLetterbox      = 0.f;
+	bool  m_bLensCharSaved      = false;
+
+	// Sprite bokeh saved state (r_DepthOfFieldMode cvar + Dof_User_BokehShapeTex post param).
+	// Unknown to an unmodified renderer, where the read returns nothing and the writes are dropped.
+	int    m_savedDofModeCVar  = 1;
+	// Whether we have pushed a shape texture name that still needs unbinding on restore.
+	bool   m_bBokehShapeTexPushed = false;
+	bool   m_bSpriteBokehSaved = false;
+
+	// Motion blur saved cvars (r_MotionBlurShutterSpeed / r_MotionBlur)
+	float m_savedMBShutter    = 250.f;
+	int   m_savedMBMode       = 0;
+	bool  m_bMBParamsSaved    = false;
+
+	// Diffraction streak saved params (HDR_Streaks_*). Unknown to an unmodified renderer,
+	// where the reads return 0 and the writes are silently dropped.
+	float m_savedStreaksActive    = 0.f;
+	float m_savedStreaksAmount    = 0.f;
+	float m_savedStreaksCount     = 8.f;
+	float m_savedStreaksAngle     = 0.f;
+	float m_savedStreaksLength    = 0.5f;
+	// Wave-optics diffraction glare (DiffractionKernelSpec.md), pushed alongside the analytic
+	// params: the mode switch decides which of the two the renderer actually draws, and the
+	// analytic ones stay live so r_HDRDiffractionKernel 0 can fall back without a frame of black.
+	float m_savedStreaksMode      = 1.f;
+	float m_savedStreaksWaveAmount = 1.f;
+	float m_savedStreaksWaveReach = 0.35f;
+	float m_savedStreaksDispersion = 1.f;
+	// Anamorphic horizontal flare, pushed alongside the blade streaks but gated separately.
+	float m_savedAnamorphicAmount    = 0.f;
+	float m_savedAnamorphicLength    = 0.7f;
+	float m_savedAnamorphicThreshold = 3.f;
+	Vec4  m_savedAnamorphicTint      = Vec4(0.35f, 0.62f, 1.0f, 0.0f);
+	// Front filter PSF (HDR_Filter_*), pushed alongside the streaks because a plate and an
+	// iris are both "what the front of the lens does to a point" and share one apply path.
+	float m_savedFilterAmount    = 0.f;
+	float m_savedFilterSize      = 0.25f;
+	float m_savedFilterRotation  = 0.f;
+	float m_savedFilterThreshold = 6.f;
+	float m_savedFilterPoints    = 4.f;
+	//! Whether we have pushed a PSF texture name that still needs unbinding on restore.
+	bool  m_bFilterPSFTexPushed  = false;
+	bool  m_bStreakParamsSaved    = false;
+
+	// Film halation saved params (HDR_Halation_*). Unknown to an unmodified renderer, where
+	// the reads return 0 and the writes are silently dropped.
+	float m_savedHalationAmount    = 0.f;
+	float m_savedHalationThreshold = 2.f;
+	float m_savedHalationRadius    = 0.5f;
+	Vec4  m_savedHalationTint      = Vec4(1.0f, 0.35f, 0.15f, 0.0f);
+	bool  m_bHalationSaved         = false;
+
+	// Derived cache of the camera manager's answer; written ONLY by ResolveActive().
+	static CCinematicCameraComponent* s_pActive;
+	//! Every live cinematic camera component. Main-thread only (entity lifecycle), no locking.
+	static std::vector<CCinematicCameraComponent*> s_all;
+};
diff --git a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraPlugin.cpp b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraPlugin.cpp
