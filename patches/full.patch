+////////////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////////////
+
+// Field-dependent pupil transmission: the fraction of the on-axis light that still passes when
+// the unit pupil disc is clipped by the mechanical barrel opening - a circle of radius R whose
+// centre sits d away from the pupil centre (both in pupil units). This is the closed form of
+// the two-disc intersection area divided by the pupil area, and it is shared by every stage
+// that has to agree on the same number: the tonemap applies it as the light loss, the splat
+// divides its deposit by it so the loss is not counted twice, and the gather only reshapes.
+// See FieldPupilSpec.md section 2.2.
+float LensFieldPupilTransmission(float d, float R)
+{
+	// Barrel pushed clear of the pupil: nothing gets through.
+	if (d >= 1.0 + R)
+		return 0.0;
+	// Barrel still encloses the whole pupil: no clipping at all. Also covers d == 0.
+	if (d <= R - 1.0)
+		return 1.0;
+	// Barrel sitting entirely inside the pupil (only reachable if the barrel is the smaller
+	// circle, i.e. R < 1); then the barrel itself is the aperture.
+	if (d <= 1.0 - R)
+		return R * R;
+
+	const float dc = max(d, 1e-4);
+	const float Rc = max(R, 1e-4);
+	const float a0 = acos(clamp((dc * dc + 1.0 - Rc * Rc) / (2.0 * dc), -1.0, 1.0));
+	const float a1 = acos(clamp((dc * dc + Rc * Rc - 1.0) / (2.0 * dc * Rc), -1.0, 1.0));
+	const float tri = sqrt(max((-dc + 1.0 + Rc) * (dc + 1.0 - Rc) * (dc - 1.0 + Rc) * (dc + 1.0 + Rc), 0.0));
+	return saturate((a0 + Rc * Rc * a1 - 0.5 * tri) / PI);
+}
