+
+namespace Cry
+{
+namespace PhoneTracker
+{
+
+class CPhoneTrackerPlugin final
+	: public Cry::IEnginePlugin
+	, public ISystemEventListener
+{
+public:
+	CRYINTERFACE_SIMPLE(Cry::IEnginePlugin)
+	CRYGENERATE_SINGLETONCLASS_GUID(CPhoneTrackerPlugin, "CryPhoneTracker", "7F1E4B08-6D3A-42F1-9D40-C1B7E2A5D330"_cry_guid)
+
+	virtual ~CPhoneTrackerPlugin();
+
+	// Cry::IEnginePlugin
+	virtual const char* GetCategory() const override { return "Tracking"; }
+	virtual bool        Initialize(SSystemGlobalEnvironment& env, const SSystemInitParams& initParams) override;
+	// ~Cry::IEnginePlugin
+
+	// ISystemEventListener
+	virtual void OnSystemEvent(ESystemEvent event, UINT_PTR wparam, UINT_PTR lparam) override;
+	// ~ISystemEventListener
+};
+
+} // namespace PhoneTracker
+} // namespace Cry
diff --git a/Code/CryPlugins/CryPhoneTracker/Module/PhoneTrackerProtocol.h b/Code/CryPlugins/CryPhoneTracker/Module/PhoneTrackerProtocol.h
new file mode 100644
index 00000000..a02fa473
--- /dev/null
+++ b/Code/CryPlugins/CryPhoneTracker/Module/PhoneTrackerProtocol.h
@@ -0,0 +1,129 @@
+// CryPhoneTracker - wire format shared with the Android "phonetracker" app.
+// Keep in sync with androidtracker/app/src/main/java/tw/bigspring/phonetracker/net/PacketCodec.kt
+// and androidtracker/tools/pose_monitor.py.
+#pragma once
+
+namespace Cry
+{
+namespace PhoneTracker
+{
+
+constexpr uint32 kPoseMagic    = 0x54443350; // 'P3DT' little endian
+constexpr uint32 kControlMagic = 0x54433350; // 'P3CT' little endian
+constexpr uint32 kLensMagic    = 0x534E4C50; // 'PLNS' little endian
+constexpr uint16 kProtocolVersion = 1;
+
+constexpr uint16 kPosePacketSize    = 64;
+constexpr uint16 kControlPacketSize = 28;
+constexpr uint16 kLensPacketSize    = 32;
+
+//! Bits carried in SPosePacket::flags.
+enum EPoseFlags : uint16
+{
+	ePoseFlag_Valid          = 1, //!< ARCore reported TRACKING for this frame.
+	ePoseFlag_SessionResumed = 2, //!< First sample after the AR session resumed.
+	ePoseFlag_OriginMark     = 4, //!< The phone recentered; originEpoch was bumped.
+	ePoseFlag_Heartbeat      = 8, //!< Keep-alive sample sent while tracking is lost.
+};
+
+//! Commands understood by the phone (sent back over the same socket).
+enum EControlCommand : uint16
+{
+	eControlCmd_Ping    = 1,
+	eControlCmd_Pong    = 2,
+	eControlCmd_Recenter = 3,
+	eControlCmd_SetRate = 4,
+	eControlCmd_Pause   = 5,
+	eControlCmd_Resume  = 6,
+	eControlCmd_SetFocus = 7, //!< PC -> phone: autofocus result; param = focus distance in millimetres.
+};
+
+//! Bits carried in SLensPacket::flags.
+enum ELensFlags : uint16
+{
+	eLensFlag_EnableDepthOfField = 1, //!< The operator armed depth of field on the phone.
+	eLensFlag_EnableExposure     = 2, //!< The operator armed EV compensation on the phone.
+	eLensFlag_AutofocusRequest   = 4, //!< One-shot: run a centre autofocus raycast in the scene.
+};
+
+#pragma pack(push, 1)
+
+struct SPosePacket
+{
+	uint32 magic;
+	uint16 version;
+	uint16 flags;
+	uint32 seq;
+	uint32 originEpoch;
+	int64  deviceNs;   //!< System.nanoTime() on the phone when the packet was queued.
+	int64  frameNs;    //!< ARCore frame timestamp.
+	float  px, py, pz; //!< Raw ARCore position (right handed, Y up, metres).
+	float  qx, qy, qz, qw;
+	uint8  trackingState;
+	uint8  failureReason;
+	uint8  batteryPct;
+	uint8  appFps;
+};
+
+//! Lens state pushed by the phone whenever a slider moves, plus a low rate keep-alive.
+struct SLensPacket
+{
+	uint32 magic;
+	uint16 version;
+	uint16 flags;
+	uint32 seq;
+	float  focalLengthMm;
+	float  apertureFNumber;
+	float  focusDistanceM;
+	float  evCompensation;
+	uint32 iso;              //!< Sensor sensitivity (e.g. 400). 0 = not sent (older phone app).
+};
+
+struct SControlPacket
+{
+	uint32 magic;
+	uint16 version;
+	uint16 cmd;
+	uint32 seq;
+	int64  pcNs;
+	int32  param;
+	int32  reserved;
+};
+
+#pragma pack(pop)
+
+static_assert(sizeof(SPosePacket) == kPosePacketSize, "Pose packet layout must match the phone");
+static_assert(sizeof(SControlPacket) == kControlPacketSize, "Control packet layout must match the phone");
+static_assert(sizeof(SLensPacket) == kLensPacketSize, "Lens packet layout must match the phone");
+
+//! ARCore is right handed with +Y up and -Z forward; CRYENGINE is right handed with +Z up
+//! and +Y forward. Same handedness, so the axis swap alone is enough (matches pose_monitor.py).
+inline Vec3 ArCoreToCryPosition(const SPosePacket& packet)
+{
+	return Vec3(packet.px, -packet.pz, packet.py);
+}
+
+inline Quat ArCoreToCryRotation(const SPosePacket& packet)
+{
+	Quat rotation;
+	rotation.w = packet.qw;
+	rotation.v = Vec3(packet.qx, -packet.qz, packet.qy);
+	rotation.Normalize();
+	return rotation;
+}
+
+inline SControlPacket MakeControlPacket(EControlCommand cmd, uint32 seq, int64 pcNs, int32 param = 0)
+{
+	SControlPacket packet;
+	ZeroStruct(packet);
+	packet.magic = kControlMagic;
+	packet.version = kProtocolVersion;
+	packet.cmd = static_cast<uint16>(cmd);
+	packet.seq = seq;
+	packet.pcNs = pcNs;
+	packet.param = param;
+	return packet;
+}
+
+} // namespace PhoneTracker
+} // namespace Cry
diff --git a/Code/CryPlugins/CryPhoneTracker/Module/PoseFilter.h b/Code/CryPlugins/CryPhoneTracker/Module/PoseFilter.h
new file mode 100644
index 00000000..0314851a
--- /dev/null
+++ b/Code/CryPlugins/CryPhoneTracker/Module/PoseFilter.h
@@ -0,0 +1,547 @@
+// CryPhoneTracker - handheld "virtual camera" pose filtering pipeline.
+//
+// Self contained, header only, no gEnv access and no dynamic allocation, so it can be unit
+// tested outside the engine. The pipeline runs entirely in tracker space (metres, ARCore axes
+// already swapped to Cry), before the component maps the pose into world space, which keeps
+// every threshold in physical units regardless of Metres To Units / Yaw Offset.
+//
+//   Stage A  clock rebasing        - map phone frame timestamps onto the engine clock
+//   Stage B  One Euro filter       - runs once per received packet
+//   Stage B' fixed delay resample  - runs once per rendered frame, from a 16 entry ring buffer
+//   Stage C  virtual tripod        - lock the image completely while the operator composes
+//
+#pragma once
+
+namespace Cry
+{
+namespace PhoneTracker
+{
+
+//! Master switch for the filtering pipeline.
+enum class EPoseFilterMode : uint32
+{
+	Off = 0,   //!< Bypass everything; frame identical to the unfiltered code path.
+	OneEuro,   //!< Stage A + B + B' only.
+	Cinematic, //!< Everything, including the virtual tripod.
+};
+
+//! Virtual tripod state, reported for debug draw.
+enum class EPoseFilterTripodState : uint32
+{
+	Moving = 0,
+	Arming,
+	Steady,
+	Blending,
+};
+
+//! Everything the component exposes to Schematyc, gathered in one plain struct.
+struct SPoseFilterParams
+{
+	float posMinCutoff = 1.0f;  //!< Hz. Static position jitter rejection; lower is steadier.
+	float posBeta = 0.5f;       //!< Per m/s. How quickly the cutoff opens up when moving.
+	float rotMinCutoff = 1.2f;  //!< Hz. Static rotation jitter rejection.
+	float rotBeta = 0.1f;       //!< Per rad/s. Rotation responsiveness.
+
+	float interpDelayFactor = 1.5f;   //!< Resample this many packet intervals behind the engine clock.
+	float maxExtrapolationMs = 0.0f;  //!< 0 disables extrapolation and freezes on the last pose instead.
+
+	bool  tripodEnabled = true;
+	float tripodEnterSpeed = 0.015f;  //!< m/s below which the tripod starts arming.
+	float tripodHoldTime = 0.25f;     //!< Seconds of stillness required before locking.
+	float tripodExitPosition = 0.01f; //!< Metres of drift from the anchor that releases the lock.
+	float tripodBlendTime = 0.15f;    //!< Seconds of smoothstep blend from anchor back to live.
+};
+
+//! Values only used for the debug overlay.
+struct SPoseFilterDebug
+{
+	EPoseFilterTripodState state = EPoseFilterTripodState::Moving;
+	float speed = 0.0f;             //!< m/s, filtered.
+	float angularSpeedDeg = 0.0f;   //!< deg/s, filtered.
+	float posCutoff = 0.0f;         //!< Hz, effective One Euro cutoff for the last packet.
+	float rotCutoff = 0.0f;         //!< Hz.
+	float blendWeight = 0.0f;       //!< 0..1 while leaving the tripod.
+	float resampleDelayMs = 0.0f;   //!< How far behind the engine clock we sample.
+	float extrapolationMs = 0.0f;   //!< How far past the newest sample we had to reach.
+	int   bufferDepth = 0;          //!< Samples currently held in the ring buffer.
+};
+
+//! Fixed pipeline constants; deliberately not exposed, to keep the property panel readable.
+constexpr int64 kDefaultIntervalNs = 33000000;      //!< 33 ms, the phone's nominal 30 Hz.
+constexpr int64 kMinIntervalNs = 4000000;           //!< 4 ms.
+constexpr int64 kMaxIntervalNs = 100000000;         //!< 100 ms.
+constexpr int64 kClockResetNs = 200000000;          //!< Disagreement that means the phone clock jumped.
+constexpr int64 kClockMaxCorrectionNs = 2000000;    //!< Absorb clock drift at most 2 ms per packet.
+constexpr double kClockEmaAlpha = 0.05;
+constexpr double kIntervalEmaAlpha = 0.1;
+
+constexpr float kDerivativeCutoff = 1.0f;           //!< Hz, low pass applied to the estimated derivatives.
+constexpr float kMinCutoff = 0.05f;                 //!< Hz, guards against a zeroed property.
+constexpr float kMinTe = 1.0f / 240.0f;             //!< Seconds, shortest accepted packet interval.
+constexpr float kMaxTe = 0.2f;                      //!< Seconds, longest accepted packet interval.
+constexpr float kEnterAngularDeg = 0.8f;            //!< deg/s below which the tripod may arm.
+constexpr float kExitAngleDeg = 0.5f;               //!< Rotation away from the anchor that releases it.
+constexpr float kExitSpeed = 0.05f;                 //!< m/s that releases the tripod immediately.
+constexpr float kSteadyCutoff = 0.1f;               //!< Hz, how slowly the anchor chases ARCore drift.
+constexpr float kSteadyDeadbandPos = 0.0005f;       //!< Metres of anchor dead band.
+constexpr float kSteadyDeadbandDeg = 0.02f;         //!< Degrees of anchor dead band.
+
+//! Handheld camera pose filter. Main thread only.
+class CPoseFilter
+{
+public:
+	static const int   kRingSize = 16;
+
+	CPoseFilter() { Reset(); }
+
+	void SetParams(const SPoseFilterParams& params) { m_params = params; }
+	const SPoseFilterParams& GetParams() const      { return m_params; }
+	const SPoseFilterDebug&  GetDebug() const       { return m_debug; }
+
+	bool        HasOutput() const     { return m_hasOutput; }
+	const QuatT& GetOutput() const    { return m_output; }
+
+	//! Drops every piece of history. The next pushed sample re-initialises the filter without
+	//! producing a transient, so this is safe to call on recenter / session resume / signal loss.
+	void Reset()
+	{
+		m_hasClock = false;
+		m_offsetNs = 0;
+		m_intervalNs = kDefaultIntervalNs;
+		m_lastFrameNs = 0;
+		m_lastSampleTimeNs = 0;
+
+		m_hasState = false;
+		m_posHat = Vec3(ZERO);
+		m_velHat = Vec3(ZERO);
+		m_rotHat = Quat(IDENTITY);
+		m_angVelHat = 0.0f;
+
+		m_count = 0;
+		m_next = 0;
+
+		m_hasOutput = false;
+		m_output = QuatT(IDENTITY);
+
+		m_tripodState = EPoseFilterTripodState::Moving;
+		m_armTimer = 0.0f;
+		m_blendTimer = 0.0f;
+		m_anchor = QuatT(IDENTITY);
+		m_blendFrom = QuatT(IDENTITY);
+
+		m_debug = SPoseFilterDebug();
+	}
+
+	//! Stage A + Stage B. Called for every valid pose packet, with the phone frame timestamp and
+	//! the engine clock reading taken when the packet was drained (both in nanoseconds).
+	void Push(int64 frameNs, int64 engineNowNs, const Vec3& position, const Quat& rotation)
+	{
+		// ---- Stage A: rebase the phone clock onto the engine clock ----------------------
+		const int64 instantOffset = engineNowNs - frameNs;
+		if (!m_hasClock)
+		{
+			m_offsetNs = instantOffset;
+			m_hasClock = true;
+		}
+		else
+		{
+			const int64 error = instantOffset - m_offsetNs;
+			if (error > kClockResetNs || error < -kClockResetNs)
+			{
+				// Phone clock jumped (new AR session, device sleep); start over cleanly.
+				Reset();
+				m_offsetNs = instantOffset;
+				m_hasClock = true;
+			}
+			else
+			{
+				int64 correction = static_cast<int64>(static_cast<double>(error) * kClockEmaAlpha);
+				correction = clamp_tpl(correction, -kClockMaxCorrectionNs, kClockMaxCorrectionNs);
+				m_offsetNs += correction;
+			}
+		}
+
+		float deltaSeconds = 0.0f;
+		if (m_hasState)
+		{
+			// Reject out of order / stale samples outright.
+			if (frameNs <= m_lastFrameNs)
+				return;
+
+			const int64 deltaNs = frameNs - m_lastFrameNs;
+
+			// Packet interval estimate, used by the fixed delay resampler.
+			const int64 clamped = clamp_tpl(deltaNs, kMinIntervalNs, kMaxIntervalNs);
+			m_intervalNs += static_cast<int64>(static_cast<double>(clamped - m_intervalNs) * kIntervalEmaAlpha);
+
+			deltaSeconds = clamp_tpl(static_cast<float>(static_cast<double>(deltaNs) * 1e-9), kMinTe, kMaxTe);
+		}
+
+		m_lastFrameNs = frameNs;
+
+		// ---- Stage B: One Euro ---------------------------------------------------------
+		Quat target = rotation;
+
+		if (!m_hasState)
+		{
+			m_posHat = position;
+			m_velHat = Vec3(ZERO);
+			m_rotHat = target;
+			m_angVelHat = 0.0f;
+			m_hasState = true;
+			m_debug.posCutoff = GetPosMinCutoff();
+			m_debug.rotCutoff = GetRotMinCutoff();
+		}
+		else
+		{
+			// Position: shared cutoff across all three axes so the axes never blur unevenly.
+			const Vec3 rawVelocity = (position - m_posHat) / deltaSeconds;
+			const float dAlpha = LowPassAlpha(kDerivativeCutoff, deltaSeconds);
+			m_velHat += (rawVelocity - m_velHat) * dAlpha;
+
+			const float speed = m_velHat.GetLength();
+			const float posCutoff = GetPosMinCutoff() + m_params.posBeta * speed;
+			const float posAlpha = LowPassAlpha(posCutoff, deltaSeconds);
+			m_posHat += (position - m_posHat) * posAlpha;
+			m_debug.posCutoff = posCutoff;
+
+			// Rotation: shortest arc, then the same adaptive scheme driven by angular rate.
+			if (m_rotHat.Dot(target) < 0.0f)
+			{
+				target = -target;
+			}
+
+			const Quat delta = m_rotHat.GetInverted() * target;
+			const float angle = 2.0f * acosf(clamp_tpl(delta.w, -1.0f, 1.0f));
+			const float rawAngular = angle / deltaSeconds;
+			m_angVelHat += (rawAngular - m_angVelHat) * dAlpha;
+
+			const float rotCutoff = GetRotMinCutoff() + m_params.rotBeta * m_angVelHat;
+			const float rotAlpha = LowPassAlpha(rotCutoff, deltaSeconds);
+			m_rotHat = Quat::CreateSlerp(m_rotHat, target, rotAlpha);
+			m_rotHat.Normalize();
+			m_debug.rotCutoff = rotCutoff;
+		}
+
+		// ---- Push into the ring buffer -------------------------------------------------
+		int64 sampleTimeNs = frameNs + m_offsetNs;
+		if (m_count > 0 && sampleTimeNs <= m_lastSampleTimeNs)
+		{
+			// The clock estimate moves slowly; make sure the buffer stays strictly monotonic.
+			sampleTimeNs = m_lastSampleTimeNs + 1;
+		}
+		m_lastSampleTimeNs = sampleTimeNs;
+
+		SSample& slot = m_samples[m_next];
+		slot.timeNs = sampleTimeNs;
+		slot.position = m_posHat;
+		slot.velocity = m_velHat;
+		slot.rotation = m_rotHat;
+		slot.angularSpeed = m_angVelHat;
+
+		m_next = (m_next + 1) % kRingSize;
+		if (m_count < kRingSize)
+		{
+			++m_count;
+		}
+	}
+
+	//! Stage B' + Stage C. Called once per rendered frame; returns false until the first sample
+	//! has arrived. \p cinematic enables the virtual tripod, \p frameTime is the engine frame time.
+	bool Sample(int64 engineNowNs, float frameTime, bool cinematic, QuatT& outPose)
+	{
+		m_debug.bufferDepth = m_count;
+		if (m_count == 0)
+			return false;
+
+		QuatT live = QuatT(IDENTITY);
+		Vec3 velocity = Vec3(ZERO);
+		float angularSpeed = 0.0f;
+		Resample(engineNowNs, live, velocity, angularSpeed);
+
+		m_debug.speed = velocity.GetLength();
+		m_debug.angularSpeedDeg = RAD2DEG(angularSpeed);
+
+		if (cinematic && m_params.tripodEnabled)
+		{
+			UpdateTripod(live, frameTime);
+		}
+		else
+		{
+			m_tripodState = EPoseFilterTripodState::Moving;
+			m_armTimer = 0.0f;
+			m_blendTimer = 0.0f;
+			m_debug.blendWeight = 0.0f;
+			m_output = live;
+		}
+
+		m_debug.state = m_tripodState;
+		m_hasOutput = true;
+		outPose = m_output;
+		return true;
+	}
+
+private:
+	struct SSample
+	{
+		int64 timeNs = 0;
+		Vec3  position = Vec3(ZERO);
+		Vec3  velocity = Vec3(ZERO);
+		Quat  rotation = Quat(IDENTITY);
+		float angularSpeed = 0.0f;
+	};
+
+	//! Generic first order low pass coefficient for a cutoff in Hz over an interval in seconds.
+	static float LowPassAlpha(float cutoffHz, float deltaSeconds)
+	{
+		const float safeCutoff = max(cutoffHz, kMinCutoff);
+		const float tau = 1.0f / (2.0f * gf_PI * safeCutoff);
+		return clamp_tpl(1.0f / (1.0f + tau / deltaSeconds), 0.0f, 1.0f);
+	}
+
+	float GetPosMinCutoff() const { return max(m_params.posMinCutoff, kMinCutoff); }
+	float GetRotMinCutoff() const { return max(m_params.rotMinCutoff, kMinCutoff); }
+
+	const SSample& GetSample(int index) const
+	{
+		// index 0 is the oldest entry currently held.
+		const int oldest = (m_next - m_count + 2 * kRingSize) % kRingSize;
+		return m_samples[(oldest + index) % kRingSize];
+	}
+
+	//! Stage B': sample the ring buffer at a fixed delay behind the engine clock.
+	void Resample(int64 engineNowNs, QuatT& outPose, Vec3& outVelocity, float& outAngularSpeed)
+	{
+		const double delayNs = static_cast<double>(m_intervalNs) * static_cast<double>(max(m_params.interpDelayFactor, 1.0f));
+		m_debug.resampleDelayMs = static_cast<float>(delayNs * 1e-6);
+		m_debug.extrapolationMs = 0.0f;
+
+		const int64 queryNs = engineNowNs - static_cast<int64>(delayNs);
+
+		const SSample& newest = GetSample(m_count - 1);
+		if (m_count < 2)
+		{
+			outPose = QuatT(newest.rotation, newest.position);
+			outVelocity = newest.velocity;
+			outAngularSpeed = newest.angularSpeed;
+			return;
+		}
+
+		const SSample& oldest = GetSample(0);
+		if (queryNs <= oldest.timeNs)
+		{
+			outPose = QuatT(oldest.rotation, oldest.position);
+			outVelocity = oldest.velocity;
+			outAngularSpeed = oldest.angularSpeed;
+			return;
+		}
+
+		if (queryNs >= newest.timeNs)
+		{
+			// Signal gap: extrapolate for a while, then hold. Never snap back.
+			outVelocity = newest.velocity;
+			outAngularSpeed = newest.angularSpeed;
+			outPose = QuatT(newest.rotation, newest.position);
+
+			const float maxExtrapolation = max(m_params.maxExtrapolationMs, 0.0f) * 0.001f;
+			const float ahead = static_cast<float>(static_cast<double>(queryNs - newest.timeNs) * 1e-9);
+			m_debug.extrapolationMs = ahead * 1000.0f;
+			if (maxExtrapolation > 0.0f)
+			{
+				// Linear decay of the velocity contribution: integrating v * (1 - t / tMax).
+				const float t = min(ahead, maxExtrapolation);
+				outPose.t += newest.velocity * (t * (1.0f - 0.5f * t / maxExtrapolation));
+			}
+			return;
+		}
+
+		// Find the pair bracketing the query time, newest first (the common case is the last pair).
+		int right = m_count - 1;
+		while (right > 1 && GetSample(right - 1).timeNs > queryNs)
+		{
+			--right;
+		}
+
+		const SSample& a = GetSample(right - 1);
+		const SSample& b = GetSample(right);
+
+		const float span = static_cast<float>(static_cast<double>(b.timeNs - a.timeNs) * 1e-9);
+		const float s = span > 0.0f ? clamp_tpl(static_cast<float>(static_cast<double>(queryNs - a.timeNs) * 1e-9) / span, 0.0f, 1.0f) : 0.0f;
+
+		// Position: cubic Hermite with the filtered velocities as tangents.
+		const float s2 = s * s;
+		const float s3 = s2 * s;
+		const float h00 = 2.0f * s3 - 3.0f * s2 + 1.0f;
+		const float h10 = s3 - 2.0f * s2 + s;
+		const float h01 = -2.0f * s3 + 3.0f * s2;
+		const float h11 = s3 - s2;
+
+		outPose.t = a.position * h00 + a.velocity * (h10 * span) + b.position * h01 + b.velocity * (h11 * span);
+
+		// Rotation: the One Euro stage already removed the jitter, so a slerp is plenty.
+		outPose.q = Quat::CreateSlerp(a.rotation, b.rotation, s);
+		outPose.q.Normalize();
+
+		outVelocity = Vec3::CreateLerp(a.velocity, b.velocity, s);
+		outAngularSpeed = a.angularSpeed + (b.angularSpeed - a.angularSpeed) * s;
+	}
+
+	//! Stage C: hysteresis driven lock/release around a stationary anchor pose.
+	void UpdateTripod(const QuatT& live, float frameTime)
+	{
+		const float dt = max(frameTime, 0.0f);
+		const bool stillEnough = m_debug.speed < max(m_params.tripodEnterSpeed, 0.0f)
+		                         && m_debug.angularSpeedDeg < kEnterAngularDeg;
+
+		switch (m_tripodState)
+		{
+		case EPoseFilterTripodState::Moving:
+			{
+				if (stillEnough)
+				{
+					m_tripodState = EPoseFilterTripodState::Arming;
+					m_armTimer = 0.0f;
+				}
+				m_output = live;
+			}
+			break;
+
+		case EPoseFilterTripodState::Arming:
+			{
+				if (!stillEnough)
+				{
+					m_tripodState = EPoseFilterTripodState::Moving;
+					m_armTimer = 0.0f;
+				}
+				else
+				{
+					m_armTimer += dt;
+					if (m_armTimer >= max(m_params.tripodHoldTime, 0.0f))
+					{
+						m_tripodState = EPoseFilterTripodState::Steady;
+						m_anchor = live;
+					}
+				}
+				m_output = live;
+			}
+			break;
+
+		case EPoseFilterTripodState::Steady:
+			{
+				TrackAnchor(live, dt);
+
+				const float drift = (live.t - m_anchor.t).GetLength();
+				const float angle = AngleBetween(m_anchor.q, live.q);
+				if (drift > max(m_params.tripodExitPosition, 0.0f)
+				    || angle > DEG2RAD(kExitAngleDeg)
+				    || m_debug.speed > kExitSpeed)
+				{
+					m_tripodState = EPoseFilterTripodState::Blending;
+					m_blendTimer = 0.0f;
+					m_blendFrom = m_anchor;
+				}
+				m_output = m_anchor;
+			}
+			break;
+
+		case EPoseFilterTripodState::Blending:
+			{
+				if (stillEnough)
+				{
+					// Re-lock straight from wherever the blend currently is; no visible step.
+					m_tripodState = EPoseFilterTripodState::Steady;
+					m_anchor = m_output;
+					m_armTimer = 0.0f;
+					m_blendTimer = 0.0f;
+					m_debug.blendWeight = 0.0f;
+					break;
+				}
+
+				m_blendTimer += dt;
+				const float blendTime = max(m_params.tripodBlendTime, 0.0001f);
+				const float u = clamp_tpl(m_blendTimer / blendTime, 0.0f, 1.0f);
+				const float w = u * u * (3.0f - 2.0f * u); // smoothstep
+				m_debug.blendWeight = w;
+
+				m_output.t = Vec3::CreateLerp(m_blendFrom.t, live.t, w);
+				m_output.q = Quat::CreateSlerp(m_blendFrom.q, live.q, w);
+				m_output.q.Normalize();
+
+				if (u >= 1.0f)
+				{
+					m_tripodState = EPoseFilterTripodState::Moving;
+					m_debug.blendWeight = 0.0f;
+				}
+			}
+			break;
+		}
+
+		if (m_tripodState != EPoseFilterTripodState::Blending)
+		{
+			m_debug.blendWeight = 0.0f;
+		}
+	}
+
+	//! Let the anchor creep towards the live pose so ARCore's slow drift is absorbed, but leave it
+	//! bit-identical while the difference sits inside the dead band; that is what makes a phone
+	//! resting on a table produce a literally unchanging transform.
+	void TrackAnchor(const QuatT& live, float dt)
+	{
+		if (dt <= 0.0f)
+			return;
+
+		const float alpha = LowPassAlpha(kSteadyCutoff, dt);
+
+		const Vec3 offset = live.t - m_anchor.t;
+		if (offset.GetLength() > kSteadyDeadbandPos)
+		{
+			m_anchor.t += offset * alpha;
+		}
+
+		if (AngleBetween(m_anchor.q, live.q) > DEG2RAD(kSteadyDeadbandDeg))
+		{
+			m_anchor.q = Quat::CreateSlerp(m_anchor.q, live.q, alpha);
+			m_anchor.q.Normalize();
+		}
+	}
+
+	static float AngleBetween(const Quat& a, const Quat& b)
+	{
+		const float dot = clamp_tpl(fabs_tpl(a.Dot(b)), 0.0f, 1.0f);
+		return 2.0f * acosf(dot);
+	}
+
+	SPoseFilterParams m_params;
+	SPoseFilterDebug  m_debug;
+
+	// Stage A state.
+	bool  m_hasClock = false;
+	int64 m_offsetNs = 0;
+	int64 m_intervalNs = kDefaultIntervalNs;
+	int64 m_lastFrameNs = 0;
+	int64 m_lastSampleTimeNs = 0;
+
+	// Stage B state.
+	bool  m_hasState = false;
+	Vec3  m_posHat = Vec3(ZERO);
+	Vec3  m_velHat = Vec3(ZERO);
+	Quat  m_rotHat = Quat(IDENTITY);
+	float m_angVelHat = 0.0f;
+
+	// Ring buffer.
+	SSample m_samples[kRingSize];
+	int     m_count = 0;
+	int     m_next = 0;
+
+	// Stage C state and the resulting output pose.
+	bool                   m_hasOutput = false;
+	QuatT                  m_output = QuatT(IDENTITY);
+	EPoseFilterTripodState m_tripodState = EPoseFilterTripodState::Moving;
+	float                  m_armTimer = 0.0f;
+	float                  m_blendTimer = 0.0f;
+	QuatT                  m_anchor = QuatT(IDENTITY);
+	QuatT                  m_blendFrom = QuatT(IDENTITY);
+};
+
+} // namespace PhoneTracker
+} // namespace Cry
