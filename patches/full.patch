+	Schematyc::Range<0, 1, 0, 1> starSize = 0.25f;
+	Schematyc::Range<0, 360, 0, 360> starRotation = 0.f;
+	Schematyc::Range<1, 64, 2, 16> starThreshold = 6.0f;
+	// Keep last: operator== memcmp's the members in front of this one.
+	Schematyc::TextureFileName psfTexture;
+};
