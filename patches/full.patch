+// Front filter (FilterPSFSpec.md). A plate screwed onto the front of the lens - etched grooves
+// for a star filter, or any other authored point spread function. Every bright point in the
+// frame is convolved with it, at every f-number: this is glass in front of the lens, not the
+// iris, so nothing here follows the aperture.
+struct SCineFilterParams
+{
+	// psfTexture holds a string, so only the POD prefix in front of it can be memcmp'd -
+	// exactly as SCineLensParams does for its bokeh shape texture.
+	inline bool operator==(const SCineFilterParams& rhs) const
+	{
+		return 0 == memcmp(this, &rhs, offsetof(SCineFilterParams, psfTexture))
+		       && psfTexture.value == rhs.psfTexture.value;
+	}
+
+	static void ReflectType(Schematyc::CTypeDesc<SCineFilterParams>& desc)
+	{
+		desc.SetGUID("{7D4B0E96-31CA-4F58-6BD2-84E17C0A9F63}"_cry_guid);
+		desc.SetLabel("Front Filter");
+		desc.AddMember(&SCineFilterParams::starAmount,
+			'flAm', "StarAmount", "Star Amount",
+			"Strength of the star / PSF filter: a plate of etched grooves in front of the lens "
+			"diffracts every bright point into lines, at every f-number (unlike the iris "
+			"sunstars, which need stopping down). 0 = off (no pass runs).", 0.0f);
+		desc.AddMember(&SCineFilterParams::starPoints,
+			'flPt', "StarPoints", "Star Points",
+			"Points of the procedural star when no PSF texture is set: 4, 6 or 8 (odd values "
+			"round down). Each pair of points is one groove direction.", 4);
+		desc.AddMember(&SCineFilterParams::starSize,
+			'flSz', "StarSize", "Star Size",
+			"Reach of the pattern, as a fraction of the frame height. Brighter sources show "
+			"more of it - the pattern is fixed, only its faint tail rises above the scene.", 0.25f);
+		desc.AddMember(&SCineFilterParams::starRotation,
+			'flRt', "StarRotation", "Star Rotation (deg)",
+			"Turning the filter turns the star.", 0.0f);
+		desc.AddMember(&SCineFilterParams::starThreshold,
+			'flTh', "StarThreshold", "Star Threshold",
+			"Scene HDR luminance a source needs to spawn the pattern.", 6.0f);
+		desc.AddMember(&SCineFilterParams::psfTexture,
+			'flTx', "PSFTexture", "PSF Texture",
+			"RGB point-spread image of the filter: what one bright point looks like through it, "
+			"centred, black outside the pattern. Covers any front-element PSF a preset wants - "
+			"a dirty or smeared filter, a custom flare plate. Same asset type as the bokeh shape "
+			"masks: an uncompressed 32-bit DDS, e.g. textures/lights/lens_flares/filter_star6.dds. "
+			"Empty = procedural star.",
+			Schematyc::TextureFileName());
+	}
+
+	Schematyc::Range<0, 2, 0, 1> starAmount = 0.0f;
