+// streaks travel through the existing bloom composition instead of a second tone-map hook.
+void CBloomStage::ExecuteStreaks()
+{
+	if (!CRenderer::CV_r_HDRStreaks)
+	{
+		ReleaseDiffractionTargets();
+		return;
+	}
+
+	CHDRStreaks* pStreaksTech = static_cast<CHDRStreaks*>(PostEffectMgr()->GetEffect(EPostEffectID::HDRStreaks));
+	if (pStreaksTech == nullptr)
+	{
+		ReleaseDiffractionTargets();
+		return;
+	}
+
+	SHDRStreaksParams streakParams = pStreaksTech->GetParams();
+
