+//! Binds an entity to the Android ARCore tracker: listens for pose packets on a UDP port and
+//! writes the received 6DoF pose into the entity transform every frame.
+struct SPhoneConnectionParams
+{
+	inline bool operator==(const SPhoneConnectionParams& rhs) const { return 0 == memcmp(this, &rhs, sizeof(rhs)); }
+
+	static void ReflectType(Schematyc::CTypeDesc<SPhoneConnectionParams>& desc)
+	{
+		desc.SetGUID("{93F6E82C-B5DA-449F-92E7-6A83FC4935F9}"_cry_guid);
+		desc.SetLabel("Connection");
+		desc.AddMember(&SPhoneConnectionParams::enabled, 'enab', "Enabled", "Enabled", "Open the socket and drive the entity while in game/simulation mode", true);
+		desc.AddMember(&SPhoneConnectionParams::port, 'port', "Port", "Listen Port", "UDP port the phone sends pose packets to", 9050);
+		desc.AddMember(&SPhoneConnectionParams::trackerId, 'tid', "TrackerId", "Tracker ID", "Number shown in logs and the debug overlay so multiple trackers can be told apart. 0 = automatic (order of creation)", 0);
+	}
+
+	bool enabled = true;
+	Schematyc::Range<1, 65535, 1024, 65535, int> port = 9050;
+	Schematyc::Range<0, 99, 0, 99, int> trackerId = 0;
+};
+
+struct SPhoneMappingParams
+{
+	inline bool operator==(const SPhoneMappingParams& rhs) const { return 0 == memcmp(this, &rhs, sizeof(rhs)); }
+
+	static void ReflectType(Schematyc::CTypeDesc<SPhoneMappingParams>& desc)
+	{
+		desc.SetGUID("{A407F93D-C6EB-45A0-93F8-7B94FD5A460A}"_cry_guid);
+		desc.SetLabel("Transform Mapping");
+		desc.AddMember(&SPhoneMappingParams::followActiveCamera, 'folw', "FollowActiveCamera", "Follow Active Camera", "Drive whichever Cinematic Camera is currently active (switch with 'ccam_slot N') instead of this entity. On every switch the tracker re-anchors at the new camera's position, so the phone carries on from wherever that camera was placed. Falls back to this entity when no cinematic camera is active", true);
+		desc.AddMember(&SPhoneMappingParams::applyPosition, 'apos', "ApplyPosition", "Apply Position", "Write the tracked translation into the entity transform", true);
+		desc.AddMember(&SPhoneMappingParams::applyRotation, 'arot', "ApplyRotation", "Apply Rotation", "Write the tracked rotation into the entity transform", true);
+		desc.AddMember(&SPhoneMappingParams::relativeToStartTransform, 'rel', "Relative", "Relative To Start", "Treat the tracker origin as the entity transform captured when tracking started. Disable to place the entity at raw tracker coordinates", true);
+		desc.AddMember(&SPhoneMappingParams::alignYawOnStart, 'ayaw', "AlignYawOnStart", "Align Yaw On Start", "Anchor using only the yaw of the starting poses (phone and entity). Pitch and roll stay gravity aligned, so turning the phone always rotates the entity around the world up axis - without this, a tilted phone at capture time tilts the whole rotation frame", true);
+		desc.AddMember(&SPhoneMappingParams::scale, 'scal', "Scale", "Metres To Units", "Multiplier applied to the tracked translation (1 = 1 metre per engine unit)", 1.0f);
+		desc.AddMember(&SPhoneMappingParams::yawOffsetDegrees, 'yaw', "YawOffset", "Yaw Offset", "Rotation around Z applied to the tracked motion, to align the phone heading with the scene", 0.0f);
+		desc.AddMember(&SPhoneMappingParams::positionOffset, 'poff', "PositionOffset", "Position Offset", "Extra world space offset added after the tracked translation", Vec3(ZERO));
+	}
+
