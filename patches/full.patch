+	float fAnamorphicAmount;    //!< 0-3 strength. 0 = the flare passes do not run at all.
+	float fAnamorphicLength;    //!< 0-1, how far the line reaches across the frame.
+	float fAnamorphicThreshold; //!< Scene HDR value a source has to exceed to throw a flare.
+	Vec4  vAnamorphicTint;      //!< (rgb, unused) colour of the line; classic coatings give cyan-blue.
+
+	//! Front filter point spread function (FilterPSFSpec.md): a plate of etched grooves in
+	//! FRONT of the lens convolves every bright point with one fixed pattern. It lives here
+	//! rather than in its own effect because these params are all "what the front of the lens
+	//! does to a point". Unlike the iris diffraction above it does not follow the f-number -
+	//! a plate is not the aperture.
+	float     fFilterAmount;    //!< 0-2 strength. 0 = the sprite pass does not run at all.
+	float     fFilterSize;      //!< Reach of the pattern as a fraction of the frame height.
+	float     fFilterRotation;  //!< Radians the plate is turned by; turns the whole pattern.
+	float     fFilterThreshold; //!< Scene HDR value a source has to exceed to spawn the pattern.
+	int       nFilterPoints;    //!< Points of the procedural star when no PSF texture is bound (4/6/8).
+	CTexture* pFilterPSFTex;    //!< RGB point spread image, centred, black outside. Null = procedural star.
+
+	//! Wave-optics diffraction mode (DiffractionKernelSpec.md). 0 = Analytic (the line pairs
+	//! above), 1 = Wave: the frame's highlights are convolved with |FFT(pupil)|^2, the real
+	//! diffraction pattern of the iris. The two are exclusive; the anamorphic flare and the
+	//! front filter are unaffected either way.
+	int   nMode;         //!< 0 = analytic line pairs, 1 = wave-optics kernel.
+	float fWaveAmount;   //!< 0-200 source radiance boost for the wave glare. 1 = the source's HDR
+	                     //!< value taken as its true radiance (physically exact, nearly invisible).
+	float fWaveReach;    //!< Sprite radius as a fraction of frame height: where the 1/u^2 tail is cut off.
+	float fDispersion;   //!< 0-1. 1 = the full six-wavelength rainbow, 0 = a monochrome pattern at 550 nm.
+};
+
+//! Parameter container only - the passes live in CBloomStage, which reads these the same way
+//! CDepthOfFieldStage reads SDepthOfFieldParams.
+class CHDRStreaks : public CPostEffect
+{
+public:
+	CHDRStreaks()
+	{
+		m_nRenderFlags = 0;
+		m_nID = EPostEffectID::HDRStreaks;
+
+		AddParamBool("HDR_Streaks_Active", m_pActive, 0);
+		AddParamFloatNoTransition("HDR_Streaks_Amount", m_pAmount, 0.0f);
+		AddParamFloatNoTransition("HDR_Streaks_Count", m_pCount, 8.0f);
+		AddParamFloatNoTransition("HDR_Streaks_Angle", m_pAngle, 0.0f);
+		AddParamFloatNoTransition("HDR_Streaks_Threshold", m_pThreshold, 4.0f);
+		AddParamFloatNoTransition("HDR_Streaks_Length", m_pLength, 0.5f);
+
+		AddParamFloatNoTransition("HDR_Streaks_AnamorphicAmount", m_pAnamorphicAmount, 0.0f);
+		AddParamFloatNoTransition("HDR_Streaks_AnamorphicLength", m_pAnamorphicLength, 0.7f);
+		AddParamFloatNoTransition("HDR_Streaks_AnamorphicThreshold", m_pAnamorphicThreshold, 3.0f);
+		AddParamVec4NoTransition("HDR_Streaks_AnamorphicTint", m_pAnamorphicTint, Vec4(0.35f, 0.62f, 1.0f, 0.0f));
+
+		AddParamFloatNoTransition("HDR_Filter_Amount", m_pFilterAmount, 0.0f);
+		AddParamFloatNoTransition("HDR_Filter_Size", m_pFilterSize, 0.25f);
+		AddParamFloatNoTransition("HDR_Filter_Rotation", m_pFilterRotation, 0.0f);
+		AddParamFloatNoTransition("HDR_Filter_Threshold", m_pFilterThreshold, 6.0f);
+		AddParamFloatNoTransition("HDR_Filter_Points", m_pFilterPoints, 4.0f);
+		AddParamTex("HDR_Filter_PSFTex", m_pFilterPSFTex, 0);
+
+		AddParamFloatNoTransition("HDR_Streaks_Mode", m_pMode, 1.0f);
+		AddParamFloatNoTransition("HDR_Streaks_WaveAmount", m_pWaveAmount, 1.0f);
+		AddParamFloatNoTransition("HDR_Streaks_WaveReach", m_pWaveReach, 0.35f);
+		AddParamFloatNoTransition("HDR_Streaks_Dispersion", m_pDispersion, 1.0f);
+	}
+
+	//! Never preprocessed or executed: the effect exists purely to own the parameters.
+	virtual bool Preprocess(const SRenderViewInfo& viewInfo) override
+	{
+		return false;
+	}
+
+	virtual void Execute() override
+	{
+	}
+
+	virtual void        Reset(bool bOnSpecChange = false) override;
+
+	SHDRStreaksParams   GetParams() const;
+
+	virtual const char* GetName() const override
+	{
+		return "HDRStreaks";
+	}
+
+	//! Performance ceiling. A 16 blade iris would ask for 16 rays and an odd blade count for
+	//! twice its blade count; both are clamped down to this, which is not a bug.
+	static const int s_nMaxDirections = 24; //!< Spike count cap (each renderer pass draws two opposed spikes).
+
+private:
+	CEffectParam* m_pAmount, * m_pCount, * m_pAngle, * m_pThreshold, * m_pLength;
+	// Anamorphic horizontal flare: float, float, float, Vec4
+	CEffectParam* m_pAnamorphicAmount, * m_pAnamorphicLength, * m_pAnamorphicThreshold, * m_pAnamorphicTint;
+	// Front filter PSF: four floats, a float carrying the star's point count, and a CTexture.
+	CEffectParam* m_pFilterAmount, * m_pFilterSize, * m_pFilterRotation, * m_pFilterThreshold, * m_pFilterPoints;
+	CEffectParam* m_pFilterPSFTex;
+	// Wave-optics diffraction: the mode switch and the three knobs that only apply in it.
+	CEffectParam* m_pMode, * m_pWaveAmount, * m_pWaveReach, * m_pDispersion;
+};
