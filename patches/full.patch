+
+	static void ReflectType(Schematyc::CTypeDesc<SPhoneFilterParams>& desc)
+	{
+		desc.SetGUID("{B518FA4E-D7FC-46B1-84F9-8CA5FE6B571B}"_cry_guid);
+		desc.SetLabel("Pose Filter");
+		desc.AddMember(&SPhoneFilterParams::filterMode, 'fmod', "FilterMode", "Filter Mode", "Off reproduces the unfiltered behaviour exactly. One Euro adds clock rebasing, adaptive smoothing and fixed delay resampling. Cinematic adds the virtual tripod on top", EPoseFilterMode::Cinematic);
+		desc.AddMember(&SPhoneFilterParams::posMinCutoff, 'pmcu', "PosMinCutoff", "Position Min Cutoff", "Hz. Lower values kill more jitter while the camera is still", 1.0f);
+		desc.AddMember(&SPhoneFilterParams::posBeta, 'pbet', "PosBeta", "Position Speed Coefficient", "How fast the position cutoff opens up with speed, per m/s. Raise it if fast moves feel laggy", 0.5f);
+		desc.AddMember(&SPhoneFilterParams::rotMinCutoff, 'rmcu', "RotMinCutoff", "Rotation Min Cutoff", "Hz. Lower values kill more rotational jitter while the camera is still", 1.2f);
+		desc.AddMember(&SPhoneFilterParams::rotBeta, 'rbet', "RotBeta", "Rotation Speed Coefficient", "How fast the rotation cutoff opens up with angular rate, per rad/s", 0.1f);
+		desc.AddMember(&SPhoneFilterParams::interpDelayFactor, 'idly', "InterpDelay", "Resample Delay", "Packet intervals of buffering used to hide network jitter. Higher is smoother but adds latency", 1.5f);
