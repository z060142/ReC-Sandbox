+
+struct SHDRStreaksParams;
 
 class CBloomStage : public CGraphicsPipelineStage
 {
 public:
 	static const EGraphicsPipelineStage StageID = eStage_Bloom;
 
+	//! Ray count ceiling for the diffraction streaks, mirrored by CHDRStreaks::s_nMaxDirections.
