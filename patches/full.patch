diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DiffractionKernel.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DiffractionKernel.cpp
new file mode 100644
index 00000000..8c74d228
--- /dev/null
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DiffractionKernel.cpp
@@ -0,0 +1,774 @@
+// Copyright 2015-2021 Crytek GmbH / Crytek Group. All rights reserved.
+
+#include "StdAfx.h"
+#include "DiffractionKernel.h"
+
+#include <CryThreading/IJobManager_JobDelegator.h>
+
+#include <algorithm>
+#include <complex>
+
+//! The iris polygon's radius function, normalised so the edge midpoints sit at 1 and the corners
+//! at 1/cos(pi/n). Defined in DepthOfField.cpp: the gather kernel, the splat mask and this pupil
+//! are three views of ONE iris and may not derive its outline separately.
+extern float NGon_Rad(float theta, float n);
+
+void DiffractionKernelAsyncBuild(CDiffractionKernel*);
+DECLARE_JOB("DiffractionKernel", TDiffractionKernelJob, DiffractionKernelAsyncBuild);
+
+void DiffractionKernelAsyncBuild(CDiffractionKernel* pKernel)
+{
+	if (pKernel)
+		pKernel->BuildJob();
+}
+
+namespace
+{
+typedef std::complex<float> complexF;
+
+//! Reference wavelength. Everything the CPU computes is in pupil units and therefore wavelength
+//! independent; lambda0 only fixes what "1 kernel texel" means on the sensor, and the pixel
+//! shader's six spectral samples are scaled copies about it.
+const float kLambda0 = 550e-9f;
+
+//! Radius of the removed core, in Airy radii. The frame already carries the source itself and
+//! its bloom, so the kernel must contain ONLY the diffracted light - otherwise every highlight
+//! would be added to the picture a second time.
+const float kCoreAiryRadii = 2.5f;
+
+//! Radius, in Airy radii, past which the pattern is what the viewer actually calls "the rays":
+//! far enough out that the source's own bloom no longer covers it. Diagnostics only.
+const float kFarAiryRadii = 20.0f;
+
+//! Width of the boundary ring the far-field extrapolation is read off, in texels.
+const float kRingWidth = 4.0f;
+
+// ---------------------------------------------------------------------------------------------
+// Radix-2 complex FFT, "2 Dimensional FFT" by Paul Bourke. Lifted verbatim (bar the grid size
+// becoming a parameter) from CWaterSim::ComputeFFT1D/2D in Common/WaterUtils.cpp, deliberately
+// as a COPY: the ocean simulation is a fixed 64^2 grid inside a singleton with its own job and
+// its own lifetime, and neither of us wants a dependency on the other's.
+// ---------------------------------------------------------------------------------------------
+void ComputeFFT1D(int nDir, int nSize, int nLogSize, float* pReal, float* pImag)
+{
+	long nn, i, i1, j, k, i2, l, l1, l2;
+	float c1, c2, fReal, fImag, t1, t2, u1, u2, z;
+
+	nn = nSize;
+	const float fRecipNN = 1.0f / (float)nn;
+
+	// Bit reversal
+	i2 = nn >> 1;
+	j = 0;
+	for (i = 0; i < nn - 1; ++i)
+	{
+		if (i < j)
+		{
+			fReal = pReal[i];
+			fImag = pImag[i];
+			pReal[i] = pReal[j];
+			pImag[i] = pImag[j];
+			pReal[j] = fReal;
+			pImag[j] = fImag;
+		}
+
+		k = i2;
+		while (k <= j)
+		{
+			j -= k;
+			k >>= 1;
+		}
+
+		j += k;
+	}
+
+	// Butterflies
+	c1 = -1.0f;
+	c2 = 0.0f;
+	l2 = 1;
+	for (l = 0; l < nLogSize; ++l)
+	{
+		l1 = l2;
+		l2 <<= 1;
+		u1 = 1.0f;
+		u2 = 0.0f;
+		for (j = 0; j < l1; ++j)
+		{
+			for (i = j; i < nn; i += l2)
+			{
+				i1 = i + l1;
+				t1 = u1 * pReal[i1] - u2 * pImag[i1];
+				t2 = u1 * pImag[i1] + u2 * pReal[i1];
+				pReal[i1] = pReal[i] - t1;
+				pImag[i1] = pImag[i] - t2;
+				pReal[i] += t1;
+				pImag[i] += t2;
+			}
+
+			z = u1 * c1 - u2 * c2;
+			u2 = u1 * c2 + u2 * c1;
+			u1 = z;
+		}
+
+		c2 = sqrt_fast_tpl((1.0f - c1) * 0.5f);
+
+		if (nDir == 1)
+			c2 = -c2;
+
+		c1 = sqrt_fast_tpl((1.0f + c1) * 0.5f);
+	}
+
+	// Scaling for the forward transform
+	if (nDir == 1)
+	{
+		for (i = 0; i < nn; ++i)
+		{
+			pReal[i] *= fRecipNN;
+			pImag[i] *= fRecipNN;
+		}
+	}
+}
+
+void ComputeFFT2D(int nDir, int nSize, int nLogSize, complexF* const __restrict c)
+{
+	std::vector<float> real((size_t)nSize);
+	std::vector<float> imag((size_t)nSize);
+	float* pReal = real.data();
+	float* pImag = imag.data();
+
+	// Rows
+	for (int y = 0; y < nSize; ++y)
+	{
+		complexF* pRow = c + (size_t)y * nSize;
+		for (int x = 0; x < nSize; ++x)
+		{
+			pReal[x] = pRow[x].real();
+			pImag[x] = pRow[x].imag();
+		}
+
+		ComputeFFT1D(nDir, nSize, nLogSize, pReal, pImag);
+
+		for (int x = 0; x < nSize; ++x)
+			pRow[x] = complexF(pReal[x], pImag[x]);
+	}
+
+	// Columns
+	for (int x = 0; x < nSize; ++x)
+	{
+		for (int y = 0; y < nSize; ++y)
+		{
+			const complexF& curC = c[(size_t)y * nSize + x];
+			pReal[y] = curC.real();
+			pImag[y] = curC.imag();
+		}
+
+		ComputeFFT1D(nDir, nSize, nLogSize, pReal, pImag);
+
+		for (int y = 0; y < nSize; ++y)
+			c[(size_t)y * nSize + x] = complexF(pReal[y], pImag[y]);
+	}
+}
+
+//! Bilinear sample of the mask's R channel, clamped. uv in [0, 1], 0 outside.
+float SampleMask(const uint8* pPixels, int w, int h, float u, float v)
+{
+	if (u < 0.0f || u > 1.0f || v < 0.0f || v > 1.0f)
+		return 0.0f;
+
+	const float fx = clamp_tpl(u * (float)w - 0.5f, 0.0f, (float)(w - 1));
+	const float fy = clamp_tpl(v * (float)h - 0.5f, 0.0f, (float)(h - 1));
+	const int   x0 = (int)fx, y0 = (int)fy;
+	const int   x1 = min(x0 + 1, w - 1), y1 = min(y0 + 1, h - 1);
+	const float tx = fx - (float)x0, ty = fy - (float)y0;
+
+	const float m00 = (float)pPixels[(size_t)y0 * w + x0];
+	const float m10 = (float)pPixels[(size_t)y0 * w + x1];
+	const float m01 = (float)pPixels[(size_t)y1 * w + x0];
+	const float m11 = (float)pPixels[(size_t)y1 * w + x1];
+
+	return ((m00 + (m10 - m00) * tx) + ((m01 + (m11 - m01) * tx) - (m00 + (m10 - m00) * tx)) * ty) * (1.0f / 255.0f);
+}
+}
+
+// ---------------------------------------------------------------------------------------------
+// The shape-mask DDS reader, shared with the DOF gather's importance-sampling CDF.
+// ---------------------------------------------------------------------------------------------
+bool ReadShapeMaskDDS(const char* szTexName, std::vector<uint8>& outPixels, int& outWidth, int& outHeight, const char*& szFail)
+{
+	szFail = nullptr;
+	outWidth = 0;
+	outHeight = 0;
+
+	std::vector<uint8> data;
+	{
+		FILE* pFile = gEnv->pCryPak->FOpen(szTexName, "rb");
+		if (!pFile)
+			szFail = "file not found";
+		else
+		{
+			gEnv->pCryPak->FSeek(pFile, 0, SEEK_END);
+			const size_t nSize = (size_t)gEnv->pCryPak->FTell(pFile);
+			gEnv->pCryPak->FSeek(pFile, 0, SEEK_SET);
+			data.resize(nSize);
+			if (nSize < 128 + 16 || gEnv->pCryPak->FReadRaw(data.data(), 1, nSize, pFile) != nSize)
+				szFail = "read failed";
+			gEnv->pCryPak->FClose(pFile);
+		}
+	}
+
+	int w = 0, h = 0;
+	if (!szFail)
+	{
+		if (memcmp(data.data(), "DDS ", 4) != 0)
+			szFail = "not a DDS";
+		else
+		{
+			const uint32* pHdr = (const uint32*)(data.data() + 4);
+			h = (int)pHdr[2];
+			w = (int)pHdr[3];
+			const uint32 nPFFlags = pHdr[19];  // pixel format flags
+			const uint32 nFourCC = pHdr[20];
+			const uint32 nRGBBits = pHdr[21];
+			if ((nPFFlags & 0x40) == 0 || nFourCC != 0 || nRGBBits != 32)
+				szFail = "not uncompressed 32-bit";
+			else if (w < 4 || h < 4 || w > 512 || h > 512 || (w & (w - 1)) != 0 || (h & (h - 1)) != 0)
+				szFail = "unsupported dimensions";
+			else if (data.size() < 128 + (size_t)w * h * 4)
+				szFail = "truncated pixel data";
+		}
+	}
+
+	if (szFail)
+		return false;
+
+	// File byte order is B,G,R,A - the R channel is what carries the transmittance.
+	const uint8* pPix = data.data() + 128;
+	outPixels.resize((size_t)w * h);
+	for (size_t i = 0; i < (size_t)w * h; i++)
+		outPixels[i] = pPix[i * 4 + 2];
+
+	outWidth = w;
+	outHeight = h;
+	return true;
+}
+
+// ---------------------------------------------------------------------------------------------
+
+void CDiffractionKernel::Request(const SDiffractionPupilDesc& descIn)
+{
+	// Quantised so a smooth blade-rotation or aperture pull rebuilds in steps rather than every
+	// frame. The steps are what the eye cannot tell apart in the finished pattern: 0.02 of the
+	// polygon exponent, one degree of either rotation, 0.05 of the mask scale.
+	SDiffractionPupilDesc desc = descIn;
+	desc.fBlades = floorf(clamp_tpl(desc.fBlades, 3.0f, 16.0f) + 0.5f);
+	desc.fExponent = floorf(clamp_tpl(desc.fExponent, 0.0f, 1.0f) * 50.0f + 0.5f) / 50.0f;
+	desc.fPhase = DEG2RAD(floorf(RAD2DEG(desc.fPhase) + 0.5f));
+	desc.fIrisRadius = floorf(clamp_tpl(desc.fIrisRadius, 0.2f, 2.0f) * 20.0f + 0.5f) / 20.0f;
+	desc.fMaskRotation = DEG2RAD(floorf(RAD2DEG(desc.fMaskRotation) + 0.5f));
+
+	// The pupil scale is the one shape parameter that moves with the aperture ring, so it is
+	// quantised only in the range where it changes the pupil at all. The barrel sits at
+	// cos(pi/n)^exponent / p and the polygon's corners at 1: for p below cos(pi/n)^exponent the
+	// barrel is outside every corner and the pupil is the bare polygon, the same pupil for every
+	// value down there. All of it collapses onto that one boundary, so a normal aperture sweep -
+	// which lives there - never rebuilds the kernel, and only the last stop or so before wide
+	// open steps in 0.02. Uses the ALREADY QUANTISED blades and exponent, so the bucket is
+	// reproducible.
+	{
+		const float fCorner = powf(cosf(PI / max(desc.fBlades, 3.0f)), desc.fExponent);
+		const float p = clamp_tpl(desc.fPupilScale, 0.0f, 1.0f);
+		desc.fPupilScale = (p < fCorner - 0.02f) ? fCorner
+		                                        : floorf(p * 50.0f + 0.5f) / 50.0f;
+	}
+	desc.fKsa = floorf(clamp_tpl(desc.fKsa, -1.0f, 1.0f) * 20.0f + 0.5f) / 20.0f;
+	desc.fSaWaves = floorf(clamp_tpl(desc.fSaWaves, 0.0f, 2.0f) * 100.0f + 0.5f) / 100.0f;
+
+	// Only 256 and 512 are allowed: the transform is radix-2 and the core-removal radius is
+	// expressed in Airy radii of a pupil that is always half the grid.
+	desc.nGridSize = (desc.nGridSize <= 256) ? 256 : 512;
+
+	if (m_bJobPosted)
+	{
+		// One job at a time. Remember the newest ask; StartJob picks it up when this one lands.
+		if (desc != m_jobDesc)
+		{
+			m_queuedDesc = desc;
+			m_bHasQueued = true;
+		}
+		else
+		{
+			m_bHasQueued = false;
+		}
+		return;
+	}
+
+	if (m_bBuiltValid && desc == m_builtDesc)
+		return;
+
+	StartJob(desc);
+}
+
+bool CDiffractionKernel::AcquireMask(const std::string& name)
+{
+	if (name.empty())
+	{
+		m_maskName.clear();
+		m_bMaskValid = false;
+		return false;
+	}
+
+	if (m_maskName == name)
+		return m_bMaskValid;
+
+	m_maskName = name;
+	m_bMaskValid = false;
+	m_maskPixels.clear();
+
+	const char* szFail = nullptr;
+	if (!ReadShapeMaskDDS(name.c_str(), m_maskPixels, m_maskWidth, m_maskHeight, szFail))
+	{
+		CryLog("[BLOOM] diffraction kernel: '%s' not usable as a pupil mask (%s), using the bare iris", name.c_str(), szFail);
+		m_maskPixels.clear();
+		return false;
+	}
+
+	m_bMaskValid = true;
+	return true;
+}
+
+void CDiffractionKernel::StartJob(const SDiffractionPupilDesc& desc)
+{
+	m_jobDesc = desc;
+
+	// The mask is read HERE, on the render thread, not in the job: CryPak is not something to
+	// touch from a worker, and a rebuild happens seconds apart at worst.
+	if (AcquireMask(desc.maskName))
+	{
+		m_jobMaskPixels = m_maskPixels;
+		m_jobMaskWidth = m_maskWidth;
+		m_jobMaskHeight = m_maskHeight;
+	}
+	else
+	{
+		m_jobMaskPixels.clear();
+		m_jobMaskWidth = 0;
+		m_jobMaskHeight = 0;
+		m_jobDesc.maskName.clear();
+	}
+
+	m_bHasQueued = false;
+	m_bJobPosted = true;
+
+	TDiffractionKernelJob job(this);
+	job.RegisterJobState(&m_jobState);
+	job.Run();
+}
+
+// ---------------------------------------------------------------------------------------------
+// The job: raster the pupil, transform it, strip the core, measure the boundary ring.
+// Runs on a worker thread and touches nothing but its own inputs and outputs.
+// ---------------------------------------------------------------------------------------------
+void CDiffractionKernel::BuildJob()
+{
+	const CTimeValue tStart = gEnv->pTimer->GetAsyncTime();
+
+	const int L = m_jobDesc.nGridSize;
+	const int nLogL = (L == 256) ? 8 : 9;
+	const int d = L / 2;                       // pupil bounding diameter, zero padded x2
+	const float fUnit = (float)d * 0.5f;       // texels per unit pupil radius
+	const float fCentre = (float)L * 0.5f;
+
+	// Pupil = mask INTERSECT iris polygon INTERSECT barrel, exactly the intersection the bokeh
+	// splat draws. The grid's unit radius is the pupil's BOUNDING radius, so with a mask bound
+	// the mask coordinates and the polygon radius are rescaled by it - the same two numbers the
+	// splat carries in vDofBokehMask.y / .z.
+	const bool  bMask = !m_jobMaskPixels.empty() && m_jobMaskWidth > 0 && m_jobMaskHeight > 0;
+	const float fMaskBound = bMask ? min(m_jobDesc.fIrisRadius, 1.0f) : 1.0f;
+	const float fPolyRadius = bMask ? m_jobDesc.fIrisRadius / max(fMaskBound, 1e-3f) : 1.0f;
+	// The barrel is the round mechanical opening the blades retract INTO, and it does not move
+	// with the iris. p = N_open / N_geo is the polygon's size divided by the barrel's, so the
+	// barrel's radius is (the polygon's size) / p. "The polygon's size" is its INSCRIBED radius,
+	// where the blade edges are - NGon_Rad is normalised to the CIRCUMRADIUS, so that is
+	// cos(pi/n) raised to the shape exponent (which is 1 for a circle, i.e. curved blades that
+	// have no corners to hide are never clipped).
+	//
+	// Wide open (p = 1) the barrel disc therefore sits exactly on the blade edges and lies inside
+	// the polygon everywhere else: the intersection IS the circle, tangent to the edges at their
+	// midpoints, and a circular pupil diffracts into rings, not rays. Stop down and the polygon
+	// shrinks inside the barrel, its corners and flats emerge whole, and the rays appear. That is
+	// the other half of "sunstars appear when you stop down" - the first half being the lambda*N
+	// scale on the sensor. Below p = cos(pi/n)^exponent the barrel is past the corners and clips
+	// nothing at all, which is where a normal working aperture lives.
+	const float fPupilScale = max(clamp_tpl(m_jobDesc.fPupilScale, 0.0f, 1.0f), 1e-3f);
+	const float fBladeRadius = powf(cosf(PI / max(m_jobDesc.fBlades, 3.0f)), m_jobDesc.fExponent);
+	const float fBarrelRadius = fPolyRadius * fBladeRadius / fPupilScale;
+	const float fMaskCos = cosf(-m_jobDesc.fMaskRotation);
+	const float fMaskSin = sinf(-m_jobDesc.fMaskRotation);
+
+	// Spherical aberration as a wavefront error, which is what it physically is: an aberrated
+	// pupil does not transmit less light, it transmits it with the wrong phase, and the FFT
+	// turns that into rings and a halo around the rays. W(r) = k_sa * W_sa * r^4 waves.
+	const float fWaveAmplitude = m_jobDesc.fKsa * m_jobDesc.fSaWaves;
+	const bool  bPhase = fabsf(fWaveAmplitude) > 1e-4f;
+
+	std::vector<complexF> grid((size_t)L * L, complexF(0.0f, 0.0f));
+
+	for (int iy = 0; iy < L; ++iy)
+	{
+		for (int ix = 0; ix < L; ++ix)
+		{
+			// 2x2 supersampling of the hard edges. A hard-edged pupil is what gives the sharp
+			// 1/u^2 rays; the splat's fEdgeSoft is a rendering convenience and has no business
+			// here, but a jagged raster would put its own aliasing rays into the transform.
+			float fCoverage = 0.0f;
+			float fR2Sum = 0.0f;
+			for (int s = 0; s < 4; ++s)
+			{
+				const float sx = (s & 1) ? 0.75f : 0.25f;
+				const float sy = (s & 2) ? 0.75f : 0.25f;
+				const float x = ((float)ix + sx - fCentre) / fUnit;
+				const float y = ((float)iy + sy - fCentre) / fUnit;
+				const float r = sqrtf(x * x + y * y);
+				fR2Sum += r * r;
+
+				if (r > fBarrelRadius)                            // the mechanical barrel
+					continue;
+
+				const float theta = atan2_tpl(y, x);
+				const float fPoly = fPolyRadius * powf(NGon_Rad(theta - m_jobDesc.fPhase, m_jobDesc.fBlades), m_jobDesc.fExponent);
+				if (r > fPoly)
+					continue;
+
+				fCoverage += 0.25f;
+			}
+
+			if (fCoverage <= 0.0f)
+				continue;
+
+			float fTransmit = fCoverage;
+			if (bMask)
+			{
+				// The mask turns independently of the iris phase, so it is SAMPLED through the
+				// inverse rotation - the same convention the splat's pixel shader uses.
+				const float x = ((float)ix + 0.5f - fCentre) / fUnit * fMaskBound;
+				const float y = ((float)iy + 0.5f - fCentre) / fUnit * fMaskBound;
+				const float mx = x * fMaskCos - y * fMaskSin;
+				const float my = x * fMaskSin + y * fMaskCos;
+				fTransmit *= SampleMask(m_jobMaskPixels.data(), m_jobMaskWidth, m_jobMaskHeight, mx * 0.5f + 0.5f, my * 0.5f + 0.5f);
+			}
+
+			if (fTransmit <= 0.0f)
+				continue;
+
+			// Amplitude is the square root of the intensity transmittance. Phase is the
+			// wavefront error in radians, 2*pi per wave.
+			const float fAmp = sqrtf(fTransmit);
+			// fftshift by modulating with (-1)^(x+y): the transform then comes out with DC at
+			// the grid centre, which is where a point spread function belongs.
+			const float fShift = (((ix + iy) & 1) != 0) ? -1.0f : 1.0f;
+
+			if (bPhase)
+			{
+				const float r2 = fR2Sum * 0.25f;                 // mean r^2 over the subsamples
+				const float fW = 2.0f * PI * fWaveAmplitude * r2 * r2;
+				grid[(size_t)iy * L + ix] = complexF(fAmp * fShift * cosf(fW), fAmp * fShift * sinf(fW));
+			}
+			else
+			{
+				grid[(size_t)iy * L + ix] = complexF(fAmp * fShift, 0.0f);
+			}
+		}
+	}
+
+	ComputeFFT2D(1, L, nLogL, grid.data());
+
+	// |F|^2, normalised so the whole grid integrates to 1 - Parseval, i.e. this IS the pupil's
+	// total transmitted light, and every fraction below is a fraction of a source's own energy.
+	std::vector<float> intensity((size_t)L * L);
+	double fTotal = 0.0;
+	for (size_t i = 0; i < intensity.size(); ++i)
+	{
+		const float re = grid[i].real();
+		const float im = grid[i].imag();
+		const float I = re * re + im * im;
+		intensity[i] = I;
+		fTotal += (double)I;
+	}
+
+	const float fInvTotal = (fTotal > 1e-30) ? (float)(1.0 / fTotal) : 0.0f;
+	for (size_t i = 0; i < intensity.size(); ++i)
+		intensity[i] *= fInvTotal;
+
+	// Remove the core. The picture already contains the source and its bloom; what the kernel
+	// must carry is only what the pupil scattered AWAY from it. For a round pupil this takes
+	// about 90% of the light, which is the Airy disc.
+	const float fAiryRadius = 1.22f * (float)L / (float)d;
+	const float fCoreRadius = kCoreAiryRadii * fAiryRadius;
+	const float fCoreRadiusSq = fCoreRadius * fCoreRadius;
+
+	// Where the VISIBLE rays live. The core and the first few Airy rings sit under the source's
+	// own bloom and are never read as a sunstar; what the eye calls "the rays" is everything
+	// further out than a couple of dozen Airy radii. Measuring that share separately is the only
+	// honest answer to "why do I see nothing at amount 1".
+	const float fFarRadius = kFarAiryRadii * fAiryRadius;
+	const float fFarRadiusSq = fFarRadius * fFarRadius;
+	double fCore = 0.0;
+	double fFar = 0.0;
+	for (int iy = 0; iy < L; ++iy)
+	{
+		const float dy = (float)iy + 0.5f - fCentre;
+		for (int ix = 0; ix < L; ++ix)
+		{
+			const float dx = (float)ix + 0.5f - fCentre;
+			if (dx * dx + dy * dy <= fCoreRadiusSq)
+			{
+				fCore += (double)intensity[(size_t)iy * L + ix];
+				intensity[(size_t)iy * L + ix] = 0.0f;
+			}
+		}
+	}
+
+	// The boundary ring: the mean intensity in the outermost band, per angular bin. This is what
+	// the pixel shader extrapolates the far field off, so it has to be measured on the very edge
+	// of what the texture still resolves.
+	const float fRingRadius = (float)L * 0.5f - 2.0f;
+	const float fRingInner = fRingRadius - kRingWidth;
+	std::vector<double> ringSum((size_t)kRingBins, 0.0);
+	std::vector<int>    ringCount((size_t)kRingBins, 0);
+
+	double fTexIntegral = 0.0;
+	for (int iy = 0; iy < L; ++iy)
+	{
+		const float dy = (float)iy + 0.5f - fCentre;
+		for (int ix = 0; ix < L; ++ix)
+		{
+			const float dx = (float)ix + 0.5f - fCentre;
+			const float I = intensity[(size_t)iy * L + ix];
+			const float r2 = dx * dx + dy * dy;
+
+			// Only what the texture will actually be sampled inside counts toward its integral;
+			// past R_tex the shader uses the extrapolation, not these texels.
+			if (r2 <= fRingRadius * fRingRadius)
+			{
+				fTexIntegral += (double)I;
+				if (r2 >= fFarRadiusSq)
+					fFar += (double)I;
+			}
+
+			if (r2 >= fRingInner * fRingInner && r2 <= fRingRadius * fRingRadius)
+			{
+				float theta = atan2_tpl(dy, dx);                  // -pi .. pi
+				if (theta < 0.0f)
+					theta += 2.0f * PI;
+				int bin = (int)(theta * (float)kRingBins / (2.0f * PI));
+				bin = clamp_tpl(bin, 0, kRingBins - 1);
+				ringSum[(size_t)bin] += (double)I;
+				ringCount[(size_t)bin]++;
+			}
+		}
+	}
+
+	// A PREFILTERED MIP CHAIN of the pattern, and the reason it exists is the whole point of the
+	// pass. The kernel's texel pitch on screen is lambda * N * d / L, a small FRACTION of a
+	// pixel: 0.23 native pixels at f/16, so a quarter-resolution pixel covers some seventeen
+	// kernel texels (a hundred at f/2.8). The rays themselves are one or two texels wide. One
+	// tap per pixel therefore lands on a ray about one time in seventeen and misses the pattern
+	// everywhere else - which is exactly what "no rays at all at f/16" looks like. The average
+	// energy was right; the sampling was not integrated. With the chain the shader picks the
+	// level whose texel IS the pixel's footprint and reads the footprint's mean in one tap.
+	//
+	// Filter the LINEAR intensity and encode afterwards, never the other way round: sqrt is not
+	// linear, so a box filter of sqrt(I) is not sqrt(mean I), and the pixel shader's k*k would
+	// then be systematically too dark. Level by level, k^2 is the mean intensity over the texel.
+	const int nMips = nLogL + 1;                     // L down to 1x1
+	size_t nTotalTexels = 0;
+	for (int m = 0; m < nMips; ++m)
+	{
+		const size_t w = (size_t)(L >> m);
+		nTotalTexels += w * w;
+	}
+
+	m_resultKernel.resize(nTotalTexels);
+	m_resultMipCount = nMips;
+
+	// sqrt encoding in both textures: the tails run down to 1e-8, which is below half float's
+	// denormals, and the square root lifts them to 1e-4 where R16F is exact. The pixel shader
+	// squares them back.
+	std::vector<float> level(std::move(intensity));   // level 0, linear
+	std::vector<float> coarser;
+	size_t nOffset = 0;
+	for (int m = 0; m < nMips; ++m)
+	{
+		const int w = L >> m;
+		for (size_t i = 0; i < (size_t)w * w; ++i)
+			m_resultKernel[nOffset + i] = CryConvertFloatToHalf(sqrtf(max(level[i], 0.0f)));
+		nOffset += (size_t)w * w;
+
+		if (m + 1 >= nMips)
+			break;
+
+		// Box 2x2 of the linear intensity: the mean of four means over equal areas IS the mean
+		// over their union, so every level stays the true footprint average.
+		const int hw = w >> 1;
+		coarser.resize((size_t)hw * hw);
+		for (int y = 0; y < hw; ++y)
+		{
+			for (int x = 0; x < hw; ++x)
+			{
+				coarser[(size_t)y * hw + x] = 0.25f * (level[(size_t)(2 * y) * w + (2 * x)]
+				                                       + level[(size_t)(2 * y) * w + (2 * x + 1)]
+				                                       + level[(size_t)(2 * y + 1) * w + (2 * x)]
+				                                       + level[(size_t)(2 * y + 1) * w + (2 * x + 1)]);
+			}
+		}
+		level.swap(coarser);
+	}
+
+	m_resultRing.resize((size_t)kRingBins);
+	double fRingMean = 0.0;
+	for (int b = 0; b < kRingBins; ++b)
+	{
+		const float I = (ringCount[(size_t)b] > 0) ? (float)(ringSum[(size_t)b] / (double)ringCount[(size_t)b]) : 0.0f;
+		m_resultRing[(size_t)b] = CryConvertFloatToHalf(sqrtf(max(I, 0.0f)));
+		fRingMean += (double)I;
+	}
+	fRingMean /= (double)kRingBins;
+
+	// Energy of the extrapolated tail, per unit of ln(R_sprite / R_tex):
+	//   E_tail = integral over theta, u of I_ring(theta) * (R_tex / u)^2 * u du dtheta
+	//          = 2*pi * mean(I_ring) * R_tex^2 * ln(R_sprite / R_tex)
+	// Logarithmic, hence finite but never zero - the sprite's radius is where it is cut off, and
+	// only the renderer knows that, so the log term is left to it.
+	m_resultTailCoefficient = (float)(2.0 * PI * fRingMean * (double)fRingRadius * (double)fRingRadius);
+	m_resultIntegral = (float)fTexIntegral;
+	m_resultCoreFraction = (float)fCore;
+	m_resultFarFraction = (float)fFar;
+	m_resultJobMs = (gEnv->pTimer->GetAsyncTime() - tStart).GetMilliSeconds();
+}
+
+// ---------------------------------------------------------------------------------------------
+
+void CDiffractionKernel::Update(const char* szNameSuffix)
+{
+	if (!m_bJobPosted)
+		return;
+
+	// Polled, never waited on: a 512^2 transform is tens of milliseconds and the render thread
+	// keeps drawing with the previous kernel until it lands.
+	if (m_jobState.IsRunning())
+		return;
+
+	m_bJobPosted = false;
+	UploadResult(szNameSuffix);
+
+	if (m_bHasQueued)
+	{
+		const SDiffractionPupilDesc next = m_queuedDesc;
+		m_bHasQueued = false;
+		StartJob(next);
+	}
+}
+
+void CDiffractionKernel::UploadResult(const char* szNameSuffix)
+{
+	const int L = m_jobDesc.nGridSize;
+	size_t nExpected = 0;
+	for (int m = 0; m < m_resultMipCount; ++m)
+	{
+		const size_t w = (size_t)(L >> m);
+		nExpected += w * w;
+	}
+
+	if (m_resultKernel.size() != nExpected || m_resultRing.size() != (size_t)kRingBins)
+		return;
+
+	// The grid size changing means new textures; everything else is a re-upload into the same
+	// two, which is what keeps a blade-rotation pull from churning resources.
+	if (m_pTexKernel && (m_pTexKernel->GetWidth() != L || m_pTexKernel->GetNumMips() != m_resultMipCount))
+		ReleaseTextures();
+
+	const std::string suffix = szNameSuffix ? szNameSuffix : "";
+	if (!m_pTexKernel)
+	{
+		const std::string kernelName = "$DiffractionKernel" + suffix;
+		const std::string ringName = "$DiffractionRing" + suffix;
+		// WITH mips, and therefore without FT_NOMIPS: the whole chain is uploaded here, level
+		// after level, and the sprite pass reads it with an explicit LOD. Both the creation path
+		// and UpdateTextureRegion walk a source buffer whose levels are consecutive, which is
+		// exactly how BuildJob laid it out.
+		m_pTexKernel = CTexture::GetOrCreate2DTexture(kernelName.c_str(), L, L, m_resultMipCount, FT_DONT_STREAM,
+		                                              (const byte*)m_resultKernel.data(), eTF_R16F);
+		m_pTexRing = CTexture::GetOrCreate2DTexture(ringName.c_str(), kRingBins, 1, 1, FT_DONT_STREAM | FT_NOMIPS,
+		                                            (const byte*)m_resultRing.data(), eTF_R16F);
+
+		if (!CTexture::IsTextureExist(m_pTexKernel) || !CTexture::IsTextureExist(m_pTexRing))
+		{
+			ReleaseTextures();
+			return;
+		}
+	}
+	else
+	{
+		m_pTexKernel->UpdateTextureRegion((const byte*)m_resultKernel.data(), 0, 0, 0, L, L, 1, eTF_R16F);
+		m_pTexRing->UpdateTextureRegion((const byte*)m_resultRing.data(), 0, 0, 0, kRingBins, 1, 1, eTF_R16F);
+	}
+
+	m_builtDesc = m_jobDesc;
+	m_bBuiltValid = true;
+	m_nKernelMips = m_pTexKernel->GetNumMips();
+	m_fRingRadius = (float)L * 0.5f - 2.0f;
+	m_fTexelPitchPupilUnits = 0.5f;      // d / L, and d is L/2 by construction
+	m_fTextureIntegral = m_resultIntegral;
+	m_fTailCoefficient = m_resultTailCoefficient;
+	m_fCoreFraction = m_resultCoreFraction;
+	m_fFarFraction = m_resultFarFraction;
+
+	// The physical glare fraction is what is NOT in the core: the pattern was Parseval-normalised
+	// to the pupil's whole transmitted light before the core was cut out, so 1 - core is the
+	// share of a source's light that really leaves it as glare. That is what amount 1 deposits
+	// (bar the part of the tail the sprite is too small to hold - the glare pass logs the number
+	// it actually deposits).
+	// E_far is the part of that fraction which lands OUTSIDE the first kFarAiryRadii Airy radii -
+	// the rays as a viewer sees them, with the core and the inner rings (which hide under the
+	// source's own bloom) excluded. It is typically a few parts in a thousand, spread over
+	// hundreds of pixels, which is why the physically exact amount of 1 shows almost nothing and
+	// why Streak Amount is a source-radiance boost rather than a fudge factor.
+	CryLog("[BLOOM] diffraction kernel blades=%.0f exp=%.2f phase=%.0f mask=%s maskRot=%.0f maskScale=%.2f p=%.2f barrel=%.2f sa=%.2f -> core=%.2f tail=%.3g physical glare fraction = %.3f E_far(>%.0f Airy) = %.4f L=%d (job %.1f ms)",
+	       m_builtDesc.fBlades, m_builtDesc.fExponent, RAD2DEG(m_builtDesc.fPhase),
+	       m_builtDesc.maskName.empty() ? "none" : m_builtDesc.maskName.c_str(),
+	       RAD2DEG(m_builtDesc.fMaskRotation), m_builtDesc.fIrisRadius,
+	       m_builtDesc.fPupilScale,
+	       powf(cosf(PI / max(m_builtDesc.fBlades, 3.0f)), m_builtDesc.fExponent) / max(m_builtDesc.fPupilScale, 1e-3f),
+	       m_builtDesc.fKsa,
+	       m_fCoreFraction, m_fTailCoefficient, 1.0f - m_fCoreFraction, kFarAiryRadii, m_fFarFraction,
+	       L, m_resultJobMs);
+	CryLog("[BLOOM] diffraction kernel mip chain: %d levels (%d..1), %.0f KB", m_nKernelMips, L,
+	       (float)(m_resultKernel.size() * sizeof(uint16)) / 1024.0f);
+}
+
+void CDiffractionKernel::ReleaseTextures()
+{
+	SAFE_RELEASE(m_pTexKernel);
+	SAFE_RELEASE(m_pTexRing);
+	m_bBuiltValid = false;
+}
+
+void CDiffractionKernel::Shutdown()
+{
+	if (m_bJobPosted)
+	{
+		// The job writes into buffers this object owns, so it has to be finished before they go.
+		gEnv->GetJobManager()->WaitForJob(m_jobState);
+		m_bJobPosted = false;
+	}
+
+	m_bHasQueued = false;
+	ReleaseTextures();
+
+	m_resultKernel.clear();
+	m_resultRing.clear();
+	m_jobMaskPixels.clear();
+	m_maskPixels.clear();
+	m_maskName.clear();
+	m_bMaskValid = false;
+}
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DiffractionKernel.h b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DiffractionKernel.h
new file mode 100644
index 00000000..f887765f
--- /dev/null
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DiffractionKernel.h
@@ -0,0 +1,169 @@
+// Copyright 2015-2021 Crytek GmbH / Crytek Group. All rights reserved.
+
+#pragma once
+
+// Wave-optics diffraction kernel (DiffractionKernelSpec.md).
+//
+// The glare of a point source is the Fraunhofer diffraction pattern of the pupil it passed
+// through: I(u) = |F{A}|^2, with A the pupil's complex amplitude. Everything the analytic
+// streaks approximate by drawing lines - ray count from the blade count, the way a rounded
+// blade softens and shortens the rays, what a shape mask throws instead of a star, the halo an
+// aberrated pupil puts around the core - falls out of that one transform for free.
+//
+// The transform is a 512^2 CPU FFT, which is 10-30 ms of work: far too much for the render
+// thread, and unnecessary every frame, because the pattern depends only on the pupil's SHAPE.
+// The f-number does NOT enter here at all - it is the pattern's SCALE on the sensor
+// (s = lambda * N * d / L), applied by the pixel shader. So the kernel is built by a job,
+// double buffered, and rebuilt only when the shape actually changes.
+//
+// This owns no rendering: it produces two small textures (the kernel and its boundary ring)
+// plus the scalars the sprite pass needs to place and normalise them.
+
+#include <CryThreading/IJobManager.h>
+
+#include <string>
+#include <vector>
+
+class CTexture;
+
+//! Everything the pupil's SHAPE depends on. Quantised by Request(), so a smooth aperture or
+//! blade-rotation pull rebuilds in steps instead of every frame. Note what is NOT here: the
+//! f-number. The kernel is computed in the pupil's own units and N only scales it on screen.
+struct SDiffractionPupilDesc
+{
+	int         nGridSize = 512;    //!< L, the complex grid the FFT runs on. 256 is 4x cheaper.
+	float       fBlades = 8.0f;     //!< Iris blade count; the polygon NGon_Rad is evaluated for.
+	float       fExponent = 1.0f;   //!< Iris polygon exponent (1 = the true convex n-gon, 0 = a circle).
+	float       fPhase = 0.0f;      //!< Blade rotation, radians.
+	float       fIrisRadius = 1.0f; //!< N_mask / N: the iris radius in MASK units. 1 when no mask.
+	//! Pupil scale p = N_open / N_geo, 1 wide open: the iris polygon's size divided by the
+	//! mechanical barrel's. The barrel therefore sits at cos(pi/n)^exponent / p in the polygon's
+	//! units, and wide open it lands exactly on the blade edges - the pupil is then the barrel
+	//! circle, which is why a lens wide open makes rings and not rays. Quantised by Request(),
+	//! and only where it can reach the polygon at all: below cos(pi/n)^exponent the barrel is
+	//! outside the corners and every value down there is the same pupil.
+	float       fPupilScale = 1.0f;
+	float       fMaskRotation = 0.0f; //!< Mask rotation, radians. The mask is its own element.
+	float       fKsa = 0.0f;        //!< Spherical aberration, -1..1. Enters as a PHASE error.
+	float       fSaWaves = 0.25f;   //!< Wavefront error in waves at |k_sa| = 1.
+	std::string maskName;           //!< Shape mask texture, or empty.
+
+	bool operator==(const SDiffractionPupilDesc& rhs) const
+	{
+		return nGridSize == rhs.nGridSize
+		       && fBlades == rhs.fBlades && fExponent == rhs.fExponent && fPhase == rhs.fPhase
+		       && fIrisRadius == rhs.fIrisRadius && fPupilScale == rhs.fPupilScale && fMaskRotation == rhs.fMaskRotation
+		       && fKsa == rhs.fKsa && fSaWaves == rhs.fSaWaves && maskName == rhs.maskName;
+	}
+	bool operator!=(const SDiffractionPupilDesc& rhs) const { return !(*this == rhs); }
+};
+
+//! Reads the R channel of an uncompressed 32-bit DDS through CryPak. THE one raw mask reader:
+//! the DOF stage's gather CDF and the diffraction pupil are two views of the same shape mask,
+//! and a second copy of this parser would be a second set of accepted formats.
+//! Returns false and fills szFail with a one-line reason on anything it cannot use.
+bool ReadShapeMaskDDS(const char* szTexName, std::vector<uint8>& outPixels, int& outWidth, int& outHeight, const char*& szFail);
+
+class CDiffractionKernel
+{
+public:
+	CDiffractionKernel() {}
+	~CDiffractionKernel() { Shutdown(); }
+
+	//! Ask for a kernel for this pupil. Quantises, compares against what is built and what is
+	//! being built, and spawns the job when it differs. At most one job is ever in flight; a
+	//! request arriving while one runs is remembered and started when that one lands.
+	void Request(const SDiffractionPupilDesc& desc);
+
+	//! Once per frame from the render thread. Uploads a finished job's result and starts the
+	//! queued request, if any. Never blocks.
+	void Update(const char* szNameSuffix);
+
+	//! Waits for the job and drops everything. Called on shutdown and on a resize.
+	void Shutdown();
+
+	//! Null until the first job has landed. The pass draws nothing while it is null rather than
+	//! falling back to the analytic lines, which would flash for a frame or two on every change.
+	CTexture* GetKernelTexture() const { return m_pTexKernel; }
+	CTexture* GetRingTexture() const   { return m_pTexRing; }
+
+	int   GetGridSize() const      { return m_builtDesc.nGridSize; }
+	//! Levels in the kernel's prefiltered mip chain, L x L down to 1 x 1. The pattern's texel
+	//! pitch on screen is a small FRACTION of a pixel (0.23 native px at f/16), so one pixel
+	//! covers tens of texels and a single tap would miss the one-texel-wide rays almost
+	//! everywhere. Each level is the MEAN INTENSITY over its footprint, which is exactly what
+	//! the sprite pass needs to integrate - see UploadResult for why the sqrt encoding happens
+	//! after the filtering and never before.
+	int   GetKernelMipCount() const { return m_nKernelMips; }
+	//! Radius, in kernel texels, out to which the TEXTURE is valid. Past it the pixel shader
+	//! extrapolates with the edge-diffraction law off the boundary ring.
+	float GetRingRadius() const    { return m_fRingRadius; }
+	//! Kernel texel pitch on the sensor, divided by lambda * N: pitch = lambda * N * this.
+	//! (It is just d / L, but naming the physics is what stops it being "re-simplified".)
+	float GetTexelPitchPupilUnits() const { return m_fTexelPitchPupilUnits; }
+	//! Integral of the kernel INSIDE the texture, in texel^2 units.
+	float GetTextureIntegral() const { return m_fTextureIntegral; }
+	//! Energy in the extrapolated 1/u^2 tail per unit of ln(R_sprite / R_tex) - the tail is
+	//! logarithmic, so its total depends on where the sprite cuts it off, which only the
+	//! renderer knows. Integral + this * ln(R_sprite / R_tex) is what the deposit normalises by.
+	float GetTailCoefficient() const { return m_fTailCoefficient; }
+	//! Fraction of the pupil's transmitted light that sat in the removed core (~0.9 for a round
+	//! pupil). Diagnostic only: the frame already carries the source itself.
+	float GetCoreFraction() const { return m_fCoreFraction; }
+
+	bool  IsReady() const { return m_pTexKernel != nullptr && m_pTexRing != nullptr; }
+
+	//! Job entry point. Public because the job delegator calls it through a free function.
+	void  BuildJob();
+
+private:
+	void  StartJob(const SDiffractionPupilDesc& desc);
+	bool  AcquireMask(const std::string& name);
+	void  UploadResult(const char* szNameSuffix);
+	void  ReleaseTextures();
+
+	// --- render thread only ---
+	SDiffractionPupilDesc m_builtDesc;                //!< what the live textures hold
+	SDiffractionPupilDesc m_queuedDesc;               //!< newest request while a job runs
+	bool                  m_bHasQueued = false;
+	bool                  m_bJobPosted = false;
+	bool                  m_bBuiltValid = false;
+
+	CTexture*             m_pTexKernel = nullptr;
+	CTexture*             m_pTexRing = nullptr;
+	int                   m_nKernelMips = 1;
+
+	float                 m_fRingRadius = 0.0f;
+	float                 m_fTexelPitchPupilUnits = 0.5f;
+	float                 m_fTextureIntegral = 1.0f;
+	float                 m_fTailCoefficient = 0.0f;
+	float                 m_fCoreFraction = 0.0f;
+	float                 m_fFarFraction = 0.0f;   //!< diagnostics: energy past kFarAiryRadii
+
+	// --- shared with the job; touched by the render thread only while it is not running ---
+	JobManager::SJobState m_jobState;
+	SDiffractionPupilDesc m_jobDesc;
+	std::vector<uint8>    m_jobMaskPixels;            //!< R channel, read on the render thread
+	int                   m_jobMaskWidth = 0;
+	int                   m_jobMaskHeight = 0;
+
+	std::vector<uint16>   m_resultKernel;             //!< the whole mip chain, R16F, sqrt-encoded, levels consecutive
+	int                   m_resultMipCount = 1;
+	std::vector<uint16>   m_resultRing;               //!< kRingBins, R16F, sqrt-encoded
+	float                 m_resultIntegral = 1.0f;
+	float                 m_resultTailCoefficient = 0.0f;
+	float                 m_resultCoreFraction = 0.0f;
+	float                 m_resultFarFraction = 0.0f;
+	float                 m_resultJobMs = 0.0f;
+
+	// --- mask cache, render thread only ---
+	std::string           m_maskName;
+	std::vector<uint8>    m_maskPixels;
+	int                   m_maskWidth = 0;
+	int                   m_maskHeight = 0;
+	bool                  m_bMaskValid = false;
+
+public:
+	//! Angular bins of the boundary ring. 256 is 1.4 degrees, finer than any ray is sharp.
+	static const int kRingBins = 256;
+};
