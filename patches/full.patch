+	// DIAMETER in native pixels, while the vertex shader compares it against the quad's half
+	// extent. Passing the diameter made every sprite ceiling twice what the cvar said.
+	const Vec4 vSpriteLensModel(0.0f, 0.0f, fSplatCapPx * 0.5f, vLensModel.w);
