+
+class CPhoneTrackerComponent final : public IEntityComponent
+{
+public:
+	CPhoneTrackerComponent() = default;
+	virtual ~CPhoneTrackerComponent();
+
+	static void ReflectType(Schematyc::CTypeDesc<CPhoneTrackerComponent>& desc)
+	{
+		desc.SetGUID("{6D5B1F52-4C2E-47D6-9C2B-2F0C3E77A101}"_cry_guid);
+		desc.SetEditorCategory("Tracking");
+		desc.SetLabel("Phone Tracker");
+		desc.SetDescription("Receives 6DoF poses from the Android phone tracker over UDP and applies them to this entity");
+		desc.SetComponentFlags({ IEntityComponent::EFlags::Singleton });
+
+		desc.AddMember(&CPhoneTrackerComponent::m_connection, 'gcon', "Connection", "Connection", "", SPhoneConnectionParams());
+		desc.AddMember(&CPhoneTrackerComponent::m_mapping, 'gmap', "TransformMapping", "Transform Mapping", "", SPhoneMappingParams());
+		desc.AddMember(&CPhoneTrackerComponent::m_filter, 'gflt', "PoseFilter", "Pose Filter", "", SPhoneFilterParams());
+		desc.AddMember(&CPhoneTrackerComponent::m_tripod, 'gtrp', "VirtualTripod", "Virtual Tripod", "", SPhoneTripodParams());
+		desc.AddMember(&CPhoneTrackerComponent::m_lensLink, 'glnk', "CinematicLensLink", "Cinematic Lens Link", "", SPhoneLensLinkParams());
+		desc.AddMember(&CPhoneTrackerComponent::m_debug, 'gdbg', "LegacyAndDebug", "Legacy And Debug", "", SPhoneDebugParams());
+	}
+
+	static void Register(Schematyc::CEnvRegistrationScope& componentScope);
+
+	// IEntityComponent
+	virtual void Initialize() override;
+	virtual void OnShutDown() override;
+	virtual Cry::Entity::EventFlags GetEventMask() const override;
+	virtual void ProcessEvent(const SEntityEvent& event) override;
+	// ~IEntityComponent
+
+	//! Re-samples the tracker origin from the next pose and asks the phone to reset its own origin.
+	void Recenter();
+	void SetTrackingEnabled(bool enable);
+	bool IsTracking() const { return m_isTracking; }
+
+	//! Number this tracker answers to in logs and the overlay: the Tracker ID property, or its
+	//! creation order (1-based) when the property is left at 0.
+	int GetTrackerId() const;
+
+protected:
+	//! Position of this component in the creation-order registry (0-based), -1 if absent.
+	int RegistryIndex() const;
+	//! Another tracker in the level already listening on our port, or nullptr.
+	const CPhoneTrackerComponent* FindPortHolder() const;
+
+	//! The entity the tracker actually drives: the active cinematic camera when Follow Active
+	//! Camera is on and one exists, otherwise this component's own entity. Never nullptr.
+	IEntity* GetTargetEntity();
+	//! Once per frame: notices a camera switch and re-anchors on the new target.
+	void UpdateTarget();
+
+	void OpenSocket();
+	void ApplyLensPacket(const SLensPacket& packet);
+	void RunAutofocus(ICinematicCameraOptics* pOptics);
+	ICinematicCameraOptics* GetOptics();
+	void CloseSocket();
+	void ReceivePackets();
+	void ApplyPose(float frameTime);
+	QuatT MapToWorld(const Vec3& trackerPosition, const Quat& trackerRotation) const;
+	void SyncFilterParams();
+	void SendControl(EControlCommand cmd, int32 param = 0);
+	void DrawDebug() const;
+
+	// Reflected properties
+
+
+
+	// Reflected property groups
+	SPhoneConnectionParams m_connection;
+	SPhoneMappingParams m_mapping;
+	SPhoneFilterParams m_filter;
+	SPhoneTripodParams m_tripod;
+	SPhoneLensLinkParams m_lensLink;
+	SPhoneDebugParams m_debug;
+
+	// Runtime state
+	CRYSOCKET      m_socket = CRY_INVALID_SOCKET;
+	bool           m_wsaStarted = false;
+	CRYSOCKADDR_IN m_peer;
+	bool           m_hasPeer = false;
+	uint32         m_controlSeq = 0;
+
+	//! Why the socket is closed although the tracker is enabled - shown in the overlay.
+	//! Empty while listening or while deliberately disabled.
+	string         m_socketProblem;
+
+	//! Every live tracker component, in creation order. Main thread only.
+	static std::vector<CPhoneTrackerComponent*> s_registry;
+
+	QuatT  m_referenceTransform = QuatT(IDENTITY);  //!< Entity transform captured when tracking started.
+	QuatT  m_trackerOrigin = QuatT(IDENTITY);       //!< Tracker pose treated as the zero point.
+	bool   m_hasOrigin = false;
+	uint32 m_originEpoch = 0;
+	bool   m_recenterRequested = false;
+
+	CPoseFilter m_poseFilter;                       //!< Runs in tracker space, before the world mapping.
+	bool   m_signalWasLost = false;                 //!< Set when Signal Timeout expires, so we can reset the filter on recovery.
+
+	QuatT  m_targetTransform = QuatT(IDENTITY);     //!< Latest pose mapped into world space.
+	QuatT  m_currentTransform = QuatT(IDENTITY);    //!< Smoothed transform actually written to the entity.
+	bool   m_hasTarget = false;
+
+	bool   m_isTracking = false;
+	float  m_timeSinceValidPose = 0.0f;
+	uint32 m_lastSeq = 0;
+	uint32 m_packetsReceived = 0;
+	uint32 m_packetsLost = 0;
+	uint8  m_batteryPct = 0;
+	uint8  m_appFps = 0;
+	uint8  m_trackingState = 0;
+
+	// Camera-follow state.
+	TGetActiveCinematicCameraEntityFn m_pfnActiveCameraEntity = nullptr;
+	bool     m_activeCameraLookedUp = false;
+	EntityId m_targetEntityId = INVALID_ENTITYID;   //!< Entity currently driven; switches re-anchor.
+
+	// Lens state mirrored from the phone (only meaningful while m_lensLink.driveLens is set).
+	ICinematicCameraOptics* m_pOptics = nullptr;
+	bool   m_opticsLookedUp = false;
+	bool   m_hasLensState = false;
+	float  m_focalLengthMm = 0.0f;
+	float  m_apertureFNumber = 0.0f;
+	float  m_focusDistanceM = 0.0f;
+	float  m_evCompensation = 0.0f;
+	uint32 m_lensIso = 0;
+};
+
+} // namespace PhoneTracker
+} // namespace Cry
