+void CHDRStreaks::Reset(bool bOnSpecChange)
+{
+	m_pActive->ResetParam(0.0f);
+	m_pAmount->ResetParam(0.0f);
+	m_pCount->ResetParam(8.0f);
+	m_pAngle->ResetParam(0.0f);
+	m_pThreshold->ResetParam(4.0f);
+	m_pLength->ResetParam(0.5f);
+
+	m_pAnamorphicAmount->ResetParam(0.0f);
+	m_pAnamorphicLength->ResetParam(0.7f);
+	m_pAnamorphicThreshold->ResetParam(3.0f);
+	m_pAnamorphicTint->ResetParamVec4(Vec4(0.35f, 0.62f, 1.0f, 0.0f));
+
+	m_pFilterAmount->ResetParam(0.0f);
+	m_pFilterSize->ResetParam(0.25f);
+	m_pFilterRotation->ResetParam(0.0f);
+	m_pFilterThreshold->ResetParam(6.0f);
+	m_pFilterPoints->ResetParam(4.0f);
+
+	m_pMode->ResetParam(1.0f);
+	m_pWaveAmount->ResetParam(1.0f);
+	m_pWaveReach->ResetParam(0.35f);
+	m_pDispersion->ResetParam(1.0f);
+	// The PSF image is deliberately NOT dropped here, exactly as the DOF leaves its bokeh
+	// shape texture alone: the owner re-pushes the name every frame, and releasing it would
+	// only make the plate blink out for one frame on every spec change.
+}
+
+SHDRStreaksParams CHDRStreaks::GetParams() const
+{
+	SHDRStreaksParams params;
+
+	params.bActive = IsActive();
+	params.fAmount = clamp_tpl(m_pAmount->GetParam(), 0.0f, 1.0f);
+	params.nDirectionCount = (int)clamp_tpl(m_pCount->GetParam(), 4.0f, (float)s_nMaxDirections);
+	params.fAngle = m_pAngle->GetParam();
+	params.fThreshold = max(m_pThreshold->GetParam(), 0.0f);
+	params.fLength = clamp_tpl(m_pLength->GetParam(), 0.0f, 1.0f);
+
+	params.fAnamorphicAmount = clamp_tpl(m_pAnamorphicAmount->GetParam(), 0.0f, 3.0f);
+	params.fAnamorphicLength = clamp_tpl(m_pAnamorphicLength->GetParam(), 0.0f, 1.0f);
+	params.fAnamorphicThreshold = max(m_pAnamorphicThreshold->GetParam(), 0.0f);
+	params.vAnamorphicTint = m_pAnamorphicTint->GetParamVec4();
+
+	params.fFilterAmount = clamp_tpl(m_pFilterAmount->GetParam(), 0.0f, 2.0f);
+	params.fFilterSize = clamp_tpl(m_pFilterSize->GetParam(), 0.0f, 1.0f);
+	params.fFilterRotation = m_pFilterRotation->GetParam();
+	params.fFilterThreshold = max(m_pFilterThreshold->GetParam(), 0.0f);
+	params.nFilterPoints = (int)clamp_tpl(m_pFilterPoints->GetParam(), 4.0f, 8.0f);
+	params.pFilterPSFTex = const_cast<CTexture*>(static_cast<CParamTexture*>(m_pFilterPSFTex)->GetParamTexture());
+
+	params.nMode = (m_pMode->GetParam() > 0.5f) ? 1 : 0;
+	params.fWaveAmount = clamp_tpl(m_pWaveAmount->GetParam(), 0.0f, 200.0f);
+	params.fWaveReach = clamp_tpl(m_pWaveReach->GetParam(), 0.02f, 1.0f);
+	params.fDispersion = clamp_tpl(m_pDispersion->GetParam(), 0.0f, 1.0f);
+
+	return params;
+}
+
+////////////////////////////////////////////////////////////////////////////////////////////////////
+////////////////////////////////////////////////////////////////////////////////////////////////////
+
+void CHDRHalation::Reset(bool bOnSpecChange)
+{
+	m_pAmount->ResetParam(0.0f);
+	m_pThreshold->ResetParam(2.0f);
+	m_pRadius->ResetParam(0.5f);
+	m_pTint->ResetParamVec4(Vec4(1.0f, 0.35f, 0.15f, 0.0f));
+}
+
+SHDRHalationParams CHDRHalation::GetParams() const
+{
+	SHDRHalationParams params;
+
+	params.fAmount = clamp_tpl(m_pAmount->GetParam(), 0.0f, 3.0f);
+	params.fThreshold = max(m_pThreshold->GetParam(), 0.0f);
+	params.fRadius = clamp_tpl(m_pRadius->GetParam(), 0.0f, 1.0f);
+	params.vTint = m_pTint->GetParamVec4();
+
+	return params;
+}
