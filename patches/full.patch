+		}
+
+		OUT.Color = saturate(OUT.Color);
+	}
+
 #if %_RT_SAMPLE4
 	// Range compression (without out-of-gammut pixels)
 	OUT.Color.xyz = LimitREC709_8Bit(OUT.Color.xyz);
