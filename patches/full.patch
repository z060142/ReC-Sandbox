+	//! 8^3 tap distances span the whole frame width, which is what makes the line read as a
+	//! single stroke across the frame instead of a stubby spike.
+	static const int kAnamorphicIterations = 3;
+	//! Gaussian iterations for the halation halo, run at 1/16 resolution. CGaussianBlurPass has
+	//! a fixed 16 tap footprint (+-8 texels) whatever its distribution, so the halo's WIDTH comes
+	//! from the resolution it runs at (+-8 texels at 1/16 = +-128 full-res pixels), and being a
+	//! true separable Gaussian it is isotropic - a round halo, as emulsion scatter is.
+	static const int kHalationBlurIterations = 2;
+
 	CBloomStage(CGraphicsPipeline& graphicsPipeline)
 		: CGraphicsPipelineStage(graphicsPipeline)
 		, m_pass1H(&graphicsPipeline)
 		, m_pass1V(&graphicsPipeline)
 		, m_pass2H(&graphicsPipeline)
-		, m_pass2V(&graphicsPipeline) {}
+		, m_pass2V(&graphicsPipeline)
+		, m_passStreakThreshold(&graphicsPipeline)
+		, m_passAnamorphicThreshold(&graphicsPipeline)
+		, m_passFilterThreshold(&graphicsPipeline)
+		, m_passDiffractionThreshold(&graphicsPipeline)
+		, m_passDiffractionBlurH(&graphicsPipeline)
+		, m_passDiffractionBlurV(&graphicsPipeline)
+		, m_passDiffractionDebug(&graphicsPipeline)
+		, m_passDiffractionComposite(&graphicsPipeline)
+		, m_passDiffractionReadbackCopy(&graphicsPipeline)
+		, m_passHalationThreshold(&graphicsPipeline)
+		, m_passHalationDown0(&graphicsPipeline)
+		, m_passHalationDown1(&graphicsPipeline)
+		, m_passHalationBlur(&graphicsPipeline)
+		, m_passHalationComposite(&graphicsPipeline)
+	{
+		for (int direction = 0; direction < kMaxStreakDirections; ++direction)
+		{
+			for (int iteration = 0; iteration < kStreakIterations; ++iteration)
+				m_passStreakStretch[direction][iteration].SetGraphicsPipeline(&graphicsPipeline);
+		}
+
+		for (int iteration = 0; iteration < kAnamorphicIterations; ++iteration)
+			m_passAnamorphicStretch[iteration].SetGraphicsPipeline(&graphicsPipeline);
+	}
 
 	bool IsStageActive(EShaderRenderingFlags flags) const final
 	{
@@ -24,9 +67,99 @@ public:
 
 	void Execute();
 
+	//! Adds the wave-glare layer into the HDR target. Called by the pipeline right after
+	//! Execute(), in the same window as the DOF's ghost composite: the glare has its own
+	//! half-resolution layer now instead of travelling through $HDRFinalBloom, so it needs its
+	//! own composite. Consume-once, and a no-op in every frame the glare pass did not run.
+	void ExecuteDiffractionComposite();
+
 private:
+	void ExecuteStreaks();
+	void ExecuteDiffraction(const SHDRStreaksParams& streakParams, float fBloomCompositeWeight);
+	void UpdateDiffractionSourceReadback(int nDebugMode, CTexture* pSource, float fThreshold);
+	void ExecuteFilterPSF();
+	void ExecuteHalation();
+
 	CFullscreenPass m_pass1H;
 	CFullscreenPass m_pass1V;
 	CFullscreenPass m_pass2H;
 	CFullscreenPass m_pass2V;
+
+	CFullscreenPass m_passStreakThreshold;
+	CFullscreenPass m_passStreakStretch[kMaxStreakDirections][kStreakIterations];
+
+	CFullscreenPass m_passAnamorphicThreshold;
+	CFullscreenPass m_passAnamorphicStretch[kAnamorphicIterations];
+
+	// Front filter PSF: a threshold pass into the shared scratch target, then one sprite draw
+	// per bright quarter-resolution texel. The sprites are procedural geometry expanded from
+	// SV_VertexID, so the pass needs a primitive pass and a per-view constant buffer of its
+	// own describing the quarter-resolution GRID (the DOF's splat and ghost passes do the
+	// same for their grids).
+	CFullscreenPass      m_passFilterThreshold;
+	CPrimitiveRenderPass m_passFilterPSF;
+	CRenderPrimitive     m_filterPSFPrimitive;
+	CConstantBufferPtr   m_pFilterPSFPerViewCB;
+
+	// Wave-optics diffraction glare (DiffractionKernelSpec.md). Same sparse convolution shape as
+	// the front filter above - a threshold pass and one sprite per surviving source texel - but
+	// the pattern is not authored: it is the FFT of the pupil, built by the DOF stage's job,
+	// sampled radially and extrapolated past its own edge by the edge-diffraction law. The debug
+	// pass draws that kernel into the corner of the frame.
+	//
+	// Everything here runs at HALF resolution and into a layer of its own, unlike the rest of the
+	// glare family. At quarter resolution a lamp is a 3x3 block of thresholded texels, each of
+	// which spawns a sprite, so the SUM of those sprites has the block's square as its centre;
+	// and the deposit was then bilinearly magnified 4x onto the pattern's steepest slope, which
+	// is what put visible square blocks around every source. Half resolution halves both errors
+	// in each axis, and the source pre-blur below turns the block into a round blob.
+	CFullscreenPass      m_passDiffractionThreshold;
+	CFullscreenPass      m_passDiffractionBlurH;
+	CFullscreenPass      m_passDiffractionBlurV;
+	CPrimitiveRenderPass m_passDiffraction;
+	CRenderPrimitive     m_diffractionPrimitive;
+	CConstantBufferPtr   m_pDiffractionPerViewCB;
+	CFullscreenPass      m_passDiffractionDebug;
+	CFullscreenPass      m_passDiffractionComposite;
+
+	// Half-resolution glare targets: the thresholded (and pre-blurred) source, its separable
+	// blur scratch, and the RGBA16F layer the sprites deposit into. Allocated lazily like the
+	// halation targets, so Analytic mode and glare off cost nothing.
+	_smart_ptr<CTexture> m_pTexDiffractionSource;
+	_smart_ptr<CTexture> m_pTexDiffractionSourceTemp;
+	_smart_ptr<CTexture> m_pTexDiffractionLayer;
