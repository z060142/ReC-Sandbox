+	static CCryNameTSCRC techStreakStretch("HDRStreakStretch");
+	static CCryNameR streakParams0Name("StreakParams0");
+	static CCryNameR streakParams1Name("StreakParams1");
+	static CCryNameR streakParams2Name("StreakParams2");
