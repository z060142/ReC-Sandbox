+//////////////////////////////////////////////////////////////////////////////////////////////////
+// Lens ghosts into the frame - the ONE place they reach it (LensGhostSpec.md, section 3.4).
+//
+// The pipeline calls this after the half and quarter resolution downsamples of the HDR target,
+// i.e. after every thresholded glare source has been extracted (diffraction streaks, the
+// anamorphic flare, the front filter PSF, halation) and after auto exposure has metered, and
+// before the tone map, which is the last reader of the HDR target. A ghost is an image of the
+// aperture formed by a SECOND-order reflection between two lens surfaces; a flare struck off one
+// would be third order, some 1/50 to 1/200 of the ghost, and invisible. So ghosts light nothing:
+// they are laid onto the finished frame and nothing downstream thresholds them.
+//
+// Being here also means they are not motion blurred by the scene's velocities - correct, a ghost
+// is formed in the glass and follows the source, not the geometry behind it - and not depth
+// masked, exactly as before.
+//////////////////////////////////////////////////////////////////////////////////////////////////
+void CDepthOfFieldStage::ExecuteGhostComposite()
+{
+	// Consume-once: whoever calls this ends the frame's ghosts, and a frame in which the DOF
+	// stage never ran (r_dof 0, no focus) leaves the flag false and this a no-op.
+	if (!m_bGhostLayerValid)
+		return;
+
+	m_bGhostLayerValid = false;
+
+	CTexture* pGhostLayer = m_pTexGhostLayer;
+	CTexture* pHDRTarget = m_graphicsPipelineResources.m_pTexHDRTarget;
+	if (!CTexture::IsTextureExist(pGhostLayer) || !CTexture::IsTextureExist(pHDRTarget))
+		return;
+
+	PROFILE_LABEL_SCOPE("LENS GHOST COMPOSITE");
+
+	CShader* pShader = CShaderMan::s_shPostDepthOfField;
+
+	if (m_passGhostComposition.IsDirty())
+	{
+		static CCryNameTSCRC techGhostCompose("DofGhostComposite");
+		m_passGhostComposition.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+		m_passGhostComposition.SetTechnique(pShader, techGhostCompose, 0);
+		m_passGhostComposition.SetRenderTarget(0, pHDRTarget);
+		// The layer carries only the energy the ghosts deposited, so it is added, not blended.
+		m_passGhostComposition.SetState(GS_NODEPTHTEST | GS_BLSRC_ONE | GS_BLDST_ONE);
+	}
