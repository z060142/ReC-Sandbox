+}
+
+// Van der Corput radical inverse in base 2; paired with (i + 0.5) / N it forms the
+// Hammersley set. The mask kernel needs a low-discrepancy pattern instead of the
+// stratified grid: a regular grid collapses under CDF inversion - only nSide distinct
+// v values means only nSide distinct mask ROWS ever get sampled, which turns thin
+// vertical structure in the mask (a note stem) into discrete horizontal bands at
+// large CoC. Deterministic across frames, so no temporal noise.
+static float RadicalInverse2(uint32 i)
+{
+	i = (i << 16) | (i >> 16);
+	i = ((i & 0x00ff00ffu) << 8) | ((i & 0xff00ff00u) >> 8);
+	i = ((i & 0x0f0f0f0fu) << 4) | ((i & 0xf0f0f0f0u) >> 4);
+	i = ((i & 0x33333333u) << 2) | ((i & 0xccccccccu) >> 2);
+	i = ((i & 0x55555555u) << 1) | ((i & 0xaaaaaaaau) >> 1);
+	return (float)i * 2.3283064365386963e-10f; // * 2^-32
+}
+
+Vec4 CDepthOfFieldStage::SampleMaskKernelTap(float u, float v) const
+{
+	// Standard 2D CDF inversion: the marginal row CDF with v, that row's conditional column
+	// CDF with u, linear interpolation inside the winning bin.
+	const int w = m_maskCDFWidth;
+	const int h = m_maskCDFHeight;
+
+	int y = (int)(std::lower_bound(m_maskRowCDF.begin(), m_maskRowCDF.end(), v) - m_maskRowCDF.begin());
+	y = min(y, h - 1);
+	const float fPrevRow = (y > 0) ? m_maskRowCDF[y - 1] : 0.0f;
+	const float fRowSpan = max(m_maskRowCDF[y] - fPrevRow, 1e-9f);
+	const float fy = ((float)y + clamp_tpl((v - fPrevRow) / fRowSpan, 0.0f, 1.0f)) / (float)h;
+
+	const float* pCol = &m_maskColCDF[(size_t)y * w];
+	int x = (int)(std::lower_bound(pCol, pCol + w, u) - pCol);
+	x = min(x, w - 1);
+	const float fPrevCol = (x > 0) ? pCol[x - 1] : 0.0f;
+	const float fColSpan = max(pCol[x] - fPrevCol, 1e-9f);
+	const float fx = ((float)x + clamp_tpl((u - fPrevCol) / fColSpan, 0.0f, 1.0f)) / (float)w;
+
+	// Same disc-space convention as the splat quad: quad-local uv to offsets. No vertical
+	// flip - the gather shader's tap offsets are applied in texture space (v down), the
+	// same space the mask is authored in, so the halo lines up with the splatted
+	// silhouette as-is. (A negation here was verified upside-down in the engine.)
+	// Taps are relative to the CoC radius, which is the pupil's BOUNDING radius: once the iris
+	// is the smaller hole the mask coordinates are rescaled by it, same as the splat quad.
+	const float fInvBound = 1.0f / max(m_maskBound, 1e-3f);
+	const float px = (fx * 2.0f - 1.0f) * fInvBound;
+	const float py = (fy * 2.0f - 1.0f) * fInvBound;
+
+	// Mask rotation: the mask is its own element, turned independently of the iris phase. The
+	// splat samples the texture through the inverse rotation, so both views turn together.
+	const float c = cosf(m_maskRotation);
+	const float s = sinf(m_maskRotation);
+	return Vec4(px * c - py * s, px * s + py * c, 0.0f, 0.0f);
 }
 
