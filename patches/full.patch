+		streakParams.bActive = true;
+		streakParams.fAmount = 1.0f;
+		streakParams.nDirectionCount = 8;
+		streakParams.fAngle = 0.4f;
+		streakParams.fThreshold = 0.5f;
+		streakParams.fLength = 0.6f;
+	}
