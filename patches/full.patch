+void CHDRStreaks::Reset(bool bOnSpecChange)
+{
+	m_pActive->ResetParam(0.0f);
+	m_pAmount->ResetParam(0.0f);
+	m_pCount->ResetParam(8.0f);
+	m_pAngle->ResetParam(0.0f);
+	m_pThreshold->ResetParam(4.0f);
+	m_pLength->ResetParam(0.5f);
+
+	m_pAnamorphicAmount->ResetParam(0.0f);
+	m_pAnamorphicLength->ResetParam(0.7f);
+	m_pAnamorphicThreshold->ResetParam(3.0f);
+	m_pAnamorphicTint->ResetParamVec4(Vec4(0.35f, 0.62f, 1.0f, 0.0f));
