+	// SceneCoC min-chain), so it needs dedicated allocations and is not part of this tier yet.
+	const bool bNativeGrid = CRenderer::CV_r_DofResolutionScale >= 1;
+	const int32 nWidth = bNativeGrid ? nLayerWidth : (nLayerWidth + 1) / 2;
+	const int32 nHeight = bNativeGrid ? nLayerHeight : (nLayerHeight + 1) / 2;
+	const uint32 nBokehVertexCount = uint32(nWidth) * uint32(nHeight) * 3 * 2;
+
+	// Blade count and iris shape exponent arrive already resolved from Execute() - the very
+	// numbers the gather taps were built from, so both views of the iris always agree.
+	CTexture* pShapeTex = dofParams.pBokehShapeTex;
+	const bool bShapeTexValid = CTexture::IsTextureExist(pShapeTex);
+
+	// Ground truth for the shape texture: the name that actually arrived at the post param and
+	// whether it resolved to real pixels. A name that arrives but does not resolve is a path
+	// problem; no name at all is a delivery problem.
+	{
+		static CryFixedStringT<256> s_lastName;
+		static int s_lastState = -1;
+		const char* szShapeName = pShapeTex ? pShapeTex->GetName() : "";
+		const int nState = bShapeTexValid ? 1 : 0;
+		if (s_lastState != nState || s_lastName != szShapeName)
+		{
+			s_lastName = szShapeName;
+			s_lastState = nState;
+			if (pShapeTex)
+				CryLog("[DOF] shape texture '%s' -> resolved %s (%dx%d)", szShapeName,
+				       bShapeTexValid ? "yes" : "NO", pShapeTex->GetWidth(), pShapeTex->GetHeight());
+			else
+				CryLog("[DOF] shape texture: none bound, using procedural disc");
+		}
+	}
+
+	if (!bShapeTexValid)
+		pShapeTex = CRendererResources::s_ptexWhite;
+
+	const float fTargetWidth = (float)m_graphicsPipelineResources.m_pTexHDRTarget->GetWidth();
+	const float fTargetHeight = (float)m_graphicsPipelineResources.m_pTexHDRTarget->GetHeight();
+	const float fAspectRatio = (1920.0f / 1080.0f) * (fTargetHeight / fTargetWidth);
+	// .z = horizontal splat scale, 1 / anamorphic squeeze. The pupil image is compressed
+	// horizontally by S, so the splat quad (and the mask sampled through it) is too; 1 = spherical.
+	const float fSpriteSqueeze = clamp_tpl(dofParams.fAnamorphicSqueeze, 1.0f, 2.0f);
+	const Vec4 vAspectRatio(fAspectRatio * (fTargetWidth / 1920.0f), fTargetHeight / 1080.0f, 1.0f / fSpriteSqueeze, CRenderer::CV_r_dofDilation);
+	const Vec4 vBokehShape(fNumApertureSides, fIrisExponent, bShapeTexValid ? 1.0f : 0.0f, dofParams.fBladeRotation);
+
+	// Pupil = mask INTERSECT iris, continuous at every f-number. The mask is a light block in
+	// FRONT of the lens with its own equivalent f-number; fIrisRadius = N_mask / N is the iris
+	// radius in mask units. Iris wider than the mask (> 1): the mask bounds the pupil and the
+	// polygon only trims whatever of the silhouette pokes past it. Iris stopped down past the
+	// mask (< 1): the polygon bounds the pupil and the mask is sampled at that scale, so the
+	// silhouette is clipped corner by corner and rounded off progressively. The two apertures
+	// stay two separate mechanisms (mask value field vs blade polygon); the crossover between
+	// them is a physical intersection, not a swap. The fill STYLE (radial iris look vs mask
+	// value field) follows whichever hole is the smaller one.
+	const float fIrisRadius = bShapeTexValid ? max(dofParams.fMaskFNumber, 0.7f) / max(dofParams.fApertureFNumber, 0.7f) : 1.0f;
+	const float fMaskBound  = min(fIrisRadius, 1.0f);                                  // pupil bounding radius, mask units
+	const float fPolyRadius = bShapeTexValid ? fIrisRadius / fMaskBound : 1.0f;        // polygon radius, quad units
+	const float fMaskLook   = bShapeTexValid ? clamp_tpl((fIrisRadius - 0.7f) / 0.6f, 0.0f, 1.0f) : 0.0f;
+	const bool  bMaskDomain = bShapeTexValid && fIrisRadius > 1.0f;                    // the mask is the smaller hole (logs)
+	// .w: CoC at which a splat reaches full strength (fade-in from a third of it) - keeps the
+	// splat's amplitude curve in step with the gather's, which loses energy as a highlight
+	// nears focus while an energy-conserving splat only gets brighter.
+	const Vec4 vBokehMask(fMaskLook, fMaskBound, fPolyRadius, max(CRenderer::CV_r_DofSpriteBokehFadeCoC, 0.0f));
+	// Mask rotation (cos, sin): the mask turns independently of the iris phase; the pixel shader
+	// samples the texture through the inverse rotation so it matches the rotated gather taps.
+	const Vec4 vBokehMask2(cosf(dofParams.fMaskRotation), sinf(dofParams.fMaskRotation), 0.0f, 0.0f);
+
+	// Field-dependent pupil, from the same derivation the gather used - the splat has to clip
+	// its silhouette with exactly the barrel the gather clipped its taps with, or the sprite and
+	// the halo underneath it disagree at the frame edges. .x of the second constant is the
+	// anamorphic squeeze, which the splat quad has already been narrowed by, so the pixel
+	// shader's quad-local coordinate IS pupil space and needs no further correction.
+	const Vec4 vFieldPupil = ResolveFieldPupil(dofParams.fCatEye, dofParams.fPupilScale, dofParams.fComa, dofParams.fAstigmatism);
+	const Vec4 vFieldPupil2(fSpriteSqueeze, (CRenderer::CV_r_DofFieldDebug > 0) ? 1.0f : 0.0f, 0.0f, 0.0f);
+	// Same derivation as the gather's, from the same user amount: the splat draws the shrunk
+	// channels at exactly the radius the gather masks its taps to.
+	// .y = the iris polygon's edge softness in quad-local radius units, resolved in Execute()
+	// from blade curvature (0.06 curved, 0.015 straight) and handed down unchanged. This is
+	// what a straight blade actually does differently - it cuts a crisper outline - now that
+	// the shape exponent can no longer stretch the corners past the physical polygon.
+	const Vec4 vAxialChromatic(ResolveAxialChromaticScale(dofParams.fAxialChromatic), fIrisEdgeSoft, 0.0f, 0.0f);
+
+	// Resolved by the shared helper, because the gather's energy split subtracts exactly this
+	// knee from the layers it builds (spec 3.3) and the two may not drift apart.
+	// Soft knee spanning +/-50% of the threshold. Wide on purpose: a hard cut makes highlights
+	// pop in and out one frame at a time as the aperture or the focus sweeps past them.
+	float fHighlightThreshold, fHighlightKnee;
+	ResolveHighlightKnee(dofParams.fHighlightThreshold, fHighlightThreshold, fHighlightKnee);
+	// Energy gain of a single splat. The pixel shader divides by the disc area to conserve
+	// energy; this scales the result back up, since the shape function's own integral is only
+	// a fraction of its bounding square (roughly 0.47 for the procedural disc+ring, and
+	// anything at all for a shape texture) - hence a user-facing knob rather than a constant.
+	float fSplatEnergyGain = max(dofParams.fHighlightGain, 0.0f);
+
+	// A shape mask passes only a fraction of its bounding square - the engine's own bokeh
+	// masks average about 0.35 - so a textured splat carries that much less energy than the
+	// procedural disc and reads dimmer for the same gain. Compensate by the reciprocal, which
+	// is what makes a star as present as the circle it replaces rather than a faint tint on
+	// top of the gather disc underneath. A measured per-texture mean would be exact, but the
+	// shape texture is a GPU resource with no CPU-side copy, and a readback every time the
+	// name changes is not worth it for a constant this forgiving.
+	// Exact whenever the CPU-side pupil is available (the same mask pixels the gather kernel
+	// samples from, clipped by the same iris radius, measured over the quad); the measured
+	// engine-mask average is the fallback for textures the CPU path cannot read.
+	const float kShapeMaskTransmittance = 0.35f;
+	if (bShapeTexValid)
+	{
+		const bool bPupilKnown = EnsureMaskKernelCDF(pShapeTex->GetName(), fIrisRadius);
+		fSplatEnergyGain /= bPupilKnown ? GetMaskPupilFill() : (bMaskDomain ? kShapeMaskTransmittance : 1.0f);
+	}
+
+	// Energy bookkeeping across grid tiers, one rule: a quad deposits
+	// (mean excess) * gain / CoC_grid^2 per layer pixel over a disc of (CoC_grid * scale)^2
+	// layer pixels, so its TOTAL is mean * gain * scale^2 - exactly the cell's worth of
+	// per-source-pixel excess (scale^2 source pixels at their mean). The scale terms cancel,
+	// so the SAME user gain deposits the same physical energy on the half-res grid, on the
+	// native grid, and at any internal resolution. No correction factor belongs here; the
+	// old grid-to-layer divide double-counted the dilution and dimmed every splat 4x.
+	// .w is the diagnostic flag: the pixel shader draws the raw silhouette at full
+	// strength instead of the energy-normalized deposit, so the shape is unmissable.
+	const float fSpriteDebug = (CRenderer::CV_r_DofSpriteBokehDebug > 0) ? 1.0f : 0.0f;
+	const Vec4 vBokehHighlight(fHighlightThreshold, fHighlightKnee, fSplatEnergyGain, fSpriteDebug);
+
+	static CCryNameR dofFocusParam0Name("vDofParamsFocus0");
+	static CCryNameR dofFocusParam1Name("vDofParamsFocus1");
+	static CCryNameR dofAspectRatioName("vAspectRatio");
+	static CCryNameR dofBokehShapeName("vDofBokehShape");
+	static CCryNameR dofBokehHighlightName("vDofBokehHighlight");
+	static CCryNameR dofBokehMaskName("vDofBokehMask");
+	static CCryNameR dofBokehMask2Name("vDofBokehMask2");
+	static CCryNameR dofFieldPupilName("vDofFieldPupil");
+	static CCryNameR dofFieldPupil2Name("vDofFieldPupil2");
+	static CCryNameR dofAxialChromaticName("vDofAxialChromatic");
+	static CCryNameR dofLensModelName("vDofLensModel");
+	static CCryNameR dofLensModel2Name("vDofLensModel2");
+
+	// Ground truth log, once per change: what the splat grid and the iris actually resolve to.
+	{
+		static int   s_lastWidth = -1, s_lastHeight = -1, s_lastShapeBound = -1;
+		static float s_lastBlades = -1.0f, s_lastBlend = -1.0f, s_lastThreshold = -1.0f;
+		const int nShapeState = (bShapeTexValid ? 1 : 0) | (bMaskDomain ? 2 : 0);
+		if (nWidth != s_lastWidth || nHeight != s_lastHeight || nShapeState != s_lastShapeBound ||
+		    fabsf(fNumApertureSides - s_lastBlades) > 0.01f || fabsf(fIrisExponent - s_lastBlend) > 0.01f ||
+		    fabsf(fHighlightThreshold - s_lastThreshold) > 0.01f)
+		{
+			s_lastWidth = nWidth;
+			s_lastHeight = nHeight;
+			s_lastShapeBound = nShapeState;
+			s_lastBlades = fNumApertureSides;
+			s_lastBlend = fIrisExponent;
+			s_lastThreshold = fHighlightThreshold;
+			CryLog("[DOF] hybrid splat grid %dx%d -> layer %dx%d (%u verts) blades=%.0f irisExp=%.2f edgeSoft=%.3f curv=%.2f rot=%.2f domain=%s (N=%.1f maskN=%.1f) thresh=%.2f shapeTex=%s",
+			       nWidth, nHeight, nLayerWidth, nLayerHeight, nBokehVertexCount, fNumApertureSides,
+			       fIrisExponent, fIrisEdgeSoft, dofParams.fBladeCurvature, dofParams.fBladeRotation,
+			       bMaskDomain ? "MASK" : "iris", dofParams.fApertureFNumber, dofParams.fMaskFNumber,
+			       fHighlightThreshold, bShapeTexValid ? "yes" : "no");
+		}
+	}
+
+	// Clear the splat layers once, before the draw: it accumulates additively into them and the
+	// overlay composites whatever ends up there.
+	CClearSurfacePass::Execute(pLayerNear, Clr_Transparent);
+	CClearSurfacePass::Execute(pLayerFar, Clr_Transparent);
+
+	// The ghosts get a layer of their own, cleared on the frames they run. It is NOT part of the
+	// splat overlay: see ExecuteGhostComposite().
+	CTexture* pGhostLayer = nullptr;
+	if (bGhost && AcquireGhostLayer(nLayerWidth, nLayerHeight))
+	{
+		pGhostLayer = m_pTexGhostLayer;
+		CClearSurfacePass::Execute(pGhostLayer, Clr_Transparent);
+	}
+
+	if (bSplat && !m_pSpritePerViewCB)
+	{
+		m_pSpritePerViewCB = gcpRendD3D->m_DevBufMan.CreateConstantBuffer(sizeof(HLSL_PerViewGlobalConstantBuffer));
+		if (m_pSpritePerViewCB)
+			m_pSpritePerViewCB->SetDebugName("SpriteBokeh Per-View CB");
+	}
+
+	// Accumulate the splats
+	if (bSplat && m_pSpritePerViewCB)
+	{
+		PROFILE_LABEL_SCOPE("HIGHLIGHT SPLATS");
+
+		// The per-view constant buffer describes the half resolution GRID, not the render target:
+		// the vertex shader uses it to walk the quad grid, to sample the source, and to turn a
+		// circle of confusion into an NDC extent. NDC is resolution independent, so the same
+		// geometry rasterized into the full resolution layer simply lands on four times the
+		// pixels - which is the whole point of this pass.
+		const SRenderViewInfo& viewInfo = m_graphicsPipeline.GetCurrentViewInfo(CCamera::eEye_Left);
+		const SRenderViewport customViewport(0, 0, nWidth, nHeight);
+		m_graphicsPipeline.GeneratePerViewConstantBuffer(&viewInfo, (int)m_graphicsPipeline.GetViewInfoCount(), m_pSpritePerViewCB, &customViewport);
+
+		D3DViewPort viewport;
+		viewport.TopLeftX = 0.0f;
+		viewport.TopLeftY = 0.0f;
+		viewport.Width = (float)nLayerWidth;
+		viewport.Height = (float)nLayerHeight;
+		viewport.MinDepth = 0.0f;
+		viewport.MaxDepth = 1.0f;
+
+		m_passSpriteSplat.SetRenderTarget(0, pLayerNear);
+		m_passSpriteSplat.SetRenderTarget(1, pLayerFar);
+		m_passSpriteSplat.SetViewport(viewport);
+		m_passSpriteSplat.BeginAddingPrimitives();
+
+		static CCryNameTSCRC techSpriteBokeh("DofBokehRef");
+		// SAMPLE1 = depth dilation, SAMPLE2 = lens model. Independent bits: the splat's lens-mode
+		// permutation only changes how big a sprite is allowed to get and how the circle of
+		// confusion it reads is clamped, so it composes with the dilation as it stands.
+		uint64 rtMask = (CRenderer::CV_r_dofDilation > 0.001f) ? g_HWSR_MaskBit[HWSR_SAMPLE1] : 0;
+		if (bLensModel)
+			rtMask |= g_HWSR_MaskBit[HWSR_SAMPLE2];
+
+		CRenderPrimitive& prim = m_spriteSplatPrimitive;
+		prim.SetFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_VS | CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+		prim.SetTechnique(pShader, techSpriteBokeh, rtMask);
+		prim.SetRenderState(GS_NODEPTHTEST | GS_BLSRC_ONE | GS_BLDST_ONE);
+		prim.SetCullMode(eCULL_None);
+
+		// Procedural geometry: no vertex or index stream, six vertices per source pixel.
+		prim.SetCustomVertexStream(~0u, EDefaultInputLayouts::Empty, 0);
+		prim.SetDrawInfo(eptTriangleList, 0, 0, nBokehVertexCount);
+
+		// Scene colour and depth are read from the vertex shader as well as the pixel shader.
+		prim.SetTexture(0, pSceneTarget, EDefaultResourceViews::Default, EShaderStage_Vertex | EShaderStage_Pixel);
+		prim.SetTexture(1, m_graphicsPipelineResources.m_pTexLinearDepth, EDefaultResourceViews::Default, EShaderStage_Vertex | EShaderStage_Pixel);
+		prim.SetTexture(2, CRendererResources::s_ptexGrainFilterMap);
+		prim.SetTexture(3, pShapeTex);
+		// The gather's own circle of confusion (near = tile max, far = tile min, first min-chain
+		// level - the raw level is overwritten by the second gather iteration by the time this
+		// pass runs). The splat sizes itself from the SAME numbers the gather blurred with, so
+		// the two never disagree on how far out of focus a highlight is.
+		prim.SetTexture(4, m_graphicsPipelineResources.m_pTexSceneCoC[1], EDefaultResourceViews::Default, EShaderStage_Vertex);
+		prim.SetSampler(0, EDefaultSamplerStates::PointClamp, EShaderStage_Vertex | EShaderStage_Pixel);
+		prim.SetSampler(1, EDefaultSamplerStates::PointClamp, EShaderStage_Vertex | EShaderStage_Pixel);
+		prim.SetSampler(2, EDefaultSamplerStates::PointWrap);
+		prim.SetSampler(3, EDefaultSamplerStates::LinearClamp);
+
+		prim.SetInlineConstantBuffer(eConstantBufferShaderSlot_PerView, m_pSpritePerViewCB, EShaderStage_Vertex | EShaderStage_Pixel);
+
+		if (prim.Compile(m_passSpriteSplat) == CRenderPrimitive::eDirty_None)
+		{
+			auto& constantManager = prim.GetConstantManager();
+			constantManager.BeginNamedConstantUpdate();
+			constantManager.SetNamedConstant(dofFocusParam0Name, vDofParams0, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofFocusParam1Name, vDofParams1, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofAspectRatioName, vAspectRatio, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofFocusParam0Name, vDofParams0, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofFocusParam1Name, vDofParams1, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofAspectRatioName, vAspectRatio, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofBokehShapeName, vBokehShape, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofBokehMaskName, vBokehMask, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofBokehMaskName, vBokehMask, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofBokehMask2Name, vBokehMask2, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofBokehHighlightName, vBokehHighlight, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofBokehHighlightName, vBokehHighlight, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofFieldPupilName, vFieldPupil, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofFieldPupilName, vFieldPupil, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofFieldPupil2Name, vFieldPupil2, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofFieldPupil2Name, vFieldPupil2, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofAxialChromaticName, vAxialChromatic, eHWSC_Pixel);
+			// Vertex: the sprite's own size cap. Pixel: the spherical-aberration apodization,
+			// which EvalPupilShape applies in both permutations (at 0 it is exactly 1).
+			constantManager.SetNamedConstant(dofLensModelName, vSpriteLensModel, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofLensModelName, vSpriteLensModel, eHWSC_Pixel);
+			constantManager.EndNamedConstantUpdate(&viewport, m_graphicsPipeline.GetCurrentRenderView());
+
+			m_passSpriteSplat.AddPrimitive(&prim);
+			m_passSpriteSplat.Execute();
+		}
+		else
+		{
+			static bool s_bWarned = false;
+			if (!s_bWarned)
+			{
+				s_bWarned = true;
+				CryLogAlways("[DOF] sprite bokeh primitive failed to compile - splat pass skipped");
+			}
+		}
+	}
+
+	if (bGhost && !m_pGhostPerViewCB)
+	{
+		m_pGhostPerViewCB = gcpRendD3D->m_DevBufMan.CreateConstantBuffer(sizeof(HLSL_PerViewGlobalConstantBuffer));
+		if (m_pGhostPerViewCB)
+			m_pGhostPerViewCB->SetDebugName("LensGhost Per-View CB");
+	}
+
+	// Internal reflection ghosts: one draw per ghost layer into the dedicated ghost target, with
+	// the same pixel shader and the same pupil constants the splat above just resolved.
+	if (bGhost && pGhostLayer && m_pGhostPerViewCB)
+	{
+		PROFILE_LABEL_SCOPE("LENS GHOSTS");
+
+		static CCryNameR dofGhost0Name("vDofGhost0");
+		static CCryNameR dofGhost1Name("vDofGhost1");
+
+		// QUARTER resolution grid, one candidate ghost per 4x4 native cell: a ghost source is a
+		// lamp, the sun or a hot reflection - never a lone sub-pixel highlight - and every layer
+		// multiplies the vertex work by the whole grid. Its own per-view constant buffer for the
+		// same reason the splat has one: the vertex shader walks its grid through it.
+		const int32 nGhostWidth = max(1, (nLayerWidth + 3) / 4);
+		const int32 nGhostHeight = max(1, (nLayerHeight + 3) / 4);
+		const uint32 nGhostVertexCount = uint32(nGhostWidth) * uint32(nGhostHeight) * 3 * 2;
+
+		const SRenderViewInfo& viewInfo = m_graphicsPipeline.GetCurrentViewInfo(CCamera::eEye_Left);
+		const SRenderViewport ghostViewport(0, 0, nGhostWidth, nGhostHeight);
+		m_graphicsPipeline.GeneratePerViewConstantBuffer(&viewInfo, (int)m_graphicsPipeline.GetViewInfoCount(), m_pGhostPerViewCB, &ghostViewport);
+
+		D3DViewPort ghostVP;
+		ghostVP.TopLeftX = 0.0f;
+		ghostVP.TopLeftY = 0.0f;
+		ghostVP.Width = (float)nLayerWidth;
+		ghostVP.Height = (float)nLayerHeight;
+		ghostVP.MinDepth = 0.0f;
+		ghostVP.MaxDepth = 1.0f;
+
+		// Target 0 is the ghost layer; DofBokehRefPS is an MRT shader and its far output must
+		// still land somewhere, so the far splat layer keeps that slot - the ghost quads carry
+		// QuadPos.z = 1, so what they write there is exactly zero.
+		m_passGhostSplat.SetRenderTarget(0, pGhostLayer);
+		m_passGhostSplat.SetRenderTarget(1, pLayerFar);
+		m_passGhostSplat.SetViewport(ghostVP);
+		m_passGhostSplat.BeginAddingPrimitives();
+
+		static CCryNameTSCRC techGhost("DofBokehGhost");
+
+		const int nGhostCount = clamp_tpl(dofParams.nGhostCount, 1, kMaxGhostLayers);
+		const float fGhostThreshold = max(dofParams.fGhostThreshold, 0.0f);
+		// Same soft knee proportion the splat uses, for the same reason: a hard cut makes a
+		// source pop its whole chain in and out one frame at a time as the camera moves.
+		const float fGhostKnee = max(fGhostThreshold * 0.5f, 0.01f);
+		// A ghost is an image of the aperture, so it shrinks with the iris exactly as the pupil
+		// does - that is the point of the pupil scale here, and it is the only aperture link the
+		// chain needs. 1 = 5% of the frame height wide open.
+		const float fGhostRadiusBase = dofParams.fGhostSize * fTargetHeight * 0.05f * dofParams.fPupilScale;
+		const Vec3 vGhostTint(dofParams.vGhostTint.x, dofParams.vGhostTint.y, dofParams.vGhostTint.z);
+
+		int nDrawn = 0;
+		for (int i = 0; i < nGhostCount; ++i)
+		{
+			const float t = (float)i / (float)max(nGhostCount - 1, 1);
+			// The chain runs from near the centre to past the opposite edge, growing as it goes.
+			const float fK = dofParams.fGhostSpread * (0.3f + (1.6f - 0.3f) * t);
+			const float fRadiusPx = fGhostRadiusBase * (0.6f + (1.4f - 0.6f) * t);
+			// Different coatings on different surfaces, at the price of one CPU matrix: one base
+			// tint from the user and the rest fanned out around it in hue.
+			const Vec3 cTint = RotateHueAroundGrey(vGhostTint, (float)i * dofParams.fGhostHueSpread * DEG2RAD(120.0f));
+
+			const Vec4 vGhost0(fK, fRadiusPx, fGhostThreshold, fGhostKnee);
+			// Energy of a ghost goes with the AREA of the aperture, like everything else the lens
+			// passes: the pixel shader spreads a fixed energy over the disc, and the disc area is
+			// itself proportional to p^2, so without this factor a ghost got 1/p^2 brighter as the
+			// iris closed - blazing specks at f/8 that then fed the streak threshold. With it the
+			// per-pixel brightness relative to the scene is what the coating decides and stays
+			// put at every f-number; the ghost only shrinks and hardens, as on a real lens.
+			// The bokeh splat's user gain (vDofBokehHighlight.z, applied in the shared pixel
+			// shader) is divided back out so a lens preset's ghosts do not move with its
+			// highlight gain; the pupil-fill correction inside that constant is kept, since a
+			// ghost is the same silhouette. kGhostGain = 3 puts amount 1 at the splat's default.
+			const float kGhostGain = 3.0f;
+			const float fGhostEnergy = dofParams.fGhostAmount * dofParams.fPupilScale * dofParams.fPupilScale
+			                           * kGhostGain / max(dofParams.fHighlightGain, 0.05f);
+			const Vec4 vGhost1(cTint.x, cTint.y, cTint.z, fGhostEnergy);
+
+			CRenderPrimitive& ghostPrim = m_ghostPrimitives[i];
+			ghostPrim.SetFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_VS | CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+			ghostPrim.SetTechnique(pShader, techGhost, 0);
+			ghostPrim.SetRenderState(GS_NODEPTHTEST | GS_BLSRC_ONE | GS_BLDST_ONE);
+			ghostPrim.SetCullMode(eCULL_None);
+
+			ghostPrim.SetCustomVertexStream(~0u, EDefaultInputLayouts::Empty, 0);
+			ghostPrim.SetDrawInfo(eptTriangleList, 0, 0, nGhostVertexCount);
+
+			// The same bindings as the splat. Depth (t1) and the gather's CoC (t4) are dead
+			// weight for a ghost - it is formed in the lens, not in the scene - but the pixel
+			// shader's resource layout is shared, so the slots stay filled.
+			ghostPrim.SetTexture(0, pSceneTarget, EDefaultResourceViews::Default, EShaderStage_Vertex | EShaderStage_Pixel);
+			ghostPrim.SetTexture(1, m_graphicsPipelineResources.m_pTexLinearDepth, EDefaultResourceViews::Default, EShaderStage_Vertex | EShaderStage_Pixel);
+			ghostPrim.SetTexture(2, CRendererResources::s_ptexGrainFilterMap);
+			ghostPrim.SetTexture(3, pShapeTex);
+			ghostPrim.SetTexture(4, m_graphicsPipelineResources.m_pTexSceneCoC[1], EDefaultResourceViews::Default, EShaderStage_Vertex);
+			ghostPrim.SetSampler(0, EDefaultSamplerStates::PointClamp, EShaderStage_Vertex | EShaderStage_Pixel);
+			ghostPrim.SetSampler(1, EDefaultSamplerStates::PointClamp, EShaderStage_Vertex | EShaderStage_Pixel);
+			ghostPrim.SetSampler(2, EDefaultSamplerStates::PointWrap);
+			ghostPrim.SetSampler(3, EDefaultSamplerStates::LinearClamp);
+
+			ghostPrim.SetInlineConstantBuffer(eConstantBufferShaderSlot_PerView, m_pGhostPerViewCB, EShaderStage_Vertex | EShaderStage_Pixel);
+
+			if (ghostPrim.Compile(m_passGhostSplat) != CRenderPrimitive::eDirty_None)
+				continue;
+
+			auto& constantManager = ghostPrim.GetConstantManager();
+			constantManager.BeginNamedConstantUpdate();
+			// Vertex: where this layer sits, how big it is and what it is made of.
+			constantManager.SetNamedConstant(dofGhost0Name, vGhost0, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofGhost1Name, vGhost1, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofAspectRatioName, vAspectRatio, eHWSC_Vertex);
+			constantManager.SetNamedConstant(dofFieldPupilName, vFieldPupil, eHWSC_Vertex);
+			// Pixel: the shared pupil description, byte for byte what the splat draw got.
+			constantManager.SetNamedConstant(dofAspectRatioName, vAspectRatio, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofBokehShapeName, vBokehShape, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofBokehMaskName, vBokehMask, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofBokehMask2Name, vBokehMask2, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofBokehHighlightName, vBokehHighlight, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofFieldPupilName, vFieldPupil, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofFieldPupil2Name, vFieldPupil2, eHWSC_Pixel);
+			constantManager.SetNamedConstant(dofAxialChromaticName, vAxialChromatic, eHWSC_Pixel);
+			// A ghost is an image of the aperture drawn by the splat's own pixel shader, so it
+			// inherits the apodization along with everything else that shapes the pupil.
+			constantManager.SetNamedConstant(dofLensModelName, vSpriteLensModel, eHWSC_Pixel);
+			constantManager.EndNamedConstantUpdate(&ghostVP, m_graphicsPipeline.GetCurrentRenderView());
+
+			m_passGhostSplat.AddPrimitive(&ghostPrim);
+			++nDrawn;
+		}
+
+		if (nDrawn > 0)
+		{
+			m_passGhostSplat.Execute();
+			// Hand the layer to ExecuteGhostComposite(), which the pipeline calls once the glare
+			// family has taken its sources from the HDR target.
+			m_bGhostLayerValid = true;
+		}
+
+		// Ground truth log, once per change: what the chain actually resolves to.
+		{
+			static int   s_lastCount = -1;
+			static float s_lastAmount = -1.0f, s_lastSpread = -1.0f, s_lastSize = -1.0f, s_lastThresh = -1.0f;
+			if (nGhostCount != s_lastCount ||
+			    fabsf(dofParams.fGhostAmount - s_lastAmount) > 0.005f ||
+			    fabsf(dofParams.fGhostSpread - s_lastSpread) > 0.005f ||
+			    fabsf(dofParams.fGhostSize - s_lastSize) > 0.005f ||
+			    fabsf(fGhostThreshold - s_lastThresh) > 0.05f)
+			{
+				s_lastCount = nGhostCount;
+				s_lastAmount = dofParams.fGhostAmount;
+				s_lastSpread = dofParams.fGhostSpread;
+				s_lastSize = dofParams.fGhostSize;
+				s_lastThresh = fGhostThreshold;
+				CryLog("[DOF] ghosts n=%d amount=%.2f spread=%.2f size=%.2f thresh=%.1f",
+				       nGhostCount, dofParams.fGhostAmount, dofParams.fGhostSpread,
+				       dofParams.fGhostSize, fGhostThreshold);
+			}
+		}
+	}
+
+	// Normalize the accumulated layers and composite them over the scene copy. Only the SPLAT
+	// writes these layers now, so with the splat off (mode 1, ghosts alone) they are empty and
+	// this fullscreen pass would add nothing but its own cost.
+	if (bSplat)
+	{
+		PROFILE_LABEL_SCOPE("SPLAT OVERLAY");
+
+		const uint64 nOverlayRTMask = bLensModel ? g_HWSR_MaskBit[HWSR_SAMPLE2] : 0;
+		if (m_passSpriteComposition.IsDirty(nOverlayRTMask))
+		{
+			static CCryNameTSCRC techSpriteCompose("RefDofMbNormalizePass");
+			m_passSpriteComposition.SetPrimitiveFlags(CRenderPrimitive::eFlags_ReflectShaderConstants_PS);
+			m_passSpriteComposition.SetPrimitiveType(CRenderPrimitive::ePrim_ProceduralTriangle);
+			m_passSpriteComposition.SetTechnique(pShader, techSpriteCompose, nOverlayRTMask);
+			m_passSpriteComposition.SetRenderTarget(0, m_graphicsPipelineResources.m_pTexHDRTarget);
+			// Additive overlay: the HDR target already holds the gathered frame, and the splat
+			// layer only carries the extra highlight energy that has to be added on top of it.
+			// Where no highlight survived the threshold the layer is zero, so mode 0 collapses
+			// to exactly mode 1 in ordinary scenes.
+			m_passSpriteComposition.SetState(GS_NODEPTHTEST | GS_BLSRC_ONE | GS_BLDST_ONE);
+		}
+
+		// Bound every frame: the layers are lazily allocated and are recreated on a resolution
+		// change, so their identity is not stable across the pass's cached state. Point sampled
+		// - the layer and the target are the same size now, so this is a 1:1 read.
+		m_passSpriteComposition.SetTextureSamplerPair(0, pLayerNear, EDefaultSamplerStates::PointClamp);
+		m_passSpriteComposition.SetTextureSamplerPair(1, pLayerFar, EDefaultSamplerStates::PointClamp);
+		m_passSpriteComposition.SetTextureSamplerPair(3, m_graphicsPipelineResources.m_pTexLinearDepth, EDefaultSamplerStates::PointClamp);
+
+		m_passSpriteComposition.BeginConstantUpdate();
+		m_passSpriteComposition.SetConstant(dofFocusParam0Name, vDofParams0, eHWSC_Pixel);
+		m_passSpriteComposition.SetConstant(dofFocusParam1Name, vDofParams1, eHWSC_Pixel);
+		m_passSpriteComposition.SetConstant(dofLensModelName, vLensOverlay, eHWSC_Pixel);
+		// It forms a circle of confusion of its own through LensModelCoC, so it takes the same
+		// physical cap the downscale and the composite clamp to.
+		m_passSpriteComposition.SetConstant(dofLensModel2Name, vLensModel2, eHWSC_Pixel);
+		// The GATHER's copy: the overlay's far mask has to agree with the composite's far blend
+		// down to the field curvature and the edge softness floor, which the splat's own copy of
+		// this constant deliberately does not carry.
+		m_passSpriteComposition.SetConstant(dofFieldPupil2Name, vGatherFieldPupil2, eHWSC_Pixel);
+		m_passSpriteComposition.Execute();
+	}
 }
