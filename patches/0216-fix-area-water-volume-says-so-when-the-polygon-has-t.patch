From 9000f696b071082513789bcfd056a288c93ad1bd Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sat, 12 Sep 2026 15:35:58 +0800
Subject: [PATCH 216/221] fix(area): water volume says so when the polygon has
 too few points

Water needs four contour points, not three: CreateArea will take three, but
SetAreaPhysicsArea wants more than three (WaterVolumeRenderNode.cpp:440), so a
three-point volume would render and never float anything. The component refused
silently; it now names the entity and the point count once, and re-arms when the
polygon grows. "Nothing appeared and nothing was logged" is the failure mode that
costs an afternoon.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SCUvWGLCsqzm3VNMzp4uiS
---
 .../Module/Functions/WaterVolumeComponent.cpp       | 13 ++++++++++++-
 .../Module/Functions/WaterVolumeComponent.h         |  1 +
 2 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/Code/CryPlugins/AreaComponents/Module/Functions/WaterVolumeComponent.cpp b/Code/CryPlugins/AreaComponents/Module/Functions/WaterVolumeComponent.cpp
index 15e74758..19bfbe29 100644
--- a/Code/CryPlugins/AreaComponents/Module/Functions/WaterVolumeComponent.cpp
+++ b/Code/CryPlugins/AreaComponents/Module/Functions/WaterVolumeComponent.cpp
@@ -221,10 +221,21 @@ bool CWaterVolumeComponent::BuildArea(IShapeComponent& shape)
 	{
 		// CreateArea wants 3, SetAreaPhysicsArea wants more than 3 (.cpp:440), and the legacy object
 		// only builds above 3 (WaterShapeObject.cpp:288) - so 4 is the real minimum for water that
-		// both renders and floats things.
+		// both renders and floats things. Said out loud, because "nothing appeared and nothing was
+		// logged" is the failure mode that costs an afternoon.
+		if (!m_bWarnedTooFewPoints)
+		{
+			m_bWarnedTooFewPoints = true;
+			CryWarning(VALIDATOR_MODULE_ENTITYSYSTEM, VALIDATOR_WARNING,
+			           "Water Volume on entity \"%s\": the polygon has %d points, and water needs at least 4 - add points with Edit Shape.",
+			           m_pEntity->GetName(), totalPoints);
+		}
+
 		return false;
 	}
 
+	m_bWarnedTooFewPoints = false;
+
 	const int pointCount = min(totalPoints, kMaxStackPoints);
 
 	Vec3 worldPoints[kMaxStackPoints];
diff --git a/Code/CryPlugins/AreaComponents/Module/Functions/WaterVolumeComponent.h b/Code/CryPlugins/AreaComponents/Module/Functions/WaterVolumeComponent.h
index 2e74c337..6ed17027 100644
--- a/Code/CryPlugins/AreaComponents/Module/Functions/WaterVolumeComponent.h
+++ b/Code/CryPlugins/AreaComponents/Module/Functions/WaterVolumeComponent.h
@@ -259,6 +259,7 @@ private:
 	bool   m_bWarnedNoShape = false;
 	bool   m_bWarnedWrongKind = false;
 	bool   m_bWarnedMaterial = false;
+	bool   m_bWarnedTooFewPoints = false;
 	uint64 m_lastBuildSignature = 0;
 };
 
