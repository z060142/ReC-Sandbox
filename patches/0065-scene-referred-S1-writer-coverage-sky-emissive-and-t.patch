diff --git a/Engine/Shaders/HWScripts/CryFX/FXConstantDefs.cfi b/Engine/Shaders/HWScripts/CryFX/FXConstantDefs.cfi
index ffaa32a6..4721896c 100644
--- a/Engine/Shaders/HWScripts/CryFX/FXConstantDefs.cfi
+++ b/Engine/Shaders/HWScripts/CryFX/FXConstantDefs.cfi
@@ -103,7 +103,30 @@ cbuffer PerMaterialConstants : register()
 //=============================================================================
 //=== Global constants ========================================================
 
-#define PS_HDR_RANGE_ADAPT_MAX 1.0
+// Emissive materials are authored in kcd/m^2 while engine units are 1.0 = 10 000 cd/m^2. One
+// definition, because the same literal used to sit in Illum.cfx, MultiLayeredMaterials.cfx and
+// (as its reciprocal power) in ShaderResources.h, free to drift apart at the first edit.
+#define MAT_EMISSIVE_UNIT_SCALE (1000.0 / 10000.0)
+
+// The scene-referred pre-exposure, as seen by the forward and transparent passes
+// (SceneReferredSpec.md D3, decisions/s1-writer-coverage.md approach A). This used to be the
+// literal 1.0 - a leftover of the CE 3.x L-buffer range-adaptation round trip that nothing ever
+// set - and it is now the lever every writer that bypasses the deferred light lists multiplies by.
+//
+// It is written as 1 + (exposure - 1) rather than as the exposure itself, and that is deliberate:
+// CV_SceneExposure.x holds exposure MINUS ONE, so a shader that runs with the per-view constant
+// buffer unbound - or with the scene-referred path off, where the camera publishes unity - reads
+// exactly 1.0 and multiplies by exactly 1.0. Off the switch the picture is therefore bit-identical
+// (x * 1.0f is exact in IEEE); only the instruction that was folded away at compile time comes
+// back. The 16 multiply sites keep their text unchanged.
+#define PS_HDR_RANGE_ADAPT_MAX (1.0 + CV_SceneExposure.x)
+
+// The five sites that read scene colour BACK out of the HDR or reflection targets used to divide
+// the same factor out again, which is the round-trip semantics of the old console scheme and
+// exactly wrong for a pre-exposure: the value read is already exposed and must not be un-exposed.
+// Off the switch the factor was 1.0 anyway, so this is 1.0 in both cases and the divide keeps
+// folding away at compile time exactly as it does today.
+#define PS_HDR_RANGE_ADAPT_MAX_SCENE_READ 1.0
 
 cbuffer CBPerViewGlobal : register(b6)
 {
@@ -145,6 +168,11 @@ cbuffer CBPerViewGlobal : register(b6)
 	
 	float4x4  CV_ProjMatr;
 	float4x4  CV_ProjMatrUnjittered;
+
+	// Scene-referred pre-exposure. .x = exposure - 1, .y = 1/exposure - 1 (both zero when the
+	// scene-referred path is off, so an unbound buffer is unity); .z and .w reserved.
+	// Read through PS_HDR_RANGE_ADAPT_MAX, never directly.
+	float4    CV_SceneExposure;
 };
 
 cbuffer CBPerPassShadowGen : register(b5)
