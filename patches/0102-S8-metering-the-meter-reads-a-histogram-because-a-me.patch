+Vec3 CRendererResources::GetWorkingLuminanceWeights()
+{
+	static const Vec3 kRec709Y(0.2126f, 0.7152f, 0.0722f);
+	static const Vec3 kAP1Y(0.27222872f, 0.67408177f, 0.05368952f);
+
+	// IsSceneReferredWorkingSpace() and not IsSceneReferred(): this follows what is IN the buffer,
+	// so r_SceneReferredDebug 1 (skip the conversion) keeps the weights on Rec.709 as well.
+	return CRendererResources::IsSceneReferredWorkingSpace() ? kAP1Y : kRec709Y;
+}
