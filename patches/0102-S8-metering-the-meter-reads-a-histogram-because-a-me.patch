+// The retirement rule, in one place. Every published meter number goes to its "no measurement"
+// value, which the camera reads as "hold the last EV" rather than as a scene that just went black.
+void CAutoExposureStage::RetireSceneReferredMeter()
+{
+	CD3D9Renderer* const pRenderer = gcpRendD3D;
+
+	pRenderer->m_fSceneReferredMeteredIlluminance = 0.0f;
+	pRenderer->m_fSceneReferredMeterRaw = 0.0f;
+	pRenderer->m_fSceneReferredMeterExposure = 1.0f;
+	pRenderer->m_bSceneReferredMeterRejected = false;
+	ZeroStruct(pRenderer->m_sceneReferredMeterHistogram);
+}
+
+// The 64x1 accumulation target (decisions/s8-metering.md approach A, "the readback is the code we
+// already wrote").
+//
+// It is a TEXTURE and not a CGpuBuffer for one concrete reason: DownloadToStagingResource lives on
+// CDeviceTexture and has no CDeviceBuffer twin anywhere in this tree, so a buffer histogram would
+// need a copy pass and a staging texture of its own. 64 uints is 256 bytes, one fence a frame.
+//
+// The format is the awkward part. CRYENGINE's ETEX_Format list has no unsigned-integer entry at
+// all, and InterlockedAdd needs an R32_UINT typed UAV. The way through is the one the linear-depth
+// fixup target already takes (GraphicsPipeline.cpp, m_pTexLinearDepthFixupUAV): create the texture
+// as eTF_R32F with FT_USAGE_UAV_RWTEXTURE, which makes the underlying resource R32_TYPELESS, then
+// build a DXGI_FORMAT_R32_UINT view of it by hand. The declared texture format is then a polite
+// fiction that nothing reads - the shader writes uints and the CPU decodes uints.
+bool CAutoExposureStage::EnsureMeterHistogramTexture()
+{
+	if (CTexture::IsTextureExist(m_pTexMeterHistogram))
+		return true;
+
+	const uint32 flags = FT_NOMIPS | FT_DONT_STREAM | FT_USAGE_RENDERTARGET
+	                     | FT_USAGE_UNORDERED_ACCESS | FT_USAGE_UAV_RWTEXTURE | FT_STAGE_READBACK;
+	const std::string id = m_graphicsPipeline.GetUniqueIdentifierName();
+
+	m_pTexMeterHistogram = CTexture::GetOrCreateRenderTarget(("$SceneReferredMeterHistogram" + id).c_str(),
+	                                                         SSceneReferredMeterHistogram::kBinCount, 1,
+	                                                         Clr_Transparent, eTT_2D, flags, eTF_R32F);
+
+	if (!CTexture::IsTextureExist(m_pTexMeterHistogram) || m_pTexMeterHistogram->GetDevTexture() == nullptr)
+	{
+		m_pTexMeterHistogram.reset();
+		CryLogAlways("[SceneReferred] the metering histogram target could not be created - AUTO falls back to the log-mean meter");
+		return false;
+	}
+
+	const SResourceView typedUAV = SResourceView::UnorderedAccessView(DXGI_FORMAT_R32_UINT, 0, -1, 0,
+	                                                                  SResourceView::eUAV_ReadWrite);
+	m_meterHistogramUAV = m_pTexMeterHistogram->GetDevTexture()->GetOrCreateResourceViewHandle(typedUAV);
+
+	CryLog("[SceneReferred] metering histogram armed: %d bins, %.1f to %.1f stops over mid grey, %.3f stops per bin",
+	       (int)SSceneReferredMeterHistogram::kBinCount, kMeterHistogramLogMin, kMeterHistogramLogMax,
+	       (kMeterHistogramLogMax - kMeterHistogramLogMin) / (float)SSceneReferredMeterHistogram::kBinCount);
+	return true;
+}
+
+// Clear the bins, then bin the frame (decisions/s8-metering.md approach A, steps 1-2).
+//
+// The source is m_pTexHDRTargetScaled[1][0] - the SAME quarter-res copy the stock measure pass
+// reads, taken at the same point in the frame, so the two meters are looking at the same pixels
+// and the r_SceneReferredMeterHistogram 0/1 A/B means something. It is the copy AFTER the round-3
+// firefly-knee change (decisions/s8-fp16-writers.md): the knee's asymptote is now the camera's
+// white rather than a literal 1.0, so a sunlit texel arrives at its real value instead of being
+// squeezed into the sliver below display white, which is what made the old downsample useless as
+// a measurement of anything bright.
+//
+// Only ever dispatched on the scene-referred path. Off it the pass does not exist as far as the
+// command list is concerned, which is what keeps the stock pipeline byte-identical.
+void CAutoExposureStage::ExecuteMeterHistogram()
+{
+	m_bMeterHistogramValid = false;
+
+	const bool bCubemapGen = (m_graphicsPipeline.GetRenderFlags() & SHDF_CUBEMAPGEN) != 0;
+	if (!CRendererResources::IsSceneReferredStage(2) || bCubemapGen)
+		return;
+	if (CRenderer::CV_r_SceneReferredMeterHistogram == 0)
+		return;
+
+	CTexture* pSource = m_graphicsPipelineResources.m_pTexHDRTargetScaled[1][0];
+	if (!CTexture::IsTextureExist(pSource))
+		return;
+	if (!EnsureMeterHistogramTexture())
+		return;
+
+	PROFILE_LABEL_SCOPE("SCENE_REFERRED_METER_HISTOGRAM");
+
+	// The camera's metering mode, published on the post-effect bus beside the pre-exposure. Read
+	// here rather than passed down from ccam so that the mask the accumulation used travels back
+	// to the camera with the bins - one authority, one frame.
+	float fMode = 0.0f;
+	if (CPostEffectsMgr* pPostMgr = PostEffectMgr())
+		fMode = pPostMgr->GetByNameF("Global_User_MeterMode");
+	const uint32 nMode = (uint32)clamp_tpl((int)(fMode + 0.5f), 0, 2);
+
+	const int width = pSource->GetWidth();
+	const int height = pSource->GetHeight();
+
+	{
+		// The bins are accumulated with InterlockedAdd, so they have to start at zero every frame.
+		// ClearUAV on the typed view, not a render-target clear: the RTV would be R32_FLOAT and
+		// would write float zeroes, which happen to be the same bits but by accident rather than
+		// by contract.
+		CDeviceCommandListRef commandList = GetDeviceObjectFactory().GetCoreCommandList();
+		const ColorI cClear(0, 0, 0, 0);
+		commandList.GetComputeInterface()->ClearUAV(
+			m_pTexMeterHistogram->GetDevTexture()->LookupUAV(m_meterHistogramUAV), cClear);
+	}
+
+	CComputeRenderPass& pass = m_passMeterHistogram;
+
+	if (pass.IsDirty(pSource->GetTextureID(), m_pTexMeterHistogram->GetTextureID()))
+	{
+		static CCryNameTSCRC techHistogram("SceneReferredMeterHistogram");
+		pass.SetTechnique(CShaderMan::s_shHDRPostProcess, techHistogram, 0);
+		pass.SetTexture(0, pSource);
+		pass.SetOutputUAV(0, m_pTexMeterHistogram.get(), m_meterHistogramUAV);
+	}
+
+	pass.BeginConstantUpdate();
+	{
+		static CCryNameR paramsName("MeterHistParams");
+		static CCryNameR weightsName("MeterHistWeights");
+
+		pass.SetConstant(paramsName, Vec4((float)width, (float)height, (float)nMode, 0.0f));
+
+		// The luminance weights of the space the source is actually in this frame. A compute pass
+		// has no per-view constant buffer binding in this renderer, so GetWorkingLuminance() is
+		// out of reach and the row is passed in whole rather than as the per-view delta.
+		const Vec3 weights = CRendererResources::GetWorkingLuminanceWeights();
+		pass.SetConstant(weightsName, Vec4(weights.x, weights.y, weights.z, 0.0f));
+	}
+
+	const int tile = 8; // must match SCENE_METER_HIST_TILE in HDRPostProcess.cfx
+	pass.SetDispatchSize((width + tile - 1) / tile, (height + tile - 1) / tile, 1);
+
+	pass.PrepareResourcesForUse(GetDeviceObjectFactory().GetCoreCommandList());
+
+	{
+		SScopedComputeCommandList computeCommandList(false);
+		pass.Execute(computeCommandList, EShaderStage_All);
+	}
+
+	m_nMeterIssuedMode = nMode;
+	m_bMeterHistogramValid = true;
+}
+
