+////////////////////////////////////////////////////////////////////////////////////////////////////
+// The camera's metering histogram (SceneReferredSpec.md D2/D7, decisions/s8-metering.md approach A).
+//
+// A 64-bin log2 LUMINANCE histogram of the quarter-res exposed HDR source - the same texture the
+// stock measure pass reads - accumulated with a metering weight and read back per frame. The
+// camera then takes the log-mean of a percentile band of it instead of the log-mean of the whole
+// frame, which is the one statistic that is robust to "one large region owns the average".
+//
+// WHAT IS METERED, AND THE SEMANTIC CHANGE THAT COMES WITH IT.
+//
+// The stock measure pass does not meter luminance. It divides the G-buffer albedo out and
+// multiplies by PI to estimate the ILLUMINANCE falling on each surface, which makes it an
+// incident meter - and for pixels with no G-buffer albedo (sky, emissive, every forward-rendered
+// pixel) it FABRICATES an albedo of 0.2. That fabrication is calibrated for midday sun and
+// over-reads by 1.6 to 3.2 stops in low sun, overcast and open shade, weighted by the sky's share
+// of the frame, which outdoors is most of it: on an airfield frame it put 74 700 lux on mid grey
+// when the subject was lit by 100 000 and collapsed the whole picture into a 2.5-stop band below
+// mid grey (research/s8-metering.md section 2.3).
+//
+// This pass meters LUMINANCE. There is no albedo, no PI and no fabricated 0.2, so the sky and
+// emissive fallback no longer exists and NO LONGER MATTERS. The meter now behaves like a real
+// camera's REFLECTED meter: it measures the light coming back off the scene. What keeps the
+// calibration is the target, not the quantity - the camera places the band's log-mean on 0.18, and
+// by spec D6 a correctly exposed 18 % card under the light lands on exactly 0.18. So an 18 % card
+// filling the frame makes the two meters agree exactly, and the incident-form constant C = 120*PI
+// of decisions/s1-exposure-constant.md still holds, because "put the metered value on 0.18 in
+// exposed units" IS that constant written the other way round (the algebra is spelled out in
+// CCinematicCameraComponent::ComputeSceneReferredEV100). What we do NOT inherit is a real body's
+// K = 12.5 calibration, which corresponds to about 12-13 % reflectance and is the origin of the
+// well-known third-of-a-stop grey-card discrepancy; ours is anchored on 18 % because the
+// pre-exposure guarantees 18 %.
+//
+// THE BIN MAPPING. Bin i covers
+//
+//     log2(L_exposed / 0.18)  in  [ -14 + i*0.5 , -14 + (i+1)*0.5 )
+//
+// i.e. 64 bins of half a stop each, from 14 stops BELOW mid grey to 18 stops ABOVE it. Bins 0 and
+// 63 are saturating buckets. The window is relative to mid grey rather than absolute, which is
+// only possible because the pre-exposure anchors 0.18 (spec D6): it is therefore permanently
+// centred on the interesting part of the scene at every time of day and with every lens and needs
+// no per-scene tuning - the one thing UE's absolute HistogramLogMin/Max cannot do, and the reason
+// Epic had to ship an "Extend default luminance range" project setting when they went physical.
+// The upper edge sits above the writer clamp's 17.5 stops on purpose, so a texel that hit the
+// clamp still has a bin to land in; the lower edge is 14 stops down, which covers a scene's own
+// range plus the tracking error during a seven-stop indoor-to-outdoor transition.
+//
+// WEIGHT QUANTISATION. Weights are accumulated as uint(w * 256), so a full-weight texel counts 256
+// and the CPU never has to divide - it works in those integer units throughout and only ever forms
+// ratios. At quarter res (480x270 at 1080p) the worst case is 129 600 * 256 = 33 million, far
+// inside uint32.
+//
+// COST. One texel per thread, 8x8 groups, 64 groupshared bins per group and one global atomic per
+// bin per group: 2 025 groups x 64 = 129 600 global atomics at 1080p, 0.02-0.05 ms. An order of
+// magnitude under the bloom that runs on the same texture one pass later.
+Texture2D<float4>  MeterHistSource : register(t0);
+RWTexture2D<uint>  MeterHistogram  : register(u0);
+
+// .x/.y = source size in texels (the dispatch is padded up to the group size)
+// .z    = metering mode: 0 Average, 1 CenterWeighted, 2 Spot
+// .w    = unused
+float4 MeterHistParams;
+// .xyz = the luminance weights of the space the HDR target is in this frame (Rec.709 before the
+//        working-space conversion, AP1 after it). Passed explicitly rather than read through
+//        GetWorkingLuminance(), because that lives in the per-view constant buffer and a compute
+//        pass in this renderer has no established binding for it.
+float4 MeterHistWeights;
+
+#define SCENE_METER_HIST_TILE     8
+#define SCENE_METER_HIST_BINS     64
+#define SCENE_METER_HIST_LOG_MIN  (-14.0)
+#define SCENE_METER_HIST_LOG_MAX  ( 18.0)
+#define SCENE_METER_HIST_WEIGHT_Q 256.0
+
+groupshared uint g_MeterHistBins[SCENE_METER_HIST_BINS];
+
+// The metering mask. A real body offers exactly this family of choices and has since the 1980s;
+// the sizes are the ones the camera industry settled on.
+//
+//   Average        - the whole frame, uniformly. The A/B reference against the shipped log-mean.
+//   CenterWeighted - a smooth radial falloff, full sensitivity at the centre and a quarter of it
+//                    in the corners. The classic, cheap and predictable answer to "the sky is half
+//                    the frame and it is not the subject". Default.
+//   Spot           - a disc 20 % of frame height across (about 1.8 % of frame area, inside the
+//                    camera-standard 1.5-3 %), soft-edged. Put it on a grey card and the card is
+//                    mid grey, whatever else is in the picture.
+//
+// The falloff is smooth rather than a hard circle on purpose: a hard edge makes the meter step as
+// content crosses it, and a step in the metering weight is a step in the exposure.
+float MeteringWeight(float2 uv, float2 size, float mode)
+{
+	if (mode < 0.5)
+		return 1.0;
+
+	// Frame-shaped coordinates, so a circle stays a circle on a wide frame instead of becoming an
+	// ellipse.
+	const float aspect = size.x / max(size.y, 1.0);
+	const float2 d = (uv - 0.5) * float2(aspect, 1.0);
+
+	if (mode < 1.5)
+	{
+		// Normalised so r = 1 at the corner. The normalisation only sets how fast the falloff
+		// runs; this one gives the classic 100 % centre / 25 % corner split.
+		const float r = saturate(length(d) / (0.5 * sqrt(aspect * aspect + 1.0)));
+		return lerp(1.0, 0.25, smoothstep(0.0, 1.0, r));
+	}
+
+	const float spotRadius = 0.10;  // 20 % of frame height across
+	return 1.0 - smoothstep(spotRadius * 0.9, spotRadius * 1.1, length(d));
+}
+
+[numthreads(SCENE_METER_HIST_TILE, SCENE_METER_HIST_TILE, 1)]
+void SceneReferredMeterHistogramCS(uint3 DispatchThreadID : SV_DispatchThreadID, uint GroupIndex : SV_GroupIndex)
+{
+	if (GroupIndex < SCENE_METER_HIST_BINS)
+		g_MeterHistBins[GroupIndex] = 0;
+
+	GroupMemoryBarrierWithGroupSync();
+
+	const int2 vPixCoord = int2(DispatchThreadID.xy);
+	const int2 vSize = (int2)MeterHistParams.xy;
+
+	if (all(vPixCoord < vSize))
+	{
+		const float3 cSrc = MeterHistSource[vPixCoord].rgb;
+
+		// A NaN carries no information and is dropped - no bin and no weight, so it cannot move
+		// the percentiles in either direction. An Inf DOES carry information, "brighter than this
+		// buffer can say", so it goes in the top bin: it gets a POSITION and no magnitude, which
+		// is the whole reason a histogram is immune to the runaway a log mean was not
+		// (research/s8-auto-exposure-runaway.md). The band then discards it as an outlier instead
+		// of being dragged by it, which is also why this pass needs no meter ceiling of its own.
+		if (!any(isnan(cSrc)))
+		{
+			const float fLum = max(dot(max(cSrc, 0.0), MeterHistWeights.xyz), 0.0);
+			const float fLogL = isfinite(fLum)
+			                    ? log2(max(fLum, 1e-8) / SCENE_MID_GREY)
+			                    : SCENE_METER_HIST_LOG_MAX;
+
+			const float fBinScale = SCENE_METER_HIST_BINS / (SCENE_METER_HIST_LOG_MAX - SCENE_METER_HIST_LOG_MIN);
+			const uint nBin = (uint)clamp(floor((fLogL - SCENE_METER_HIST_LOG_MIN) * fBinScale),
+			                              0.0, SCENE_METER_HIST_BINS - 1.0);
+
+			const float2 uv = (float2(vPixCoord) + 0.5) / float2(vSize);
+			const uint nWeight = (uint)(saturate(MeteringWeight(uv, float2(vSize), MeterHistParams.z))
+			                            * SCENE_METER_HIST_WEIGHT_Q + 0.5);
+
+			if (nWeight > 0)
+				InterlockedAdd(g_MeterHistBins[nBin], nWeight);
+		}
+	}
+
+	GroupMemoryBarrierWithGroupSync();
+
+	// One global atomic per bin per group instead of one per texel: 64 x 2 025 rather than
+	// 129 600 contended adds on 64 addresses.
+	if (GroupIndex < SCENE_METER_HIST_BINS)
+	{
+		const uint nLocal = g_MeterHistBins[GroupIndex];
+		if (nLocal > 0)
+			InterlockedAdd(MeterHistogram[int2(GroupIndex, 0)], nLocal);
+	}
+}
+
+technique SceneReferredMeterHistogram
+{
+  pass p0
+  {
+    ComputeShader = SceneReferredMeterHistogramCS();
+  }
+}
