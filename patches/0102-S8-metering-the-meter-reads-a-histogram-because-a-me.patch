+
+//! The metering histogram the renderer reads back once a frame for the Cinematic Camera's AUTO
+//! mode (SceneReferredSpec.md D2/D7, decisions/s8-metering.md approach A).
+//!
+//! The bins hold accumulated METERING WEIGHT, not texel counts: a texel at full weight contributes
+//! 256 and one the metering mask half-rejects contributes 128, so every percentile query is a
+//! ratio against totalWeight and no consumer has to know the quantisation. Bin i covers
+//!
+//!     log2(L_exposed / 0.18) in [ logMinStops + i*step , logMinStops + (i+1)*step ),
+//!     step = (logMaxStops - logMinStops) / kBinCount
+//!
+//! i.e. STOPS ABOVE MID GREY in the frame's own exposed units. Bins 0 and kBinCount-1 are
+//! saturating buckets: a percentile that resolves inside either is a bound, not a value.
+//!
+//! To get back to absolute scene luminance, divide by exposureAtCapture - the pre-exposure that
+//! was in force for the frame this sample was measured on, which the renderer recorded when it
+//! issued the download. The whole histogram shifts rigidly by that one scalar, so percentiles and
+//! log-means may all be computed in exposed units and converted once, at the end.
+struct SSceneReferredMeterHistogram
+{
+	enum { kBinCount = 64 };
+
+	float  bins[kBinCount];      //!< accumulated metering weight per bin
+	float  totalWeight;          //!< sum of the bins; 0 means "no measurement, hold the last EV"
+	float  exposureAtCapture;    //!< the pre-exposure applied to the frame these bins came from
+	float  logMinStops;          //!< lower edge of bin 0, in stops relative to mid grey
+	float  logMaxStops;          //!< upper edge of the top bin, same units
+	uint32 sampleId;             //!< increments once per completed readback; 0 = never measured
+	uint32 meteringMode;         //!< the mask the accumulation actually used (0 Avg, 1 Centre, 2 Spot)
 };
 
 enum class EGraphicsPipelineType
