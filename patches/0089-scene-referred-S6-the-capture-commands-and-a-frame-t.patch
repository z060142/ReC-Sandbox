+// ---------------------------------------------------------------------------------------------
+// The EXR capture's user surface (SceneReferredSpec.md S6 item 3). Commands rather than a cvar,
+// because arming a capture takes arguments and because `capture_frames` has already demonstrated
+// what happens when a capture's on/off state and its frame counter share one console variable that
+// three other systems also write.
+// ---------------------------------------------------------------------------------------------
+static void Cmd_CaptureEXR(IConsoleCmdArgs* pArgs)
+{
+	const char* szFolder = (pArgs && pArgs->GetArgCount() > 1) ? pArgs->GetArg(1) : "";
+	const char* szPrefix = (pArgs && pArgs->GetArgCount() > 2) ? pArgs->GetArg(2) : "";
+	CSceneReferredExport::Get().StartSequence(szFolder, szPrefix);
+}
+
+static void Cmd_CaptureEXRStop(IConsoleCmdArgs* pArgs)
+{
+	CSceneReferredExport::Get().Stop("stopped from the console");
+}
+
+static void Cmd_CaptureEXRFrame(IConsoleCmdArgs* pArgs)
+{
+	const char* szFolder = (pArgs && pArgs->GetArgCount() > 1) ? pArgs->GetArg(1) : "";
+	const char* szPrefix = (pArgs && pArgs->GetArgCount() > 2) ? pArgs->GetArg(2) : "";
+	CSceneReferredExport::Get().RequestSingleFrame(szFolder, szPrefix);
+}
