 ////////////////////////////////////////////////////////////////////////////////////////////////////
 
 // CTexture type effect param
+//! String type effect param. The bus is otherwise float and Vec4 only, and the camera metadata an
+//! exported frame has to carry (SceneReferredSpec.md S6) includes things that are genuinely names -
+//! the camera, the lens. CParamTexture already carries a string, but it turns it into a texture on
+//! the way in, which is not what is wanted here.
+//!
+//! Double-buffered per thread exactly like the other param types, with the same "set on the render
+//! thread wins once" rule, so a name written from a component on the main thread reaches the render
+//! thread on the following frame and never tears.
+class CParamString : public CEffectParam
+{
+public:
+	CParamString()
+	{
+		Reset();
+	}
+
+	CParamString(int nInit, bool bSmoothTransition)
+	{
+		Reset();
+	}
+
+	virtual void SetParamString(const char* pszParam)
+	{
+		CParamStringThreadSafeData* pFillData = &m_threadSafeData[gRenDev->GetMainThreadID()];
+		pFillData->value = pszParam ? pszParam : "";
+		pFillData->bSetThisFrame = true;
+	}
+
+	virtual const char* GetParamString() const
+	{
+		const int threadID = gRenDev->m_pRT ? gRenDev->m_pRT->GetThreadList() : 0;
+		return m_threadSafeData[threadID].value.c_str();
+	}
+
+	virtual void SyncMainWithRender();
+
+private:
+
+	void Reset()
+	{
+		for (int i = 0; i < RT_COMMAND_BUF_COUNT; ++i)
+		{
+			m_threadSafeData[i].value.clear();
+			m_threadSafeData[i].bSetThisFrame = false;
+		}
+	}
+
+	struct CParamStringThreadSafeData
+	{
+		string value;
+		bool   bSetThisFrame;
+	};
+
+	CParamStringThreadSafeData m_threadSafeData[RT_COMMAND_BUF_COUNT];
+};
