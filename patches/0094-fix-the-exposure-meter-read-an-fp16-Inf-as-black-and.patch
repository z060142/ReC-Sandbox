+const float CRendererResources::kSceneReferredMeterCeilingStops = 14.0f;
+
+float CRendererResources::GetSceneReferredMeterCeiling()
+{
+	// Gated on stage 2, the exposure stage: the ceiling only means anything once the pre-exposure
+	// is what put absolute scene radiance in the HDR target. Zero off it, which is what the
+	// shader reads as "stock NaN filter, unchanged".
