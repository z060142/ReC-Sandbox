+// The AUTO exposure loop, laid out end to end (SceneReferredSpec.md D2/D7).
+//
+// The loop is a feed-FORWARD chain, not a feedback one: the meter samples a pre-exposed frame,
+// the stage divides out the exposure that was in force for THAT frame, and the camera converts an
+// absolute illuminance into an EV. Every one of those four numbers has to be visible, because a
+// runaway can start at any of them and they are indistinguishable from the picture:
+//
+//   raw          the meter texture as it came back - PRE-EXPOSED engine units. Collapsing to
+//                ~1e-6 here is the signature of taps being read as black (the fp16 Inf case the
+//                measure pass's ceiling now prevents).
+//   /exposure    the pre-exposure recorded when THAT download was issued. If this does not track
+//                the applied scale one frame behind, the bookkeeping is wrong and the loop will
+//                oscillate or ratchet.
+//   = absolute   what the camera is actually fed. It should barely move when the aperture does;
+//                if it moves WITH the exposure, the division is not working.
+//   target EV    what that absolute illuminance asks for, at C = 120*pi.
+//   applied EV   what the camera settled on: the smoothed EV plus the mode's bias, after the
+//                Auto EV Min/Max clamp. target and applied converging is the loop working;
+//                applied pinned at a limit while target sits far away is the loop having lost.
+void CToneMappingStage::DisplaySceneReferredMeterInfo(float appliedEV)
+{
+	const float raw = gcpRendD3D->m_fSceneReferredMeterRaw;
+	const float exposureAtCapture = gcpRendD3D->m_fSceneReferredMeterExposure;
+	const float absolute = gcpRendD3D->m_fSceneReferredMeteredIlluminance;
+	const float targetEV = (absolute > 0.0f)
+	                       ? logf(absolute * RENDERER_LIGHT_UNIT_SCALE * 100.0f / (120.0f * gf_PI)) / logf(2.0f)
+	                       : 0.0f;
+
+	char str[256];
+	sprintf(str, "  meter raw %.4g / exposure %.4g = %.4g (%.0f lux) -> target EV %.2f, applied EV %.2f%s",
+	        raw, exposureAtCapture, absolute, absolute * RENDERER_LIGHT_UNIT_SCALE,
+	        targetEV, appliedEV,
+	        gcpRendD3D->m_bSceneReferredMeterRejected ? "  [SAMPLE REFUSED - holding]" : "");
+	IRenderAuxText::DrawText(Vec3(5, 115, 1), IRenderAuxText::ASize(1.0f), ColorF(1, 0, 1, 1), eDrawText_800x600 | eDrawText_2D, str);
+
+	sprintf(str, "  meter ceiling %.4g (%.0f stops over grey); stock adaptation bypassed (tone map exposure pinned to unity)",
+	        CRendererResources::GetSceneReferredMeterCeiling(), CRendererResources::kSceneReferredMeterCeilingStops);
+	IRenderAuxText::DrawText(Vec3(5, 135, 1), IRenderAuxText::ASize(1.0f), ColorF(1, 0, 1, 1), eDrawText_800x600 | eDrawText_2D, str);
+}
