From ffc5bed14566b05f5bf4828caf547ccf177cae94 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 2 Sep 2026 06:50:56 +0800
Subject: [PATCH 266/307] !F (Terrain Plate) Report the dominant terrain
 surface for contacts.

Map plate collision contacts to the dominant terrain surface type below the
plate. Footsteps, impacts, effects and friction then match the terrain material
seen on the integrated surface.
---
 .../Geometry/TerrainPlateComponent.cpp        | 430 ++++++++++++++++++
 .../Geometry/TerrainPlateComponent.h          |  90 ++++
 2 files changed, 520 insertions(+)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
index bc6db6be..9679435d 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/DefaultComponents/Geometry/TerrainPlateComponent.cpp
@@ -206,6 +206,32 @@ ICVar* g_pTerrainPlateCullBuriedCVar = nullptr;
 //! correctly seen as buried, while float noise cannot flip a vertex that is meant to sit on the surface.
 const float kBuriedCullMargin = 0.05f;
 
+//! Decision 09: the plate's contacts report the surface type of the TERRAIN LAYER under them instead of
+//! the plate material's single one. Kill switch, restoring the stock physicalise path bit for bit.
+int    g_terrainPlatePhysSurfaceFromTerrain = 1;
+ICVar* g_pTerrainPlatePhysSurfaceFromTerrainCVar = nullptr;
+
+//! Frames between two checks that the terrain layers under the plate are still the ones its physics
+//! mapping was built from. Editor only - a layer cannot be repainted at run time - and the check is
+//! kPhysSurfaceProbeGrid^2 terrain rays, so the default is deliberately slower than the bake probe.
+int    g_terrainPlatePhysSurfaceProbeFrames = 32;
+ICVar* g_pTerrainPlatePhysSurfaceProbeFramesCVar = nullptr;
+
+//! Probes per axis over the plate's world footprint. 25 rays: enough to pick the dominant layer and to
+//! notice a repaint, cheap enough to run on every plate in the level every 32 frames.
+const int kPhysSurfaceProbeGrid = 5;
+
+//! Hard ceiling on the mapping table. CPhysicalEntity's part stores nMats in an unsigned:7
+//! (physicalentity.h:81), so 128 entries would wrap to 0 - the same kludge the terrain itself works
+//! around at terrain_load.cpp:190. A plate footprint realistically sees fewer than ten.
+const int kPhysSurfaceMaxMappingEntries = 127;
+
+//! Metres above the terrain the surface sampling ray starts, and how far down it travels. The start has
+//! to clear the plate's own relief and the margin the weld sinks the rim by; the length has to reach
+//! back down through both. Generous, because the ray only ever tests the heightfield.
+const float kPhysSurfaceRayUp = 32.f;
+const float kPhysSurfaceRayLength = 128.f;
+
 //! Bake trigger / bake apply tracing. The bake chain has a dozen places where it can legitimately do
 //! nothing (the property is off, the level's terrain is not in yet, the footprint is empty, the write
 //! was refused), and until this cvar existed every one of them was a silent return: the user ticked
@@ -337,6 +363,29 @@ void RegisterTerrainPlateCVars()
 		g_pTerrainPlateCullBuriedCVar->AddOnChange(&CTerrainPlateComponent::OnCullBuriedCVarChanged);
 	}
 
+	g_pTerrainPlatePhysSurfaceFromTerrainCVar = REGISTER_CVAR2("e_TerrainPlatePhysSurfaceFromTerrain", &g_terrainPlatePhysSurfaceFromTerrain, 1, VF_NULL,
+	                                                          "Terrain Plate component: take the surface types the plate's COLLISION reports - footstep sounds,\n"
+	                                                          "bullet impact effects and decals, particles, friction - from the terrain layers painted under the\n"
+	                                                          "plate instead of from the plate's single material. The ids are sampled with downward terrain rays\n"
+	                                                          "when the plate is rebuilt, and re-sampled a moment after a layer under it is repainted.\n"
+	                                                          "This is the global kill switch; each plate also has a Physics Surface From Terrain tick box.\n"
+	                                                          "1 - default\n"
+	                                                          "0 - stock behaviour, bit for bit: the whole plate reports its own material's surface type");
+
+	// The per face ids are baked into the physics trimesh, so the cvar can only take effect by rebuilding
+	// every plate - exactly like e_TerrainPlateCullBuried above.
+	if (g_pTerrainPlatePhysSurfaceFromTerrainCVar != nullptr)
+	{
+		g_pTerrainPlatePhysSurfaceFromTerrainCVar->AddOnChange(&CTerrainPlateComponent::OnPhysSurfaceCVarChanged);
+	}
+
+	g_pTerrainPlatePhysSurfaceProbeFramesCVar = REGISTER_CVAR2("e_TerrainPlatePhysSurfaceProbeFrames", &g_terrainPlatePhysSurfaceProbeFrames, 32, VF_NULL,
+	                                                           "Terrain Plate component with Physics Surface From Terrain on: number of frames between two checks\n"
+	                                                           "that the terrain layers under the plate are still the ones its collision was built from. Nothing in\n"
+	                                                           "the engine announces a layer repaint, so the plate samples 5 x 5 cells of its own footprint and\n"
+	                                                           "re-applies itself when they change. Editor only - terrain cannot be repainted at run time.\n"
+	                                                           "0 - no polling, a repaint only takes effect when the plate is next edited or the level reloaded");
+
 	g_pTerrainPlateDebugCVar = REGISTER_CVAR2("e_TerrainPlateDebug", &g_terrainPlateDebug, 0, VF_NULL,
 	                                          "Terrain Plate component: trace the bake trigger and the bake itself.\n"
 	                                          "0 - off\n"
@@ -376,6 +425,12 @@ void UnregisterTerrainPlateCVars()
 		if (g_pTerrainPlateCullBuriedCVar != nullptr)
 			gEnv->pConsole->UnregisterVariable(g_pTerrainPlateCullBuriedCVar->GetName());
 
+		if (g_pTerrainPlatePhysSurfaceFromTerrainCVar != nullptr)
+			gEnv->pConsole->UnregisterVariable(g_pTerrainPlatePhysSurfaceFromTerrainCVar->GetName());
+
+		if (g_pTerrainPlatePhysSurfaceProbeFramesCVar != nullptr)
+			gEnv->pConsole->UnregisterVariable(g_pTerrainPlatePhysSurfaceProbeFramesCVar->GetName());
+
 		if (g_pTerrainPlateDebugCVar != nullptr)
 			gEnv->pConsole->UnregisterVariable(g_pTerrainPlateDebugCVar->GetName());
 	}
@@ -388,6 +443,8 @@ void UnregisterTerrainPlateCVars()
 	g_pTerrainPlateBakeEdgeAACVar = nullptr;
 	g_pTerrainPlateBakeWeldCurveCVar = nullptr;
 	g_pTerrainPlateCullBuriedCVar = nullptr;
+	g_pTerrainPlatePhysSurfaceFromTerrainCVar = nullptr;
+	g_pTerrainPlatePhysSurfaceProbeFramesCVar = nullptr;
 	g_pTerrainPlateDebugCVar = nullptr;
 }
 
@@ -1159,9 +1216,22 @@ Cry::Entity::EventFlags CTerrainPlateComponent::GetEventMask() const
 	// branch (:818-838), and while the entity, its slot and the terrain are all still whole.
 	bitFlags |= ENTITY_EVENT_DONE;
 
+	// IEntity::SetMaterial runs CEntityPhysics::OnGlobalEntityMaterialChanged (PhysicsProxy.cpp:390-404)
+	// and then sends this, so it is the hook that lets the plate push its own mapping back over the one
+	// the new material just installed. @see ApplyPhysicsSurfaceMapping.
+	bitFlags |= ENTITY_EVENT_MATERIAL;
+
 	// Only ticked while a rebuild was throttled away or held back, while the first bake is still owed,
 	// or while a live bake has to be watched - so a plate that is not baking costs nothing per frame.
+	// The terrain surface probe is the fourth reason, and it is editor only: nothing can repaint a layer
+	// at run time, so a launcher build never subscribes for it (@see PollPhysicsSurface).
+	const bool bWantsPhysSurfacePoll = m_bPhysSurfaceFromTerrain && g_terrainPlatePhysSurfaceFromTerrain != 0
+	                                   && ((uint32)m_type & (uint32)EMeshType::Collider) != 0
+	                                   && g_terrainPlatePhysSurfaceProbeFrames > 0
+	                                   && gEnv != nullptr && gEnv->IsEditor();
+
 	if (m_bRegenPending || m_bDeferredXformPending || m_bBakeMoveBatchPending || m_bInitialBakePending
+	    || bWantsPhysSurfacePoll
 	    || (m_bBakeIntoTerrain && !m_bBakeCommitted && (GetBakeProbeFrames() > 0 || GetPlateDebugLevel() >= 1)))
 	{
 		bitFlags |= ENTITY_EVENT_UPDATE;
@@ -1331,6 +1401,11 @@ void CTerrainPlateComponent::ProcessEvent(const SEntityEvent& event)
 			{
 				PollBake();
 			}
+
+			// Independent of the bake polling above on purpose: PollBake early-returns unless a bake is
+			// live, and it compares heights, so it cannot see a layer repaint under a plate that does not
+			// bake at all (decision 09, re-physicalise triggers). @see PollPhysicsSurface.
+			PollPhysicsSurface();
 		}
 		break;
 
@@ -1366,6 +1441,33 @@ void CTerrainPlateComponent::ProcessEvent(const SEntityEvent& event)
 		return; // someone else owns that slot
 
 	CBaseMeshComponent::ProcessEvent(event);
+
+	// Decision 09, settled fact 4: every one of these events ends in a call that rewrites the part's
+	// material mapping from the slot's RENDER material, which throws away the terrain ids the plate put
+	// there. The base class handler above is itself one of them (ApplyBaseMeshProperties ->
+	// UnphysicalizeSlot / PhysicalizeSlot -> CEntityPhysics::AddSlotGeometry, PhysicsProxy.cpp:1138-1151),
+	// which is why this sits AFTER it rather than in the switch. Pushing the cached table again is a
+	// single pe_params_part and casts no rays, so re-applying more often than strictly necessary is free.
+	//  * COMPONENT_PROPERTY_CHANGED / SLOT_CHANGED - the base class re-physicalises the slot.
+	//  * PHYSICAL_TYPE_CHANGED           - a physics component took the entity over and re-physicalised it
+	//                                      (PhysicsProxy.cpp:882).
+	//  * MATERIAL                        - IEntity::SetMaterial ran OnGlobalEntityMaterialChanged first
+	//                                      (PhysicsProxy.cpp:390-404, i.e. the :397 / :401 call sites).
+	// The remaining known site, UpdateSlotGeometry (:1265), is reached from IEntity::SetStatObj with
+	// bUpdatePhysics - which RegenerateMesh deliberately passes false for - and is covered there anyway by
+	// the ApplyPhysicsSurfaceMapping at the end of the rebuild. Anything not on this list is caught by the
+	// read-back half of PollPhysicsSurface.
+	switch (event.event)
+	{
+	case ENTITY_EVENT_COMPONENT_PROPERTY_CHANGED:
+	case ENTITY_EVENT_SLOT_CHANGED:
+	case ENTITY_EVENT_PHYSICAL_TYPE_CHANGED:
+	case ENTITY_EVENT_MATERIAL:
+		ApplyPhysicsSurfaceMapping();
+		break;
+	default:
+		break;
+	}
 }
 
