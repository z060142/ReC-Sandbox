From 08ea77e0429481965047865ad5b44dac1ed629c5 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Wed, 26 Aug 2026 06:28:59 +0800
Subject: [PATCH 29/35] fix: cat-eye reach capped below the barrel radius
 (default 1.0) - stopping down removes the clipping instead of blacking out
 the corners

---
 Code/CryEngine/RenderDll/Common/RendererCVars.cpp   |  9 +++++----
 .../XRenderD3D9/GraphicsPipeline/DepthOfField.cpp   |  7 ++++++-
 Code/CryPlugins/CinematicCamera/FieldPupilSpec.md   | 13 ++++++++-----
 .../CinematicCamera/docs/ConsoleReference.md        |  2 +-
 4 files changed, 20 insertions(+), 11 deletions(-)

diff --git a/Code/CryEngine/RenderDll/Common/RendererCVars.cpp b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
index a2a35c9f..4b8a6c97 100644
--- a/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
+++ b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
@@ -1567,12 +1567,13 @@ void CRendererCVars::InitCVars()
 	               "radii. 1.0 = the barrel is exactly the wide-open pupil (harshest clipping), "
 	               "above 1 = a barrel wider than the glass, so the corners keep more of the "
 	               "pupil. Default 1.05.");
-	REGISTER_CVAR3("r_DepthOfFieldCatEyeReach", CV_r_DofCatEyeReach, 1.5f, VF_NULL,
+	REGISTER_CVAR3("r_DepthOfFieldCatEyeReach", CV_r_DofCatEyeReach, 1.0f, VF_NULL,
 	               "TUNING for the field-dependent pupil (Cat-eye lens property). How far the "
 	               "barrel's apparent centre slides away from the pupil centre at the frame "
-	               "CORNER, per unit of Cat-eye, in wide-open pupil radii. Raise it to make the "
-	               "cat-eye and the mechanical falloff reach further in from the edges. "
-	               "Default 1.5.");
+	               "CORNER, per unit of Cat-eye, in wide-open pupil radii. Capped just below "
+	               "r_DepthOfFieldCatEyeBarrel: a barrel that slid past the pupil centre would "
+	               "black out the corners when stopped down, which no lens that covers its "
+	               "sensor does. Default 1.0 (corner transmission ~40%% wide open at Cat-eye 1).");
 	REGISTER_CVAR3("r_DepthOfFieldFieldDebug", CV_r_DofFieldDebug, 0, VF_NULL,
 	               "DIAGNOSTIC for the field-dependent pupil. 1 = the tonemap replaces the "
 	               "picture with the pupil transmission T as a grey ramp, which is exactly the "
diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
index 060532bc..675ebab1 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
@@ -284,8 +284,13 @@ Vec4 CDepthOfFieldStage::ResolveFieldPupil(float catEye, float pupilScale, float
 	const float kAstig = 0.5f;   // ellipse axis ratio at astigmatism = 1, in the corner
 
 	const float p = clamp_tpl(pupilScale, 0.05f, 1.0f);
-	const float reach = max(CRenderer::CV_r_DofCatEyeReach, 0.0f);
 	const float barrel = max(CRenderer::CV_r_DofCatEyeBarrel, 0.01f);
+	// The barrel's apparent offset at the frame corner can never reach the barrel radius: a lens
+	// whose barrel slid past the pupil centre would not cover its own sensor, and a pinhole stop
+	// on the axis has to pass light at every field position. Without this cap, stopping down
+	// (p -> small) blows the offset up faster than the barrel and the corners go black - the
+	// opposite of what a real lens does.
+	const float reach = clamp_tpl(CRenderer::CV_r_DofCatEyeReach, 0.0f, barrel * 0.97f);
 
 	return Vec4(reach * clamp_tpl(catEye, 0.0f, 1.0f) / p,
 	            barrel / p,
diff --git a/Code/CryPlugins/CinematicCamera/FieldPupilSpec.md b/Code/CryPlugins/CinematicCamera/FieldPupilSpec.md
index a5cd4b31..1e373bb7 100644
--- a/Code/CryPlugins/CinematicCamera/FieldPupilSpec.md
+++ b/Code/CryPlugins/CinematicCamera/FieldPupilSpec.md
@@ -21,9 +21,12 @@ plumbing: **coma** (radial comet tails, ∝ pupil radius², strongest wide open)
 **astigmatism** (radial vs tangential focus split: the blur ellipse elongates radially on one
 side of focus and tangentially on the other).
 
-Physically correct AND bold: defaults are 0 (no change to existing scenes), but at strength 1
-the corner pupil is cut to a sliver. That is the exaggeration zone by design
-(flaw → suppression → residual); the natural zone is roughly 0.2–0.4.
+Physically correct AND bold: defaults are 0 (no change to existing scenes); at strength 1, wide
+open, the corner pupil is cut to a lens shape passing ~40% of the light. The offset can never
+exceed the barrel radius (`K_reach <= 0.97 R_b`): a lens whose barrel slid past the pupil centre
+would not cover its own sensor, and a stopped-down pinhole must pass light everywhere - so
+stopping down always REMOVES the clipping, never blacks the corners out. The natural zone is
+roughly 0.2–0.4, 1 is the exaggeration zone (flaw → suppression → residual).
 
 ## 2. Model
 
@@ -50,7 +53,7 @@ the corner pupil is cut to a sliver. That is the exaggeration zone by design
 
 The mechanical opening is a circle of radius `R_b = 1.05` (wide-open units; cvar
 `r_DofCatEyeBarrel`, tuning only) whose centre, seen from field position `f`, sits at
-`c = -u * (K_reach * catEye * |f|)` with `K_reach = 1.5` (cvar `r_DofCatEyeReach`). In pupil
+`c = -u * (K_reach * catEye * |f|)` with `K_reach = 1.0` (cvar `r_DofCatEyeReach`, clamped to `<= 0.97 R_b`). In pupil
 units: `c_p = c / p`, `R_p = R_b / p`.
 
 * Pupil value at pupil point `x`: `pupil(x) *= saturate((R_p - |x - c_p|) / softEdge)`,
@@ -165,7 +168,7 @@ Saved/restored exactly like `Dof_User_MaskRotation` (baseline capture, `RestoreA
 | CVar | Default | Meaning |
 |---|---|---|
 | `r_DepthOfFieldCatEyeBarrel` | 1.05 | Barrel radius in wide-open pupil units (tuning). |
-| `r_DepthOfFieldCatEyeReach` | 1.5 | Barrel offset at the frame corner, per unit Cat-eye (tuning). |
+| `r_DepthOfFieldCatEyeReach` | 1.0 | Barrel offset at the frame corner, per unit Cat-eye (tuning; clamped below the barrel radius). |
 | `r_DepthOfFieldFieldDebug` | 0 | 1 = tonemap outputs the field transmission `T` as grey instead of the picture. |
 
 ## 4. Renderer plumbing
diff --git a/Code/CryPlugins/CinematicCamera/docs/ConsoleReference.md b/Code/CryPlugins/CinematicCamera/docs/ConsoleReference.md
index a01150e9..6e717b45 100644
--- a/Code/CryPlugins/CinematicCamera/docs/ConsoleReference.md
+++ b/Code/CryPlugins/CinematicCamera/docs/ConsoleReference.md
@@ -202,7 +202,7 @@ diagnostics outrank the mask. Kernel parameter changes are logged as
 
 | | |
 | --- | --- |
-| Default | 1.5 |
+| Default | 1.0 |
 | Purpose | Tuning for the field-dependent pupil (the **Cat-eye** lens property). How far the barrel's apparent centre slides away from the pupil centre at the frame **corner**, per unit of Cat-eye, in wide-open pupil radii. Raise it to make the cat-eye shape and the mechanical edge darkening reach further in from the edges, lower it to confine them to the extreme corners. |
 
 ### r_DepthOfFieldFieldDebug
