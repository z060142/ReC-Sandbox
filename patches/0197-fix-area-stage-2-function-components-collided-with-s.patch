From facfe144f577419518516417c33ae89c678c07f7 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sat, 12 Sep 2026 00:28:17 +0800
Subject: [PATCH 197/209] fix(area): stage 2 function components collided with
 stage 3's GUIDs

Create -> Area -> Polygon (and Box, Sphere, Spline, and Add Component -> Area)
produced nothing on the deployed build: "the object class AreaShapePolygon
produced no shape component".

Two components were registered twice under one GUID, because stage 2 and
stage 3 were written in the same worktree and both took the next free numbers
of the 6C3A81D5-...-9620x series:

  ...96210  CAreaFunctionComponent   vs  CGravityVolumeComponent
  ...96211  CTriggerBoundsComponent  vs  CDistributorComponent

A duplicate element GUID does not lose one component. RegisterPackageElements
(CrySchematyc/Core/Impl/Env/EnvRegistry.cpp:387-403) returns false, and
RegisterPackage (:102-110) then releases every element of the package and
erases the package, so the WHOLE AreaComponents package - all four shape kinds
included - was gone and CreateComponentByInterfaceID had nothing to create.
The DLL still loads and logs "Loading plug-in AreaComponents", which is why
the editor log showed nothing wrong: the conflict is reported on Schematyc's
critical-error channel, not in the editor log.

The 6C3A81D5-...-9620x series belongs to the SHAPE kinds (ShapeKinds.h owns
...96201..96204), so the two stage-2 FUNCTION components move to the series
this stage's own interface header already uses,
B4E27C09-8A16-4D53-9C70-1F5D3E8A46xx: 4620 for Area, 4621 for Trigger Bounds.
The GUID string the Create presets embed moves with them. Stage 3's components
keep the GUIDs they shipped with.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
---
 .../Module/Functions/AreaFunctionComponent.h               | 7 ++++++-
 .../Module/Functions/TriggerBoundsComponent.h              | 3 ++-
 .../Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.cpp | 2 +-
 .../AreaComponentsEditor/Tools/ShapeDragCreateTool.h       | 4 ++--
 4 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/Code/CryPlugins/AreaComponents/Module/Functions/AreaFunctionComponent.h b/Code/CryPlugins/AreaComponents/Module/Functions/AreaFunctionComponent.h
index 4545889f..59ca5d4a 100644
--- a/Code/CryPlugins/AreaComponents/Module/Functions/AreaFunctionComponent.h
+++ b/Code/CryPlugins/AreaComponents/Module/Functions/AreaFunctionComponent.h
@@ -75,7 +75,12 @@ public:
 
 	static void ReflectType(Schematyc::CTypeDesc<CAreaFunctionComponent>& desc)
 	{
-		desc.SetGUID("{6C3A81D5-0F47-4E9A-B4D1-72E5C8A96210}"_cry_guid);
+		// NOT in the 6C3A81D5-...-9620x series: that one belongs to the SHAPE kinds, and stage 3's
+		// gravity volume took ...96210 there. A duplicate element GUID does not just lose one
+		// component - CEnvRegistry::RegisterPackageElements fails and the WHOLE AreaComponents
+		// package is released, so every shape kind disappears with it. Function components of this
+		// module use the B4E27C09-8A16-4D53-9C70-1F5D3E8A46xx series instead.
+		desc.SetGUID("{B4E27C09-8A16-4D53-9C70-1F5D3E8A4620}"_cry_guid);
 		desc.SetEditorCategory("Area");
 		desc.SetLabel("Area");
 		desc.SetDescription("Turns the shape on this entity into an area: it sends enter/leave/fade events to the entities linked below.");
diff --git a/Code/CryPlugins/AreaComponents/Module/Functions/TriggerBoundsComponent.h b/Code/CryPlugins/AreaComponents/Module/Functions/TriggerBoundsComponent.h
index f9745e3f..a77be948 100644
--- a/Code/CryPlugins/AreaComponents/Module/Functions/TriggerBoundsComponent.h
+++ b/Code/CryPlugins/AreaComponents/Module/Functions/TriggerBoundsComponent.h
@@ -39,7 +39,8 @@ public:
 
 	static void ReflectType(Schematyc::CTypeDesc<CTriggerBoundsComponent>& desc)
 	{
-		desc.SetGUID("{6C3A81D5-0F47-4E9A-B4D1-72E5C8A96211}"_cry_guid);
+		// See the note on CAreaFunctionComponent's GUID: ...96211 belongs to stage 3's distributor.
+		desc.SetGUID("{B4E27C09-8A16-4D53-9C70-1F5D3E8A4621}"_cry_guid);
 		desc.SetEditorCategory("Area");
 		desc.SetLabel("Trigger Bounds");
 		desc.SetDescription("Feeds the shape on this entity to the entity's proximity trigger, so entities crossing it fire enter/leave events.");
diff --git a/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.cpp b/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.cpp
index 9256fee5..15e9136a 100644
--- a/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.cpp
+++ b/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeCreateTool.cpp
@@ -31,7 +31,7 @@ const int kMaxDrawPoints = 1024;
 }
 
 //! CAreaFunctionComponent::ReflectType, CryPlugins/AreaComponents/Module/Functions/AreaFunctionComponent.h.
-const char* const szAreaFunctionComponentGuid = "6C3A81D5-0F47-4E9A-B4D1-72E5C8A96210";
+const char* const szAreaFunctionComponentGuid = "B4E27C09-8A16-4D53-9C70-1F5D3E8A4620";
 
 class CShapeCreateTool_ClassDesc : public IClassDesc
 {
diff --git a/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeDragCreateTool.h b/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeDragCreateTool.h
index 26b8c376..858bd564 100644
--- a/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeDragCreateTool.h
+++ b/Code/Sandbox/Plugins/AreaComponentsEditor/Tools/ShapeDragCreateTool.h
@@ -78,7 +78,7 @@ protected:
 
 	virtual const char* GetObjectClassName() const override        { return "AreaShapeBox"; }
 	//! CAreaFunctionComponent - Create -> Area -> Box makes an AREA, not a bare box.
-	virtual const char* GetFunctionComponentGuid() const override  { return "6C3A81D5-0F47-4E9A-B4D1-72E5C8A96210"; }
+	virtual const char* GetFunctionComponentGuid() const override  { return "B4E27C09-8A16-4D53-9C70-1F5D3E8A4620"; }
 	virtual void        SizeToDrag(const Vec3& anchorWorld, const Vec3& worldPos, bool bDefaultSize) override;
 
 private:
@@ -105,7 +105,7 @@ protected:
 
 	virtual const char* GetObjectClassName() const override        { return "AreaShapeSphere"; }
 	//! CAreaFunctionComponent - Create -> Area -> Sphere makes an AREA, not a bare sphere.
-	virtual const char* GetFunctionComponentGuid() const override  { return "6C3A81D5-0F47-4E9A-B4D1-72E5C8A96210"; }
+	virtual const char* GetFunctionComponentGuid() const override  { return "B4E27C09-8A16-4D53-9C70-1F5D3E8A4620"; }
 	virtual void        SizeToDrag(const Vec3& anchorWorld, const Vec3& worldPos, bool bDefaultSize) override;
 
 private:
