From 36c9c63e16b64518639d75d5f3da40fb00550d47 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Mon, 31 Aug 2026 03:00:40 +0800
Subject: [PATCH 232/307] !F (3DEngine) Allow height-only terrain elevation
 updates.

Treat a null surface-data pointer as a height-only update and preserve the
packed surface type, blend weights and hole flag of every cell. Existing
callers that provide surface data keep their previous behaviour.
---
 Code/CryEngine/Cry3DEngine/terran_edit.cpp    | 82 +++++++++++--------
 .../CryCommon/Cry3DEngine/I3DEngine.h         |  4 +
 2 files changed, 53 insertions(+), 33 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/terran_edit.cpp b/Code/CryEngine/Cry3DEngine/terran_edit.cpp
index c706736c..4c7eb190 100644
--- a/Code/CryEngine/Cry3DEngine/terran_edit.cpp
+++ b/Code/CryEngine/Cry3DEngine/terran_edit.cpp
@@ -186,6 +186,11 @@ void CTerrain::SetTerrainElevation(int X1, int Y1, int nSizeX, int nSizeY, float
 		return;
 	}
 
+	if (!pSurfaceData && GetCVars()->e_TerrainIntegrateObjectsDebug >= 1)
+	{
+		PrintMessage("SetTerrainElevation: heights-only update (%d,%d,%d,%d)", X1, Y1, nSizeX, nSizeY);
+	}
+
 	AABB aabb = Get3DEngine()->m_pObjectsTree->GetNodeBox();
 
 	int x0 = (int)(aabb.min.x * m_fInvUnitSize);
@@ -298,52 +303,63 @@ void CTerrain::SetTerrainElevation(int X1, int Y1, int nSizeX, int nSizeY, float
 
 					uint32 height = ri.fRange ? int((rawHeightmap[nCellLocal] - fMin) / ri.fRange) : 0;
 
-					assert(x >= x0 + X1 && y >= y0 + Y1 && x <= x0 + X1 + nSurfSizeX && y <= y0 + Y1 + nSurfSizeY && pSurfaceData);
-
-					int nSurfX = (x - nSurfOrgX);
-					int nSurfY = (y - nSurfOrgY);
+					SHeightMapItem nNewValue;
+					nNewValue.height = height;
 
-					SSurfaceTypeLocal dst;
+					if (!pSurfaceData)
+					{
+						// Heights-only update: keep this cell's existing packed surface bits
+						// (surface type ids, blend weights and the hole flag) exactly as they are.
+						// The sector palette (ri.pSTPalette) is not touched either, so the local
+						// type ids stay valid by construction.
+						nNewValue.surface = ri.pHMData[nCellLocal].surface;
+					}
+					else
+					{
+						assert(x >= x0 + X1 && y >= y0 + Y1 && x <= x0 + X1 + nSurfSizeX && y <= y0 + Y1 + nSurfSizeY && pSurfaceData);
 
-					assert(nSurfX >= 0 && nSurfY >= 0 && pSurfaceData);
+						int nSurfX = (x - nSurfOrgX);
+						int nSurfY = (y - nSurfOrgY);
 
-					nSurfX = min(nSurfX, nSurfSizeX - 1);
-					nSurfY = min(nSurfY, nSurfSizeY - 1);
+						SSurfaceTypeLocal dst;
 
-					{
-						int nSurfCell = nSurfX * nSurfSizeY + nSurfY;
-						assert(nSurfCell >= 0 && nSurfCell < nSurfSizeX * nSurfSizeY);
+						assert(nSurfX >= 0 && nSurfY >= 0 && pSurfaceData);
 
-						const SSurfaceTypeItem& src = pSurfaceData[nSurfCell];
+						nSurfX = min(nSurfX, nSurfSizeX - 1);
+						nSurfY = min(nSurfY, nSurfSizeY - 1);
 
-						if (src.GetHole())
-						{
-							dst = SRangeInfo::e_index_hole;
-						}
-						else
 						{
-							// read all 3 types, remap to local
-							for (int i = 0; i < SSurfaceTypeLocal::kMaxSurfaceTypesNum; i++)
-							{
-								dst.we[i] = src.we[i] / 16;
+							int nSurfCell = nSurfX * nSurfSizeY + nSurfY;
+							assert(nSurfCell >= 0 && nSurfCell < nSurfSizeX * nSurfSizeY);
+
+							const SSurfaceTypeItem& src = pSurfaceData[nSurfCell];
 
-								if (src.we[i] || !i)
+							if (src.GetHole())
+							{
+								dst = SRangeInfo::e_index_hole;
+							}
+							else
+							{
+								// read all 3 types, remap to local
+								for (int i = 0; i < SSurfaceTypeLocal::kMaxSurfaceTypesNum; i++)
 								{
-									dst.ty[i] = (byte)ri.GetLocalSurfaceTypeID(src.ty[i]);
+									dst.we[i] = src.we[i] / 16;
+
+									if (src.we[i] || !i)
+									{
+										dst.ty[i] = (byte)ri.GetLocalSurfaceTypeID(src.ty[i]);
+									}
 								}
-							}
 
-							dst.we[0] = SATURATEB(15 - dst.we[1] - dst.we[2]);
+								dst.we[0] = SATURATEB(15 - dst.we[1] - dst.we[2]);
+							}
 						}
-					}
-
-					SHeightMapItem nNewValue;
-					nNewValue.height = height;
 
-					// pack SSurfTypeItem into uint32
-					uint32 surface = 0;
-					SSurfaceTypeLocal::EncodeIntoUint32(dst, surface);
-					nNewValue.surface = surface;
+						// pack SSurfTypeItem into uint32
+						uint32 surface = 0;
+						SSurfaceTypeLocal::EncodeIntoUint32(dst, surface);
+						nNewValue.surface = surface;
+					}
 
 					if (nNewValue != ri.pHMData[nCellLocal])
 					{
diff --git a/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h b/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h
index ac86e6d4..57b53a0c 100644
--- a/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h
+++ b/Code/CryEngine/CryCommon/Cry3DEngine/I3DEngine.h
@@ -818,6 +818,10 @@ struct ITerrain
 	//! x1, y1, nSizeX, nSizeY are in terrain units
 	//! pTerrainBlock points to a square 2D array with dimensions GetTerrainSize()
 	//! by default update only elevation.
+	//! pSurfaceData may be nullptr: every touched cell then keeps its existing surface type
+	//! ids, blend weights and hole flag, and only the heights change (nSurfOrgX/Y and
+	//! nSurfSizeX/Y are ignored). Use this for heights-only writes - there is no lossless
+	//! surface read-back, so a read-modify-write round trip would collapse blended weights.
 	virtual void SetTerrainElevation(int x1, int y1, int nSizeX, int nSizeY, float* pTerrainBlock, SSurfaceTypeItem* pSurfaceData, int nSurfOrgX, int nSurfOrgY, int nSurfSizeX, int nSurfSizeY, uint32* pResolMap, int nResolMapSizeX, int nResolMapSizeY) = 0;
 
 	//! Checks if it is possible to paint on the terrain with a given surface type ID.
