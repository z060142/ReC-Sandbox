@@ -530,7 +579,7 @@ float CCinematicCameraComponent::ComputeManualEV100() const
 	const float t = 1.0f / (float)max((int)m_shutterDenominator, 1);
 	const float iso = (float)max((int)m_iso, 1);
 
-	const float ev100 = log2f(N * N / t) - log2f(iso / 100.0f) - (float)m_evCompensation;
+	const float ev100 = log2f(N * N / t) - log2f(iso / 100.0f) - (float)m_evCompensation + (float)(int)m_ndFilterStops;
 	return clamp_tpl(ev100, -6.0f, 24.0f);
 }
 
