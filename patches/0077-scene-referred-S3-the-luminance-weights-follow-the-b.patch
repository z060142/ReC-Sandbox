diff --git a/Engine/Shaders/HWScripts/CryFX/CommonMath.cfi b/Engine/Shaders/HWScripts/CryFX/CommonMath.cfi
index b6046bfb..fa1c05c5 100644
--- a/Engine/Shaders/HWScripts/CryFX/CommonMath.cfi
+++ b/Engine/Shaders/HWScripts/CryFX/CommonMath.cfi
@@ -135,6 +135,32 @@ half GetLuminance( half3 color )
 	return dot( color, GetLuminanceWeights() );
 }
 
+// The luminance weights of the space the HDR TARGET is in - Rec.709 on the stock path, ACEScg
+// (AP1) once the scene-referred working-space conversion has run (SceneReferredSpec.md S3).
+//
+// This is a SEPARATE name and not a switch inside GetLuminanceWeights() on purpose: two thirds of
+// that function's call sites read the G-buffer, do shading-time energy conservation or run after
+// the display transform, and Rec.709 is still the right answer in every one of them. Only the
+// handful of sites that sit between the conversion point and the tone map may move - the
+// exposure meter, the firefly filter in the stable downsample, the tone map's saturation pivot
+// and the lens model's highlight extraction. Getting that classification wrong in either
+// direction is a wrong picture with no error message.
+//
+// A per-view constant rather than a shader permutation: the DOF gather evaluates this inside a
+// 121-tap loop and the firefly filter thirteen times per texel, and a static flag would double
+// the permutation count of every one of those techniques to carry three floats. The value is a
+// DELTA from Rec.709, so a pass that does not bind the per-view buffer still gets Rec.709 rather
+// than zero, and on the stock path the delta is an exact 0.0.
+half3 GetWorkingLuminanceWeights()
+{
+	return GetLuminanceWeights() + (half3)CV_SceneLuminanceWeightsDelta.xyz;
+}
+
+half GetWorkingLuminance( half3 color )
+{
+	return dot( color, GetWorkingLuminanceWeights() );
+}
+
 half3 EncodeColorYCC( half3 col )
 {
 	half3 encodedCol;
