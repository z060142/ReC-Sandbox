 .../docs/SceneReferredExport.md               | 84 +++++++++++++++++++
 2 files changed, 95 insertions(+)

diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp
index 13d34d38..67168c4f 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp
@@ -546,11 +546,22 @@ void CToneMappingStage::Execute()
 
 	if (pExportTex)
 	{
+		// The capture's own GPU cost, named so that it can be MEASURED rather than inferred
+		// (research/s8-perf-and-permutations.md section 2.1). Everything the exporter does on the
+		// GPU is inside this scope: the negative blit when there is one, and EndFrame()'s copy to
+		// the ring's staging resource. The GRADED tap has no marker of its own and cannot have
+		// one - it is an extra SV_Target1 write inside the TONEMAPPING pass above, so its cost
+		// shows up as a widening of TONEMAPPING itself. Read the two together.
+		PROFILE_LABEL_SCOPE("SCENE_REFERRED_EXPORT_TAP");
+
 		// The negative: $HDRTarget as it entered this pass. Nothing in the tone map writes it, so
 		// taking the copy after Execute() is the same frame - and doing it here keeps both taps in
 		// one place instead of scattering the capture across the stage.
 		if (!bExportGraded)
+		{
+			PROFILE_LABEL_SCOPE("SCENE_REFERRED_EXPORT_NEGATIVE");
 			m_passExportNegativeCopy.Execute(m_graphicsPipelineResources.m_pTexHDRTarget, pExportTex);
+		}
 
 		exporter.EndFrame();
 	}
