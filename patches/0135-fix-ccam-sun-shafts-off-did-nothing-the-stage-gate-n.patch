diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SunShafts.h b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SunShafts.h
index 59fa7e75..849880dc 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SunShafts.h
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/SunShafts.h
@@ -17,9 +17,19 @@ public:
 		, m_passShaftsGen0(&graphicsPipeline)
 		, m_passShaftsGen1(&graphicsPipeline) {}
 
+	// The two cvars, ANDed with the Cinematic Camera's suppression request on the post-effect bus
+	// (ReCS 2026-09-09: the screen-space shafts are retired under the camera; volumetric fog is the
+	// god-ray source). Note this gate never read the Time of Day's SunShafts_Active - that param
+	// only reaches the composite through SunShafts_Amount / RaysAmount - which is why pinning it
+	// from the camera did nothing. Every caller of the stage (the half-res downsample decision,
+	// Execute, and the tone map's featureMask / texture bind) goes through here, so one AND covers
+	// the whole chain. Flag 0 = byte-identical to stock.
 	bool IsStageActive(EShaderRenderingFlags flags) const final
 	{
-		return CRenderer::CV_r_sunshafts && CRenderer::CV_r_PostProcess;
+		if (!(CRenderer::CV_r_sunshafts && CRenderer::CV_r_PostProcess))
+			return false;
+		CPostEffectsMgr* pPostMgr = PostEffectMgr();
+		return !(pPostMgr && pPostMgr->GetByNameF("Global_User_SunShaftsSuppressed") > 0.5f);
 	}
 
 	void      Init() final;
diff --git a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.cpp
