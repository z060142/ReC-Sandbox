+++ b/Code/CryEngine/RenderDll/Common/PostProcess/PostProcess.cpp
@@ -472,6 +472,13 @@ int CPostEffectsMgr::Init()
 	AddParamFloatNoTransition("Global_User_MeterBandMean", m_pUserMeterBandMean, 0.0f);
 	AddParamFloatNoTransition("Global_User_MeterHold", m_pUserMeterHold, 0.0f);
 
+	// The Cinematic Camera's "keep the screen-space sun shafts off" request (2026-09-09). The
+	// stage's gate never read the TOD's SunShafts_Active - CSunShaftsStage::IsStageActive is the
+	// two cvars only - so the request needs its own input into that gate. Read by IsStageActive on
