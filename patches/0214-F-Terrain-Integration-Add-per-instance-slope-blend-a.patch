+//////////////////////////////////////////////////////////////////////////
+void CEntity::SetSlotTerrainIntegrationParams(int nSlot, const STerrainIntegrationParams& params)
+{
+	if (CEntitySlot* pSlot = m_render.GetSlot(nSlot))
+	{
+		pSlot->SetTerrainIntegrationParams(params);
+	}
+}
+
+//////////////////////////////////////////////////////////////////////////
+const STerrainIntegrationParams& CEntity::GetSlotTerrainIntegrationParams(int nSlot) const
+{
+	if (CEntitySlot* pSlot = m_render.GetSlot(nSlot))
+	{
+		return pSlot->GetTerrainIntegrationParams();
+	}
+
+	static const STerrainIntegrationParams s_defaultParams;
+	return s_defaultParams;
+}
