 		m_pRenderNode->SetRndFlags(ERF_HIDDEN, !bSlotShouldRender);
 
 		// Update render node location
@@ -618,6 +622,43 @@ void CEntitySlot::GetCameraSpacePos(Vec3& cameraSpacePos)
    }
  */
 
+//////////////////////////////////////////////////////////////////////////
+void CEntitySlot::SetTerrainIntegrationParams(const STerrainIntegrationParams& params)
+{
+	if (m_terrainIntegrationParams == params)
+		return;
+
+	m_terrainIntegrationParams = params;
+
+	ApplyTerrainIntegrationParams();
+}
+
+//////////////////////////////////////////////////////////////////////////
+void CEntitySlot::ApplyTerrainIntegrationParams()
+{
+	// Only eERType_MovableBrush nodes are picked up by CTerrainNode::AppendTrianglesFromObjects.
+	if (!m_pRenderNode || m_renderNodeType != eERType_MovableBrush)
+		return;
+
+	IBrush* pBrush = static_cast<IBrush*>(m_pRenderNode);
+
+	if (pBrush->GetTerrainIntegrationParams() == m_terrainIntegrationParams)
+		return;
+
+	pBrush->SetTerrainIntegrationParams(m_terrainIntegrationParams);
+
+	// The terrain sector meshes hold a classified copy of the geometry of every integrating node, so
+	// changing the classification parameters has to invalidate the sectors the node covers.
+	if (m_pRenderNode->GetGIMode() == IRenderNode::eGM_IntegrateIntoTerrain)
+	{
+		if (ITerrain* pTerrain = gEnv->p3DEngine ? gEnv->p3DEngine->GetITerrain() : nullptr)
+		{
+			AABB nodeBox = m_pRenderNode->GetBBox();
+			pTerrain->ResetTerrainVertBuffers(&nodeBox);
+		}
+	}
+}
+
