diff --git a/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx b/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx
index 75cdf004..2da6eb26 100644
--- a/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx
+++ b/Engine/Shaders/HWScripts/CryFX/HDRPostProcess.cfx
@@ -855,7 +855,10 @@ half ComputeExposure(float fIlluminance)
 // OLD meanings and a debug readout that lies is worse than six float4s.
 ////////////////////////////////////////////////////////////////////////////////////////////////////////////
 
-float4 SceneWBRow0;      // Bradford white-balance matrix, in the working space (AP1). Row 0. .w unused.
+float4 SceneWBRow0;      // Bradford white-balance matrix, in the working space (AP1). Row 0.
+                         // .w = the sensor's saturation level in LINEAR working-space units
+                         //      (0.18 * 2^N), 0 = no clip. It rides here because the clip happens
+                         //      immediately after this matrix; see FilmMapping step 1b.
 float4 SceneWBRow1;      // Row 1. .w unused.
 float4 SceneWBRow2;      // Row 2. .w unused.
 float4 SceneCDLSlope;    // ASC CDL slope.rgb, .w = saturation (1 = neutral)
@@ -913,6 +916,28 @@ half3 FilmMapping( in vert2frag IN, in half3 cScene, in half3 cBloom, in half3 v
 	//    and not by approximation. Scene-linear in, scene-linear out.
 	cColor = mul(float3x3(SceneWBRow0.xyz, SceneWBRow1.xyz, SceneWBRow2.xyz), cColor);
 
+	// 1b. SENSOR SATURATION - the full well (decisions/s8-sensor-clip.md).
+	//
+	//     Every RAW converter clips the highlights per channel at ONE common level and does it
+	//     AFTER the white-balance gains, for one reason: the gains are per channel, so a neutral
+	//     highlight that was already clipped comes out of them tinted by the inverse of the
+	//     illuminant - which is exactly the "white balance 5600 -> 3200 K turns the clipped sky
+	//     blue" report. Clipped here, at a level the three channels share, a clipped neutral
+	//     stays neutral at every colour temperature, and only the highlights that were NOT
+	//     clipped take the WB's colour, which is what a camera does.
+	//
+	//     This is the SENSOR, not the lens. Everything upstream - bloom, glare, diffraction,
+	//     depth of field - runs on the unclipped radiance on purpose: the lens sees the light
+	//     that is really there, and a sun a hundred thousand times over the clip level must
+	//     still throw a hundred-thousand-times flare. The clip is the last thing before the
+	//     grading space because it is the last thing before the picture becomes a picture.
+	//
+	//     0 = off, which is what the stock path and an unpublishing camera read, so the branch
+	//     folds away and nothing changes. Negatives are left alone (min, not clamp): they are
+	//     legal AP1 values and the ODT's own domain handling owns them.
+	if (SceneWBRow0.w > 0.0)
+		cColor = min(cColor, (half3)SceneWBRow0.w);
+
 	// 2. Linear ACEScg -> ACEScct. The grading space, the LUT domain and the shaper are all the
 	//    same encoding, so this happens once and everything downstream is log.
 	float3 cGrade = LinearToACEScct((float3)cColor);
@@ -940,6 +965,10 @@ half3 FilmMapping( in vert2frag IN, in half3 cScene, in half3 cBloom, in half3 v
 	// written to EXR": everything the camera does (WB, CDL, LMT, and the composites before them)
 	// has happened, and nothing that knows about a display has.
 	//
+	// The clip of step 1b is upstream of this point, so the tap carries it too - the EXR is a
+	// file of what the SENSOR recorded, and a capture whose highlights ran past the full well
+	// would not match the picture the ODT shows. There is deliberately no second clip here.
+	//
 	// The inverse shaper is NOT an operator being undone - the ACEScct encode belongs to the ODT
 	// LUT's input domain, not to the grade. An EXR of the log value would be a file no ACES tool
 	// could interpret without being told about our private shaper, and the D12 round trip
