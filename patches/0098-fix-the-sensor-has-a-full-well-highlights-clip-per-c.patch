 	}
 
 	bool bEnableExposure = false;
@@ -438,6 +446,7 @@ struct SCineExposureParams
 	Schematyc::Range<0, 10, 0, 5> autoTau = 1.0f;
 	Schematyc::Range<-6, 24, -6, 24> autoEVMin = -2.0f;
 	Schematyc::Range<-6, 24, -6, 24> autoEVMax = 20.0f;
+	Schematyc::Range<8, 20, 8, 20> sensorClipStops = 14.0f;
 };
 
 struct SCineDofParams
@@ -1322,6 +1331,9 @@ private:
 	// Pre-exposure saved state (Global_User_SceneExposure post param). Same story: unknown to an
 	// unmodified renderer. The neutral value is 1.0, not 0.
 	float m_savedSceneExposure  = 1.f;
+	// The sensor clip travels with the pre-exposure (same Apply/Restore, same saved flag): it is
+	// the other half of "what the sensor did with the light", and it is meaningless without it.
+	float m_savedSensorClipStops = 0.f;
