+// The glare's GPU time, so the report can print what the population COSTS next to how big it is.
+//
+// The pass already carries PROFILE_LABEL_SCOPE markers ("HDR_DIFFRACTION", with the budget chain
+// nested inside it, and "HDR_DIFFRACTION_COMPOSITE"), and the render pipeline profiler times every
+// labelled section with GPU timestamps and publishes them as detailed stats, keyed by that same
+// label. So there is nothing to instrument: this looks the two sections up by name.
+//
+// What it cannot do is turn the profiler ON. Recording costs a timestamp pair per section for the
+// whole frame, and CRenderPipelineProfiler::IsEnabled() is driven by r_profiler and r_DisplayInfo 3
+// - engine-wide switches that are not this debug mode's to flip. When it is off the array is empty
+// and the fields stay negative; the report then says which cvar to set instead of printing a zero
+// that would read as "free".
+void CBloomStage::SampleDiffractionGpuTimes(SDiffractionReport& report)
+{
+	report.fGlareGpuMs = -1.0f;
+	report.fCompositeGpuMs = -1.0f;
+
+	if (gcpRendD3D == nullptr)
+		return;
+
+	// false = the RENDER thread's array, which is the thread this stage executes on and the one
+	// the profiler writes its resolved sections into.
+	const DynArray<RPProfilerDetailedStats>* pStats = gcpRendD3D->GetRPPDetailedStatsArray(false);
+	if (pStats == nullptr)
+		return;
+
+	for (const RPProfilerDetailedStats& stat : *pStats)
+	{
+		// The smoothed time, not the instantaneous one: a once-a-second line made of a single
+		// frame's timestamps jitters by more than the difference the user is trying to read.
+		if (strcmp(stat.name, "HDR_DIFFRACTION") == 0)
+			report.fGlareGpuMs = stat.gpuTimeSmoothed;
+		else if (strcmp(stat.name, "HDR_DIFFRACTION_COMPOSITE") == 0)
+			report.fCompositeGpuMs = stat.gpuTimeSmoothed;
+	}
+}
