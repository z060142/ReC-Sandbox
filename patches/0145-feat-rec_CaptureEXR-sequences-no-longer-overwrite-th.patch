index a8da8f38..ed7067b4 100644
--- a/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
+++ b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
@@ -426,6 +426,7 @@ float CRendererCVars::CV_r_SceneReferredWriterClamp;
 int CRendererCVars::CV_r_SceneReferredMeterHistogram;
 int CRendererCVars::CV_r_SceneReferredExrSelfTest;
 int CRendererCVars::CV_r_SceneReferredExportTap;
+int CRendererCVars::CV_r_SceneReferredExportSequenceNaming;
 int CRendererCVars::CV_r_SceneReferredExportEncoding;
 int CRendererCVars::CV_r_SceneReferredExportCompression;
 float CRendererCVars::CV_r_SceneReferredExportFixedStep;
@@ -1896,6 +1897,15 @@ void CRendererCVars::InitCVars()
 	               "estimate, kept as the A/B reference and as the fallback if the compute pass "
 	               "ever misbehaves. On 0 the camera's Metering Mode and metering band do nothing "
 	               "and the meter's own 14-stop ceiling is back in force.");
+	REGISTER_CVAR3("r_SceneReferredExportSequenceNaming", CV_r_SceneReferredExportSequenceNaming, 1, VF_NULL,
+	               "How a SEQUENCE started by rec_CaptureEXR is numbered and named (single frames from "
+	               "rec_CaptureEXRFrame always continue from the first free number on disk). "
+	               "0 = restart at 000000 on every arm - the original behaviour; a second sequence into the "
+	               "same folder and prefix overwrites the first. "
+	               "1 = CONTINUE (default): start at the first free <prefix>.%06d.exr in that folder, so "
+	               "nothing already on disk is overwritten and repeated takes number on. "
+	               "2 = TIMESTAMP: the prefix becomes <prefix>_YYYYMMDD_HHMMSS and numbering starts at "
+	               "000000 - one folder, one sub-name per take.");
 	REGISTER_CVAR3("r_SceneReferredExportTap", CV_r_SceneReferredExportTap, 0, VF_NULL,
 	               "WHICH frame rec_CaptureEXR writes. "
 	               "0 = GRADED (default): the value HDRFinalPass has right before the output "
diff --git a/Code/CryEngine/RenderDll/Common/RendererCVars.h b/Code/CryEngine/RenderDll/Common/RendererCVars.h
