+////////////////////////////////////////////////////////////////////////////////////////////////////////////
+// The scene-referred display chain (SceneReferredSpec.md S4/S5, D8, D9, D10).
+//
+// Its own constant block: HDRMiscParams and HDREyeAdaptation are both unread on this branch and
+// could have carried these numbers, but CToneMappingStage::DisplayDebugInfo() still prints their
+// OLD meanings and a debug readout that lies is worse than six float4s.
+////////////////////////////////////////////////////////////////////////////////////////////////////////////
+
+float4 SceneWBRow0;      // Bradford white-balance matrix, in the working space (AP1). Row 0. .w unused.
+float4 SceneWBRow1;      // Row 1. .w unused.
+float4 SceneWBRow2;      // Row 2. .w unused.
+float4 SceneCDLSlope;    // ASC CDL slope.rgb, .w = saturation (1 = neutral)
+float4 SceneCDLOffset;   // ASC CDL offset.rgb, .w = LMT grid size N (0 = no look loaded)
+float4 SceneCDLPower;    // ASC CDL power.rgb, .w = ODT grid size N (0 = no output transform loaded)
+
+Texture3D<float4> lmtTex : register(t3);   // creative look, ACEScct in / ACEScct out
+Texture3D<float4> odtTex : register(t4);   // output transform, ACEScct in / display-encoded out
+SamplerState linearClamp3DSS : register(s1);
+
+// The standard half-texel inset for an N^3 grid: the first and last samples sit at the CENTRES
+// of the outer texels, so the usable range is [0.5/N, 1 - 0.5/N] and an input of 0..1 has to be
+// mapped onto it. Exactly the correction TexColorChart2D makes for its unwrapped strip, one
+// dimension up. Getting it wrong is a small, uniform, entirely invisible error - which is why it
+// is spelled out here instead of being folded into the call.
+float3 SampleLut3D(Texture3D<float4> lut, SamplerState ss, float3 c, float fGridSize)
+{
+	const float fScale = (fGridSize - 1.0) / fGridSize;
+	const float fBias  = 0.5 / fGridSize;
+	return lut.SampleLevel(ss, saturate(c) * fScale + fBias, 0).rgb;
+}
