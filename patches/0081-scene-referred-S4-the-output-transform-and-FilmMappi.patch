+	//    hidden ReC look": with nothing loaded the picture is pure ACES.
+	if (SceneCDLOffset.w > 1.5)
+		cGrade = SampleLut3D(lmtTex, linearClamp3DSS, cGrade, SceneCDLOffset.w);
+
+	// 5. The output transform (ODT), ACEScct in and DISPLAY-ENCODED [0,1] out. The back buffer
+	//    is R8G8B8A8_UNORM and is not sRGB-typed, so the encode has to be inside this LUT; the
+	//    engine's own sRGB curve at the end of the stock branch is what it replaces.
+	//
+	//    With no ODT loaded the picture is deliberately, visibly wrong - the log image, clamped
+	//    - instead of quietly falling back to the film curve. A wrong picture that cannot be
+	//    mistaken for a correct one is what D13 asks for.
+	if (SceneCDLPower.w > 1.5)
+		return (half3)SampleLut3D(odtTex, linearClamp3DSS, cGrade, SceneCDLPower.w);
+
+	return (half3)saturate(cGrade);
+
+#else
+
