+// ---------------------------------------------------------------------------
+// The camera stage's white balance (SceneReferredSpec.md S5).
+//
+// WB is the CAMERA'S SETTING, not a description of the scene: the scene is lit at whatever it is
+// lit at, and the camera is told what to call white. So the transform is a chromatic adaptation
+// FROM the temperature the camera is set to TOWARDS the neutral setting - which is why 3200 K in
+// daylight comes out blue and 8000 K comes out warm, exactly as a stills camera does.
+//
+// The neutral is 6500 K + tint 0 evaluated through THIS SAME locus, not a tabulated D65. That
+// makes the neutral setting an exact identity by construction (source white == destination white
+// -> the adaptation is the identity matrix to the last bit) instead of an identity to six
+// decimals, which is what "6500 = no-op" has to mean if the switch is to be provable.
+//
+// CCT -> xy is Kim et al.'s cubic fit to the Planckian locus (1667..25000 K), the formula
+// Resolve, Nuke and every camera pipeline use. Tint is a Duv offset perpendicular to the locus
+// in the CIE 1960 UCS, the space Duv is defined in; positive tint is magenta (below the locus),
+// negative is green, matching the sign convention of every grading tool.
+// ---------------------------------------------------------------------------
+namespace
+{
+
+//! AP1 (ACEScg primaries) -> CIE XYZ with the ACES D60 white. Verified against PyOpenColorIO
+//! 2.5 by tools/ocio-bake/verify_matrices.py; the same numbers CommonMath.cfi carries.
+static const Matrix33 kAP1ToXYZ(
+	0.66245418f, 0.13400421f, 0.15618769f,
+	0.27222872f, 0.67408177f, 0.05368952f,
+	-0.00557465f, 0.00406073f, 1.01033910f);
+
+//! Bradford cone response, the chromatic adaptation transform D5 names.
+static const Matrix33 kBradford(
+	0.8951f, 0.2664f, -0.1614f,
+	-0.7502f, 1.7135f, 0.0367f,
+	0.0389f, -0.0685f, 1.0296f);
+
+//! Kim et al. (2002) cubic fit to the Planckian locus.
+static Vec2 CCTToXY(float kelvin)
+{
+	const float T = clamp_tpl(kelvin, 1667.0f, 25000.0f);
+	const float invT = 1.0f / T;
+	const float invT2 = invT * invT;
+	const float invT3 = invT2 * invT;
+
+	const float x = (T <= 4000.0f)
+		? (-0.2661239e9f * invT3 - 0.2343589e6f * invT2 + 0.8776956e3f * invT + 0.179910f)
+		: (-3.0258469e9f * invT3 + 2.1070379e6f * invT2 + 0.2226347e3f * invT + 0.240390f);
+
+	const float x2 = x * x;
+	const float x3 = x2 * x;
+
+	float y;
+	if (T <= 2222.0f)
+		y = -1.1063814f * x3 - 1.34811020f * x2 + 2.18555832f * x - 0.20219683f;
+	else if (T <= 4000.0f)
+		y = -0.9549476f * x3 - 1.37418593f * x2 + 2.09137015f * x - 0.16748867f;
+	else
+		y = 3.0817580f * x3 - 5.87338670f * x2 + 3.75112997f * x - 0.37001483f;
+
+	return Vec2(x, y);
+}
+
+static Vec2 XYToUV1960(const Vec2& xy)
+{
+	const float d = -2.0f * xy.x + 12.0f * xy.y + 3.0f;
+	return Vec2(4.0f * xy.x / d, 6.0f * xy.y / d);
+}
+
+static Vec2 UV1960ToXY(const Vec2& uv)
+{
+	const float d = 2.0f * uv.x - 8.0f * uv.y + 4.0f;
+	return Vec2(3.0f * uv.x / d, 2.0f * uv.y / d);
+}
+
+//! The white point for a (Kelvin, tint) camera setting, as XYZ normalised to Y = 1.
+//! tint is -1..1; full scale is a Duv of 0.03, which is far past anything a shoot uses and
+//! still short of leaving the region the locus fit is valid in.
+static Vec3 CameraWhiteXYZ(float kelvin, float tint)
+{
+	Vec2 xy = CCTToXY(kelvin);
+
+	if (fabsf(tint) > 1e-6f)
+	{
+		// The normal to the locus, taken from a finite difference along it. Duv is signed
+		// positive ABOVE the locus (green); the tint control is signed positive toward magenta,
+		// hence the minus.
+		const Vec2 uv0 = XYToUV1960(CCTToXY(kelvin * 0.999f));
+		const Vec2 uv1 = XYToUV1960(CCTToXY(kelvin * 1.001f));
+		Vec2 tangent(uv1.x - uv0.x, uv1.y - uv0.y);
+		const float len = sqrtf(tangent.x * tangent.x + tangent.y * tangent.y);
+		if (len > 1e-9f)
+		{
+			tangent.x /= len;
+			tangent.y /= len;
+			const Vec2 normal(-tangent.y, tangent.x);
+			Vec2 uv = XYToUV1960(xy);
+			uv.x += normal.x * (-0.03f * tint);
+			uv.y += normal.y * (-0.03f * tint);
+			xy = UV1960ToXY(uv);
+		}
+	}
+
+	const float y = max(xy.y, 1e-6f);
+	return Vec3(xy.x / y, 1.0f, (1.0f - xy.x - xy.y) / y);
+}
+
+//! The Bradford adaptation from white src to white dst, expressed in the working space (AP1).
+//! Returns the identity when the two whites coincide, which is what makes the neutral setting a
+//! true no-op rather than a near-one.
+static Matrix33 ResolveWhiteBalanceMatrix(float kelvin, float tint, bool bEnabled)
+{
+	Matrix33 identity;
+	identity.SetIdentity();
+
+	if (!bEnabled)
+		return identity;
+
+	const Vec3 src = CameraWhiteXYZ(kelvin, tint);
+	const Vec3 dst = CameraWhiteXYZ(6500.0f, 0.0f);
+
+	if (src.IsEquivalent(dst, 1e-9f))
+		return identity;
+
+	const Vec3 coneSrc = kBradford * src;
+	const Vec3 coneDst = kBradford * dst;
+
+	Matrix33 scale;
+	scale.SetIdentity();
+	scale.m00 = coneDst.x / max(coneSrc.x, 1e-9f);
+	scale.m11 = coneDst.y / max(coneSrc.y, 1e-9f);
+	scale.m22 = coneDst.z / max(coneSrc.z, 1e-9f);
+
+	const Matrix33 catXYZ = kBradford.GetInverted() * scale * kBradford;
+
+	// XYZ in, XYZ out; the shader multiplies AP1 values, so the adaptation is conjugated by the
+	// primaries matrix. AP1 (1,1,1) is preserved exactly at the neutral setting because the
+	// adaptation itself is the identity there, whatever the primaries.
+	return kAP1ToXYZ.GetInverted() * catXYZ * kAP1ToXYZ;
+}
+
