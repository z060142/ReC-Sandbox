 {
+#if %_RT_SAMPLE0
+
+	// ------------------------------------------------------------------------------------
+	// The scene-referred branch. Nothing in here knows what a display is except the last
+	// fetch, which IS the display transform.
+	//
+	// Whole-body #if rather than an #if inside the function on purpose: ComputeExposure() is
+	// called unconditionally on the stock path, and leaving it above the branch would keep
+	// evaluating the EV formula and reading the luminance texture for a value this path throws
+	// away. The exposure here is exactly 1.0 - S1 applied it on the light side, so the HDR
+	// target arrives already exposed and applying any of it again would expose the frame twice.
+	//
+	// Shared with the stock path and deliberately UNCHANGED: the vignette scalar (a lens
+	// transmission, already in the right place - it multiplies scene-linear light) and the bloom
+	// composite (its form is a look question that belongs with the S7 re-thresholding, not here).
+	// ------------------------------------------------------------------------------------
+	half3 cColor = fVignetting * lerp(cScene, cBloom, saturate(HDRBloomColor));
+
+	// 1. White balance. A Bradford chromatic adaptation from the temperature the CAMERA is set
+	//    to towards the neutral setting, expressed as a 3x3 in the working space and computed on
+	//    the CPU (CToneMappingStage::ResolveWhiteBalanceMatrix). Exactly identity when white
+	//    balance is off or at the neutral setting, so this multiply is a no-op by construction
+	//    and not by approximation. Scene-linear in, scene-linear out.
+	cColor = mul(float3x3(SceneWBRow0.xyz, SceneWBRow1.xyz, SceneWBRow2.xyz), cColor);
+
+	// 2. Linear ACEScg -> ACEScct. The grading space, the LUT domain and the shaper are all the
+	//    same encoding, so this happens once and everything downstream is log.
+	float3 cGrade = LinearToACEScct((float3)cColor);
+
+	// 3. ASC CDL, in the order the ASC specification fixes:
+	//        out = (in * slope + offset) ^ power
+	//    with the power applied to the clamped result (the spec's "negative values are clamped
+	//    to zero before the power function"), per channel and with no cross-channel term.
+	//    Saturation is the ASC's own extension and comes AFTER the SOP, about the luminance of
+	//    the already-graded value - and the luminance weights are AP1's, because that is the
+	//    space this is happening in. Using Rec.709 weights on AP1 data is the classic silent
+	//    failure: the picture is wrong and nothing reports it.
+	cGrade = cGrade * SceneCDLSlope.rgb + SceneCDLOffset.rgb;
+	cGrade = pow(max(cGrade, 0.0), SceneCDLPower.rgb);
+	const float fGradeLuma = dot(cGrade, ACESCG_LUMINANCE_WEIGHTS);
+	cGrade = fGradeLuma + SceneCDLSlope.w * (cGrade - fGradeLuma);
+
