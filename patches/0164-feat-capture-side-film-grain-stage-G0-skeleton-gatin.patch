+		grainDigital0Vec = PostEffectMgr()->GetByNameVec4("Grain_User_Digital0");
+		grainDigital1Vec = PostEffectMgr()->GetByNameVec4("Grain_User_Digital1");
+		grainFamily      = (int)(PostEffectMgr()->GetByNameF("Grain_User_Family") + 0.5f);
