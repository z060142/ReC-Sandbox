+	                                 && PostEffectMgr()->GetByNameF("Grain_User_Active") >= 0.5f;
+
+	Vec4 grainAmountVec(ZERO), grainSizeVec(ZERO), grainSensorVec(ZERO), grainSeedVec(ZERO);
+	Vec4 grainDigital0Vec(ZERO), grainDigital1Vec(ZERO);
