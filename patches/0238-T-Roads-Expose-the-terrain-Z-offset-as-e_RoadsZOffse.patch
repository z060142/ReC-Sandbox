From 95c9756c6393df22b99c3ba0e3da8bb7315c27dc Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Mon, 31 Aug 2026 09:58:39 +0800
Subject: [PATCH 238/307] !T (Roads) Expose the terrain Z offset as
 e_RoadsZOffset.

Replace the hard-coded road elevation margin with e_RoadsZOffset. Its default
keeps the existing placement while allowing additional clearance where terrain
height quantization would otherwise consume the margin.
---
 Code/CryEngine/Cry3DEngine/RoadRenderNode.cpp | 11 +++++++++--
 Code/CryEngine/Cry3DEngine/cvars.cpp          |  9 +++++++++
 Code/CryEngine/Cry3DEngine/cvars.h            |  1 +
 3 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/RoadRenderNode.cpp b/Code/CryEngine/Cry3DEngine/RoadRenderNode.cpp
index d2404541..6a7215f9 100644
--- a/Code/CryEngine/Cry3DEngine/RoadRenderNode.cpp
+++ b/Code/CryEngine/Cry3DEngine/RoadRenderNode.cpp
@@ -482,9 +482,16 @@ void CRoadRenderNode::Render(const SRendParams& RendParams, const SRenderingPass
 	if (!passInfo.RenderRoads())
 		return; // false;
 
-	// Prepare object model matrix
+	// Prepare object model matrix.
+	// The road mesh is built on the terrain heightmap grid at the exact terrain height
+	// (Compile(), GetTerrain()->GetZ), so this translation is the road's whole depth margin: it is
+	// drawn in EFSLIST_DECAL with GS_DEPTHFUNC_LEQUAL and no depth write (SceneGBuffer.cpp:124-144),
+	// and loses to anything the G-buffer put above the terrain surface. Kept as a cvar because a
+	// Terrain Plate mesh stands e_TerrainPlateBakeEpsilon above the terrain it baked, and on a sector
+	// with a large height range the 12 bit height quantisation can eat the difference.
+	// e_RoadsZOffset defaults to 0.01, the stock constant, so the native path is unchanged.
 	Vec3 vWSBoxCenter = m_serializedData.worldSpaceBBox.GetCenter();
-	vWSBoxCenter.z += 0.01f;
+	vWSBoxCenter.z += max(0.f, GetCVars()->e_RoadsZOffset);
 	const auto objMat = Matrix34::CreateTranslationMat(vWSBoxCenter);
 
 	CRenderObject* pObj = nullptr;
diff --git a/Code/CryEngine/Cry3DEngine/cvars.cpp b/Code/CryEngine/Cry3DEngine/cvars.cpp
index ca25ddc8..c1f4a2ac 100644
--- a/Code/CryEngine/Cry3DEngine/cvars.cpp
+++ b/Code/CryEngine/Cry3DEngine/cvars.cpp
@@ -293,6 +293,15 @@ void CVars::Init()
 	DefineConstIntCVar(e_Roads, 1, VF_CHEAT | VF_CHEAT_ALWAYS_CHECK,
 	                   "Activates drawing of road objects");
 
+	REGISTER_CVAR(e_RoadsZOffset, 0.01f, VF_NULL,
+	              "Height in metres a road render node is lifted above the terrain surface it was built on.\n"
+	              "0.01 is the engine default and the value every stock level was authored with. A road is an\n"
+	              "overlay in EFSLIST_DECAL: it does not write depth, so this offset is the whole margin it has\n"
+	              "to win the depth test against anything else standing on the same ground - in particular a\n"
+	              "Terrain Plate mesh, which sits e_TerrainPlateBakeEpsilon above the terrain it baked.\n"
+	              "Raise it (0.03 is usually enough) if roads disappear under a baked plate on a sector with a\n"
+	              "large height range, where the 12 bit height quantisation eats the margin.");
+
 	REGISTER_CVAR(e_Decals, 1, VF_NULL | VF_CHEAT_ALWAYS_CHECK,
 	              "Activates drawing of decals (game decals and hand-placed)");
 	REGISTER_CVAR(e_DecalsForceDeferred, 0, VF_NULL,
diff --git a/Code/CryEngine/Cry3DEngine/cvars.h b/Code/CryEngine/Cry3DEngine/cvars.h
index 35b672f2..c91003c8 100644
--- a/Code/CryEngine/Cry3DEngine/cvars.h
+++ b/Code/CryEngine/Cry3DEngine/cvars.h
@@ -306,6 +306,7 @@ struct CVars : public Cry3DEngineBase
 	int   e_TerrainEditPostponeTexturesUpdate;
 	int   e_DecalsDeferredStatic;
 	DeclareConstIntCVar(e_Roads, 1);
+	float e_RoadsZOffset;
 	float e_TerrainDetailMaterialsViewDistXY;
 	int   e_ParticlesQuality;
 	DeclareConstIntCVar(e_DebugDrawShowOnlyCompound, 0);
