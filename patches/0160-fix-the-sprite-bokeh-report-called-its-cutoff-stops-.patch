@@ -1143,7 +1143,7 @@ CTexture* CDepthOfFieldStage::ExecuteSpriteBudget(const SDepthOfFieldParams& dof
 	if (!bSplat)
 	{
 		ReleaseSpriteBudgetTargets();
-		UpdateSpriteBudgetReport(0, 0, 0, 0, 0, false);
+		UpdateSpriteBudgetReport(0, 0, 0, 0, 0, false, 0.0f);
 		return nullptr;
 	}
 
@@ -1303,7 +1303,9 @@ CTexture* CDepthOfFieldStage::ExecuteSpriteBudget(const SDepthOfFieldParams& dof
 	m_passSpriteBudget.SetConstant(spriteBudgetNName, Vec4((float)nBudget, 0.0f, 0.0f, 0.0f), eHWSC_Pixel);
 	m_passSpriteBudget.Execute();
 
-	UpdateSpriteBudgetReport(nDebugMode, nRequestedBudget, nBudget, nGridW, nGridH, true);
+	// vDownscaleHighlight.x is the highlight threshold this frame's weight pass ranked against; the
+	// report needs it to turn the cutoff (a number in EXCESS over that threshold) into a brightness.
+	UpdateSpriteBudgetReport(nDebugMode, nRequestedBudget, nBudget, nGridW, nGridH, true, vDownscaleHighlight.x);
 
 	return m_pTexSpriteWeight;
 }
@@ -1390,7 +1392,7 @@ void CDepthOfFieldStage::ReleaseSpriteBudgetTargets()
 // on and says so rather than printing a zero that would read as "free".
 //////////////////////////////////////////////////////////////////////////////////////////////////
 void CDepthOfFieldStage::UpdateSpriteBudgetReport(int nDebugMode, int nRequestedBudget, int nBudget,
-                                                  int nGridW, int nGridH, bool bInForce)
+                                                  int nGridW, int nGridH, bool bInForce, float fThreshold)
 {
 	const bool bWantReport = (nDebugMode == 2 || nDebugMode == 3) && bInForce;
 
@@ -1482,15 +1484,45 @@ void CDepthOfFieldStage::UpdateSpriteBudgetReport(int nDebugMode, int nRequested
 		const float fSpriteCapPx = max(CRenderer::CV_r_DofLensModelSplatMaxCoC, 1.0f);
 
 		CryLog("[DOF] ---- sprite bokeh sources, once a second (r_DepthOfFieldSpriteBokehDebug 2) ----");
-		CryLog("[DOF]   SOURCES: raw above the highlight threshold = %.0f of the %d x %d grid"
-		       " -- one sprite each, up to %.0f x %.0f native px per sprite (r_DepthOfFieldLensModelSplatMaxCoC)",
+		// fRaw counts the cells the SPLAT would draw with no budget in force: over the highlight
+		// threshold AND past the sprite's own two culls (a disc at least a pixel across, and the
+		// fade). It is not the plain "over the threshold" count, which is larger.
+		CryLog("[DOF]   SOURCES: raw sources = %.0f of the %d x %d grid (over the highlight threshold, disc"
+		       " at least a pixel across, faded in) -- one sprite each with no budget, up to %.0f x %.0f"
+		       " native px per sprite (r_DepthOfFieldLensModelSplatMaxCoC)",
 		       fRaw, nGridW, nGridH, fSpriteCapPx, fSpriteCapPx);
+		// WHAT THE CUTOFF ACTUALLY IS. The controller ranks cells by PRIORITY = the cell's EXCESS
+		// over the highlight threshold (LensHighlightExcess: working luminance MINUS the threshold,
+		// soft-kneed) x the sprite's own fade x the sky weight, and the cutoff is a value on that
+		// scale. It is therefore NOT an absolute luminance, and the first build's "= %+.1f stops
+		// over mid grey" read a perfectly healthy frame back as "-6.7 stops over mid grey" - a
+		// threshold that is itself +2 stops over grey cannot possibly select anything below grey.
+		// The excess is in the frame's own working (scene-linear) units, pre-exposed on the
+		// scene-referred path, so its own magnitude means nothing on its own.
+		//
+		// What IS meaningful is the BRIGHTNESS the cutoff stands for: a cell fully faded in and not
+		// in the sky keeps a shape from threshold + cutoff upwards, and reaches its full shape at
+		// threshold + 2 x cutoff (the weight pass crossfades over one doubling of the cutoff). That
+		// one is worth stating in the stops over mid grey the Highlight Threshold is authored in.
+		// fThreshold is THIS frame's while the stats are a frame or two old, so under a moving
+		// exposure the last digits drift - not worth a history buffer for a once-a-second report.
 		CryLog("[DOF]            budget %d (r_DepthOfFieldSpriteBokehMaxSources): %.0f drew a shaped disc,"
-		       " cutoff %.4g = %+.1f stops over mid grey -- the other %.0f kept their LIGHT (%.1f%% of the"
-		       " source excess, handed back to the GATHER and blurred there) and lost their shape",
+		       " cutoff %.4g of EXCESS over the highlight threshold (scene-linear, the same weight the"
+		       " controller ranks by, NOT an absolute luminance) -- the other %.0f kept their LIGHT (%.1f%%"
+		       " of the source excess, handed back to the GATHER and blurred there) and lost their shape",
 		       nBudget, fDrawn, fCutoff,
-		       (fCutoff > 1e-12f) ? (logf(fCutoff / fReportGrey) * fInvLn2) : -99.0f,
 		       max(fRaw - fDrawn, 0.0f), fResidualFrac * 100.0f);
+		if (fCutoff > 0.0f && fThreshold > 0.0f)
+		{
+			CryLog("[DOF]            in picture terms: the highlight threshold is %.4g (%+.2f stops over mid"
+			       " grey), so a cell keeps a shape from %.4g (%+.3f stops) and has its full shape from %.4g"
+			       " (%+.3f stops) - a %.3f stop band at the bottom of the population, inside which a cell"
+			       " draws a partly faded shape and leaves the rest of its excess in the gather",
+			       fThreshold, logf(fThreshold / fReportGrey) * fInvLn2,
+			       fThreshold + fCutoff, logf((fThreshold + fCutoff) / fReportGrey) * fInvLn2,
+			       fThreshold + 2.0f * fCutoff, logf((fThreshold + 2.0f * fCutoff) / fReportGrey) * fInvLn2,
+			       logf((fThreshold + 2.0f * fCutoff) / (fThreshold + fCutoff)) * fInvLn2);
+		}
 		if (fCutoff <= 0.0f)
 		{
 			CryLog("[DOF]            cutoff 0 = the budget is NOT binding: the whole population fits, and both"
@@ -1525,7 +1557,8 @@ void CDepthOfFieldStage::UpdateSpriteBudgetReport(int nDebugMode, int nRequested
 		if (fMidGrey <= 0.0f)
 		{
 			CryLog("[DOF]            NOTE: the stock path's mid grey is not measured this frame, so the"
-			       " highlight threshold is being read as an ABSOLUTE value and the stops above are nominal");
+			       " highlight threshold is being read as an ABSOLUTE value and the stops on the picture"
+			       " terms line are nominal (the cutoff and the counts are unaffected)");
 		}
 		return;
 	}
