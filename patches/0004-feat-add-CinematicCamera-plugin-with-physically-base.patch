@@ -0,0 +1,77 @@
+#include "StdAfx.h"
+#include "CinematicCameraPlugin.h"
+#include "CinematicCameraComponent.h"
+
+#include <CrySchematyc/Env/IEnvRegistry.h>
+#include <CrySchematyc/Env/EnvPackage.h>
+#include <CrySchematyc/Utils/SharedString.h>
+#include <CryCore/StaticInstanceList.h>
+
+#include <CryCore/Platform/platform_impl.inl>
+
+CCinematicCameraPlugin::~CCinematicCameraPlugin()
+{
+	gEnv->pSystem->GetISystemEventDispatcher()->RemoveListener(this);
+	if (gEnv->pSchematyc)
+		gEnv->pSchematyc->GetEnvRegistry().DeregisterPackage(CCinematicCameraPlugin::GetCID());
+}
+
+bool CCinematicCameraPlugin::Initialize(SSystemGlobalEnvironment& env, const SSystemInitParams& initParams)
+{
+	gEnv->pSystem->GetISystemEventDispatcher()->RegisterListener(this, "CCinematicCameraPlugin");
+
+	// Register for the UpdateBeforeFinalizeCamera hook so we can apply EV compensation
+	// after the TOD system sets E3DPARAM_HDR_EYEADAPTATION_PARAMS.
+	EnableUpdate(EUpdateStep::BeforeFinalizeCamera, true);
+
+	return true;
+}
+
+void CCinematicCameraPlugin::UpdateBeforeFinalizeCamera()
+{
+	if (CCinematicCameraComponent* pActive = CCinematicCameraComponent::GetActiveComponent())
+	{
+		pActive->FinalizeGameCamera();
+		pActive->ApplyExposureGlobalParam();
+	}
+}
+
+void CCinematicCameraPlugin::OnSystemEvent(ESystemEvent event, UINT_PTR wparam, UINT_PTR lparam)
+{
+	switch (event)
+	{
+	case ESYSTEM_EVENT_REGISTER_SCHEMATYC_ENV:
+	{
+		auto staticAutoRegisterLambda = [](Schematyc::IEnvRegistrar& registrar)
+		{
+			Detail::CStaticAutoRegistrar<Schematyc::IEnvRegistrar&>::InvokeStaticCallbacks(registrar);
+		};
+
+		if (gEnv->pSchematyc)
+		{
+			gEnv->pSchematyc->GetEnvRegistry().RegisterPackage(
+				stl::make_unique<Schematyc::CEnvPackage>(
+					CCinematicCameraPlugin::GetCID(),
+					"CinematicCameraComponents",
+					"CryEngine",
+					"Cinematic Camera Components",
+					staticAutoRegisterLambda));
+		}
+		break;
+	}
+	}
+}
+
+CRYREGISTER_SINGLETON_CLASS(CCinematicCameraPlugin)
+
+// ---------------------------------------------------------------------------
+// C entry point used by other plugins (CryPhoneTracker) to drive the lens without
+// linking against this module. See Interface/ICinematicCameraOptics.h.
+// ---------------------------------------------------------------------------
+extern "C" DLL_EXPORT ICinematicCameraOptics* CryGetCinematicCameraOptics(IEntity* pEntity)
+{
+	if (pEntity == nullptr)
+		return nullptr;
+
+	return pEntity->GetComponent<CCinematicCameraComponent>();
+}
