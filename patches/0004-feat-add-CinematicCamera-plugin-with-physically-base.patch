@@ -0,0 +1,276 @@
+#pragma once
+
+#include <CryEntitySystem/IEntityComponent.h>
+#include <CrySchematyc/MathTypes.h>
+#include <CrySchematyc/Reflection/TypeDesc.h>
+#include <CrySchematyc/Env/IEnvRegistrar.h>
+#include <Cry3DEngine/I3DEngine.h>
+
+#include "../Interface/ICinematicCameraOptics.h"
+
+// CCameraComponent is in CryDefaultEntities/Module — forward-declared here,
+// included fully in the .cpp (include path set in CMakeLists.txt).
+namespace Cry { namespace DefaultComponents { class CCameraComponent; } }
+
+// ---------------------------------------------------------------------------
+// Sensor size presets
+// ---------------------------------------------------------------------------
+enum class ESensorPreset : uint32
+{
+	FullFrame35mm = 0,  // 36 x 24 mm
+	APSC,               // 23.6 x 15.7 mm
+	MicroFourThirds,    // 17.3 x 13 mm
+	Custom
+};
+
+static void ReflectType(Schematyc::CTypeDesc<ESensorPreset>& desc)
+{
+	desc.SetGUID("{C3A1B2D4-9E5F-4C8A-B1D0-6E7F2A3C4B5D}"_cry_guid);
+	desc.SetLabel("Sensor Preset");
+	desc.SetDefaultValue(ESensorPreset::FullFrame35mm);
+	desc.AddConstant(ESensorPreset::FullFrame35mm,   "FullFrame35mm",   "Full Frame 35mm");
+	desc.AddConstant(ESensorPreset::APSC,            "APSC",            "APS-C");
+	desc.AddConstant(ESensorPreset::MicroFourThirds, "MicroFourThirds", "Micro Four Thirds");
+	desc.AddConstant(ESensorPreset::Custom,          "Custom",          "Custom");
+}
+
+// ---------------------------------------------------------------------------
+// Focal length detents
+//
+// The engine takes a continuous FOV, so "steps" are produced by quantising the focal
+// length that feeds the optics; the stored property still holds whatever the fader sent.
+// ---------------------------------------------------------------------------
+enum class EFocalStepMode : uint32
+{
+	Continuous = 0, // No quantisation.
+	PrimeSet,       // Snap to a classic prime lens series (12 … 600 mm).
+	Geometric       // Snap to N equal steps per doubling of focal length.
+};
+
+static void ReflectType(Schematyc::CTypeDesc<EFocalStepMode>& desc)
+{
+	desc.SetGUID("{7D4E9A16-2C58-4B31-8F6A-0B9E4C1D7A32}"_cry_guid);
+	desc.SetLabel("Focal Step Mode");
+	desc.SetDefaultValue(EFocalStepMode::PrimeSet);
+	desc.AddConstant(EFocalStepMode::Continuous, "Continuous", "Continuous");
+	desc.AddConstant(EFocalStepMode::PrimeSet,   "PrimeSet",   "Prime Lens Set");
+	desc.AddConstant(EFocalStepMode::Geometric,  "Geometric",  "Geometric Steps");
+}
+
+// ---------------------------------------------------------------------------
+// Exposure model
+// ---------------------------------------------------------------------------
+enum class EExposureMode : uint32
+{
+	//! Writes the scene-key auto-compensation strength. Aperture cannot affect brightness
+	//! here: the engine scales that term by how far the scene is from the reference key,
+	//! so its sign flips between bright and dark scenes.
+	AutoCompensation = 0,
+	//! Locks EV Min and EV Max to a single EV100 computed from aperture, shutter, ISO and
+	//! EV compensation, which is what makes the f-number actually change brightness.
+	Manual
+};
+
+static void ReflectType(Schematyc::CTypeDesc<EExposureMode>& desc)
+{
+	desc.SetGUID("{1E8B5C74-6A29-4D03-B5F1-8C2D7E6A0B94}"_cry_guid);
+	desc.SetLabel("Exposure Mode");
+	desc.SetDefaultValue(EExposureMode::Manual);
+	desc.AddConstant(EExposureMode::AutoCompensation, "AutoCompensation", "Auto Compensation");
+	desc.AddConstant(EExposureMode::Manual,           "Manual",           "Manual (physical)");
+}
+
+// ---------------------------------------------------------------------------
+// CCinematicCameraComponent
+//
+// Creates a sibling CCameraComponent that handles view/camera-manager integration
+// (so the entity appears in the Sandbox Camera Entity menu and the editor renders
+// through it with the correct frustum). This component drives:
+//   - FOV  via focal-length + sensor-size optics formula → written to CCameraComponent
+//   - DOF  via Dof_User_* post-effect params
+//   - EV   via E3DPARAM_HDR_EYEADAPTATION_PARAMS, applied in the plugin's
+//           UpdateBeforeFinalizeCamera() hook (runs after TOD::Update so it can't
+//           be overwritten by the TOD system in the same frame)
+// ---------------------------------------------------------------------------
+class CCinematicCameraComponent final
+	: public IEntityComponent
+	, public ICinematicCameraOptics
+{
+public:
+	static void ReflectType(Schematyc::CTypeDesc<CCinematicCameraComponent>& desc)
+	{
+		desc.SetGUID("{F2A3B4C5-D6E7-4F8A-B9C0-1D2E3F4A5B6C}"_cry_guid);
+		desc.SetEditorCategory("Cameras");
+		desc.SetLabel("Cinematic Camera");
+		desc.SetDescription(
+			"Physically-based camera: FOV from focal length, DOF from aperture, "
+			"exposure compensation from EV bias. Automatically creates a companion "
+			"Camera component so the entity appears in the Camera Entity menu.");
+		desc.SetIcon("icons:General/Camera.ico");
+		desc.SetComponentFlags({
+			IEntityComponent::EFlags::Transform,
+			IEntityComponent::EFlags::Socket,
+			IEntityComponent::EFlags::Attach,
+			IEntityComponent::EFlags::Singleton,
+			IEntityComponent::EFlags::ClientOnly });
+
+		desc.AddMember(&CCinematicCameraComponent::m_bActivateOnGameStart,
+			'aogs', "ActivateOnGameStart", "Activate On Game Start",
+			"Automatically make this the active camera when gameplay starts. Leave off when "
+			"Schematyc decides which camera is active - with several cameras in the level, "
+			"auto activation lets the last one initialised steal the view from an explicit "
+			"Activate call.", false);
+
+		desc.AddMember(&CCinematicCameraComponent::m_nearPlane,
+			'near', "NearPlane", "Near Plane (m)", nullptr, 0.25f);
+		desc.AddMember(&CCinematicCameraComponent::m_farPlane,
+			'far_', "FarPlane", "Far Plane (m)", nullptr, 1024.f);
+
+		desc.AddMember(&CCinematicCameraComponent::m_sensorPreset,
+			'sens', "SensorPreset", "Sensor Preset",
+			"Reference sensor size used to compute FOV and circle of confusion.",
+			ESensorPreset::FullFrame35mm);
+		desc.AddMember(&CCinematicCameraComponent::m_customSensorWidth,
+			'cswt', "CustomSensorWidth", "Custom Sensor Width (mm)",
+			"Width in mm — only used when Sensor Preset is Custom.", 36.0f);
+		desc.AddMember(&CCinematicCameraComponent::m_focalLength,
+			'focl', "FocalLength", "Focal Length (mm)",
+			"Shorter = wider angle. Drives the vertical field of view.", 50.0f);
+		desc.AddMember(&CCinematicCameraComponent::m_aperture,
+			'aptr', "Aperture", "Aperture (f-number)",
+			"Lower f-number = shallower depth of field.", 5.6f);
+		desc.AddMember(&CCinematicCameraComponent::m_focusDistance,
+			'fdst', "Focus Distance (m)", "Focus Distance (m)",
+			"Distance to the sharp focus plane.", 5.0f);
+
+		desc.AddMember(&CCinematicCameraComponent::m_focalStepMode,
+			'fstm', "FocalStepMode", "Focal Step Mode",
+			"Quantise the focal length so zooming has detents instead of sliding freely.",
+			EFocalStepMode::PrimeSet);
+		desc.AddMember(&CCinematicCameraComponent::m_focalStepsPerDoubling,
+			'fstn', "FocalStepsPerDoubling", "Steps Per Doubling",
+			"Detents between one focal length and twice that — only used by Geometric.", 6);
+
+		desc.AddMember(&CCinematicCameraComponent::m_bEnableDOF,
+			'dof_', "EnableDOF", "Enable Depth of Field",
+			"Compute and apply DOF blur from aperture + focus distance.", false);
+		desc.AddMember(&CCinematicCameraComponent::m_focusFalloff,
+			'ffal', "FocusFalloff", "Focus Falloff",
+			"How far past the depth of field limits the blur keeps ramping. 1 = fully blurred "
+			"right at the limits (the engine default, which reads as a very thin focus zone); "
+			"higher values widen the sharp zone.", 3.0f);
+
+		desc.AddMember(&CCinematicCameraComponent::m_bEnableExposure,
+			'expo', "EnableExposure", "Enable Exposure Control",
+			"Override HDR eye-adaptation EV compensation.", false);
+		desc.AddMember(&CCinematicCameraComponent::m_exposureMode,
+			'expm', "ExposureMode", "Exposure Mode",
+			"Manual locks exposure to the aperture / shutter / ISO triangle.",
+			EExposureMode::Manual);
+		desc.AddMember(&CCinematicCameraComponent::m_shutterDenominator,
+			'shut', "ShutterDenominator", "Shutter (1/x s)",
+			"Manual mode only. 50 is roughly a 180 degree shutter at 25 fps.", 50);
+		desc.AddMember(&CCinematicCameraComponent::m_iso,
+			'iso_', "ISO", "ISO",
+			"Manual mode only. Higher ISO brightens the image.", 400);
+		desc.AddMember(&CCinematicCameraComponent::m_evCompensation,
+			'evcp', "EVCompensation", "EV Compensation",
+			"EV bias (-3 darker … 0 neutral … +3 brighter). In Manual mode this is a true stop.", 0.0f);
+	}
+
+	static void Register(Schematyc::CEnvRegistrationScope& componentScope);
+
+	// IEntityComponent
+	virtual void Initialize() override;
+	virtual Cry::Entity::EventFlags GetEventMask() const override;
+	virtual void ProcessEvent(const SEntityEvent& event) override;
+	virtual void OnShutDown() override;
+	// ~IEntityComponent
+
+	// Schematyc / scripting API
+	void Activate();
+	void Deactivate();
+	bool IsActive() const;
+
+	// ICinematicCameraOptics - live lens control, used by CryPhoneTracker
+	virtual void SetFocalLength(float millimetres) override;
+	virtual void SetAperture(float fNumber) override;
+	virtual void SetFocusDistance(float metres) override;
+	virtual void SetEVCompensation(float ev) override;
+	virtual void SetDepthOfFieldEnabled(bool enable) override;
+	virtual void SetExposureEnabled(bool enable) override;
+
+	virtual float GetFocalLength() const override { return m_focalLength; }
+	virtual float GetAperture() const override { return m_aperture; }
+	virtual float GetFocusDistance() const override { return m_focusDistance; }
+	virtual float GetEVCompensation() const override { return m_evCompensation; }
+	// ~ICinematicCameraOptics
+
+	// Called by CCinematicCameraPlugin::UpdateBeforeFinalizeCamera() - the engine's
+	// sanctioned override point: the view camera "is only considered final after
+	// UpdateBeforeFinalizeCamera has been executed" (ISystem.h). Writing it any earlier
+	// (as CCameraComponent does from ENTITY_EVENT_UPDATE) loses to the GameSDK ViewSystem,
+	// which runs in the game framework post update.
+	void FinalizeGameCamera();
+	void ApplyExposureGlobalParam();
+
+	static CCinematicCameraComponent* GetActiveComponent() { return s_pActive; }
+	bool IsExposureEnabled() const { return m_bEnableExposure; }
+
+private:
+	void UpdateCameraComponentParams();
+
+	float GetEffectiveFocalLength() const;
+	float ComputeManualEV100() const;
+	float ComputeFocusRange() const;
+
+	float GetSensorWidth()  const;
+	float GetSensorHeight() const;
+	float ComputeVerticalFOV() const;
+	float ComputeCoCLimit() const;
+	void  ComputeDOFBounds(float& outNear, float& outFar) const;
+	float ComputeMaxBlurAmount() const;
+
+	void ApplyDOF();
+	void RestoreDOF();
+	void RestoreExposure();
+
+private:
+	// Reflected properties
+	bool                             m_bActivateOnGameStart = false;
+	Schematyc::Range<0, 32768>       m_nearPlane            = 0.25f;
+	Schematyc::Range<0, 32768>       m_farPlane             = 1024.f;
+	ESensorPreset                    m_sensorPreset         = ESensorPreset::FullFrame35mm;
+	Schematyc::Range<1, 200>         m_customSensorWidth    = 36.f;
+	Schematyc::Range<1, 2400>        m_focalLength          = 50.f;
+	Schematyc::Range<1, 64>          m_aperture             = 5.6f;
+	Schematyc::Range<0, 10000>       m_focusDistance        = 5.f;
+	EFocalStepMode                   m_focalStepMode        = EFocalStepMode::PrimeSet;
+	Schematyc::Range<1, 24, 2, 12, int> m_focalStepsPerDoubling = 6;
+	bool                             m_bEnableDOF           = false;
+	Schematyc::Range<1, 10, 1, 6>    m_focusFalloff         = 3.f;
+	bool                             m_bEnableExposure      = false;
+	EExposureMode                    m_exposureMode         = EExposureMode::Manual;
+	Schematyc::Range<1, 8000, 1, 250, int>    m_shutterDenominator = 50;
+	Schematyc::Range<25, 25600, 50, 6400, int> m_iso          = 400;
+	Schematyc::Range<-3, 3, -3, 3>  m_evCompensation       = 0.f;
+
+	// Sibling camera component (created in Initialize)
+	Cry::DefaultComponents::CCameraComponent* m_pCameraComponent = nullptr;
+
+	// DOF saved params
+	float m_savedDofUserActive = 0.f;
+	float m_savedDofFocusDist  = 3.5f;
+	float m_savedDofFocusRange = 5.f;
+	float m_savedDofBlurAmount = 1.f;
+	int   m_savedDofCVar       = 0;
+	bool  m_bDofParamsSaved    = false;
+
+	// Exposure saved param. Manual mode rewrites EV min and max as well as the auto
+	// compensation, so the whole vector has to be put back.
+	Vec3 m_savedEyeAdaptation = Vec3(4.5f, 17.0f, 1.5f);
+	bool m_bExpParamsSaved    = false;
+
+	// Singleton: which CinematicCameraComponent is currently the active camera
+	static CCinematicCameraComponent* s_pActive;
+};
diff --git a/Code/CryPlugins/CinematicCamera/Module/CinematicCameraPlugin.cpp b/Code/CryPlugins/CinematicCamera/Module/CinematicCameraPlugin.cpp
