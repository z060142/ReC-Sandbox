+// Live lens control surface of the Cinematic Camera component.
+//
+// Other plugins (CryPhoneTracker) drive the lens without linking against CinematicCamera:
+// they resolve CryGetCinematicCameraOptics from the already loaded CinematicCamera.dll and
+// simply get nullptr back when that plugin is not part of the project.
+#pragma once
+
+struct IEntity;
+
+struct ICinematicCameraOptics
+{
+	virtual ~ICinematicCameraOptics() {}
+
+	virtual void SetFocalLength(float millimetres) = 0;
+	virtual void SetAperture(float fNumber) = 0;
+	virtual void SetFocusDistance(float metres) = 0;
+	virtual void SetEVCompensation(float ev) = 0;
+	virtual void SetDepthOfFieldEnabled(bool enable) = 0;
+	virtual void SetExposureEnabled(bool enable) = 0;
+
+	virtual float GetFocalLength() const = 0;
+	virtual float GetAperture() const = 0;
+	virtual float GetFocusDistance() const = 0;
+	virtual float GetEVCompensation() const = 0;
+};
+
+//! Name of the C entry point exported by CinematicCamera.dll.
+#define CINEMATIC_CAMERA_OPTICS_ENTRY "CryGetCinematicCameraOptics"
+
+//! Signature of that entry point: returns the optics interface of the cinematic camera
+//! component on pEntity, or nullptr when the entity carries no such component.
+typedef ICinematicCameraOptics* (* TGetCinematicCameraOpticsFn)(IEntity* pEntity);
