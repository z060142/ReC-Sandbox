From d2c29578ea606898b289b470b0698aa4bbd02db0 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Tue, 8 Sep 2026 19:36:28 +0800
Subject: [PATCH 123/135] feat: the exposure coverage overlay says which
 meaning ambient lights have this frame

r_HDRDebug 1's coverage line said "ambient lights: n/a, they modulate", which is only true on the
stock path now. It reports "routed as fill lights, shadows on" when they are, read from the same
3D engine mirror of the switch that the routing itself reads so the two cannot disagree.

Without it a fill light that is not following the aperture is indistinguishable from a modulator
that is behaving correctly by doing nothing, which is exactly the confusion this overlay exists to
prevent.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01HXzRVK4yBVDUNfdWXEwV5y
---
 .../GraphicsPipeline/ToneMapping.cpp           | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp
index a00bc902..51814727 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/ToneMapping.cpp
@@ -1014,11 +1014,25 @@ void CToneMappingStage::DisplaySceneReferredCoverage()
 	cry_sprintf(str, "  pre-exposure reaches: sun+lights YES  probes YES (tint; re-bake for PI)  sky YES  forward/emissive YES");
 	IRenderAuxText::DrawText(Vec3(5, 155, 1), IRenderAuxText::ASize(1.0f), ColorF(1, 0, 1, 1), eDrawText_800x600 | eDrawText_2D, str);
 
-	cry_sprintf(str, "    ... SVOGI %s  global fog %s  volumetric fog %s  clouds YES  snow %s  | ambient lights: n/a, they modulate",
+	// Ambient light entities have two possible meanings and the overlay must say which one is in
+	// force, or the reader cannot tell a fill light that is not following the aperture from a
+	// modulator that is behaving correctly by doing nothing. Read from the SAME 3DEngine mirror
+	// that CRenderView::AddDeferredLight routes on (E3DPARAM_SCENE_REFERRED), never from a second
+	// gate that could disagree with it.
+	bool bAmbientAsFill = false;
+	if (gEnv->p3DEngine)
+	{
+		Vec3 v(0.0f, 0.0f, 0.0f);
+		gEnv->p3DEngine->GetGlobalParameter(E3DPARAM_SCENE_REFERRED, v);
+		bAmbientAsFill = v.x > 0.5f;
+	}
+
+	cry_sprintf(str, "    ... SVOGI %s  global fog %s  volumetric fog %s  clouds YES  snow %s  | ambient lights: %s",
 	            bSvo  ? "YES (ApplyGI+SvoGiFog)"      : "YES (off)",
 	            bFog  ? "YES"                         : "YES (off)",
 	            bVFog ? "YES (sun+emission)"          : "YES (off)",
-	            bSnow ? "YES (flakes+709->AP1)"       : "YES (off)");
+	            bSnow ? "YES (flakes+709->AP1)"       : "YES (off)",
+	            bAmbientAsFill ? "YES (routed as fill lights, shadows on)" : "n/a, they modulate");
 	IRenderAuxText::DrawText(Vec3(5, 175, 1), IRenderAuxText::ASize(1.0f), ColorF(1, 0, 1, 1), eDrawText_800x600 | eDrawText_2D, str);
 }
 
