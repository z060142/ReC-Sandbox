 	std::vector<AABB>            m_integratedNodeBoxes;
 
-	//! Rebuilds m_integratedNodeBoxes from m_integratedIntoTerrainNodes. Called from every place that
-	//! touches the map, so the two can never drift apart.
 	void RefreshIntegratedNodeBoxes();
 
-	//! True when any object currently integrated into the terrain overlaps `box` in XY. False - without
-	//! touching anything - while the level does not integrate objects at all, which is what keeps
