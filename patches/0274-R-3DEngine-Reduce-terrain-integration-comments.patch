diff --git a/Code/CryEngine/Cry3DEngine/3dEngine.cpp b/Code/CryEngine/Cry3DEngine/3dEngine.cpp
index eaef3838..6aef5d32 100644
--- a/Code/CryEngine/Cry3DEngine/3dEngine.cpp
+++ b/Code/CryEngine/Cry3DEngine/3dEngine.cpp
@@ -622,8 +622,6 @@ void C3DEngine::Update()
 		m_pTerrain->Recompile_Modified_Incrementaly_RoadRenderNodes();
 	}
 
-	// Terrain sector rebuilds that e_TerrainIntegrateObjectsRebuildDelay held back while an integrating
-	// object was being moved. No-op (one empty-map test) while the cvar is 0.
 	FlushPendingTerrainRebuilds();
 
 	if (m_bEditor)
@@ -6807,19 +6805,13 @@ void C3DEngine::UpdateTerrainObjectIntegration(IRenderNode* pEnt, EERType eERTyp
 	if (!bIntegratesNow && !bWasIntegrating)
 		return;
 
-	// Drop the sector meshes over the union of where the object was integrated and where it is now,
-	// so that enabling the mode, disabling it, and moving an integrated object all leave no stale
-	// geometry behind. The rebuild itself is lazy (the meshes are freed here, rebuilt when drawn).
+	// Union of where the object was integrated and where it is now, so no stale geometry is left behind.
 	AABB dirtyBox = aabb;
 	if (bWasIntegrating)
 		dirtyBox.Add(it->second);
 
-	// A node that was integrating and still is has only moved (or changed its box). Sector builds are
-	// synchronous while the level flag is on, so every frame of an editor drag pays for a full rebuild of
-	// every sector the object touches. With e_TerrainIntegrateObjectsRebuildDelay > 0 the union of the
-	// dirty boxes is accumulated instead and flushed by FlushPendingTerrainRebuilds() once the node has
-	// been still for that many frames. Entering and leaving the mode, and (un)registering, are not
-	// debounced: they are one-off transitions the user expects to see at once.
+	// Sector builds are synchronous, so an editor drag would rebuild every touched sector every frame.
+	// Only moves are debounced; entering/leaving the mode must be visible at once.
 	const bool bMovedWhileIntegrating = bIntegratesNow && bWasIntegrating;
 
 	if (bMovedWhileIntegrating && GetCVars()->e_TerrainIntegrateObjectsRebuildDelay > 0)
@@ -6833,8 +6825,7 @@ void C3DEngine::UpdateTerrainObjectIntegration(IRenderNode* pEnt, EERType eERTyp
 		return;
 	}
 
-	// Not debounced (or no longer): anything this node still owed has to go out with this rebuild, so
-	// that the boxes it passed through are not left holding stale geometry.
+	// Anything this node still owed has to go out with this rebuild.
 	if (!m_pendingTerrainRebuilds.empty())
 	{
 		std::map<IRenderNode*, SPendingTerrainRebuild>::iterator pendingIt = m_pendingTerrainRebuilds.find(pEnt);
@@ -6855,10 +6846,8 @@ void C3DEngine::UpdateTerrainObjectIntegration(IRenderNode* pEnt, EERType eERTyp
 
 	RefreshIntegratedNodeBoxes();
 
-	// A road drapes over the object's real surface (e_RoadsFollowIntegratedObjects), so the same dirty
-	// box that invalidates the terrain sectors has to rebuild the roads crossing it. Done after the map
-	// is updated, and only as a scheduling request - Compile() runs later, from Update(), never from
-	// inside a (un)registration.
+	// Roads drape over the object's surface, so the same dirty box has to rebuild them. Scheduling only:
+	// Compile() must not run from inside a (un)registration.
 	RequestRoadRebuildsInArea(dirtyBox);
 }
 
@@ -6878,8 +6867,7 @@ void C3DEngine::RefreshIntegratedNodeBoxes()
 ///////////////////////////////////////////////////////////////////////////////
 void C3DEngine::UpdateIntegratedObjectDrawSuppression(const SRenderingPassInfo& passInfo)
 {
-	// Full 0 and Full 1 must be bit identical to what they were, so nothing is ever stamped below 2 and
-	// no brush can carry this frame's id. The map is empty on any level that does not integrate.
+	// Full 0/1 must stay bit identical to the stock path, so nothing is ever stamped below 2.
 	if (GetCVars()->e_TerrainIntegrateObjectsFull < 2 || !m_bIntegrateObjectsIntoTerrain || m_integratedIntoTerrainNodes.empty())
 		return;
 
@@ -6895,13 +6883,11 @@ void C3DEngine::UpdateIntegratedObjectDrawSuppression(const SRenderingPassInfo&
 	{
 		IRenderNode* pNode = it->first;
 
-		// Only eERType_MovableBrush ever enters this map (UpdateTerrainObjectIntegration), and only
-		// CBrush implements the suppression, but the cast is worth guarding anyway.
+		// Guard the CBrush cast below.
 		if (pNode->GetRenderNodeType() != eERType_MovableBrush)
 			continue;
 
-		// The live box, not the cached one: the cached box is what the sectors were invalidated for and
-		// may lag a debounced move, and lagging here would be the unsafe direction.
+		// Live box, not the cached one: that one may lag a debounced move, which is the unsafe direction.
 		if (!pTerrain->IsObjectDrawnByTerrain(pNode, pNode->GetBBox(), nMainFrameId))
 			continue;
 
@@ -6912,10 +6898,8 @@ void C3DEngine::UpdateIntegratedObjectDrawSuppression(const SRenderingPassInfo&
 ///////////////////////////////////////////////////////////////////////////////
 bool C3DEngine::HasIntegratedObjectsInBoxXY(const AABB& box) const
 {
-	// XY only, deliberately. A terrain node's box is the heightmap under it (plus whatever the last
-	// integration stretched it by), while an integrated object may sit well above or below that - a
-	// sunken plate is the whole point of the exercise. What decides whether this sector has to stay at
-	// LOD 0 is only whether the object's footprint lands on it.
+	// XY only: an integrated object may sit well above or below the sector's heightmap box (a sunken
+	// plate is the point), so only the footprint decides whether the sector must stay at LOD 0.
 	for (size_t i = 0; i < m_integratedNodeBoxes.size(); ++i)
 	{
 		if (Overlap::AABB_AABB2D(m_integratedNodeBoxes[i], box))
@@ -6951,8 +6935,6 @@ void C3DEngine::FlushPendingTerrainRebuilds()
 			if (pTerrain != nullptr)
 				pTerrain->ResetTerrainVertBuffers(&it->second.dirtyBox);
 
-			// Same debounce for the roads: one rebuild once the object has come to rest, not one per
-			// frame of the drag.
 			RequestRoadRebuildsInArea(it->second.dirtyBox);
 		}
 
@@ -6969,9 +6951,8 @@ void C3DEngine::RequestRoadRebuildsInArea(const AABB& box)
 	if (box.IsReset() || !m_pObjectsTree)
 		return;
 
-	// A road sits on the terrain while the object standing on it can be anywhere above or below, so the
-	// two boxes need not overlap vertically. Widen the query in Z only, exactly as the heightmap edit
-	// path does (terran_edit.cpp), and let the XY overlap do the selecting.
+	// The object standing on a road can be anywhere above or below it, so widen the query in Z only and
+	// let the XY overlap select (same as the heightmap edit path in terran_edit.cpp).
 	AABB queryBox = box;
 	queryBox.min.z -= 1024.f;
 	queryBox.max.z += 1024.f;
@@ -6981,9 +6962,7 @@ void C3DEngine::RequestRoadRebuildsInArea(const AABB& box)
 
 	for (int i = 0; i < lstRoads.Count(); i++)
 	{
-		// Only schedule: OnTerrainChanged() would first snap every vertex back onto the bare heightmap
-		// (GetZApr), which is the very surface we are trying to leave. Compile() runs from Update() and
-		// does the whole job with the integrated heights in one pass.
+		// Not OnTerrainChanged(): that snaps every vertex back onto the bare heightmap first.
 		((CRoadRenderNode*)lstRoads[i])->ScheduleRebuild(true);
 	}
 }
@@ -6991,8 +6970,7 @@ void C3DEngine::RequestRoadRebuildsInArea(const AABB& box)
 ///////////////////////////////////////////////////////////////////////////////
 void C3DEngine::BeginIntegratedHeightSampling(const AABB& areaBox)
 {
-	// Nesting keeps the outer cache: it was built for a superset area, and rebuilding it here would
-	// silently shrink what the outer scope can see.
+	// Nesting keeps the outer cache; rebuilding here would shrink what the outer scope can see.
 	if (m_nIntegratedHeightSamplingDepth++ > 0)
 		return;
 
@@ -7001,16 +6979,13 @@ void C3DEngine::BeginIntegratedHeightSampling(const AABB& areaBox)
 	if (m_integratedIntoTerrainNodes.empty() || areaBox.IsReset())
 		return;
 
-	// Read budget per object. A plate is a few thousand triangles; anything past this is not something
-	// a road should be draping over, and the cost is paid once per rebuild, not once per sample.
+	// Read budget per object.
 	const int nMaxTrisPerNode = 200000;
 
 	for (std::map<IRenderNode*, AABB>::const_iterator it = m_integratedIntoTerrainNodes.begin();
 	     it != m_integratedIntoTerrainNodes.end(); ++it)
 	{
-		// The map is authoritative: an entry exists only between RegisterEntity and UnRegisterEntity, so
-		// the node is alive here. It is erased before the node is destroyed, on the unregister path of
-		// UpdateTerrainObjectIntegration().
+		// Entries exist only between RegisterEntity and UnRegisterEntity, so the node is alive here.
 		IRenderNode* pRNode = it->first;
 
 		if (!Overlap::AABB_AABB2D(it->second, areaBox))
@@ -7067,8 +7042,7 @@ void C3DEngine::BeginIntegratedHeightSampling(const AABB& areaBox)
 		if (nTris <= 0 || entry.box.IsReset())
 			continue;
 
-		// One coarse XY bin grid per object, sized so a bin holds a handful of triangles. A road samples
-		// a few thousand points per rebuild, so the grid is what keeps this off O(points * triangles).
+		// Coarse XY bin grid, sized for a handful of triangles per bin: keeps sampling off O(points * tris).
 		const int nBins = clamp_tpl((int)sqrtf((float)nTris / 4.f), 1, 64);
 		entry.binsX = nBins;
 		entry.binsY = nBins;
@@ -7125,8 +7099,7 @@ bool C3DEngine::HasIntegratedHeightSamplesIn2D(const AABB& box) const
 ///////////////////////////////////////////////////////////////////////////////
 float C3DEngine::GetTerrainOrIntegratedZ(float x, float y, float defaultZ) const
 {
-	// No open sampling scope (or nothing integrating nearby): this is the caller's own terrain height,
-	// unmodified. That is the byte identical native path.
+	// No open sampling scope: byte identical native path.
 	if (m_integratedHeightCache.empty())
 		return defaultZ;
 
@@ -7150,9 +7123,8 @@ float C3DEngine::GetTerrainOrIntegratedZ(float x, float y, float defaultZ) const
 			const Vec3& b = node.verts[bin[k] * 3 + 1];
 			const Vec3& c = node.verts[bin[k] * 3 + 2];
 
-			// A vertical ray against a triangle is a 2D barycentric test in XY plus a linear
-			// interpolation of Z. A vertical face projects to zero area and drops out on the determinant
-			// test, which is what we want: only a surface a road could lie on may raise it.
+			// Vertical ray = 2D barycentric test in XY plus linear Z interpolation. Vertical faces project
+			// to zero area and drop out here, as intended.
 			const float fDet = (b.y - c.y) * (a.x - c.x) + (c.x - b.x) * (a.y - c.y);
 			if (fabs_tpl(fDet) < 1e-8f)
 				continue;
@@ -7162,8 +7134,7 @@ float C3DEngine::GetTerrainOrIntegratedZ(float x, float y, float defaultZ) const
 			const float l1 = ((c.y - a.y) * (x - c.x) + (a.x - c.x) * (y - c.y)) * fInvDet;
 			const float l2 = 1.f - l0 - l1;
 
-			// A small negative tolerance keeps a sample that lands exactly on a shared edge from falling
-			// through the crack between the two triangles that own it.
+			// Negative tolerance so a sample on a shared edge does not fall through the crack.
 			const float fEdgeTol = -1e-4f;
 			if (l0 < fEdgeTol || l1 < fEdgeTol || l2 < fEdgeTol)
 				continue;
diff --git a/Code/CryEngine/Cry3DEngine/3dEngine.h b/Code/CryEngine/Cry3DEngine/3dEngine.h
