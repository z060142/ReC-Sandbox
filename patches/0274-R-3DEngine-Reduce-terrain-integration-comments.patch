+	//! True when any integrated object overlaps `box` in XY. Early-outs on levels that integrate nothing.
 	bool HasIntegratedObjectsInBoxXY(const AABB& box) const;
 
-	//! A terrain sector rebuild held back by e_TerrainIntegrateObjectsRebuildDelay: the union of every
-	//! dirty box recorded for that node since the last flush, and the frame of the last move.
+	//! A terrain sector rebuild held back by e_TerrainIntegrateObjectsRebuildDelay.
 	struct SPendingTerrainRebuild
 	{
 		AABB   dirtyBox = AABB(AABB::RESET);
 		uint32 lastMoveFrameId = 0;
 	};
 
-	//! Moves of already integrating nodes whose rebuild is being debounced. Empty unless
-	//! e_TerrainIntegrateObjectsRebuildDelay is > 0. Keys are only ever compared, never dereferenced,
-	//! and an entry is flushed by any (un)registration of the node and by UnloadLevel.
+	//! Debounced moves of already integrating nodes. Keys are only ever compared, never dereferenced.
 	std::map<IRenderNode*, SPendingTerrainRebuild> m_pendingTerrainRebuilds;
 
-	//! Request the terrain sector rebuild needed by any transition into/out of eGM_IntegrateIntoTerrain.
-	//! Called on (un)registration; pass bUnregister when the node is leaving the scene.
+	//! Request the terrain sector rebuild needed by a transition into/out of eGM_IntegrateIntoTerrain.
 	void UpdateTerrainObjectIntegration(IRenderNode* pEnt, EERType eERType, const AABB& aabb, bool bUnregister);
 
-	//! Runs the rebuilds that e_TerrainIntegrateObjectsRebuildDelay held back and whose node has now been
-	//! still for long enough. Called once per frame from Update().
+	//! Runs the debounced rebuilds whose node has been still for long enough. Once per frame.
 	void FlushPendingTerrainRebuilds();
 
-	//! Decision 05 step 2 (e_TerrainIntegrateObjectsFull 2). Called once per frame from CTerrain::CheckVis,
-	//! after the terrain traversal has picked this frame's sectors and before the outdoor octree is
-	//! traversed, so the verdict is exact for the same frame. Stamps every integrated brush that the
-	//! terrain is drawing in full this frame; CBrush::Render then skips its own camera draw. Objects that
-	//! are not stamped simply draw as before - the whole gate is one-sided in that direction.
+	//! Stamps every integrated brush the terrain draws in full this frame so CBrush::Render can skip its
+	//! own camera draw. Must run after the terrain traversal picked its sectors and before the outdoor
+	//! octree traversal, otherwise the verdict is a frame late.
 	void UpdateIntegratedObjectDrawSuppression(const SRenderingPassInfo& passInfo);
 
-	//! Schedule a full rebuild of every eERType_Road node whose bounding box overlaps `box` in XY, so a
-	//! road that drapes over an integrating object (e_RoadsFollowIntegratedObjects) follows it when the
-	//! object appears, moves or goes away. No-op while the cvar is 0.
+	//! Rebuild every road overlapping `box` in XY so it re-drapes over a moved/added/removed integrating
+	//! object. No-op while e_RoadsFollowIntegratedObjects is 0.
 	void RequestRoadRebuildsInArea(const AABB& box);
 
 	//! One integrating object, cached in world space for the duration of a road rebuild.
@@ -910,20 +895,18 @@ public:
 		float                         binSizeY = 1.f;
 	};
 
-	//! LOD 0 geometry of the eGM_IntegrateIntoTerrain nodes overlapping the area passed to
