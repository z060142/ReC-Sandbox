@@ -384,11 +384,18 @@ float4 FilterPSFPS(v2fFilterPSF IN) : SV_Target
 //    edge. That is exact for a straight blade and pessimistic for anything smoother, so the
 //    extrapolated tail is never brighter than the physics allows.
 //
+//  * Energy. The kernel is NOT renormalised. Its texels are the Parseval-normalised |F{A}|^2
+//    of the pupil - the whole pattern summed to 1 before the core was removed - so what the
+//    texture holds is literally the fraction of the source that was diffracted away. The only
+//    factor applied here is 1 / pitch^2, which converts "per kernel texel" into "per
+//    quarter-resolution pixel", the unit the sprite rasterizes in. Amount 1 is therefore the
+//    physical fraction (5-15% of the source for a typical iris), not the whole excess.
+//
 //  * Colour. Each wavelength is a scaled copy: PSF_l(u) = (l0/l)^2 * PSF_l0(u * l0/l). Blue is
 //    compact, red is stretched, which is why a real sunstar's ray runs blue at the core and red
 //    at the tip. Six samples, weights pre-multiplied and normalised to white on the CPU.
 
-float4 DiffractionParams0;    // (sprite radius in quarter-res px, kernel texel pitch in the same px, R_tex, 1 / kernel integral)
+float4 DiffractionParams0;    // (sprite radius in quarter-res px, kernel texel pitch in the same px, R_tex, 1 / pitch^2)
 float4 DiffractionParams1;    // (dispersion 0..1, grid size L, unused, unused)
 float4 DiffractionParams2;    // (sprite half extent x in NDC, half extent y in NDC, energy per unit of source excess, unused)
 float4 DiffractionSpectrum[6];// rgb = colour * (l0/l)^2 normalised to white, w = l0 / l
