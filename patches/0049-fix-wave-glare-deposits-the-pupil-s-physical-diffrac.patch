diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp
index 29590310..c9196434 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Bloom.cpp
@@ -467,21 +467,27 @@ void CBloomStage::ExecuteDiffraction(const SHDRStreaksParams& streakParams, floa
 	const float fRadiusNdcY = 2.0f * fRadiusQuarterPx / (float)nGridHeight;
 	const float fRadiusNdcX = 2.0f * (fRadiusQuarterPx * fSqueeze) / (float)nGridWidth;
 
-	// Energy. The kernel's integral is the texture's own plus the extrapolated tail out to the
-	// sprite's rim; the tail is logarithmic, hence finite, and the CPU handed us its coefficient
-	// so the deposit is energy correct INCLUDING what the sprite cuts off. Dividing by the pitch
-	// squared converts "per kernel texel" into "per quarter-resolution pixel", which is what the
-	// sprite actually rasterizes.
+	// Energy. The kernel texture is ALREADY the physical answer: the CPU normalised the full
+	// pattern to Parseval (sum I = 1 = the pupil's whole transmitted light) BEFORE removing the
+	// core, so what is left in the texture integrates to 1 - E_core, and the extrapolated tail
+	// out to the sprite's rim adds its own logarithmic share. A source of excess E therefore
+	// deposits E * amount * I(u) per kernel texel - and NOT one factor more. There is no
+	// renormalisation of the glare to unit integral here: that would hand the pattern the
+	// source's entire excess (some 14x too much for an 8-blade iris, whose diffracted fraction
+	// is 1 - E_core ~ 0.07) and would make the deposit depend on where the sprite happens to be
+	// cut off, which is a cost choice and not physics.
 	//
-	// With that, amount 1 puts the source's whole thresholded excess into the pattern the pupil
-	// dictates - no gain constant tuned by eye anywhere. (The removed core is NOT added back:
-	// the frame already carries the source itself. Its fraction is in the kernel's log line, so
-	// how much of the light really went into the glare stays readable.)
+	// The ONE conversion that stays is texel -> pixel: the sprite rasterizes quarter-resolution
+	// pixels, each of which covers 1 / s_q^2 kernel texels, so the per-pixel deposit is
+	// I / s_q^2. Amount 1 is then the physical fraction (the log line prints it); above 1 is
+	// explicitly the exaggeration side.
 	const float fRingRadius = max(kernel.GetRingRadius(), 1.0f);
 	const float fSpriteRadiusTexels = max(fRadiusQuarterPx / fPitchQuarterPx, fRingRadius);
-	const float fIntegral = max(kernel.GetTextureIntegral()
-	                            + kernel.GetTailCoefficient() * logf(fSpriteRadiusTexels / fRingRadius), 1e-12f);
-	const float fNorm = 1.0f / (fIntegral * fPitchQuarterPx * fPitchQuarterPx);
+	// Diagnostic only now: the fraction of the source's light this pattern actually receives at
+	// amount 1, texture plus the tail the sprite is wide enough to hold.
+	const float fGlareFraction = max(kernel.GetTextureIntegral()
+	                                 + kernel.GetTailCoefficient() * logf(fSpriteRadiusTexels / fRingRadius), 0.0f);
+	const float fNorm = 1.0f / (fPitchQuarterPx * fPitchQuarterPx);
 	const float fEnergy = streakParams.fWaveAmount / fBloomCompositeWeight;
 
 	// Spectral sampling. Each wavelength is a SCALED copy of the same pattern -
@@ -527,10 +533,10 @@ void CBloomStage::ExecuteDiffraction(const SHDRStreaksParams& streakParams, floa
 			s_lastReach = streakParams.fWaveReach;
 			s_lastDispersion = streakParams.fDispersion;
 			s_lastN = pDofStage->GetDiffractionNGeo();
-			CryLog("[BLOOM] diffraction glare amount=%.2f reach=%.2f disp=%.2f N=%.1f -> pitch=%.3f q-px/texel sprite=%.0f q-px (%.0f texels) core=%.2f norm=%.3g",
+			CryLog("[BLOOM] diffraction glare amount=%.2f reach=%.2f disp=%.2f N=%.1f -> pitch=%.3f q-px/texel sprite=%.0f q-px (%.0f texels) core=%.2f deposited glare fraction=%.3f norm=%.3g",
 			       streakParams.fWaveAmount, streakParams.fWaveReach, streakParams.fDispersion,
 			       pDofStage->GetDiffractionNGeo(), fPitchQuarterPx, fRadiusQuarterPx, fSpriteRadiusTexels,
-			       kernel.GetCoreFraction(), fNorm);
+			       kernel.GetCoreFraction(), fGlareFraction * streakParams.fWaveAmount, fNorm);
 		}
 	}
 
