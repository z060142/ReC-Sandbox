+		const float fKernelBlades = (CRenderer::CV_r_DofBokehQuality >= 3)
+		                            ? (float)CRenderer::CV_r_DofBokehQuality
+		                            : clamp_tpl(dofParams.fApertureBlades, 3.0f, 16.0f);
+		const float fKernelCurvature = (CRenderer::CV_r_DofBokehQuality >= 3) ? 0.0f : dofParams.fBladeCurvature;
+
+		SDiffractionPupilDesc pupil;
+		pupil.nGridSize = clamp_tpl((int)CRenderer::CV_r_HDRDiffractionKernelSize, 256, 512);
+		pupil.fBlades = fKernelBlades;
+		pupil.fExponent = ComputeIrisShapeExponent(clamp_tpl(dofParams.fPupilScale, 0.0f, 1.0f), fKernelCurvature);
+		pupil.fPhase = dofParams.fBladeRotation;
+		// N_mask / N: the iris radius in mask units, exactly the number the splat quad and the
+		// gather CDF scale the mask by. Without a mask the pupil is the bare iris polygon.
+		pupil.fIrisRadius = bMaskTex ? max(dofParams.fMaskFNumber, 0.7f) / max(dofParams.fApertureFNumber, 0.7f) : 1.0f;
+		pupil.fMaskRotation = dofParams.fMaskRotation;
+		pupil.fKsa = clamp_tpl(dofParams.fSphericalAberration, -1.0f, 1.0f);
+		pupil.fSaWaves = clamp_tpl(CRenderer::CV_r_HDRDiffractionSAWaves, 0.0f, 2.0f);
+		if (bMaskTex)
+			pupil.maskName = dofParams.pBokehShapeTex->GetName();
+
+		// The kernel is scale free; these two turn it into pixels on the sensor. N is the
+		// GEOMETRIC aperture - the smaller of the two holes light passes - because the pattern's
+		// size on the sensor is lambda * N * d / L and a mask in front of the lens stops the
+		// light down just as the iris does.
+		m_fDiffractionNGeo = max(bMaskTex ? max(dofParams.fApertureFNumber, dofParams.fMaskFNumber)
+		                                  : dofParams.fApertureFNumber, 0.7f);
+		m_fDiffractionSensorWidthMM = max(dofParams.fSensorWidthMM, 1.0f);
+
+		if (CRenderer::CV_r_HDRDiffractionKernel != 0)
+			m_diffraction.Request(pupil);
+
+		// Uploads a finished job, never waits for one. The render thread keeps drawing with the
+		// previous kernel until the new one lands, which is why a blade-rotation pull cannot hitch.
+		m_diffraction.Update(m_graphicsPipeline.GetUniqueIdentifierName().c_str());
+	}
