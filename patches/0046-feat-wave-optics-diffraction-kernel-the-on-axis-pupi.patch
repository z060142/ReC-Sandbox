+// Copyright 2015-2021 Crytek GmbH / Crytek Group. All rights reserved.
+
+#pragma once
+
+// Wave-optics diffraction kernel (DiffractionKernelSpec.md).
+//
+// The glare of a point source is the Fraunhofer diffraction pattern of the pupil it passed
+// through: I(u) = |F{A}|^2, with A the pupil's complex amplitude. Everything the analytic
+// streaks approximate by drawing lines - ray count from the blade count, the way a rounded
+// blade softens and shortens the rays, what a shape mask throws instead of a star, the halo an
+// aberrated pupil puts around the core - falls out of that one transform for free.
+//
+// The transform is a 512^2 CPU FFT, which is 10-30 ms of work: far too much for the render
+// thread, and unnecessary every frame, because the pattern depends only on the pupil's SHAPE.
+// The f-number does NOT enter here at all - it is the pattern's SCALE on the sensor
+// (s = lambda * N * d / L), applied by the pixel shader. So the kernel is built by a job,
+// double buffered, and rebuilt only when the shape actually changes.
+//
+// This owns no rendering: it produces two small textures (the kernel and its boundary ring)
+// plus the scalars the sprite pass needs to place and normalise them.
+
+#include <CryThreading/IJobManager.h>
+
+#include <string>
+#include <vector>
+
+class CTexture;
+
+//! Everything the pupil's SHAPE depends on. Quantised by Request(), so a smooth aperture or
+//! blade-rotation pull rebuilds in steps instead of every frame. Note what is NOT here: the
+//! f-number. The kernel is computed in the pupil's own units and N only scales it on screen.
+struct SDiffractionPupilDesc
+{
+	int         nGridSize = 512;    //!< L, the complex grid the FFT runs on. 256 is 4x cheaper.
+	float       fBlades = 8.0f;     //!< Iris blade count; the polygon NGon_Rad is evaluated for.
+	float       fExponent = 1.0f;   //!< Iris polygon exponent (1 = the true convex n-gon, 0 = a circle).
+	float       fPhase = 0.0f;      //!< Blade rotation, radians.
+	float       fIrisRadius = 1.0f; //!< N_mask / N: the iris radius in MASK units. 1 when no mask.
+	float       fMaskRotation = 0.0f; //!< Mask rotation, radians. The mask is its own element.
+	float       fKsa = 0.0f;        //!< Spherical aberration, -1..1. Enters as a PHASE error.
+	float       fSaWaves = 0.25f;   //!< Wavefront error in waves at |k_sa| = 1.
+	std::string maskName;           //!< Shape mask texture, or empty.
+
+	bool operator==(const SDiffractionPupilDesc& rhs) const
+	{
+		return nGridSize == rhs.nGridSize
+		       && fBlades == rhs.fBlades && fExponent == rhs.fExponent && fPhase == rhs.fPhase
+		       && fIrisRadius == rhs.fIrisRadius && fMaskRotation == rhs.fMaskRotation
+		       && fKsa == rhs.fKsa && fSaWaves == rhs.fSaWaves && maskName == rhs.maskName;
+	}
+	bool operator!=(const SDiffractionPupilDesc& rhs) const { return !(*this == rhs); }
+};
+
+//! Reads the R channel of an uncompressed 32-bit DDS through CryPak. THE one raw mask reader:
+//! the DOF stage's gather CDF and the diffraction pupil are two views of the same shape mask,
+//! and a second copy of this parser would be a second set of accepted formats.
+//! Returns false and fills szFail with a one-line reason on anything it cannot use.
+bool ReadShapeMaskDDS(const char* szTexName, std::vector<uint8>& outPixels, int& outWidth, int& outHeight, const char*& szFail);
+
+class CDiffractionKernel
+{
+public:
+	CDiffractionKernel() {}
+	~CDiffractionKernel() { Shutdown(); }
+
+	//! Ask for a kernel for this pupil. Quantises, compares against what is built and what is
+	//! being built, and spawns the job when it differs. At most one job is ever in flight; a
+	//! request arriving while one runs is remembered and started when that one lands.
+	void Request(const SDiffractionPupilDesc& desc);
+
+	//! Once per frame from the render thread. Uploads a finished job's result and starts the
+	//! queued request, if any. Never blocks.
+	void Update(const char* szNameSuffix);
+
+	//! Waits for the job and drops everything. Called on shutdown and on a resize.
+	void Shutdown();
+
+	//! Null until the first job has landed. The pass draws nothing while it is null rather than
+	//! falling back to the analytic lines, which would flash for a frame or two on every change.
+	CTexture* GetKernelTexture() const { return m_pTexKernel; }
+	CTexture* GetRingTexture() const   { return m_pTexRing; }
+
+	int   GetGridSize() const      { return m_builtDesc.nGridSize; }
+	//! Radius, in kernel texels, out to which the TEXTURE is valid. Past it the pixel shader
+	//! extrapolates with the edge-diffraction law off the boundary ring.
+	float GetRingRadius() const    { return m_fRingRadius; }
+	//! Kernel texel pitch on the sensor, divided by lambda * N: pitch = lambda * N * this.
+	//! (It is just d / L, but naming the physics is what stops it being "re-simplified".)
+	float GetTexelPitchPupilUnits() const { return m_fTexelPitchPupilUnits; }
+	//! Integral of the kernel INSIDE the texture, in texel^2 units.
+	float GetTextureIntegral() const { return m_fTextureIntegral; }
+	//! Energy in the extrapolated 1/u^2 tail per unit of ln(R_sprite / R_tex) - the tail is
+	//! logarithmic, so its total depends on where the sprite cuts it off, which only the
+	//! renderer knows. Integral + this * ln(R_sprite / R_tex) is what the deposit normalises by.
+	float GetTailCoefficient() const { return m_fTailCoefficient; }
+	//! Fraction of the pupil's transmitted light that sat in the removed core (~0.9 for a round
+	//! pupil). Diagnostic only: the frame already carries the source itself.
+	float GetCoreFraction() const { return m_fCoreFraction; }
+
+	bool  IsReady() const { return m_pTexKernel != nullptr && m_pTexRing != nullptr; }
+
+	//! Job entry point. Public because the job delegator calls it through a free function.
+	void  BuildJob();
+
+private:
+	void  StartJob(const SDiffractionPupilDesc& desc);
+	bool  AcquireMask(const std::string& name);
+	void  UploadResult(const char* szNameSuffix);
+	void  ReleaseTextures();
+
+	// --- render thread only ---
+	SDiffractionPupilDesc m_builtDesc;                //!< what the live textures hold
+	SDiffractionPupilDesc m_queuedDesc;               //!< newest request while a job runs
+	bool                  m_bHasQueued = false;
+	bool                  m_bJobPosted = false;
+	bool                  m_bBuiltValid = false;
+
+	CTexture*             m_pTexKernel = nullptr;
+	CTexture*             m_pTexRing = nullptr;
+
+	float                 m_fRingRadius = 0.0f;
+	float                 m_fTexelPitchPupilUnits = 0.5f;
+	float                 m_fTextureIntegral = 1.0f;
+	float                 m_fTailCoefficient = 0.0f;
+	float                 m_fCoreFraction = 0.0f;
+
+	// --- shared with the job; touched by the render thread only while it is not running ---
+	JobManager::SJobState m_jobState;
+	SDiffractionPupilDesc m_jobDesc;
+	std::vector<uint8>    m_jobMaskPixels;            //!< R channel, read on the render thread
+	int                   m_jobMaskWidth = 0;
+	int                   m_jobMaskHeight = 0;
+
+	std::vector<uint16>   m_resultKernel;             //!< L*L, R16F, sqrt-encoded
+	std::vector<uint16>   m_resultRing;               //!< kRingBins, R16F, sqrt-encoded
+	float                 m_resultIntegral = 1.0f;
