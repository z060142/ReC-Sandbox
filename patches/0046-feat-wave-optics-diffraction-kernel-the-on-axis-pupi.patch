@@ -364,6 +323,51 @@ void CDepthOfFieldStage::Execute()
 	CDepthOfField* pDofRenderTech = (CDepthOfField*)PostEffectMgr()->GetEffect(EPostEffectID::DepthOfField);
 	SDepthOfFieldParams dofParams = pDofRenderTech->GetParams();
 
+	// ---------------------------------------------------------------------------------------
+	// Wave-optics glare kernel (DiffractionKernelSpec.md). Resolved and ticked BEFORE the depth
+	// of field's own early-out: the glare of a point source is the diffraction pattern of the
+	// pupil whether or not anything in the frame is out of focus, so a camera at hyperfocal
+	// distance must still get its sunstars. The bloom stage reads the finished kernel through
+	// GetDiffractionKernel(); nothing about it travels as a post param.
