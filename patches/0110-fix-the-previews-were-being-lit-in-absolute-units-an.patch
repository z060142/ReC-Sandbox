+++ b/Code/CryEngine/RenderDll/Common/RendererResources.cpp
@@ -463,7 +463,62 @@ ETEX_Format CRendererResources::GetDisplayFormat()
 // per-frame, per-camera data and the bus already has the reset/handover semantics for it), and
 // r_SceneReferred ANDs it away. When this returns false not one line of the scene-referred work
 // runs and every target, pass and constant keeps its stock value.
+// The pipeline gate (research/s8-editor-pipelines.md, decisions/s8-preview-gate.md). Set once per
+// render view on the render thread by CD3D9Renderer::LatchSceneReferredExposure(), read by every
+// scene-referred site through IsSceneReferred(). Default OPEN so that any render that somehow
+// reaches a gated site without passing the latch behaves exactly as it did before this gate
+// existed - the gate can only ever take work AWAY from a render, never add it.
+static bool        s_bSceneReferredPipelineGate = true;
+static const char* s_szSceneReferredPipelineName = "";
+static bool        s_bSceneReferredGateLogged = false;
+static bool        s_bSceneReferredGateLoggedState = true;
+static std::string s_sSceneReferredGateLoggedName;
+
+void CRendererResources::SetSceneReferredPipelineGate(bool bOpen, const char* szPipelineName, const char* szReason)
+{
+	s_bSceneReferredPipelineGate = bOpen;
+	s_szSceneReferredPipelineName = szPipelineName ? szPipelineName : "";
+
+	// One line per decision, not per frame: the pair (pipeline, verdict) is what a user needs to
+	// see once when a preview stops being pre-exposed, and it is what a bug report needs to carry.
+	// It is only interesting while the camera is actually asking for the path.
+	if (!IsSceneReferredRequested())
+		return;
+
+	if (s_bSceneReferredGateLogged &&
+	    s_bSceneReferredGateLoggedState == bOpen &&
+	    s_sSceneReferredGateLoggedName == s_szSceneReferredPipelineName)
+		return;
+
+	s_bSceneReferredGateLogged = true;
+	s_bSceneReferredGateLoggedState = bOpen;
+	s_sSceneReferredGateLoggedName = s_szSceneReferredPipelineName;
+
+	CryLogAlways("[SceneReferred] pipeline '%s' scene-referred: %s (%s)",
+	             s_szSceneReferredPipelineName, bOpen ? "yes" : "no", szReason ? szReason : "");
+}
+
+bool CRendererResources::IsSceneReferredPipelineGateOpen()
+{
+	return s_bSceneReferredPipelineGate;
+}
+
+const char* CRendererResources::GetSceneReferredPipelineName()
+{
+	return s_szSceneReferredPipelineName;
+}
+
 bool CRendererResources::IsSceneReferred()
+{
+	// The gate first: it is a plain bool and it is false for every preview, thumbnail and minimap
+	// render, so the common editor case exits here without touching the parameter bus at all.
+	if (!s_bSceneReferredPipelineGate)
+		return false;
+
+	return IsSceneReferredRequested();
+}
+
+bool CRendererResources::IsSceneReferredRequested()
 {
 	if (CRenderer::CV_r_SceneReferred == 0)
 		return false;
@@ -495,6 +550,12 @@ bool CRendererResources::IsSceneReferredStage(int nStage)
 	return IsSceneReferred() && CRenderer::CV_r_SceneReferredStage >= nStage;
 }
 
+// The un-gated twin, for the world-shaped decisions. See the header.
+bool CRendererResources::IsSceneReferredRequestedStage(int nStage)
+{
+	return IsSceneReferredRequested() && CRenderer::CV_r_SceneReferredStage >= nStage;
+}
