+		// ApplyBakeCascaded is the last thing RegenerateMesh does and the guard above turns the inner call
+		// into a plain ApplyBake. It costs one extra mesh generation and buys the guarantee that every
+		// plate in the set, the seed included, is welded against the ground it actually ends up on.
+		pPlate->RegenerateMesh();
+		pPlate->m_lastBakeProbeFrameId = gEnv->nMainFrameID;
