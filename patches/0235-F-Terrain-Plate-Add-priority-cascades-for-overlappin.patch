+//! Bake probing: how far apart the watched cells are, in terrain units. Nine probes over a large
+//! footprint leave tens of metres between them, so a sculpt through the middle of a big plate can sit
+//! entirely between two of them and never be noticed - the gap this closes (decision 04 step 3).
+int    g_terrainPlateBakeProbeSpacing = 4;
+ICVar* g_pTerrainPlateBakeProbeSpacingCVar = nullptr;
+
+//! Every terrain plate component that is alive, registered in Initialize and removed in the destructor.
+//! That is the whole "registry" the overlap cascade needs: it follows component add / remove, entity
+//! delete and level unload by construction, and needs no level or editor hook to stay correct.
+std::vector<CTerrainPlateComponent*> g_terrainPlates;
+
+//! Greater than zero while an overlap cascade is running. Everything a cascade does - restoring,
+//! regenerating, baking - writes the terrain and would otherwise start another cascade from inside
+//! itself, and would trip every other plate's polling. One guard covers both.
+int  g_bakeCascadeDepth = 0;
+//! Frame of the last completed cascade. The polling skips that frame, so N plates that all see the
+//! terrain move in the same frame produce one cascade between them, not N.
+uint32 g_bakeCascadeFrameId = ~0u;
+//! Never restore and re-bake more than this many plates in one cascade. Unreal caps its landscape edit
+//! layers at 8 for the same reason; the cost here is one mesh regeneration plus one SetTerrainElevation
+//! per plate, so the cap is about a runaway configuration, not about the normal case.
+const size_t kBakeCascadeMaxPlates = 16;
 
