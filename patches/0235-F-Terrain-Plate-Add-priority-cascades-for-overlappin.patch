+		if (pPlate != this)
+		{
+			pPlate->LogBakeOverlapOnce(*this);
+			LogBakeOverlapOnce(*pPlate);
+		}
+	}
+
+	--g_bakeCascadeDepth;
+
+	// Coalescing: the cascade just rewrote the terrain under every plate in the set, and it may well have
+	// touched a sector a plate outside the set also watches. Remembering the frame lets the polling stand
+	// down for it, so N plates seeing the same terrain change produce one cascade between them, not N.
+	g_bakeCascadeFrameId = gEnv->nMainFrameID;
+
+	if (GetTerrainIntegrateDebugLevel() >= 1)
 	{
-		g_bakingPlates.erase(it);
+		CryLog("TerrainPlate '%s': overlap cascade over %d plates, restored highest priority first and re-baked lowest priority first",
+		       (m_pEntity != nullptr) ? m_pEntity->GetName() : "?", (int)affected.size());
 	}
 }
 
