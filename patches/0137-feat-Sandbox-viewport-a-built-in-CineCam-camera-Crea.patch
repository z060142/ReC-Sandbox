+namespace Private_CineCamPreview
+{
+//! Personalization module / key holding the Default vs CineCam choice of the built-in fly camera.
+const char* const szPersonalizationModule = "LevelEditorViewport";
+const char* const szPersonalizationKey = "CineCamCamera";
+
+//! GUID of CCinematicCameraComponent (Code/CryPlugins/CinematicCamera/Module/CinematicCameraComponent.h).
+//! Hard-coded so that the editor does not depend on the plugin being present.
+const CryGUID cinematicCameraComponentGUID = "{F2A3B4C5-D6E7-4F8A-B9C0-1D2E3F4A5B6C}"_cry_guid;
+
+//! Resolves the editor preview interface of the CinematicCamera plugin the same way CryPhoneTracker
+//! resolves CryGetCinematicCameraOptics. Returns nullptr when the plugin is not part of the project,
+//! in which case the viewport behaves exactly like stock.
+ICineCamEditorPreview* GetPreview()
+{
+	static bool s_resolved = false;
+	static TGetCineCamEditorPreviewFn s_pfn = nullptr;
+
+	if (!s_resolved)
+	{
+		s_resolved = true;
+		if (HMODULE hModule = CryLoadLibraryDefName("CinematicCamera"))
+		{
+			s_pfn = (TGetCineCamEditorPreviewFn)CryGetProcAddress(hModule, CINECAM_EDITOR_PREVIEW_ENTRY);
+		}
+	}
+
+	// The entry point itself may return nullptr until the plugin is up, so it is called every time.
+	return s_pfn != nullptr ? s_pfn() : nullptr;
+}
+}
