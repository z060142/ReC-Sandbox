+void CLevelEditorViewport::LoadCineCamPersonalization()
+{
+	if (CPersonalizationManager* pPersonalizationManager = GetIEditorImpl()->GetPersonalizationManager())
+	{
+		const QVariant& value = pPersonalizationManager->GetProperty(Private_CineCamPreview::szPersonalizationModule, Private_CineCamPreview::szPersonalizationKey);
+		if (value.isValid())
+		{
+			m_bCineCamMode = value.toBool();
+		}
+	}
+}
+
+void CLevelEditorViewport::SaveCineCamPersonalization() const
+{
+	if (CPersonalizationManager* pPersonalizationManager = GetIEditorImpl()->GetPersonalizationManager())
+	{
+		pPersonalizationManager->SetProperty(Private_CineCamPreview::szPersonalizationModule, Private_CineCamPreview::szPersonalizationKey, m_bCineCamMode);
+	}
+}
+
+void CLevelEditorViewport::SetDefaultFlyCamera()
+{
+	m_bCineCamMode = false;
+	SaveCineCamPersonalization();
+	SetDefaultCamera();
+}
+
+void CLevelEditorViewport::SetCineCamFlyCamera()
+{
+	m_bCineCamMode = true;
+	SaveCineCamPersonalization();
+	SetDefaultCamera();
+}
+
+void CLevelEditorViewport::PushCineCamPreview(EntityId previewEntity)
+{
+	// Only the level editor's main perspective viewport drives the preview.
+	if (GetType() != ET_ViewportCamera || !gEnv->IsEditing())
+	{
+		ClearCineCamPreview();
+		return;
+	}
+
+	ICineCamEditorPreview* pPreview = Private_CineCamPreview::GetPreview();
+	if (pPreview == nullptr)
+	{
+		return;
+	}
+
+	ECineCamEditorPreviewMode mode = ECineCamEditorPreviewMode::Default;
+	if (previewEntity != INVALID_ENTITYID)
+	{
+		mode = ECineCamEditorPreviewMode::Entity;
+	}
+	else if (m_bCineCamMode && IsDefaultCamera())
+	{
+		mode = ECineCamEditorPreviewMode::CineCam;
+	}
+
+	pPreview->SetViewportPreview(mode, previewEntity, m_Camera);
+	m_bCineCamPreviewPushed = true;
+}
+
+void CLevelEditorViewport::ClearCineCamPreview()
+{
+	if (!m_bCineCamPreviewPushed)
+	{
+		return;
+	}
+
+	m_bCineCamPreviewPushed = false;
+
+	if (ICineCamEditorPreview* pPreview = Private_CineCamPreview::GetPreview())
+	{
+		pPreview->ClearViewportPreview();
+	}
+}
