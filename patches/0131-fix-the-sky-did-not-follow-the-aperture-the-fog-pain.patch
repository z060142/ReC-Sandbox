diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Sky.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Sky.cpp
index 405ba768..005609de 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Sky.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Sky.cpp
@@ -167,6 +167,14 @@ void CSkyStage::SetSkyParameters()
 		static CCryNameR skyPeakClampName("SkyDome_ScenePeakClamp");
 		const float skyPeakClamp = CRendererResources::GetSceneReferredSkyPeakClamp(sceneExposure);
 		m_skyPass.SetConstant(skyPeakClampName, Vec4(skyPeakClamp, 0.0f, 0.0f, 0.0f), eHWSC_Pixel);
+
+		// For r_HDRDebug 1: what this pass is about to do, recorded from the values it uploads.
+		// The dome numbers are filled in by SetHDRSkyParameters() below when the dome runs.
+		m_srDebug = SSceneReferredDebug();
+		m_srDebug.bProcedural     = rd->m_p3DEngineCommon[threadID].m_SkyInfo.m_bApplySkyDome;
+		m_srDebug.bSkybox         = rd->m_p3DEngineCommon[threadID].m_SkyInfo.m_bApplySkyBox;
+		m_srDebug.exposureApplied = sceneExposure;
+		m_srDebug.peakCapExposed  = skyPeakClamp;
 	}
 
 	// Skybox
@@ -214,6 +222,54 @@ void CSkyStage::SetHDRSkyParameters()
 		m_skyPass.SetConstant(rayleighName, renderParams->m_partialRayleighInScatteringConst * sceneExposure, eHWSC_Pixel);
 		m_skyPass.SetConstant(sunDirectionName, renderParams->m_sunDirection, eHWSC_Pixel);
 		m_skyPass.SetConstant(phaseName, renderParams->m_phaseFunctionConsts, eHWSC_Pixel);
+
+		// r_HDRDebug 1: the dome evaluated on the CPU at two directions, with the same arithmetic
+		// SkyPassPS uses (Stars.cfx, "Day sky gradient"), so the overlay can print what the dome
+		// is worth in UNEXPOSED cd/m2 and what it lands at in the target. The texel layout is the
+		// one CSkyLightManager::UpdateInternal writes: row = angle from the zenith in steps of
+		// 90/height degrees, column = azimuth in steps of 360/width degrees, so straight up is
+		// texel 0 and the sun is at skyDir = -m_sunDirection (the phase peaks at cosine = +1).
+		// Reading the dome data here is safe: Execute() already reads the same pointers for the
+		// texture upload, on this thread, this frame.
+		if (CRendererResources::IsSceneReferredStage(2) && renderParams->m_pSkyDomeTextureDataMie && renderParams->m_pSkyDomeTextureDataRayleigh)
+		{
+			const CryHalf4* const pMie = static_cast<const CryHalf4*>(renderParams->m_pSkyDomeTextureDataMie);
+			const CryHalf4* const pRay = static_cast<const CryHalf4*>(renderParams->m_pSkyDomeTextureDataRayleigh);
+			const Vec3 sunDir(renderParams->m_sunDirection.x, renderParams->m_sunDirection.y, renderParams->m_sunDirection.z);
+			const Vec3 mieConst(renderParams->m_partialMieInScatteringConst.x, renderParams->m_partialMieInScatteringConst.y, renderParams->m_partialMieInScatteringConst.z);
+			const Vec3 rayConst(renderParams->m_partialRayleighInScatteringConst.x, renderParams->m_partialRayleighInScatteringConst.y, renderParams->m_partialRayleighInScatteringConst.z);
+			const float miePart_g_2 = renderParams->m_phaseFunctionConsts.x;
+			const float miePart_g2_1 = renderParams->m_phaseFunctionConsts.y;
+
+			const auto evalDome = [&](int texel, const Vec3& skyDir) -> float
+			{
+				const Vec3 mie(CryConvertHalfToFloat(pMie[texel].x), CryConvertHalfToFloat(pMie[texel].y), CryConvertHalfToFloat(pMie[texel].z));
+				const Vec3 ray(CryConvertHalfToFloat(pRay[texel].x), CryConvertHalfToFloat(pRay[texel].y), CryConvertHalfToFloat(pRay[texel].z));
+				const float cosine = -sunDir.Dot(skyDir);
+				const float cosine2 = cosine * cosine;
+				const float miePhaseTmp = miePart_g2_1 + miePart_g_2 * cosine;
+				const float miePhase = (miePhaseTmp > 0.0f) ? (1.0f + cosine2) * powf(miePhaseTmp, -1.5f) : 0.0f;
+				const float rayleighPhase = 0.75f * (1.0f + cosine2);
+				const Vec3 c = mie.CompMul(mieConst) * miePhase + ray.CompMul(rayConst) * rayleighPhase;
+				return 0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z; // Rec.709 luminance, unexposed engine units
+			};
+
+			const float zenith = evalDome(0, Vec3(0.0f, 0.0f, 1.0f));
+			m_srDebug.zenithNits = zenith * RENDERER_LIGHT_UNIT_SCALE;
+			m_srDebug.zenithExposed = zenith * sceneExposure;
+
+			const Vec3 toSun = -sunDir.GetNormalizedSafe(Vec3(0.0f, 0.0f, -1.0f));
+			if (toSun.z > 0.0f)
+			{
+				const float fromZenithDeg = RAD2DEG(acosf(clamp_tpl(toSun.z, -1.0f, 1.0f)));
+				float azimuthDeg = RAD2DEG(atan2f(toSun.y, toSun.x));
+				if (azimuthDeg < 0.0f) azimuthDeg += 360.0f;
+				const int row = clamp_tpl((int)(fromZenithDeg * SSkyLightRenderParams::skyDomeTextureHeight / 90.0f + 0.5f), 0, SSkyLightRenderParams::skyDomeTextureHeight - 1);
+				const int col = ((int)(azimuthDeg * SSkyLightRenderParams::skyDomeTextureWidth / 360.0f + 0.5f)) % SSkyLightRenderParams::skyDomeTextureWidth;
+				const float sunPeak = evalDome(row * SSkyLightRenderParams::skyDomeTextureWidth + col, toSun) * sceneExposure;
+				m_srDebug.sunPeakExposed = (m_srDebug.peakCapExposed > 0.0f) ? min(sunPeak, m_srDebug.peakCapExposed) : sunPeak;
+			}
+		}
 	}
 
 	// Night sky
