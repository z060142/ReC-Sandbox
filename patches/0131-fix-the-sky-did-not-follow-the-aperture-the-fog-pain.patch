--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/VolumetricClouds.cpp
@@ -1510,6 +1510,13 @@ void CVolumetricCloudsStage::GenerateCloudShaderParam(::VCCloudRenderContext& co
 			cb.frustumBL = Vec4(vLB.x, vLB.y, vLB.z, 0.0f);
 
 			gEnv->p3DEngine->GetGlobalParameter(E3DPARAM_SKYLIGHT_RAYLEIGH_INSCATTER, cb.skylightRayleighInScatter);
+			// The cloud's SKY light is the Nishita dome's horizon Rayleigh radiance
+			// (3DEngineRender.cpp: hazeColorRayleighNoPremul x partialRayleighInScatteringConst), in
+			// engine units - the same class of quantity as shadeColorFromSun below, and it was
+			// missed when that one took the exposure. Without it a cloud's sky-lit half sits at the
+			// old brightness while its sun-lit half and the dome behind it follow the aperture.
+			// Exactly 1.0 off the switch.
