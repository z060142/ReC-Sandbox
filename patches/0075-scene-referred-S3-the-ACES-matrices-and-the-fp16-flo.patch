 Engine/Shaders/HWScripts/CryFX/CommonMath.cfi | 120 ++++++++++++++++++
 3 files changed, 206 insertions(+), 1 deletion(-)

diff --git a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp
index d2d2e5df..b07674a1 100644
--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/Common/GraphicsPipeline.cpp
@@ -228,6 +228,28 @@ static ETEX_Format ResolveHDRSatelliteFormat()
 	return CRendererResources::GetHDRFormat(false, true);
 }
 
+// The same floor for the MAIN HDR target and its three scaled siblings, which take the "high
+// quality" alias and are therefore fp16 already at the registered default r_HDRTexFormat 1 - but
+// R11G11B10F at r_HDRTexFormat 0. That target IS the working space: the 709 -> AP1 conversion
+// writes it in place and every post effect reads it from there, so a user typing
+// "r_HDRTexFormat 0" would put the whole scene-referred chain in an unsigned 11:11:10 buffer.
+// 709 -> AP1 alone produces no negatives (Rec.709's primaries lie inside AP1), so S3 by itself
+// would survive it - but S4's CDL and any LMT legitimately can, and then the sign bit matters.
+//
+// Same shape as the satellites: effective = max(cvar, sceneReferred ? 2 : 0), decided HERE rather
+// than inside CRendererResources::GetHDRFormat(), which is engine-wide. With the switch off this
+// is a straight pass-through to the stock helper, and at the default cvar value it is a no-op on
+// both paths, which is why this costs nothing in practice and closes the hole anyway.
+static ETEX_Format ResolveHDRMainFormat()
+{
+	const int effective = std::max(CRenderer::CV_r_HDRTexFormat, CRendererResources::IsSceneReferred() ? 2 : 0);
+
+	if (effective >= 1)
+		return eTF_R16G16B16A16F;
+
+	return CRendererResources::GetHDRFormat(false, false);
+}
+
 void CGraphicsPipelineResources::CreateHDRMaps(int resourceWidth, int resourceHeight)
 {
 	m_renderTargetPool.ClearRenderTargetList();
@@ -237,7 +259,7 @@ void CGraphicsPipelineResources::CreateHDRMaps(int resourceWidth, int resourceHe
 	uint32 nHDRTargetFlags = FT_DONT_RELEASE;
 	uint32 nHDRTargetFlagsUAV = nHDRTargetFlags | (FT_USAGE_UNORDERED_ACCESS);  // UAV required for tiled deferred shading
 
-	const ETEX_Format nHDRFormat = CRendererResources::GetHDRFormat(false, false); // No alpha, default is HiQ, can be downgraded
+	const ETEX_Format nHDRFormat = ResolveHDRMainFormat();                         // No alpha, default is HiQ, can be downgraded - forced to fp16 on the scene-referred path
 	const ETEX_Format nHDRQFormat = ResolveHDRSatelliteFormat();                   // No alpha, default is LoQ, can be upgraded - forced to fp16 on the scene-referred path
 	const ETEX_Format nHDRAFormat = CRendererResources::GetHDRFormat(true, false); // With alpha
 	
@@ -521,6 +543,63 @@ void CGraphicsPipelineResources::UpdateHDRSatelliteFormats()
 	       (double(sizeAfter) - double(sizeBefore)) / (1024.0 * 1024.0));
 }
 
+// The main HDR target and its three scaled siblings, on exactly the same terms as the satellites
+// above (SceneReferredSpec.md S3): the objects stay alive and only their device texture is
+// swapped, because $HDRTarget is bound as a UAV by CTiledShadingStage behind a caustics / SVO /
+// AO dirty key, as a render target by a dozen stages and as an ESRAM resident by the pipeline
+// itself - releasing it would strand every one of those bindings.
+//
+// All four or none: the scaled pair is produced from the main target by the half- and
+// quarter-resolution downsamples and consumed by auto exposure, bloom and the sun shafts, so a
+// mixed set would put a precision cliff in the middle of the glare chain.
+//
+// At the registered default (r_HDRTexFormat 1) this never fires on either path - the format is
+// already fp16 - so it exists to close the r_HDRTexFormat 0 hole, not to change the normal case.
+void CGraphicsPipelineResources::UpdateHDRMainFormats()
+{
+	const ETEX_Format wanted = ResolveHDRMainFormat();
+
+	CTexture* const mains[] =
+	{
+		m_pTexHDRTarget,
+		m_pTexHDRTargetScaled[0][0],
+		m_pTexHDRTargetScaled[1][0],
+		m_pTexHDRTargetScaled[1][1],
+	};
+
+	uint64 sizeBefore = 0;
+	bool bMismatch = false;
+	for (CTexture* pTex : mains)
+	{
+		if (!pTex)
+			continue;
+
+		sizeBefore += pTex->GetDeviceDataSize();
+		bMismatch |= (pTex->GetDstFormat() != wanted);
+	}
+
+	if (!bMismatch)
+		return;
+
+	uint64 sizeAfter = 0;
+	for (CTexture* pTex : mains)
+	{
+		if (!pTex)
+			continue;
+
+		if (pTex->GetDstFormat() != wanted)
+			pTex->ReformatRenderTarget(wanted);
+
+		sizeAfter += pTex->GetDeviceDataSize();
+	}
+
+	CryLog("[SceneReferred] HDR main targets -> %s at %dx%d; %.1f MiB -> %.1f MiB (%+.1f MiB)",
+	       (wanted == eTF_R16G16B16A16F) ? "R16G16B16A16F" : "R11G11B10F",
+	       m_resourceWidth, m_resourceHeight,
+	       sizeBefore / (1024.0 * 1024.0), sizeAfter / (1024.0 * 1024.0),
+	       (double(sizeAfter) - double(sizeBefore)) / (1024.0 * 1024.0));
+}
+
 // Re-format the five scaled display targets when the scene-referred switch flips
 // (SceneReferredSpec.md S2, decisions/s2-sun-shafts.md approach A).
 //
@@ -600,6 +679,7 @@ void CGraphicsPipelineResources::Update(EShaderRenderingFlags renderingFlags)
 	// for a stage to manage or retire resources - it runs on the render thread, before
 	// CompileModifiedRenderObjects() and before Execute(), so nothing is bound yet - and the
 	// rain occlusion texture right below is created and released on demand in the same way.
+	UpdateHDRMainFormats();
 	UpdateHDRSatelliteFormats();
 	UpdateDisplayTargetScaledFormats();
 
