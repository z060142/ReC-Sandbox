@@ -142,6 +142,11 @@ public:
 	void OnCVarsChanged(const CCVarUpdateRecorder& rCVarRecs);
 	void Update(EShaderRenderingFlags renderingFlags);
 
+	//! Scene-referred pipeline (SceneReferredSpec.md S3): re-format the main HDR target and its
