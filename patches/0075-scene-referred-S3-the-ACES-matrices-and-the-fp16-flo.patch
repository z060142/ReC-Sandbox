+////////////////////////////////////////////////////////////////////////////////////////////////////
+// ACES working space (SceneReferredSpec.md D5, Stage S3)
+//
+// Linear Rec.709 (sRGB primaries, D65) <-> ACEScg (AP1 primaries, ACES D60), chromatic adaptation
+// by BRADFORD. The adaptation is the load-bearing part: without it a neutral grey would come out
+// tinted, because the two spaces do not share a white point. With it, (1,1,1) maps to (1,1,1).
+//
+// These are STANDARDS, not tuning: Rec.709, AP1, D65, D60 and Bradford are each fixed by their
+// own specification, so there is no scene, camera or user parameter in these numbers. They are
+// exact double-precision operator parameters read out of OCIO's own transform, NOT sampled
+// through a float32 processor.
+//
+//   Bradford-adapted, verified against PyOpenColorIO 2.5, tools/ocio-bake/verify_matrices.py
+//   (config ocio://studio-config-latest = studio-config-v4.0.0_aces-v2.0_ocio-v2.5).
+//   Re-run that script if any digit here is ever in doubt; it fails with a per-entry diff.
+//
+// Two properties worth knowing before using them:
+//  1. REC709_TO_ACESCG is entirely NON-NEGATIVE - Rec.709's primaries lie inside AP1 - so no
+//     non-negative Rec.709 colour can produce a negative AP1 component. That is what makes the
+//     spec's "AP1-encoded negatives never appear" a VERIFICATION that the matrix was applied
+//     correctly rather than a hazard of the transform. The inverse IS signed, which is why
+//     anything going back to Rec.709 needs a float buffer.
+//  2. The matrix does not change any colour, only its coordinates: a Rec.709 (1,0,0) becomes
+//     (0.6131, 0.0702, 0.0206). Every threshold that compares against an absolute constant
+//     therefore sees a different number even though the light did not change. Re-deriving those
+//     constants is D11 / Stage S7 and must NOT be mixed into the primaries change.
+//
+// Unlike every transfer function below, these must NEVER acquire a saturate(): they operate on
+// scene-referred values with no upper bound.
+static const float3x3 REC709_TO_ACESCG =
+{
+	 0.61309740f,  0.33952315f,  0.04737945f,
+	 0.07019372f,  0.91635388f,  0.01345240f,
+	 0.02061559f,  0.10956977f,  0.86981463f
+};
+
+static const float3x3 ACESCG_TO_REC709 =
+{
+	 1.70505099f, -0.62179212f, -0.08325887f,
+	-0.13025642f,  1.14080474f, -0.01054832f,
+	-0.02400336f, -0.12896898f,  1.15297233f
+};
+
+float3 Rec709ToACEScg(float3 col)
+{
+	return mul(REC709_TO_ACESCG, col);
+}
+
+float3 ACEScgToRec709(float3 col)
+{
+	return mul(ACESCG_TO_REC709, col);
+}
+
+// The Y row of the AP1 -> CIE XYZ (D60) matrix; the three weights sum to exactly 1.0. This is the
+// luminance of an ACEScg value, and it is NOT GetLuminanceWeights(): compared with Rec.709's
+// (0.2126, 0.7152, 0.0722) red gains about 0.060, green loses 0.041 and blue loses 0.019, so a
+// saturated red source reads roughly 28 % brighter than the 709 weights would say. Applying the
+// 709 weights to AP1 data is the classic silent failure - every threshold and every
+// hue-preserving rescale moves, and nothing errors. Same provenance as the matrices above.
+static const float3 ACESCG_LUMINANCE_WEIGHTS = float3(0.27222872f, 0.67408177f, 0.05368952f);
+
+float ACEScgLuminance(float3 col)
+{
+	return dot(col, ACESCG_LUMINANCE_WEIGHTS);
+}
+
+////////////////////////////////////////////////////////////////////////////////////////////////////
+// ACEScct - the ACES grading log encoding (Stage S4's shaper, defined here so that there is one
+// home for the constants). A pure log curve cannot represent zero, nor the small negatives a
+// wide-gamut grade legitimately produces, so ACEScct replaces the toe with a straight segment
+// that meets the log curve at X_BRK with matching value and slope.
+//
+// Constants read out of OCIO's "CURVE - ACEScct-LOG_to_LINEAR" LogCameraTransform by
+// tools/ocio-bake/verify_matrices.py (base 2, logSideSlope 1/17.52, logSideOffset 9.72/17.52,
+// linSideBreak 2^-7, linearSlope defaulted to the tangent at the break).
+//
+// Landmarks worth remembering: encode(0.18) = 0.41358781 (mid grey), -B/A = -0.00691688 is the
+// most negative linear value the encode still represents, and decode(1.0) = 222.86 - NOT the fp16
+// ceiling. Anything that clamps the shaper output to [0,1] therefore clips at about 223x
+// reference white, roughly +10.3 stops over mid grey.
+#define ACESCCT_X_BRK       0.0078125000f
+#define ACESCCT_Y_BRK       0.1552511416f
+#define ACESCCT_A          10.5402377417f
+#define ACESCCT_B           0.0729055342f
+#define ACESCCT_LOG_OFFSET  9.7200000000f
+#define ACESCCT_LOG_SCALE  17.5200000000f
+
+float LinearToACEScct(float x)
+{
+	return (x < ACESCCT_X_BRK)
+	       ? (ACESCCT_A * x + ACESCCT_B)
+	       : ((log2(x) + ACESCCT_LOG_OFFSET) / ACESCCT_LOG_SCALE);
+}
+
+float3 LinearToACEScct(float3 col)
+{
+	return float3(LinearToACEScct(col.r), LinearToACEScct(col.g), LinearToACEScct(col.b));
+}
+
+float ACEScctToLinear(float y)
+{
+	return (y < ACESCCT_Y_BRK)
+	       ? ((y - ACESCCT_B) / ACESCCT_A)
+	       : exp2(y * ACESCCT_LOG_SCALE - ACESCCT_LOG_OFFSET);
+}
+
+float3 ACEScctToLinear(float3 col)
+{
+	return float3(ACEScctToLinear(col.r), ACEScctToLinear(col.g), ACEScctToLinear(col.b));
+}
+
 // Gamma-Curve / Transfer-function only (no color-space change and no limited ranges)
 half3 LinearToSRGB(half3 col)
 {
@@ -219,6 +330,15 @@ float3 REC2020ToLinear(float3 col)
 	return (col < 0.0812428582986315f) ? col / 4.50f : pow((col + float3(0.09929682680944f, 0.09929682680944f, 0.09929682680944f)) / 1.09929682680944f, 2.4f);
 }
 
+// BROKEN AND UNUSED - left in place deliberately, do not copy it. The opening "float3(" is
+// missing, so it cannot compile; even repaired it is not a matrix multiply (the commas are the
+// comma operator, so each row's three products are never summed) and each row multiplies a
+// different component instead of dotting the whole vector. The coefficients themselves are the
+// correct Rec.709 -> Rec.2020 matrix, which is what makes it dangerous: it looks authoritative.
+// It survives only because nothing references it and the CryFX front end does not emit
+// unreferenced functions. Repairing it would be a stock-path source change with no stock
+// consumer (scene-notes/decisions/s3-working-space.md section 3C); the working colour-matrix
+// code the scene-referred path uses is Rec709ToACEScg() / ACEScgToRec709() above.
 // The color primaries of sRGB and REC709 are the same, REC2020 has distinct color primaries
 float3 Convert_REC709toREC2020(half3 col)
 {
