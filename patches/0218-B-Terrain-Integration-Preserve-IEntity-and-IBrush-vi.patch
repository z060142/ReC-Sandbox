From c3f2b5d7c1f3286c81d8995d6156b3100921c884 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sun, 30 Aug 2026 20:26:03 +0800
Subject: [PATCH 218/307] !B (Terrain Integration) Preserve IEntity and IBrush
 virtual function ordering.

Move the new terrain integration methods to the end of IEntity and IBrush.
Appending the virtuals preserves the indices of existing methods for binary
modules built against the previous interfaces.
---
 .../CryCommon/Cry3DEngine/IRenderNode.h       | 14 +++++++---
 .../CryCommon/CryEntitySystem/IEntity.h       | 28 +++++++++++--------
 2 files changed, 27 insertions(+), 15 deletions(-)

diff --git a/Code/CryEngine/CryCommon/Cry3DEngine/IRenderNode.h b/Code/CryEngine/CryCommon/Cry3DEngine/IRenderNode.h
index 1418445b..03a31e4c 100644
--- a/Code/CryEngine/CryCommon/Cry3DEngine/IRenderNode.h
+++ b/Code/CryEngine/CryCommon/Cry3DEngine/IRenderNode.h
@@ -815,13 +815,19 @@ struct IBrush : public IRenderNode
 	virtual void            DisablePhysicalization(bool bDisable) = 0; //!< This render node will not be physicalized
 	virtual float           GetScale() const = 0;
 
-	//! Per instance parameters of the eGM_IntegrateIntoTerrain mode, @see STerrainIntegrationParams.
-	virtual void                             SetTerrainIntegrationParams(const STerrainIntegrationParams& params) = 0;
-	virtual const STerrainIntegrationParams& GetTerrainIntegrationParams() const = 0;
-
 	// Hide mask disable individual sub-objects rendering in the compound static objects
 	// Only implemented by few nodes.
 	virtual void SetSubObjectHideMask(hidemask subObjHideMask) {}
+
+	//////////////////////////////////////////////////////////////////////////
+	// ABI: new virtual methods MUST be appended here, at the very end of IBrush.
+	// Inserting one anywhere above shifts the vtable index of every method below it, which breaks
+	// every binary that was compiled against the previous header.
+	//////////////////////////////////////////////////////////////////////////
+
+	//! Per instance parameters of the eGM_IntegrateIntoTerrain mode, @see STerrainIntegrationParams.
+	virtual void                             SetTerrainIntegrationParams(const STerrainIntegrationParams& params) = 0;
+	virtual const STerrainIntegrationParams& GetTerrainIntegrationParams() const = 0;
 };
 
 //! \cond INTERNAL
diff --git a/Code/CryEngine/CryCommon/CryEntitySystem/IEntity.h b/Code/CryEngine/CryCommon/CryEntitySystem/IEntity.h
index 70763897..afda22bc 100644
--- a/Code/CryEngine/CryCommon/CryEntitySystem/IEntity.h
+++ b/Code/CryEngine/CryCommon/CryEntitySystem/IEntity.h
@@ -1203,17 +1203,6 @@ public:
 	//! Returns a 3DEngine render node assigned to an Entity Slot.
 	virtual IRenderNode* GetSlotRenderNode(int nSlot) = 0;
 
-	//! Sets the per instance parameters of the eGM_IntegrateIntoTerrain mode for a slot.
-	//! The values are stored on the slot, not on the render node, because the render node is
-	//! recreated whenever the slot geometry changes. @see STerrainIntegrationParams.
-	//! \param nSlot Index of the slot.
-	virtual void SetSlotTerrainIntegrationParams(int nSlot, const STerrainIntegrationParams& params) = 0;
-
-	//! Returns the per instance parameters of the eGM_IntegrateIntoTerrain mode of a slot,
-	//! or the default constructed (= stock behaviour) value if the slot is not valid.
-	//! \param nSlot Index of the slot.
-	virtual const STerrainIntegrationParams& GetSlotTerrainIntegrationParams(int nSlot) const = 0;
-
 	//! Returns the network proxy associated with the entity.
 	//! Use the proxy to modify the entity's network behavior.
 	virtual INetEntity* GetNetEntity() = 0;
@@ -1374,6 +1363,23 @@ public:
 
 		return GetWorldRotation().GetColumn2();
 	}
+
+	//////////////////////////////////////////////////////////////////////////
+	// ABI: new virtual methods MUST be appended here, at the very end of IEntity.
+	// Inserting one anywhere above shifts the vtable index of every method below it, which breaks
+	// every binary that was compiled against the previous header (stock game DLLs, editor plugins).
+	//////////////////////////////////////////////////////////////////////////
+
+	//! Sets the per instance parameters of the eGM_IntegrateIntoTerrain mode for a slot.
+	//! The values are stored on the slot, not on the render node, because the render node is
+	//! recreated whenever the slot geometry changes. @see STerrainIntegrationParams.
+	//! \param nSlot Index of the slot.
+	virtual void SetSlotTerrainIntegrationParams(int nSlot, const STerrainIntegrationParams& params) = 0;
+
+	//! Returns the per instance parameters of the eGM_IntegrateIntoTerrain mode of a slot,
+	//! or the default constructed (= stock behaviour) value if the slot is not valid.
+	//! \param nSlot Index of the slot.
+	virtual const STerrainIntegrationParams& GetSlotTerrainIntegrationParams(int nSlot) const = 0;
 };
 
 typedef IEntity IEntityRender;
