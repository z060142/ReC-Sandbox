+++ b/Code/CryEngine/RenderDll/Common/PostProcess/PostEffects.cpp
@@ -119,6 +119,13 @@ void CDepthOfField::Reset(bool bOnSpecChange)
 	m_pUserEdgeSoftness->ResetParam(0.0f);
 	m_pUserAxialChromatic->ResetParam(0.0f);
 
+	// Lens model off by default: a reset puts the engine back on the stock depth of field, which
+	// is the state every consumer other than the cinematic camera expects to find.
+	m_pUserLensModel->ResetParam(0.0f);
+	m_pUserLensFocal->ResetParam(50.0f);
+	m_pUserSensorWidth->ResetParam(36.0f);
+	m_pUserSphericalAberration->ResetParam(0.0f);
