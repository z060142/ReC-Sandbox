 	};
@@ -168,6 +169,15 @@ struct SDepthOfFieldParams
 	float     fEdgeSoftness;       //!< 0..1 residual off-axis aberration blur, applied as a far-layer circle of confusion floor that grows with the square of the field height and of the pupil radius, so it is strongest wide open and gone stopped down.
 	float     fAxialChromatic;     //!< 0..1 longitudinal chromatic aberration. Each wavelength focuses at its own distance, so the out-of-focus disc has a different size per channel: behind focus red and blue shrink and leave a green rim, in front of it green shrinks and leaves a magenta one. Unlike the lateral kind this is a focus error, so it is as strong in the centre as at the edges.
 
+	// Lens model (DofLensModelSpec.md). The cinematic camera asks for the depth of field to be
+	// driven by the thin lens itself rather than by the engine's focus-range ramp; everything
+	// below is what a thin lens needs and the stock path has never had. Nothing else in the
+	// engine sets bLensModel, so with the component off the renderer takes the stock branches.
+	bool      bLensModel;          //!< The component requested the lens model. Gated again by r_DepthOfFieldLensModel.
+	float     fLensFocalMM;        //!< Effective focal length in mm, breathing and servo zoom included.
+	float     fSensorWidthMM;      //!< Sensor width in mm - what maps the circle of confusion from the sensor onto the frame.
+	float     fSphericalAberration; //!< -1..1 intensity profile across the pupil. Positive: bright-rimmed discs behind focus, soft ones in front (over-corrected, soap bubble). Negative: the reverse, the STF / DC apodized look. 0 = a flat disc.
+
 	// Internal reflection ghosts. Drawn by the sprite bokeh's own pixel shader, so they inherit
 	// the iris polygon, the shape mask and every pupil effect above without asking for any of
 	// it - a ghost IS an image of the aperture. See LensGhostSpec.md.
@@ -229,6 +239,10 @@ public:
 		AddParamFloatNoTransition("Dof_User_FieldCurvature", m_pUserFieldCurvature, 0.0f);
 		AddParamFloatNoTransition("Dof_User_EdgeSoftness", m_pUserEdgeSoftness, 0.0f);
 		AddParamFloatNoTransition("Dof_User_AxialChromatic", m_pUserAxialChromatic, 0.0f);
+		AddParamFloatNoTransition("Dof_User_LensModel", m_pUserLensModel, 0.0f);
+		AddParamFloatNoTransition("Dof_User_LensFocal", m_pUserLensFocal, 50.0f);
+		AddParamFloatNoTransition("Dof_User_SensorWidth", m_pUserSensorWidth, 36.0f);
+		AddParamFloatNoTransition("Dof_User_SphericalAberration", m_pUserSphericalAberration, 0.0f);
 		AddParamFloatNoTransition("Dof_User_GhostAmount", m_pUserGhostAmount, 0.0f);
 		AddParamFloatNoTransition("Dof_User_GhostCount", m_pUserGhostCount, 3.0f);
 		AddParamFloatNoTransition("Dof_User_GhostSpread", m_pUserGhostSpread, 1.0f);
@@ -300,6 +314,10 @@ private:
 	// float: axial chromatic aberration. Not a field effect at all - it is a per-channel focus
 	// error, so it lives on its own rather than on the field vector. See AxialChromaticSpec.md.
 	CEffectParam* m_pUserAxialChromatic;
+	// float x4: the lens model (DofLensModelSpec.md). The switch plus the three quantities a
+	// thin lens needs that the stock focus-range path never carried - focal length, sensor
+	// width, and the spherical aberration only a shared pupil function can express.
+	CEffectParam* m_pUserLensModel, * m_pUserLensFocal, * m_pUserSensorWidth, * m_pUserSphericalAberration;
 	// float x6 + Vec4: internal reflection ghosts. Re-use the sprite bokeh splat pass rather
 	// than a pass of their own, so they live with the depth of field parameters even though
 	// nothing about them depends on focus. See LensGhostSpec.md.
diff --git a/Code/CryEngine/RenderDll/Common/RendererCVars.cpp b/Code/CryEngine/RenderDll/Common/RendererCVars.cpp
