@@ -408,6 +408,10 @@ float CRendererCVars::CV_r_DofSpriteBokehFadeCoC;
 float CRendererCVars::CV_r_DofCatEyeBarrel;
 float CRendererCVars::CV_r_DofCatEyeReach;
 int CRendererCVars::CV_r_DofFieldDebug;
+int CRendererCVars::CV_r_DofLensModel;
