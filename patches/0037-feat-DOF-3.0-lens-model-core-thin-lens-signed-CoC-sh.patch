+int CRendererCVars::CV_r_DofLensModelDebug;
 
 //AllocateConstIntCVar(CRendererCVars, CV_r_measureoverdraw);
 AllocateConstIntCVar(CRendererCVars, CV_r_printmemoryleaks);
@@ -1563,7 +1567,7 @@ void CRendererCVars::InitCVars()
 	               "2 = reserved for native-resolution GATHER as well (currently behaves as 1; "
 	               "the gather still runs on the shared half-resolution target chain).");
 	REGISTER_CVAR3("r_DepthOfFieldSpriteBokehFadeCoC", CV_r_DofSpriteBokehFadeCoC, 1.0f, VF_NULL,
-	               "Circle of confusion (gather units, ~16 px of disc diameter per unit at 1080p) at which "
+	               "Circle of confusion (gather units, 4 px of disc RADIUS per unit at 1080p) at which "
 	               "the hybrid sprite bokeh splats reach full strength; they fade in from one third of "
 	               "this value and are skipped below it. The gather's own halo loses energy as a highlight "
 	               "approaches focus while an energy-conserving splat only gets brighter, so without this "
@@ -1587,6 +1591,37 @@ void CRendererCVars::InitCVars()
 	               "picture with the pupil transmission T as a grey ramp, which is exactly the "
 	               "mechanical light loss the vignette applies (white = full pupil, black = "
 	               "fully clipped). 0 = off (default).");
+	REGISTER_CVAR3("r_DepthOfFieldLensModel", CV_r_DofLensModel, 1, VF_NULL,
+	               "Kill switch for the LENS MODEL depth of field (DofLensModelSpec.md), which drives "
+	               "focus and blur from the thin lens itself - focal length, f-number, focus distance "
+	               "and sensor - instead of the engine's focus-range ramp, weights the gather by the "
+	               "energy each tap actually scatters here, and leaves the depth of field natively "
+	               "sharp. It is a separate shader permutation that ONLY runs when the Cinematic "
+	               "Camera component asks for it (Lens Model DOF). 1 = honour the request (default), "
+	               "0 = ignore it and always take the stock path, which is then byte for byte the "
+	               "engine's own depth of field.");
+	REGISTER_CVAR3("r_DepthOfFieldLensModelMaxCoC", CV_r_DofLensModelMaxCoC, 4.0f, VF_NULL,
+	               "Largest circle of confusion the lens-model GATHER will form, in gather units "
+	               "(~4 px of disc radius per unit at 1080p). Not an optical quantity: the gather has "
+	               "49 taps at half resolution and cannot resolve a disc of any size, so beyond this "
+	               "the physical blur is clipped and the sprite splats carry the rest. Raising it "
+	               "gives larger discs at the cost of sparser sampling (ringing, holes); the second "
+	               "gather iteration fills the small ones. Default 4.0, the stock kernel's own reach.");
+	REGISTER_CVAR3("r_DepthOfFieldLensModelSplatMaxCoC", CV_r_DofLensModelSplatMaxCoC, 256.0f, VF_NULL,
+	               "Largest bokeh sprite the lens-model splat will draw, in native pixels. A sprite is "
+	               "an EXACT evaluation of the pupil rather than a sparse sample of it, so a big disc "
+	               "costs fill rate and nothing else - hence far above the gather's cap. A very bright "
+	               "point far out of focus therefore shows the gather's clipped halo plus a larger, "
+	               "fainter exact disc; if that reads wrong, lower this or raise "
+	               "r_DepthOfFieldLensModelMaxCoC. Default 256 (the stock path is fixed at 64).");
+	REGISTER_CVAR3("r_DepthOfFieldLensModelDebug", CV_r_DofLensModelDebug, 0, VF_NULL,
+	               "DIAGNOSTIC for the lens model. 1 = log the UNCAPPED circle of confusion the thin "
+	               "lens is asking for once a second (so the clipping against "
+	               "r_DepthOfFieldLensModelMaxCoC is visible as a number), and paint the composite as "
+	               "a false-colour map: red = how much of the far layer replaced the frame, green = "
+	               "the frame the lens says is sharp, blue = the near layer's pupil opacity. "
+	               "0 = off (default).");
+
 	REGISTER_CVAR3("r_MotionBlurShutterSpeed", CV_r_MotionBlurShutterSpeed, 250.0f, 0,
 	               "Sets camera exposure time for motion blur as 1/x seconds.\n"
 	               "Default: 250 (1/250 of a second)");
