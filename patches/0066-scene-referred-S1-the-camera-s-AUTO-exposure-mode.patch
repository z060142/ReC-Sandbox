 private:
 	CFullscreenPass m_passLuminanceInitial;
 	CFullscreenPass m_passLuminanceIteration[NUM_HDR_TONEMAP_TEXTURES];
 	CFullscreenPass m_passAutoExposure;
+
+	// Readback state. m_fMeterIssuedExposure is the pre-exposure that was in force for the frame
+	// whose sample is currently in flight: dividing by THAT, and not by the current one, is what
+	// stops the meter from being a two-frame-delayed feedback loop that oscillates.
+	bool  m_bMeterReadbackIssued  = false;
+	bool  m_bMeterReadbackStalled = false;
+	float m_fMeterIssuedExposure  = 1.0f;
+	float m_fMeterIssuedTime      = 0.0f;
 };
