+// Scene-referred AUTO metering: the CPU half of the camera's exposure loop
+// (SceneReferredSpec.md D2/D7, decisions/s1-auto-mode.md part 1, approach A).
+//
+// Passes 1 and 2 above already produce exactly what a camera's incident meter wants: a 1x1
+// R16G16F whose .y is the geometric-mean illuminance estimate in engine units, albedo divided
+// out. Pass 3 (the temporal adaptation) and both ComputeExposure branches are BYPASSED on this
+// path - not stopped: screen-space reflections bind m_pTexHDRMeasuredLuminance and the film
+// grain binds s_ptexCurLumTexture, so the stage keeps running and only its exposure stops being
+// consumed. Smoothing, limits, lock and compensation move to the camera, in EV, where a camera's
+// controls live.
+//
+// s_ptexHDRToneMaps[0] is created with FT_STAGE_READBACK (RendererResources.cpp), so it already
+// owns a PERSISTENT staging resource: no copy pass and no texture of our own are needed, unlike
+// CBloomStage::UpdateDiffractionSourceReadback, whose two-phase shape this otherwise follows
+// exactly. Cost is four bytes and one fence per frame. The blocking one-shot form
+// DownloadToStagingResource(sub, hook) - what r_HDRDebug 1 uses - is a full pipeline stall and is
+// not acceptable per frame.
+//
+// The pre-exposure is divided out HERE rather than in the camera. The camera would otherwise have
+// to keep a history of the exposures it published and guess which frame the sample came from; the
+// stage knows exactly, because it recorded the value when it issued the download. Getting that
+// wrong turns the meter into a two-frame-delayed feedback loop, which oscillates.
+void CAutoExposureStage::UpdateSceneReferredMeterReadback()
+{
+	CD3D9Renderer* const pRenderer = gcpRendD3D;
+
+	// Cube-map generation renders at unity exposure and is not a view anybody meters.
+	const bool bCubemapGen = (m_graphicsPipeline.GetRenderFlags() & SHDF_CUBEMAPGEN) != 0;
+
+	if (!CRendererResources::IsSceneReferred() || bCubemapGen)
+	{
+		// Leaving the path with a download in flight is fine - the staging resource belongs to the
+		// texture, not to us, and nothing is freed here. Only the reported value is retired, so
+		// the camera cannot keep metering off a sample from before the switch was flipped.
+		m_bMeterReadbackIssued = false;
+		m_bMeterReadbackStalled = false;
+		pRenderer->m_fSceneReferredMeteredIlluminance = 0.0f;
+		return;
+	}
+
+	CTexture* pMeterTex = CRendererResources::s_ptexHDRToneMaps[0];
+	if (!CTexture::IsTextureExist(pMeterTex))
+		return;
+
+	CDeviceTexture* pDevTex = pMeterTex->GetDevTexture();
+	if (pDevTex == nullptr)
+		return;
+
+	const float fNow = gEnv->pTimer->GetAsyncCurTime();
+
+	if (m_bMeterReadbackIssued)
+	{
+		// Not signalled yet: come back next frame. Never block.
+		if (!pDevTex->AccessCurrStagingResource(0, false))
+		{
+			if ((fNow - m_fMeterIssuedTime) > 5.0f && !m_bMeterReadbackStalled)
+			{
+				m_bMeterReadbackStalled = true;
+				CryLogAlways("[SceneReferred] the exposure meter's staging download has not signalled in 5 s - AUTO is holding its last EV");
+			}
+			return;
+		}
+		m_bMeterReadbackStalled = false;
+
+		float fIlluminance = 0.0f;
+		const auto readbackData = [&fIlluminance](void* pData, uint32 rowPitch, uint32 slicePitch) -> bool
+		{
+			// R16G16F: .x is the geometric-mean luminance, .y the illuminance estimate. .y is the
+			// incident-meter quantity and the one the EV path has always used.
+			const CryHalf* pDataHalf = static_cast<const CryHalf*>(pData);
+			fIlluminance = CryConvertHalfToFloat(pDataHalf[1]);
+			return true;
+		};
+		pDevTex->AccessCurrStagingResource(0, false, readbackData);
+		m_bMeterReadbackIssued = false;
+
+		// Divide out the exposure that was applied to the frame this sample was measured on, and
+		// reject anything the measure pass could not produce a sane number for (its own isfinite
+		// filter covers NaNs in the source, not a zero illuminance in a black frame).
+		const float fExposureAtCapture = max(m_fMeterIssuedExposure, 1e-12f);
+		pRenderer->m_fSceneReferredMeteredIlluminance =
+			(fIlluminance > 0.0f && NumberValid(fIlluminance)) ? (fIlluminance / fExposureAtCapture) : 0.0f;
+	}
+
+	if (!m_bMeterReadbackIssued)
+	{
+		// Every frame, unlike the diffraction debug readback: this closes an exposure loop, and a
+		// one-second cadence would be visible as steps.
+		pDevTex->DownloadToStagingResource(0);
+		m_bMeterReadbackIssued = true;
+		m_fMeterIssuedExposure = pRenderer->GetSceneReferredExposure();
+		m_fMeterIssuedTime = fNow;
+	}
+}
+
 void CAutoExposureStage::Execute()
 {
 	FUNCTION_PROFILER_RENDERER();
 
 	MeasureLuminance();
 	AdjustExposure();
+	UpdateSceneReferredMeterReadback();
 }
