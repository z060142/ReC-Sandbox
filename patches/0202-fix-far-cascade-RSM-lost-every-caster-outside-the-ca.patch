From d7258cb614b87c67a74ea2f537eed2b74c3e08a3 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Thu, 13 Aug 2026 13:38:20 +0800
Subject: [PATCH 202/307] fix: far cascade RSM lost every caster outside the
 camera hull

The hull-cull exemption loop for LPV RSM passes kept only the FIRST
e_LPVRsm pass (early break). With per-cascade RSM views the far
cascade's caster set degraded to "volume box intersected with the
camera-swept hull", so its GI content followed the view direction -
worse the bigger r_LPVCascadeScale. Keep every LPV pass in the mask.

Co-Authored-By: Claude Fable 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Tu9cj9ax1mqCV93HVfCfpW
---
 Code/CryEngine/Cry3DEngine/ObjectsTree.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/ObjectsTree.cpp b/Code/CryEngine/Cry3DEngine/ObjectsTree.cpp
index f79a0270..b305c7ab 100644
--- a/Code/CryEngine/Cry3DEngine/ObjectsTree.cpp
+++ b/Code/CryEngine/Cry3DEngine/ObjectsTree.cpp
@@ -652,8 +652,11 @@ FrustumMaskType COctreeNode::UpdateCullMask(uint32 onePassTraversalFrameId, uint
 		// test sun shadows hull. for cached shadows also nodes outside hull need to be rendered
 		if (onePassTraversalFrameId != passInfo.GetMainFrameID() && !IsAABBInsideHull(CLightEntity::GetCastersHull().GetElements(), CLightEntity::GetCastersHull().Count(), nodeBox))
 		{
-			// The LPV RSM pass is exempt: its caster set is defined by the volume box (tested below),
-			// not by the camera swept hull, otherwise the RSM contents follow the camera orientation.
+			// The LPV RSM passes are exempt: their caster set is defined by the volume box (tested
+			// below), not by the camera swept hull, otherwise the RSM contents follow the camera
+			// orientation. EVERY LPV cascade pass has to be kept - an early break here silently
+			// limited the exemption to the first cascade, so the far cascade's RSM only received
+			// the casters inside the camera hull and its GI content swam with the view direction.
 			FrustumMaskType keepMask = kPassCullMainMask;
 			for (uint32 n = 0, passId = n + 1, l = (uint32)shadowPasses->size(); n < l; ++n, ++passId)
 			{
@@ -661,7 +664,6 @@ FrustumMaskType COctreeNode::UpdateCullMask(uint32 onePassTraversalFrameId, uint
 				if (pFr && pFr->m_eFrustumType == ShadowMapFrustum::e_LPVRsm)
 				{
 					keepMask |= FMBIT(passId);
-					break;
 				}
 			}
 
