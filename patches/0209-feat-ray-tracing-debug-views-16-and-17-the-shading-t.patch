From c45d790d2b7ba5471b97f368a1df5e7cc5b225e5 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Mon, 14 Sep 2026 04:34:38 +0800
Subject: [PATCH 209/213] feat: ray tracing debug views 16 and 17 - the shading
 tag at the hit, and whether it has an extras record

Two views for the two questions that come before any argument about what a material should look
like in a reflection.

16 = the shading tag, as a flat colour: grey 0 Illum, green 0.25 vegetation leaves, pink 2 human
skin, cyan 3 glass, blue 4 water, brown 5 terrain, yellow 6 emissive only (reserved, never
produced), black for a pixel carrying no material data. If a glass pane reads grey here, the CPU
tagged it Illum and nothing in the shading branch can help.

17 = white when the hit's material has an extras record, black when it is a plain four texel
record. A detail mapped wall that reads black is a producer problem, not a shader one; the
"extras N" counter on the r_DisplayInfo 2 "RT BVH:" line is the other half of the same question.

Both live in ShadePS's existing %_RT_PARTICLE_SHADOW debug block, before the fog and the writer
clamp like views 7-9 and 13, so what they show is the value and not the value plus a veil.

The e_svoTI_RT_Debug help string lives in Cry3DEngine's SceneTreeCVars.inl, which another agent
holds; the two lines to append are in report 05B.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SCUvWGLCsqzm3VNMzp4uiS
---
 .../HWScripts/CryFX/Total_Illumination.cfx    | 33 +++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx b/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx
index 447eb679..d874fe70 100644
--- a/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx
+++ b/Engine/Shaders/HWScripts/CryFX/Total_Illumination.cfx
@@ -2469,6 +2469,39 @@ pixoutShade ShadePS(vtxOutWPOS IN)
 				// lerp, before the writer clamp and before the exposure divide.
 				bRawDebug = true;
 			}
+			else if (nDbg == 16)
+			{
+				// rt stage 5B. 16 = the SHADING TAG at the hit, as a flat colour. This is the
+				// view that answers "is my glass actually tagged glass" before any argument
+				// about what glass should look like:
+				//   grey   0 Illum          green  0.25 vegetation leaves
+				//   pink   2 human skin     cyan   3 glass
+				//   blue   4 water          brown  5 terrain
+				//   yellow 6 emissive only (reserved, the CPU never produces it)
+				//   black    the pixel carries no material data at all (a miss)
+				float3 vTagCol = (float3)0.f;
+				if (nMatCode == VOX_RT_MATCODE_ILLUM)           vTagCol = float3(0.5f, 0.5f, 0.5f);
+				else if (nMatCode == VOX_RT_MATCODE_VEG_LEAVES) vTagCol = float3(0.f, 1.f, 0.f);
+				else if (nMatCode == VOX_RT_MATCODE_HUMAN_SKIN) vTagCol = float3(1.f, 0.5f, 0.6f);
+				else if (nMatCode == VOX_RT_MATCODE_GLASS)      vTagCol = float3(0.f, 0.8f, 1.f);
+				else if (nMatCode == VOX_RT_MATCODE_WATER)      vTagCol = float3(0.f, 0.15f, 1.f);
+				else if (nMatCode == VOX_RT_MATCODE_TERRAIN)    vTagCol = float3(0.6f, 0.4f, 0.15f);
+				else                                            vTagCol = float3(1.f, 1.f, 0.f);
+
+				acc = bNoHit ? (float3)0.f : vTagCol;
+				bRawDebug = true;
+			}
+			else if (nDbg == 17)
+			{
+				// rt stage 5B. 17 = does this hit's material have an EXTRAS record. White = yes
+				// (detail map, blend layer, transmittance, glass / skin / water parameters),
+				// black = a plain 4 texel record. A detail-mapped wall that reads black here is
+				// a CPU-side problem (the producer did not emit extras) and not a shader one;
+				// the "extras N" counter on the r_DisplayInfo 2 "RT BVH:" line is the other half
+				// of the same question.
+				acc = (bNoHit || !bMatExtras) ? (float3)0.f : (float3)1.f;
+				bRawDebug = true;
+			}
 			else if (nDbg == 13)
 			{
 				// 13 = VALIDATOR C (energy audit section 5 / research 06 section 8, option C).
