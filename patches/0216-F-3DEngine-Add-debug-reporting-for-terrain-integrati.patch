From fffa6deee9425e51c6c3dce41ae00871ca1b8abc Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Sun, 30 Aug 2026 20:18:07 +0800
Subject: [PATCH 216/307] !F (3DEngine) Add debug reporting for terrain
 integration classes.

Extend the terrain integration debug mode with triangle counts and optional
class bounds. Merged, transition and rejected geometry is drawn separately so
overly restrictive settings are visible.
---
 Code/CryEngine/Cry3DEngine/cvars.cpp          |  7 ++--
 Code/CryEngine/Cry3DEngine/terrain_node.cpp   | 36 +++++++++++++++++--
 Code/CryEngine/Cry3DEngine/terrain_sector.h   |  7 ++++
 .../Cry3DEngine/terrain_sector_render.cpp     | 28 +++++++++++++--
 4 files changed, 71 insertions(+), 7 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/cvars.cpp b/Code/CryEngine/Cry3DEngine/cvars.cpp
index 504c7987..9651b061 100644
--- a/Code/CryEngine/Cry3DEngine/cvars.cpp
+++ b/Code/CryEngine/Cry3DEngine/cvars.cpp
@@ -505,8 +505,11 @@ void CVars::Init()
 	REGISTER_CVAR(e_TerrainIntegrateObjectsDebug, 0, VF_NULL,
 	              "Debug output for the level flag Terrain/IntegrateObjects\n"
 	              "0 - off\n"
-	              "1 - log the integrated vertex/triangle count of every terrain sector rebuild\n"
-	              "2 - additionally draw the bounding box of the integrated triangles of each sector");
+	              "1 - log the integrated vertex/triangle count and the merged/transition/rejected\n"
+	              "    triangle counts of every terrain sector rebuild, and check that objects with\n"
+	              "    default per instance parameters are classified exactly like stock\n"
+	              "2 - additionally draw one bounding box per triangle class of each sector:\n"
+	              "    green = merged, yellow = slope transition band, red = rejected");
 	DefineConstIntCVar(e_TerrainDeformations, 0, VF_CHEAT,
 	                   "Allows in-game terrain surface deformations");
 	REGISTER_CVAR(e_TerrainEditPostponeTexturesUpdate, 10, VF_NULL,
diff --git a/Code/CryEngine/Cry3DEngine/terrain_node.cpp b/Code/CryEngine/Cry3DEngine/terrain_node.cpp
index e5dd7e39..60f260e9 100644
--- a/Code/CryEngine/Cry3DEngine/terrain_node.cpp
+++ b/Code/CryEngine/Cry3DEngine/terrain_node.cpp
@@ -354,6 +354,12 @@ void CTerrainNode::Init(int x1, int y1, int nNodeSize, CTerrainNode* pParent, bo
 	m_fBBoxExtentionByObjectsIntegration = 0;
 	m_boxIntegratedObjects.Reset();
 	m_nIntegratedObjectsVerts = 0;
+	m_boxIntegratedMerged.Reset();
+	m_boxIntegratedTransition.Reset();
+	m_boxIntegratedRejected.Reset();
+	m_nIntegratedTrisMerged = 0;
+	m_nIntegratedTrisTransition = 0;
+	m_nIntegratedTrisRejected = 0;
 	m_bIntegrationRetryPending = false;
 	m_nIntegrationRetriesLeft = kMaxIntegrationRetries;
 	m_pParent = NULL;
@@ -672,10 +678,34 @@ void CTerrainNode::RenderNodeHeightmap(const SRenderingPassInfo& passInfo, Frust
 		}
 	}
 
-	if (GetCVars()->e_TerrainIntegrateObjectsDebug >= 2 && m_nIntegratedObjectsVerts > 0 && !m_boxIntegratedObjects.IsReset())
+	if (GetCVars()->e_TerrainIntegrateObjectsDebug >= 2
+	    && (!m_boxIntegratedMerged.IsReset() || !m_boxIntegratedTransition.IsReset() || !m_boxIntegratedRejected.IsReset()))
 	{
-		GetRenderer()->GetIRenderAuxGeom()->DrawAABB(m_boxIntegratedObjects, false, ColorB(0, 255, 0, 255), eBBD_Faceted);
-		IRenderAuxText::DrawLabelF(m_boxIntegratedObjects.GetCenter(), 1.5f, "integrated: %d verts", m_nIntegratedObjectsVerts);
+		// One AABB per triangle class: green = merged (full terrain layer weight), yellow =
+		// transition (ramped weight inside the slope band), red = rejected (the object keeps its own
+		// material). Three boxes per sector, so this stays as cheap as the single box it replaces.
+		IRenderAuxGeom* pAux = GetRenderer()->GetIRenderAuxGeom();
+
+		if (!m_boxIntegratedMerged.IsReset())
+			pAux->DrawAABB(m_boxIntegratedMerged, false, ColorB(0, 255, 0, 255), eBBD_Faceted);
+
+		if (!m_boxIntegratedTransition.IsReset())
+			pAux->DrawAABB(m_boxIntegratedTransition, false, ColorB(255, 255, 0, 255), eBBD_Faceted);
+
+		if (!m_boxIntegratedRejected.IsReset())
+			pAux->DrawAABB(m_boxIntegratedRejected, false, ColorB(255, 0, 0, 255), eBBD_Faceted);
+
+		AABB boxLabel;
+		boxLabel.Reset();
+		if (!m_boxIntegratedMerged.IsReset())
+			boxLabel.Add(m_boxIntegratedMerged);
+		if (!m_boxIntegratedTransition.IsReset())
+			boxLabel.Add(m_boxIntegratedTransition);
+		if (!m_boxIntegratedRejected.IsReset())
+			boxLabel.Add(m_boxIntegratedRejected);
+
+		IRenderAuxText::DrawLabelF(boxLabel.GetCenter(), 1.5f, "integrated: %d verts, %d merged / %d transition / %d rejected tris",
+		                           m_nIntegratedObjectsVerts, m_nIntegratedTrisMerged, m_nIntegratedTrisTransition, m_nIntegratedTrisRejected);
 	}
 
 	if (GetCVars()->e_TerrainDetailMaterialsDebug)
diff --git a/Code/CryEngine/Cry3DEngine/terrain_sector.h b/Code/CryEngine/Cry3DEngine/terrain_sector.h
index a60a1ca7..ca587671 100644
--- a/Code/CryEngine/Cry3DEngine/terrain_sector.h
+++ b/Code/CryEngine/Cry3DEngine/terrain_sector.h
@@ -502,6 +502,13 @@ public:
 	float                      m_fBBoxExtentionByObjectsIntegration;
 	AABB                       m_boxIntegratedObjects;    // bbox of the triangles copied in from integrated objects (debug)
 	int                        m_nIntegratedObjectsVerts; // number of vertices copied in on the last rebuild (debug)
+	// Per class bboxes and counts of the last rebuild, drawn by e_TerrainIntegrateObjectsDebug 2.
+	AABB                       m_boxIntegratedMerged;     // full terrain layer weight (green)
+	AABB                       m_boxIntegratedTransition; // ramped weight inside the slope band (yellow)
+	AABB                       m_boxIntegratedRejected;   // too steep or out of the height band (red)
+	int                        m_nIntegratedTrisMerged;
+	int                        m_nIntegratedTrisTransition;
+	int                        m_nIntegratedTrisRejected;
 	static const int           kMaxIntegrationRetries = 8;
 	bool                       m_bIntegrationRetryPending;// an integrated object had no render mesh yet, rebuild once more
 	int                        m_nIntegrationRetriesLeft; // remaining retries, so a mesh that never arrives cannot spin
diff --git a/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp b/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
index 1c4b53b0..9566a45e 100644
--- a/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
+++ b/Code/CryEngine/Cry3DEngine/terrain_sector_render.cpp
@@ -1492,8 +1492,14 @@ void CTerrainNode::AppendTrianglesFromObjects(const int nOriginX, const int nOri
 	// Welded vertices are shared between triangles of different classes and keep the largest weight.
 	PodArray<float> arrVertBlend;
 
+	// The per class debug boxes cost one AABB::Add per triangle, so only fill them when asked.
+	const bool bDebugBoxes = (GetCVars()->e_TerrainIntegrateObjectsDebug >= 2);
+
 	m_boxIntegratedObjects.Reset();
 	m_nIntegratedObjectsVerts = 0;
+	m_boxIntegratedMerged.Reset();
+	m_boxIntegratedTransition.Reset();
+	m_boxIntegratedRejected.Reset();
 
 	bool bRenderMeshMissing = false;
 
@@ -1656,6 +1662,8 @@ void CTerrainNode::AppendTrianglesFromObjects(const int nOriginX, const int nOri
 							{
 								nTrisRejected++;
 								nObjectTrisClassified++;
+								if (bDebugBoxes)
+									m_boxIntegratedRejected.Add(triBox);
 								continue;
 							}
 
@@ -1682,6 +1690,8 @@ void CTerrainNode::AppendTrianglesFromObjects(const int nOriginX, const int nOri
 								{
 									nTrisRejected++;
 									nObjectTrisClassified++;
+									if (bDebugBoxes)
+										m_boxIntegratedRejected.Add(triBox);
 									continue;
 								}
 
@@ -1694,9 +1704,17 @@ void CTerrainNode::AppendTrianglesFromObjects(const int nOriginX, const int nOri
 							}
 
 							if (fBlendWeight < 1.f)
+							{
 								nTrisTransition++;
+								if (bDebugBoxes)
+									m_boxIntegratedTransition.Add(triBox);
+							}
 							else
+							{
 								nTrisMerged++;
+								if (bDebugBoxes)
+									m_boxIntegratedMerged.Add(triBox);
+							}
 
 							{
 								m_fBBoxExtentionByObjectsIntegration = max(m_fBBoxExtentionByObjectsIntegration, triBox.max.z - fHeightMapMax);
@@ -1819,10 +1837,16 @@ void CTerrainNode::AppendTrianglesFromObjects(const int nOriginX, const int nOri
 
 	s_nPeakIntegratedObjectsVerts = max(s_nPeakIntegratedObjectsVerts, m_nIntegratedObjectsVerts);
 
-	if (GetCVars()->e_TerrainIntegrateObjectsDebug && m_nIntegratedObjectsVerts)
+	m_nIntegratedTrisMerged = nTrisMerged;
+	m_nIntegratedTrisTransition = nTrisTransition;
+	m_nIntegratedTrisRejected = nTrisRejected;
+
+	if (GetCVars()->e_TerrainIntegrateObjectsDebug && (m_nIntegratedObjectsVerts || nTrisRejected))
 	{
-		CryLog("Terrain object integration: sector at (%d, %d) took %d vertices / %d triangles from %d object(s); budget %d, peak %d",
+		CryLog("Terrain object integration: sector at (%d, %d) took %d vertices / %d triangles from %d object(s); "
+		       "classified %d merged / %d transition / %d rejected; budget %d, peak %d",
 		       nOriginX, nOriginY, m_nIntegratedObjectsVerts, nIntegratedIndices / 3, nIntegratedObjects,
+		       nTrisMerged, nTrisTransition, nTrisRejected,
 		       GetCVars()->e_TerrainIntegrateObjectsMaxVertices, s_nPeakIntegratedObjectsVerts);
 	}
 }
-- 
