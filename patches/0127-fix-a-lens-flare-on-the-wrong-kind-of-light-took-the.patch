 		TArray<CRenderElement*>* pRendElemBase = pShader ? pLight->m_Shader.m_pShader->GetREs(pLight->m_Shader.m_nTechnique) : 0;
 		if (pRendElemBase && !pRendElemBase->empty())
 		{
+			CRenderElement* pRE0 = pRendElemBase->Get(0);
+			const bool bLensOptics = pRE0->mfGetType() == eDATA_LensOptics;
+
+			// A lens-flare render item carries nothing but the light's INDEX, and
+			// CLensOpticsStage::Execute resolves that index against eDLT_DeferredLight and against
+			// no other list (LensOptics.cpp:64). CRenderView::AddDeferredLight, however, routes the
+			// light into one of THREE lists and returns an index into whichever one it picked, so a
+			// flare on an environment probe (eDLT_DeferredCubemap) or on an ambient light
+			// (eDLT_DeferredAmbientLight) hands the stage an index from a foreign index space.
+			// Because m_lights is a std::list and CRenderView::GetLight has no bounds check, an
+			// index past the end of the deferred list walks onto the list's sentinel node and
+			// returns an SRenderLight that was never constructed - the RenderThread AV of
+			// 2026-09-08 in CLensOpticsStage::Execute+0x711 (garbage m_pLensOpticsElement).
+			//
+			// This is a STOCK CRYENGINE 5.7 bug: the mismatch exists with the scene-referred switch
+			// off. Our ambient-as-fill-light routing (RenderView.cpp, decisions/s8-ambient-lights.md
+			// part 2) only changes WHICH lights land in which list, so it changes how often the
