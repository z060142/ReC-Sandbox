diff --git a/Code/CryEngine/RenderDll/Common/RenderView.cpp b/Code/CryEngine/RenderDll/Common/RenderView.cpp
index ed122c75..6fb4ee23 100644
--- a/Code/CryEngine/RenderDll/Common/RenderView.cpp
+++ b/Code/CryEngine/RenderDll/Common/RenderView.cpp
@@ -387,6 +387,25 @@ static bool IsSceneReferredLightConvention()
 }
 }
 
+//////////////////////////////////////////////////////////////////////////
+eDeferredLightType CRenderView::ResolveDeferredLightList(const SRenderLight& light)
+{
+	// Keep in lockstep with the routing in AddDeferredLight() below - that function calls this one,
+	// so there is exactly one copy of the decision.
+	if (light.m_Flags & DLF_DEFERRED_CUBEMAPS)
+		return eDLT_DeferredCubemap;
+
+	// Scene-referred: an ambient light is a real fill light and goes into the ordinary deferred
+	// list (see the block in AddDeferredLight). On the stock path it stays a modulator.
+	const bool bAmbientAsFillLight = (light.m_Flags & (DLF_AMBIENT | DLF_DEFERRED_CUBEMAPS)) == DLF_AMBIENT
+	                                 && IsSceneReferredLightConvention();
+
+	if ((light.m_Flags & DLF_AMBIENT) && !bAmbientAsFillLight)
+		return eDLT_DeferredAmbientLight;
+
+	return eDLT_DeferredLight;
+}
+
 RenderLightIndex CRenderView::AddDeferredLight(const SRenderLight& pDL, float fMult, const SRenderingPassInfo& passInfo)
 {
 	CRenderView* pRenderView = passInfo.GetRenderView();
@@ -423,20 +442,13 @@ RenderLightIndex CRenderView::AddDeferredLight(const SRenderLight& pDL, float fM
 	// main thread, and it is the same value CLightEntity::UpdateCastShadowFlag tested a moment
 	// earlier when it decided whether to build the light's shadow frustum. One source, no way for
 	// the two halves to land on opposite sides of a flip within one frame.
+	const eDeferredLightType LightType = ResolveDeferredLightList(pDL);
 	const bool bAmbientAsFillLight = (pDL.m_Flags & (DLF_AMBIENT | DLF_DEFERRED_CUBEMAPS)) == DLF_AMBIENT
-	                                 && IsSceneReferredLightConvention();
+	                                 && LightType == eDLT_DeferredLight;
 
-	eDeferredLightType LightType = eDLT_DeferredLight;
-	if (pDL.m_Flags & DLF_DEFERRED_CUBEMAPS)
-	{
-		LightType = eDLT_DeferredCubemap;
-		bSort = false;
-	}
-	else if ((pDL.m_Flags & DLF_AMBIENT) && !bAmbientAsFillLight)
-	{
-		LightType = eDLT_DeferredAmbientLight;
+	// Stock: only the ordinary deferred list is size-sorted; cubemaps and ambient modulators are not.
+	if (LightType != eDLT_DeferredLight)
 		bSort = false;
-	}
 
 	if (pDL.GetLensOpticsElement() && !pDL.m_pSoftOccQuery)
 	{
@@ -605,6 +617,19 @@ SRenderLight& CRenderView::GetLight(eDeferredLightType lightType, RenderLightInd
 {
 	CRY_ASSERT(nLightId >= 0 && nLightId < m_lights[lightType].size());
 
+	// Defence in depth. m_lights is a std::list, so an out-of-range index does not merely read past
+	// the end of a buffer: the walk below lands on the list's SENTINEL node, whose SRenderLight is
+	// never constructed, and the caller then dereferences whatever happens to sit in
+	// m_pLensOpticsElement. That is the RenderThread AV of 2026-09-08 (dump: garbage pRootElem in
+	// CLensOpticsStage::Execute, LensOptics.cpp:67). The real fix is that callers must not carry an
+	// index from one light list into another - see CRenderer::EF_CheckLightMaterial - but this
+	// accessor is used from a dozen places and must not be a crash primitive in a Profile build.
+	if (nLightId < 0 || nLightId >= (RenderLightIndex)m_lights[lightType].size())
+	{
+		static SRenderLight s_nullLight; // default-constructed: no optics element, no occlusion query
+		return s_nullLight;
+	}
+
 	// find iterator at given index (assuming no [] operator)
 	auto itr = m_lights[lightType].begin();
 	while (--nLightId >= 0)
