+
 			CRenderObject* pRO = passInfo.GetIRenderView()->AllocateTemporaryRenderObject();
 			pRO->m_fAlpha        = 1.0f;
 			pRO->SetAmbientColor(Vec3(0, 0, 0));
@@ -1757,14 +1784,14 @@ void CRenderer::EF_CheckLightMaterial(SRenderLight* pLight, uint16 nRenderLightI
 			pOD->m_fTempVars[0] = 0;
 			pOD->m_fTempVars[1] = 0;
 			pOD->m_fTempVars[3] = pLight->m_fRadius;
-			pOD->m_nLightID     = nRenderLightID;
+			pOD->m_nLightID     = (uint16)(nRenderLightID < 0 ? 0 : nRenderLightID);
 
 			pRO->SetAmbientColor(pLight->m_Color);
