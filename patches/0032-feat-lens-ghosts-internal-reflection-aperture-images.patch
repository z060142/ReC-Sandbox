+// Rotation of an RGB colour around the grey axis, the standard 3x3 form. Luminance is preserved
+// because the axis of the rotation IS the grey line, which is what makes it a usable stand-in for
+// "the next lens surface has a different coating": the ghosts fan out in hue without one of them
+// going dark. Negative lobes are clamped away - a rotated colour can leave the RGB cube.
+static Vec3 RotateHueAroundGrey(const Vec3& c, float fAngleRad)
+{
+	const float fCos = cosf(fAngleRad);
+	const float fSin = sinf(fAngleRad);
+	const float k = 1.0f / 3.0f;
+	const float s = sqrtf(k) * fSin;
+	const float a = fCos + (1.0f - fCos) * k;          // diagonal
+	const float b = k * (1.0f - fCos) - s;             // one off-diagonal
+	const float d = k * (1.0f - fCos) + s;             // the other
+	return Vec3(max(0.0f, c.x * a + c.y * b + c.z * d),
+	            max(0.0f, c.x * d + c.y * a + c.z * b),
+	            max(0.0f, c.x * b + c.y * d + c.z * a));
+}
