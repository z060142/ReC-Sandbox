+/////////////////////////////////////////////////////////////////////////////////////////////////
+// Lens ghosts (LensGhostSpec.md)
+//
+// A bright source reflects between the lens surfaces and lands on the sensor as a chain of
+// IMAGES OF THE APERTURE, strung along the line from the source through the frame centre. That
+// is the same object the sprite bokeh already draws, so this shares DofBokehRefPS verbatim and
+// inherits the iris polygon, the shape mask and its rotation, the anamorphic oval, the cat-eye
+// clip and the axial chromatic rim for free. Only the placement and the sizing are different,
+// which is exactly one vertex shader.
+//
+// The grid is QUARTER resolution: a ghost source is a lamp or the sun, never a lone hot texel,
+// and every extra layer multiplies the vertex work by the whole grid.
+/////////////////////////////////////////////////////////////////////////////////////////////////
+v2fBokehQuad DofBokehGhostVS(uint nVertexID : SV_VertexID)
+{
+	v2fBokehQuad OUT = (v2fBokehQuad) 0;
+
+	// Same integer walk over the quad grid as the splat above; only the per-view constant
+	// buffer differs, so the existing arithmetic needs no knowledge of the grid tier.
+	const int nQuadID    = (int)(nVertexID / 6);
+	const int nGridWidth = (int)g_VS_ScreenSize.x;
+	float4 INPos = float4((float)(nQuadID % nGridWidth), (float)(nQuadID / nGridWidth), 0, 0);
+	INPos.xy /= g_VS_HPosScale.xy;
+
+	INPos.xy *= g_VS_ScreenSize.zw * 2.0;
+	INPos.xy += g_VS_ScreenSize.zw;
+
+	float4 vOutPos = INPos;
+	vOutPos.xy = vOutPos.xy * 2 - 1;
+
+	// Where the SOURCE is. The ghost is placed elsewhere below, but the light is sampled here.
+	OUT.Position = float4(vOutPos.xy, 0, 1);
+	float4 screenProj = HPosToScreenTC(OUT.Position);
+
+	OUT.QuadPos = 1;
+
+	// No circle of confusion, no depth, no focus fade: a ghost is formed in the lens, not in
+	// the scene, so its size is the aperture's image and arrives resolved from the CPU in
+	// native pixels. Sub-pixel ghosts cost a quad and add nothing.
+	const half fRadiusPx = (half)vDofGhost0.y;
+	if (fRadiusPx < 1.0)
+	{
+		OUT.Position.xy = 0;
+		return OUT;
+	}
+
+	// The middle 2x2 of the 4x4 cell. zw is half a GRID texel and a grid texel spans four
+	// native texels here, so one native texel is 0.5 * zw and +/-0.25 * zw lands on the four
+	// texel centres around the cell centre.
+	float4 vQuad[4] =
+	{
+		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2(-0.25, -0.25), 0, 0)),
+		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2( 0.25,  0.25), 0, 0)),
+		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2( 0.25, -0.25), 0, 0)),
+		GetTexture2DLod(texDofBkRef_SceneTarget, ssDofBkRef_SceneTarget, float4(screenProj.xy + g_VS_ScreenSize.zw * float2(-0.25,  0.25), 0, 0)),
+	};
+
+	// Its own threshold, far above the splat's: only lamps, the sun and hot reflections throw
+	// ghosts. Same quadratic knee and the same per-texel order as the splat - max(0, x - t) is
+	// convex, so thresholding the mean would swallow a lone hot texel, which is exactly what a
+	// distant lamp is on a quarter resolution grid.
+	const half fThreshold = (half)vDofGhost0.z;
+	const half fKnee      = (half)max(vDofGhost0.w, 1e-4);
+
+	half fExcessSum = 0;
+	half3 cExcess = 0;
+	[unroll] for (int i = 0; i < 4; i++)
+	{
+		const half fLum = GetLuminance(vQuad[i].rgb);
+		half fSoft = clamp(fLum - fThreshold + fKnee, 0, 2 * fKnee);
+		fSoft = (fSoft * fSoft) / (4 * fKnee);
+		const half fExcess = max(fSoft, fLum - fThreshold);
+		// Hue preserving, as in the splat: this texel's colour rescaled to its own excess.
+		cExcess += vQuad[i].rgb * (fExcess / max(fLum, 1e-4));
+		fExcessSum += fExcess;
+	}
+
+	if (fExcessSum * 0.25 < 1e-4)
+	{
+		OUT.Position.xy = 0;
+		return OUT;
+	}
+
+	// The chain: the ghost sits on the line from the source through the frame CENTRE and out
+	// the other side, at k times the source's distance from it. NDC has the centre at the
+	// origin, so the reflection is a plain negation.
+	OUT.Position = float4(-vOutPos.xy * vDofGhost0.x, 0, 1);
+
+	OUT.Color.rgb = cExcess * 0.25 * (half3)vDofGhost1.rgb * (half)vDofGhost1.w;
+	// Read by the pixel shader as the iris falloff exponent, exactly as for a splat.
+	OUT.Color.w = sqrt(fRadiusPx);
+
+	// Radius in native pixels -> NDC half extent. The grid is quarter resolution, so one grid
+	// cell spans four native pixels and g_VS_ScreenSize.zw (half a grid texel) IS one native
+	// pixel expressed in NDC - no 1080-referenced aspect scale belongs here, because the CPU
+	// already sized the ghost as a fraction of the real frame height.
+	OUT.QuadPos = float4(fRadiusPx * g_VS_ScreenSize.zw, 1, fRadiusPx);
+	// Anamorphic squeeze: the pupil image is compressed horizontally, so its ghost is too.
+	OUT.QuadPos.x *= vAspectRatio.z;
+	// QuadPos.z = 1: ghosts go to the NEAR layer, which the overlay adds unmasked. The far
+	// layer is depth-masked against in-focus foreground and would cut them - and a ghost is
+	// formed inside the lens, so nothing in the scene may occlude it.
+
+	// Field-dependent pupil, evaluated at the GHOST's own place in the frame rather than the
+	// source's: the aperture image is clipped by the barrel where IT lands.
+	{
+		const float fFieldAspect = g_VS_ScreenSize.x / max(g_VS_ScreenSize.y, 1.0);
+		const float2 vField = OUT.Position.xy * float2(fFieldAspect, 1.0) * rsqrt(fFieldAspect * fFieldAspect + 1.0);
+		const float fFieldR = length(vField);
+
+		const float fTransmission = LensFieldPupilTransmission(vDofFieldPupil.x * fFieldR, vDofFieldPupil.y);
+		const float fGrowth = 1.0 + vDofFieldPupil.z * fFieldR + abs(vDofFieldPupil.w) * fFieldR * fFieldR;
+
+		OUT.Field = float4(vField, 1.0 / max(fTransmission, 0.05), fGrowth);
+		OUT.QuadPos.xy *= fGrowth;
+	}
+
+	const float2 Verts[6] =
+	{
+		float2( 1,  1),
+		float2(-1,  1),
+		float2( 1, -1),
+
+		float2( 1, -1),
+		float2(-1,  1),
+		float2(-1, -1)
+	};
+
+	OUT.Position.xy += Verts[nVertexID % 6].xy * OUT.QuadPos.xy;
+	OUT.QuadPos = float4(Verts[nVertexID % 6].xy * 0.5 + 0.5, OUT.QuadPos.zw);
+
+	return OUT;
+}
+
+technique DofBokehGhost
+{
+  pass p0
+  {
+    VertexShader = DofBokehGhostVS() PostMotionBlurVS;
+    PixelShader = DofBokehRefPS() PostMotionBlurPS;
+    CullMode = None;
   }
 }
 
