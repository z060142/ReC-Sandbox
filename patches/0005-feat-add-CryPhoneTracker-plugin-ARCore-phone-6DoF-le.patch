+// CryPhoneTracker - entity component driving an entity transform from the phone 6DoF tracker.
+#pragma once
+
+#include <CryEntitySystem/IEntitySystem.h>
+#include <CryEntitySystem/IEntityComponent.h>
+#include <CryNetwork/CrySocks.h>
+
+#include <CrySchematyc/MathTypes.h>
+#include <CrySchematyc/ResourceTypes.h>
+#include <CrySchematyc/Env/IEnvRegistrar.h>
+#include <CrySchematyc/Utils/SharedString.h>
+
+#include "PhoneTrackerProtocol.h"
+#include "PoseFilter.h"
+#include "../../CinematicCamera/Interface/ICinematicCameraOptics.h"
+
+namespace Cry
+{
+namespace PhoneTracker
+{
+
+//! Reflection for the pose filter master switch, so it shows up as a combo box in the panel.
+static void ReflectType(Schematyc::CTypeDesc<EPoseFilterMode>& desc)
+{
+	desc.SetGUID("{9E4F2B07-5D31-4A6C-8B72-1C0D5A93E4F6}"_cry_guid);
+	desc.SetLabel("Filter Mode");
+	desc.SetDefaultValue(EPoseFilterMode::Cinematic);
+	desc.AddConstant(EPoseFilterMode::Off,       "Off",       "Off");
+	desc.AddConstant(EPoseFilterMode::OneEuro,   "OneEuro",   "One Euro");
+	desc.AddConstant(EPoseFilterMode::Cinematic, "Cinematic", "Cinematic");
+}
+
+//! Binds an entity to the Android ARCore tracker: listens for pose packets on a UDP port and
+//! writes the received 6DoF pose into the entity transform every frame.
+class CPhoneTrackerComponent final : public IEntityComponent
+{
+public:
+	CPhoneTrackerComponent() = default;
+	virtual ~CPhoneTrackerComponent();
+
+	static void ReflectType(Schematyc::CTypeDesc<CPhoneTrackerComponent>& desc)
+	{
+		desc.SetGUID("{6D5B1F52-4C2E-47D6-9C2B-2F0C3E77A101}"_cry_guid);
+		desc.SetEditorCategory("Tracking");
+		desc.SetLabel("Phone Tracker");
+		desc.SetDescription("Receives 6DoF poses from the Android phone tracker over UDP and applies them to this entity");
+		desc.SetComponentFlags({ IEntityComponent::EFlags::Singleton });
+
+		desc.AddMember(&CPhoneTrackerComponent::m_enabled, 'enab', "Enabled", "Enabled", "Open the socket and drive the entity while in game/simulation mode", true);
+		desc.AddMember(&CPhoneTrackerComponent::m_port, 'port', "Port", "Listen Port", "UDP port the phone sends pose packets to", 9050);
+
+		desc.AddMember(&CPhoneTrackerComponent::m_applyPosition, 'apos', "ApplyPosition", "Apply Position", "Write the tracked translation into the entity transform", true);
+		desc.AddMember(&CPhoneTrackerComponent::m_applyRotation, 'arot', "ApplyRotation", "Apply Rotation", "Write the tracked rotation into the entity transform", true);
+
+		desc.AddMember(&CPhoneTrackerComponent::m_relativeToStartTransform, 'rel', "Relative", "Relative To Start", "Treat the tracker origin as the entity transform captured when tracking started. Disable to place the entity at raw tracker coordinates", true);
+		desc.AddMember(&CPhoneTrackerComponent::m_scale, 'scal', "Scale", "Metres To Units", "Multiplier applied to the tracked translation (1 = 1 metre per engine unit)", 1.0f);
+		desc.AddMember(&CPhoneTrackerComponent::m_yawOffsetDegrees, 'yaw', "YawOffset", "Yaw Offset", "Rotation around Z applied to the tracked motion, to align the phone heading with the scene", 0.0f);
+		desc.AddMember(&CPhoneTrackerComponent::m_positionOffset, 'poff', "PositionOffset", "Position Offset", "Extra world space offset added after the tracked translation", Vec3(ZERO));
+
+		desc.AddMember(&CPhoneTrackerComponent::m_smoothingHalfLife, 'smoo', "Smoothing", "Smoothing Half Life", "Superseded by the Pose Filter; leave at 0. When above 0 it adds one more exponential smoothing pass after the filter pipeline", 0.0f);
+		desc.AddMember(&CPhoneTrackerComponent::m_signalTimeout, 'tout', "Timeout", "Signal Timeout", "Seconds without a valid pose before tracking is considered lost", 2.0f);
+		desc.AddMember(&CPhoneTrackerComponent::m_driveLens, 'lens', "DriveLens", "Drive Cinematic Camera", "Forward the focal length / aperture / focus distance / EV sent by the phone to a Cinematic Camera component on this entity", true);
+		desc.AddMember(&CPhoneTrackerComponent::m_lensArmsEffects, 'larm', "LensArmsEffects", "Lens Arms DOF And Exposure", "Let the phone switch depth of field and exposure control on when it starts sending lens values", true);
+
+		desc.AddMember(&CPhoneTrackerComponent::m_filterMode, 'fmod', "FilterMode", "Filter Mode", "Off reproduces the unfiltered behaviour exactly. One Euro adds clock rebasing, adaptive smoothing and fixed delay resampling. Cinematic adds the virtual tripod on top", EPoseFilterMode::Cinematic);
+		desc.AddMember(&CPhoneTrackerComponent::m_posMinCutoff, 'pmcu', "PosMinCutoff", "Position Min Cutoff", "Hz. Lower values kill more jitter while the camera is still", 1.0f);
+		desc.AddMember(&CPhoneTrackerComponent::m_posBeta, 'pbet', "PosBeta", "Position Speed Coefficient", "How fast the position cutoff opens up with speed, per m/s. Raise it if fast moves feel laggy", 0.5f);
+		desc.AddMember(&CPhoneTrackerComponent::m_rotMinCutoff, 'rmcu', "RotMinCutoff", "Rotation Min Cutoff", "Hz. Lower values kill more rotational jitter while the camera is still", 1.2f);
+		desc.AddMember(&CPhoneTrackerComponent::m_rotBeta, 'rbet', "RotBeta", "Rotation Speed Coefficient", "How fast the rotation cutoff opens up with angular rate, per rad/s", 0.1f);
+		desc.AddMember(&CPhoneTrackerComponent::m_interpDelayFactor, 'idly', "InterpDelay", "Resample Delay", "Packet intervals of buffering used to hide network jitter. Higher is smoother but adds latency", 1.5f);
+		desc.AddMember(&CPhoneTrackerComponent::m_maxExtrapolationMs, 'xtrp', "MaxExtrapolation", "Max Extrapolation", "Milliseconds the pose may be extrapolated into a signal gap. 0 freezes on the last pose instead", 0.0f);
+
+		desc.AddMember(&CPhoneTrackerComponent::m_tripodEnabled, 'trip', "Tripod", "Virtual Tripod", "Lock the pose completely once the operator holds still, so composing a shot is rock steady", true);
+		desc.AddMember(&CPhoneTrackerComponent::m_tripodEnterSpeed, 'tesp', "TripodEnterSpeed", "Tripod Enter Speed", "Metres per second below which the tripod starts arming", 0.015f);
+		desc.AddMember(&CPhoneTrackerComponent::m_tripodHoldTime, 'thld', "TripodHoldTime", "Tripod Hold Time", "Seconds of stillness required before the pose locks", 0.25f);
+		desc.AddMember(&CPhoneTrackerComponent::m_tripodExitPosition, 'txps', "TripodExitPosition", "Tripod Release Distance", "Metres of movement away from the locked pose that releases the tripod", 0.01f);
+		desc.AddMember(&CPhoneTrackerComponent::m_tripodBlendTime, 'tbld', "TripodBlendTime", "Tripod Release Blend", "Seconds spent blending from the locked pose back to the live pose", 0.15f);
+
+		desc.AddMember(&CPhoneTrackerComponent::m_debugDraw, 'dbg', "DebugDraw", "Debug Draw", "Draw connection and pose statistics on screen", false);
+	}
