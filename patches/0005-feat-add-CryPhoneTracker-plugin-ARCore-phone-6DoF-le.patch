+// CryPhoneTracker - engine plugin entry point.
+#include "StdAfx.h"
+#include "PhoneTrackerPlugin.h"
+
+#include <CrySchematyc/Env/IEnvRegistry.h>
+#include <CrySchematyc/Env/EnvPackage.h>
+#include <CrySchematyc/Utils/SharedString.h>
+#include <CryCore/StaticInstanceList.h>
+
+// Included only once per DLL module.
+#include <CryCore/Platform/platform_impl.inl>
+
+namespace Cry
+{
+namespace PhoneTracker
+{
+
+CPhoneTrackerPlugin::~CPhoneTrackerPlugin()
+{
+	if (gEnv->pSystem != nullptr)
+	{
+		gEnv->pSystem->GetISystemEventDispatcher()->RemoveListener(this);
+	}
+
+	if (gEnv->pSchematyc != nullptr)
+	{
+		gEnv->pSchematyc->GetEnvRegistry().DeregisterPackage(CPhoneTrackerPlugin::GetCID());
+	}
+}
+
+bool CPhoneTrackerPlugin::Initialize(SSystemGlobalEnvironment& env, const SSystemInitParams& initParams)
+{
+	gEnv->pSystem->GetISystemEventDispatcher()->RegisterListener(this, "CPhoneTrackerPlugin");
+	return true;
+}
+
+void CPhoneTrackerPlugin::OnSystemEvent(ESystemEvent event, UINT_PTR wparam, UINT_PTR lparam)
+{
+	switch (event)
+	{
+	case ESYSTEM_EVENT_REGISTER_SCHEMATYC_ENV:
+		{
+			auto staticAutoRegisterLambda = [](Schematyc::IEnvRegistrar& registrar)
+			{
+				Detail::CStaticAutoRegistrar<Schematyc::IEnvRegistrar&>::InvokeStaticCallbacks(registrar);
+			};
+
+			if (gEnv->pSchematyc != nullptr)
+			{
+				gEnv->pSchematyc->GetEnvRegistry().RegisterPackage(
+					stl::make_unique<Schematyc::CEnvPackage>(
+						CPhoneTrackerPlugin::GetCID(),
+						"EntityComponents",
+						"Bigspring",
+						"Phone tracker entity components",
+						staticAutoRegisterLambda));
+			}
+		}
+		break;
+
+	default:
+		break;
+	}
+}
+
+CRYREGISTER_SINGLETON_CLASS(CPhoneTrackerPlugin)
+
+} // namespace PhoneTracker
+} // namespace Cry
