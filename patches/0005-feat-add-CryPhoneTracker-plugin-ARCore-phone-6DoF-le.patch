+	Schematyc::Range<0, 5, 0, 2>   m_rotBeta = 0.1f;
+	Schematyc::Range<1, 4, 1, 4>   m_interpDelayFactor = 1.5f;
+	Schematyc::Range<0, 80, 0, 80> m_maxExtrapolationMs = 0.0f;
