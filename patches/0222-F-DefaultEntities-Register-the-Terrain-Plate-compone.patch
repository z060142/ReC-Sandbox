---
 Code/CryPlugins/CryDefaultEntities/Module/CMakeLists.txt | 2 ++
 Code/CryPlugins/CryDefaultEntities/Module/PluginDll.cpp  | 5 +++++
 2 files changed, 7 insertions(+)

diff --git a/Code/CryPlugins/CryDefaultEntities/Module/CMakeLists.txt b/Code/CryPlugins/CryDefaultEntities/Module/CMakeLists.txt
index 9fe6b76a..ae4eec5a 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/CMakeLists.txt
+++ b/Code/CryPlugins/CryDefaultEntities/Module/CMakeLists.txt
@@ -58,6 +58,8 @@ add_sources("CryDefaultEntities_uber_0.cpp"
 		"DefaultComponents/Geometry/BaseMeshComponent.h"
 		"DefaultComponents/Geometry/StaticMeshComponent.cpp"
 		"DefaultComponents/Geometry/StaticMeshComponent.h"
+		"DefaultComponents/Geometry/TerrainPlateComponent.cpp"
+		"DefaultComponents/Geometry/TerrainPlateComponent.h"
 		"DefaultComponents/Geometry/AnimatedMeshComponent.cpp"
 		"DefaultComponents/Geometry/AnimatedMeshComponent.h"
 		"DefaultComponents/Geometry/AdvancedAnimationComponent.cpp"
diff --git a/Code/CryPlugins/CryDefaultEntities/Module/PluginDll.cpp b/Code/CryPlugins/CryDefaultEntities/Module/PluginDll.cpp
index 20ab8858..be3815ec 100644
--- a/Code/CryPlugins/CryDefaultEntities/Module/PluginDll.cpp
+++ b/Code/CryPlugins/CryDefaultEntities/Module/PluginDll.cpp
@@ -31,6 +31,7 @@
 #include "DefaultComponents/Geometry/AlembicComponent.h"
 #include "DefaultComponents/Geometry/AnimatedMeshComponent.h"
 #include "DefaultComponents/Geometry/StaticMeshComponent.h"
+#include "DefaultComponents/Geometry/TerrainPlateComponent.h"
 #include "DefaultComponents/Input/InputComponent.h"
 #include "DefaultComponents/Lights/EnvironmentProbeComponent.h"
 #include "DefaultComponents/Lights/PointLightComponent.h"
@@ -195,6 +196,10 @@ void CPlugin_CryDefaultEntities::RegisterComponents(Schematyc::IEnvRegistrar& re
 			Schematyc::CEnvRegistrationScope componentScope = scope.Register(SCHEMATYC_MAKE_ENV_COMPONENT(Cry::DefaultComponents::CStaticMeshComponent));
 			Cry::DefaultComponents::CStaticMeshComponent::Register(componentScope);
 		}
+		{
+			Schematyc::CEnvRegistrationScope componentScope = scope.Register(SCHEMATYC_MAKE_ENV_COMPONENT(Cry::DefaultComponents::CTerrainPlateComponent));
+			Cry::DefaultComponents::CTerrainPlateComponent::Register(componentScope);
+		}
 		{
 			Schematyc::CEnvRegistrationScope componentScope = scope.Register(SCHEMATYC_MAKE_ENV_COMPONENT(Cry::DefaultComponents::CInputComponent));
 			Cry::DefaultComponents::CInputComponent::Register(componentScope);
