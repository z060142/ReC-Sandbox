+	// Field-dependent pupil, resolved once per frame and handed to the gather and the splat
+	// unchanged so the two silhouettes can never disagree. .y of the second constant carries the
+	// diagnostic flag purely for symmetry with the tonemap's copy; the gather ignores it.
+	const Vec4 vFieldPupil = ResolveFieldPupil(dofParams.fCatEye, dofParams.fPupilScale, dofParams.fComa, dofParams.fAstigmatism);
+	const Vec4 vFieldPupil2(fSqueeze, (CRenderer::CV_r_DofFieldDebug > 0) ? 1.0f : 0.0f, 0.0f, 0.0f);
+
+	// Once per change, never per frame: these four user values reach the shaders as derived
+	// numbers, so the log prints both sides of the derivation.
