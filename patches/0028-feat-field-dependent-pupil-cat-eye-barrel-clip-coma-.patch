+		static float s_lastCatEye = -1.0f, s_lastPupilScale = -1.0f, s_lastComa = -1.0f, s_lastAstig = -2.0f;
+		if (fabsf(dofParams.fCatEye - s_lastCatEye) > 0.005f || fabsf(dofParams.fPupilScale - s_lastPupilScale) > 0.005f ||
+		    fabsf(dofParams.fComa - s_lastComa) > 0.005f || fabsf(dofParams.fAstigmatism - s_lastAstig) > 0.005f)
+		{
+			s_lastCatEye = dofParams.fCatEye;
+			s_lastPupilScale = dofParams.fPupilScale;
+			s_lastComa = dofParams.fComa;
+			s_lastAstig = dofParams.fAstigmatism;
+			CryLog("[DOF] field pupil catEye=%.2f p=%.2f -> offset/field=%.2f barrel=%.2f coma=%.2f astig=%.2f",
+			       dofParams.fCatEye, dofParams.fPupilScale, vFieldPupil.x, vFieldPupil.y, vFieldPupil.z, vFieldPupil.w);
+		}
