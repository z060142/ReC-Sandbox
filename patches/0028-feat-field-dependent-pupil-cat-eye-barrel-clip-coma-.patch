+// Field-dependent pupil: barrel clip (cat-eye), coma and astigmatism, all expressed in PUPIL
+// units so the shaders can use them without knowing the f-number.
+//
+// The user authors the effects "wide open"; pupilScale = N_open / N_geo is how big the pupil
+// still is relative to the lens wide open. Dividing the barrel geometry by it is what makes
+// stopping down remove the clipping for free: the barrel is mechanical and does not move, so a
+// smaller pupil simply stops reaching it. Coma is multiplied by it instead, because third-order
+// coma goes with the square of the pupil radius in ABSOLUTE terms and the shader's tap radius is
+// already normalized to the pupil. Astigmatism is a focus shift, not a pupil-size effect, so it
+// is aperture independent.
+Vec4 CDepthOfFieldStage::ResolveFieldPupil(float catEye, float pupilScale, float coma, float astigmatism)
+{
+	const float kComa = 0.6f;    // radii a rim tap travels at coma = 1, wide open, in the corner
+	const float kAstig = 0.5f;   // ellipse axis ratio at astigmatism = 1, in the corner
+
+	const float p = clamp_tpl(pupilScale, 0.05f, 1.0f);
+	const float reach = max(CRenderer::CV_r_DofCatEyeReach, 0.0f);
+	const float barrel = max(CRenderer::CV_r_DofCatEyeBarrel, 0.01f);
+
+	return Vec4(reach * clamp_tpl(catEye, 0.0f, 1.0f) / p,
+	            barrel / p,
+	            kComa * clamp_tpl(coma, 0.0f, 1.0f) * p,
+	            kAstig * clamp_tpl(astigmatism, -1.0f, 1.0f));
+}
+
