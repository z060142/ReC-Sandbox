+
+// The report itself. Everything r_HDRDiffractionDebug 3 knows, said in the units the user's
+// controls are in - exposed scene values and stops over mid grey - and ending in the one sentence
+// the mode exists to produce: how bright a ray actually is in this frame, and how much more gain
+// it would take to put it at mid grey.
+//
+// It is deliberately several short lines rather than one long one. Round 3's single line was
+// misread (see the THRESHOLD SOURCE line in ExecuteDiffraction), and a diagnostic that has to be
+// parsed carefully is not a diagnostic.
+void CBloomStage::PrintDiffractionReport(const SDiffractionReport& report, float fMaxExcess, int nMaxX, int nMaxY)
+{
+	const float fGrey = CRendererResources::kSceneReferredMidGrey;
+	const float fInvLn2 = 1.0f / logf(2.0f);
+	const auto stops = [fGrey, fInvLn2](float v) -> float
+	{
+		return (v > 1e-12f) ? (logf(v / fGrey) * fInvLn2) : -99.0f;
+	};
+
+	// The deposit along a SPIKE, and between the spikes, at the radius the report is defined at.
+	// deposit = excess * gain * coefficient; nothing else is in it.
+	const float fRay = fMaxExcess * report.fGain * report.fRayCoeff;
+	const float fGap = fMaxExcess * report.fGain * report.fRingMeanCoeff;
+	const float fRayStops = stops(fRay);
+	const float fRadiusNative = report.fReportRadiusHalfPx * report.fNativeScale;
+
+	const char* szVerdict =
+	  (fMaxExcess <= 0.0f)   ? "NOTHING cleared the threshold - no source in the frame is bright enough to grow rays" :
+	  (fRayStops >= -1.0f)   ? "plainly visible" :
+	  (fRayStops >= -4.0f)   ? "visible against a dark background" :
+	  (fRayStops >= -7.0f)   ? "faint - findable if you know where to look" :
+	                           "invisible: below anything the display transform can show";
+
+	CryLog("[BLOOM] ---- wave glare, once a second (r_HDRDiffractionDebug 3) ----");
+	CryLog("[BLOOM]   source peak %.4g exposed = %+.1f stops over mid grey, at (%d, %d) of the %d x %d grid"
+	       " -- this is the EXCESS above the threshold, after the 5-tap pre-blur: exactly what one sprite is fed",
+	       fMaxExcess, stops(fMaxExcess), nMaxX, nMaxY, report.nGridW, report.nGridH);
+	CryLog("[BLOOM]   threshold %.4g exposed = %+.1f stops over mid grey -- nothing dimmer than this grows rays at all",
+	       report.fThreshold, report.fThresholdStops);
+	CryLog("[BLOOM]   pupil scatters %.2f%% of a source's light into the pattern; the sprite's inner %.0f-native-px fade"
+	       " then keeps about %.0f%% of the texture's share (estimate, 1/u^2 law)",
+	       report.fGlareFraction * 100.0f,
+	       kDiffractionInnerWindowHalfPx * report.fNativeScale, report.fInnerKept * 100.0f);
+	CryLog("[BLOOM]   gain x%.4g = %+.1f stops (Streak Amount %.0f)",
+	       report.fGain, logf(max(report.fGain, 1e-9f)) * fInvLn2, report.fGainSlider);
+	CryLog("[BLOOM]   RAYS: %.0f native px out from that source a spike lands at %.4g = %+.1f stops vs mid grey -- %s",
+	       fRadiusNative, fRay, fRayStops, szVerdict);
+	if (fRay > 1e-12f)
+	{
+		CryLog("[BLOOM]         between the spikes, %.4g = %+.1f stops; %+.0f stops of gain (Streak Amount %.0f) would put the spike ON mid grey",
+		       fGap, stops(fGap), -fRayStops, clamp_tpl(report.fGainSlider - 10.0f * fRayStops, 0.0f, 200.0f));
+	}
+	CryLog("[BLOOM]   threshold source = %s, %d x %d px%s",
+	       report.bFullResSource ? "the FULL-RESOLUTION $HDRTarget" : "$HDRTarget 1/2a, the firefly-FILTERED downsample",
+	       report.nSourceW, report.nSourceH,
+	       report.bFullResSource ? "" : (report.bSceneReferred ? "  <-- FALLBACK, about 3.5 stops dark on a small source" : "  (stock path)"));
 }
 
