+		                     : streakParams.fWaveAmount;
+		report.fGlareFraction = fGlareFraction;
+		report.fRayCoeff = 0.25f * kernel.GetRingPeak() * fNorm;
+		report.fRingMeanCoeff = 0.25f * fRingMeanI * fNorm;
+		report.fReportRadiusHalfPx = fReportU * fPitchHalfPx;
+		report.fNativeScale = fNativeScaleY;
+		report.bFullResSource = (pGlareSrc != pHalfHDR);
+		report.bSceneReferred = bSceneReferredGlare;
+		report.nSourceW = pGlareSrc->GetWidth();
+		report.nSourceH = pGlareSrc->GetHeight();
+		report.nGridW = nGridWidth;
+		report.nGridH = nGridHeight;
+
+		// What the sprite's INNER FADE costs, which the deposited-fraction figure above has never
+		// included and which is not small: the kernel texture spans only R_tex * pitch half-res
+		// pixels - about twelve at f/8 on a 1080p frame - and the fade covers the first four of
+		// them. The pattern's energy grows as ln(u) outside the core, so the fade sits on the
+		// part of the curve where most of the texture's share lives.
+		//
+		//     kept = (1 / ln(R_tex / u_core)) * integral of w_in(u * pitch) d(ln u)
+		//
+		// Sixty-four log steps, once a second, on the two decades between the core edge and the
+		// texture's rim. It is an estimate - it assumes the 1/u^2 law inside the texture too -
+		// and it is labelled as one, but it turns "a small extra deficit at the very centre"
+		// into a number that can be argued with.
+		const float fCoreU = max(kernel.GetCoreRadiusTexels(), 1.0f);
+		const float fLnSpan = logf(max(fRingRadius / fCoreU, 1.0001f));
+		float fKept = 0.0f;
+		const int kSteps = 64;
+		for (int i = 0; i < kSteps; ++i)
+		{
+			const float u = fCoreU * expf(fLnSpan * ((float)i + 0.5f) / (float)kSteps);
+			const float t = clamp_tpl((u * fPitchHalfPx) / kDiffractionInnerWindowHalfPx, 0.0f, 1.0f);
+			fKept += t * t * (3.0f - 2.0f * t);   // smoothstep, the pixel shader's w_in
+		}
+		report.fInnerKept = fKept / (float)kSteps;
+	}
