+	// ---------------------------------------------------------------------------------------
+	// The report r_HDRDiffractionDebug 3 prints once a second. Built here because this is where
+	// every number that decides the rays' brightness exists at once, and handed to the readback
+	// so the source's measured peak and the parameters that produced it are the same frame's.
+	//
+	// The whole chain, in one line of arithmetic, is
+	//
+	//     deposit(r) = excess * gain * I(u) / pitch^2          u = r / pitch, r in half-res px
+	//
+	// and past the kernel's own edge I(u) = I_ring(theta) * (R_tex / u)^2, in which the pitch
+	// cancels exactly:
+	//
+	//     deposit(r) = excess * gain * I_ring(theta) * R_tex^2 / r^2
+	//
+	// so a single coefficient per angle says what a ray is worth at a given radius, with no
+	// aperture, no resolution and no sensor size left in it. The report evaluates it at
+	// u = 2 R_tex - the first radius at which the far-field law is certainly the one in force,
+	// so the number is exact rather than an interpolation of the texture.
+	SDiffractionReport report;
+	{
+		const float fRingMeanI = (fRingRadius > 1.0f)
+		                         ? (kernel.GetTailCoefficient() / (2.0f * PI * fRingRadius * fRingRadius))
+		                         : 0.0f;
+		// u = 2 R_tex, so I is a quarter of the ring's own value.
+		const float fReportU = 2.0f * fRingRadius;
+
+		report.fThreshold = streakParams.fThreshold;
+		report.fThresholdStops = logf(max(streakParams.fThreshold, 1e-9f) / CRendererResources::kSceneReferredMidGrey) / logf(2.0f);
