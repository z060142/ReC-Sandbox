--- a/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
+++ b/Code/CryEngine/RenderDll/XRenderD3D9/GraphicsPipeline/DepthOfField.cpp
@@ -11,17 +11,23 @@ float NGon_Rad(float theta, float n)
 	return cosf(PI / n) / cosf(theta - (2 * PI / n) * floorf((n * theta + PI) / (2 * PI)));
 }
 
-// The sharpening exponent raised over the iris polygon's radius function: 0 = perfect circle,
-// ~1 = the physical polygon, 2+ = deliberately sharpened corners, 4 = caricature. THE single
-// place this is decided - the gather kernel and the splat mask are two views of one iris and
-// must never derive it separately.
+// The exponent raised over the iris polygon's radius function: 0 = perfect circle, 1 = the
+// exact polygon. THE single place this is decided - the gather kernel and the splat mask are
+// two views of one iris and must never derive it separately.
 //
-// Two things drive it. Stopping down reveals the polygon (round at f/1.2, complete by f/2.8,
-// deliberately overlapping the apertures that produce LARGE discs or the shape would never be
-// readable). And blade curvature: only a CURVED blade can retract into a circle. Straight
-// blades keep the fully formed polygon at EVERY aperture and cut visibly sharper corners, so
-// low curvature both floors the formation window and pushes the exponent toward caricature.
-// The knob has to read at a glance - tuned to the picture, not to arithmetic timidity.
+// It CANNOT exceed 1. NGon_Rad is normalised so the edge midpoints sit at 1 and the corners at
+// 1/cos(pi/n) - 1.08 for eight blades, but 2.0 for a triangle - so an exponent of 2 pushes a
+// triangle's corners out to four times the radius and turns every corner into a spike, i.e. a
+// concave three-lobed cloverleaf. A real iris opening is the INTERSECTION of the blades and is
+// always convex; exponents above 1 were a "make it readable" caricature tuned on 5-9 blades and
+// are not physical at any blade count.
+//
+// Two things drive what is left. Stopping down reveals the polygon (round at f/1.2, complete by
+// f/2.8, deliberately overlapping the apertures that produce LARGE discs or the shape would
+// never be readable). And blade curvature: only a CURVED blade can retract into a circle, so
+// straight blades keep the fully formed polygon at EVERY aperture - low curvature floors the
+// formation window. What makes a straight blade look SHARPER than a curved one is the edge, not
+// the corner length; that lives in ComputeIrisEdgeSoftness below.
 static float ComputeIrisShapeExponent(float fstop, float curvature)
 {
 	const float minFstops = 1.2f;
@@ -31,10 +37,21 @@ static float ComputeIrisShapeExponent(float fstop, float curvature)
 	// Straight blades are always fully formed; curved blades follow the f-stop window.
 	const float formed = straight + (1.0f - straight) * stopBlend;
 	const float strength = clamp_tpl(CRenderer::CV_r_DofBokehShapeStrength, 0.25f, 4.0f);
-	// Straight blades sharpen on top of forming: at curvature 0 the polygon runs at double
-	// strength (a caricature on purpose); at curvature 1 this reduces exactly to the legacy
-	// stopBlend * strength.
-	return formed * strength * (1.0f + straight);
+	// 1 is the true iris and the ceiling. r_DofBokehShapeStrength below 1 rounds the polygon
+	// back toward a circle; above 1 it can no longer push past the physical shape.
+	return clamp_tpl(formed * strength, 0.0f, 1.0f);
+}
+
+// Soft width of the polygon's edge in the splat, in quad-local radius units. This is where the
+// blade's own shape shows: a curved blade presents a rounded, slightly soft outline, a straight
+// blade cuts a crisp one. It replaces the corner-stretching the exponent used to do, and unlike
+// that it stays physical - the silhouette is the same convex polygon either way, only its edge
+// is harder or softer. 0.06 at fully curved (the legacy hard-coded width), 0.015 at fully
+// straight.
+static float ComputeIrisEdgeSoftness(float curvature)
+{
+	const float straight = 1.0f - clamp_tpl(curvature, 0.0f, 1.0f);
+	return 0.06f + (0.015f - 0.06f) * straight;
 }
 
 // Shirley's concentric mapping
@@ -377,6 +394,8 @@ void CDepthOfFieldStage::Execute()
 	// which reduces the exponent to the legacy strength-at-full-formation.
 	const float fBladeCurvatureEff = (CRenderer::CV_r_DofBokehQuality >= 3) ? 1.0f : dofParams.fBladeCurvature;
 	const float fIrisExponent = ComputeIrisShapeExponent(fFNumber, fBladeCurvatureEff);
+	// The other half of the curvature knob: how crisp the polygon's edge is cut in the splat.
+	const float fIrisEdgeSoft = ComputeIrisEdgeSoftness(fBladeCurvatureEff);
 
 	// Anamorphic squeeze. The cylindrical element compresses the pupil image horizontally, so
 	// the gather kernel's horizontal reach shrinks by the same factor while the vertical reach
@@ -404,7 +423,11 @@ void CDepthOfFieldStage::Execute()
 
 	// Axial chromatic aberration: one scale, shared by the gather and the splat so the halo and
 	// the sprite can never disagree on where the coloured rim starts.
-	const Vec4 vAxialChromatic(ResolveAxialChromaticScale(dofParams.fAxialChromatic), 0.0f, 0.0f, 0.0f);
+	// .y = the iris polygon's edge softness (blade curvature), riding this constant's free lane
+	// because it is the one every pupil-drawing pass already receives. The gather does not read
+	// it - 49 taps have no crisp edge to soften - but it is filled here as well so the two
+	// copies of the constant can never differ.
+	const Vec4 vAxialChromatic(ResolveAxialChromaticScale(dofParams.fAxialChromatic), fIrisEdgeSoft, 0.0f, 0.0f);
 
 	// ---------------------------------------------------------------------------------------
 	// Lens model (DofLensModelSpec.md). The component asks; the cvar may refuse; the request is
@@ -803,8 +826,8 @@ void CDepthOfFieldStage::Execute()
 	const bool bGhost = (dofParams.fGhostAmount > 0.001f);
 	if (bSplat || bGhost)
 	{
-		ExecuteSplatLayers(dofParams, vDofParams0, vDofParams1, fNumApertureSides, fIrisExponent, bSplat, bGhost,
-		                   bLensModel, vDofLensModel, fLensSplatCap, vFieldPupil2);
+		ExecuteSplatLayers(dofParams, vDofParams0, vDofParams1, fNumApertureSides, fIrisExponent, fIrisEdgeSoft,
+		                   bSplat, bGhost, bLensModel, vDofLensModel, fLensSplatCap, vFieldPupil2);
 	}
 
 	m_bWroteHDRTarget = true;
@@ -898,7 +921,8 @@ static Vec3 RotateHueAroundGrey(const Vec3& c, float fAngleRad)
 // that sharing is the whole reason the two live in one function.
 //////////////////////////////////////////////////////////////////////////////////////////////////
 void CDepthOfFieldStage::ExecuteSplatLayers(const SDepthOfFieldParams& dofParams, const Vec4& vDofParams0, const Vec4& vDofParams1,
-                                            float fNumApertureSides, float fIrisExponent, bool bSplat, bool bGhost,
+                                            float fNumApertureSides, float fIrisExponent, float fIrisEdgeSoft,
+                                            bool bSplat, bool bGhost,
                                             bool bLensModel, const Vec4& vLensModel, float fSplatCapPx,
                                             const Vec4& vGatherFieldPupil2)
 {
@@ -1019,7 +1043,11 @@ void CDepthOfFieldStage::ExecuteSplatLayers(const SDepthOfFieldParams& dofParams
 	const Vec4 vFieldPupil2(fSpriteSqueeze, (CRenderer::CV_r_DofFieldDebug > 0) ? 1.0f : 0.0f, 0.0f, 0.0f);
 	// Same derivation as the gather's, from the same user amount: the splat draws the shrunk
 	// channels at exactly the radius the gather masks its taps to.
-	const Vec4 vAxialChromatic(ResolveAxialChromaticScale(dofParams.fAxialChromatic), 0.0f, 0.0f, 0.0f);
+	// .y = the iris polygon's edge softness in quad-local radius units, resolved in Execute()
+	// from blade curvature (0.06 curved, 0.015 straight) and handed down unchanged. This is
+	// what a straight blade actually does differently - it cuts a crisper outline - now that
