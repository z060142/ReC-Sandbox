+///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+// Self test for the CPU skinning path (console command "ca_RTSkinSelfTest").
+//
+// A synthetic two bone skin: three quads of four vertices each, all four corners of a quad bound to
+// the same bone(s). Bone 0 is the identity, bone 1 is a 90 degree rotation about X through the
+// origin. Quad A is bound to bone 0, quad B to bone 1, quad C half to each - so its analytic result
+// is a 45 degree rotation, because the dual quaternion blend of two unit rotations with equal
+// weights normalises to their bisector.
+//
+// The test drives the SAME VertexCommandSkin::Execute() and the SAME tangent decode that
+// GetSkinnedVertices() uses, with the same argument shapes (strided pointers into an array of
+// SSoftwareVertexFormat, which is exactly what CSoftwareMesh hands out), and compares against the
+// analytic transform of every vertex position and normal.
+///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+
+//! Registered as the console command "ca_RTSkinSelfTest" in cvars.cpp.
+void CryAnimation_RTSkinSelfTest(IConsoleCmdArgs*)
+{
+	const uint32 quadCount = 3;
+	const uint32 vertexCount = quadCount * 4;
+
+	// bone 1: 90 degrees about X, through the origin
+	const Quat  boneRot = Quat::CreateRotationX(gf_PI * 0.5f);
+	const QuatT bones[2] = { QuatT(IDENTITY), QuatT(boneRot, Vec3(ZERO)) };
+
+	DualQuat    boneDQ[2] = { DualQuat(bones[0]), DualQuat(bones[1]) };
+	JointIdType remapTable[2] = { 0, 1 };
+
+	// the analytic rotation each quad's vertices must end up under
+	const Quat quadRot[quadCount] =
+	{
+		Quat(IDENTITY),
+		boneRot,
+		Quat::CreateRotationX(gf_PI * 0.25f)
+	};
+
+	DynArray<SSoftwareVertexFormat> verts;
+	verts.resize(vertexCount);
+
+	for (uint32 q = 0; q < quadCount; q++)
+	{
+		for (uint32 c = 0; c < 4; c++)
+		{
+			SSoftwareVertexFormat& v = verts[q * 4 + c];
+
+			// a unit quad in the XY plane, offset per quad so no two vertices coincide
+			v.position = Vec3((c & 1) ? 1.f : 0.f, (c & 2) ? 1.f : 0.f, (float)q);
+			v.color = 0xffffffff;
+			v.coord = Vec2(0.f, 0.f);
+			v.tangent = Quat(IDENTITY);   // tangent = +X, bitangent = +Y, normal = +Z
+
+			for (uint32 j = 0; j < 8; j++)
+			{
+				v.indices[j] = 0;
+				v.weights[j] = 0;
+			}
+
+			if (q == 0)
+			{
+				v.indices[0] = 0;
+				v.weights[0] = 255;
+			}
+			else if (q == 1)
+			{
+				v.indices[0] = 1;
+				v.weights[0] = 255;
+			}
+			else
+			{
+				v.indices[0] = 0;
+				v.weights[0] = 128;
+				v.indices[1] = 1;
+				v.weights[1] = 128;
+			}
+		}
+	}
+
+	DynArray<Vec3>          positions;
+	DynArray<Vec3>          normals;
+	DynArray<SPipTangents>  tangents;
+	positions.resize(vertexCount);
+	normals.resize(vertexCount);
+	tangents.resize(vertexCount);
+
+	CVertexData vertexData;
+	vertexData.m_vertexCount = vertexCount;
+	vertexData.pPositions = strided_pointer<Vec3>(&positions[0], sizeof(Vec3));
+	vertexData.pTangents = strided_pointer<SPipTangents>(&tangents[0], sizeof(SPipTangents));
+
+	VertexCommandSkin command;
+	command.pTransformations = boneDQ;
+	command.pTransformationRemapTable = remapTable;
+	command.transformationCount = 2;
+	command.pVertexPositions = strided_pointer<const Vec3>(&verts[0].position, sizeof(verts[0]));
+	command.pVertexQTangents = strided_pointer<const Quat>(&verts[0].tangent, sizeof(verts[0]));
+	command.pVertexTransformIndices = strided_pointer<const SoftwareVertexBlendIndex>(&verts[0].indices[0], sizeof(verts[0]));
+	command.pVertexTransformWeights = strided_pointer<const SoftwareVertexBlendWeight>(&verts[0].weights[0], sizeof(verts[0]));
+	command.vertexTransformCount = 4;
+
+	VertexCommandSkin::Execute(command, vertexData);
+
+	for (uint32 i = 0; i < vertexCount; ++i)
+	{
+		Vec4 tng, btg;
+		tangents[i].GetTB(tng, btg);
+		normals[i] = Vec3(tng.x, tng.y, tng.z).Cross(Vec3(btg.x, btg.y, btg.z)) * tng.w;
+	}
+
+	// positions are plain floats; normals come back through an 8 bit snorm tangent frame
+	const float posEps = 1e-4f;
+	const float normEps = 2e-2f;
+
+	int posMismatches = 0;
+	int normMismatches = 0;
+	float maxPosErr = 0.f;
+	float maxNormErr = 0.f;
+
+	for (uint32 q = 0; q < quadCount; q++)
+	{
+		for (uint32 c = 0; c < 4; c++)
+		{
+			const uint32 i = q * 4 + c;
+
+			const Vec3 wantPos = quadRot[q] * verts[i].position;
+			const Vec3 wantNorm = quadRot[q] * Vec3(0.f, 0.f, 1.f);
+
+			const float posErr = (positions[i] - wantPos).GetLength();
+			const float normErr = (normals[i] - wantNorm).GetLength();
+
+			maxPosErr = max(maxPosErr, posErr);
+			maxNormErr = max(maxNormErr, normErr);
+
+			if (posErr > posEps)
+				posMismatches++;
+			if (normErr > normEps)
+				normMismatches++;
+		}
+	}
+
+	const bool bPassed = (posMismatches == 0) && (normMismatches == 0);
+
+	CryLogAlways("RT self test: skinning - 2 bones, %u verts in %u quads (identity / 90 deg X / 50-50 blend); "
+	             "position mismatches = %d, normal mismatches = %d (must be 0); max err pos %.2e, norm %.2e - %s",
+	             vertexCount, quadCount, posMismatches, normMismatches, maxPosErr, maxNormErr,
+	             bPassed ? "PASSED" : "FAILED");
+}
+
+///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+// CPU readable skinned geometry (ReC, rt stage 3B)
+//
+// CE 5.7.1 skins either in a compute shader (the CPU never sees a result) or, in the vertex animation
+// fallback, straight into a write only discard mapped vertex buffer. Neither leaves a CPU readable
+// skinned position anywhere, and the skin -> skeleton bone remap table never leaves CryAnimation.
+// The data is all there; only the interface was missing.
+//
+// This is deliberately NOT a second skinning implementation: it drives VertexCommandSkin - the exact
+// command the software skinning path compiles into its command buffer - with the master character's
+// current SSkinningData::pBoneQuatsS and this attachment's m_arrRemapTable, over the CSoftwareMesh
+// CModelMesh already keeps (or lazily builds) for the requested LOD. Same dual quaternions, same
+// blend, same tangent frame maths as a software skinned character.
+///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
+
+uint32 CAttachmentSKIN::GetSkinnedVertexCount(uint32 lod)
+{
+	if (!m_pModelSkin)
+		return 0;
+
+	const CModelMesh* pModelMesh = m_pModelSkin->GetModelMesh(lod);
+
+	if (!pModelMesh || !pModelMesh->m_pIRenderMesh)
+		return 0;
+
+	// CSoftwareMesh::Create() allocates exactly renderMesh.GetVerticesCount() vertices, so this is the
+	// count GetSkinnedVertices() will write without having to build the software mesh first.
+	const int count = pModelMesh->m_pIRenderMesh->GetVerticesCount();
+
+	return (count > 0) ? (uint32)count : 0;
+}
+
+uint32 CAttachmentSKIN::GetSkinnedVertices(uint32 lod, Vec3* pPositions, Vec3* pNormals, Vec4* pTangents, uint32 capacity)
+{
+	DEFINE_PROFILER_FUNCTION();
+
+	if (!pPositions || !m_pModelSkin || !m_pAttachmentManager)
+		return 0;
+
+	CCharInstance* pMaster = m_pAttachmentManager->m_pSkelInstance;
+
+	if (!pMaster)
+		return 0;
+
+	CModelMesh* pModelMesh = m_pModelSkin->GetModelMesh(lod);
+
+	if (!pModelMesh || !pModelMesh->m_pIRenderMesh)
+		return 0;
+
+	// lazily builds the CPU side copy of this LOD (positions, QTangents, blend indices and weights);
+	// a no-op once it exists, and the very same buffer the software skinning path reads
+	if (!pModelMesh->InitSWSkinBuffer())
+		return 0;
+
+	const CSoftwareMesh& geometry = pModelMesh->m_softwareMesh;
+	const uint32         vertexCount = geometry.GetVertexCount();
+
+	if (!vertexCount || vertexCount > capacity)
+		return 0;
+
+	// The newest skinning data the renderer still holds: this frame's if the character has already
+	// been submitted, otherwise one of the two previous frames'. This is the same three slot scan
+	// GetRandomPoints() uses. A character that has never been rendered has none at all, and the
+	// caller is told so (0) rather than being handed a bind pose.
+	SSkinningData* pSkinningData = nullptr;
+
+	const int nFrameID = gEnv->pRenderer ? gEnv->pRenderer->EF_GetSkinningPoolID() : 0;
+
+	for (int n = 0; n < 3; n++)
+	{
+		const int nList = (nFrameID - n) % 3;
+
+		if (pMaster->arrSkinningRendererData[nList].nFrameID == nFrameID - n)
+		{
+			pSkinningData = pMaster->arrSkinningRendererData[nList].pSkinningData;
+			break;
+		}
+	}
+
+	if (!pSkinningData || !pSkinningData->pBoneQuatsS)
+		return 0;
+
+	// the bone transforms are produced by an async job; the render path waits on the same handle
+	if (pSkinningData->pAsyncJobs)
+		gEnv->pJobManager->WaitForJob(*pSkinningData->pAsyncJobs);
+
+	if (m_arrRemapTable.empty())
+		return 0;
+
+	const uint32 transformationCount = std::min<uint32>((uint32)m_arrRemapTable.size(), pSkinningData->nNumBones);
+
+	if (!transformationCount || transformationCount > MAX_JOINT_AMOUNT)
+		return 0;
+
+	// VertexCommandSkin always writes a tangent frame, so it needs a destination even when the caller
+	// only asked for positions. This scratch buffer is a member and never crosses a module boundary.
+	if ((uint32)m_skinnedVertexTangents.size() < vertexCount)
+		m_skinnedVertexTangents.resize(vertexCount);
+
+	CVertexData vertexData;
+	vertexData.m_vertexCount = vertexCount;
+	vertexData.pPositions = strided_pointer<Vec3>(pPositions, sizeof(Vec3));
+	vertexData.pTangents = strided_pointer<SPipTangents>(&m_skinnedVertexTangents[0], sizeof(SPipTangents));
+	// velocities and previous positions stay null: VertexCommandSkin then runs its cheapest variant
+
+	VertexCommandSkin command;
+	command.pTransformations = pSkinningData->pBoneQuatsS;
+	command.pTransformationRemapTable = &m_arrRemapTable[0];
+	command.transformationCount = transformationCount;
+	command.pVertexPositions = geometry.GetPositions();
+	command.pVertexQTangents = geometry.GetTangents();
+	command.pVertexTransformIndices = geometry.GetBlendIndices();
+	command.pVertexTransformWeights = geometry.GetBlendWeights();
+	command.vertexTransformCount = geometry.GetBlendCount();
+
+	VertexCommandSkin::Execute(command, vertexData);
+
+	// Decode the tangent frame the command produced. The normal is the third basis vector, exactly as
+	// SPipTangents::GetN() forms it, which is also how the ray tracer reads a static mesh's normals -
+	// so a skinned vertex and a rigid one are quantised the same way.
+	if (pNormals || pTangents)
+	{
+		for (uint32 i = 0; i < vertexCount; ++i)
+		{
+			Vec4 tng, btg;
+			m_skinnedVertexTangents[i].GetTB(tng, btg);
+
+			if (pNormals)
+				pNormals[i] = Vec3(tng.x, tng.y, tng.z).Cross(Vec3(btg.x, btg.y, btg.z)) * tng.w;
+
+			if (pTangents)
+				pTangents[i] = tng;
+		}
+	}
+
+	return vertexCount;
+}
