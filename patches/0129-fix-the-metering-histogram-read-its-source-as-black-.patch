 //   applied EV   what the camera settled on: the smoothed EV plus the mode's bias, after the
 //                Auto EV Min/Max clamp. target and applied converging is the loop working;
 //                applied pinned at a limit while target sits far away is the loop having lost.
+// Why the camera's AUTO loop is not moving the EV, in words. The codes are the Cinematic
+// Camera's EMeterHold, published as Global_User_MeterHold; anything the camera has not published
+// yet reads 0 on the bus, which is why 0 is worded as an observation and not as a promise.
+static const char* MeterHoldReason(int nHold)
+{
+	switch (nHold)
+	{
+	case 0:  return "LIVE";
+	case 1:  return "HOLDING: no sample yet (readback not back / meter retired)";
+	case 2:  return "HOLDING: histogram total is zero";
+	case 3:  return "HOLDING: band collected no weight";
+	case 4:  return "HOLDING: band entirely in bin 0 (black source?)";
+	case 5:  return "HOLDING: band entirely in bin 63 (Inf / clipped)";
+	case 6:  return "HOLDING: result NaN or outside 1e-10..1e3";
+	case 7:  return "HOLDING: Auto Exposure Lock";
+	case 8:  return "LIVE (log-mean fallback drives, band n/a)";
+	case 9:  return "MANUAL (not metering)";
+	default: return "HOLDING: unknown reason";
+	}
+}
