+float CRendererResources::GetSceneReferredWriterClamp()
+{
+	// Stage 2, the exposure stage: before the pre-exposure exists there is nothing that can
+	// overflow that did not overflow in stock CE, and a clamp there would be a change to the
+	// stock picture for no reason.
+	if (!IsSceneReferredStage(2))
