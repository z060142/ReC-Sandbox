From b4a7ada0d455ccf14ea46bee9ee11130d5c66b35 Mon Sep 17 00:00:00 2001
From: z060142 <z060142@yahoo.com.tw>
Date: Mon, 31 Aug 2026 10:39:31 +0800
Subject: [PATCH 243/307] !F (Roads) Rebuild roads when integrated geometry
 changes.

Schedule road rebuilding over the same old-and-new bounds used to invalidate
terrain sectors. Deferred integration rebuilds coalesce the road update with
the existing movement debounce.
---
 Code/CryEngine/Cry3DEngine/3dEngine.cpp | 45 +++++++++++++++++++++++--
 Code/CryEngine/Cry3DEngine/3dEngine.h   |  5 +++
 2 files changed, 48 insertions(+), 2 deletions(-)

diff --git a/Code/CryEngine/Cry3DEngine/3dEngine.cpp b/Code/CryEngine/Cry3DEngine/3dEngine.cpp
index a6010238..3507494d 100644
--- a/Code/CryEngine/Cry3DEngine/3dEngine.cpp
+++ b/Code/CryEngine/Cry3DEngine/3dEngine.cpp
@@ -6848,6 +6848,12 @@ void C3DEngine::UpdateTerrainObjectIntegration(IRenderNode* pEnt, EERType eERTyp
 		m_integratedIntoTerrainNodes[pEnt] = aabb;
 	else
 		m_integratedIntoTerrainNodes.erase(it);
+
+	// A road drapes over the object's real surface (e_RoadsFollowIntegratedObjects), so the same dirty
+	// box that invalidates the terrain sectors has to rebuild the roads crossing it. Done after the map
+	// is updated, and only as a scheduling request - Compile() runs later, from Update(), never from
+	// inside a (un)registration.
+	RequestRoadRebuildsInArea(dirtyBox);
 }
 
 ///////////////////////////////////////////////////////////////////////////////
@@ -6871,13 +6877,48 @@ void C3DEngine::FlushPendingTerrainRebuilds()
 			continue;
 		}
 
-		if (pTerrain != nullptr && !it->second.dirtyBox.IsReset())
-			pTerrain->ResetTerrainVertBuffers(&it->second.dirtyBox);
+		if (!it->second.dirtyBox.IsReset())
+		{
+			if (pTerrain != nullptr)
+				pTerrain->ResetTerrainVertBuffers(&it->second.dirtyBox);
+
+			// Same debounce for the roads: one rebuild once the object has come to rest, not one per
+			// frame of the drag.
+			RequestRoadRebuildsInArea(it->second.dirtyBox);
+		}
 
 		it = m_pendingTerrainRebuilds.erase(it);
 	}
 }
 
+///////////////////////////////////////////////////////////////////////////////
+void C3DEngine::RequestRoadRebuildsInArea(const AABB& box)
+{
+	if (!GetCVars()->e_RoadsFollowIntegratedObjects)
+		return;
+
+	if (box.IsReset() || !m_pObjectsTree)
+		return;
+
+	// A road sits on the terrain while the object standing on it can be anywhere above or below, so the
+	// two boxes need not overlap vertically. Widen the query in Z only, exactly as the heightmap edit
+	// path does (terran_edit.cpp), and let the XY overlap do the selecting.
+	AABB queryBox = box;
+	queryBox.min.z -= 1024.f;
+	queryBox.max.z += 1024.f;
+
+	PodArray<IRenderNode*> lstRoads;
+	GetObjectsByTypeGlobal(lstRoads, eERType_Road, &queryBox);
+
+	for (int i = 0; i < lstRoads.Count(); i++)
+	{
+		// Only schedule: OnTerrainChanged() would first snap every vertex back onto the bare heightmap
+		// (GetZApr), which is the very surface we are trying to leave. Compile() runs from Update() and
+		// does the whole job with the integrated heights in one pass.
+		((CRoadRenderNode*)lstRoads[i])->ScheduleRebuild(true);
+	}
+}
+
 ///////////////////////////////////////////////////////////////////////////////
 void C3DEngine::BeginIntegratedHeightSampling(const AABB& areaBox)
 {
diff --git a/Code/CryEngine/Cry3DEngine/3dEngine.h b/Code/CryEngine/Cry3DEngine/3dEngine.h
index 26db5637..b319e0be 100644
--- a/Code/CryEngine/Cry3DEngine/3dEngine.h
+++ b/Code/CryEngine/Cry3DEngine/3dEngine.h
@@ -871,6 +871,11 @@ public:
 	//! still for long enough. Called once per frame from Update().
 	void FlushPendingTerrainRebuilds();
 
+	//! Schedule a full rebuild of every eERType_Road node whose bounding box overlaps `box` in XY, so a
+	//! road that drapes over an integrating object (e_RoadsFollowIntegratedObjects) follows it when the
+	//! object appears, moves or goes away. No-op while the cvar is 0.
+	void RequestRoadRebuildsInArea(const AABB& box);
+
 	//! One integrating object, cached in world space for the duration of a road rebuild.
 	struct SIntegratedHeightNode
 	{
